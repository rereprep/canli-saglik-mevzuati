nf":1},{"text":"00165281136","x0":0.7474332626691559,"x1":0.8254620142131166,"top":0.19622093040411126,"bottom":0.20494186025722594,"conf":1},{"text":"SENELGI","x0":0.4722792586222702,"x1":0.5503080101662309,"top":0.28488372107420734,"bottom":0.30523255794201054,"conf":0.5},{"text":"2022 / .-","x0":0.478439424493997,"x1":0.5420944567060941,"top":0.3023255814241991,"bottom":0.3126603933568175,"conf":1},{"text":"Özel bakım ihtiyacı olan bireyler yaşam kalitesini doğrudan etkileyen ağız ve sağlığı","x0":0.17852910003360287,"x1":0.901532667379809,"top":0.3647820141935001,"bottom":0.3851888432704188,"conf":1},{"text":"hastalıkları açısından yüksek risk grubu içerisinde yer almaktadır. Ağız ve diş sağlığı","x0":0.11903470222713596,"x1":0.9015038554872252,"top":0.3899322921589916,"bottom":0.40894777811996597,"conf":1},{"text":"hastalıklarının genel sağlık üzerine olumsuz etkileri olduğundan, bu bireylerin ağız ve diş","x0":0.1190964986579287,"x1":0.9014373821458745,"top":0.41569767449117623,"bottom":0.43168604643242214,"conf":1},{"text":"sağlığının iyileştirilmesi ve var olan durumlarının korunması önemlidir.","x0":0.11704312481335759,"x1":0.6981519468805999,"top":0.4404069768166584,"bottom":0.4563953487579042,"conf":1},{"text":"Bilindiği üzere; engelli hastalara yönelik ağız ve diş sağlığı hizmetleri, engelli hastaların","x0":0.17864474859237342,"x1":0.9014373867045257,"top":0.4649272879553037,"bottom":0.4825581391526892,"conf":1},{"text":"evde sağlık hizmetleri ile birlikte evde muayeneleri, ayaktan başvurularda poliklinik","x0":0.11909649856822883,"x1":0.9014373820561747,"top":0.48837209339655785,"bottom":0.5059880235475387,"conf":1},{"text":"muayeneleri, hastanın genel sistemik durumu ve kooperasyonu uygun ise poliklinik şartlarında","x0":0.11903243817025055,"x1":0.9015073480714371,"top":0.5125902551484729,"bottom":0.5322423272815854,"conf":1},{"text":"ağız ve diş sağlığı tedavileri, genel anestezi gereken durumlarda ihtiyaç olunan konsültasyon","x0":0.11901802797538184,"x1":0.901504746371127,"top":0.5365645982172152,"bottom":0.5559981190343803,"conf":1},{"text":"hizmetleri, genel anestezi öncesi tahlil ve tetkikleri, genel anestezi altında diş tedavileri ve tedavi","x0":0.11909651786191008,"x1":0.9034907509474226,"top":0.5624465358773434,"bottom":0.5799828917370526,"conf":1},{"text":"sonrası yatış işlemlerini kapsamaktadır.","x0":0.1169314204986238,"x1":0.44156335710353994,"top":0.5873900702615478,"bottom":0.6050831795046617,"conf":1},{"text":"Bakanlığımızca sağlık kurum ve kuruluşları tarafından engelli hastalara yönelik ağız ve","x0":0.1786447487370536,"x1":0.901437386849206,"top":0.6119186050232157,"bottom":0.629360464729445,"conf":1},{"text":"diş sağlığı hizmetlerinin bütüncül bir yaklaşımla güncel ihtiyaç ve beklentilere uygun olarak","x0":0.11909651786678549,"x1":0.903490750952298,"top":0.6364414029439832,"bottom":0.6526946108139575,"conf":1},{"text":"sunulmasını temin etmek üzere birimlerde görev yapacak asgari personel standardı, birimlerin","x0":0.11909651806277267,"x1":0.903490751148285,"top":0.6598837213024686,"bottom":0.677502138838386,"conf":1},{"text":"fiziki şartları, bu birimlerin kurulması ve işleyişi ile buralarda görev yapacak personelin","x0":0.11909651785040201,"x1":0.9034907509359145,"top":0.6860465120050311,"bottom":0.7035928141412721,"conf":1},{"text":"eğitimlerine ilişkin düzenleme yapılması gerektiği değerlendirilmiştir.","x0":0.11909650811503374,"x1":0.687885011187604,"top":0.7107558143295776,"bottom":0.7284003424729978,"conf":1},{"text":"Bu kapsamda engelli hastalara yönelik ağız ve diş sağlığı hizmet birimleri; hizmetin","x0":0.17864476784826913,"x1":0.903490755557988,"top":0.735465116656,"bottom":0.7529069763622293,"conf":1},{"text":"içeriği, personel standardı ve fiziki gereklilikler bakımından, ekte usul ve esasları belirtilen","x0":0.1170431121035071,"x1":0.9034907685896771,"top":0.7600513256516346,"bottom":0.7776162786879796,"conf":1},{"text":"engelli polikliniği, engelli ünitesi ve engelli diş tedavi merkez olarak sınıflandırılmış olup","x0":0.11909651565436911,"x1":0.9034907487398816,"top":0.7834302327631644,"bottom":0.8008720924693937,"conf":1},{"text":"poliklinik ve ünitenin ağız ve diş sağlığı hizmeti sunulan sağlık tesisleri bünyesinde; merkez ise","x0":0.11909651795194375,"x1":0.9034907510374562,"top":0.8079555177213635,"bottom":0.8255813949646796,"conf":1},{"text":"Bakanlığımız planlamaları kapsamında uygun görülen yataklı sağlık tesisleri bünyesinde","x0":0.11900796760222775,"x1":0.9035908413883145,"top":0.8308946932294653,"bottom":0.8521240374432594,"conf":1},{"text":"kurulmalıdır.","x0":0.11882972616337004,"x1":0.2322940908575064,"top":0.858197067565599,"bottom":0.8730765030958707,"conf":1},{"text":"Ağız ve Diş Sağlığı Dairesi Başkanlığı","x0":0.12114989535253955,"x1":0.3305954843189184,"top":0.922965116464431,"bottom":0.9316860463175457,"conf":1},{"text":"Bilkent Yerleşkesi, Universiteler Mah. Dumlupınar Bulvarı 6001 Cad. No:9 06800 Çankaya /ANKARA","x0":0.12114989302251379,"x1":0.681724850098636,"top":0.9331395349672186,"bottom":0.9433139534011201,"conf":1},{"text":"e-Posta: bilgen.kibaroglu@saglik.gov.tr İnternet Adresi: https://shgmadsdb.saglik.gov.tr","x0":0.1211499022145803,"x1":0.6016427120222435,"top":0.9431137726312487,"bottom":0.9550898205354404,"conf":0.5},{"text":"Bilgi İçin: Bilgen KİBAROGLU","x0":0.7002053425530631,"x1":0.8767967106321044,"top":0.9213002565572103,"bottom":0.9316860464202681,"conf":1},{"text":"Sağlık Teknikeri (Diş)","x0":0.7556468187441244,"x1":0.8788501009447082,"top":0.9331395349593126,"bottom":0.9433139533932141,"conf":1},{"text":"Telefon No: 0 (312) 471 7912","x0":0.7002053378534348,"x1":0.8644763869378042,"top":0.9431137725101876,"bottom":0.9534883719963436,"conf":1}]}