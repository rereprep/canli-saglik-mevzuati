,"top":0.38508723931940725,"bottom":0.3939825280965549,"conf":1},{"text":"2015/4-3","x0":0.5030800821916631,"x1":0.5626283367928431,"top":0.39534883729488235,"bottom":0.4098837207125172,"conf":1},{"text":"Bilindiği gibi Idari Yargı mercilerince verilen muhtelif kararların 2577 sayılı Idari Yargılama Usul","x0":0.2566735197172698,"x1":0.8501026607791841,"top":0.4302325580142594,"bottom":0.4418803420109719,"conf":1},{"text":"Kanununda belirlenen usul ve esaslar çerçevesinde gecikmeye yer verilmeksizin uygulanması gerekmektedir.","x0":0.21149897451902427,"x1":0.8336755634700521,"top":0.44186046498911025,"bottom":0.4534883722122819,"conf":1},{"text":"Bakanlığımız ve Bağlı Kuruluşlar aleyhine açılan davalarda, yargı makamlarınca verilen çeşitli","x0":0.2546201324552574,"x1":0.8501026600162837,"top":0.45341880346351404,"bottom":0.46511627919030185,"conf":1},{"text":"kararların Idari Yargılama Usulü Kanunu'nun 28 inci madde belirlenen süre ve esaslar muvacehesinde","x0":0.21149898072988127,"x1":0.8501026616738051,"top":0.46495726475476673,"bottom":0.47692307672057876,"conf":1},{"text":"uygulanabilmesini teminen alınan ve ivedilikle uygulayıcı birimlere intikal ettirilen makam onay/ kararlarının,","x0":0.21149898078603224,"x1":0.8501026617299561,"top":0.47674418592073664,"bottom":0.4884615384210653,"conf":1},{"text":"mezkür yargı kararının idareye tebliğinden tarihinden itibaren 30 (otuz) gün içerisinde, tebligata ilişkin","x0":0.21149898077952778,"x1":0.8501026617234516,"top":0.48837209283140925,"bottom":0.5014534885593657,"conf":1},{"text":"mevzuatlar çerçevesinde, raporlu yåda izinli olduğu günlerde dahi geçerli olmak üzere ilgiliye tebliğinin","x0":0.20944557508481512,"x1":0.8501026794293964,"top":0.49999999987372634,"bottom":0.511627907096898,"conf":1},{"text":"sağlanması,","x0":0.20944558515875605,"x1":0.2813141679799943,"top":0.5130813952556321,"bottom":0.523255813974019,"conf":1},{"text":"Ilişikte sunulan tebliğ/tebelluğ tarihini ve karar icabının fiilen yerine getirildiği tarihi gösterir belgenin","x0":0.25256672666758206,"x1":0.8501026776292658,"top":0.5230769232071834,"bottom":0.5363372094894537,"conf":1},{"text":"hazırlanarak onaylı örneğinin Bakanlığımız Merkez Teşkilatı ile Bağlı Kuruluşlarının ilgili birimlerine","x0":0.20944557832052238,"x1":0.8501026826651037,"top":0.5333333331887719,"bottom":0.5465811964366352,"conf":1},{"text":"gönderilerek, faks çekilmesi ve müteakiben faks teyidinin de gönderilmesi,","x0":0.20944558534497043,"x1":0.6386036957732881,"top":0.5465116277807968,"bottom":0.5581395350039684,"conf":1},{"text":"Mezkür hususlar ile ilgili mevzuatında ki usul ve esaslara aykırı hareket edildiği takdirde yargı kararınım","x0":0.2546201324122274,"x1":0.8501026599732537,"top":0.5581196580513997,"bottom":0.5683760683078101,"conf":1},{"text":"uygulanmasındaki gecikmeden, müsebbiplerinin yasalar karşısında müşterek ve müteselsilen sorumlu duruma","x0":0.21142424481289673,"x1":0.8501505126909574,"top":0.5674998385617179,"bottom":0.5814790151400767,"conf":1},{"text":"düşeceğinin, konun ehemmiyetine binaen sorumlular hakkında Bağlı Kuruluşlar/Genel Müdürlüklerince de idari","x0":0.2094456118339776,"x1":0.850102642375468,"top":0.5799145300429829,"bottom":0.5915697669637227,"conf":1},{"text":"soruşturma başlatılacağının bilinmesini.","x0":0.20944558200719668,"x1":0.4394250544154683,"top":0.593023255750211,"bottom":0.6031976744685978,"conf":1},{"text":"Idari yargı kararları ve uygulanmasına dair iş ve işlemlerin yukarıda belirtilen şekilde yürütülmesi ve","x0":0.2546201324174305,"x1":0.8501026599784567,"top":0.6046511626654149,"bottom":0.6162790698885865,"conf":1},{"text":"21/03/2006 tarihli ve 63567 sayılı genel yazının yürürlükten kaldırıldığı ve bu Genelge'de belirtilmeyen","x0":0.20939344244117442,"x1":0.8501578564800574,"top":0.614352115675555,"bottom":0.6279069173719412,"conf":1},{"text":"konularda yürürlükteki mevzuata uyulması hususunda bilgilerinizi ve gereğini rica ederim.","x0":0.20944558185174356,"x1":0.7248459990458563,"top":0.6277777778609946,"bottom":0.6380813954036201,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.6632443528790969,"x1":0.8049281320224614,"top":0.6713675213764365,"bottom":0.6846153846242998,"conf":1},{"text":"Bakan a.","x0":0.7082213588982074,"x1":0.7601326449259244,"top":0.684182583945157,"bottom":0.6941901512285917,"conf":1},{"text":"Müstesa","x0":0.7022587259835494,"x1":0.7597535940856174,"top":0.6962209300787446,"bottom":0.7078488373019163,"conf":1},{"text":"EKLER 1-Teblig-Tebelläğ Belgesi (1 Sayfa)","x0":0.20739219738250997,"x1":0.47022587222734635,"top":0.7149572648930065,"bottom":0.7325581395085371,"conf":1},{"text":"DAĞITIM","x0":0.20502766397817396,"x1":0.2755015436620133,"top":0.736644953619561,"bottom":0.7538504788792473,"conf":1},{"text":"1-A-Plamı (Bağlı kuruluşlar dâhil )","x0":0.18817587389531334,"x1":0.40913747577073845,"top":0.746487255280024,"bottom":0.7688824862498361,"conf":1},{"text":"2-TKHK Başkanlığı(Taşra teşkilatına duyurulmak üzere)","x0":0.20725519074641605,"x1":0.5339846480988572,"top":0.7627808038391142,"bottom":0.7777412460805546,"conf":1},{"text":"3-THSK Başkanlığı (Taşra teşkilatına duyurulmak üzere)","x0":0.20739219514838916,"x1":0.5359342933171278,"top":0.7747093021979963,"bottom":0.7863372094211679,"conf":1},{"text":"1003","x0":0.8110882960682698,"x1":0.848049280728445,"top":0.8968023254258821,"bottom":0.9084302326490538,"conf":1}]}