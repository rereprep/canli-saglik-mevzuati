82,"x1":0.6098562677685726,"top":0.45203488359389155,"bottom":0.46367521385147037,"conf":1},{"text":"/ Zaman zaman vücudun kene yönünden muayenesi, kene varsa bir cımbız","x0":0.26680316407939403,"x1":0.7742291572918714,"top":0.4635914097362832,"bottom":0.4798772180060773,"conf":1},{"text":"yardımıyla patlatmadan ve koparmadan çıkarılması; kenenın çıkarıldığı yere","x0":0.28947204266638143,"x1":0.7741730678208366,"top":0.47821737544749743,"bottom":0.49137064072402326,"conf":1},{"text":"antiseptiklerin uygulanması,","x0":0.28952772356056855,"x1":0.4640657051404979,"top":0.4912790696254734,"bottom":0.5029914528305286,"conf":1},{"text":"• Vücuttan uzaklaştırılan kenenin çamaşır suyu, alkol veya insektisit vb. içine","x0":0.26687167003679235,"x1":0.7741803163345932,"top":0.5043229022967411,"bottom":0.5186196108520441,"conf":1},{"text":"atılarak öldürülmesi,","x0":0.2874743330393736,"x1":0.4168377839626798,"top":0.5174418605522958,"bottom":0.530523255465146,"conf":1},{"text":"• Kenelerin hiçbir şekilde elle patlatılmaması ve öldürülmemesi,","x0":0.2668672395271755,"x1":0.6735871069059731,"top":0.5319308859390307,"bottom":0.5447597605270433,"conf":1},{"text":"• Ayrıca, keneleri vücuttan uzaklaştırmak amacıyla, gazyağı ve kolonya gibi","x0":0.2647692172458556,"x1":0.7721770917994946,"top":0.5449736611797329,"bottom":0.562378481548573,"conf":1},{"text":"kimyasal maddeleri dökmek veya yanan sıgarayı ve kibriti keneye değdirmek","x0":0.2895277238947977,"x1":0.774127306700685,"top":0.5610465115022086,"bottom":0.5726744187253803,"conf":1},{"text":"gibi yöntemlere başvurulmaması olduğu; bu sebeple de toplumun ve sağlık","x0":0.2895277194389456,"x1":0.7741273022448328,"top":0.5726495727038973,"bottom":0.584302325180777,"conf":1},{"text":"çalışanlarının eğitimlerine devam edilmesi yönünde kanaat håsıl olmuştur.","x0":0.2894464606807654,"x1":0.7454974211246703,"top":0.5828606420271522,"bottom":0.5984708185048289,"conf":1},{"text":"Keyfiyete ilişkin olarak bilgilerinizi, yukarıda belirtilen konular ile halkın ve sağlık","x0":0.24435318491156868,"x1":0.7741273075994655,"top":0.6148255812687937,"bottom":0.6264957264829071,"conf":1},{"text":"çalışanlarının bilgilendirilmesi ve bilinçlendirilmesine yönelik çalışmaların Bakanlığımız","x0":0.19712525886992857,"x1":0.7741273079389469,"top":0.6264534882432347,"bottom":0.6380813954664063,"conf":1},{"text":"gönderilen eğitim materyalleri çerçevesinde yapılmasının temini yanında,","x0":0.26694044441091336,"x1":0.772073929109466,"top":0.639534883595144,"bottom":0.6512820514595603,"conf":1},{"text":"genelgemizin ilgili bütün kurum ve kuruluşlara da ulaştırılmasının sağlanması hususlarında","x0":0.1971252588632442,"x1":0.7741273079322625,"top":0.6495726494332401,"bottom":0.6658119656725563,"conf":1},{"text":"ilgililere emirlerinizi rica ederim.","x0":0.1950718665961785,"x1":0.4045174555625573,"top":0.6627906978181669,"bottom":0.677350427304616,"conf":1},{"text":"Prof. Dr. Necdet ÜNÜVAR","x0":0.5975359389855796,"x1":0.7761806935637329,"top":0.7093023255739243,"bottom":0.7269230765554426,"conf":1},{"text":"Bakan a.","x0":0.6570506245488027,"x1":0.7166660076739326,"top":0.7237684185350614,"bottom":0.7384408837371973,"conf":1},{"text":"Müsteşar","x0":0.6550308007713322,"x1":0.7207392194825413,"top":0.7354651159204811,"bottom":0.751453488658007,"conf":1},{"text":"DAĞITIM:","x0":0.19707760827354973,"x1":0.27109487583514286,"top":0.7484248439833849,"bottom":0.7632030627010415,"conf":1},{"text":"81 İl Valiliğine","x0":0.19486174261038355,"x1":0.2959000192550707,"top":0.7661244356762839,"bottom":0.7817953025202654,"conf":1}]}