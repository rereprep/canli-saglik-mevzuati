{"lines":[{"text":"628","x0":0.06776180820885747,"x1":0.10677617936814461,"top":0.027616278667574323,"bottom":0.04360465140510017,"conf":1},{"text":"6.3.30. Kırım-Kongo Kanamalı Ateşi Genelgesi (2006/81)","x0":0.12927770173916564,"x1":0.7803757293663196,"top":0.11318529221777007,"bottom":0.13775947826570722,"conf":1},{"text":"T. C.","x0":0.4887063650878462,"x1":0.5236139632489093,"top":0.21495726512702085,"bottom":0.22692307709283277,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.43121149779400536,"x1":0.5831622186583163,"top":0.22521367516301338,"bottom":0.23982558123095132,"conf":1},{"text":"Temel Sağlık Hizmetleri Genel Müdürlüğü","x0":0.3733329491073334,"x1":0.6429883174556084,"top":0.23634433103483132,"bottom":0.25726459381987077,"conf":1},{"text":"Sayr : B100TSH0110002-104-02-01","x0":0.21948707883833612,"x1":0.4622215335456744,"top":0.2719065898165782,"bottom":0.29237330954992247,"conf":1},{"text":"Konu : Kınım-Kongo Kanamalı Ateşi","x0":0.21971252593150775,"x1":0.45995893083533934,"top":0.296511628181252,"bottom":0.31540697629813486,"conf":1},{"text":"TSE-ISO-EN","x0":0.7227926076332748,"x1":0.7761806981244255,"top":0.24273255820082384,"bottom":0.24999999990964128,"conf":1},{"text":"9000","x0":0.7371663247162865,"x1":0.7618069811564032,"top":0.2485465115501757,"bottom":0.2572674417637779,"conf":1},{"text":"14.07.06","x0":0.4147843950366516,"x1":0.4825462002469727,"top":0.35174418590512935,"bottom":0.363372093128301,"conf":1},{"text":"11494","x0":0.5482155311916426,"x1":0.5996284111078141,"top":0.3516576334333027,"bottom":0.3634586455866021,"conf":1},{"text":"GENELGE","x0":0.4701865257696525,"x1":0.5462405787475777,"top":0.40248683231375304,"bottom":0.41437363277000383,"conf":1},{"text":"(2006/81)","x0":0.47433264965723304,"x1":0.5420944548675541,"top":0.41424418590253387,"bottom":0.4258720931257054,"conf":1},{"text":"Ilgi: a) 30/12/2003 tarihli ve B100TSH0110002/20 409 sayıl genelge.","x0":0.21765914485775517,"x1":0.6652977337780809,"top":0.43888888897103095,"bottom":0.45213675221889427,"conf":1},{"text":"b) 31/03/2004 tarihli ve B100TSH0110002/5367 (2004/46) sayıl genelge.","x0":0.26270695989240367,"x1":0.7188562629550549,"top":0.4486290136057097,"bottom":0.4655036823465284,"conf":1},{"text":"c) 06/08/2004 tarihli ve B100TSH0110002/12 875 sayıl yazı.","x0":0.26283367663003965,"x1":0.6468172471763478,"top":0.46366279050400117,"bottom":0.47692307678627155,"conf":1},{"text":"g) 11/03/2005 tarihli ve B100TSH0110002/3580 (2005/40) sayılı genelge.","x0":0.2648870548758274,"x1":0.7186858401950347,"top":0.4767441858537458,"bottom":0.4898255815817022,"conf":1},{"text":"d) 10/03/2006 tarihli ve B100TSH0110002/3079 sayılı yazı.","x0":0.26462308933363693,"x1":0.6368911941174943,"top":0.4834903588853531,"bottom":0.5033583390598823,"conf":1},{"text":"Ulkemizde 2002 yılından beri görülmeye başlayan ve önemli bir halk sağlığı problemi","x0":0.2648870666586644,"x1":0.7967145758456733,"top":0.5130813951567424,"bottom":0.5261627908846989,"conf":1},{"text":"olan Kırım-Kongo kanamalı ateşi (KKKA) ile ilgili bütün uygulamaların ilgi genelge ve","x0":0.22168266549990312,"x1":0.7988439816392812,"top":0.523017260167483,"bottom":0.5387455757001999,"conf":1},{"text":"yazılar çerçevesinde yapıldığı malumunuzdur.","x0":0.21963568201274836,"x1":0.5052558397919484,"top":0.5377909416426387,"bottom":0.5509154784992656,"conf":1},{"text":"Hastalıkla mücadele kapsamında başarılı birçok çahışma Bakanlığımızın eş","x0":0.26694045393925575,"x1":0.7967145766271524,"top":0.5623931622673761,"bottom":0.5741279070973855,"conf":1},{"text":"güdümünde gerçekleştirilmiştir. Ancak, uygulamada zaman zaman aşağıda belirtilen aksakhk","x0":0.2196384364254304,"x1":0.7967953243793491,"top":0.5737678451321256,"bottom":0.5900703891635133,"conf":1},{"text":"ve olumsuzluklarla da karşılaşılmaktadır.","x0":0.22176591012860797,"x1":0.4743326524778843,"top":0.5871794872334629,"bottom":0.5988372094131692,"conf":1},{"text":"Belirlenen aksaklıklar genel olarak:","x0":0.2648870656540803,"x1":0.4845995871160192,"top":0.6119186045223587,"bottom":0.6235465117455303,"conf":1},{"text":"• İlgi (a) yazı ekinde örneği ve doldurma talimatı yer alan Kırım-Kongo Kanamalı Ateşi","x0":0.21964334190543458,"x1":0.7967692325611366,"top":0.627818909024188,"bottom":0.6437961865353934,"conf":1},{"text":"Vaka Bildirim Çizelgesi'nin yapılan vaka tanımları çerçevesinde doğru ve okunaklı olarak","x0":0.2443531752605983,"x1":0.7967145863402726,"top":0.6409883722419388,"bottom":0.6555555558750747,"conf":1},{"text":"doldurulmadığı, epi numaralarının yazılmadığı ve birer nüshalarının Bakanlığımıza","x0":0.2443531752567936,"x1":0.7967145863364679,"top":0.6540697673162738,"bottom":0.6658119658854167,"conf":1},{"text":"Her ay sonunda Bakanlığımıza bildirilmesi gereken kesin KKKA vaka ve ölüm","x0":0.21964653130620862,"x1":0.7967971828989384,"top":0.6816117500736688,"bottom":0.6973667839742639,"conf":1},{"text":"imallerinin gönderilmediği.","x0":0.24229979920940772,"x1":0.42094455378756107,"top":0.6961538460403599,"bottom":0.7078488373232875,"conf":1},{"text":"• Kan ve serum örneklerinin, biyogüvenlik önlemleri alınmadan uygun olmayan şartlarda,","x0":0.21971252076836584,"x1":0.7967145698373841,"top":0.7106837609759736,"bottom":0.7252906973410849,"conf":1},{"text":"bazen de hasta sahipleri ile laboratuvara yollandığı,","x0":0.24229981058858535,"x1":0.5585215528611065,"top":0.7252136751146565,"bottom":0.7369186041730249,"conf":1},{"text":"/ Hastalara ait ikinci numunelerin alınmasında gerekli titizliğin gösterilmediği; ancak,","x0":0.21962073531897455,"x1":0.7947565625276354,"top":0.7412051277703559,"bottom":0.7569433109793757,"conf":1},{"text":"şikâyeti olmayan kişilerden \"temaslı\" diye bahsedilerek numune ahındığı ve laboratuvara","x0":0.24435319339519299,"x1":0.7967145675733217,"top":0.7558139536518599,"bottom":0.76889534856471,"conf":1},{"text":"gönderildiği şeklindedir.","x0":0.2422997934677024,"x1":0.39425051433201336,"top":0.76880341891657,"bottom":0.7820512821644332,"conf":1},{"text":"KKKA vakalarının ve pideminin doğru bir şekilde izlenmesi yanında, gerekli kontrol","x0":0.26694045395379296,"x1":0.7967145766416897,"top":0.7978632477753911,"bottom":0.8111111110232543,"conf":1},{"text":"ve korunma önlemlerinin alınması için söz konusu aksaklıkların giderilmesinin önemi","x0":0.22176591502317805,"x1":0.7967145775930844,"top":0.8110465115025157,"bottom":0.8226744187256874,"conf":1},{"text":"bilgileriniz dâhilindedir.","x0":0.219712524466383,"x1":0.37166324533069395,"top":0.823931623960986,"bottom":0.8358974359267979,"conf":1}]}