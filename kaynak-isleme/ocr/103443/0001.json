{"lines":[{"text":"606","x0":0.06570841776082709,"x1":0.10472279353280742,"top":0.030523255656540016,"bottom":0.04215116287971166,"conf":1},{"text":"6.3.25. Akkız İmmun Yetersizliği Sendromu Genelgesi","x0":0.11896121617724921,"x1":0.7413843812552798,"top":0.11107774787717273,"bottom":0.13397600699932033,"conf":1},{"text":"SAGLIK VE SOSYAL YARDIM","x0":0.3696098571354378,"x1":0.562628335658148,"top":0.20494186033498119,"bottom":0.21666666657444345,"conf":1},{"text":"BAKANLIGI","x0":0.4145286704902175,"x1":0.49512225472847515,"top":0.2139933856749634,"bottom":0.22641359084829282,"conf":1},{"text":"Tedavi Hizmetleri Genel","x0":0.3798767959841095,"x1":0.5687885015085956,"top":0.22674418591564793,"bottom":0.2384615384159765,"conf":1},{"text":"Müdürlüğü","x0":0.4146582369324805,"x1":0.4970460757919925,"top":0.23796547854287486,"bottom":0.2518601025193623,"conf":1},{"text":"EL: /","x0":0.6948305473144316,"x1":0.7570158232582846,"top":0.23048513085318723,"bottom":0.24995234610592498,"conf":1},{"text":"Th. II-Sb.Ma.5590-5687","x0":0.1967750219388499,"x1":0.37409764949420815,"top":0.27972615206722684,"bottom":0.29643718333705027,"conf":1},{"text":"Konu: Acquired Immune","x0":0.19917864449265357,"x1":0.36550308007613497,"top":0.29941860458581626,"bottom":0.30959302330420324,"conf":1},{"text":"Deficiency Syndrome","x0":0.2400033413455867,"x1":0.39651711359279046,"top":0.30948783027508464,"bottom":0.3224885296688542,"conf":0.5},{"text":"(Akkia İmmun Yetersizlik","x0":0.2380438251209736,"x1":0.4376221806818299,"top":0.31904186453277483,"bottom":0.3332011168299398,"conf":1},{"text":"Sendromu)","x0":0.24640657247520983,"x1":0.3244353147937842,"top":0.3313953486531611,"bottom":0.3415697673715481,"conf":1},{"text":"ANKARA","x0":0.7308759682213689,"x1":0.782471054131119,"top":0.2845907532492611,"bottom":0.296804595527114,"conf":1},{"text":"16 Agustos 1983","x0":0.7204564085402806,"x1":0.8483399783337973,"top":0.2961993675026404,"bottom":0.3116436592613816,"conf":1},{"text":"..VALILIĞINE","x0":0.46406570675402564,"x1":0.566735114738103,"top":0.3822674416726519,"bottom":0.39389534889582356,"conf":1},{"text":"/ Memleketimizde AIDS olguları saptanmamıştır. AIDS'in görüldüğü Amerika","x0":0.20300054943035795,"x1":0.8051446177873712,"top":0.4286227394946809,"bottom":0.44906900332149124,"conf":1},{"text":"Birleşik Devletleri ve Avrupa Ulkeleri ile sıkı ilişkilerimiz olması nedeniyle","x0":0.19287023148844737,"x1":0.8359019502856813,"top":0.44578753185430764,"bottom":0.4638756851391467,"conf":1},{"text":"uyanık bulunmamiz gerekir.","x0":0.19284313554436316,"x1":0.4088033418033376,"top":0.4642654202567924,"bottom":0.477408205712219,"conf":1},{"text":"AIDS yeni tarif edilmiş bir sendrom olup etkeni henüz saptanmamıętır.","x0":0.22563479145066992,"x1":0.7948456696129848,"top":0.4809305984560108,"bottom":0.49978831148696456,"conf":1},{"text":"Muhtemel etken bir virus olarak düşünülmektedir. Çok yakın temas (cinsel) ve","x0":0.19074922635120142,"x1":0.8194547319437044,"top":0.4983029823380962,"bottom":0.5174492087482692,"conf":1},{"text":"kan ve kan ürünleri-kullanımı ile geçmektedir (Hepatit B benzeri).","x0":0.19077524675614996,"x1":0.7353639746034142,"top":0.5130824255134461,"bottom":0.5320658246682396,"conf":1},{"text":"Bu hastalık kişinin hücresel direncini kırmaktadır. Burada bilhassa T len-","x0":0.22360549902934224,"x1":0.8338183117182781,"top":0.5318702075908668,"bottom":0.5500373968384545,"conf":1},{"text":"fosit subpopulasyonları etkilennektedir. Bunun sonucunda da hastalarda non-","x0":0.19071945459203568,"x1":0.8092176974880454,"top":0.5474173416277494,"bottom":0.5668589128226508,"conf":1},{"text":"spesifik bulgular yanında halsizlik, sebepsiz kilo kaybı, ateş, yaygın len-","x0":0.18870063945311813,"x1":0.8092007911922733,"top":0.564163853268581,"bottom":0.5846379611250054,"conf":1},{"text":"fadenomegali, uzun süreli ishal, öksürük, menenjit, prömoni, ansefalit, oral","x0":0.18866165213735722,"x1":0.8153994197178439,"top":0.5811137154945741,"bottom":0.6012877452442569,"conf":1},{"text":"ve intestinal kandidiazis, herpes zoster v.b. gibi ağır enfeksiyonlar oluşmakta","x0":0.1887034236663924,"x1":0.8400333406054415,"top":0.5981682065183853,"bottom":0.6175217177092073,"conf":1},{"text":"veya kaposi sarkomu, lenfoma v.b. gibi malign oluşumlar meydana çıkmaktadır.","x0":0.18871911354311519,"x1":0.813379619324554,"top":0.6152607747640454,"bottom":0.6337987819296771,"conf":1},{"text":"Prognoz kötü olup yeterli bir tedavisi yoktur. Tartışmalı olmakla beraber","x0":0.18663183162953031,"x1":0.7907295416081805,"top":0.6321797058604824,"bottom":0.6507434573420195,"conf":1},{"text":"kortikosteroidlerin kullanılması denenmektedir. Kesin tani için (etkene yönelik)","x0":0.18664616765771105,"x1":0.8461700727740956,"top":0.6484435459681719,"bottom":0.6677308754218604,"conf":1},{"text":"elimizde herhangi bir laboratuvar testi yoktur. Hücresel direncin laboratuvar","x0":0.18662470774270298,"x1":0.8215327727083167,"top":0.6652293071313892,"bottom":0.6846153263898068,"conf":1},{"text":"testleri ile tamamiyle bozulduğu saptanır. Kuluçka süresi uzun olup 6 ay ile-","x0":0.18661206680804873,"x1":0.8194527595888075,"top":0.6809509868743302,"bottom":0.7010899132581068,"conf":1},{"text":"3 yıl arasında değişmektedir. Portörlüğü saptayacak bir laboratuvar testi de","x0":0.1845645344182584,"x1":0.8113163245860335,"top":0.6980226718957836,"bottom":0.7182120166768604,"conf":1},{"text":"yoktur. Aya memleketlerinde ve Çin'de bugüne kadar rastlanmamıştır. Genelik","x0":0.1845676447083481,"x1":0.8113065931382908,"top":0.7145563485617196,"bottom":0.7353363152584343,"conf":1},{"text":"dispozisyon da düşünülmektedir.","x0":0.18454712737009757,"x1":0.43968636870974764,"top":0.7323433799371304,"bottom":0.7471732470474235,"conf":1},{"text":"(.%..)","x0":0.45174537974536555,"x1":0.5051334702365162,"top":0.7732558140623864,"bottom":0.7877906974800213,"conf":1}]}