{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453731780507,"x1":0.9589322443757156,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"-2","x0":0.45585215633846315,"x1":0.4804928127785799,"top":0.22529069776159816,"bottom":0.23837209267444837,"conf":1},{"text":"Hastalık nedeni kesinleşmediği için korunmada gerekli etkin tedbirler","x0":0.22582730774790183,"x1":0.7967836290121665,"top":0.2758490763485749,"bottom":0.29045425126907265,"conf":1},{"text":"bu gün için kesinlikle bilinmemektedir. Bununla beraber kan ve kan ürünleri","x0":0.19498221638624405,"x1":0.8112202765221834,"top":0.29181895381753264,"bottom":0.30830541679371115,"conf":1},{"text":"ile de geçmesi nedeni ile aşağidaki önlemler önerilmektedir.","x0":0.19497357523621311,"x1":0.6900178452823135,"top":0.3094171034672133,"bottom":0.3239956130017393,"conf":1},{"text":"1-Ken ve kan ürünlerinin sağlanmasında milli imkânların gerektirdiği üst","x0":0.22792608587494964,"x1":0.8193018404377519,"top":0.3239316238281924,"bottom":0.338662790537375,"conf":1},{"text":"düzeye erişilmeli, milli yeterlilik sağlammalığar.","x0":0.1950718616117546,"x1":0.6057494935480643,"top":0.3444444445903039,"bottom":0.3576923078381671,"conf":1},{"text":"a)Bu suretle dıg Ilkelerden kan ve bilhassa kan ürünlerinin vaktör VIII,","x0":0.22785456896645453,"x1":0.8193480763609339,"top":0.35895960241663083,"bottom":0.3739636186081622,"conf":1},{"text":"antihemofilik globulin, fibrinojen, çoşitli immanoglobulinler (Kizamık, Kaza-","x0":0.1949792013606808,"x1":0.8276132454866632,"top":0.37556542898723166,"bottom":0.39240127747762876,"conf":0.5},{"text":"mikçik, Kabakulak, Su çiveği, Tetanos, Hepatit 8 v.b.) ithallerinde azami","x0":0.19507186101250826,"x1":0.7946611984733041,"top":0.3938953486438248,"bottom":0.4069767443717811,"conf":1},{"text":"titizlik gösterilmelidir.","x0":0.19507186564008322,"x1":0.4024640681073501,"top":0.4113372091500421,"bottom":0.42307692327532487,"conf":1