{"lines":[{"text":"T.C.","x0":0.455852154907901,"x1":0.49486653067988134,"top":0.08866279053812343,"bottom":0.10029069776129518,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4268978624430838,"x1":0.5957892064327963,"top":0.09985638677474917,"bottom":0.11683568255424637,"conf":1},{"text":"Temel Sağlık Hizmetleri Genel Müdürlüğü","x0":0.35700343447063093,"x1":0.6656065021108686,"top":0.1151561090513139,"bottom":0.1339940410837116,"conf":1},{"text":"Say1 : B100TSH0110002","x0":0.1414800990705294,"x1":0.3430987041803012,"top":0.14378249328701553,"bottom":0.15986721484411104,"conf":1},{"text":"Konu : Şarbon Antiserumu","x0":0.14350316816220596,"x1":0.34725658303122614,"top":0.16411437559480202,"bottom":0.1789088801354003,"conf":1},{"text":"13.05.05.* 5000","x0":0.44522277703789476,"x1":0.6329635780730274,"top":0.1792536140416947,"bottom":0.20054368238281128,"conf":1},{"text":"BAKANLIK MAKAMINA","x0":0.4084736388271049,"x1":0.6080050556220906,"top":0.22495461080691537,"bottom":0.2400734852508173,"conf":1},{"text":"Ulkemizde, Refik Saydam Hıfzıssıhha Merkezi Başkanlığı tarafından üretilen ve şarbon","x0":0.19273052602198484,"x1":0.8770619379164453,"top":0.25200310208613996,"bottom":0.27524687496780276,"conf":1},{"text":"hastalığı tedavisinde çok az da olsa bazı vak'alarda kullanıldığı bildirilen hayvan kaynaklı şarbon","x0":0.13729532742282402,"x1":0.8770609789919368,"top":0.26621524529008145,"bottom":0.2898089049763085,"conf":1},{"text":"antiserumunun, tedavideki yerinin ne olduğu konusunda ilgili kurumlar ile uzmanların fikirlerine","x0":0.13735041680620053,"x1":0.8770212314033892,"top":0.28170300417876926,"bottom":0.3041716313911633,"conf":1},{"text":"başvurulmuş olup, tarafımıza ulaşan görüşlerin değerlendirilmesi neticesinde ;","x0":0.13733636352144185,"x1":0.6984868371011161,"top":0.29464383013975914,"bottom":0.31696426451444615,"conf":1},{"text":"v Insan şarbonunda antiserum uygulamasının, 1960'lı yıllardan beri batı dünyasında terk edildiği,","x0":0.1680893894739003,"x1":0.8709115015884711,"top":0.31753369838285783,"bottom":0.34015502760075234,"conf":1},{"text":"v Dünya Sağlık Teşkilâtı tarafindan hazırlanan Guidelines for the Surveillance and Control of","x0":0.16396044578524577,"x1":0.8770482726443751,"top":0.33701951267732877,"bottom":0.3617502920480198,"conf":1},{"text":"Anthrax in Humans and Animals WHO/EMC/ZDI/98.6\" adlı kılavuzda da tedavide","x0":0.1907696045215188,"x1":0.8749931162969495,"top":0.3520392156165948,"bottom":0.3731231794509171,"conf":1},{"text":"antibakteriyel şarbon antiserumunun önerilmediği,","x0":0.18868298662530172,"x1":0.5526637423217196,"top":0.3670394797578246,"bottom":0.38673602841536414,"conf":1},{"text":"V Sadece sistemik şarbon olgularının tedavisinde, aşılanmış insanlardan hazırlanan spesifik","x0":0.16398374687965242,"x1":0.8749486278264103,"top":0.38792800286385354,"bottom":0.411521850024519,"conf":1},{"text":"antitoksik human gammaglobulinin, antimikrobiyel tedavi ile birlikte verilmesi konusunda","x0":0.18874776801822657,"x1":0.8728864800421081,"top":0.4037932010973818,"bottom":0.4237263979232406,"conf":1},{"text":"görüş birliğinin bulunduğu; ancak, dünyada da henüz bu antiserumu hazırlayıp kullanımını","x0":0.18871259786515415,"x1":0.8729276960882119,"top":0.41833944448128335,"bottom":0.44003604625114645,"conf":1},{"text":"sürekli kılan bir ülkenin bulunmadığı,","x0":0.18658268677907616,"x1":0.46444645335820256,"top":0.432142586223317,"bottom":0.4509137121471911,"conf":1},{"text":"v Bacillus anthracis'in biyolojik silah olarak da kullanılabilme potansiyelinin olması","x0":0.16191103023229406,"x1":0.8729762833828004,"top":0.4518438478412238,"bottom":0.47634975162321247,"conf":1},{"text":"keyfiyetinden ötürü, Refik Saydam Hıfzıssıhha Merkezi Başkanlığında şarbonla ilgili her türlü","x0":0.18659688012106426,"x1":0.8729169901053826,"top":0.46752735983137206,"bottom":0.49048179689160587,"conf":1},{"text":"çalışmayı yapabilecek bir lâboratuvar kurulmasının uygun olacağı kanaatine varılmıştır.","x0":0.1866879972179325,"x1":0.8133515188888818,"top":0.48382011633753885,"bottom":0.503253713347964,"conf":1},{"text":"Bu nedenle, şarbon hastalığının tedavisinde antiserum kullanımının uygulamadan kaldırılması","x0":0.1866652033565822,"x1":0.8708306320994026,"top":0.5044953033140611,"bottom":0.5245035681654274,"conf":1},{"text":"ve dolayısıyla da hayvan kaynaklı şarbon antiserumu üretimine son verilmesi hususlarında takdir ve","x0":0.13328514270935152,"x1":0.8708392846569029,"top":0.5185360700166137,"bottom":0.5398433436205258,"conf":1},{"text":"tensiplerinizi arz ederim.","x0":0.13118529691136588,"x1":0.31854248793029727,"top":0.5330306920289877,"bottom":0.54952360249563,"conf":1},{"text":"petinet","x0":0.6098562619393442,"x1":0.7392197128626504,"top":0.5436046509276196,"bottom":0.5712209300732108,"conf":0.30000001192092896},{"text":"Uzm. Dr. Mehmet UGURLU","x0":0.6036960973490001,"x1":0.815195072814491,"top":0.5811965812442498,"bottom":0.5959302323972926,"conf":1},{"text":"Genel Müdür","x0":0.6550120659677678,"x1":0.755665551746798,"top":0.5958580652808166,"bottom":0.6090837951334768,"conf":1},{"text":"Uygun Görüşle Arz Ederim","x0":0.13141684030715606,"x1":0.3326488648263142,"top":0.605982905622198,"bottom":0.6222222218615143,"conf":1},{"text":"/2005","x0":0.21743552320090104,"x1":0.2651106778626585,"top":0.6216238446787582,"bottom":0.6341901087416234,"conf":1},{"text":"1 4","x0":0.1853281711545948,"x1":0.26997506727703946,"top":0.6316054586538735,"bottom":0.6508461884830585,"conf":0.5},{"text":"POT D ASERH ONDVAR","x0":0.12912113117760485,"x1":0.33494457514275555,"top":0.6389171745212258,"bottom":0.6808502668178588,"conf":0.30000001192092896},{"text":"Müsteşar","x0":0.17620188703100606,"x1":0.2549679222285858,"top":0.6666623769263937,"bottom":0.6796810306656056,"conf":1},{"text":"OLUR","x0":0.4670220637785287,"x1":0.5330786670222631,"top":0.6886381074505424,"bottom":0.7112576792993547,"conf":1},{"text":"/ 2005","x0":0.4866529773707082,"x1":0.5523613960819173,