text":"Gerekmektedir.","x0":0.2689938410114258,"x1":0.36755646677189285,"top":0.5552325580024784,"bottom":0.56686046522565,"conf":1},{"text":"Bilgilerinizi ve konunun iliniz dähilindeki Bakanlığımıza bağlı tüm döner sermayeli","x0":0.2710472286381454,"x1":0.7967145783278182,"top":0.5712209301049399,"bottom":0.5829059827973206,"conf":1},{"text":"kurum ve kuruluşlarına duyurulması hususunda gereğini önemle rica ederim.","x0":0.22792608673408582,"x1":0.6796714486526356,"top":0.5841880343259651,"bottom":0.5959302320800017,"conf":1},{"text":"Prof. Dr. Nihat TOSUN","x0":0.5770020555000475,"x1":0.7227926076416361,"top":0.6235042734168522,"bottom":0.6351744182234125,"conf":1},{"text":"Bakan a.","x0":0.6262833666640757,"x1":0.6796714571552264,"top":0.6366279071578558,"bottom":0.6470085469432311,"conf":1},{"text":"Müsteşar","x0":0.6198058247461262,"x1":0.6798726982803969,"top":0.648710795426994,"bottom":0.6611551660554161,"conf":1},{"text":"DAĞITIM:","x0":0.22366332241368622,"x1":0.30414408017659056,"top":0.681756215846283,"bottom":0.6955800331727553,"conf":1},{"text":"Gereği:","x0":0.2258726897402465,"x1":0.2792607802313972,"top":0.6962209304194055,"bottom":0.7093023253322556,"conf":1},{"text":"81 Il Valiliği (İl Sağhk Müdürlüğü)","x0":0.2255819712645192,"x1":0.4397129125609502,"top":0.7047731392652541,"bottom":0.722673531194424,"conf":1},{"text":"Bilgi:","x0":0.5215605739102387,"x1":0.5667351137922483,"top":0.6962209304142145,"bottom":0.7093023253270647,"conf":1},{"text":"Teftiş Kurulu Başkanlığına","x0":0.5215605754576073,"x1":0.6919917840393126,"top":0.7063953488071709,"bottom":0.7209401708153528,"conf":1},{"text":"Iç Denetim Birimi Başkanlığına","x0":0.521560578392441,"x1":0.7207392164124871,"top":0.717948717686484,"bottom":0.7325581393105617,"conf":1},{"text":"Tedavi Hizmetleri Genel Müdürlüğüne","x0":0.5212452127669764,"x1":0.7620784998503728,"top":0.7279245628760727,"bottom":0.7461040308842607,"conf":1},{"text":"861","x0":0.8952772069705462,"x1":0.9301848051316094,"to