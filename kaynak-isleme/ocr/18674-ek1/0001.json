{"lines":[{"text":"SAĞLIK HİZMETLERİ GENEL MÜDÜRLÜĞÜ - SAĞLIK","x0":0.679604076803627,"x1":0.9405490513988489,"top":0.022064704788979927,"bottom":0.033489700276551626,"conf":1},{"text":"TURİZMI DAIRE BAŞKANLIGI","x0":0.6796714560527359,"x1":0.8275154020581471,"top":0.03333333313771758,"bottom":0.04230769211207652,"conf":1},{"text":"15/03/2017 17:06 - 75000571 - 010.06.02 - E.02-46","x0":0.6796714606389822,"x1":0.8993839806302073,"top":0.042151162863060865,"bottom":0.04957264946493112,"conf":1},{"text":"T.C.","x0":0.4558521567433963,"x1":0.5092402455409978,"top":0.05523255824576101,"bottom":0.06976744166339599,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.3860369613675177,"x1":0.5893223813660552,"top":0.06965811995233073,"bottom":0.0843023254206634,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.33047268689589715,"x1":0.6428520908625337,"top":0.08729891493223207,"bottom":0.10484096495967188,"conf":1},{"text":"00041438662","x0":0.7782340856168328,"x1":0.8542094438150631,"top":0.08284883707343149,"bottom":0.0915697672870337,"conf":1},{"text":"TC Saglik Bakar","x0":0.11909650883821472,"x1":0.1971252568390922,"top":0.10465116285551024,"bottom":0.11196581185054288,"conf":1},{"text":"Sayı: 75000571-020","x0":0.10677618526056952,"x1":0.2833675516460617,"top":0.1307692307195627,"bottom":0.14700854695887888,"conf":1},{"text":"Konu: Sağlık Turizmi Bölge","x0":0.10677618287124498,"x1":0.34496919726492703,"top":0.14680232521706937,"bottom":0.16282051291112987,"conf":1},{"text":"Koordinatörlüğü Sistemi","x0":0.16221765951112652,"x1":0.36550307950966404,"top":0.16279069734384,"bottom":0.17877907008136584,"conf":1},{"text":"GENELGE","x0":0.441421290053733,"x1":0.5359914407515978,"top":0.2090925117292709,"bottom":0.2225935347528274,"conf":1},{"text":"2017/2","x0":0.4558521567988987,"x1":0.5256673501963101,"top":0.22674418624270287,"bottom":0.23982558115555297,"conf":1},{"text":"Sağlık turizmi, hastaların sağlık hizmeti almak amacıyla başka bir ülkeye gerçekleştirdiği","x0":0.16632446369011852,"x1":0.8624229756117294,"top":0.25726495693446993,"bottom":0.27325581330074966,"conf":1},{"text":"seyahat olarak adlandırılmakta olup dünyada hızla gelişmiş ve hizmet ihracatı kapsamında","x0":0.10669561386891059,"x1":0.862506779941148,"top":0.2721765882212034,"bottom":0.29077671626461443,"conf":1},{"text":"değerlendirilerek, ülke ekonomileri açısından katma değeri en yüksek sektörlerden birisi haline","x0":0.1067761972533015,"x1":0.862422981201822,"top":0.28924418572181565,"bottom":0.3052325584593415,"conf":1},{"text":"gelmiştir.","x0":0.10654015953420214,"x1":0.18282747059058801,"top":0.3050953077424743,"bottom":0.31929882112430175,"conf":1},{"text":"Ülkemiz özellikle \"Sağlıkta Dönüşüm Programı\" ile ulaştığı kaliteli sağlık hizmeti sunumu","x0":0.1663244237015891,"x1":0.8624230093371567,"top":0.3183139531635083,"bottom":0.33430232590103415,"conf":1},{"text":"sayesinde, hem kendi vatandaşlarımıza hak ettiği sağlık hizmetini sunmakta, hem de hızla gelişen","x0":0.10677619724759758,"x1":0.862422981196118,"top":0.3341880339773493,"bottom":0.3488372091485086,"conf":1},{"text":"sağlık turizmi potansiyeli ile dünyada en çok tercih edilen ülkeler arasında üst sıralara yükselmektedir.","x0":0.10677616645652595,"x1":0.8644764001002834,"top":0.3487179488104504,"bottom":0.36337209286933003,"conf":1},{"text":"Onuncu Kalkınma Eylem Planında önemli bir yere sahip olan Sağlık Turizminin geliştirilmesi","x0":0.1663244480167899,"x1":0.8706365375774783,"top":0.3632478636420311,"bottom":0.37790697658863115,"conf":1},{"text":"ve sağlık turizmi alanında hizmet veren kurum, kuruluş ve ilgili paydaşlar arasındaki koordinasyonun","x0":0.10671110673904056,"x1":0.8707075442909351,"top":0.3775036153042919,"bottom":0.3953250332187884,"conf":1},{"text":"artırılması amacıyla, \"Sağlık Turizmi Bölge Koordinatörlüğü\" yapılanması planlanmıştır. \"Sağlık","x0":0.1067761847900125,"x1":0.8706365463776106,"top":0.39230769201652027,"bottom":0.40854700825583645,"conf":1},{"text":"Turizmi Bölge Koordinatörlüğü\" kapsamında ekteki şekilde 8 (sekiz) Sağlık Turizmi Bölge","x0":0.10882957264245725,"x1":0.8726899342300554,"top":0.40683760684669346,"bottom":0.42307692308600964,"conf":1},{"text":"Koordinatörlüğü oluşturulmuştur.","x0":0.1088295670116561,"x1":0.36139630541674556,"top":0.4243589740669851,"bottom":0.43895348821279534,"conf":1},{"text":"Sağlık Turizmi Bölge Koordinatörleri, kendisine bağlı illerde Yabancı Hasta Takip Sistemine","x0":0.1683778360177106,"x1":0.872689925578399,"top":0.438888888905669,"bottom":0.4534883719391998,"conf":1},{"text":"veri girişlerini yöneten ve Bakanlığımızca kullanıcı yetkisi tanımlanmış II Temsilcilerinin (II Admini)","x0":0.10677619067138094,"x1":0.8726899282402594,"top":0.4534188032646653,"bottom":0.4696581195039815,"conf":1},{"text":"çalışmalarını koordine etmekle görevlendirilmiştir. Sağlık Turizmi Bölge Koordinatörleri, Sağlık","x0":0.10882957005618392,"x1":0.8706365556625019,"top":0.46794871790051107,"bottom":0.48418803413982725,"conf":1},{"text":"Turizmi Daire Başkanlığı ile kendilerine bağlı iller arasında etkili bir iletişimin sağlanmasından","x0":0.10882957269440094,"x1":0.8726899342819991,"top":0.48401162805661135,"bottom":0.4987179486969796,"conf":1},{"text":"sorumludur. Yabancı Hasta Takip Sistemi kullanıcı yetkisi tanımlanmış II Temsilcileri ise sorumlu","x0":0.10882957276120411,"x1":0.8726899343488023,"top":0.4985465113009806,"bottom":0.5145348840385064,"conf":1},{"text":"oldukları ildeki sağlık turizmi faaliyeti gösteren sağlık kuruluşlarının, sisteme veri girişlerinin","x0":0.10882957305235473,"x1":0.8726899346399528,"top":0.513081395016337,"bottom":0.5290697677538628,"conf":1},{"text":"sağlanmasından ve Bakanlıkça talep edilecek uluslararası hastalara ait istatistikî bilgilerin toplanarak","x0":0.10882957269922969,"x1":0.8726899342868278,"top":0.5290598290009536,"bottom":0.5436046510091355,"conf":1},{"text":"bağlı bulundukları Sağlık Turizmi Bölge Koordinatörlerine iletilmesinden sorumludur.","x0":0.1088295532457784,"x1":0.753593444493514,"top":0.5448717950497733,"bottom":0.5581395350711774,"conf":1},{"text":"Bunun yanı sıra Sağlık Turizmi Bölge Koordinatörleri ve Yabancı Hasta Takip Sistemi İl","x0":0.16832732590612676,"x1":0.8727575052256468,"top":0.5568481842618975,"bottom":0.5743061332563303,"conf":1},{"text":"Temsilcileri, sorumlu oldukları bölgedeki sağlık turizminin geliştirilmesine yönelik faaliyetlerin teşvik","x0":0.10879010242763802,"x1":0.8727399527588202,"top":0.5726464881091526,"bottom":0.5899565124358358,"conf":1},{"text":"edilmesini sağlar.","x0":0.10859049324105628,"x1":0.24462931491755935,"top":0.5884214171404976,"bottom":0.6033183609745905,"conf":1},{"text":"Keyfiyetin ilgililere tebliği ile görevlendirilen personele gerekli kolaylığın sağlanması, Sağlık","x0":0.16837783602077905,"x1":0.8726899255814674,"top":0.6029914526860201,"bottom":0.6177325579857497,"conf":1},{"text":"Turizmi Bölge Koordinatörlüğü uygulamasının bu genelge kapsamında yürütülmesi ve uygulamanın","x0":0.1108046311910169,"x1":0.8727502727501202,"top":0.6175661514543503,"bottom":0.6357623967945509,"conf":1},{"text":"titizlikle takibi hususlarında gereğini önemle rica ederim.","x0":0.10882957491045529,"x1":0.5359342852912675,"top":0.633720929905279,"bottom":0.6497093026428049,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.6529774173483228,"x1":0.835728948534634,"top":0.6802325577773126,"bottom":0.6962209305148385,"conf":1},{"text":"Bakan a.","x0":0.7145559967328974,"x1":0.7803105324263747,"top":0.69615534814445,"bottom":0.7079144190054839,"conf":1},{"text":"Müsteşar","x0":0.7104287425240805,"x1":0.7803310105329899,"top":0.7120920070722917,"bottom":0.7254079928252778,"conf":1},{"text":"EK: Sağlık Turizmi Bölge Koordinatörlükleri ve Bağlı Iller","x0":0.11080039772151151,"x1":0.5565598991556903,"top":0.7426084673282073,"bottom":0.7601377886563948,"conf":1},{"text":"DAĞITIM:","x0":0.11067010751188987,"x1":0.20571890135989995,"top":0.7759563545899743,"bottom":0.791864