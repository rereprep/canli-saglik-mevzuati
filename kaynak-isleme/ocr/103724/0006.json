{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"toplantısında en az iki kurum/kuruluş sırasıyla yaptıkları faaliyetleri, yaşadıkları sorunları ve","x0":0.201107295098052,"x1":0.7270332877201046,"top":0.2303189655521899,"bottom":0.24706290918231066,"conf":1},{"text":"yapacaklarını kurula arz edecektir.","x0":0.19903572460745922,"x1":0.39434964531696076,"top":0.24578024313629965,"bottom":0.2574598338016767,"conf":1},{"text":"Kurum/kuruluş amirlerinin yaptıgı sunumla başlayan toplantılar diğer üyelerin katkı sağladığı","x0":0.1990762529330181,"x1":0.7249486645110108,"top":0.25686858570277515,"bottom":0.273683168886129,"conf":1},{"text":"gündem maddeleri ile devam edecektir. Ihtiyaç duyulduğunda katkı sağlaması amacıyla bu","x0":0.19910696407663162,"x1":0.7249198165601941,"top":0.2702886293122425,"bottom":0.28378414221752646,"conf":1},{"text":"belgede yer almayan diğer kurum ve kuruluşlar da Kurul toplantılarına davet edilir.","x0":0.19701034017703078,"x1":0.6633407796419643,"top":0.28328201948047615,"bottom":0.2996142610930981,"conf":1},{"text":"(4) Kurul kararları, Ek 2'te yer alan karar belgesine işlenerek üyelerce imzalanır. Kararla ilgili","x0":0.19698864160634189,"x1":0.7249946636433544,"top":0.2960779544873242,"bottom":0.31253506793263885,"conf":1},{"text":"farklı görüşü olanlar, bu görüşlerini karar belgesinde belirtebilir.","x0":0.19909573671479286,"x1":0.5565507124011025,"top":0.31081253396304054,"bottom":0.3243228663151164,"conf":1},{"text":"(5) Kurul toplantılarında alınan herhangi bir kararın bilimsel açıdan değerlendirilmesi","x0":0.19917864538697586,"x1":0.7248459950766486,"top":0.3239316239671334,"bottom":0.3358974359329454,"conf":1},{"text":"ihtiyacının ortaya çıkması durumunda ilgili Bakanlıklarca kurulmuş olan bilim kurulları","x0":0.1990765830606846,"x1":0.7249309128813846,"top":0.3355999629152223,"bottom":0.3504346358919851,"conf":1},{"text":"uzmanlık alanları doğrultusunda ilgili konuları gündeme ahır. Bilim kurulunca alınan kararlar","x0":0.19907184361007813,"x1":0.7249547721285372,"top":0.34870767541492587,"bottom":0.36365734521212223,"conf":1},{"text":"ilgililere yazılı olarak sekretaryadan sorumlu Bakanlıkça iletilir.","x0":0.19902781199646116,"x1":0.5565994703696285,"top":0.3631955129650932,"bottom":0.37840278405195715,"conf":1},{"text":"MADDE 10 -(1)Bu çalışma usul ve esaslar;","x0":0.19917864869483382,"x1":0.44763859959511343,"top":0.3982558138911505,"bottom":0.40854700839936875,"conf":1},{"text":"a) Merkezde Cumhurbaşkanı Yardımcısının riyaseti ve görevlendirilmiş olan Sağlık","x0":0.22368293720010066,"x1":0.7229339834327185,"top":0.4176792623976173,"bottom":0.43292807782000153,"conf":1},{"text":"Bakanlığı Bakan Yardımcısı","x0":0.2236562390102196,"x1":0.4108381845895916,"top":0.4324363828058343,"bottom":0.44535706770179806,"conf":1},{"text":"koordinatörlüğünde, BMK üyesi diğer ilgili","x0":0.41058568613670104,"x1":0.7229260500508864,"top":0.4312278943413279,"bottom":0.4455788816371471,"conf":1},{"text":"Kurum/Kuruluşlarca yürütülür.","x0":0.22176591670364978,"x1":0.39630389828357915,"top":0.4476744185415794,"bottom":0.4578488372599663,"conf":1},{"text":"b) İllerde, Valilerin riyaseti ve Il Sağlık Müdürlüklerinin sekretaryasında, BMIKK'yı","x0":0.2217073320657029,"x1":0.7228505788467073,"top":0.4575554801146805,"bottom":0.4711280568331332,"conf":1},{"text":"oluşturan Kurum/Kuruluşlarca yürütülür.","x0":0.22176591051140282,"x1":0.4517453829196744,"top":0.47383720924070327,"bottom":0.484188034069544,"conf":1},{"text":"Ek-I) BMIKK Üye Tabiosu","x0":0.1950718661869068,"x1":0.3552361422730521,"top":0.5072649570962314,"bottom":0.5205128203440946,"conf":1},{"text":"2) Karar Tutanağı","x0":0.21560574765067178,"x1":0.31827515563474923,"top":0.5217948717747954,"bottom":0.5320512820312058,"conf":1},{"text":"Cumhurbaşkanı Yardımcısı","x0":0.3778234080422047,"x1":0.5