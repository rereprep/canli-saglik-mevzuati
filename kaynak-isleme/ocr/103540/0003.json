{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4496919868413055,"x1":0.9609856310371943,"top":0.040598290632302914,"bottom":0.056837606871619095,"conf":1},{"text":"14. Ekte gönderilen tip sözleşmede idareler tarafından doldurulması gereken maddeler ve","x0":0.19292273423701056,"x1":0.8440448216718277,"top":0.23822682781086568,"bottom":0.25653298859911655,"conf":1},{"text":"idarelerce öngörülecek diğer hususlar ilgili mevzuat hükümlerine aykırı olmamak şartıyla","x0":0.14358935759366592,"x1":0.844080768094724,"top":0.25140309260786164,"bottom":0.27136817639035105,"conf":1},{"text":"doldurulacaktır.","x0":0.1454683506706097,"x1":0.26524004745090557,"top":0.26615986406425196,"bottom":0.28069418831899706,"conf":1},{"text":"15. İlgi genelge doğrultusunda imzalanan sözleşmeler, sözleşme süresi sonuna kadar","x0":0.19284329578142673,"x1":0.8441076755756756,"top":0.294796973343023,"bottom":0.31638028267962826,"conf":1},{"text":"uygulanabilecektir. Bu sözleşmelerle ilgili damga vergisi hususunda 29.01.2014 tarihli ve","x0":0.1457091692824448,"x1":0.844019108019975,"top":0.31082295490534984,"bottom":0.3295007739861917,"conf":1},{"text":"2014.5454.327 sayılı yazımız ekinde gönderilen Maliye Bakanlığı Gelir İdaresi Başkanlığı'nın","x0":0.14571413862990373,"x1":0.8440102023863274,"top":0.3254614884318424,"bottom":0.3450091726041222,"conf":1},{"text":"görüşü doğrultusunda hareket edilecektir.","x0":0.14579055125801502,"x1":0.44763860648752485,"top":0.3414529913866853,"bottom":0.35610465100170474,"conf":1},{"text":"16. Bu genelgenin yayımı itibari ile ilgide kayıtlı genelge yürürlükten kaldırılmıştır.","x0":0.1928523109899254,"x1":0.8420462926725887,"top":0.3698468916178883,"bottom":0.38961016650353875,"conf":1},{"text":"Yürürlükten kaldırılan ilgi genelge doğrultusunda alım süreci devam eden ancak henüz sözleşme","x0":0.147748747285062,"x1":0.8440195066184961,"top":0.3851283950138126,"bottom":0.4017855135258277,"conf":1},{"text":"imzalanmamış alımlarda bu genelge hükümleri doğrultusunda hareket edilecektir.","x0":0.14361057594285404,"x1":0.7352367074918451,"top":0.39966155455781616,"bottom":0.4174953311133258,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.19917864461550014,"x1":0.4640657059594485,"top":0.428632478692496,"bottom":0.44331395326405,"conf":1},{"text":"Mom","x0":0.6735112947846149,"x1":0.8069815187061451,"top":0.46075581411143496,"bottom":0.4898255809467047,"conf":0.5},{"text":". Ercan ÖZGÜL","x0":0.6919917863167402,"x1":0.8110882955191,"top":0.4883720928843287,"bottom":0.5000000001075003,"conf":1},{"text":"Kurum Başkan V.","x0":0.6735112945006749,"x1":0.8069815184222051,"top":0.5042735040827002,"bottom":0.5175213673305635,"conf":1},{"text":"833","x0":0.8932238196822326,"x1":0.9301848043424078,"top":0.9433139536654862,"bottom":0.9563953485783364,"conf":1}]}