{"lines":[{"text":"T.C.","x0":0.4722792605482321,"x1":0.5133470228193244,"top":0.061046511634205824,"bottom":0.0755813950518407,"conf":1},{"text":"SAGLIK BAKANLIĞI","x0":0.393751343544066,"x1":0.5918725124256126,"top":0.07368019137119908,"bottom":0.09340960674308574,"conf":1},{"text":"Temel Sağlık Hizmetleri Genel Müdürlüğü","x0":0.31797533114027404,"x1":0.6697366197658597,"top":0.09196000822088235,"bottom":0.11148072378766427,"conf":1},{"text":"K-Q","x0":0.802874744031747,"x1":0.8254620116664051,"top":0.062499999900466396,"bottom":0.07122093011406849,"conf":1},{"text":"TSE-ISO-EN","x0":0.7801730971588708,"x1":0.8481636596624134,"top":0.07075405601042728,"bottom":0.08040873445296659,"conf":1},{"text":"9000","x0":0.800821354732499,"x1":0.829568788783533,"top":0.08284883725717451,"bottom":0.09011627896599195,"conf":1},{"text":"Sayı:","x0":0.09144853601373386,"x1":0.13805706995370892,"top":0.11722055241082119,"bottom":0.13110234661488107,"conf":1},{"text":"Konu:","x0":0.09240246431801034,"x1":0.14784394130827305,"top":0.13226744194764473,"bottom":0.14534883686049493,"conf":1},{"text":"Türkiye'de kızamık sürveyansının eliminasyon hedefine ulaşıldığının kanıtlanması ve olası","x0":0.153636601501986,"x1":0.8976539015369391,"top":0.15378655328510438,"bottom":0.18037388631221862,"conf":1},{"text":"bir salgının erken tespiti ve etkin salgın yanıtı ile kontrol altına alınmasını sağlamak amacıyla","x0":0.09412481605469399,"x1":0.8976980369869039,"top":0.17024659057803815,"bottom":0.19869017974779313,"conf":1},{"text":"yeniden düzenlenmiş olan ve sürveyansın il düzeyinde yürütülmesi sırasında uyulması gereken","x0":0.09398389950835856,"x1":0.8996798449436669,"top":0.18593331925882106,"bottom":0.21527253902868204,"conf":1},{"text":"kuralları içeren Daimi Genelge ekte gönderilmektedir. Bu Daimi Genelge yayınlandığı tarihte","x0":0.0941445560445601,"x1":0.8997468453574002,"top":0.20288176123067614,"bottom":0.23199967476211802,"conf":1},{"text":"yürürlüge gırer.","x0":0.09445585223894958,"x1":0.2258726896613678,"top":0.2324786325791547,"bottom":0.2470930230909527,"conf":1},{"text":"Kızamık/Kızamıkçık/KKS sürveyansı konusunda temel başvuru kaynağı olan bu Daimi","x0":0.15571034192761432,"x1":0.8998271285292241,"top":0.2520053272654832,"bottom":0.2802912846671175,"conf":1},{"text":"Genelge her düzeyde tanıtılmalı, özel sektör dahil tüm sağlık çalışanlarının uygulamadaki","x0":0.0962115041758091,"x1":0.9018620607101576,"top":0.2686995142710785,"bottom":0.2979929136580143,"conf":1},{"text":"değişiklikleri yakından izlemeleri sağlanmalıdır. Ekte gönderilen Kızamık Sürveyansı Daimi","x0":0.09614166001457797,"x1":0.9018836585786649,"top":0.2837600513897831,"bottom":0.31458017087262236,"conf":1},{"text":"Genelgesinin tüm sağlık kuruluşlarına (Tıp Fakülteleri, Hastaneler, Özel Sağlık Kuruluşları ve","x0":0.09815596774771256,"x1":0.9018342842814943,"top":0.30003949943351427,"bottom":0.3304738910747236,"conf":1},{"text":"Muayenehaneler dâhil) ve birinci basamak sağlık personeline imza karşılığı tebliğini ve il","x0":0.09822186537096939,"x1":0.9018349399723147,"top":0.3181910091903104,"bottom":0.3466001650114994,"conf":1},{"text":"düzeyinde yapılacak uygulamaların Genelgeye uygun olarak yürütülmesi hususunda gereğini","x0":0.09822524711556763,"x1":0.9040782455285059,"top":0.3356221872903711,"bottom":0.3701884959884546,"conf":1},{"text":"önemle rica ederim.","x0":0.1006160159180472,"x1":0.2669404515015285,"top":0.3619186046511331,"bottom":0.3749999995639832,"conf":1},{"text":"Prof. Dr. Nihat TOSUN","x0":0.638105079670852,"x1":0.8465140304211638,"top":0.43429529054751503,"bottom":0.45280245735294544,"conf":1},{"text":"Bakan a.","x0":0.700205336789552,"x1":0.7802874748326246,"top":0.4534188032690336,"bottom":0.4666666665168968,"conf":1},{"text":"Müsteşar","x0":0.6957692717845424,"x1":0.780456012350736,"top":0.4709556096954841,"bottom":0.4840377789592749,"conf":1},{"text":"Ek: Daimi Genelge","x0":0.10472279002824497,"x1":0.2648870661143903,"top":0.5276162792