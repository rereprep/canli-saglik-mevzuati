{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"T.C.","x0":0.4969199174235752,"x1":0.5318275155846384,"top":0.2427325580402736,"bottom":0.2529069767586605,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.43326488782933986,"x1":0.6016427099119331,"top":0.2512820511193212,"bottom":0.2659883717596896,"conf":1},{"text":"Sağhk Hizmetleri Genel Müdürlüğü","x0":0.39014374659783746,"x1":0.646817243494565,"top":0.2674418604350779,"bottom":0.28205128205915564,"conf":1},{"text":"aktarımı kimin denetleyeceği (veri erişim komitesi, vb.), kişisel verileri toplama yöntemi ve","x0":0.20118147530168906,"x1":0.8255237421547725,"top":0.30515099567075055,"bottom":0.32208786027912395,"conf":1},{"text":"hukuki sebebi, aktarım şekli (kamuya açık, kontrollü) ve ilgili kişilerin 6698 sayılı Kişisel","x0":0.20116503895496718,"x1":0.8255453143999113,"top":0.3207160058756152,"bottom":0.33727061988563545,"conf":1},{"text":"Verilerin Korunması Kanunu'nun 11 inci maddesinde sayılan diğer hakları gibi detayların","x0":0.2032854220496578,"x1":0.8254620110006856,"top":0.3371794875181884,"bottom":0.351744185892358,"conf":1},{"text":"metinde yer alması zorunludur.","x0":0.20315159143500272,"x1":0.41293080727420883,"top":0.3527277842708427,"bottom":0.36634018422796166,"conf":1},{"text":"7) Kişisel genetik verilerin yurtiçinde paylaşımında 6698 sayılı Kişisel Verilerin","x0":0.24845996103364923,"x1":0.8254620101026675,"top":0.3675213675175223,"bottom":0.3824786324747873,"conf":1},{"text":"Korunması Kanunu'nun 8 inci maddesine, yurtdışına paylaşımında ise aynı Kanunun 9 uncu","x0":0.20123201630297274,"x1":0.825462028654658,"top":0.3837209303816469,"bottom":0.398290598458643,"conf":1},{"text":"maddesine riayet edilmesi zorunludur.","x0":0.2032854188169118,"x1":0.4599589341644122,"top":0.3995726496334584,"bottom":0.4115384615992703,"conf":1},{"text":"8) Toplumun genetik yapısını ilgilendiren verinin uluslararası paylaşıma açılmasında","x0":0.2505133483407436,"x1":0.8254620109106499,"top":0.41410256392780753,"bottom":0.42877906961164136,"conf":1},{"text":"Kişisel Verileri Koruma Kurulunun izni alınmalıdır.","x0":0.20123203884747964,"x1":0.5503080020073383,"top":0.4302325582866965,"bottom":0.4448717948673089,"conf":1},{"text":"9) Tanı amacı ile işlenen genetik verilerin ve arşiv materyallerinin ikincil amaçlar için","x0":0.25051334836974243,"x1":0.8254620109396487,"top":0.444767442007169,"bottom":0.4594017097000609,"conf":1},{"text":"işlenmesi ve veri paylaşımı yapılabilmesi için bireylerin tekrar bilgilendirilmesi ve açık","x0":0.2011515551658123,"x1":0.8255493957464124,"top":0.45936425617466137,"bottom":0.47614876764301073,"conf":1},{"text":"rızalarının alınması kapsamında zorunludur.","x0":0.20328542470800512,"x1":0.49897330198940626,"top":0.4767441859185324,"bottom":0.4884615384188611,"conf":1},{"text":"10) Sağlık kuruluşlarının, kişisel sağlık verilerinin yurt içinde aktarımında Kişisel","x0":0.25051334839731204,"x1":0.8254620109672184,"top":0.49127906991362524,"bottom":0.5059829061101334,"conf":1},{"text":"Verilerin Korunması Kanunu'nun 8 inci maddesine riayet ederek kuruluş bünyesinde muhafaza","x0":0.20328540439595227,"x1":0.8275154167476375,"top":0.507264957224813,"bottom":0.5205128204726762,"conf":1},{"text":"edilen sağlık kayıtlarını Bakanlığımıza anlık olarak aktarması zorunludur. Sağlık hizmet","x0":0.20118046047731072,"x1":0.8275694346497714,"top":0.5216929615612804,"bottom":0.5369414819152009,"conf":1},{"text":"sunumunu hizmet alımı yoluyla gerçekleştiren sağlık kuruluşları ilgili yüklenici firma veya","x0":0.20123203576177032,"x1":0.8275153977110221,"top":0.5376068375598414,"bottom":0.5523255812346168,"conf":1},{"text":"cihaz üreticileri tarafindan elde edilen tüm veriler için de bu kural doğrultusunda işlem tesis","x0":0.20328540439876028,"x1":0.8275154167504457,"top":0.5537790695756799,"bottom":0.5668604653036363,"conf":1},{"text":"etmesi zorunludur.","x0":0.2030367707740099,"x1":0.33498020247603905,"top":0.5684150280218323,"bottom":0.5829987216321295,"conf":1},{"text":"Bilgilerini ve gereğini önemle rica ederim.","x0":0.25256673490919873,"x1":0.5379876796950399,"top":0.5841880339726625,"bottom":0.5988372091438218,"conf":1},{"text":"Prof. Dr. Sabalattin AYDIN","x0":0.5893223828136708,"x1":0.7823408613363809,"top":0.6307692308569776,"bottom":0.6440170941048409,"conf":1},{"text":"Bakan a.","x0":0.6547186346065821,"x1":0.716886493020961,"top":0.6468066789239594,"bottom":0.6579185277062297,"conf":1},{"text":"Bakan Yardımcısı","x0":0.6242299786341227,"x1":0.7535934295574289,"top":0.6584302322073375,"bottom":0.6744186049448634,"conf":1},{"text":"Dağıtım","x0":0.2032854216469793,"x1":0.2648870627472712,"top":0.7063953484864073,"bottom":0.7223837212239332,"conf":1},{"text":"Gereği","x0":0.20219816301344842,"x1":0.257746608358717,"top":0.7203438256907329,"bottom":0.7391289078638765,"conf":1},{"text":"Yükseköğretim Kurulu Başkanhığına","x0":0.20533881293896797,"x1":0.4537987638392476,"top":0.7367521371423552,"bottom":0.7543604650894664,"conf":1},{"text":"81 İl Valiliğine (İl Sağlık Müdürlüğü)","x0":0.20328541960296956,"x1":0.46201232144958193,"top":0.7512820511602406,"bottom":0.7688953488101784,"conf":1},{"text":"Bilgi","x0":0.5420944554832082,"x1":0.5831622177543005,"top":0.7194767440596536,"bottom":0.7369186044868579,"conf":1},{"text":"Sağlık Bilgi Sistemleri Genel Müdürlüğü","x0":0.5420944532497431,"x1":0.8213552385382483,"top":0.7354651162914687,"bottom":0.7529914527005566,"conf":1},{"text":"255","x0":0.8952772077665425,"x1":0.9322381924267177,"top":0.9418604652251773,"bottom":0.9563953486428122,"conf":1}]}