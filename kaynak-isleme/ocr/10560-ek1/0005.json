{"lines":[{"text":"EK-3","x0":0.7577002042889747,"x1":0.8028747441709841,"top":0.1642441862318017,"bottom":0.1773255811446518,"conf":0.5},{"text":"ARŞİV MALZEMESİ DEVİR TESLİM VE ENVANTER","x0":0.2279260721716819,"x1":0.7371663298684586,"top":0.17863247826548367,"bottom":0.19487179450479997,"conf":1},{"text":"FORMUNUN DOLDURULMASI","x0":0.3347022564428586,"x1":0.6386036981714805,"top":0.1991279067825784,"bottom":0.2123931623601223,"conf":1},{"text":"1","x0":0.15605749468017915,"x1":0.16632443524795223,"top":0.23110465106325706,"bottom":0.23982558127685927,"conf":1},{"text":"Envanter Formunun başında kurumun antedi bulunur.","x0":0.16824818257896795,"x1":0.6079388797288697,"top":0.22916686119882057,"bottom":0.24698275106270695,"conf":1},{"text":"2","x0":0.15400410683452934,"x1":0.16632443505458772,"top":0.24563953502271152,"bottom":0.25726744143077696,"conf":1},{"text":"\"Birimi\" bölümüne, arşiv malzemesini devreden birimin açık adı,","x0":0.17238295443273552,"x1":0.6982374687611628,"top":0.24541747886762355,"bottom":0.2628592757165402,"conf":1},{"text":"\"Türü\" bölümüne, devredilen arşiv malzemesinin türü yazılır. Burada","x0":0.17036110175517133,"x1":0.8029303467672633,"top":0.2600154671030277,"bottom":0.2760434939446723,"conf":1},{"text":"devredilen malzeme evrak olduğundan, bu bölüme \"Evrak\" ibaresi,","x0":0.16632444443706762,"x1":0.7125256591178604,"top":0.2760683757780107,"bottom":0.292307692017327,"conf":1},{"text":"4","x0":0.1498973305153083,"x1":0.16632443519311058,"top":0.29941860468168646,"bottom":0.31395348809932133,"conf":1},{"text":"\"İşlem Yılı\" bölümüne devredilecek arşiv malzemesi hangi yıla aitse yılı veya","x0":0.17030465409316345,"x1":0.8029867440313814,"top":0.289184590515253,"bottom":0.3082488351686776,"conf":1},{"text":"yıl grubu,","x0":0.16221766067538088,"x1":0.24845995821578953,"top":0.30811965848769485,"bottom":0.3226744182713175,"conf":1},{"text":"\"Teşkilat Kodu\" bölümüne, her karenin içine sırasıyla kurum kodu, Birimin","x0":0.16824726865553877,"x1":0.8050232160510572,"top":0.32061464515848637,"bottom":0.3404548970484895,"conf":1},{"text":"5 kodu varsa alt birim ve hizmet türü kodları,","x0":0.15063724166920464,"x1":0.5182214701848297,"top":0.32949757914872757,"bottom":0.36247316560789566,"conf":1},{"text":"6","x0":0.15195071896321216,"x1":0.16632443483555584,"top":0.3619186047757178,"bottom":0.374999999688568,"conf":1},{"text":"\"Kutu no\" bölümüne, listenin o sayfasında dökümü yapılan evrakın ait olduğu","x0":0.16831051208827102,"x1":0.8049745739978464,"top":0.3529682000625698,"bottom":0.36897832472557235,"conf":1},{"text":"klasör numarası,","x0":0.1637339222199075,"x1":0.308543050082877,"top":0.36899246269678976,"bottom":0.38396290955238366,"conf":1},{"text":"7","x0":0.15400410683452934,"x1":0.16632443505458772,"top":0.3924418606041068,"bottom":0.40406976701217223,"conf":1},{"text":"\"Dosya no\" bölümüne, listenin o sayfasında dökümü yapılan evrakın alt","x0":0.1682142679222836,"x1":0.8050395157825843,"top":0.3831598582808249,"bottom":0.40359795963361433,"conf":1},{"text":"olduğu dosya numarası veya numaraları,","x0":0.17043121070673084,"x1":0.5030800818736935,"top":0.4011627908250972,"bottom":0.41581196599625647,"conf":1},{"text":"8","x0":0.1540041068687525,"x1":0.16632443508881087,"top":0.42296511636961065,"bottom":0.4345930227776761,"conf":1},{"text":"\"Envanter Sıra Numarası\" bölümüne, devredilen fonun ilk evrakından","x0":0.1701583017490498,"x1":0.803134718414142,"top":0.409114005680568,"bottom":0.43459197583646336,"conf":1},{"text":"başlayarak en son evraka kadar verilen sıra numarasını,","x0":0.16828934318435781,"x1":0.6304755176808436,"top":0.43066583282574233,"bottom":0.4462488475177391,"conf":1},{"text":"9","x0":0.15400410681399546,"x1":0.16632443503405384,"top":0.4549418603065043,"bottom":0.4651162790248913,"conf":1},{"text":"\"İşlem Tarihi\" bölümüne, evrakın en son işlem gördüğü tarih yani evrakın en","x0":0.16828548124358786,"x1":0.8029509554491123,"top":0.44471203885391564,"bottom":0.4635025854993816,"conf":1},{"text":"son tarihi,","x0":0.1683778244911116,"x1":0.2546201220315203,"top":0.46366279081772455,"bottom":0.4782051283820462,"conf":1},{"text":"10","x0":0.14373716689108984,"x1":0.166324434525748,"top":0.47819767423725135,"bottom":0.4898255814604231,"conf":1},{"text":"Sayısı\" bölümüne, en son işlem gören evrakın almış olduğu sayı.","x0":0.17239566523710836,"x1":0.7105608303552877,"top":0.47671261598570147,"bottom":0.49428713169521166,"conf":1},{"text":"11","x0":0.14373716689108984,"x1":0.166324434525748,"top":0.5014534881907398,"bottom":0.5130813954139114,"conf":1},{"text":"\"Gizlilik Derecesi\" bölümüne, evrakın gizlilik kaydının olup olmadığı (Gizlilik","x0":0.168377811634511,"x1":0.8049281429808681,"top":0.4927325578146453,"bottom":0.5087209305521712,"conf":1},{"text":"kaydı varsa) \"G\" kısaltması ile gösterilır.","x0":0.168218898896147,"x1":0.49708311065551825,"top":0.5078941143958616,"bottom":0.5251853016170301,"conf":1},{"text":"\"Konusu\" bölümüne, evrakın kısaca konusu (Evrakın yazılırken kısaltmalar","x0":0.16822147347649952,"x1":0.805059120256087,"top":0.5213180534344987,"bottom":0.5419380865030333,"conf":1},{"text":"12 kullanılmayacak, kısa ve öz biçimde evrakın muhteviyatını verecek ifadeler","x0":0.1457905698333715,"x1":0.8049281157684153,"top":0.5392441861956093,"bottom":0.5538461536730003,"conf":1},{"text":"kullanılacaktır),","x0":0.16778458109778743,"x1":0.29838738887734173,"top":0.5538884768721395,"bottom":0.5715357163615726,"conf":1},{"text":"13 \"Adedi\" bölümüne, evrak kaç sayfadan müteşekkil ise toplam sayfa sayısı,","x0":0.1436505332690388,"x1":0.7783136457756515,"top":0.576749296229729,"bottom":0.5944513010781114,"conf":1},{"text":"\"Açıklamalar\" bölümüne, evrakla ilgili açıklama gereği duyulan hususlar","x0":0.17043121726916868,"x1":0.8049281252148686,"top":0.6002906978210886,"bottom":0.6149572649143753,"conf":1},{"text":"14 kaydedilir. Örnek: \"Evrakın eki yok\" veya \"Evrakın ekinde bir adet fotoğraf","x0":0.14168377766374693,"x1":0.8069815199976723,"top":0.6148255810508914,"bottom":0.6308139537884172,"conf":1},{"text":"mevcut\" gibı,","x0":0.1697471514298266,"x1":0.28018551559021904,"top":0.6298824148645749,"bottom":0.6486871484343804,"conf":1},{"text":"15 \"Evrak Sıra Numarası\" bölumüne, kaydedilen evrakın dosya içinde almış","x0":0.14339726292544872,"x1":0.8091933975328399,"top":0.6409902942271587,"bottom":0.6673378352211344,"conf":1},{"text":"]olduğu sıra numarası,_","x0":0.1617704396684358,"x1":0.35578096088948136,"top":0.6616826780763594,"bottom":0.6804448655450593,"conf":1},{"text":"yazılır.","x0":0.16966573353547784,"x1":0.22828475186875608,"top":0.6936430448205861,"bottom":0.7081642165208273,"conf":1}]}