{"lines":[{"text":"89кг","x0":0.24229979408690422,"x1":0.28336755635799654,"top":0.12354651198752553,"bottom":0.13953488309483886,"conf":0.30000001192092896},{"text":"SS96IK BBKANLIG","x0":0.21718060726301092,"x1":0.3168231936539571,"top":0.1365626626310038,"bottom":0.15151438323553346,"conf":0.30000001192092896},{"text":"T.C.","x0":0.49486653012517795,"x1":0.5318275147853531,"top":0.11918604661136523,"bottom":0.1337209300290002,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4312114979538227,"x1":0.595482547038192,"top":0.1293604652563911,"bottom":0.14401709375913097,"conf":1},{"text":"Idari ve Mali Işler Dairesi Başkanlığı","x0":0.3675564703054972,"x1":0.6591375745886744,"top":0.14529914521633358,"bottom":0.15988372077159696,"conf":1},{"text":"10 Arak 2002","x0":0.7581190802077636,"x1":0.8475973111742416,"top":0.13547659266963374,"bottom":0.15646960450288983,"conf":1},{"text":"ANKARA","x0":0.7618069807478675,"x1":0.8254620129599646,"top":0.17877906960269985,"bottom":0.1904069768258716,"conf":1},{"text":"SAYI : B100IMI0000010/","x0":0.17453799011051174,"x1":0.3716632416314458,"top":0.17587209282006977,"bottom":0.18895348854802618,"conf":1},{"text":"KONU:Devir Teslim ve","x0":0.1745379890083645,"x1":0.34496919759006983,"top":0.19040697654440664,"bottom":0.20348837227236305,"conf":1},{"text":"Evrak Teşekkülü","x0":0.22997946841060304,"x1":0.3552361371102989,"top":0.20341880345522356,"bottom":0.21511627918201137,"conf":1},{"text":"01 48","x0":0.5071868591348627,"x1":0.5749486643451838,"top":0.21220930230662027,"bottom":0.2296511627338247,"conf":1},{"text":"Bildiğiniz gibi, Bakanlığımız bünyesinde ve bağlı Sağlık Kurum ve Kuruluşlarımızda Kurum Arşivi'nin","x0":0.22381928689036532,"x1":0.8521560722402747,"top":0.26880341892442283,"bottom":0.28205128217228603,"conf":1},{"text":"Kanun ve Yönetmeliklerde tanımlanan niteliklere uygun hale getirilmesi ile, işin rastgele yapılmasının önüne","x0":0.17650074594938536,"x1":0.85224214228025,"top":0.2772968802388054,"bottom":0.2929241103695146,"conf":1},{"text":"geçilerek belli bir sisteme kavuşturulması bakımından, 2001 yılı içerisinde yoğun çalışma ve eğitim","x0":0.17654545425347323,"x1":0.8522055933811561,"top":0.2896981171544758,"bottom":0.3040978200906319,"conf":1},{"text":"programları yapılmış, olumlu ve bilgilendirici koordinasyonlar kurulmuştur.","x0":0.1765913701534544,"x1":0.6386037014691096,"top":0.30213675212178925,"bottom":0.3141025640876013,"conf":1},{"text":"Başlatılmış olan bu çalışmalarımızın daha da ileriye götürülmesi, son derece disiplinli ve özverili bir","x0":0.22577459906834077,"x1":0.8522316934937867,"top":0.3228517210154447,"bottom":0.3381840587453959,"conf":1},{"text":"şekilde yürütülen çalışmalarımızın, aynı anlayışla devamının sağlanması, işe gereken hassasiyet ve özen","x0":0.17652802274698767,"x1":0.8522080149061472,"top":0.33547534973365,"bottom":0.3495001347673079,"conf":1},{"text":"gösterilmesi ile mümkün olacaktır.","x0":0.17659137615381096,"x1":0.39219712461752576,"top":0.34738372086684266,"bottom":0.3576923077047416,"conf":1},{"text":"Bu anlamda, yıl içerisinde kurulan koordinasyonlar ve yapılan bilgilendirme çalışmalarımız","x0":0.22580737157062844,"x1":0.8522110325581964,"top":0.36899590630193435,"bottom":0.38256621987787476,"conf":1},{"text":"sonucunda, kurumlarımızın Evrak Teşekkül ve Ayıklama Envanter Formlarının oluşturulmasında sıkıntı","x0":0.1765913604233279,"x1":0.8521560721543587,"top":0.3807692309226045,"bottom":0.39244186058057806,"conf":1},{"text":"yaşadıkları tespit edilmiştir.","x0":0.1745379906426684,"x1":0.34907597222259773,"top":0.39230769221344586,"bottom":0.4042735041792579,"conf":1},{"text":"Bunun için 2002 yılından itibaren, bir işlemle ilgili dosya oluşturmaya başlanırken Dosya Muhteviyatı","x0":0.2238192862706544,"x1":0.8521560716205637,"top":0.4141025639830953,"bottom":0.4273504272309586,"conf":1},{"text":"Formunun tutulması uygulamasına geçilmesi kararlaştırılmıştır. Oluşturulan Dosya Muhteviyatı Formu","x0":0.17654608861740778,"x1":0.8521958953123518,"top":0.4258485130233698,"bottom":0.43871750510340624,"conf":1},{"text":"dosyanın en üst bölümüne takılacak ve her işlem gören evrak sıra numarasıyla Forma işlenecektir.","x0":0.17659137447014475,"x1":0.7926078039238366,"top":0.43749999987440347,"bottom":0.44914529901970257,"conf":1},{"text":"Bu uygulamayla evrak kayıp yada yıl sonunda evrak tespiti yapılması zorluğunun önüne geçileceği","x0":0.22375342829554895,"x1":0.8522115459270483,"top":0.45927362297226715,"bottom":0.4742680315063905,"conf":1},{"text":"gibi, Evrak Devir ve Envanter Formunun tanziminde de büyük kolaylık sağlanmış olacaktır. Yıl sonu itibariyle","x0":0.174478850474519,"x1":0.852222081845438,"top":0.47027758420070054,"bottom":0.4850613154819484,"conf":1},{"text":"Evrak Devir ve Envanter Formunun nasıl doldurulacağına ilişkin ayrıntılar ekte gönderilen açıklamalarla","x0":0.17653735859050687,"x1":0.8522075349385646,"top":0.4820252280545605,"bottom":0.49514894002365906,"conf":1},{"text":"Bilgilerinizi ve yukarıda ifade edilen, ekte birer öreği gönderilen açıklamaların dikkatle incelenerek","x0":0.22376452296444857,"x1":0.852204854051019,"top":0.5159391188729863,"bottom":0.5303507745272413,"conf":1},{"text":"belirtilen hususların mahiyetinizdeki bütün Sağlık Kurum ve Kuruluşlarında uygulamaya konulmasını ve","x0":0.17653824001562962,"x1":0.8501577974804875,"top":0.527092002345131,"bottom":0.5394565320933793,"conf":1},{"text":"tereddüt edilen konularda Bakanlığımız Idari ve Mali İşler Dairesi Başkanlığı ile koordinasyon kurulmasını","x0":0.17659137831088553,"x1":0.8501026666412589,"top":0.5392441859213662,"bottom":0.5508720931445379,"conf":1},{"text":"Bakan a","x0":0.7556329196952557,"x1":0.8111021927746631,"top":0.5958923764749819,"bottom":0.6061425071528165,"conf":1},{"text":"Müsteşar Yardımcısı","x0":0.7166324443636702,"x1":0.8501026682852004,"top":0.6075581397383424,"bottom":0.6206395346511925,"conf":1},{"text":"EKLER:","x0":0.1764797791949378,"x1":0.23214445057043848,"top":0.6290896353226968,"bottom":0.6412592018439746,"conf":1},{"text":"Dosya Muhteviyatı Döküm Formu","x0":0.19712525786121587,"x1":0.4147843928240428,"top":0.6409883720302401,"bottom":0.6512820513898717,"conf":1},{"text":"2. Evrak Devir İşleminde Uyulacak Kurallar","x0":0.1745379862456384,"x1":0.45790554453236754,"top":0.6511627908429936,"bottom":0.6642441857558437,"conf":1},{"text":"Devir, Teslim ve Envanter Formu","x0":0.19507186943330165,"x1":0.41478439089524055,"top":0.6613372093895052,"bottom":0.6744186043023553,"conf":1},{"text":"4. Formun Doldurulmasına Ait Açıklama","x0":0.17659137532142163,"x1":0.439425050166258,"top":0.6729651161195188,"bottom":0.6846153845600914,"conf":1},{"text":"DAĞITIM","x0":0.17659137561359464,"x1":0.24229979432480375,"top":0.693313953494671,"bottom":0.7078488369123058,"conf":1},{"text":"A Planı","x0":0.17659137692737037,"x1":0.22792607630671588,"top":0.7063953488916854,"bottom":0.719658119617816,"conf":1},{"text":"(1 adet)","x0":0.47010590869433333,"x1":0.5257873149207163,"top":0.6406967530094073,"bottom":0.6529078976931147,"conf":1},{"text":"(1 Adet)","x0":0.4681724837145756,"x1":0.5256673518166435,"top":0.652564102751085,"bottom":0.6642441861481923,"conf":1},{"text":"(1 Adet)","x0":0.4722792597176263,"x1":0.5236139637096651,"top":0.6627906974983506,"bottom":0.6744186047215223,"conf":1},{"text":"(1 Adet)","x0":0.4722792617476989,"x1":0.5236139611270444,"top":0.6729651164471301,"bottom":0.6846153844801496,"conf":1}]}