2655052615858,"top":0.18610465155359002,"bottom":0.19720930213253718,"conf":1},{"text":"00120052672","x0":0.7207392196229947,"x1":0.7802874742241747,"top":0.1598837209930788,"bottom":0.16715116270189623,"conf":1},{"text":"- IQNet-","x0":0.7286946157214694,"x1":0.8075782376937715,"top":0.16978587574350146,"bottom":0.18526659134027923,"conf":0.30000001192092896},{"text":"CERTIFICATE","x0":0.7392197116555183,"x1":0.7967145797575861,"top":0.19040697680349294,"bottom":0.19767441851231038,"conf":0.30000001192092896},{"text":"DAĞITIM YERLERİNE","x0":0.41478439323647853,"x1":0.5790554423208478,"top":0.2383720928239339,"bottom":0.2514534885518904,"conf":1},{"text":"Bakanlığımızca, toplumu ve bireyi sağlığa yönelik risklerden korumak, sağlıklı hayat tarzını ve","x0":0.24229979039029667,"x1":0.8028747474664188,"top":0.26308139515412743,"bottom":0.27616279088208384,"conf":1},{"text":"davranışlarını teşvik etmek, geliştirmek ve yaygınlaştırmak amacı kapsamında \"Hastalığa Değil,","x0":0.19301847801591865,"x1":0.8028747479722744,"top":0.2747093021660305,"bottom":0.28633720938920204,"conf":1},{"text":"Sağlığa Yatırım Yapmak\" anlayışı benimsenmiştir. Belirlenen amaç doğrultusunda Sağlıklı Hayat","x0":0.19301849160914528,"x1":0.8028747246639557,"top":0.28632478632239455,"bottom":0.29957264957025775,"conf":1},{"text":"Merkezleri kurulmuş, Toplum Sağlığı Merkezi ve Bağhı Birimler Yönetmeliği'nin 41 inci maddesi ile","x0":0.19301847682740195,"x1":0.8028747467837577,"top":0.2994186045259647,"bottom":0.3111111109574791,"conf":1},{"text":"de görevleri tanımlanmıştır.","x0":0.1930184802117061,"x1":0.3593429157951874,"top":0.3123931622595666,"bottom":0.32412790708957584,"conf":1},{"text":"Söz konusu merkezlerde beslenme danışmanlığı, psikososyal danışmanlık, ağız ve diş sağlığı,","x0":0.23613962860400906,"x1":0.8028747451774674,"top":0.3226495727469455,"bottom":0.3358974359948087,"conf":1},{"text":"kadın ve üreme sağlığı, okul sağlığı, kanser erken teşhis, tarama ve eğitimi, sigara bırakma danışmanlığı,","x0":0.19301847682596154,"x1":0.8028747467823173,"top":0.3357558138282628,"bottom":0.34743589763292326,"conf":1},{"text":"uyuşturucu kullanan kişi ve yakını için danışmanlık vb. hizmetler sunulmaktadır.","x0":0.19301848207572186,"x1":0.6735112918833851,"top":0.3473837208039263,"bottom":0.35901162802709785,"conf":1},{"text":"Tüm sağlık kurum ve kuruluşlarımızda olduğu gibi sağlıklı hayat merkezlerinde sunulan","x0":0.23815480650364448,"x1":0.8029286059340027,"top":0.3586214098927918,"bottom":0.3719717768275437,"conf":1},{"text":"hizmetlerin yerinde izleme ve değerlendirmesi; tespit edilen eksiklik/aksaklıkların düzeltici ve önleyici","x0":0.1930184962378241,"x1":0.8028747292926344,"top":0.36918604651159814,"bottom":0.38247863260181647,"conf":1},{"text":"faaliyetlerle önlenmesi açısından büyük önem taşımaktadır. Sunulan hizmetin etkinlik, kalite ve","x0":0.1930184768229577,"x1":0.8028747467793135,"top":0.38372093010727537,"bottom":0.395348837330447,"conf":1},{"text":"verimliliğini artırmak; iyileştirici, düzeltici ve önleyici faaliyetlerle mümkün olacaktır.","x0":0.1909650890447558,"x1":0.7063655062388685,"top":0.3952991453534176,"bottom":0.40697674430666475,"conf":1},{"text":"Halk Sağlığı Hizmetlerinin izleme ve değerlendirmesi kapsamında Sağlıklı Hayat Merkezi","x0":0.23819301606691778,"x1":0.8028747461412641,"top":0.40683760663910273,"bottom":0.41880341860491477,"conf":1},{"text":"İzleme ve Değerlendirme Formu\" oluşturulmuş ayrıca formun kullanılmasında görevli personele yol","x0":0.1929360595361527,"x1":0.8049809601558625,"top":0.41639838761409287,"bottom":0.4321629232082831,"conf":1},{"text":"güsterici olması adına \"Sağlıklı Hayat Merkezi İzleme ve Değerlendirme Rehberi\" hazırlanmıştır. Bu","x0":0.19096509264837822,"x1":0.802874749103846,"top":0.43023255817005857,"bottom":0.44487179475067085,"conf":1},{"text":"çerçevede;","x0":0.19055103724458847,"x1":0.2590615471368596,"top":0.44340103003943954,"bottom":0.4552402405170892,"conf":1},{"text":"1)