tom":0.2398255813060668,"conf":0.30000001192092896},{"text":"DENİZLİ VALİLIĞİNE","x0":0.39219712413413566,"x1":0.5441478449984466,"top":0.28034188020098905,"bottom":0.2936046509271195,"conf":1},{"text":"( II Sağlık Müdürluğo)","x0":0.39425051438421044,"x1":0.540041066525799,"top":0.29487179497399507,"bottom":0.3095930230926307,"conf":1},{"text":"İlgi : 18/11/2019 tarihli ve 64472473-799-997 sayılı yazı.","x0":0.1785313253464909,"x1":0.5565679166237921,"top":0.32410121111416623,"bottom":0.3402677546671844,"conf":1},{"text":"İlgide kayıtlı yazınız ile, Pamukkale Üniversitesinde SAHU eğitimine devam eden aile","x0":0.22381930411286108,"x1":0.7556468132998698,"top":0.35299145335791504,"bottom":0.36773255784253833,"conf":1},{"text":"hekimleri için eğitim kurumu tarafindan hazırlanan eğitim programının değiştirilmesine","x0":0.1806981533277032,"x1":0.7556468158976094,"top":0.3662393164324078,"bottom":0.379487179680271,"conf":1},{"text":"yönelik müdürlük tarafından yazılı talepte bulunulduğu ancak olumlu cevap alınamadığı,","x0":0.18069815310343063,"x1":0.7556468156733369,"top":0.37777777778012245,"bottom":0.3897435897459345,"conf":1},{"text":"bununla birlikte SAHU öğrencisi olan ceza infaz kurumu aile hekimlerinin esnek mesai","x0":0.18069815320321206,"x1":0.7556468157731183,"top":0.3909883719675561,"bottom":0.40261627919072773,"conf":1},{"text":"uygulaması olmadığından bahisle sözü geçen konularda nasıl bir yol izleneceğine dair","x0":0.18069815321515026,"x1":0.7556468157850565,"top":0.4040697673163932,"bottom":0.41581196588553615,"conf":1},{"text":"Bakanlığımız görüşünün istendiği anlaşılmaktadır.","x0":0.1806003005198177,"x1":0.4908168697860851,"top":0.41564727849959193,"bottom":0.4286172972939859,"conf":1},{"text":"Aile Hekimliği Odeme Sözleşme Yönetmeliğinin Sözleşmeli aile hekimliği uzmanlık","x0":0.22381930485208082,"x1":0.7556468140390896,"top":0.4302325579474303,"bottom":0.44331395367538673,"conf":1},{"text":"eğitimi başlıklı EK MADDE 2- (Ek: 16/3/2015-2015/7528 K.)'nin 3 üncü fikrasında Eğitime","x0":0.1786447660810458,"x1":0.7556468151500642,"top":0.44040697688766806,"bottom":0.4551282050063037,"conf":1},{"text":"başlatılan sözleşmeli aıle hekimlerine ilişkin eğitim süreçleri, eğitim aldıkları aile hekimlıği","x0":0.1786447659172362,"x1":0.7556468149862545,"top":0.454941860273229,"bottom":0.46802325600118544,"conf":1},{"text":"anabilim dalları veya eğitim klinikleri tarafindan yürütülür. Klinik rotasyonlar dışında eğitim","x0":0.17864476591097586,"x1":0.7556468149799942,"top":0.46656976724964194,"bottom":0.47965116297759836,"conf":1},{"text":"kurumunda verilecek eğitimler, aile hekimliği hizmetlerini aksatmayacak şekilde çalışma","x0":0.1786447662868461,"x1":0.7556468153558644,"top":0.47819767442490346,"bottom":0.49273504310150473,"conf":1},{"text":"saatleri dışında en fazla ıki farklı günde ve ayda sekiz saati geçmeyecek şekılde eğitim","x0":0.18069815321351068,"x1":0.755646815783417,"top":0.49273255808075456,"bottom":0.5029914531885781,"conf":1},{"text":"kurumunca planlanır. Klinik rotasyon dışındaki bu eğitim süreçleri için yüz yüze eğitim","x0":0.18069815314553364,"x1":0.7556468157154399,"top":0.5029069766175523,"bottom":0.514534883840724,"conf":1},{"text":"yerine diğer interaktif iletişim yöntemleri tercih edilebilir. Yüz yüze eğitim dışındaki eğitim","x0":0.17864476592334752,"x1":0.7556468149923659,"top":0.5158119657904143,"bottom":0.5290697676288245,"conf":1},{"text":"yöntemlerinde bu fıkradaki süre sınırı uygulanmazi hükmü yer almaktadır.","x0":0.18069814632001416,"x1":0.6427104776356694,"top":0.5276162788753268,"bottom":0.5406976746032832,"conf":1},{"text":"Yukarıdaki mevzuat hükümleri dikkate alındığında eğitim","x0":0.22579549821848577,"x1":0.648953528053828,"top":0.5410974817565021,"bottom":0.5541877906713388,"conf":1},{"text":"programlarinin","x0":0.6465491602913219,"x1":0.7559789406356103,"top":0.542528888480636,"bottom":0.5548064834789875,"conf":1},{"text":"hazırlanmasının ilgili eğiticinin sorumluluğunda olduğu açıktır. Ancak eğitim programları","x0":0.18069815318336938,"x1":0.7556468157532756,"top":0.555128205258242,"bottom":0.5668604652368381,"conf":1},{"text":"hazırlanırken aile hekimliği hizmetlerinin olumsuz etkilenmemesi ve hizmetin devamlılığı","x0":0.1806981532089471,"x1":0.7556468157788534,"top":0.5666666665507933,"bottom":0.5786324785166053,"conf":1},{"text":"açısından ilgili mevzuat hükümleri de dıkkate alınmak suretiyle eğitim kurumu ile tekrar","x0":0.1786447659208741,"x1":0.7556468149898925,"top":0.5799145298935711,"bottom":0.5901709401499814,"conf":1},{"text":"iletişime geçilmesi ve esnek mesai uygulaması olmayan birimler de dahil olmak üzere eğitim","x0":0.18069815320933424,"x1":0.7556468157792405,"top":0.5914529915266857,"bottom":0.6031976745396888,"conf":1},{"text":"saatlerinde görevlendirmelerle ilgili müdürlük tarafından gerekli tedbirlerin alınmasının","x0":0.18069815320555,"x1":0.7556468157754563,"top":0.6029914531518368,"bottom":0.6162790699467816,"conf":1},{"text":"önemli olduğu değerlendirilmektedir.","x0":0.17848172258433256,"x1":0.4107823575566062,"top":0.6146575764411982,"bottom":0.6303401995626717,"conf":1},{"text":"Bilgilerini ve geregini rica ederim.","x0":0.22381930145267465,"x1":0.4373716634172775,"top":0.6307692308571974,"bottom":0.6440170941050606,"conf":1},{"text":"e-imzalıdır.","x0":0.5891109412028,"x1":0.6656906151820738,"top":0.6576736483193051,"bottom":0.6711939608323468,"conf":1},{"text":"Uzm. Dr. Muhammet ÇÖMÇE","x0":0.5236139655086335,"x1":0.7207392170295676,"top":0.6670940173291188,"bottom":0.6846153848504862,"conf":1},{"text":"Bakan a.","x0":0.593429157981751,"x1":0.6529774125829308,"top":0.6845930233711244,"bottom":0.699145299525993,"conf":1},{"text":"Genel Müdür Yardımcısı","x0":0.5503080042171236,"x1":0.7084188938041569,"top":0.6947674414655393,"bottom":0.7107558142030651,"conf":1},{"text":"HSGM Tolum Sağlığı Hizmetleri ve Eğitim Dairesi Başkanlığı Sağlık Mahallesi, A","x0":0.15400410670669232,"x1":0.5338809042547765,"t