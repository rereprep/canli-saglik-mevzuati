617610599,"bottom":0.3811420608989513,"conf":1},{"text":"sağlayacak olan hizmetlerin verilmesinde kullanılır. Izlem dönemine uygun olarak tüm bebck,","x0":0.18884550866058825,"x1":0.8050088062653532,"top":0.37808121749077683,"bottom":0.39440436251761146,"conf":1},{"text":"çocuk ve ergenlerin değerlendirilmesi, varsa sorunların tespiti, soruna yaklaşım, rutin","x0":0.19091520880939603,"x1":0.8070331913162923,"top":0.3918206681612634,"bottom":0.4058279675355747,"conf":1},{"text":"uygulamalar gibi konuları içeren izlemler ile sağlık sorunlarının yarattığı diğer","x0":0.1909145011813582,"x1":0.8070370594798959,"top":0.4043557670858524,"bottom":0.41891435705375946,"conf":1},{"text":"olumsuzlukların zamanında giderilmesine yönelik bütüncül bir yaklaşım sağlanır.","x0":0.1889117073046781,"x1":0.7207392164916869,"top":0.4186046509697521,"bottom":0.4316860466977084,"conf":1},{"text":"Bu kapsamda yapılacak çalışmalarda aşağıdaki hususlara riayet edilecektir.","x0":0.23613963752206676,"x1":0.731006152823514,"top":0.43162393148814737,"bottom":0.44622093007781793,"conf":1},{"text":"1) Doğan tüm bebekler sağlık kuruluşlarınca kayıt altına alımacaktır.","x0":0.23819302411599017,"x1":0.6817248400380919,"top":0.44476744166262616,"bottom":0.4578488373905826,"conf":1},{"text":"2) Izlemlerde Halk Sağlığı Genel Müdürlügümüzün web sayfasında güncel hali yer","x0":0.23613963005471014,"x1":0.8069815196263924,"top":0.45769230761373103,"bottom":0.4723837207758321,"conf":1},{"text":"alan Bebek, Çocuk, Ergen Izlem Protokolleri kullanılacaktır.","x0":0.18685832363760305,"x1":0.5872689861768072,"top":0.470930232364414,"bottom":0.4841880342028242,"conf":1},{"text":"3) Tüm bebek, çocuk ve ergenler protokolde belirtilen dönemlerde, döneme özel","x0":0.23203285541593668,"x1":0.8069815179858429,"top":0.484011628054587,"bottom":0.49871794869495534,"conf":1},{"text":"belirlenmiş işlem basamaklan kullamlarak değerlendirilecektir. Protokolde belirtilen","x0":0.18891170377717081,"x1":0.8069815197299747,"t