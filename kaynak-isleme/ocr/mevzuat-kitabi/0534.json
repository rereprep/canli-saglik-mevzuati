54,"top":0.323931623800507,"bottom":0.3386627905096895,"conf":1},{"text":"Aile Hekimliği Uygulama Yönetmeliğinin çalışma saatlerini düzenleyen 10.","x0":0.24024641196172894,"x1":0.7782340806460737,"top":0.36025641023521815,"bottom":0.3722222222010301,"conf":1},{"text":"Maddesinin 1. Fikrasında iAile hekimleri ve aile sağlığı elemanları tam gün esasına göre","x0":0.1950096144897116,"x1":0.7803433314023098,"top":0.36964793779694316,"bottom":0.384129594776235,"conf":1},{"text":"çalışırlar\"; 2. Fıkrasında ise \"Mesai saatleri ve günleri, çalışma yerinin şartları da dikkate","x0":0.19507186717472857,"x1":0.7782340757410828,"top":0.3822674419149412,"bottom":0.3953488368277913,"conf":1},{"text":"alınmak suretiyle çalıştığı bölgedeki kişilerin ihtiyaçlarıa uygun olarak aile hekimi","x0":0.1950718738115027,"x1":0.7802874688769691,"top":0.395299145353706,"bottom":0.4069767443069532,"conf":1},{"text":"tarafindan teklif edilir ve müdürlükçe uygun görülmesi halinde onaylanır. Yapılacak ev","x0":0.19499414005838636,"x1":0.7803544998868326,"top":0.4058342822947778,"bottom":0.4214474681447419,"conf":1},{"text":"ziynetleri ve gezici/yerinde sağhk hizmetleri çalışma süresine dåhil edilir. Çalışılan günler ve","x0":0.1930184857268105,"x1":0.7782340807922767,"top":0.4200581393428926,"bottom":0.43333333351098346,"conf":1},{"text":"saatler aile sağlığı merkezinin dış levhasının yakınıda ve görülecek bir yerine asılarak","x0":0.1950718738328898,"x1":0.7802874688983561,"top":0.43162393155504075,"bottom":0.44487179480290406,"conf":1},{"text":"kişilerin bilgilenmesi sağlanır.\" hükümleri yer almaktadır.","x0":0.19495622547425184,"x1":0.5545372468027547,"top":0.44217712015660915,"bottom":0.456934416726955,"conf":1},{"text":"Ancak bazı Aile Hekimlerinin izinsiz görev yerini terk ettikleri, mesai santlerine riayet","x0":0.23819302473355658,"x1":0.7782340799170133,"top":0.4549418606117519,"bottom":0.46965811984266725,"conf":1},{"text":"etmedikleri, diğer aile hekimleri ile sıralı çalıştıkları ve gezici hizmet planına uygun","x0":0.19502934337094496,"x1":0.7782994520563289,"top":0.46556597170293845,"bottom":0.47974967637259747,"conf":1},{"text":"davranmadıkları tespit edilmiştir. Söz konusu mesai saatlerine uyumsuz davranışlarım","x0":0.19499795935290384,"x1":0.7783036780296911,"top":0.4780404156144109,"bottom":0.4919177202132273,"conf":1},{"text":"engellenmesi amacı ile; Ilinizdeki her TSM nin kendi bölgesinde görev yapan aile hekimi ve","x0":0.1950718738410259,"x1":0.7802874689064921,"top":0.49127906964123125,"bottom":0.5029914528462863,"conf":1},{"text":"aile","x0":0.193018480364892,"x1":0.21971252561046736,"top":0.5043604650821524,"bottom":0.5130813952957546,"conf":1},{"text":"sağlığı elemanlarının mesailerini hassasiyetle takip","x0":0.22792608060638045,"x1":0.6119096511526887,"top":0.502906976834727,"bottom":0.5145348832427924,"conf":1},{"text":"etmesinin saglanmasi,","x0":0.6160164252840801,"x1":0.7782340878693375,"top":0.5042735042800017,"bottom":0.5132478632543607,"conf":1},{"text":"müdürlüğünüzce ilinizdeki tüm aile hekimi ve aile sağlığı elemanlarından her ay en az % 10","x0":0.1950718722346383,"x1":0.7761806943018806,"top":0.515811965990456,"bottom":0.5247863249648149,"conf":1},{"text":"unun rastgele seçilerek mesaiye riayetlerinin yerinde denetleme usulü ile kontrollerinin","x0":0.19507187384558008,"x1":0.7802874689110464,"top":0.527616279010566,"bottom":0.5377906977289529,"conf":1},{"text":"yapılması; mesaiye devam konusunda aksaklıkların giderilmesi için gerekli çalışmaların","x0":0.19301848567219407,"x1":0.7802874672367723,"top":0.5376068374172482,"bottom":0.5508720925872389,"conf":1},{"text":"yapılarak yapılan denetimler doğrultusunda tesis edilen iş ve işlemlerin her ayın 20 sine","x0":0.1930184865253084,"x1":0.7802874680898866,"top":0.550854700975589,"bottom":0.5625000001208882,"conf":1},{"text":"kadar bir önceki aya ait verileri içerecek şekilde düzenli olarak kurumumuza resmi yazı ile","x0":0.1950718737219875,"x1":0.7802874687874538,"t