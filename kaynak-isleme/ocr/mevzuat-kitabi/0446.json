":0.3008720927398554,"conf":0.5},{"text":"a) 05/03/2018 tarih ve E.671 sayılı Bakan Oluru","x0":0.23203285686211025,"x1":0.5010266912042827,"top":0.2876068377632529,"bottom":0.29796511633122735,"conf":1},{"text":"b) 14/03/2017 tarih ve E.966 (2017/1) sayılı Genelge","x0":0.2422997945310307,"x1":0.5277207393168718,"top":0.2978632478339098,"bottom":0.3095930233686457,"conf":1},{"text":"c) 28/11/2017 tarih ve E.4437 (2017/4) sayılı Genelge","x0":0.24024640955596774,"x1":0.5338809003382569,"top":0.30940170947203693,"bottom":0.3226744187887144,"conf":1},{"text":"d) 05/03/2018 tarih ve E.672 (2018/2) sayıl Genelge","x0":0.2422997944448618,"x1":0.527720739230703,"top":0.32122093010510055,"bottom":0.3329059827974814,"conf":1},{"text":"Bilindiği üzere Ulusal Uyuşturucu ile Mücadele Eylem Planı \"Uyuşturucuya Ulaşılabilirliğin","x0":0.24016592631069034,"x1":0.776236116887984,"top":0.3406009290265608,"bottom":0.3552293736003789,"conf":1},{"text":"Önlenmesi\" başlıklı 1. bileşenin 5. alt bileşeni mucibince \"Elektronik Renkli Reçete Sistemi\" kurulmuş ve","x0":0.1971252595189428,"x1":0.7761806950870731,"top":0.3529914528852536,"bottom":0.3633720930781821,"conf":1},{"text":"ilgi (b) Genelge ile kırmızı ve yeşil reçeteli ilaçlar elektronik reçete kapsamına alınmıştır. Projenin","x0":0.19712525952599647,"x1":0.7761806950941268,"top":0.3648255813366641,"bottom":0.3750000000550511,"conf":1},{"text":"devaminda ilgi (c) Genelge ile mor ve turuncu reçeteli ilaçlar, ilgi (d) Genelge ile de normal reçete ile","x0":0.1970613692876136,"x1":0.776242011799611,"top":0.3741061636028855,"bottom":0.38715111348493636,"conf":1},{"text":"verilmesi gereken izlemeye tâbi ilaçları içerecek şekilde kapsam genişletilmiştir.","x0":0.1970635201880212,"x1":0.6283958696769495,"top":0.38605670903495337,"bottom":0.39850775823646223,"conf":1},{"text":"İlgi (a) Bakan Oluru ile tüm ilaçların renkli reçete sistemine dahil edilerek kamu ve özel tüm sağlık","x0":0.24024641123611232,"x1":0.7761806934213451,"top":0.3968023254544063,"bottom":0.40854700846740943,"conf":1},{"text":"sunucularında Bakanlığımızın kontrolünde","x0":0.24219963330883504,"x1":0.507299173751748,"top":0.40826904680216325,"bottom":0.4210707771292803,"conf":1},{"text":"talimatlandırılmiştır. 15/06/2018","x0":0.19712525441549686,"x1":0.38193018694175895,"top":0.4200581394696761,"bottom":0.43034188023876085,"conf":0.5},{"text":"tarihinden itibaren hekimlerin tüm ilaçları Renkli Reçete Sistemi","x0":0.37987680284963316,"x1":0.7761806923906134,"top":0.4186046510957484,"bottom":0.4287790698141354,"conf":1},{"text":"üzerinden yazmaları gerekmektedir.","x0":0.19712525836117495,"x1":0.39219712338299706,"top":0.4316239316842925,"bottom":0.4418803419407028,"conf":1},{"text":"Sağlık Bakanlığı e-reçete sistemine https://renklirecete.saglik.gov.tr/ adresi üzerinden","x0":0.28534115506288277,"x1":0.7762549244170054,"top":0.45080699087479104,"bottom":0.4643836834722699,"conf":1},{"text":"Renkli Reçete sisteminde, hekimler oluşturdukları reçeteleri 5070 sayılı elektronik imza","x0":0.283304531586155,"x1":0.7762465943884524,"top":0.47463096602841714,"bottom":0.48790825705734475,"conf":1},{"text":"Kanunu ile yapılan düzenleme kapsamında ıslak imzaya eşdeğer hukuki geçerliliği olan e-imza","x0":0.2504620713551014,"x1":0.7762327084706169,"top":0.48683422109261454,"bottom":0.5002110333346498,"conf":1},{"text":"prosedürü ile imzalayacaklardır.","x0":0.25036515073181903,"x1":0.42517856544732874,"top":0.5001798582674867,"bottom":0.5116994517263959,"conf":1},{"text":"Entegrasyon işlemlerine dair dokümanlar Sağlık Bilgi Sistemleri Genel Müdürlüğü","x0":0.28536693255094286,"x1":0.776249483197576,"top":0.510723844636509,"bottom":0.5234365596550178,"conf":1},{"text":"tarafindan ilan edilecektir.","x0":0.25051334727230495,"x1":0.3942505129147815,"top":0.5230769229253327,"bottom":0.5334302326055866,"conf":1},{"text":"Hekimler kırmızı, yeşil, turuncu, mor ve normal reçete ile verilmesi gereken izlemeye tåbi","x0":0.2854209502627711,"x1":0.7761806925659943,"top":0.5333333334123156,"bottom":0.5450581396517779,"conf":1},{"text":"ilaçlar ile beraber reçete etmek istedikleri tüm ilaçları tek bir e-reçetede yazabileceklerdir. Renkli","x0":0.2504681136207731,"x1":0.7762504485262107,"top":0.5448796443993897,"bottom":0.5579163315493505,"conf":1},{"text":"reçeteye tabi ilaçlar ile diğer ilaçların ayrı ayrı reçete edilmesine gerek yoktur.","x0":0.2505133439775969,"x1":0.6714579084094666,"top":0.5581196580502841,"bottom":0.5683760683066943,"conf":1},{"text":"Hastane eczaneleri ve serbest eczaneler kırmızı, yeşil, turuncu, mor ve normal reçete ile","x0":0.28331445766119534,"x1":0.7762527196043068,"top":0.5682587443881296,"bottom":0.5824616065000607,"conf":1},{"text":"verilmesi gereken izlemeye tåbi ilaçları içermeyen -yani kapsama bu genelge ile alınan normal","x0":0.2504477413375352,"x1":0.7762601141010064,"top":0.5799335547706591,"bottom":0.5932821064637848,"conf":1},{"text":"reçeteler- için ilgili sistem üzerinden ikinci bir duyuruya kadar herhangi bir işlem","x0":0.2504449054534633,"x1":0.7762338457355447,"top":0.5919862390030782,"bottom":0.6050599058935404,"conf":1},{"text":"Ilgi (b, c, d) genelgelerdeki teknik açıklamalara dair hükümler geçerliliğini korumaktadır.","x0":0.28536307561226054,"x1":0.7680326706871736,"top":0.6158218986343201,"bottom":0.6293276663913773,"conf":1},{"text":"Bilgilerinizi ve konunun iliniz dâhilindeki tüm özel ve kamu sağlık hizmet sunucularına, (serbest","x0":0.24229979846285418,"x1":0.776180694148975,"top":0.6293604650574163,"bottom":0.639743589694205,"conf":1},{"text":"hekim, veteriner hekim, diş hekimleri dåhil) duyurulmasını önemle rica ederim.","x0":0.19501984187454355,"x1":0.6263310836794483,"top":0.6394542477194731,"bottom":0.6520876406729382,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.6016427116189748,"x1":0.7351129355405049,"top":0.6816239315139812,"bottom":0.6948717947618444,"conf":1},{"text":"Bakan a.","x0":0.6447638593913567,"x1":0.6960985633833954,"top":0.69615384