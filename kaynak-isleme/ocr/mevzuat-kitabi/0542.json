418,"top":0.2063953486785972,"bottom":0.2165697673969842,"conf":1},{"text":"Konu","x0":0.19712525712910992,"x1":0.23203285298382648,"top":0.2165697672578124,"bottom":0.22674418597619928,"conf":1},{"text":": 19831278/060.08","x0":0.24024640585772392,"x1":0.35728952856097174,"top":0.20494186031421702,"bottom":0.2166666665536794,"conf":1},{"text":": Göçmen Sağlığı Merkezi (GSM)","x0":0.238193015707985,"x1":0.4455852181752519,"top":0.21656976724486832,"bottom":0.22965116297282462,"conf":1},{"text":"Izleme ve Degerlendirme Formu","x0":0.2461985730374295,"x1":0.441611814256633,"top":0.22809974884532624,"bottom":0.24237800910079743,"conf":1},{"text":"ve Rehberi","x0":0.2463521464639798,"x1":0.3142228020081271,"top":0.24106323817301334,"bottom":0.25021583113359913,"conf":1},{"text":"DAĞITIM YERLERİNE","x0":0.44558521779450083,"x1":0.5975359294334254,"top":0.26153846126199576,"bottom":0.27616279036434066,"conf":1},{"text":"Sağlık hizmetlerinin planlanmasında ve sunulmasında toplumun demografik özellikleri büyük","x0":0.2402464023546601,"x1":0.8008213594307824,"top":0.29059829028991313,"bottom":0.305232557982805,"conf":1},{"text":"önem taşımaktadır. 2011 yılında Suriye'de başlayan iç karışıkhklar sonrası ülkemize kısa zamanda ve","x0":0.19301847605838582,"x1":0.8008213595156296,"top":0.3037790695749092,"bottom":0.3168604653028656,"conf":1},{"text":"çok yüksek sayılarda güç gerçekleşmiş; sağlık sistemimizin sağlam altyapısı, olağanüstü koşullara","x0":0.19301847608515363,"x1":0.8008213595423974,"top":0.31395348851476856,"bottom":0.3286324786424625,"conf":1},{"text":"yönelik hazır bulunuşluğu ve sağlık çalışanlarımızın fedakårlığı ile başarıyla yönetilmiştir.","x0":0.19294282340956795,"x1":0.7289932347584759,"top":0.32500582204689465,"bottom":0.34159824394536975,"conf":1},{"text":"Geçici koruma altına alınan bu kişilere sunulacak sağlık hizmetleri için gerekli mevzuat","x0":0.24229978954999978,"x1":0.8008213601270101,"top":0.34145299152632,"bottom":0.35319767453932316,"conf":1},{"text":"düzenlemeleri yapılarak Göçmen Sağlığı Merkezleri (GSM) oluşturulmuştur. Toplum Sağlığı Merkezi","x0":0.19712524982414567,"x1":0.7987679737840535,"top":0.35299145288541023,"bottom":0.36337209307833873,"conf":1},{"text":"ve Bağhı Birimler Yönetmeliği'nin 38 inci maddesinde göçmen sağlığı merkezleri toplum sağlığı","x0":0.19507186257671433,"x1":0.798767973035734,"top":0.3648255812680118,"bottom":0.37649572648212515,"conf":1},{"text":"Tüm sağlık kurum ve kuruluşlarımızda olduğu gibi göçmen sağlığı merkezleri ve bu","x0":0.2422997895563371,"x1":0.8008213601333474,"top":0.3909883719676319,"bottom":0.40261627919080367,"conf":1},{"text":"merkezlerde sunulan hizmetlerin yerinde izleme ve değerlendirmesi; tespit edilen eksiklik/aksaklıkların","x0":0.19712525062227002,"x1":0.8008213610812899,"top":0.40256410242954743,"bottom":0.41282051268595765,"conf":1},{"text":"düzeltici ve önleyici faaliyetlerle önlenmesi açısından büyük önem taşımaktadır. Sunulan hizmetin","x0":0.19712525075357318,"x1":0.8008213612125932,"top":0.41410256405931833,"bottom":0.42606837602513026,"conf":1},{"text":"etkinlik, kalite ve verimliliğini artırmak; iyileştirici, düzeltici ve önleyici faaliyetlerle mümkün olacaktır.","x0":0.19507186253496872,"x1":0.7987679729939885,"top":0.42587209289788075,"bottom":0.43760683772789,"conf":1},{"text":"Halk Sağlığı Hizmetlerinin izleme ve değerlendirmesi kapsamında \"Göçmen Sağlığı Merkezi İzleme ve","x0":0.19507188499566291,"x1":0.8008213450522492,"top":0.435897436030098,"bottom":0.4491452992779612,"conf":1},{"text":"Değerlendirme Formu\" oluşturulmuş ayrıca formun kullanılmasında görevli personele yol gösterici","x0":0.19712525059966052,"x1":0.8008213610586803,"top":0.4491279068491918,"bottom":0.4607558140723633,"conf":1},{"text":"olması adına \"Göçmen Sağlığı Merkezi İzleme ve Değerlendirme Rehberi\" hazırlanmıştır. Bu","x0":0.19712527262578022,"x1":0.8008213461832545,"top":0.46068376068563843,"bottom":0.47393162393350163,"conf":1},{"text":"1) Göçmen sağl