{"lines":[{"text":"Beyan*","x0":0.37154061515373454,"x1":0.4151902494077565,"top":0.0964883434815278,"bottom":0.10604774252390181,"conf":1},{"text":"Tespit 1","x0":0.44337634029370276,"x1":0.49091524061141034,"top":0.09112953587718897,"bottom":0.10073092878618195,"conf":1},{"text":"Tespit 2+*","x0":0.5195071867727236,"x1":0.5790554413739034,"top":0.0901162789250205,"bottom":0.10174418614819225,"conf":1},{"text":"(.......) (..d.d....)","x0":0.43121149555274646,"x1":0.5893223851397799,"top":0.10170940173086684,"bottom":0.11196581198727718,"conf":0.5},{"text":"Kriterler","x0":0.24435318240671758,"x1":0.2977412728978683,"top":0.11046511624009814,"bottom":0.11918604645370023,"conf":1},{"text":"Grup","x0":0.5965563177171695,"x1":0.6354968673346925,"top":0.1094721388625639,"bottom":0.12148860316117083,"conf":1},{"text":"Açıklama","x0":0.7063655044360109,"x1":0.7638603679253856,"top":0.10901162799415631,"bottom":0.12209302290700652,"conf":1},{"text":"5","x0":0.15811088301522752,"x1":0.1704312112352859,"top":0.21947674400199846,"bottom":0.22965116272038533,"conf":1},{"text":"7","x0":0.16016427088654467,"x1":0.17043121145431775,"top":0.5421511627129663,"bottom":0.5508720929265685,"conf":1},{"text":"Aile sağlığı merkezinde gebe","x0":0.18480492391805167,"x1":0.34086242700597297,"top":0.14957264969846662,"bottom":0.15988372098022585,"conf":1},{"text":"izlemleri ve üreme sağlığı","x0":0.18480492677034135,"x1":0.3244353194145939,"top":0.15982905990744034,"bottom":0.16880341888179928,"conf":1},{"text":"hizmetlerinin yürütülmesi için","x0":0.1848049278908109,"x1":0.35112936347429224,"top":0.17005813953869875,"bottom":0.17877906975230096,"conf":1},{"text":"en az 10 m''lik müstakil bir","x0":0.1827515396989639,"x1":0.33675564706238686,"top":0.18023255813690042,"bottom":0.18895348835050263,"conf":1},{"text":"oda olusturulmuştur","x0":0.1827515391635565,"x1":0.2997946618668043,"top":0.19186046518561417,"bottom":0.19914529922411217,"conf":1},{"text":"(gruplandırmaya dâhil olan","x0":0.1827515358277026,"x1":0.3388090389156239,"top":0.20203488372451572,"bottom":0.21075581393811782,"conf":1},{"text":"her dört hekim için bir \"gebe","x0":0.18275154188478135,"x1":0.35112936396737465,"top":0.21068376082196383,"bottom":0.22094017107837416,"conf":1},{"text":"izlem ve üreme sağlığı odası\"","x0":0.18275154150846548,"x1":0.3470225905928348,"top":0.22093023273925116,"bottom":0.23119658117865516,"conf":1},{"text":"planianir).","x0":0.1848049280382191,"x1":0.244353182639399,"top":0.2340116279014186,"bottom":0.2427325581150208,"conf":0.5},{"text":"A, B","x0":0.5995893223413626,"x1":0.6324435316969673,"top":0.1904069765725227,"bottom":0.20213675210725845,"conf":1},{"text":"a) Gebe izlemleri ve üreme sağlığı hizmetlerinin yürütildüğü oda asgari 10 m* olmalıdır.","x0":0.18472960225959623,"x1":0.5955512240264305,"top":0.2511434126045413,"bottom":0.264073929719686,"conf":1},{"text":"b) Gruplandırmaya dâhil olan 4-7 aile hekimliği biriminin bulunduğu ASM' lerde müstakil 1 oda, 8-11 aile hekimliği birimi için 2 oda, 12-","x0":0.1848049166585576,"x1":0.821355248004915,"top":0.2601744185364784,"bottom":0.27051282033091195,"conf":1},{"text":"15 aile hekimliği birimi için 3 oda vb. şektinde gebe izlem ve üreme sağlığı odası olmalıdır.","x0":0.18480493021554933,"x1":0.607802881146531,"top":0.27034883739041393,"bottom":0.2805232552936945,"conf":1},{"text":"c) Oda içerisinde muayene masası, jinekolojik muayene masası bulunmalı, hastaları mahremiyeti perde, paravan vb. araçlar ile sağlanmış","x0":0.18480493948183674,"x1":0.8234086204257606,"top":0.2790598290748185,"bottom":0.28931623933122874,"conf":1},{"text":"olmalıdır.","x0":0.18275154056435236,"x1":0.2320328534445859,"top":0.28924418603033986,"bottom":0.29796511624394206,"conf":1},{"text":"ç) Oda içerisinde lavabo olmalıdır.","x0":0.18480492629943157,"x1":0.3470225888846889,"top":0.29941860465482684,"bottom":0.30813953486842904,"conf":1},{"text":"Not: Gruplandırılmış 1, 2, 3 aile hekimliği biriminin bulunduğu ASM'Ierde soru kapsam dışıdır.","x0":0.182751548121428,"x1":0.6324435235408657,"top":0.3081196581176394,"bottom":0.3168604651047824,"conf":1},{"text":"Kullanıma hazır bir şekilde","x0":0.18275153964477725,"x1":0.33675564700820015,"top":0.3212209302360629,"bottom":0.3299418604496651,"conf":1},{"text":"müstakil asgari 5 m'lik bir","x0":0.1848049269410873,"x1":0.33675564780539824,"top":0.33119658103710703,"bottom":0.34156976749090184,"conf":1},{"text":"emzirme odası veya bölümü","x0":0.18275153584325857,"x1":0.3388090389311799,"top":0.3414529916549003,"bottom":0.3504273506292592,"conf":1},{"text":"planlanmıştır (bu alan diğer","x0":0.18480492402072105,"x1":0.3408624271086424,"top":0.3517094017202935,"bottom":0.36196581197670386,"conf":1},{"text":"aile hekimleri ile birlikte ortak","x0":0.18275154212930167,"x1":0.355236137210119,"top":0.36191860465136316,"bottom":0.37063953486496537,"conf":1},{"text":"kullamlabilir). Emzirme","x0":0.1848049297567166,"x1":0.32032854017735884,"top":0.3720930232538171,"bottom":0.3808139534674192,"conf":0.5},{"text":"A","x0":0.6078028746631522,"x1":0.6242299793409546,"top":0.3764534885595332,"bottom":0.38808139496759864,"conf":1},{"text":"alaminda masa, oturma grubu","x0":0.18275154060141383,"x1":0.3511293626840072,"top":0.3837209302365856,"bottom":0.3924418604501878,"conf":1},{"text":"ve bebek bakım ünitesi ile","x0":0.18275153805207345,"x1":0.33264887241727237,"top":0.39389534890784206,"bottom":0.4012820512579043,"conf":1},{"text":"bebeği koruyucu güvenlik","x0":0.18275154107499625,"x1":0.32854209321658484,"top":0.4040697674450189,"bottom":0.41282051302270883,"conf":1},{"text":"önlemleri (korkuluk,","x0":0.18275153995547494,"x1":0.30184804915783475,"top":0.4141025641217485,"bottom":0.4244186046987811,"conf":1},{"text":"yükseltilmiş kenarlar ve","x0":0.18258533667113336,"x1":0.3205198449890369,"top":0.4232002452783251,"bottom":0.4347098316777621,"conf":1},{"text":"benzerleri) bulunmaktadır.","x0":0.18275153963722804,"x1":0.33675564700065097,"top":0.4345930232588795,"bottom":0.4433139534724817,"conf":1},{"text":"a) Kullanıma hazır bir şekilde müstakil asgari 5 m'lik bir emzirme odası veya bölümü olmalıdır. Enızirme bölümü oluşturulmuş ise,","x0":0.1848049246623405,"x1":0.7987679676169201,"top":0.44316239328812057,"bottom":0.45348837204814696,"conf":1},{"text":"paravan ya da perde ile oluşturulmuş olmamalı, mahremiyeti sağlayacak kapısı olmalıdır.","x0":0.18472402840873944,"x1":0.5976087048796055,"top":0.4527041818903932,"bottom":0.4651737706836342,"conf":1},{"text":"b) Emzirme bölümünde bebek bakım ünitesi (bebeğin düşmemesi için gerekli düzenlemenin yapıldığı korkuluk, emniyet kemeri vb.olduğu","x0":0.18480491848479347,"x1":0.8254620228293748,"top":0.46220930225175616,"bottom":0.47238372097014314,"conf":1},{"text":"temiz bir alt değiştirme yeri) bulunmalıdır.","x0":0.18480493050229732,"x1":0.3839835685223434,"top":0.4722222221985124,"bottom":0.48119658117287134,"conf":1},{"text":"c) Emzirme bölümünde annelerin kullanabileceği ıslak mendil, en az bir adet koltuk veya sandalye olmalıdır.","x0":0.18475821609487872,"x1":0.6879193869897737,"top":0.48042641918150386,"bottom":0.4913093249948677,"conf":1},{"text":"Ç) Enzirme bölümünün kolay fark edilebilen ve okunabilen asgari 15x30 cm ebatında bir tabelası olmalıdır.","x0":0.18269846160515918,"x1":0.6838275012911477,"top":0.4894585501346196,"bottom":0.5012960790480686,"conf":1},{"text":"Aile sağlığı merkezinde","x0":0.18480492820690755,"x1":0.31622176562932575,"top":0.5012820510835668,"bottom":0.5116279070246872,"conf":1},{"text":"gruplandırmaya dahil olan her","x0":0.1846376023111554,"x1":0.3574363217980055,"top":0.5103410906316022,"bottom":0.5220719074645765,"conf":1},{"text":"A","x0":0.6119096509823733,"x1":0.6242299792024317,"top":0.5159883719089753,"bottom":0.5261627906273622,"conf":1},{"text":"dört hekim için bir adet","x0":0.1848049290043273,"x1":0.3182751529258575,"top":0.5230769229943909,"bottom":0.5320512819687498,"conf":1},{"text":"müdahale odası planlanmıştır.","x0":0.1846507425751998,"x1":0.3533254560420793,"top":0.5317953735311168,"bottom":0.5429178537442495,"conf":1},{"text":"a) Gruplandırmaya dâbil olan 7 aile hekinliği biriminin bulunduğu ASM'ere kadar 1 oda, 8-11 aile hekimliği birimi için 2 oda, 12-15 aile","x0":0.18275154920507558,"x1":0.8254620031472233,"top":0.5448717947737952,"bottom":0.555232558193183,"conf":1},{"text":"hekimliği birimi için 3 oda vb. şeklinde müdahale odası olmalıdır.","x0":0.18275153171346653,"x1":0.4948665378893092,"top":0.5551282049830282,"bottom":0.5641025639573872,"conf":1},{"text":"b) Gruplandırılmış 7 aile hekimliği biriminin bulunduğu ASM'lerde soru kapsam dışı olup asgari şartlardaki müdahale odası yeterli","x0":0.18480492370387294,"x1":0.7926078071611167,"top":0.563953488312954,"bottom":0.574127907031341,"conf":1},{"text":"sayılacaktır.","x0":0.18480492724260053,"x1":0.24229979534466844,"top":0.5741279070385922,"bottom":0.5813953487474096,"conf":1},{"text":"c) Ilave müdahale odasında lavabo, muayene ve müdahale masası, hasta malıremiyetini sağlanaya yönelik paravan vb. öniemler","x0":0.1848049365528727,"x1":0.778234077614787,"top":0.5828488371506556,"bottom":0.5931623932838281,"conf":1},{"text":"ve","x0":0.8110882959823771,"x1":0.8254620118547208,"top":0.5828488371461058,"bottom":0.591569767359708,"conf":1},{"text":"müdahale için gerekli tıbbi sari malzemeleri kullanıma hazır şekilde bulundurulmalıdır.","x0":0.18480493715782964,"x1":0.5893223726952579,"top":0.5930232558211838,"bottom":0.601744186034786,"conf":1},{"text":"Belgelendirmek kaydıyla her","x0":0.18480492550225658,"x1":0.3449692015884019,"top":0.6059829060811905,"bottom":0.6149572650555495,"conf":1},{"text":"aile hekimi haftalık asgari 10","x0":0.18480492630764514,"x1":0.34702258889290244,"top":0.6162393161567095,"bottom":0.6264957264131197,"conf":1},{"text":"saat temizlik personeli","x0":0.18480492669667384,"x1":0.312114991120868,"top":0.6264534883006903,"bottom":0.6367521369555954,"conf":1},{"text":"A, B,","x0":0.6057494865062335,"x1":0.6324435317518089,"top":0.6175213673428607,"bottom":0.6264957263172196,"conf":1},{"text":"C. D","x0":0.6057494868816776,"x1":0.6303901433217944,"top":0.626453488414883,"bottom":0.6337606836707821,"conf":1},{"text":"çalıştırmaktadır.","x0":0.1824941744414128,"x1":0.27957277687360843,"top":0.6358371561575573,"bottom":0.6474157241841081,"conf":1},{"text":"a) Temizlik, dezenteksiyon, sterilizasyon talimatları bulunmalı ve uygulanmalıdır.","x0":0.18480492840761342,"x1":0.5667351124548096,"top":0.6468023255883958,"bottom":0.6555555556099458,"conf":1},{"text":"b) Temizlik personeli bu konuda eğitilmelidir ve bu eğitimler kayıt altına alınmalıdır.","x0":0.18480493397640851,"x1":0.5811088235173887,"top":0.6568376067784679,"bottom":0.6658119657528269,"conf":1},{"text":"c) Çalıştırılan personelin ilgili sosyal güvenlik kuruluşuna kaydedildiğine, aile hekimi/hekimlerince sigorta primlerinin yatırıldığına ve","x0":0.18480493291141104,"x1":0.8110882948606628,"top":0.6641025639193032,"bottom":0.6760683758851153,"conf":1},{"text":"maaşıaım ödendiğine dair belgeler özlük dosyasında saklanıalıdır. İşe yeni başlayan personel için ilk ay sadece SGK İşe Giriş Belgesi","x0":0.18480492936876158,"x1":0.8069815183197894,"top":0.6743589742690894,"bottom":0.6846153845254997,"conf":1},{"text":"istenmelidir. Hizmet satın alma yöntemi ile çalıştırılıyor isc ayrıca fatura da dosyaya eklenmelidir.","x0":0.18480492015538127,"x1":0.6406570919737005,"top":0.6845930232631544,"bottom":0.6933139534767566,"conf":1},{"text":"g) Çalıştırılan personelin güncel çalışma gün ve saatleri yazılı olarak mildirliğe bildirilmiş olmalıdır.","x0":0.1868125169795196,"x1":0.6550932400254498,"top":0.6920995365703853,"bottom":0.7035077514655196,"conf":1},{"text":"d) Çalıştırılan personelin kullanacağı izinler ve çalışma planındaki değişiklikler de yazıh (ani gelişen durumlarda aynı gün içerisinde sözlü.","x0":0.18685832869299346,"x1":0.8254620096369173,"top":0.7020348839020418,"bottom":0.7123931624700163,"conf":1},{"text":"en geç ertesi iş günü yazılı) olarak müdürlüğe önceden bildirilmiş olmalıdır.","x0":0.1847400925826465,"x1":0.5380695861871658,"top":0.711705852906892,"bottom":0.7229671889155996,"conf":1},{"text":"Not: Personel çalıştırılması ile ilgili herhangi bir süre kesintisi olması (yeni personel, izin vb.) durumunda gruplandırma kriterlerinin","x0":0.18480491952748254,"x1":0.8295687968702878,"top":0.7209302324994082,"bottom":0.7311965813463654,"conf":1},{"text":"devamı bakımından aile hekimine 1 yılda toplamda 14 (ondört) güne kadar süre tanınabilir. Bu sürenin uzaması halinde hizmetin","x0":0.18480491954182166,"x1":0.829568796884627,"top":0.7324786324488054,"bottom":0.7414529914231645,"conf":1},{"text":"devamlılığı için başka bir personel çalıştırılmalıdır. Söz konusu personel aynı aile sağlığı merkezindeki tek aile hekimliği birimiyle veya","x0":0.18480491959348444,"x1":0.8295687969362897,"top":0.7427325580800174,"bottom":0.752991453187841,"conf":1},{"text":"birden fazla aile hekimliği birimiyle sözleşme imzalamış olsa dahi bu süre 1 yılda toplamda 14 (ondört) günü geçemez.","x0":0.1847517589899052,"x1":0.73720549773641,"top":0.7528793442969355,"bottom":0.7642640441917672,"conf":1},{"text":"Yukarıdaki bilgiler tarafımdan doldurulmuştur ve doğrudur. Eksik/yanlış verdiğim bilgilerden sorumlu olacağımı beyan ederim.","x0":0.17659137035093614,"x1":0.8295687936901894,"top":0.7819767441273874,"bottom":0.7923076921826873,"conf":1},{"text":"Aile Hekimi (Ad- Soyad):","x0":0.16016427032724537,"x1":0.28952772125055154,"top":0.7935897436869683,"bottom":0.8023255813788379,"conf":1},{"text":"Imza:","x0":0.6344969193559601,"x1":0.6694045175170232,"top":0.7936046511099764,"bottom":0.8023255813235785,"conf":1},{"text":"512","x0":0.48459958886086224,"x1":0.5133470229118962,"top":0.9331395346959077,"bottom":0.9447674419190794,"conf":1}]}