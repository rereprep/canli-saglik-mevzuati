94393713,"conf":1},{"text":"ANKARA VALILIGINE","x0":0.41446992147768924,"x1":0.5896946408192948,"top":0.25035655590860184,"bottom":0.2674719939949566,"conf":1},{"text":"(II Sağhık Müdürlüğü)","x0":0.42299794319127093,"x1":0.5811088327783043,"top":0.2645299146344381,"bottom":0.2777777778823013,"conf":1},{"text":"Ilgi : 12/10/2023 tarihli ve 226755678 sayılı yazınız,","x0":0.1971252513610845,"x1":0.5646817299144967,"top":0.29941860479793303,"bottom":0.3141025638133472,"conf":1},{"text":"Ilgide kayıtlı yazınız ve ekleri bir bütün olarak incelendiğinde; Müdürlüğünüz Izleme,","x0":0.22369052916451562,"x1":0.8070339243192541,"top":0.3334803777550963,"bottom":0.35182724087410755,"conf":1},{"text":"Değerlendirme ve Istatistik Birimi tarafindan aile sağlığı merkezlerine yapılan 2023 Yılı","x0":0.20123202600737172,"x1":0.8028747499672795,"top":0.3473837209382069,"bottom":0.3561046511518091,"conf":1},{"text":"1. Periyodik Izleme Değerlendirme ziyaretlerinde Etimesgut Ilçesinde bulunan Bağlica 3 No.lu","x0":0.19917865244090618,"x1":0.8049281124974924,"top":0.3575581396738743,"bottom":0.36923076933184795,"conf":1},{"text":"Aile Sağlığı Merkezinde bayrak ve bayrak direklerinin olmadığının tespit edildiği, bu çerçevede","x0":0.1991786395127355,"x1":0.8049281364708674,"top":0.370512820444618,"bottom":0.3808139535433833,"conf":1},{"text":"yapılan inceleme ve sonucunda düzenlenen raporun sonuç ve kanaat kısmında idari yönden","x0":0.19912409135354495,"x1":0.804963664984232,"top":0.3812600692972845,"bottom":0.39391539676002707,"conf":1},{"text":"getirilen teklifin Ankara Il Sağlık Müdürlüğü Halk Sağlığı Başkanlığınca değerlendirilerek","x0":0.19912114058827377,"x1":0.8049681683311509,"top":0.39224346626045015,"bottom":0.4055465814856959,"conf":1},{"text":"gerekli işlemlerin yürütülmesinin belirtilmesinin önerildiği, Müdürlükçe konuya ilişkin tesis","x0":0.19911993670599668,"x1":0.804974197151791,"top":0.4031393689952396,"bottom":0.4171731642134221,"conf":1},{"text":"edilecek işlem konusunda tereddüt hasıl olduğu, bu sebeple aile sağlığı merkezlerinde bulunan","x0":0.1991786394983071,"x1":0.8049281364564389,"top":0.4170940171960301,"bottom":0.42877906988841086,"conf":1},{"text":"bayrak direklerinin yapımının aile hekimlerinin sorumluluğunda olup olmadığı hakkında görüş","x0":0.19712525221226637,"x1":0.8049281356695102,"top":0.42863247848802,"bottom":0.4405982904538319,"conf":1},{"text":"talebinde bulunulduğu anlaşılmaktadır.","x0":0.19712525295267191,"x1":0.44969199530194826,"top":0.4404069766158273,"bottom":0.45213675215056304,"conf":1},{"text":"Bilindiği üzere aile hekimleri tarafindan özel hukuk (gerçek ve tüzel) kişilerinden","x0":0.24435317844073604,"x1":0.8049281355168583,"top":0.4520348836621355,"bottom":0.46239316223010984,"conf":1},{"text":"kiralanan aile sağlığı merkezlerinde kira sözleşmesinin tarafları aile hekimi ve mülk sahibidir.","x0":0.19917863871229205,"x1":0.8028747491713117,"top":0.46495726482283106,"bottom":0.47529069772954435,"conf":1},{"text":"Bakanlığımız ÇKYS bina kayıtları incelendiğinde Bağlıca 3 No.lu Aile Sağlığı Merkezinin","x0":0.19917863949637238,"x1":0.8049281364545042,"top":0.4752136753728442,"bottom":0.4854700856292544,"conf":1},{"text":"özelden kiralanan bir binada hizmet verdiği görülmektedir. Ote yandan Aile Hekimliği","x0":0.19917863951087028,"x1":0.8049281364690022,"top":0.4867521365983595,"bottom":0.4987179485641715,"conf":1},{"text":"Sözleşme ve Odeme Yönetmeliği hükümlerine göre sözleşme ile çalıştırılan aile hekimlerine","x0":0.199178639498616,"x1":0.8049281364567478,"top":0.4985465115025157,"bottom":0.5102564102637107,"conf":1},{"text":"kira, elektrik, su, telefon, internet, bilgi-işlem, temizlik, büro malzemeleri, küçük onarım ve","x0":0.19917863949479286,"x1":0.8049281364529247,"top":0.5101744184792013,"bottom":0.521802325702373,"conf":1},{"text":"tıbbi sarf malzeme vb. aile sağlığı merkezi giderleri için ödemeler yapılmaktadır. Açıklanan","x0":0.19911758853134004,"x1":0.8049687492473128,"top":0.5216286274551337,"bottom":0.535775419223004,"conf":1},{"text":"nedenlerle Bağlıca 3 No.lu Aile Sağlığı Merkezi bayrak direğinin yapımının burada görevli aile","x0":0.1991786394357311,"x1":0.804928136393863,"top":0.5333333334150462,"bottom":0.5450581396545084,"conf":1},{"text":"hekimlerinin sorumluluğunda olduğu mütalaa edilmiştir.","x0":0.19904204695373884,"x1":0.5648054794115117,"top":0.5436047829025403,"bottom":0.5576409777935326,"conf":1},{"text":"Bilgilerini ve gereğini rica ederim.","x0":0.2464065736206209,"x1":0.46817248158167174,"top":0.5566860463820251,"bottom":0.5683760683696794,"conf":1},{"text":"Dr. Oğretim Üyesi Süleyman ÖZSARI","x0":0.5236139609217704,"x1":0.7802874762692708,"top":0.591452991523432,"bottom":0.6031976745364351,"conf":1},{"text":"Bakan a.","x0":0.6384974032082443,"x1":0.6982582430003322,"top":0.602878319634346,"bottom":0.6136914474617866,"conf":1},{"text":"Genel Müdür Yardımcısı","x0":0.5770020523263986,"x1":0.741273101410768,"top":0.6162393162225709,"bottom":0.6249999999832546,"conf":1},{"text":"Alle Heğ migi Egitim ve frieme Dharei Reykanliğ.","x0":0.201232035530433,"x1":0.42299794349148384,"top":0.7529069766096861,"bottom":0.7732558140464599,"conf":0.30000001192092896},{"text":"Sağlık Mahallesi A. Adnan Saygun 2 Caddesi No:55 Sıhhiye/ANKAR/","x0":0.20123204096203365,"x1":0.5051334642398828,"top":0.7703488373967424,"bottom":0.7820512820112506,"conf":1},{"text":"Bilgi için: Mänüre YILMAZ","x0":0.5831622161435095,"x1":0.7104722805677036,"top":0.7558139534231646,"bottom":0.7659883721415515,"conf":1},{"text":"Tel : (312) 565 51 61","x0":0.5811088291607448,"x1":0.6755646819229878,"top":0.7717948718420498,"bottom":0.7805232557947857,"conf":1},{"text":"Bu belge, güvenli elektronik imza ile imzalanmıştır.","x0":0.37987680106427235,"x1":0.6057494820235473,"top":0.8212209301683175,"bottom":0.8313953488867044,"conf":1},{"text":"Belge doğrulama kodu: : AABID1/A1-49E9-4B27-ACB5-55C5B0F28AAD","x0":0.13963038977519923,"x1":0.4722792609421619,"top":0.83119