bottom":0.35174418580008027,"conf":1},{"text":"Ilgi: 2006/78 tarih ve 857 sayılı genelgemiz.","x0":0.201232029927408,"x1":0.4866529747132491,"top":0.37500000000629885,"bottom":0.38974358974988865,"conf":1},{"text":"Ilgi genelge ile verem kontrol programında belirlenen ülke hedeflerine ulaşmak üzere","x0":0.24845995459241338,"x1":0.8090349116685356,"top":0.39389534864448983,"bottom":0.40697674437244635,"conf":1},{"text":"Doğrudan Gözetimli Tedavi Stratejişinin ülke genelinde uygulanmasıa geçilmiş ve bu","x0":0.20328541558571758,"x1":0.8090349125438494,"top":0.4068376065088083,"bottom":0.4215116277487818,"conf":1},{"text":"konuda başta Il Sağlık Müdürlükleri olmak üzere tüm sağlık kuruluşlarının her düzeyde","x0":0.20123204202509493,"x1":0.8069815020816813,"top":0.4186046511690895,"bottom":0.43333333343441205,"conf":1},{"text":"üzerine düşen görevleri eksiksiz yerine getırmesı ıstenmıştır.","x0":0.20313652436796387,"x1":0.5935573481167358,"top":0.4317620561489932,"bottom":0.4475528340890098,"conf":1},{"text":"Geçen bu süre içerisinde illerde yapılan faaliyetler Bakanlığımız tarafından titizlikle","x0":0.24845995462222667,"x1":0.809034911698349,"top":0.45042735019714675,"bottom":0.46511627891538765,"conf":1},{"text":"takip edilmekte olup, karşılaşılan sorunlar ve hizmetin ifası sırasında yaşanılan aksakhıkların","x0":0.20328541569289346,"x1":0.8090349126510252,"top":0.4636627905055797,"bottom":0.47692307678785006,"conf":1},{"text":"giderılmesi amacıyla illerde Doğrudan Gözetimli Tedavi (DGT) çalışmalarımın Il Sağlık","x0":0.20117610286843088,"x1":0.8090967391573517,"top":0.47510976536035776,"bottom":0.49108105999166374,"conf":1},{"text":"Müdürlükleri tarafından, Verem Savaşı Il Koordinatörleri ile birlikte hassasiyetle gözden","x0":0.20123202826257794,"x1":0.8090349117198218,"top":0.4883720931229931,"bottom":0.5029914533376179,"conf":1},{"text":"geçırılmesı gerekmektedir.","x0":0.20098584926699062,"x1":0.3759930155471259,"top":0.5023316282854754,"bottom":0.5170652052638491,"conf":1},{"text":"İl Sağlık Müdürlüğü Bulaşıcı Hastalıklar Şubesi ve Verem Savaşı İ1 Koordinatörü;","x0":0.246406566512629,"x1":0.8069815235887512,"top":0.5188034188570276,"bottom":0.5334302324032328,"conf":1},{"text":"birlikte DGT'nin uygulanmasında aktif rol alarak düzenli denetimlerde bulunacaktır. Ayrıca","x0":0.20123202759303244,"x1":0.8069815245511642,"top":0.5333333336908729,"bottom":0.5479651161247985,"conf":1},{"text":"Verem Savaşı Dairesi Başkanlığı tarafından oluşturulacak 'Verem Savaşı Izleme ve","x0":0.20328541576840545,"x1":0.8090349127265373,"top":0.5448717950470315,"bottom":0.5581395350684356,"conf":1},{"text":"Değerlendirme Ekipleri\" tarafindan illere ziyaret yapılacak ve il düzeyinde yapılan DGT","x0":0.2012320439911448,"x1":0.8090348905468431,"top":0.5566860468445991,"bottom":0.5726744179519125,"conf":1},{"text":"uygulamaları ile bunlarla ilgili kayıtlar kontrol edilecektir.","x0":0.20113874014217378,"x1":0.579127839130422,"top":0.570031129764193,"bottom":0.5858662103592911,"conf":1},{"text":"Uygulamaya esas olmak üzere;","x0":0.24845996220133726,"x1":0.45174537321960734,"top":0.5901162791787493,"bottom":0.6031976740915995,"conf":1},{"text":"1. Verem hastasına DGT uygulanması işleyişinden, hastanın ikamet ettiği ilin İl Sağlık","x0":0.20322062369061514,"x1":0.8091065825639903,"top":0.6059323478276908,"bottom":0.6235004837005561,"conf":1},{"text":"Müdürlüğü sorumludur.","x0":0.2009365063307556,"x1":0.3596536329579661,"top":0.6201650687923707,"bottom":0.6350900588024284,"conf":1},{"text":"2. DGT de en iyi gözeticinin bir sağlık personeli olması gerektiği ilkesinden hareketle","x0":0.20123202839458143,"x1":0.8090349118518252,"top":0.6395348835291459,"bottom":0.6526162792571023,"conf":1},{"text":"verem hastasının tedavisinde ildeki tüm sağlık kurım ve kuruluşlarında çalışan her sağlık","x0":0.20123202763250156,"x1":0.8069815245906333,"top":0.652564102361189,"bottom":0.6642441861658495,"conf":1},{"text":"personelı gözetımcı olmak üzere görevlendırılebılecektır.","x0":0.2032854164572428,"x1":0.572895281509767,"top":0.6656976742915406,"bottom":0.6773504271759735,"conf":1},{"text":"3. DGT'nin uygulanma kayıtlarının tutulması ve raporlanması işlerini Il Sağlık Müdürlüğü","x0":0.20123202856333683,"x1":0.8090349120205806,"top":0.6816239314828865,"bottom":0.696220930072557,"conf":1},{"text":"Bulaşıcı Hastalıklar Şubesi yürütür.","x0":0.2012320303711663,"x1":0.4332648892785499,"top":0.6961538459755476,"bottom":0.7094017092234108,"conf":1},{"text":"4. DGT'nin planlanmasi;","x0":0.20328542371291666,"x1":0.377823405292846,"top":0.713662790555706,"bottom":0.7252906977788777,"conf":1},{"text":"a. Aile hekimliğine geçilmeyen illerde; verem hastasının dispansere kaydı sırasında","x0":0.25051334112685,"x1":0.8069815252047482,"top":0.7324786325895514,"bottom":0.7470930231013494,"conf":1},{"text":"DGT uygulaması hakkında bilgi verildikten sonra dispanser doktorunca veya birden fazla","x0":0.2258726935831049,"x1":0.8069815156503471,"top":0.7440170938817303,"bottom":0.7587209300782385,"conf":1},{"text":"doktor olan dispanserlerde sorumlu doktor tarafinca görevlendirilen dispanser","x0":0.22587269874774438,"x1":0.7248459870474157,"top":0.7572649575614607,"bottom":0.7718023254229558,"conf":1},{"text":"I..","x0":0.7864476383507758,"x1":0.806981519486322,"top":0.7761627908851148,"bottom":0.7877906972931801,"conf":0.5},{"text":"Verem Savaşı Dairesi Başkanlığı, İlkiz Sok, No:4/5 Sıhhiye ANKARA İRTİBAT: S.Murat MUTLU","x0":0.20123203888953153,"x1":0.7885010204541099,"top":0.8051282051922398,"bottom":0.8183760684401031,"conf":1},{"text":"Tel: +90 312 231 44 25 -231 21 85 - 231 38 56 Faks: + 90 312 231 37 16 E-posta: smurat mutlu@saglik.gov.tr","x0":0.203285427920059,"x1":0.7453798696026278,"top":0.8166666666172254,"bottom":0.8270348837757467,"conf":1},{"text":"413","x0":0.48665297728309875,"x1":0.513347022528674,"top":0.9156976743193433,"bottom":0.9258720930377303,"conf":1}]}