{"lines":[{"text":"T.C. SAGLII","x0":0.49486653047165907,"x1":0.5564681715719509,"top":0.09738372091894643,"bottom":0.10610465113254863,"conf":1},{"text":"BAKANLIGI","x0":0.5010266931563582,"x1":0.5585215612584261,"top":0.10610465122563695,"bottom":0.11337209293445438,"conf":1},{"text":"EK-1","x0":0.18891170318177164,"x1":0.22792607895375197,"top":0.1264534882146795,"bottom":0.13808139543785125,"conf":1},{"text":"K Vitamini Uygulaması Ebeveyn Bilgilendirme ve Ret Formu","x0":0.27310060795404795,"x1":0.7289527797723672,"top":0.15116279084341366,"bottom":0.16581196601457293,"conf":1},{"text":"Bebek adr:","x0":0.19083349001067068,"x1":0.2629652777178507,"top":0.17399906239017415,"bottom":0.18646605343978584,"conf":1},{"text":"Doğum tarihi:","x0":0.1909650911987499,"x1":0.28336755746188097,"top":0.1991279068403169,"bottom":0.21075581406348853,"conf":1},{"text":"Doğum yeri:","x0":0.418679480328363,"x1":0.503291772026519,"top":0.19841188157416645,"bottom":0.21292532769733863,"conf":1},{"text":"Ebeveyn adı:","x0":0.18883184656672972,"x1":0.2772872497205425,"top":0.22210971705134586,"bottom":0.23573912012490938,"conf":1},{"text":"K vitamini vücutta depolanabilen yağda çözünen vitamin türlerinden biridir ve kanın","x0":0.2381246092727086,"x1":0.8132050103600348,"top":0.2456001212042901,"bottom":0.2611264713397673,"conf":1},{"text":"pıbtılaşmasında çok önemli görevlere sahiptir. Eksikliği halinde kanama, pıhtılaşma","x0":0.1909650935085379,"x1":0.8131416824595656,"top":0.26017441847938305,"bottom":0.2718023257025547,"conf":1},{"text":"bozuklukları ve buna bağlı olarak vücudun birçok doku ve organında bozukluklar meydana","x0":0.19087097837157438,"x1":0.8132264660151658,"top":0.2703086048638589,"bottom":0.28587271153609695,"conf":1},{"text":"gelebilir. Sağhklı kişilerde vücudun sağladığı vücudun gereksinim duyduğu K vitamininin","x0":0.18891168772695077,"x1":0.8131417000786361,"top":0.28488372107845217,"bottom":0.29957264979669307,"conf":1},{"text":"çoğu, tüketilen besinlerden ve bağırsaklarımızdaki sağhıklı bakterilerden karşılanmaktadır.","x0":0.18891170542739658,"x1":0.8110882943784243,"top":0.29786324777557616,"bottom":0.31111111102343947,"conf":1},{"text":"Ancak bebekler düşük seviyelerde K vitamini depoları ile doğarlar ve bağırsaklarında kendi","x0":0.1909650912534389,"x1":0.8131416802044666,"top":0.30940170925951005,"bottom":0.3226744181686344,"conf":1},{"text":"başlarına K vitamini üretmek için yeterli bakteri bulunmaz. Ayrıca, 6. aydan itibaren anne","x0":0.19096507584055306,"x1":0.8151950881922383,"top":0.3239316239673168,"bottom":0.3358974359331288,"conf":1},{"text":"sütüne ek olarak tamamlayıcı besinler başlanana kadar K vitamini ihtiyacı yeterince","x0":0.18685831888442125,"x1":0.8131416808336731,"top":0.33575581410103017,"bottom":0.3504273500820372,"conf":1},{"text":"karşılanamaz.","x0":0.19096509108374687,"x1":0.2833675573468779,"top":0.350290697593326,"bottom":0.36046511631171285,"conf":1},{"text":"Yetersiz olan bu miktar yeni doğan bebeklerin yenidoğan hemorajik (kanama) hastalığı","x0":0.2361396324148662,"x1":0.8131416814838845,"top":0.3619186047994145,"bottom":0.3764957262079911,"conf":1},{"text":"riski altında kalmasına sebep olur. Yenidoğan hemorajik (kanama) hastahığı bebeklerde görülen","x0":0.18891168775007744,"x1":0.8131417001017627,"top":0.37499999980792476,"bottom":0.38808139553588106,"conf":1},{"text":"bir kanama bozukluğudur. Düşük K vitamini depoları nedeniyle normal yenidoğanlarda bile bu","x0":0.18891168776494555,"x1":0.8131417001166308,"top":0.38803418787087485,"bottom":0.40128205111873805,"conf":1},{"text":"eksikliğe ve kanamaya eğilim vardır. Hastalık özellikle prematüre bebeklerde daha uzun ve","x0":0.18884871827056318,"x1":0.8152509769994023,"top":0.39960593867438965,"bottom":0.41560568703478706,"conf":1},{"text":"daha şiddetli seyretmektedir.","x0":0.18891170598560267,"x1":0.38398357100742475,"top":0.41410256399111867,"bottom":0.427350427238982,"conf":1},{"text":"Kanama vücudun içinde veya dışında oluşabilir. K vitamini eksikliğinin en önemli ve","x0":0.23613963242567645,"x1":0.8131416814946947,"top":0.4258720928308648,"bottom":0.4389534885588211,"conf":1},{"text":"olumsuz sonucu kafa içi kanama ve iç organlarda oluşan kanamalardır. Bu durumdaki bebek","x0":0.18891168772438682,"x1":0.8131417000760721,"top":0.43888888903626166,"bottom":0.450581395467776,"conf":1},{"text":"yaşamını kaybedebileceği gibi beyin hasanı sonucu zekå geriliği ve felç gibi önemli sorunlarla","x0":0.18891168774272402,"x1":0.8131417000944092,"top":0.4520348835947041,"bottom":0.46367521385228294,"conf":1},{"text":"baş etmek durumunda da kalabilir. Yenidoğan bebeklere doğumu takiben yapılan tek doz K","x0":0.18891172302549755,"x1":0.8131416615740918,"top":0.46366279066763605,"bottom":0.4782051282319577,"conf":1},{"text":"vitamini, bu vitaminin eksikliğini ve bunun sonucunda ortaya çıkabilecek kanamalan ve","x0":0.1889116877600623,"x1":0.8131417001117477,"top":0.4781976742267091,"bottom":0.4914529916212591,"conf":1},{"text":"olumsuz sonuçları önlemektedir.","x0":0.18891170551342198,"x1":0.4065708404762488,"top":0.4912790697054352,"bottom":0.5014534884238222,"conf":1},{"text":"Bilim Kurulu önerileri ile hazırlanan Sağlık Bakanlığının 2021/.. sayılı Genelgesi ve","x0":0.236139632443957,"x1":0.8131416815129753,"top":0.5029069766188109,"bottom":0.5145348838419825,"conf":1},{"text":"talimatları uyarınca koruyucu sağlık hizmetleri kapsamında, ülkemizde tüm yenidoğan","x0":0.19090311814911703,"x1":0.8132020726250087,"top":0.5145605508914232,"bottom":0.5292938132387831,"conf":1},{"text":"bebeklere doğumu takiben intramüsküler (IM, kas içine) K vitamini uygulaması","x0":0.19096509447041357,"x1":0.8131416834214413,"top":0.5276162789791671,"bottom":0.5423076921412681,"conf":1},{"text":"gerçekleştirilmektedir.","x0":0.18656602418474044,"x1":0.3410721401730878,"top":0.5397630496145719,"bottom":0.5556261943179723,"conf":1},{"text":"Ebeveyn: Bu bilgileri okudum / okuduk, soru sorma firsatım / firsatımız oldu, K vitamini","x0":0.19096509350080013,"x1":0.8131416824518278,"top":0.5666666665507856,"bottom":0.5786324785165975,"conf":1},{"text":"uygulaması önleyici bakımı reddetme kararımın olası sonuçlanı hakkında tam olarak","x0":0.18891168780493017,"x1":0.8131417001566155,"top":0.5799145298265854,"bottom":0.5915697675624315,"conf":1},{"text":"bilgilendirildim / bilgilendirildık. Bebeğimde K vitamini eksikliğine bağhı sağlık sorunu olması","x0":0.18891168771708078,"x1":0.8131417000687661,"top":0.5930232556212033,"bottom":0.6061046513491597,"conf":1},{"text":"halinde doğacak tüm cezai ve hukuki sorumluluğu kabul ediyorum / ediyoruz.","x0":0.18685831364802302,"x1":0.7043121173412479,"top":0.6059829058852947,"bottom":0.6192307691331579,"conf":1},{"text":"Imza:","x0":0.18812716636833665,"x1":0.23055553936148301,"top":0.6317583521810518,"bottom":0.6435633339018051,"conf":1},{"text":"Yakınlk:","x0":0.4043889556046393,"x1":0.46419420640673126,"top":0.6318070881833932,"bottom":0.6414487257409853,"conf":1},{"text":"Tarih:","x0":0.6160164260494848,"x1":0.6611909659314943,"top":0.6322674417066516,"bottom":0.6438953489298233,"conf":1},{"text":"(opsiyonel - ikinci ebeveyn/vasi)","x0":0.18685831799072716,"x1":0.408624225951778,"top":0.6540697674118222,"bottom":0.6688034185648649,"conf":1},{"text":"Imza:","x0":0.18586438410490225,"x1":0.23090092604483717,"top":0.6810277015463432,"bottom":0.6946391934750958,"conf":1},{"text":"Yakınlik:","x0":0.4004106768097625,"x1":0.4640657090218596,"top":0.681686046366881,"bottom":0.6933139535900527,"conf":1},{"text":"Tarih:","x0":0.6157688052167528,"x1":0.6675987510128106,"top":0.6811851740953976,"bottom":0.6952683142159446,"conf":1},{"text":"Sağlık personeli: Doğumdan sonra bebeklere K vitamini yapılması gerekliligini ve","x0":0.18685831905507191,"x1":0.8131416810043237,"top":0.7049418601362581,"bottom":0.7209401706492248,"conf":1},{"text":"yapılmamasımın olası sonuçlanını açıkladım. Ebeveynlere imzalı ret formunun bir kopyasını","x0":0.18685831898629346,"x1":0.8131416809355453,"top":0.7179487177544697,"bottom":0.7325581393785474,"conf":1},{"text":"verdim ve bir aslını dosyaladım.","x0":0.18891170392780024,"x1":0.4024640658924031,"top":0.7311046510324868,"bottom":0.7427350426995186,"conf":1},{"text":"Imza:","x0":0.18891170356671255,"x1":0.22997946583780488,"top":0.755813953304324,"bottom":0.765988372022711,"conf":1},{"text":"Ad Soyad:","x0":0.40225055957728245,"x1":0.4724927667458062,"top":0.7566747762582479,"bottom":0.7709415027602343,"conf":1},{"text":"Unvan: _","x0":0.40241349251904135,"x1":0.45795611664550795,"top":0.7818136858009782,"bottom":0.7908607326905849,"conf":1},{"text":"Tarih:","x0":0.6242299784000738,"x1":0.6694045182820832,"top":0.7572674417066516,"bottom":0.7688953489298233,"conf":1},{"text":"471","x0":0.4825462015011078,"x1":0.5133470220512537,"top":0.9156976742372513,"bottom":0.9273255814604231,"conf":1}]}