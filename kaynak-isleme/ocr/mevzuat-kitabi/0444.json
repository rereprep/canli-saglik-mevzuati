715306732955,"bottom":0.2901589676007914,"conf":1},{"text":"2017/1","x0":0.4763362579357797,"x1":0.5318772952957901,"top":0.290578318139488,"bottom":0.30244493738001244,"conf":1},{"text":"Bilindiği üzere, kontrole tâbi madde ve müstahzarlara ilişkin reçetelere dair hususlar","x0":0.244353179139362,"x1":0.8069815227145962,"top":0.32991452982504543,"bottom":0.3415697675608915,"conf":1},{"text":"14.03.2016 tarihli ve 31951 sayılı (2016/3) Bakanlığımız Genelgesi ile düzenlenmiş olup, bu","x0":0.1949749723553406,"x1":0.8050251968348222,"top":0.34137601987417554,"bottom":0.35772766264583944,"conf":1},{"text":"Genelge çerçevesinde uyuşturucu madde ve müstahzarları için kırmızı reçete; psikotrop","x0":0.1971252520845669,"x1":0.8049281355418108,"top":0.3559829059500339,"bottom":0.3677325582583105,"conf":1},{"text":"madde ve müstahzarları için yeşil reçete kullanılmaktadır.","x0":0.1950718680649698,"x1":0.574948665613054,"top":0.3691860464517138,"bottom":0.37948717955047906,"conf":1},{"text":"Söz konusu maddelerin tıbbi erişimlerine imkân sağlanırken bu maddelerin suistimal","x0":0.24225371741093243,"x1":0.8049769717611819,"top":0.3807849307855399,"bottom":0.3934360074691712,"conf":1},{"text":"edilmelerinin önlenmesi hususunun daha etkin hale getirilmesi amacıyla Kurumumuzca","x0":0.1949592930523227,"x1":0.805051400785942,"top":0.3913484679935969,"bottom":0.4088204042113369,"conf":1},{"text":"Renkli Reçete Sistemi yazılım çalışmaları tamamlanmış olup, Renkli Reçete web servislerinin","x0":0.1971252521638384,"x1":0.8049281356210822,"top":0.4068376066451257,"bottom":0.4188034186109377,"conf":1},{"text":"kullanım Kılavuzu hazırlanarak https://renklirecete.saglik.gov.tr adresinde yayımlanmıştır.","x0":0.19496116782165215,"x1":0.8029746114974948,"top":0.4176321526681315,"bottom":0.4336748359353173,"conf":1},{"text":"17.03.2017 tarihinden itibaren söz konusu sistem kullanıma açılmış olup, Renkli Reçete","x0":0.19501125799736205,"x1":0.8049783801963871,"top":0.4314707425733634,"bottom":0.44530571136848773,"conf":1},{"text":"Sistemi üzerinden uyuşturucu madde ve müstahzarlanı ile psikotrop madde ve müstahzarları","x0":0.19501829770059317,"x1":0.8049718032293304,"top":0.4447365351174287,"bottom":0.4584106027532502,"conf":1},{"text":"için elektronik reçete düzenlenmesi gerekmektedir. Bu kapsamda;","x0":0.1928795328212558,"x1":0.6305538188206323,"top":0.4559812433350955,"bottom":0.47098640067538167,"conf":1},{"text":"• Renkli Reçete Sisteminde, hekimler oluşturdukları reçeteleri 5070 sayıh","x0":0.26274426252717753,"x1":0.804998856917198,"top":0.48341670245998913,"bottom":0.49849536445198883,"conf":1},{"text":"elektronik Imza Kanunu ile yapılan düzenleme kapsamında ıslak imzaya","x0":0.28943442217550214,"x1":0.8029763299322661,"top":0.49614158316182244,"bottom":0.5103102735742949,"conf":1},{"text":"eşdeğer hukuki geçerliliği olan e-imza prosedürü ile imzalayacaklardır.","x0":0.2874743278410038,"x1":0.751540045655771,"top":0.5101744184785011,"bottom":0.5218023257016727,"conf":1},{"text":"• Eczacılar elektronik reçete numarası ile düzenlenen elektronik reçeteye sistem","x0":0.2607332938431753,"x1":0.8029444920156927,"top":0.5223533014618645,"bottom":0.5366225613140865,"conf":1},{"text":"üzerinden ulaşabilecektir. Reçete sisteme kaydedildikten sonra ilaçların","x0":0.2895277165403333,"x1":0.8028747472353341,"top":0.5363247861410709,"bottom":0.5479651163986498,"conf":1},{"text":"• Renkli Reçete Sisteminde uyuşturucu ve psikotrop madde ve müstahzarlarn","x0":0.260780295221049,"x1":0.8049281234027297,"top":0.5623931622667541,"bottom":0.5741279070967633,"conf":1},{"text":"bir reçeteye yazılacak maksimum miktarları otomatik olarak belirlenmiştir.","x0":0.28747433731197064,"x1":0.776180693116082,"top":0.5755813952211511,"bottom":0.5872093024443228,"conf":1},{"text":"• Bu sistem sadece hastane dışına çıkan yani serbest eczanelerce karşılanacak","x0":0.2607102921451962,"x1":0.8029518602896566,"top":0.5880721684525653,"bottom":0.6028478309970113,"conf":1},{"text":"uyuşturucu ve psikotrop madde ve müstahzarları için kullanılacaktır.","x0":0.28542095186427247,"x1":0.7330595407845982,"top":0.602991452884112,"bottom":0.6133720930770405,"conf":1},{"text":"• Il Sağlık Müdürlükleri sistemin sağladığı istatistiksel veriler ile denetim","x0":0.2586587639650784,"x1":0.8029474453459164,"top":0.6147023553665267,"bottom":0.630216939443237,"conf":1},{"text":"yapacaklardır.","x0":0.2853547168600672,"x1":0.3819964142189793,"top":0.6276265998511098,"bottom":0.639815260236372,"conf":1},{"text":"• Ilaç kullanım raporlanı hekimler veya eczacılar tarafindan sisteme girilecektir.","x0":0.2628336769333888,"x1":0.7905544131221736,"top":0.6423076922189705,"bottom":0.6542735041847825,"conf":1},{"text":"• Hastanın talebi olması durumunda reçete örneği hekim tarafindan hastaya","x0":0.260780294408291,"x1":0.8028747360908597,"top":0.6555232556203565,"bottom":0.6688034186761677,"conf":1},{"text":"verilecektir.","x0":0.2853886782201463,"x1":0.36758873434001665,"top":0.6684732657376894,"bottom":0.6789104551496026,"conf":1},{"text":"• Sistem ile ilgili sorunlar renkli.recete@titck.gov.tr adresine iletilmesi","x0":0.26070066096238387,"x1":0.8008996916621081,"top":0.6811590172770471,"bottom":0.6954621757681329,"conf":1},{"text":"gerekmektedir.","x0":0.2851943531940944,"x1":0.38420667041335926,"top":0.6948361478921855,"bottom":0.7062228798469068,"conf":1},{"text":"• Sistemde belirlenen maksimum dozdan fazla ihtiyacı olan hastalara reçete","x0":0.26069831475292177,"x1":0.8029598835350409,"top":0.7067257692829111,"bottom":0.7216569068243315,"conf":1},{"text":"edilecek uyuşturucu ve psikotrop ilaçlar için Kurumumuzdan \"endikasyon dışı","x0":0.2854209411752624,"x1":0.8008213583693752,"top":0.7209302323651909,"bottom":0.7341880342036011,"conf":1},{"text":"ilaç kullanım onayı\" ahınarak,","x0":0.28520009562647247,"x1":0.5341540106147584,"top":0.7303927970497456,"bottom":0.7472241543046868,"conf":1},{"text":"onay","x0":0.5420944555228349,"x1":0.5831622177939272