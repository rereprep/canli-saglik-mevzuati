293604645275549,"bottom":0.14534883726508074,"conf":1},{"text":"HİZMET BAŞLADIĞI TARİHTEN BU GÜNE KADAR TOPLAM:","x0":0.5032776779767039,"x1":0.5200795397593083,"top":0.5711372133873726,"bottom":0.7660668481989044,"conf":1},{"text":"...........................IL SAGLIGI MÜDÜRÜ","x0":0.5420944445806921,"x1":0.5564681835165016,"top":0.1264534861361415,"bottom":0.30377906904796714,"conf":1},{"text":"* Ekipte başka unvanda personel varsa ünvanı ve sayısı yazılacaktır.","x0":0.6117367934997012,"x1":0.6333085767292477,"top":0.483959880685221,"bottom":0.7645920431868903,"conf":1},{"text":"** Yapılan hizmetler neler ise ayn ауг ve sayılan ile yazılması gerekmektedir.","x0":0.6398358516211786,"x1":0.6614064124870306,"top":0.44471657672368403,"bottom":0.7660340962132006,"conf":1},{"text":"***Bu bölümün toplamı toplam ziyaret edilen hasta sayısını vermez. (Bir hasta hem kronik hastalığı olup engelli olabilmektedir. Ayrıca bu hizmet sadece engelli","x0":0.6795291650499682,"x1":0.7033259869301934,"top":0.1104054622629227,"bottom":0.7645841272936384,"conf":1},{"text":"ve kronik hastalığı olanlara sunulmamaktadır.)","x0":0.7002053256863997,"x1":0.7186858433862998,"top":0.5697674438055179,"bottom":0.7645348789934854,"conf":1},{"text":"Hiçbir zaman sunulan hizmetlerin toplamı hasta sayısını vermez. (bir hastaya hem tansiyon takibi, hem pansuman, hem de enjeksiyon yapılmış olabilir.) Sunulan","x0":0.7409695558833636,"x1":0.7653912593096278,"top":0.10605240196015764,"bottom":0.7617008144200935,"conf":1},{"text":"hizmetler ayn değerlendirilmektedir.","x0":0.7618069718857258,"x1":0.7802874838197594,"top":0.6090116290708115,"bottom":0.7645348803353348,"conf":1}]}