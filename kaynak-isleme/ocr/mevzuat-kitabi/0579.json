{"lines":[{"text":"TIPTA UZMANLIK KURULU","x0":0.4209445578227222,"x1":0.6098562633472083,"top":0.08846153838810245,"bottom":0.10042735035391437,"conf":1},{"text":"KARAR TUTANAĞI","x0":0.44763860424761953,"x1":0.5893223833909841,"top":0.09871794874826045,"bottom":0.11196581199612365,"conf":1},{"text":"Sayfa 2 / 3","x0":0.4803033636780816,"x1":0.5527493680451581,"top":0.11179178430709202,"bottom":0.12634341326759546,"conf":1},{"text":"ZÇ","x0":0.16221765912772565,"x1":0.18891170437330101,"top":0.681686046566104,"bottom":0.6947674414789541,"conf":0.5},{"text":"OK","x0":0.16837782397527873,"x1":0.19096509160993688,"top":0.7136627905899345,"bottom":0.7238372093083214,"conf":1},{"text":"TC Sağlik Bakanağ","x0":0.21149897506032178,"x1":0.2997946590998425,"top":0.12499999999203615,"bottom":0.13376068375271988,"conf":1},{"text":"Toplantı Tarihi","x0":0.19301848263492458,"x1":0.305954823114562,"top":0.15406976730767696,"bottom":0.1658119658768199,"conf":1},{"text":"Toplantı No","x0":0.1950718695937448,"x1":0.28131416713415347,"top":0.16569767434798754,"bottom":0.17606837595036906,"conf":1},{"text":"Karar No","x0":0.1949903131141581,"x1":0.26496861888006884,"top":0.17558560307060223,"bottom":0.18633300154487975,"conf":1},{"text":": 02 - 03 / 01 / 2014","x0":0.32834893016798516,"x1":0.4724944852144634,"top":0.15293486164316816,"bottom":0.16583355089688556,"conf":1},{"text":": 53","x0":0.32648870665804525,"x1":0.35728952720819124,"top":0.16709401722828354,"bottom":0.17735042748469376,"conf":1},{"text":":406","x0":0.3260496944896225,"x1":0.36803717704257183,"top":0.17630241633729726,"bottom":0.18893634155514594,"conf":1},{"text":"* KARAR EKI","x0":0.44147843981490764,"x1":0.5379876790762627,"top":0.18749999986386634,"bottom":0.19914529900916556,"conf":1},{"text":"SÖZLEŞMELİ AİLE HEKİMLERİNE VERİLECEK AİLE HEKİMLİGİ UZMANLIK","x0":0.2279260786288929,"x1":0.7535934283185657,"top":0.20930232545542626,"bottom":0.22094017086159168,"conf":1},{"text":"EGİTİMİNE AÎT TIPTA UZMANLIK KURULUNCA BELİRLENEN ESASLAR","x0":0.24435318863491332,"x1":0.7371663174372485,"top":0.22093023248915933,"bottom":0.23119658133611654,"conf":1},{"text":"1. Bu eğitiminin müfredatı (amaç, öğrenim hedefleri, rotasyon dal ve süreleri, ölçme-değerlendirme","x0":0.1889116958703318,"x1":0.7864476468320156,"top":0.2440170940150026,"bottom":0.25598290598081463,"conf":1},{"text":"yöntemleri, tez süreci) 1219 sayılı Kanuna ekli çizelgede 3 yıllık eğitim süresi olduğu belirtılen aile","x0":0.21149897456832292,"x1":0.7864476371382293,"top":0.2572649572912771,"bottom":0.2688953489583088,"conf":1},{"text":"hekimliği uzmanlık eğitimininki ile aynı olmalıdır.","x0":0.21149897308653784,"x1":0.496919917872379,"top":0.27034883714860947,"bottom":0.28052325586699633,"conf":1},{"text":"2. Bu eğitime girmek için adaydan Tipta Uzmanlık Eğitimine Giriş Sınavi'nda (TUS) minimum puan","x0":0.18891169582796086,"x1":0.7864476467896446,"top":0.28197674405991124,"bottom":0.2936046512830828,"conf":1},{"text":"şartı olarak: Sözleşmeli aile hekimleri için ÖSYM tarafından TUS klinik tıp bilimleri testinden, 1","x0":0.21149897464404352,"x1":0.7864476372139498,"top":0.29487179470701264,"bottom":0.30683760667282467,"conf":1},{"text":"ağırlık katsayısı kullanılarak KTBT standart puanından hesaplanacak bir puandan alınacak 40'tır.","x0":0.2114989745675933,"x1":0.7864476371374995,"top":0.3094017092007375,"bottom":0.31976744191539863,"conf":1},{"text":"Yabancı dil yeterlılığı şartı aranmaz.","x0":0.2133159250624106,"x1":0.4170329919091174,"top":0.32111760584761995,"bottom":0.3345868152741087,"conf":1},{"text":"3. TUS, bu eğitime girmek isteyen adayları sıralamak için puan alacaklan bir sınav olarak","x0":0.18685830856179014,"x1":0.786447646022586,"top":0.3341880340432164,"bottom":0.3474358972910797,"conf":1},{"text":"kullanılmalıdır, Kanun gereği merkezi yerleştirmeye tabi olmayacak adaylann yerleştirilmesinde","x0":0.21149897455837974,"x1":0.786447637128286,"top":0.3473837208047478,"bottom":0.3590116280279194,"conf":1},{"text":"Ölçme, Seçme ve Yerleştirme Merkezi görev almaz; yerleştirme işlemi Türkiye Halk Sağlığı Kurumu","x0":0.21149897456009506,"x1":0.7864476371300013,"top":0.3602564101685928,"bottom":0.3735465118149509,"conf":1},{"text":"(THSK) tarafindan yapılır.","x0":0.21149897131842726,"x1":0.36139630568362624,"top":0.3735042735720224,"bottom":0.38376068382843265,"conf":1},{"text":"4. Bu eğitim için \"yıllık global ülke kontenjanı\" TUK tarafindan belirlenip ilan edildikten sonra THSK.","x0":0.1868583189709577,"x1":0.784394233031096,"top":0.3850427349834753,"bottom":0.3982905982313386,"conf":1},{"text":"eğitim kurumlarından bu eğitime ait kontenjan taleplerini ahır, bu taleplere göre global ülke","x0":0.2114989745672029,"x1":0.7864476371371092,"top":0.3995726496368579,"bottom":0.41153846160266994,"conf":1},{"text":"kontenjanımı eğitim kurumlarına dağıtır.","x0":0.21149896924541575,"x1":0.43942505515457536,"top":0.41279069761208054,"bottom":0.4230769232325786,"conf":1},{"text":"5. THSK, global kontenjanları hangi eğitim kurumlarına hangi sayılarda dağıttığını resmi bir yolla","x0":0.1889116958736837,"x1":0.7864476468353675,"top":0.4258720928980303,"bottom":0.43760683772803965,"conf":1},{"text":"TUS'a başvuruların başladığı tarihten önce ilan edilir.","x0":0.211498970226275,"x1":0.5133470254557849,"top":0.4388888886957214,"bottom":0.4491452989521316,"conf":1},{"text":"6. Sahadaki sözleşmeli aile hekimleri, THSK'nın ilanındaki kontenjanlara başvurabilmek için TUS'a","x0":0.18891169587296325,"x1":0.7864476468346471,"top":0.45203488366228983,"bottom":0.46239316223026417,"conf":1},{"text":"girip aldıkları puan ile THSK ya başvururlar.","x0":0.211498970379809,"x1":0.4661190992281974,"top":0.4649572648199902,"bottom":0.4752906977267034,"conf":1},{"text":"7. THSK, başvuran adayları puan kriterine göre yerleştirir.","x0":0.18881582963920304,"x1":0.5257335084906616,"top":0.47670673819793286,"bottom":0.49021923343445184,"conf":1},{"text":"8. Bu kapsamda eğitime başlatılan adayların eğitim süreçleri, eğitim aldıkları aile hekimliği anabilim","x0":0.18891169587223272,"x1":0.7864476468339165,"top":0.4897435897320719,"bottom":0.5014534884932668,"conf":1},{"text":"dallanı veya eğitim klinıkleri tarafından yürütülür.","x0":0.2114989714944996,"x1":0.49281314328211673,"top":0.5042735042222605,"bottom":0.5145348837739442,"conf":1},{"text":"9. Bu eğitimde rotasyona ayrılan süre yılda 6 ayı geçmeyecek şekilde eğitim sorumlusu tarafindan","x0":0.1868583085775097,"x1":0.7864476460383055,"top":0.5158119658573229,"bottom":0.5277777778231348,"conf":1},{"text":"düzenlenir.","x0":0.21129947309831265,"x1":0.27746382885489473,"top":0.5297408321053658,"bottom":0.5390592963356343,"conf":1},{"text":"10. Bu eğitimin ve mevcut 3 yıllık eğitimin kalitesini desteklemek için eğitim kurumlarına \"Eğitim-","x0":0.18891169670277969,"x1":0.7885010341635756,"top":0.5421511626643915,"bottom":0.5538461539473191,"conf":1},{"text":"ASM'ler bağlanmalı ve bununla ilgili gerekli mevzuat düzenlemesi yapılmalıdır.","x0":0.21149898218290022,"x1":0.66324434410145,"top":0.5551282052581151,"bottom":0.5668604652367111,"conf":1},{"text":"11. Bu eğitime başlayan hekimler eğitim süreci boyunca eğitim kurumunu değiştiremezler. Bu süreçte","x0":0.1889116959522519,"x1":0.7864476469139356,"top":0.5683139533603134,"bottom":0.5799418605834851,"conf":1},{"text":"dört olumsuz kanaat notu alırlarsa eğitimleri sonlandırılır.","x0":0.21149897134348697,"x1":0.5400410695122256,"top":0.5811965810416085,"bottom":0.5915697674954034,"conf":1},{"text":"12. Bu eğitimi alanlardan askerlik ya da doğum sonrası ücretsiz izin nedeniyle sözleşmeleri","x0":0.18891169587475073,"x1":0.7864476468364345,"top":0.5944444442528661,"bottom":0.6061046512839857,"conf":1},{"text":"feshedilenlerin bu mazeretleri sonrasında ilgıli mevzuatlarına göre tekrar sözleşme yapmaları halinde","x0":0.2114989745672029,"x1":0.7864476371371092,"top":0.6075581394095787,"bottom":0.6192307690675523,"conf":1},{"text":"eğitimlerine kaldıklan yerden devam etmeleri sağlanır.'","x0":0.21141347521451428,"x1":0.5257873725963349,"top":0.6191355812847432,"bottom":0.6329334505187468,"conf":1},{"text":"13. Bu eğıtimi alanların zorunlu rotasyonlarının hızmet sunumuna yönelik insan gücü planlamasını","x0":0.1889116958676249,"x1":0.7864476468293087,"top":0.6337209301738268,"bottom":0.6440170939773187,"conf":1},{"text":"kolaylaştırmak amacıyla eğıtimin birinci yılının tamamlanmasından sonra yapılacak şekılde","x0":0.2114989745668349,"x1":0.7864476371367412,"top":0.6468023255227042,"bottom":0.6569767442410911,"conf":1},{"text":"planlanması önerilir.'","x0":0.21104455758811053,"x1":0.3372803811213774,"top":0.6581076773033724,"bottom":0.6717246736446538,"conf":1},{"text":"RÖ","x0":0.24640657076236924,"x1":0.2731006160079446,"top":0.6816860467129108,"bottom":0.6933139531209762,"conf":1},{"text":"MA","x0":0.3285420939522117,"x1":0.3572895280032456,"top":0.6831395347877206,"bottom":0.6933139535061076,"conf":1},{"text":"SA","x0":0.4106776182891819,"x1":0.4353182747292987,"top":0.683139534775981,"bottom":0.6933139534943679,"conf":1},{"text":"SC","x0":0.4948665304331843,"x1":0.5174537980678425,"top":0.6816860466796882,"bottom":0.6933139530877536,"conf":1},{"text":"EG","x0":0.5770020537101264,"x1":0.6016427101502432,"top":0.6816860465988075,"bottom":0.6947674415116576,"conf":1},{"text":"MG","x0":0.659137577803221,"x1":0.6878850095479084,"top":0.6816860465988075,"bottom":0.6947674415116576,"conf":1},{"text":"MISK","x0":0.7411176963537719,"x1":0.7824962665044956,"top":0.6814392720513308,"bottom":0.6950142162458963,"conf":1},{"text":"AK","x0":0.246406570703701,"x1":0.27310061594927637,"top":0.7136627905216065,"bottom":0.7252906977447783,"conf":1},{"text":"AO","x0":0.3305954827769756,"x1":0.35523613921709235,"top":0.7136627905842821,"bottom":0.7238372093026689,"conf":1},{"text":"IŞ","x0":0.4127310060799901,"x1":0.42915811075779237,"top":0.7136627908339092,"bottom":0.7267441857467594,"conf":1},{"text":"AT","x0":0.494866529993494,"x1":0.5195071864336108,"top":0.7136627905163212,"bottom":0.7252906977394928,"conf":1},{"text":"MMT","x0":0.5770020530479618,"x1":0.6180698153190542,"top":0.713662790543861,"bottom":0.7252906977670326,"conf":0.30000001192092896},{"text":"MRT","x0":0.6591375773824382,"x1":0.6960985620426132,"top":0.713662790542161,"bottom":0.7252906977653326,"conf":1},{"text":"MEY","x0":0.7412731009964012,"x1":0.7782340856565764,"top":0.713662790542161,"bottom":0.7252906977653326,"conf":1},{"text":"12 nei ve 13 üncü maddeler Tipta Uzmanhk Kurulu'nun 29-30.09.2014 tarih ve 512 sayılı karanı ile eklenmiştir.","x0":0.19705940281077955,"x1":0.7146491148960652,"top":0.7693229156980281,"bottom":0.7824430493506744,"conf":1},{"text":"573","x0":0.48459958883453674,"x1":0.5133470228855707,"top":0.9331395347157845,"bottom":0.9447674419389561,"conf":1}]}