29070043558874,"x1":0.46013072248476056,"top":0.28621651423518557,"bottom":0.3022903622748616,"conf":1},{"text":"DAĞITIM YERLERİNE","x0":0.42505133606495565,"x1":0.595482544646661,"top":0.33284883687394573,"bottom":0.3488372096114716,"conf":1},{"text":"Aile hekimlerince, kişiye yönelik koruyucu sağhk hizmetleri ile birinci basamak teşhis,","x0":0.24229979910268123,"x1":0.8254620076690355,"top":0.36918604631969854,"bottom":0.38247863240991675,"conf":1},{"text":"tedavi ve rehabilite edici sağlık hizmetleri sunulmakta olup, bireylerin sağlık ile ilgili tüm","x0":0.19301848648822903,"x1":0.827515394433929,"top":0.3807692303841055,"bottom":0.39534883705164847,"conf":1},{"text":"sorunlarında ilk başvuru noktasının aile hekımi olması sağlık hızmetlerınin etkın yönetımi için","x0":0.19301848637877458,"x1":0.8275153943244745,"top":0.3952991452873479,"bottom":0.4085470085352112,"conf":1},{"text":"önemlıdır. Bu kapsamda aile hekımlerinın sorumluluğu altındaki kişılerle sürekli iletişım","x0":0.19301848637622612,"x1":0.827515394321926,"top":0.40843023236621867,"bottom":0.4215116280941751,"conf":1},{"text":"halinde olması gerekmekte olup, kişinin il içinde veya il dışında adres değiştirmesi vb. nedenler","x0":0.1930184671906759,"x1":0.825462025538809,"top":0.4200581396798022,"bottom":0.43461538472239125,"conf":1},{"text":"ile kişiye ulaşılamaması durumunda sağlık hizmetlerinin aksaması söz konusu olabilmektedir.","x0":0.19507187280403993,"x1":0.8254620077515158,"top":0.4331395347572773,"bottom":0.44487179473587324,"conf":1},{"text":"Aile Hekimliği Uygulama Yönetmeliği'nin \"Aile hekimliği birimine kişi kaydı ve aile hekimi","x0":0.19507187296369605,"x1":0.8254620079111719,"top":0.44476744200770835,"bottom":0.45940170970060024,"conf":1},{"text":"seçimine ilişkin esaslar\" başlıklı 8 inci maddesinde kişi kayıtlarına ilişkin düzenlemeler","x0":0.19301850160153763,"x1":0.82546198614658,"top":0.45769230749535983,"bottom":0.4723837206574608,"conf":1},{"text":"yapılmış olup, adres değiştiren ancak 30 gün içinde hekim değişikliği talebinde bulunmayan","x0":0.1930184864265736,"x1":0.8275153943722734,"top":0.4709302327027992,"bottom":0.4854700858232608,"conf":1},{"text":"kişıler ile herhangi bir şekilde aile hekımlerince kayıt edılmemiş kişilerin ilgıli birimler","x0":0.19301846712812923,"x1":0.8254620254762626,"top":0.4854651160873371,"bottom":0.4987179486304738,"conf":1},{"text":"tarafindan kişiye bilgi verilerek adresine en yakın ve nüfusu en düşük aile hekimine kayıt","x0":0.19301848638040242,"x1":0.8275153943261022,"top":0.49854651143613016,"bottom":0.5116279071640866,"conf":1},{"text":"edılmesi gerekmektedir.","x0":0.19487763911448402,"x1":0.357462564331288,"top":0.5098987316512249,"bottom":0.5240393074188072,"conf":1},{"text":"Mezkür mevzuat hükümlerinin uygulanmasının kolaylaştırılması ve takibi amacıyla; İl","x0":0.2422406941913192,"x1":0.8275847435366562,"top":0.5261315518497127,"bottom":0.5427554352193542,"conf":1},{"text":"Sağlık Müdürlüğii, Ilçe Sağhk Müdürlüğü ve Toplum Sağlığı Merkezi yetkisinde kullamılmak","x0":0.19301848633711388,"x1":0.8275153942828137,"top":0.5421511629385002,"bottom":0.5568376072128809,"conf":1},{"text":"üzere, Karar Destek Sistemi içerisinde \"Birinci Basamak Izleme ve Değerlendirme Raporlan\"","x0":0.19293325412609677,"x1":0.8276426411707613,"top":0.5551912672228583,"bottom":0.5735909378155983,"conf":1},{"text":"başlığının altında \"Aile Hekimi Farkh Ilçede Olan Kişi Listesi\" raporu oluşturılmuştur. Ilgili","x0":0.1930184864466974,"x1":0.8275153943923972,"top":0.5712209303799056,"bottom":0.5858974360637393,"conf":1},{"text":"rapordaki bilgileri kullanarak adres değişikliği olan kişilerin ve var ise diğer aile bireylerinin,","x0":0.1930184671229901,"x1":0.8254620254711234,"top":0.5871794875178444,"bottom":0.601744185892014,"conf":1},{"text":"ıkamet adreslerine en yakın ve nüfusu en düşük olan Aile Hekimliği Birimlerinden başlayarak","x0":0.19502253232467,"x1":0.8275812234947502,"top":0.6008600859805621,"bottom":0.6153345341601495,"conf":1},{"text":"kayıtlarını yapılması, aynı zamanda aile hekimlıği birim planlamalarının etkin şekılde","x0":0.1930184863758927,"x1":0.8275153943215926,"top":0.6175213675190079,"bottom":0.6324786324762729,"conf":1},{"text":"yapılmasına devam edilmesi hususunda;","x0":0.19301848393804075,"x1":0.4640657047793252,"top":0.6322674416650655,"bottom":0.645348837393022,"conf":1},{"text":"Gereğini rica ederim.","x0":0.24229979480287092,"x1":0.38603696044534747,"top":0.6482558139467945,"bottom":0.6658119661275232,"conf":1},{"text":"Dr. Hüseyin İLTER","x0":0.6405997419318888,"x1":0.7782914288550439,"top":0.665487413959843,"bottom":0.6848032835438859,"conf":1},{"text":"Bakan a.","x0":0.6750663767374439,"x1":0.7417714047132435,"top":0.680391675801104,"bottom":0.6975153008146674,"conf":1},{"text":"Genel Müdür","x0":0.6609289045459661,"x1":0.7579622656833839,"top":0.6924852900491413,"bottom":0.7101309881726494,"conf":1},{"text":"DAĞITIM:","x0":0.19493265680199537,"x1":0.2773466035049456,"top":0.7293188104481368,"bottom":0.7474253753530263,"conf":1},{"text":"81 İl Valiliği (İ1 Sağlık Müdürlüğü)","x0":0.19301848121420803,"x1":0.43326488611803965,"top":0.7500000000089319,"bottom":0.7675213675302994,"conf":1},{"text":"Sağlık Mahallesi Aduan Saygun 2 Cad No: 55 06100 Sıhluye/Ankara","x0":0.16016427785961657,"x1":0.5092402410194752,"top":0.8066860466911466,"bottom":0.8197674416039968,"conf":1},{"text":"Bilgi için:İlhami AKKUŞ","x0":0.7310061580104148,"x1":0.8685831641555554,"top":0.8066860463107912,"bottom":0.8197674420387476,"conf":1},{"text":"Faks No:0 (312) 565 59 81","x0":0.1642710450778248,"x1":0.3018480512229654,"top":0.8183139534912434,"bottom":0.8270348837048456,"conf":1},{"text":"Unvan: UZMAN YARDIMCISI","x0":0.7063655012829066,"x1":0.868583163868164,"top":0.8166666663164186,"bottom":0.831395348581741,"conf":1},{"text":"e-Posta: ilhami akkus@saglik: gov. tr İnt. Adresi: Aile Hekimliği Daire Başkanhığı","x0":0.16221766985976135,"x1":0.5626283323989656,"to