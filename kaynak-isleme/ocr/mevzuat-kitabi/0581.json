9000","x0":0.7063655030240296,"x1":0.7330595482696048,"top":0.18604651163105634,"bottom":0.1933139533398739,"conf":1},{"text":"TaNet","x0":0.7720739226110197,"x1":0.8275153996012825,"top":0.1700581397244394,"bottom":0.1831395346372896,"conf":0.5},{"text":"CERTIFICATE","x0":0.7720739210824363,"x1":0.8295687891845042,"top":0.1889534884349393,"bottom":0.19622093014375674,"conf":0.30000001192092896},{"text":"DAĞITIM YERLERİNE","x0":0.4086242288715037,"x1":0.574948664454985,"top":0.23837209313223773,"bottom":0.2514534880450878,"conf":1},{"text":"Bilindiği üzere, Sözleşmeli Aile Hekimliği Uzmanlık Eğitimi (SAHU) 1219 sayılı","x0":0.2319695076837975,"x1":0.7988251816063905,"top":0.27196469724992633,"bottom":0.2881488976346043,"conf":1},{"text":"Tababet ve Şuabatı San'atlarının Tarzı Icrasına Dair Kanunun Geçici 9 uncu maddesi","x0":0.18685831335015535,"x1":0.7987679698056231,"top":0.286324786142679,"bottom":0.2979651164002577,"conf":1},{"text":"\"1/1/2020 tarihine kadar, 24/11/2004 tarihli ve 5258 sayılı Kanun hükümlerine göre","x0":0.18883325641717574,"x1":0.7988259144856839,"top":0.2978409887843323,"bottom":0.3126094466046052,"conf":1},{"text":"sözleşmeli aile hekimi olarak çalışmakta olanlar, tipta uzmanlık sınavı sonuçlarına göre,","x0":0.18476684347684738,"x1":0.7967631078595937,"top":0.31188721749516235,"bottom":0.3256681292586715,"conf":1},{"text":"merkezi yerleştirmeye tabi olmaksızın, Tıpta Uzmanlık Kurulunca belirlenen esaslar","x0":0.1847280520788068,"x1":0.7988477051924707,"top":0.324792241891809,"bottom":0.3412805152189763,"conf":1},{"text":"çerçevesinde aile hekimliği uzmanlık eğitimi yapabilir. Bu eğitim uzaktan ve/veya kısmi","x0":0.18275153956815668,"x1":0.8008213555209605,"top":0.338461538667147,"bottom":0.35319767426405,"conf":1},{"text":"zamanlı eğitim metotları da uygulanmak suretiyle yapılabilir ve en az altı yılda","x0":0.1868583133593267,"x1":0.7987679698147945,"top":0.3529914528187429,"bottom":0.3649572647845548,"conf":1},{"text":"tamamlanır...\" hükmü kapsamında gerçekleştirilmekte olup bu maddeye istinaden Tıpta","x0":0.18685832574672237,"x1":0.7967145588015326,"top":0.3632478634642524,"bottom":0.37790697641085225,"conf":1},{"text":"Uzmanlık Kurulunun (TUK) 02-03/01/2014 tarihli ve 406 sayılı karan ile söz konusu eğitimin","x0":0.18685831333350345,"x1":0.7987679697889712,"top":0.37777777779438937,"bottom":0.3897435897602014,"conf":1},{"text":"genel esasları belirlenmiştir.","x0":0.18667785872962683,"x1":0.3697396914020781,"top":0.3910263513357607,"bottom":0.40414405434155953,"conf":1},{"text":"SAHU eğitimine başvuru ve yerleştirme işlemleri 2014-2019 yılları arasında yılda iki","x0":0.23203285228859283,"x1":0.7987679688620511,"top":0.4055232556886256,"bottom":0.4171511629117972,"conf":1},{"text":"dönem olmak üzere (Ilkbahar dönemi/Sonbahar dönemi) toplam on bir defa gerçekleştirilmiş","x0":0.18685831335197803,"x1":0.7987679698074458,"top":0.4186046510375995,"bottom":0.4303418803114689,"conf":1},{"text":"olup 2020 yılı içerisinde SAHU kapsamında uzmanlık eğitimini tamamlayan aile hekimleri","x0":0.18685831257668165,"x1":0.7967145825330374,"top":0.43023255794696114,"bottom":0.44331395367491755,"conf":1},{"text":"mezun olmaya başlamıştır.","x0":0.18663382389438465,"x1":0.36173621461267175,"top":0.4427283142006251,"bottom":0.45686534588621786,"conf":1},{"text":"SAHU kapsamında uzmanlık eğitimini tamamlayan ve diplomaları tescil edilen aile","x0":0.23203285228745898,"x1":0.7987679688609173,"top":0.45769230768040714,"bottom":0.47094017092827045,"conf":1},{"text":"hekimleri, aile hekimliği uzmanı olarak değerlendirilmektedir.","x0":0.18685832524761625,"x1":0.5913757607850445,"top":0.4709302324318818,"bottom":0.48255813965505356,"conf":1},{"text":"Bu kapsamda;","x0":0.2340092421965974,"x1":0.32861909433358066,"top":0.4836915049762922,"bottom":0.495959657783805,"conf":1},{"text":"Aile hekimliği ek yerleştirme işlemlerine esas aile hekimliği uzmanı kontenjanı","x0":0.25462013139690853,"x1":0.7967145730794774,"top":0.4985465116342058,"bottom":0.5132478633868539,"conf":1},{"text":"belirlenir iken bulundukları aıle sağlığı merkezinde uzman kontenjanı hesaplamasına dahil","x0":0.1848049260582998,"x1":0.7987679690128796,"top":0.5130813951570827,"bottom":0.5261627908850391,"conf":1},{"text":"edilmesi,","x0":0.1860484255246838,"x1":0.2513791661431301,"top":0.5251730610561738,"bottom":0.5396004890164311,"conf":1},{"text":"Yerleştirme işlemlerinde Aile Hekimliği Uygulama Yönetmeliği'nin Madde","x0":0.2546201309798435,"x1":0.7987679591615243,"top":0.5421511629395502,"bottom":0.5568376072139308,"conf":1},{"text":"15/1/(b) bendinde tercih haklarının bulunduğu,","x0":0.18467656613421868,"x1":0.4929409882914417,"top":0.553687606606493,"bottom":0.5684511925366896,"conf":1},{"text":"Aile Hekimliği Ödeme ve Sözleşme Yönetmeliği'nin ilgili hükümlerine göre","x0":0.252566743591526,"x1":0.7987679582723187,"top":0.5696581199520977,"bottom":0.5843023254204304,"conf":1},{"text":"yapılan ödemelerde aile hekimliği uzmanı olarak hesaplanması,","x0":0.18475257022004204,"x1":0.6017250522947473,"top":0.5829891660474236,"bottom":0.5974205733564096,"conf":1},{"text":"Reçete ve rapor düzenleme yetkilerine ilişkin yapılacak işlemlerde de aile","x0":0.25256674368590426,"x1":0.798767958366697,"top":0.6002906978232818,"bottom":0.6149572649165685,"conf":1},{"text":"hekimliği uzmanı olarak değerlendirilmesi hususunda;","x0":0.186858324606344,"x1":0.5420944472635386,"top":0.6132478633673972,"bottom":0.625000000119534,"conf":1},{"text":"Bilgilerini ve gereğini arz/rica ederim.","x0":0.23613963429420418,"x1":0.48459958519448376,"top":0.626453488176641,"bottom":0.6397435898229992,"conf":1},{"text":"e-imzalıdır.","x0":0.6507878896631463,"x1":0.733195683033385,"top":0.650769590902702,"bottom":0.6660908741616455,"conf":1},{"text":"Doç. Dr. Fatih KARA","x0":0.6177024697008894,"x1":0.7683478721963786,"top":0.6613651124689514,"bottom":0.6807158914236121,"conf":1},{"text":"Bakan a.","x0":0.6604171015938377,"x1":0.723603636397