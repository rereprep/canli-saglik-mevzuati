{"lines":[{"text":"ULUSAL GÖRME TARAMA PROGRAMI GENELGESİ","x0":0.2874743284017234,"x1":0.7104722793327051,"top":0.09011627917874931,"bottom":0.10319767409159952,"conf":1},{"text":"LO0C - ROM COC.","x0":0.7556468166082514,"x1":0.8316221770404069,"top":0.14230769234004614,"bottom":0.15128205131440509,"conf":0.5},{"text":"T.C.","x0":0.45585215492715153,"x1":0.49486653069913183,"top":0.18168604669519672,"bottom":0.19476744160804682,"conf":1},{"text":"SAGLIK BAKANLIĞI","x0":0.40041067421476106,"x1":0.5585215638017944,"top":0.19316239324695317,"bottom":0.20641025649481637,"conf":1},{"text":"Halk Sağlığı Genel Müdürlüğu","x0":0.3778234042593183,"x1":0.5811088337283612,"top":0.20769230774330283,"bottom":0.21965811970911486,"conf":1},{"text":"00100587821","x0":0.7121503899286111,"x1":0.7724032795410327,"top":0.1893644591324718,"bottom":0.19935777183774817,"conf":1},{"text":"Sayı : 67414668-","x0":0.18275153931760768,"x1":0.3121149902409138,"top":0.23546511607860898,"bottom":0.2487179486217458,"conf":1},{"text":"Konu : Ulusal Görme Taraması Programı","x0":0.1846763274645664,"x1":0.46008490506645006,"top":0.24702825647048254,"bottom":0.26044681030375116,"conf":1},{"text":"K-O","x0":0.6468172485014423,"x1":0.6735112937470177,"top":0.228197674319071,"bottom":0.23691860453267322,"conf":1},{"text":"TSE-ISO-EN","x0":0.6344969188766706,"x1":0.6858316228687092,"top":0.23691860461703618,"bottom":0.24563953483063827,"conf":1},{"text":"9000","x0":0.6488706364121198,"x1":0.6755646816576952,"top":0.24563953492651092,"bottom":0.25290697663532846,"conf":1},{"text":"CERTIFICATI","x0":0.7145790560673391,"x1":0.7700205330576019,"top":0.24854651168975495,"bottom":0.2558139533985724,"conf":0.30000001192092896},{"text":"GENELGE","x0":0.4393086640887497,"x1":0.5237303500790337,"top":0.2975296554074425,"bottom":0.3100284840997565,"conf":1},{"text":"20191.17","x0":0.44969199440246116,"x1":0.5277207367210355,"top":0.30668604640599917,"bottom":0.32412790683320347,"conf":1},{"text":"Ülkemizde çocukluk çağında sık görülen sağlık sorunlarının erken tanınması ve gerekli","x0":0.21960886626925952,"x1":0.7865557239107726,"top":0.332762067855051,"bottom":0.35141725306545013,"conf":1},{"text":"tedavilerinin sağlanabilmesi amacıyla çeşitli tarama programları yürütülmektedir. Yenidoğan,","x0":0.17659137129872543,"x1":0.7843942547559692,"top":0.34871794880997564,"bottom":0.3633720928688553,"conf":1},{"text":"okul öncesi ve okul çağı çocuklarda sık görülen görme kusurlarına yönelik tarama programı da","x0":0.17653022486592734,"x1":0.7844534811645782,"top":0.36038150106896705,"bottom":0.3769083134348984,"conf":1},{"text":"bu programlar arasına dâhil edilmiştir.","x0":0.17659137122710142,"x1":0.4271047270772659,"top":0.3735042734406627,"bottom":0.3867521366885259,"conf":1},{"text":"Bu kapsamda Ulusal Görme Taraması programımın yürütülmesi sırasında aşağıdaki","x0":0.2216934599288283,"x1":0.7844484127066584,"top":0.39095014380690685,"bottom":0.4075394894943818,"conf":1},{"text":"hususlara riayet edilecektir:","x0":0.1763776366813986,"x1":0.35954321804901124,"top":0.4039811536023661,"bottom":0.4180195818844924,"conf":1},{"text":"1) \"Ulusal Görme Taraması Uygulama Rehberi\" Halk Sağlığı Genel Modürlogümüzün","x0":0.22381929897213637,"x1":0.7864476425473707,"top":0.42136752120321663,"bottom":0.43604651133091044,"conf":1},{"text":"web sayfasında güncel olarak yer almakta olup, program buradan takip edilecektir.","x0":0.17650276990148628,"x1":0.7105730074175458,"top":0.4337727896176,"bottom":0.45000169531984857,"conf":1},{"text":"2) Tarama programı kapsamında; bebeklere 0-3 aylar arasında, çocuklara 36-48 aylar","x0":0.2237467296090564,"x1":0.7844593294498778,"top":0.4520059532053665,"bottom":0.4679247664054449,"conf":1},{"text":"arasında ve 6 yaş ya da 7 yaşta (çocuğun ilköğretim 1. sınıfa başlayacağı yıl) gürne taraması","x0":0.1765001236184326,"x1":0.7844819795713309,"top":0.4649170452589444,"bottom":0.48174407103925554,"conf":1},{"text":"yapılacaktır.","x0":0.17446932416437133,"x1":0.2608489508063425,"top":0.47796833589775534,"bottom":0.4915084082165905,"conf":1},{"text":"3) 32 hafta ve altindaki tüm prematüreler ve 1500 gram ve altında doğan tüm bebekler","x0":0.22373856581402995,"x1":0.7844690629044169,"top":0.4965177387686541,"bottom":0.5115521274493975,"conf":1},{"text":"4. haftada prematüre retinopatisi (ROP) açısından değerlendirilmek üzere göz muayenesi için","x0":0.1765004448109745,"x1":0.7844699387461317,"top":0.5089753197490315,"bottom":0.5251597997151544,"conf":1},{"text":"sevk edilecektir.","x0":0.17659137691117466,"x1":0.2874743308917001,"top":0.5217948718967377,"bottom":0.535042735144601,"conf":1},{"text":"4) Aile","x0":0.22371039924004735,"x1":0.28552984709993484,"top":0.5404033418238563,"bottom":0.5526199138925516,"conf":1},{"text":"hekimi","x0":0.2852597655227369,"x1":0.3512905422973175,"top":0.5401511602692252,"bottom":0.5514186071295141,"conf":1},{"text":"vC","x0":0.35318275146769496,"x1":0.3860369608232995,"top":0.5436046512126594,"bottom":0.5508720929214769,"conf":0.5},{"text":"aile","x0":0.38809034877547366,"x1":0.429158111046566,"top":0.5406976745997163,"bottom":0.550872092502997,"conf":1},{"text":"sağlığı çalışanı tarafindan kendilerine kayıtlı","x0":0.42710473197916937,"x1":0.7843942411354761,"top":0.5421511625970755,"bottom":0.5552325583250319,"conf":1},{"text":"bebeklere/çocuklara;","x0":0.17659137360130772,"x1":0.3141683797464483,"top":0.5537790695662025,"bottom":0.5668604652941589,"conf":1},{"text":"a) 0-3 aylık bebeklerin, bebek izlemlerinde 6. izlem olan 3. ay izleminin sonuna kadar","x0":0.22997945938015799,"x1":0.7843942569589443,"top":0.5666666664828475,"bottom":0.5799418606509383,"conf":1},{"text":"göz taraması yapılacaktır. Tarama; aile hekimi tarafindan risk faktörleri açısından sorgulama","x0":0.17659136970238462,"x1":0.7802874801614045,"top":0.5799145297602764,"bottom":0.5931623930081396,"conf":1},{"text":"görme muayenesi, kırmızı refle testinin yapılması şeklindedir. Bebekler, pozitif muayene","x0":0.17659137129942007,"x1":0.7843942547566639,"top":0.5930232556218974,"bottom":0.6061046513498538,"conf":1},{"text":"bulgusu ya da risk faktörlerinden herhangi birinin varlğı durumunda, ileri tetkik ve muayene","x0":0.1765913712934157,"x1":0.7843942547506595,"top":0.604651162598563,"bottom":0.6177325583265193,"conf":1},{"text":"için göz hastalıkları uzmanına sevk edilecektir.","x0":0.17453798618744545,"x1":0.4804928144151793,"top":0.6175213675829737,"bottom":0.630813953673192,"conf":1},{"text":"b) 36-48 aylık çocukların, çocuk izlemlerinde 5. izlemi içerisinde görme taramasi","x0":0.231935699659129,"x1":0.7824267928068958,"top":0.6291248139839558,"bottom":0.6456001589108388,"conf":1},{"text":"yapılacaktır. Taramada; aile hekimleri tarafından risk faktörleri açısından sorgulama, görme","x0":0.1745379982364553,"x1":0.7843942312912656,"top":0.6423076923519031,"bottom":0.65697674388905,"conf":1},{"text":"muayenesi, kırmızı refle testi ve aile sağlığı çalışanları tarafindan da Lea Sembol Testi","x0":0.17652224044785578,"x1":0.7844601097585231,"top":0.655012282342944,"bottom":0.671073508462287,"conf":1},{"text":"yapılacaktır. Çocuklar, pozitif muayene bulgusu ya da risk faktörlerinden herhangi birinin","x0":0.1745379840152817,"x1":0.7843942539716375,"top":0.6686046509708086,"bottom":0.681686046698765,"conf":1},{"text":"varlığı durumunda ileri tetkik ve muayene için göz hastalıkları uzmanına sevk edilecektir.","x0":0.17649765783067614,"x1":0.7557357560490104,"top":0.6795453731817247,"bottom":0.6960786599366263,"conf":1},{"text":"e) Çocukların 6 yaş ya da 7 yaş izlemleri içerisinde (çocuğun ilköğretim 1. sınıfa","x0":0.23203284676964112,"x1":0.7843942578493154,"top":0.6931623927791447,"bottom":0.7078488370535254,"conf":1},{"text":"başlayacağı yıl) görme taraması yapılacaktır. Taramada: aile hekimleri tarafindan risk faktörleri","x0":0.17652649107452376,"x1":0.7844448763691693,"top":0.7063646415092572,"bottom":0.7209148424036048,"conf":1},{"text":"açısından sorgulama, görme muayenesi, kırmızı refle testi ve aile sağhğı çalışanlanı tarafından","x0":0.1765913713137772,"x1":0.784394254771021,"top":0.719476743994091,"bottom":0.7325581397220474,"conf":1},{"text":"da Lea Sembol Testi yapılacaktır. Çocuklar, pozitif muayene bulgusu ya da risk faktörlerinden","x0":0.17659137129388489,"x1":0.7843942547511287,"top":0.7311046513115883,"bottom":0.7457264959700731,"conf":1},{"text":"herhangi birinin varlığı durumunda ileri tetkik ve muayene için göz hastalıkları uzmanına sevk","x0":0.17651271797580745,"x1":0.7844508086957478,"top":0.743952351952446,"bottom":0.7600318535690952,"conf":1},{"text":"edilecektir.","x0":0.17655185738472248,"x1":0.25055286520283154,"top":0.7571552903627312,"bottom":0.7704609886596939,"conf":1},{"text":"ş) Bebek veya çocukların bu tanı ve tedavisine yönelik ilgili süreçler aile hekimince","x0":0.22997946018861024,"x1":0.7864476442665085,"top":0.7703488368822926,"bottom":0.7863372096198185,"conf":1},{"text":"takip edilecektir.","x0":0.17453798942977247,"x1":0.2874743299094099,"top":0.7833333332928284,"bottom":0.7965811965406916,"conf":1},{"text":"d) Sonuçlar Aile Hekimliği Bilgi Sistemine (AHBS) kaydedilecektir.","x0":0.23203286228932604,"x1":0.6817248377087638,"top":0.8021367520578861,"bottom":0.8154069769307034,"conf":1},{"text":"T.C. SAÖLIK BAKANLIOI HALK SAGLIĞI GENEL MÜDÜRLOÓU-ÇOCUK VE ERGEN SAGLIGI DAIRE HASKANLIO!","x0":0.18269434725871392,"x1":0.7454284137617936,"top":0.8472254954216635,"bottom":0.8604074475476693,"conf":1},{"text":"Tel: (312) 565 60 84 / MAHMUT BOZKURT CAD UMUT SOK NO: 19 KAT:5 KOLFANKARA","x0":0.1889117052323838,"x1":0.6201232021598135,"top":0.8589743588111568,"bottom":0.8677325581279804,"conf":1},{"text":"Faks (312) 565 60 81","x0":0.1868583166093903,"x1":0.28336755587074536,"top":0.8675213674376443,"bottom":0.8749999999162767,"conf":1},{"text":"DrA.KÜLEKÇI UGUR o-posur mih","x0":0.18869248230617588,"x1":0.35542191235147325,"top":0.8736096481981016,"bottom":0.8862240874858579,"conf":0.5},{"text":