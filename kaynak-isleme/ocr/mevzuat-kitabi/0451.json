{"lines":[{"text":"4.1. Tebligatlar, 7201 sayılı Tebligat Kanunu hükümlerine göre ve iadeli taahhütlü olarak","x0":0.1909650966949776,"x1":0.8213552316424534,"top":0.1395348837370175,"bottom":0.1569767441642218,"conf":1},{"text":"yapılır.","x0":0.19041471682218575,"x1":0.24846518843131749,"top":0.15565050948019477,"bottom":0.1714100998247461,"conf":1},{"text":"4.2. Protokol hükümleri ancak tarafların mutabakatı ile değiştirilebilir.","x0":0.19096509873786094,"x1":0.6837782275401962,"top":0.18749999967430298,"bottom":0.20348837241182882,"conf":1},{"text":"5. IHTİLAFLARIN HALLI","x0":0.16632443414348336,"x1":0.3778234096089742,"top":0.21794871809186123,"bottom":0.2341880343311774,"conf":1},{"text":"Iş bu protokolün yürütülmesiyle ilgili bir uyuşmazlığın olması halinde, taraflardan birinin","x0":0.19090087144287718,"x1":0.8214179477068585,"top":0.24996556072542386,"bottom":0.2692352602459589,"conf":1},{"text":"yazılı talebi ile uyuşmazlığın giderilmesi ve protokolde gerekli düzenlemelerin","x0":0.19087345224993438,"x1":0.8235136958355601,"top":0.26470467626377114,"bottom":0.2859090720470243,"conf":1},{"text":"yapılabilmesi için taraf yetkilileri yazılı bildirimi müteakip 15 gün içinde bir araya","x0":0.19096511456526116,"x1":0.8234085991103035,"top":0.2803418801718828,"bottom":0.29957264940265205,"conf":1},{"text":"geleceklerdir. Bu suretle uyuşmazlığın giderilememesi halinde Ankara mahkemeleri ve","x0":0.19290313016832156,"x1":0.8235021278633032,"top":0.296960909432757,"bottom":0.3165664188728612,"conf":1},{"text":"6. PROTOKOLÜN SÜRESİ","x0":0.16632443616341974,"x1":0.38193018462713463,"top":0.3444444442635457,"bottom":0.3604651155863602,"conf":1},{"text":"Bu protokol imza tarihinden itibaren iki yıl süreyle geçerlidir. Bu sürenin bitiminden bir","x0":0.19301848478396905,"x1":0.823408619731445,"top":0.37936046479138064,"bottom":0.3953488375289065,"conf":1},{"text":"ay önce taraflardan herhangi birinin fesih bildiriminde bulunmaması halinde işbu protokol","x0":0.19294310406756374,"x1":0.8255438629995091,"top":0.3910310419501003,"bottom":0.4129556851813536,"conf":1},{"text":"aynı şartlarla birer yıl uzatılmış sayılır.","x0":0.19301847631850177,"x1":0.4681724886087829,"top":0.4113372089718328,"bottom":0.4273504269630668,"conf":1},{"text":"Taraflar bir ay önceden yazılı bildirimde bulunmak şartıyla, bu protokolü feshetme","x0":0.19301848485953876,"x1":0.8234086198070146,"top":0.44186046512968025,"bottom":0.4594017090170355,"conf":1},{"text":"hakkına sahiptirler.","x0":0.19301847912422462,"x1":0.3326488717684772,"top":0.45930232572072527,"bottom":0.4739316237107907,"conf":1},{"text":".YÜRÜTME","x0":0.16622445189359142,"x1":0.27730737534915845,"top":0.4865963034572416,"bottom":0.5046827662117113,"conf":0.5},{"text":"Bu protokol Genel Müdürlük ve TEB tarafindan yürütülür.","x0":0.1950718615417844,"x1":0.6057494934780941,"top":0.5217948714490257,"bottom":0.5393162389703933,"conf":1},{"text":"5 sayfa ve 7 maddeden ibaret iş bu protokol 3(üç) nüsha olarak tanzim edilmiştir.","x0":0.1950718666600277,"x1":0.761806983233486,"top":0.5521367517920327,"bottom":0.5713675210228019,"conf":1},{"text":"TÜRK ECZACILARI BİRLIGI","x0":0.20944558674853464,"x1":0.45174537815147825,"top":0.600290697819519,"bottom":0.6149572649128058,"conf":1},{"text":"MERKEZ HEYETI","x0":0.25455351976444374,"x1":0.4129994015814876,"top":0.6152239326755052,"bottom":0.6460859257967909,"conf":1},{"text":"T.C. SAĞLIK BAKANLIĞI","x0":0.5585215610204161,"x1":0.7741273094841309,"top":0.5973837212768991,"bottom":0.616279069393782,"conf":1},{"text":"Ecz. Endon ÇOLAK","x0":0.24833106171400451,"x1":0.41491329149431927,"top":0.6898683371555749,"bottom":0.7112944524361176,"conf":1},{"text":"Genel Başkan","x0":0.2768495573062032,"x1":0.3863757982904176,"top":0.7125156214328802,"bottom":0.7298289673175457,"conf":1},{"text":"18.09.2009","x0":0.2914366810215639,"x1":0.3759144481356151,"top":0.7423449812898325,"bottom":0.7591085070325834,"conf":1},{"text":"TULD RIM TOSUN","x0":0.5642886120