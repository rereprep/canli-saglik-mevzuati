79484502818,"x1":0.5975359300302112,"top":0.2747093023318803,"bottom":0.28931623951209773,"conf":1},{"text":"5258 sayılı Aile Hekimliği Kanunın 5 inci maddesinin üçüncü fikrasında aile","x0":0.24024641339959937,"x1":0.8295687814632897,"top":0.30940170900105723,"bottom":0.32412790682251935,"conf":1},{"text":"hekimlerinin yaptığı iş ve işlemleri basılı veya elektronik ortamda kayıt altına alacağı ve bu","x0":0.1909650998764452,"x1":0.829568780820369,"top":0.3239316241754474,"bottom":0.3401709404147637,"conf":1},{"text":"kayıtların resmi evrak hüviyetinde olduğu hüküm altına alınmıştır. Diğer taraftan Aile","x0":0.1889116941302687,"x1":0.8295687984748499,"top":0.3401162788780704,"bottom":0.3531976746060268,"conf":1},{"text":"Hekimliği Uygulama Yönetmeliği'nin 30 uncu maddesinin ikinci fikrasında \"Kayıth kişi","x0":0.190965099877114,"x1":0.8295687808210378,"top":0.35465116293999344,"bottom":0.36923076960753654,"conf":1},{"text":"sayısı, yapılan hizmetlerin listesi, muayene edilen ve sevk edilen hasta sayısı, kodları ile","x0":0.18891169415149536,"x1":0.8295687984960768,"top":0.3691860466604031,"bottom":0.3837606836251195,"conf":1},{"text":"birlikte konulan teşhisler, reçete içeriği, aşılama, gebe ve lohusa izlemi, bebek ve çocuk","x0":0.18891169413161066,"x1":0.829568798476192,"top":0.38504273507830256,"bottom":0.3997093021715894,"conf":1},{"text":"izlemi, üreme sağhığı ve bulaşıcı hastahklar ile ilgili veriler ve Kurum tarafiından belirlenen","x0":0.18891171178788096,"x1":0.8275153927318046,"top":0.39957264991122377,"bottom":0.4142441858922308,"conf":1},{"text":"benzeri verıler evrak kayıt kriterlerine göre belirlı arahklarla düzenhı olarak basıhı veya","x0":0.18891171178078756,"x1":0.8275153927247114,"top":0.41569767422680504,"bottom":0.42877906995476145,"conf":1},{"text":"elektronik ortamda Kuruma bildiriliri hükmü mevcuttur.","x0":0.19096510017297236,"x1":0.5893223762130646,"top":0.42863247872250454,"bottom":0.44188034197036785,"conf":1},{"text":"Bu amaçla aile hekimliği birimlerince yapılan tıbbi iş ve işlemlerin kayıtlarını","x0":0.2381930260945629,"x1":0.8295687806573651,"top":0.4461538463215886,"bottom":0.46075581379897945,"conf":1},{"text":"elektronik olarak Ulusal Sağlık Sistemine (USS) Aile Hekimliği Bilgi Sistemi (AHBS)","x0":0.19086087352275033,"x1":0.8296858161334668,"top":0.4587512361401189,"bottom":0.4774356755139504,"conf":1},{"text":"vasıtasıyla gönderilmektedir.","x0":0.19070288137538483,"x1":0.38831947697459507,"top":0.47580392880550937,"bottom":0.4924081762655079,"conf":1},{"text":"Ancak gerek verilerin raporlandığı Karar Destek Sistemi incelendiğinde, gerek aile","x0":0.2402464134416319,"x1":0.8295687815053222,"top":0.5000000001455914,"bottom":0.5145348835632263,"conf":1},{"text":"sağlığı merkezi izleme değerlendırme faaliyetleri esnasında gerekse bazı yargı mercilerine","x0":0.190965099876418,"x1":0.8295687808203418,"top":0.5158119661317536,"bottom":0.5305232556598423,"conf":1},{"text":"intikal eden olaylarda; yapılan enjeksiyon, sütur işlemleri, pansuman gibi basit tıbbi","x0":0.18891169413401446,"x1":0.8295687984785958,"top":0.5303418801498901,"bottom":0.5450581393808055,"conf":1},{"text":"müdahalelerin, danışmanlık hizmetlerinin ve bumın dışında sözleşmeli veya gruplandırma","x0":0.19301846871962577,"x1":0.8295688000659831,"top":0.5448717950495735,"bottom":0.5581395350709776,"conf":1},{"text":"kriterleri kapsamında çalışan aile sağlığı elemanlarının yaptığı diğer bazı işlemlerin","x0":0.18891169412711675,"x1":0.829568798471698,"top":0.5610465117771077,"bottom":0.5756410259229181,"conf":1},{"text":"verilerinin Bakanlığımıza yazılımlar aracılığıyla gönderilmediği müşahede edilmektedir.","x0":0.190965084773144,"x1":0.7905544222339398,"top":0.5755813954975663,"bottom":0.59017093994055,"conf":1},{"text":"Bu işlemler başvuan kişinin kimlik numarası ile e-nabız üzerinden kimlik bilgilerinin","x0":0.24435318798349165,"x1":0.829568783048958,"top":0.5987179488099756,"bottom":0.6133720928688553,"conf":1},{"text":"s