51950793053465,"top":0.2948717947086644,"bottom":0.30683760667447646,"conf":1},{"text":"\"Türkiye Cumhuriyeti dähilinde tababet iera ve her hangi surette olursa olsun hasta tedavi","x0":0.17659138324123672,"x1":0.8151950641851605,"top":0.308119657918433,"bottom":0.3213675211662963,"conf":1},{"text":"edebilmek için up fakültesinden diploma sahibi olmak şarttır.\" hükmü ile 70\"inci maddesinde","x0":0.17650754692829554,"x1":0.8152726352322178,"top":0.31895180535551515,"bottom":0.33570382913392516,"conf":1},{"text":"*Tahipler, dis tabipleri ve disciler yapacaklan her nevi ameliye için hastanın, hasta küçük veya","x0":0.1765224483647006,"x1":0.8172983018826872,"top":0.3328184687106883,"bottom":0.34984496403289134,"conf":1},{"text":"tahtı hacirde ise veli veya vasisinin evvelemirde muvafakatım ahırlar. Büyük ameliyei","x0":0.1786019807374617,"x1":0.8152512820288387,"top":0.3459099223506874,"bottom":0.36029227330492253,"conf":1},{"text":"cerrahiyeler için bu muvafakatin tahriri olması lazımdır. (Veli veya vasisi olmadığı veya","x0":0.176591383242414,"x1":0.8151950641863378,"top":0.36025641016871246,"bottom":0.3735465118150707,"conf":1},{"text":"bulunmadığı veya üzerinde ameliye yapılacak şahıs ifadeye muktedir olmadığı takdirde","x0":0.1765913861365254,"x1":0.8151950670804492,"top":0.37209302328633764,"bottom":0.3867521370480438,"conf":1},{"text":"muvafakat şart değildir.) ...\" hükmü yer almaktadır.","x0":0.1765913803665279,"x1":0.5215605705281626,"top":0.38504273505355435,"bottom":0.39829059830141755,"conf":1},{"text":"Kanun Maddesinden de anlaşılacağı üzere, tibbi müdahalelerde hastanın muvafakatının","x0":0.22587269755693276,"x1":0.8172484521197351,"top":0.3982558141024244,"bottom":0.4128205124765938,"conf":1},{"text":"alımması gereklidir. Ancak, büyük cerrahi işlemler için bu muvafakatın yazılı olması zorunlu olup","x0":0.17659136558712868,"x1":0.81724846993171,"top":0.4113372094515588,"bottom":0.42606837616074145,"conf":1},{"text":"mevzuatımızda bunun dışında yazılı rıza alınması gereken bir işlem öngörülmemiştir.","x0":0.17659137545883008,"x1":0.7474332650305123,"top":0.424358974071223,"bottom":0.4389534882170334,"conf":1},{"text":"Enjeksiyon uygulamaları büyük ameliyei cerrahiye olmadığı için hastaların süzel olarak","x0":0.22381930947424575,"x1":0.815195064037048,"top":0.4375000001491066,"bottom":0.4521367522858588,"conf":1},{"text":"bilgilendirilmesinin gerekli ve yeterli olduğu, müdavi hekim tarafindan reçete edilmiş güncel","x0":0.17858613220055794,"x1":0.815250932141043,"top":0.4495691765472285,"bottom":0.4652304438848647,"conf":1},{"text":"tedavisinin yetkili sağlık meslek mensupları tarafindan hastanın reçetesi görülerek yapılması","x0":0.17659138324182838,"x1":0.8151950641857522,"top":0.463662790372657,"bottom":0.47965116311018285,"conf":1},{"text":"halinde yazılı onam alınması zorunluluğu bulunmadığı hususunda,","x0":0.17651083153505154,"x1":0.6201897370174994,"top":0.47611917272413096,"bottom":0.4915134128833858,"conf":1},{"text":"Bilgilerinizi ve uygulamanın gereğini önemle rica ederim.","x0":0.2257450717033268,"x1":0.61406586539948,"top":0.48939695229602065,"bottom":0.5057719022158925,"conf":1},{"text":"Prof. DK Muhammet GÜVEN","x0":0.6078028712215373,"x1":0.8131416871896922,"top":0.552136752051166,"bottom":0.5654069769239833,"conf":1},{"text":"Bakan a.","x0":0.6813679277270988,"x1":0.7437105241847866,"top":0.5663780443027403,"bottom":0.5770757726472583,"conf":1},{"text":"Bakan Yardımcısı","x0":0.6488706388033549,"x1":0.7741273075030508,"top":0.5799145298150478,"bottom":0.5915697675508939,"conf":1},{"text":"DAĞITIM","x0":0.17858011767642515,"x1":0.25263138078680625,"top":0.6160946414344409,"bottom":0.6295448931196894,"conf":1},{"text":"Gereği","x0":0.1786447636061538,"x1":0.2258726899872753,"top":0.6308139536752194,"bottom":0.6438953485880696,"conf":1},{"text":"81 Il Valiliğine (II Sağlık Müdürlügü)","x0":0.17864476093604148,"x1":0.43326488978442984,"top":0.6438953486419621,"bottom":0.6569767443699185,"conf":1},{