{"lines":[{"text":"GELİŞİMSEL KALÇA DISPLAZİSİ TARAMA PROGRAMI GENELGESİ","x0":0.22176590695658346,"x1":0.7761807045353698,"top":0.0901162792152036,"bottom":0.10470085477046709,"conf":1},{"text":"HALK SAGLII GENEL MUDÜRLCÓC . HSGM ÇOCUK","x0":0.6138639855260711,"x1":0.8173883525021991,"top":0.11507113512505185,"bottom":0.1252626409158275,"conf":1},{"text":"T.C.","x0":0.459958933222539,"x1":0.4948665290772556,"top":0.12063953497090052,"bottom":0.13372092988375062,"conf":1},{"text":"DE ERDEN ARALISI DAIRESI BASKANL EI","x0":0.6139630371891804,"x1":0.7761806997744378,"top":0.12500000000194378,"bottom":0.12948717948912325,"conf":0.5},{"text":"SAGLIK BAKANLIĞI","x0":0.41067761672622166,"x1":0.5503080093704742,"top":0.1337209300311064,"bottom":0.14700854682605113,"conf":1},{"text":"Halk Sağlığı Genel Müdürluğu","x0":0.3880903451574691,"x1":0.5687885046855071,"top":0.14825581375431007,"bottom":0.16153846166153452,"conf":1},{"text":"Sayı","x0":0.19301848062841778,"x1":0.22381930117856372,"top":0.17587209319131614,"bottom":0.18749999959938157,"conf":1},{"text":"Konu","x0":0.19507186903876086,"x1":0.2299794648934774,"top":0.18895348818804492,"bottom":0.19912790690643178,"conf":1},{"text":": 67414668-","x0":0.24412222980124704,"x1":0.31627643058462257,"top":0.1754449651677117,"bottom":0.18538742257873597,"conf":1},{"text":": Gelışimsel Kalça Displazisi","x0":0.24435318411408602,"x1":0.41478439269579137,"top":0.1904069766807961,"bottom":0.20058139539918307,"conf":1},{"text":"Tarama Programi","x0":0.25206907153243496,"x1":0.3576554636594755,"top":0.20014260585129218,"bottom":0.21333918383635475,"conf":1},{"text":"KO","x0":0.6324435318125305,"x1":0.6591375770581059,"top":0.18168604643389652,"bottom":0.19040697664749873,"conf":1},{"text":"SE-ISO-EN","x0":0.6262833665066339,"x1":0.6714579063886433,"top":0.19040697680184127,"bottom":0.1976744185106587,"conf":1},{"text":"KQNet","x0":0.6981519497446936,"x1":0.7494866537367324,"top":0.18168604669989097,"bottom":0.19476744161274118,"conf":0.30000001192092896},{"text":"TAhra G","x0":0.702258726686236,"x1":0.7494866530673575,"top":0.20042735050738336,"bottom":0.20784883710925373,"conf":0.30000001192092896},{"text":"GENELGE","x0":0.43936362273696744,"x1":0.5195686152503819,"top":0.23815755162081031,"bottom":0.25021454137212074,"conf":1},{"text":"2019 /..13","x0":0.4455463716662391,"x1":0.5215994190770495,"top":0.24844470005756591,"bottom":0.2631832067985598,"conf":1},{"text":"Gelişimsel Kalça Displazisi (GKD) kalça ekleminin stabii olmayışından, tam çıkığa","x0":0.22792608580366078,"x1":0.7720739139853415,"top":0.28488372073809787,"bottom":0.2979651164660543,"conf":1},{"text":"kadar çok farklı şekillerde karşılaşılabilen bir ortopedik sorundur. GKD'nin çok büyük bir","x0":0.18063709899039188,"x1":0.7742041780293694,"top":0.29604924016252276,"bottom":0.3122649509247424,"conf":1},{"text":"bölümü, erken tanı ile olgunun ilerideki hayatına olumsuz hiçbir etkisi kalmayacak şekilde, tam","x0":0.18270381228536292,"x1":0.7741814151137335,"top":0.30944156845086646,"bottom":0.32544662478318576,"conf":1},{"text":"olarak tedavi edilebilir. KD'nin ülkemizdeki görülme sıklığının 1000 canlı doğumda yaklaşık","x0":0.18275154768797058,"x1":0.7741273022507729,"top":0.3226495727510822,"bottom":0.3358974359989455,"conf":1},{"text":"5 ile 10 arasında olduğu öngörülmektedir. Bu da her yıl tedavi edilmediği takdirde sakat kalma","x0":0.18275154766392837,"x1":0.7741273022267305,"top":0.3357558137615675,"bottom":0.348837209489524,"conf":1},{"text":"olasılığı olan yaklaşık 6-12 bin yenidoğanımız ile karşılaşıldığı anlamına gelmektedir. Uygun","x0":0.18275155232845505,"x1":0.7741273068912573,"top":0.34738372093653136,"bottom":0.36196581204793465,"conf":1},{"text":"tedavi edilmediğinde GKD'li bireyler toplumda toplam sağlıklı yaşam günü ortalamasının","x0":0.18480493496970696,"x1":0.7741273030333974,"top":0.36025641023472477,"bottom":0.3722222222005367,"conf":1},{"text":"düşmesine, sosyal güvenlik kurumu yükünün artmasına ve ciddi iş gücü kayıplanna neden","x0":0.18480493495978673,"x1":0.774127303023477,"top":0.3735042735116676,"bottom":0.38517441872578106,"conf":1},{"text":"olmaktadır.","x0":0.18480492898344797,"x1":0.25872689830379825,"top":0.38662790690103477,"bottom":0.39680232561942175,"conf":1},{"text":"GKD Tarama Programı ile tüm bebeklerin kalça çıkığı açısından değerlendirilmesi,","x0":0.2279260689485524,"x1":0.7761807070300026,"top":0.40406976724975585,"bottom":0.41715116297771226,"conf":1},{"text":"tedavi gerektiren olgularda erken ve uygun tedavilerinin başlatılması, kalça çıkığı için yapılacak","x0":0.18275154766907808,"x1":0.7741273022318804,"top":0.4170940171296178,"bottom":0.430341880377481,"conf":1},{"text":"cerrahi tedavi sayısı ve muhtemel komplikasyonlanın en aza indirilmesi amaçlanmaktadır.","x0":0.18480492382785257,"x1":0.7453798809039749,"top":0.42863247848798336,"bottom":0.4405982904537953,"conf":1},{"text":"Bu kapsamda tarama programının yürütülmesinde aşağıdaki hususlara riayet edilecektir.","x0":0.22792608660132493,"x1":0.7741273012821177,"top":0.44767441841259514,"bottom":0.46075581414055156,"conf":1},{"text":"1) GKD Tarama Programı Uygulama Rehberi Halk Sağlığı Genel Müdürlüğümüzün","x0":0.22792608659400335,"x1":0.7741273012747961,"top":0.4649572650965659,"bottom":0.4782051283444292,"conf":1},{"text":"web sayfasında güncel olarak yer almakta olup program buradan takip edilecektir.","x0":0.1827515366827285,"x1":0.6981519538768413,"top":0.4781976742263083,"bottom":0.4914529916208583,"conf":1},{"text":"2) Doğumdan hemen sonra, taburculuk öncesi aileler GKD konusunda bilgilendirilecek","x0":0.22792608661576869,"x1":0.7741273012965615,"top":0.49563953469135413,"bottom":0.5087209304193105,"conf":1},{"text":"ve yenidoğan hekim tarafından değerlendirilerek gerekli hallerde kalça ultrasonografisi","x0":0.18275154720525189,"x1":0.7741273017680542,"top":0.5072649573865666,"bottom":0.5218023252480617,"conf":1},{"text":"yapılması sağlanacaktır.","x0":0.1848049269495734,"x1":0.33675564781388434,"top":0.521794871775419,"bottom":0.5320512820318292,"conf":1},{"text":"3) Aile hekimi tarafindan;","x0":0.22792607779347493,"x1":0.39425051337695627,"top":0.5392441859140694,"bottom":0.5508720931372411,"conf":1},{"text":"a) Tüm bebeklerin, 4. izleminde (41. gün izlemi) GKD açısından fizik muayenesi","x0":0.24435318501952663,"x1":0.7741273077074234,"top":0.5508547009075313,"bottom":0.5641025641553946,"conf":1},{"text":"yapılacak ve risk faktörleri sorgulanacaktır.","x0":0.18069814770349546,"x1":0.4558521599937766,"top":0.5639534881731896,"bottom":0.577034883901146,"conf":1},{"text":"b) Pozitif muayene bulgusu ya da risk faktörlerinden herhangi biri var ise ileri tetkik","x0":0.2463007981861317,"x1":0.774260508783547,"top":0.5738424116510623,"bottom":0.5912215251988846,"conf":1},{"text":"ve muayene için ortopedi veya pediatri kliniğine sevk işlemi yapılacaktır.","x0":0.18267217250598236,"x1":0.6448223310940643,"top":0.5873540450767888,"bottom":0.6034270160621361,"conf":1},{"text":"c) Bebeğin tanı ve tedavisi ile ilgili süreçler aile hekimince takip edilecektir.","x0":0.24640657181595033,"x1":0.7248459951245015,"top":0.6002906978163762,"bottom":0.6149572649096631,"conf":1},{"text":"d) Sonuçlar Aile Hekimliği Bilgi Sistemine (AHBS) kaydedilecektir.","x0":0.24845995981635574,"x1":0.6796714567437855,"top":0.613247863300125,"bottom":0.6264957265479882,"conf":1},{"text":"4) Ikinci ve üçüncü basamak sağlık kuruluşlarınca;","x0":0.22997946097262073,"x1":0.5503080131449114,"top":0.6322674418001365,"bottom":0.6424418605185235,"conf":1},{"text":"a) Ortopedi ya da pediatri kliniklerince muayene edilerek, bebeğin kalça","x0":0.2464065722676372,"x1":0.774127308456422,"top":0.6438953486445933,"bottom":0.6569767443725497,"conf":1},{"text":"ultrasonografisinin eğitim almış ortopedist ya da radyolog tarafindan yapılması sağlanacaktır.","x0":0.18275154730805995,"x1":0.7700205288726383,"top":0.6555232557839151,"bottom":0.6700854697142244,"conf":1},{"text":"b) Radyolojik inceleme sonucunun ortopedi kliniğince değerlendirilmesinin ardından","x0":0.24435318572826042,"x1":0.7761806949152692,"top":0.6686046509700091,"bottom":0.6816860466979655,"conf":1},{"text":"tanı ve tedavisi planlanacaktır.","x0":0.1806981536672204,"x1":0.37577001868904253,"top":0.681623931545906,"bottom":0.6948717947937691,"conf":1},{"text":"c) Sonucundan aile hekimine bilgi verilecektir.","x0":0.24425988121469402,"x1":0.5442368066782955,"top":0.693204180482702,"bottom":0.709004705463296,"conf":1},{"text":"5) Bebeklerin 4. izleminde taraması yapılarak, bebek üç ayhk olana dek sevk edilen","x0":0.22792608659892516,"x1":0.7741273012797181,"top":0.7122093021334867,"bottom":0.7252906978614431,"conf":1},{"text":"olguların radyolojik ve klinik değerlendirmeleri tamamlanacak ve gereken olgularda tedaviye","x0":0.18275154766541096,"x1":0.7741273022282131,"top":0.7252136752397478,"bottom":0.738461538487611,"conf":1},{"text":"başlanmış olacaktır.","x0":0.18069815119264906,"x1":0.31006160211595524,"top":0.7367521369205974,"bottom":0.7500000001684606,"conf":1},{"text":"TC Sağlık Bakanlıgı Halk Sağlığı Genci Müdürlügo-","x0":0.18275153552460985,"x1":0.4332648913747742,"top":0.8212209302384025,"bottom":0.8299418604520046,"conf":1},{"text":"Çocuk ve Ergen Sağlıg Daire Başkanlg","x0":0.1827515417625055,"x1":0.37782340678432763,"top":0.8299145298760078,"bottom":0.840170940132418,"conf":1},{"text":"Bilgi için: Tülay ÖNAL","x0":0.550036936559113,"x1":0.6635438395098197,"top":0.8191186532083319,"bottom":0.8313551130545025,"conf":1},{"text":"Tel: 0(312)565 6074 Faks:0 (312)565 6081","x0":0.5503080054388513,"x1":0.7577002079061181,"top":0.8299145299575593,"bottom":0.838662790683836,"conf":1},{"text":"e-Posta:tulay.onal@saglik.gov.tr","x0":0.5482546167068076,"x1":0.706365506293841,"top":0.8401162790062059,"bottom":0.8502906977245928,"conf":0.5},{"text":"457","x0":0.48459958962225763,"x1":0.5154004101724036,"top":0.9156976742506682,"bottom":0.9273255814738398,"conf":1}]}