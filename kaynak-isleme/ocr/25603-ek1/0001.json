{"lines":[{"text":"T.C.","x0":0.45585215668582346,"x1":0.5112936336760862,"top":0.04069767452483086,"bottom":0.05523255794246573,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.38603695663138166,"x1":0.5893223861004245,"top":0.05377906943480848,"bottom":0.06976744217233433,"conf":1},{"text":"Sağhk Hizmetleri Genel Müdürlüğü","x0":0.3264886988289938,"x1":0.6406570915039485,"top":0.0726495730229817,"bottom":0.08866279101421559,"conf":1},{"text":"Sayı : 26325996","x0":0.1067761764861932,"x1":0.2628336795741145,"top":0.11918604617842565,"bottom":0.1351744189159515,"conf":1},{"text":"Konu : Klinik Kalite Uygulama ve","x0":0.10865397778344064,"x1":0.40055974186388954,"top":0.1350794654062899,"bottom":0.15181451296676163,"conf":1},{"text":"Veri Kalitesi Iyileştirme Rehberi","x0":0.18275154176122135,"x1":0.4496919896042817,"top":0.15116279070105731,"bottom":0.16880341886366956,"conf":1},{"text":"GENELGE","x0":0.4393548096328689,"x1":0.5360045330779263,"top":0.19886464864502384,"bottom":0.21247256062711184,"conf":1},{"text":"2017/ - 8","x0":0.4476386037743494,"x1":0.5420944565365924,"top":0.21366279092287088,"bottom":0.23255813903975375,"conf":1},{"text":"Bakanlığımızca Sağlıkta Dönüşüm Programı ile birlikte nitelikli ve etkili sağlık hizmeti için","x0":0.16427104325770314,"x1":0.8685831659763019,"top":0.26153846144147286,"bottom":0.27616279054381776,"conf":1},{"text":"kalite ve akreditasyon faaliyetlerine başlanmış ve ülke genelinde bu alanda önemli bir mesafe kat","x0":0.10677619900310362,"x1":0.8685831436968385,"top":0.27606837627482106,"bottom":0.29069767426488646,"conf":1},{"text":"edilmiştir. Bu kapsamda kalite ve akreditasyon faaliyetleri bünyesinde, teşhis tedavi ve bakım","x0":0.10670288825255106,"x1":0.8666074106697972,"top":0.28920499205434136,"bottom":0.30749782993088126,"conf":1},{"text":"süreçlerinin iyileştirilmesi amacıyla Türkiye Klinik Kalite Ölçme ve Değerlendirme Sistemi'nin","x0":0.10677617971064281,"x1":0.8665297748068111,"top":0.3051282054654152,"bottom":0.3213675217047315,"conf":1},{"text":"kurulmasına yönelik çalışmalar başlatılmıştır.","x0":0.10677618349684402,"x1":0.4476386006602547,"top":0.32122093037908783,"bottom":0.33589743606292166,"conf":1},{"text":"Sistem, hastalık yükü, ölçülebilirlik ve süreçlere müdahale ile iyileştirmeye açık olma özelliği","x0":0.16427104324306083,"x1":0.8685831659616597,"top":0.33575581410262134,"bottom":0.35042735008362846,"conf":1},{"text":"dikkate alınarak, belirlenen sağlık olgularına yönelik tıbbi süreçler ve klinik sonuçların kurumsal,","x0":0.1067761795903622,"x1":0.8665297746865305,"top":0.3502906973463321,"bottom":0.36627907008385796,"conf":1},{"text":"bölgesel ve ulusal düzeyde izlenmesi, analiz edilmesi ve iyileştirilmesini amaçlamaktadır. Sistem","x0":0.10677617750325057,"x1":0.8665297725994189,"top":0.3648255816883491,"bottom":0.38081395279566244,"conf":1},{"text":"kapsamında sağlık olgusu ve göstergeler belirlenmiş, söz konusu göstergelere ilişkin verilerin elde","x0":0.10672795405674466,"x1":0.8665878994070318,"top":0.37924574164177893,"bottom":0.3978690203329974,"conf":1},{"text":"edilmesi amacıyla E-Nabız üzerinde Klinik Kalite Karar Destek Sistemi oluşturulmuştur.","x0":0.106776196058123,"x1":0.765913741993167,"top":0.3952991452193717,"bottom":0.4098837207746351,"conf":1},{"text":"Gösterge sonuçlarına yönelik analizlerin doğru yapılması ve iyileştirmeye açık alanların doğru","x0":0.1663244297548813,"x1":0.8665297794752561,"top":0.41133720945173713,"bottom":0.42606837616091975,"conf":1},{"text":"şekilde belirlenmesi için sistemden doğru verilerin elde edilmesi büyük önem arz etmektedir. Bu","x0":0.10670684590486751,"x1":0.8666098184572029,"top":0.42418534288195586,"bottom":0.4419004089929418,"conf":1},{"text":"bağlamda, takip edilen sağlık olgularına dair klinik süreçlerin kalitesi ile ilgili sorumlu ve","x0":0.10670703582378994,"x1":0.8665901553446484,"top":0.43902691174504005,"bottom":0.45670362792191266,"conf":1},{"text":"sorumlulukların tanımlanması, elde edilen verilerin doğrulanması ve veri kalitesinin iyileştirilmesine","x0":0.10677620385436444,"x1":0.8685831485480993,"top":0.4549418607980875,"bottom":0.47094017131105415,"conf":1},{"text":"yönelik sağlık kuruluşlarında gerçekleştirilmesi gereken faaliyetlere ilişkin \"Klinik Kalite Uygulama ve","x0":0.10467486458235961,"x1":0.866591037850762,"top":0.4694324696122092,"bottom":0.4871008708901914,"conf":1},{"text":"Veri Kalitesi Iyilestirme Rehberi\" hazırlanmıştır. Ilgili rehbere http://kalite saglik.gov.tr/ adresinden","x0":0.10669894761948517,"x1":0.8666087100561917,"top":0.4832228351744735,"bottom":0.5019627686122448,"conf":1},{"text":"ulaşılabilmektedir.","x0":0.10677618094501767,"x1":0.25051334658749425,"top":0.5000000001213666,"bottom":0.5145348835390016,"conf":1},{"text":"Bilgilerinizi ve uygulamaların ekteki rehbere uygun olarak yürütülmesi gerektiğinin, ilgili tüm","x0":0.16418055229502443,"x1":0.8666126150737048,"top":0.5135439664156346,"bottom":0.5325785672848378,"conf":1},{"text":"resmi ve özel sağlık hizmet sunucularına tebliğini önemle rica ederim.","x0":0.10464059979922877,"x1":0.6284413217115437,"top":0.5288966760107985,"bottom":0.5465341798711417,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.6673511346090734,"x1":0.8665297726291195,"top":0.5884615386423777,"bottom":0.6076923078731469,"conf":1},{"text":"Müsteşar","x0":0.7159874850458285,"x1":0.7970399492277124,"top":0.6084592428050875,"bottom":0.6233580141074003,"conf":1},{"text":"EK: Klinik Kalite Uygulama ve Veri Kalitesi","x0":0.10472279462868418,"x1":0.44353182529298285,"top":0.6670940169943027,"bottom":0.6833333332336189,"conf":1},{"text":"İyileştirme Rehberi (27 s.)","x0":0.10451542448329736,"x1":0.3061564841835033,"top":0.6805107050695315,"bottom":0.6992090028798822,"conf":1},{"text":"DAĞITIM:","x0":0.10882957042034919,"x1":0.19712525445986986,"top":0.7252906977049421,"bottom":0.739825581122577,"conf":1},{"text":"81 Il Valiliği","x0":0.10647933841888858,"x1":0.20579062273437376,"top":0.741011798685