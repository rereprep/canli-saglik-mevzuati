{"lines":[{"text":"618","x0":0.0698151950073449,"x1":0.10266940436294944,"top":0.030523255651980108,"bottom":0.04215116287515175,"conf":1},{"text":"6.3.28. Kırım Kongo Kanamalı Ateşi Genelgesi (2004/46)","x0":0.11909651989769961,"x1":0.7659137468380715,"top":0.11482558127835207,"bottom":0.13517441871512592,"conf":1},{"text":"T.C.","x0":0.48459958888148075,"x1":0.5195071870425438,"top":0.23110465125387636,"bottom":0.24563953467151123,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.43715425462526875,"x1":0.564792438366625,"top":0.24185066097010754,"bottom":0.25758222388613783,"conf":1},{"text":"Temel Sağlık Hizmetleri","x0":0.4312114984159975,"x1":0.5728952775593621,"top":0.25726495721728315,"bottom":0.27051282046514635,"conf":1},{"text":"Genel Müdürluğü","x0":0.44969199074608496,"x1":0.5544147852292743,"top":0.2703488373461185,"bottom":0.28504273495207966,"conf":1},{"text":"SAYI : B100TSH0110002","x0":0.20533880880223435,"x1":0.3716632443857157,"top":0.29651162770913775,"bottom":0.30959302343709416,"conf":1},{"text":"KONU : Kırım-Kongo Kanamalı Ateşi","x0":0.205197511255476,"x1":0.4272906436712106,"top":0.30806843171049714,"bottom":0.32451219942112575,"conf":1},{"text":"•31.03.04. : 05367","x0":0.45021007616800596,"x1":0.6317413434379292,"top":0.3485164383611643,"bottom":0.3766639939814067,"conf":1},{"text":"GENELGE","x0":0.4701575886771945,"x1":0.5360025753955903,"top":0.4125953964433471,"bottom":0.42461390584354364,"conf":1},{"text":"2004/ 46","x0":0.4722792599685579,"x1":0.535934292180655,"top":0.4243589740504101,"bottom":0.4389534881962206,"conf":1},{"text":"ILGI: 30.12.2003 tarihli ve B100TSH0110002/20409 sayili genelge.","x0":0.2073921997717287,"x1":0.5954825433162609,"top":0.4504273502621623,"bottom":0.4636752135100255,"conf":1},{"text":"İki bin iki yılının bahar ve yaz aylarında bazı illerimizin özellikle kırsal kesiminde bulunan","x0":0.2546201317678464,"x1":0.8008213464486393,"top":0.46794871782283454,"bottom":0.48119658107069774,"conf":1},{"text":"vatandaşlarımızda görülen ve 2003 yılının yine aynı dönemlerinde tekrar ortaya çıkan vakalarla ilgili","x0":0.20933171347277205,"x1":0.8009305009765507,"top":0.4785209908978125,"bottom":0.49493511156379477,"conf":1},{"text":"olarak Bakanlığımızca yapılan çalışmalar sonucunda belirlenen Kırım-Kongo Kanamalı Ateşi'ne ait klinik","x0":0.2073033085826575,"x1":0.7988682573692165,"top":0.49185315305512844,"bottom":0.5079616357746151,"conf":1},{"text":"tanımlama, vaka tanımları ile bu vakalarda yapılması gereken işlemlerle ilgili öneriler yapılmış, ayrıca,","x0":0.20944559292750137,"x1":0.8008213474903036,"top":0.5058139533603535,"bottom":0.5175213676776883,"conf":1},{"text":"hastalığa ait bilgi notu ile vaka takip çizelgesi hazırlanarak ilgi genelge ile gönderilmiştir.","x0":0.2072453171465883,"x1":0.7105837999675905,"top":0.5158186283969243,"bottom":0.533731145846719,"conf":1},{"text":"Malümları olduğu üzere, enfeksiyon hastalıklarından korunmanın en önemli basamaklarından","x0":0.25448727460390075,"x1":0.8009274636933241,"top":0.5342578120228826,"bottom":0.5504918871289898,"conf":1},{"text":"birisi de iyi bir vaka yönetimi ve ilgili birimlerin üzerine düşen görevleri titizlikle yapmasıdır. Bunun yanı","x0":0.2093413324733334,"x1":0.8009234773800936,"top":0.5474475949663584,"bottom":0.5642519999179267,"conf":1},{"text":"sıra, nozokomiyal enfeksiyon riski olan hastalıklarda, sağlık çalışanlarının ve hasta ile teması olanların","x0":0.2092561420806971,"x1":0.8009573313732267,"top":0.558845524641897,"bottom":0.5772591148041253,"conf":1},{"text":"korunması da büyük önem arz etmektedir.","x0":0.2092214919800719,"x1":0.4539505121230019,"top":0.5739154623759168,"bottom":0.5897523573975348,"conf":1},{"text":"Bu nedenle, nozokomiyal enfeksiyon riski bulunan Kırım-Kongo Kanamalı Ateşinde, iyi bir vaka","x0":0.254534469927267,"x1":0.8009029962153377,"top":0.5905196892578357,"bottom":0.6066674470570332,"conf":1},{"text":"yönetiminin gerçekleşebilmesi için sağlık kuruluşlarınca yapılması gereken çalışmalar ve nozokomiyal","x0":0.20927848270959853,"x1":0.7989206395665551,"top":0.6031854618021933,"bottom":0.6208981885582322,"conf":1},{"text":"enfeksiyonlara karşı sağlık çalışanlarının alması gereken önlemler ile hasta yakınlarının korunmalarına","x0":0.2114053365475744,"x1":0.8009266408430323,"top":0.6162792525801486,"bottom":0.6318519113471968,"conf":1},{"text":"ilişkin bilgilerin yer aldığı doküman ilişikte gönderilmektedir.","x0":0.20920844146766665,"x1":0.5464615553676817,"top":0.6286348005509321,"bottom":0.6470265034800458,"conf":1},{"text":"Söz konusu dokümanın bütün sağlık kurum ve kuruluşlarına ulaştırılmasının sağlanması ile","x0":0.256595108103837,"x1":0.8008949337514149,"top":0.6474168020516916,"bottom":0.6628765539307397,"conf":1},{"text":"ilişikte verilen bilgiler çerçevesinde konuya hassasiyetle yaklaşılarak gereğinin yapılması hususlarında","x0":0.2093163646629998,"x1":0.8009827557981268,"top":0.6592754632111931,"bottom":0.677473919934659,"conf":1},{"text":"bilgilerinizi ve keyfiyetin icabı için ilgililere emirlerinizi arz ve rica ederim.","x0":0.20931158680570167,"x1":0.62028424659825,"top":0.6729821943222302,"bottom":0.6906209183966346,"conf":1},{"text":"er","x0":0.6981519518888694,"x1":0.7494866512682149,"top":0.7223837210664673,"bottom":0.7354651159793175,"conf":1},{"text":"Dr. Necdet ÜNUVAR","x0":0.6096650557613436,"x1":0.727090589180564,"top":0.7303753653494383,"bottom":0.7478223087792385,"conf":0.5},{"text":"Bakan a.","x0":0.6199589779101916,"x1":0.6779973596504802,"top":0.7490655669966871,"bottom":0.7595176263919801,"conf":1},{"text":"Müsteşar","x0":0.6197079889660799,"x1":0.6779132487204869,"top":0.7618231168760727,"bottom":0.7745901212314789,"conf":1},{"text":"EK: KKKA'de Vaka Yönetimi ve","x0":0.21317356342897723,"x1":0.41915009345561716,"top":0.7744204637593851,"bottom":0.7911044881137166,"conf":1},{"text":"İzolâsyon Önlemleri (7 sf.)","x0":0.2544091933167993,"x1":0.4130413172339603,"top":0.7865306633947615,"bottom":0.8044070178405