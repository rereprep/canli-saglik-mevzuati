{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397568687,"x1":0.9609856316724636,"top":0.04059829028555706,"bottom":0.05523255797844895,"conf":1},{"text":"T.C.","x0":0.2874743327877283,"x1":0.3059548251178159,"top":0.22819767444251826,"bottom":0.2354651161513357,"conf":1},{"text":"Seğik Bakaninğ","x0":0.2607802866694477,"x1":0.3244353188815448,"top":0.2367521367186458,"bottom":0.24572649569300486,"conf":0.5},{"text":"Temel Sağlık Hizmetleri Genel Müdüruğu","x0":0.21765913655595606,"x1":0.3819301856403254,"top":0.24563953488722567,"bottom":0.2543604651008279,"conf":1},{"text":"3. HASTAHANELERİN YAPMASI GEREKEN ÇALIŞMALAR","x0":0.21549517844441313,"x1":0.6387230260038335,"top":0.26404760529354543,"bottom":0.2820621398117954,"conf":1},{"text":"v KKKA'ya ilişkin değerlendirmelerin, Bakanlıkça hazırlanarak il sağlık","x0":0.23603601782093336,"x1":0.7783412780329195,"top":0.2831599243741484,"bottom":0.30157336374171984,"conf":1},{"text":"müdürlüklerine gönderilen dokümanlar ve bilgiler çerçevesinde yapılması","x0":0.2607802844791756,"x1":0.7761807016732885,"top":0.29941860461561287,"bottom":0.3168604650428173,"conf":1},{"text":"sağlanmalıdır.","x0":0.25867073180746175,"x1":0.3573456950978043,"top":0.3166462606896989,"bottom":0.3301560648529225,"conf":1},{"text":"y KKKA vaka tanımlarına uyan hastalar için uygun hasta odaları","x0":0.23607126828484273,"x1":0.7783189251843099,"top":0.3339511135922326,"bottom":0.35310107481925834,"conf":1},{"text":"hazırlanmalıdır.","x0":0.25853559496962536,"x1":0.3719446626978363,"top":0.3507839862648444,"bottom":0.36588633361435363,"conf":1},{"text":"v KKKA konusunda, hastahane çalışanlarının eğitimleri ve enfeksiyon kontrolü","x0":0.23819302546340684,"x1":0.7802874671459756,"top":0.37051282058556967,"bottom":0.38675213682488585,"conf":1},{"text":"için bir ekip oluşturulmalıdır.","x0":0.25872690699079554,"x1":0.46406570450817763,"top":0.3866279069467058,"bottom":0.40128205100558545,"conf":1},{"text":"v Hastahane çalışanlarının (hekim, hemşire, laboratuvar teknisyeni,","x0":0.23819302546222063,"x1":0.7802874671447894,"top":0.4055232554886157,"bottom":0.4215116282261415,"conf":1},{"text":"temizlikçi vb.) konuya ilişkin olarak bilgilenmesi ve bilinçlenmesi","x0":0.25872689770693796,"x1":0.7782340878992746,"top":0.4200581396810672,"bottom":0.43461538472365624,"conf":1},{"text":"sağlanmalıdır.","x0":0.2627906951483841,"x1":0.35938589655997155,"top":0.4358660856244536,"bottom":0.4478548444615096,"conf":1},{"text":"v KKKA hastası veya şüpheli bir vakanın varlığı söz konusu olursa, gerekli","x0":0.23819302562568015,"x1":0.7802874673082489,"top":0.45341880373392984,"bottom":0.4680232556551809,"conf":1},{"text":"uyarıcı levhalar","x0":0.3241697173370771,"x1":0.4643272577841231,"top":0.46836132008744713,"bottom":0.48210834136315495,"conf":1},{"text":"asılmalı, hasta yanına giriş çıkışlar","x0":0.4618677897646608,"x1":0.7804496072809093,"top":0.4672895423457666,"bottom":0.484524990156013,"conf":1},{"text":"sınırlandırılmalıdır. Hasta ziyaretçilerinin hasta ile teması önlenmeli,","x0":0.26078028662494157,"x1":0.7823408633163903,"top":0.4824786325858794,"bottom":0.49709302309767744,"conf":1},{"text":"gerekirse kontrollü ziyarete izin verilmelidir.","x0":0.2606596260874404,"x1":0.5770861350359175,"top":0.49758765325877374,"bottom":0.5131406516629913,"conf":1},{"text":"v Üniversal korunma önlemleri için gerekli olan malzemeler (eldiven, maske,","x0":0.24024641385445575,"x1":0.7823408555370245,"top":0.515811965647629,"bottom":0.5320512818869452,"conf":1},{"text":"gözlük, önlük vb.) eksiksiz olarak tedarik edilmeli ve sürekli olarak","x0":0.26062860270810395,"x1":0.7804465777166061,"top":0.5295967582933871,"bottom":0.548041054323285,"conf":1},{"text":"müdahale edenlerin veya laboratuvar çalişanlarının","x0":0.3345925098567183,"x1":0.7804038080471846,"top":0.5446799879481502,"bottom":0.5621015995058092,"conf":1},{"text":"kullanabileceği şekilde hazır bulundurulmalıdır.","x0":0.26283367174545214,"x1":0.5852156104168548,"top":0.561046511747957,"bottom":0.5756410258937674,"conf":1},{"text":"v KKKA vakalarının il sağlık müdürlüklerine bildirimlerinde gerekli hassasiyet","x0":0.2402464129173519,"x1":0.7802874681008087,"top":0.5799145296198085,"bottom":0.5959302328700089,"conf":1},{"text":"gösterilmelidir.","x0":0.26059677676059506,"x1":0.3738377487236864,"top":0.5970679978854694,"bottom":0.6115233171515033,"conf":1},{"text":"v Hasta odalarının, hastanın kullandığı malzemelerin ve hastaya ait dışkı,","x0":0.24024641448177744,"x1":0.7843942426634583,"top":0.6148255810658955,"bottom":0.6308139538034214,"conf":1},{"text":"idrar ve vücut sıvılarının uygun şekilde bertaraf edilmesi sağlanmalıdır.","x0":0.2628336812303186,"x1":0.753593423533542,"top":0.6293604652610053,"bottom":0.6440170937637452,"conf":1},{"text":"v Hastaların, gerek hastahane içi gerekse hastahane dışı nakillerinde gerekli","x0":0.24024641372408181,"x1":0.7823408554066505,"top":0.6482558136231622,"bottom":0.664244186360688,"conf":1},{"text":"önlemler alınmalı ve bu nakilleri yapacak olanlar uyarılmalıdır.","x0":0.2626506162986401,"x1":0.685925624033204,"top":0.6625606175668466,"bottom":0.6807276258608461,"conf":1},{"text":"v KKKA'dan vefat edenlerle ilgili olarak, gerekli korunma önlemlerinin","x0":0.24221748309373636,"x1":0.7824199825387371,"top":0.6830756060054315,"bottom":0.7000755663586633,"conf":1},{"text":"alınmasından sonra cenaze usulüne uygun olarak yıkanmalı, kefenlenmeli ve","x0":0.2648870614326097,"x1":0.7823408651258346,"top":0.6976744182673165,"bottom":0.7136752140392495,"conf":1},{"text":"durumdan il sağlık müdürlükleri haberdar edilmelidir.","x0":0.2648870584474554,"x1":0.6324435370008676,"top":0.7136627908412472,"bottom":0.7282051284055688,"conf":1},{"text":"4. BİRİNCİ BASAMAK SAĞLIK KURULUŞLARININ YAPMASI GEREKEN","x0":0.22153324715597406,"x1":0.782529841290931,"top":0.7442367353780428,"bottom":0.7647017376825112,"conf":1},{"text":"ÇALIŞMALAR","x0":0.25044293248780375,"x1":0.35325316599487944,"top":0.7642537399144604,"bottom":0.7778974228344762,"conf":1},{"text":"v KKKA'ya ilişkin eğitimleri, Bakanlıkça hazırlanarak il sağlık müdürlüklerine","x0":0.24416973758208751,"x1":0.7825146870299223,"top":0.7792245729260124,"bottom":0.7986548720165364,"conf":1},{"text":"gönderilen dokümanlar ve bilgiler çerçevesinde sürdürmelidir.","x0":0.26468360163053845,"x1":0.6921293327416705,"top":0.7947681956534072,"bottom":0.8129519609017629,"conf":1},{"text":"y Sorumluluk alanında bulunan insanların, başta hastalıktan korunma","x0":0.2441999106147726,"x1":0.7824892494335451,"top":0.814433968265822,"bottom":0.8334325495896903,"conf":1},{"text":"önlemleri olmak üzere, konu hakkında bilgi sahibi olmaları ve yeterli bilince","x0":0.26670465765282797,"x1":0.7825642407775446,"top":0.8278054703444461,"bottom":0.8489217466208633,"conf":1},{"text":"ulaşmaları sağlanmalıdır.","x0":0.26671765764336486,"x1":0.439576379043191,"top":0.8465301698933418,"bottom":0.8622385291796583,"conf":1},{"text":"621","x0":0.8973305957750882,"x1":0.9281314163252342,"top":0.9433139536596464,"bottom":0.9563953485724965,"conf":1}]}