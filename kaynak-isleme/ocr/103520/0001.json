","x0":0.25455169875828937,"x1":0.8008832496977731,"top":0.47944536078552247,"bottom":0.4954647890713004,"conf":1},{"text":"sorunlara yol açan bir hastalıktır. Bu hastahk için Avrupa ülkeleri için bir haberleşme","x0":0.21149898093255382,"x1":0.8028747354953562,"top":0.4940170940148141,"bottom":0.505982905980626,"conf":1},{"text":"ağı kurulmuş olup, ülkemiz de bu ağın içinde yer almaktadır. 1996 yılında yayınlanan","x0":0.2094455928410124,"x1":0.8008213474038147,"top":0.5072649575654574,"bottom":0.5218023254269525,"conf":1},{"text":"Ilgi'de belirtilen genelge doğrultusunda Lejyoner hastalığına yönelik çalışmalar,","x0":0.21149898011052912,"x1":0.8008213481742195,"top":0.5188034189237763,"bottom":0.5320512821716396,"conf":1},{"text":"bilimsel gelişmeler göz önüne ahınarak ekte gönderilen &&Seyahat Ilişkili Lejyoner","x0":0.21149898094018624,"x1":0.8028747355029885,"top":0.5319767440603049,"bottom":0.5436046512834766,"conf":1},{"text":"Hastalığı Kontrol Programı\" çerçevesinde yeniden düzenlenmiştir.","x0":0.2113592268229255,"x1":0.657208570506798,"top":0.5424041439506051,"bottom":0.5591377226896084,"conf":1},{"text":"Ekte gönderilen \"Seyahat İlişkili Lejyoner Hastalığı Kontrol Programı\" göz","x0":0.2546201141715276,"x1":0.802874752252978,"top":0.5683139531610613,"bottom":0.5843023258985871,"conf":1},{"text":"önüne alınarak, özellikle hastanelere öncelik vererek vaka sürveyansı çalışmalarını, İl","x0":0.21144765368661175,"x1":0.8008798407496974,"top":0.5813695052583985,"bottom":0.5959198512416592,"conf":1},{"text":"Turizm Müdürlükleri ile işbirliği içinde Bulaşıcı Hastalıklar Şube Müdürlüğü ve Gıda","x0":0.20944559283808212,"x1":0.8008213474008843,"top":0.5957264957430818,"bottom":0.6090116280941664,"conf":1},{"text":"ve Çevre Kontrol Şube Müdürlükleri sorumluluğunda çevresel sürveyans çalışmalarını","x0":0.2114989807815693,"x1":0.8028747353443715,"top":0.60755813940521,"bottom":0.6192307690631835,"conf":1},{"text":"düzenlemeniz gerekmektedir.","x0":0.20944558927482088,"x1":0.410677613793979,"top":0.6205128207141485,"bottom":0.6337606839620117,"conf":1},{"text":"Ilgi'de belirtilen 30.05.1996 tarih ve 6076 sayıl Daimi Genelge, bu genelge ile","x0":0.2525667268251945,"x1":0.8028747514057568,"top":0.6468023253893393,"bottom":0.6598837211172958,"conf":1},{"text":"yürürlükten kaldırılmış olup, ekte gönderilen \"Seyahat Ilişkili Lejyoner Hastalığ","x0":0.2114989785396143,"x1":0.7967145736050806,"top":0.6598290597793719,"bottom":0.6715116280278924,"conf":1},{"text":"Kontrol Programı\"nın il düzeyindeki bütün sağlık kuruluşlarında dağıtımının yapılmas","x0":0.21136395545425826,"x1":0.7968057200920681,"top":0.6700145920619776,"bottom":0.6858829648568869,"conf":1},{"text":"ve personel eğitimlerinde göz önüne alınması hususunda bilgi ve gereğini önemle rica","x0":0.20739220555175614,"x1":0.8008213466136704,"top":0.6845930230637675,"bottom":0.6978632479365848,"conf":1},{"text":"Doç. Dr. Osman DURMUŞ","x0":0.5749486629976492,"x1":0.7597535955239113,"top":0.7730769232021821,"bottom":0.7863372094844525,"conf":1},{"text":"Sağlık Bakanı","x0":0.5748881064040097,"x1":0.6735718522621802,"top":0.78610596589571,"bottom":0.7996498480211732,"conf":1},{"text":"EK : Kontrol Programı (23) sayfa","x0":0.2072125772408004,"x1":0.4375670062528545,"top":0.7975330034375344,"bottom":0.8134513487666235,"conf":1}]}