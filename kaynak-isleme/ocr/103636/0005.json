11549304417174,"top":0.4030573491154862,"bottom":0.4176818224916381,"conf":1},{"text":"Özlük dosyaların yeni görev yerlerine gönderilmesinden eski görev yaptığı birim sorumlu","x0":0.22176592136958018,"x1":0.8131416759323825,"top":0.41709401712932315,"bottom":0.43034188037718635,"conf":1},{"text":"657 sayılı Devlet Memurları Kanunu hükümlerine göre memuriyetine son verilen, istifa","x0":0.2648870722283921,"x1":0.8110882869091849,"top":0.4431623932546954,"bottom":0.45641025650255873,"conf":1},{"text":"eden, istek, yaş haddi, malullük sebeplerinden biri ile emekliliğe ayrılan veya vefat eden","x0":0.22176592058715394,"x1":0.8110882886508443,"top":0.4563953487118737,"bottom":0.46802325593504535,"conf":1},{"text":"personelin mal beyanları Bakanlık arşivine gönderilecektir.","x0":0.22176590927334833,"x1":0.5913757743258725,"top":0.46947674412591756,"bottom":0.47965116284430453,"conf":1},{"text":"Personele ait muhtelif yazışmaların muhafaza edildiği şahsi dosyalar ile yukarıda","x0":0.2648870722276023,"x1":0.8110882869083951,"top":0.4811046510373409,"bottom":0.49273504270437274,"conf":1},{"text":"sayılan nedenlerle görevinden ayrılan sözleşmeli ve 5442 sayılı Il Idaresi Kanununa tabi","x0":0.22170315434329754,"x1":0.8111679623726015,"top":0.49214376194840104,"bottom":0.5072822339919519,"conf":1},{"text":"personelin özlük dosyaları ilde muhafaza edilecektir.","x0":0.21960663094875463,"x1":0.5544808498168395,"top":0.5057210234769826,"bottom":0.5204046784577643,"conf":1},{"text":"Konuya ilişkin 15/01/2015 tarihli ve 2015/3 sayılı Genelge yürürlükten kaldırılmıştır.","x0":0.26488706909656823,"x1":0.802874737780913,"top":0.5188034188554418,"bottom":0.533430232401647,"conf":1},{"text":"Bilgi ve gereği ile yukarıda belirtilen hususlara titizlikle riayet edilmesi ve uygulamada","x0":0.268993846816664,"x1":0.8110882884992328,"top":0.531976744060588,"bottom":0.5436046512837597,"conf":1},{"text":"herhangi bir aksamaya meydan verilmemesini önemle rica ederim.","x0":0.2197125218097180