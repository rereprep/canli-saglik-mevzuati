69767443025776,"conf":1},{"text":"içinde mal bildiriminde bulunmayanlara ise 657 sayıhı Kanunun disiplin hükümleri","x0":0.19917863712428688,"x1":0.7987679745850826,"top":0.4084302324320618,"bottom":0.420085470167908,"conf":1},{"text":"uygulanmaktadır.","x0":0.20123203501851966,"x1":0.31416837549815707,"top":0.4229651162084527,"bottom":0.43313953492683965,"conf":1},{"text":"3628 sayılı Mal Bildiriminde Bulunulması, Rüşvet ve Yolsuzluklarla Mücadele Kanunu","x0":0.24435317604876852,"x1":0.7987679736275548,"top":0.43459302306362757,"bottom":0.44786324793644483,"conf":1},{"text":"ile bu Kanunun uygulanmasına ilişkin usul ve esasları düzenleyen ve 10/08/1990 tarihli ve","x0":0.2011819415218326,"x1":0.7988150173512611,"top":0.44596208550249905,"bottom":0.4604909403942843,"conf":1},{"text":"90/748 sayılı Bakanlar Kurulu Kararı ile yürürlüğe konulan Mal Bildiriminde Bulunulması","x0":0.19911120557917797,"x1":0.796785758745744,"top":0.4587794165273674,"bottom":0.4749238429873075,"conf":1},{"text":"Hakkında Yönetmeliğin öngördüğü işlemlerin yerine getirilmesi, uygulamada yaşanan","x0":0.1991786370993888,"x1":0.7987679745601846,"top":0.47222222244563383,"bottom":0.4869186044954552,"conf":1},{"text":"sıkıntıların giderilmesi ve personelin mağduriyetinin önlenmesi amacına yönelik hususlar","x0":0.201232024474036,"x1":0.7987679754357198,"top":0.4854651161521528,"bottom":0.49709302337532457,"conf":1},{"text":"aşağıda belirtilmiştir.","x0":0.1991786442578865,"x1":0.3408624234012511,"top":0.49854651182868803,"bottom":0.5116279067415382,"conf":1},{"text":"A) MAL BİLDİRİMİNDE BULUNULMASINDA UYULMASI GEREKEN USUL","x0":0.24640656210341436,"x1":0.7967145866839767,"top":0.5230769231919372,"bottom":0.5363372090666545,"conf":1},{"text":"VE ESASLAR","x0":0.19917864292787915,"x1":0.3018480509119566,"top":0.5376068376899894,"bottom":0.5495726496558014,"conf":1},{"text":"1. Mal bildiriminde bulunacak kamu görevlileri","x0":0.24640656729774088,"x1":0.5708418924682556,"top":0.562393162199213,"bottom":0.5756410254470763,"conf":1},{"text":"Bakanlığımız merkez ve taşra teşkilatında aylık, ücret ve ödenek almak suretiyle kamu","x0":0.24845994984476388,"x1":0.7967145879262143,"top":0.5755813951566924,"bottom":0.5886627908846488,"conf":1},{"text":"hizmeti gören memurlar ve işçi niteliği taşımayan diğer kamu görevlilerinden;","x0":0.19917865348478525,"x1":0.6981519417844565,"top":0.5884615383260274,"bottom":0.6017441862332519,"conf":1},{"text":"a) 657 sayılı Kanunun 4 üncü maddesinin birinci fikrasının (A) bendine göre istihdam","x0":0.2442995576012421,"x1":0.7967760646013177,"top":0.6001067182000046,"bottom":0.6162853057630221,"conf":1},{"text":"edilen memurlarin,","x0":0.20306133685273337,"x1":0.32674129476725877,"top":0.6136108188537645,"bottom":0.6265586814299802,"conf":1},{"text":"b) 657 sayılı Kanunun 4 üncü maddesinin birinci fikrasının (B) bendine göre istihdam","x0":0.24640656254957216,"x1":0.7967145871301345,"top":0.626453488520635,"bottom":0.6410256410414913,"conf":1},{"text":"edilen sözleşmeli personelin,","x0":0.20328541944143597,"x1":0.39014373846681005,"top":0.6395348835900665,"bottom":0.6512820514544829,"conf":1},{"text":"c) 4924 sayılı Kanuna tabi sözleşmeli personelin,","x0":0.24845995233515392,"x1":0.5626283450101086,"top":0.6511627907974118,"bottom":0.6658119659685711,"conf":1},{"text":"ş) 5258 sayılı Aile Hekimliği Kanunu kapsamında sözleşme ile görev yapan personelin,","x0":0.2484599507471414,"x1":0.7987679753277037,"top":0.6641025642669707,"bottom":0.6803418805062869,"conf":1},{"text":"d) 663 sayılı KHK'nin Ek-2 sayılı cetvelinde belirtilen pozisyonlarda sözleşmeli statüde","x0":0.24640658198177753,"x1":0.7987679561599063,"top":0.6758720926343863,"bottom":0.6918803417378998,"conf":1},{"text":"görev yapan personelin,","x0":0.20098649377440755,"x1":0.35538220956401795,"top":0.6901080720269424,"bottom":0.7040641517545064,"conf":1},{"text":"mal bildiriminde bulunması gerekmektedir.","x0":0.24435318095167397,"x1":0.5256673527392911,"top":0.7034