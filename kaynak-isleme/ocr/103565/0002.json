{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"TC. Sağak Bak","x0":0.1375770017737589,"x1":0.203285420484968,"top":0.26153846154097526,"bottom":0.2718023255365192,"conf":1},{"text":"Serel Feci","x0":0.1560574960562223,"x1":0.19507186721550943,"top":0.27179487168028826,"bottom":0.2834302326425936,"conf":0.30000001192092896},{"text":"T.C.","x0":0.5215605754022256,"x1":0.5646817241724299,"top":0.2369186047509002,"bottom":0.2514534881685351,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.45554246902019385,"x1":0.6327398711809121,"top":0.24810158115040748,"bottom":0.26556574533002186,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.40847658077775884,"x1":0.6798022975828997,"top":0.26446576578202863,"bottom":0.2806384226319468,"conf":1},{"text":"hastanın seronegatif cihazda tedaviye alınması, bahse konu hastanın kalıcı viral","x0":0.27909572940381333,"x1":0.8522810885237498,"top":0.29061566759005164,"bottom":0.3097707476843483,"conf":1},{"text":"yanıt oluşana kadarki süreçte seropozitif cihazda diyalize alınması,","x0":0.27911356730110864,"x1":0.7476287627671191,"top":0.30716652587267523,"bottom":0.3256333009028276,"conf":1},{"text":"• Tüm uluslararası rehberlerde hepatit C ile enfekte tüm hastalar için önerildiği gibi","x0":0.25031684368250495,"x1":0.8523201695449975,"top":0.3227310292283305,"bottom":0.3433017711915134,"conf":1},{"text":"enfeksiyon kontrol önlemlerine sıkı uyumun önemli olduğu,","x0":0.2791014498824972,"x1":0.7004082029834079,"top":0.34026204917863445,"bottom":0.35869174828574746,"conf":1},{"text":"Hemodiyaliz ünitelerinde ve işlem esnasında standart önlemlere ve sterilizasyon-","x0":0.2770323200498229,"x1":0.8503021099058538,"top":0.35584781223580353,"bottom":0.3753490516537681,"conf":1},{"text":"dezenfeksiyon-antisepsi ilkeleri ile kateter ilişkili kan dolaşımı enfeksiyonları için","x0":0.2790635178018403,"x1":0.8502929843058646,"top":0.37329342232784346,"bottom":0.3931174169236238,"conf":1},{"text":"gerekli önlemlere tam uyumun sağlanmasının büyük önem arz ettiği, Bu nedenle,","x0":0.2791169181871288,"x1":0.850282139100445,"top":0.3903983562002489,"bottom":0.4090395085413906,"conf":1},{"text":"ekte sunulan kontrol listelerinin her hasta için doldurulacak şekilde düzenlenmesi","x0":0.27908556234011356,"x1":0.850266724721084,"top":0.4058633806224101,"bottom":0.42487384293502695,"conf":1},{"text":"ve hasta kayıtları içerisinde yer almasının sağlanması,","x0":0.27720739162055713,"x1":0.6570841891686413,"top":0.4243589740677789,"bottom":0.43895348821358926,"conf":1},{"text":"Ünitelerde kullanılacak ilaçlarla ilgili olarak mümkünse tek kullanımlık flakon ya","x0":0.2769955511855731,"x1":0.8502939028378176,"top":0.4388149441767353,"bottom":0.459209064026307,"conf":1},{"text":"da ampullerin kullanılması, mümkün olmayan durumlarda ilaçların hastaya özgü","x0":0.2811575847744952,"x1":0.8502395658383934,"top":0.4558523291340135,"bottom":0.4728531901796553,"conf":1},{"text":"olmasının sağlanması, asla çoklu doz şeklinde ortak kullanımın yapılmaması","x0":0.2790206201919515,"x1":0.8503290929048822,"top":0.47048842747838004,"bottom":0.49232698733821834,"conf":1},{"text":"hususunda;","x0":0.276834765501071,"x1":0.3620590785566607,"top":0.48708514662060587,"bottom":0.5018480168875121,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.25239123287717713,"x1":0.5094072499191965,"top":0.5130022403533117,"bottom":0.5298095438227168,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.6611909689893654,"x1":0.8336755640701826,"top":0.5828488375023025,"bottom":0.5988372086096159,"conf":1},{"text":"Bakan a.","x0":0.713944271715605,"x1":0.7787542208224696,"top":0.5998361745216079,"bottom":0.6120558729303378,"conf":1},{"text":"Müsteşar","x0":0.7081434063940215,"x1":0.7785095704665588,"top":0.6125967710531045,"bottom":0.6272288102454998,"conf":1},{"text":"EK: Kontrol Listeleri","x0":0.190965090961215,"x1":0.34291581182552594,"top":0.6641025639671602,"bottom":0.6773504272150234,"conf":1},{"text":"DAĞITIM:","x0":0.19084298287026644,"x1":0.27541808703594906,"top":0.6905186270653663,"bottom":0.7057736584880383,"conf":1},{"text":"Gereği","x0":0.18847673649725602,"x1":0.2428338938619779,"top":0.7067062248634931,"bottom":0.7208799819764363,"conf":1},{"text":"81 Il Valiliğine (İl Sağlık Müdürlüğü)","x0":0.18859784549475517,"x1":0.45824289986106415,"top":0.7189978329015788,"bottom":0.737944545754122,"conf":1},{"text":"135","x0":0.8952772073625187,"x1":0.9281314167181233,"top":0.9433139536469047,"bottom":0.9563953485597548,"conf":1}]}