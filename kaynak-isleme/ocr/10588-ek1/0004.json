0.2536182349429949,"top":0.5696662895721418,"bottom":0.5873104544807873,"conf":1},{"text":"Prof. Dr. N. ÇAĞAN","x0":0.4069529658301195,"x1":0.558282208096261,"top":0.5712209302151768,"bottom":0.5886627906423813,"conf":1},{"text":"F.AYTEKİN","x0":0.694979062805229,"x1":0.7917150721095692,"top":0.571579404602188,"bottom":0.5893853599510588,"conf":0.5},{"text":"Turizm Bakanı","x0":0.15741300991222587,"x1":0.2658998731952365,"top":0.585578582608493,"bottom":0.6019214173419832,"conf":1},{"text":"Orman Bakanı","x0":0.42944785485964015,"x1":0.5357873186804644,"top":0.5871794875005071,"bottom":0.6017441858746766,"conf":1},{"text":"Çevre Bakam","x0":0.6949478456022502,"x1":0.7916319805257449,"top":0.5882187995308068,"bottom":0.6043706793223274,"conf":1},{"text":"Kamu Konutları Yönetmeliğinde Değişiklik Yapılmasına Dair Yönetmelik","x0":0.12869417765015273,"x1":0.6729413647510767,"top":0.6147102044017452,"bottom":0.6353379222920363,"conf":1},{"text":"Madde 1- 16/07/1984 tarihli ve 84/8345 sayılı Bakanlar Kurulu Karanıyla yürürlüğe konulan Kamu Konutları","x0":0.12466804781698045,"x1":0.8916978834446098,"top":0.6420235579578378,"bottom":0.6620558814853778,"conf":1},{"text":"Yönetmeliğinin 14'üncü maddesinin birinci fıkrasının ikinci cümlesinden sonra gelmek üzere aşağıdaki cümle eklenmiş","x0":0.06738454629154753,"x1":0.8917210383898423,"top":0.6566313865058827,"bottom":0.6755560295415105,"conf":1},{"text":"ve mevcut üçüncü cümle aşağıdaki şekilde değiştirilmiştir.","x0":0.06531681225731452,"x1":0.4664146601224925,"top":0.6711816776715754,"bottom":0.6880680154735168,"conf":1},{"text":"'' Bu birim beyannameleri Mal Bildiriminde Bulunulması Hakkında Yönetmelik uyanınca verilen mal","x0":0.1286955057889836,"x1":0.8917144806800592,"top":0.6845123696365609,"bottom":0.7027843782879031,"conf":1},{"text":"bildirimleri ile karşılaştırılması için mal bildirimlerinin verileceği mercilere gönderiri","x0":0.06748465430018474,"x1":0.6543967360919891,"top":0.699127906651658,"bottom":0.7151162793891839,"conf":1},{"text":"\" Karşılaştırma işlemi","x0":0.12825614352799525,"x1":0.29692859513415887,"top":0.7104121557968511,"bottom":0.728710829834165,"conf":1},{"text":"sonuçlandıktan sonra, konut tahsis işlerini yürütmekle görevlendirilen birimde,","x0":0.30674845771805614,"x1":0.8895705604848267,"top":0.7149572650967972,"bottom":0.7282051283446606,"conf":1},{"text":"beyannamedeki bilgilere göre ek (4) sayılı cetveldeki puanlar dikkate alımır ve her yıl Ocak ayı içinde gerekli","x0":0.06538916770131585,"x1":0.8896143733428423,"top":0.7264108477390472,"bottom":0.7431770046447839,"conf":1},{"text":"degerlendırme bilgisayar ortamında yapılarak toplam puana göre sıra cetveli düzenlenir","x0":0.06543967487501672,"x1":0.6707566439395826,"top":0.741279069916626,"bottom":0.7559829061131341,"conf":1},{"text":"Madde 2- Aynı Yönetmeliğin eki (5) sayılı cetvel ilişikteki şekilde değiştirilmiştir.","x0":0.1267893654591271,"x1":0.6912065442733548,"top":0.7688034188565788,"bottom":0.783430232402784,"conf":1},{"text":"Madde 3-Aynı Yönetmeliğe aşağıdaki geçici madde eklenmiştir.","x0":0.1266625428517251,"x1":0.5686276826809206,"top":0.7814221467578342,"bottom":0.7977451271332057,"conf":1},{"text":"\"Geçici Madde 10- Bu Yönetmeliğin \"yayımı tarihinden itibaren yapılacak konut tahsisleri için en geç bir","x0":0.12467975662602886,"x1":0.887576514485479,"top":0.7964874033162583,"bottom":0.8145469675643677,"conf":1},{"text":"ay içinde ek (5) sayılı cetvelin değişik sekline göre yeni beyannameler alınır. Konut tahsisleri yeni","x0":0.06537877041338909,"x1":0.8875843872910182,"top":0.8120913995400276,"bottom":0.8322776069771353,"conf":1},{"text":"beyannameler esas alınarak sonuçlandırılır.","x0":0.06529901108905337,"x1":0.4193507844537806,"top":0.8284426658315768,"bottom":0.8459667403208116,"conf":1},{"text":"Madde 4- Bu Yönetmelik yayımı tarihinde yürürlüge gırer.","x0":0.1285631512204644,"x1":0.5319522383105899,"top":0.8422976655469778,"bottom":0.8618393782508458,"conf":1},{"text":"Madde 5- Bu Yönetmelik hükümlerini Bakanlar Kurulu yürütür.","x0":0.1288343564280772,"x1":0.5685071566388833,"top":0.8589743589516762,"bottom":0.8735465114725325,"conf":1}]}