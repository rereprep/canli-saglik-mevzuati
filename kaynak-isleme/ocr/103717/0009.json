{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537364127537,"x1":0.963039017837164,"top":0.03760683761997996,"bottom":0.056837606850749234,"conf":1},{"text":"Hizmetin etkin sunumu için her türlü bilgi, doküman, donanım ve iletişim sistemlerini","x0":0.24229980157713435,"x1":0.8316221696408247,"top":0.21656976745101764,"bottom":0.23418803398867571,"conf":1},{"text":"kullanır, kullamılmasını sağlar.","x0":0.19301847771030686,"x1":0.4004106801775737,"top":0.23401162771038408,"bottom":0.2470930234383405,"conf":1},{"text":"c)","x0":0.19096509219843402,"x1":0.21149897333398018,"top":0.25726744198502005,"bottom":0.27034883689787026,"conf":0.5},{"text":"Hasta ve olay ile ilgili bilgileri kayıt altına alır. Gerektiğinde bu bilgileri komuta kontrol","x0":0.24024641589400958,"x1":0.8357289434550359,"top":0.25290697675663387,"bottom":0.2705128202598849,"conf":1},{"text":"merkezi hekiminin bilgisine sunar.","x0":0.19096509382631827,"x1":0.43121149873014986,"top":0.27034883717926395,"bottom":0.2850427347852251,"conf":1},{"text":"d)","x0":0.19301848023011486,"x1":0.21355236136566103,"top":0.2950581397361667,"bottom":0.306686046144232,"conf":1},{"text":"Ambulansların takibi ve görevlendirilmesinde komuta kontrol merkezi hekiminin bilgisi","x0":0.23819302779916973,"x1":0.833675555360196,"top":0.29215116246289485,"bottom":0.3081395352004208,"conf":1},{"text":"dahilinde görev yapar.","x0":0.19231728339155751,"x1":0.3498110499824924,"top":0.3062305198308525,"bottom":0.3255094716224691,"conf":1},{"text":"Hekimi Be komi a kol ba bekez ardimi an indan verle diyet geke r yerine setin hu","x0":0.19096508392014425,"x1":0.8357289612629496,"top":0.3284883717781202,"bottom":0.36196581263661876,"conf":0.30000001192092896},{"text":"İstasyon Sorumlu Hekimi","x0":0.19283343026100516,"x1":0.38207237869094773,"top":0.3909050407013319,"bottom":0.40533893000885934,"conf":1},{"text":"Madde 10. Istasyon sorumlu hekimi Il Ambulans Servisi Başhekimliğinin teklifi, Acil Sağlık","x0":0.19301848796779428,"x1":0.8316221689117181,"top":0.4141025639961964,"bottom":0.4273504272440596,"conf":1},{"text":"Hizmetleri Şube Müdürü, İl Sağlık Müdür Yardımcısı ve il Sağlık Müdürü' nün uygun görüşü","x0":0.19289151532430046,"x1":0.83379932876898,"top":0.42587237122279586,"bottom":0.44504621506304454,"conf":1},{"text":"ile Valilik Makamından onay alınarak görevlendirilir.","x0":0.19301847439917247,"x1":0.5585215664534726,"top":0.4431623927789481,"bottom":0.4578488370533289,"conf":1},{"text":"a)","x0":0.19301848063167076,"x1":0.21149897296175835,"top":0.4680232560152364,"bottom":0.47965116242330175,"conf":1},{"text":"Istasyon personelinin 1. derecede disiplin ve sicil amiridir.","x0":0.24024641320924156,"x1":0.6386036892493338,"top":0.46656976758962176,"bottom":0.481196581135827,"conf":1},{"text":"Acil Sağlık Hizmetleri Şubesi ve İl Ambulans Servisi Başhekimliği ile istasyon","x0":0.2402464141917208,"x1":0.831622168754523,"top":0.48837209317200814,"bottom":0.5029914533866328,"conf":1},{"text":"arasındaki iletişimi sağlar.","x0":0.19301847741450415,"x1":0.3757700234416542,"top":0.5042735040823367,"bottom":0.5175213673302,"conf":1},{"text":"c)","x0":0.19301848061455923,"x1":0.21149897294464678,"top":0.5276162791787493,"bottom":0.5406976740915995,"conf":0.5},{"text":"Istasyonda düzenlenen 112 İstasyon Aylık Çalışma Formu (Ek-2) ve tüm evrakları,","x0":0.24024641498778568,"x1":0.8336755560497,"top":0.5260683762742392,"bottom":0.5406976742643046,"conf":1},{"text":"istasyon personelinin yıllık izinlerini onaylar ve İl Ambulans Servisi Başhekimliği' ne iletir.","x0":0.19096509521960234,"x1":0.8172484571688542,"top":0.5405982902893615,"bottom":0.5552325579822535,"conf":1},{"text":"d)","x0":0.193018480259449,"x1":0.21355236139499517,"top":0.5654069769454689,"bottom":0.5770348833535344,"conf":1},{"text":"Istasyon hekimlerinin nöbet listesini düzenler, istasyon sağlık personeli ve sürücülerinin","x0":0.23203284654521641,"x1":0.8316221840060122,"top":0.5639534885206082,"bottom":0.5786324786483021,"conf":1},{"text":"sorumluları tarafından yapılan nöbet listelerini ve yıllık izinlerini onaylar. Nöbet listelerini bir","x0":0.19291301247511808,"x1":0.8317302795643715,"top":0.5771765743650862,"bottom":0.5946276259304032,"conf":1},{"text":"önceki ayı en geç 25. gününe kadar İl Ambulans Servisi Başhekimliği' ne iletir.","x0":0.19292554389336014,"x1":0.741339965666807,"top":0.5918842377798306,"bottom":0.6096479168277656,"conf":1},{"text":"e)","x0":0.19301848063167076,"x1":0.21149897296175835,"top":0.6177325582640899,"bottom":0.6308139531769401,"conf":1},{"text":"Istasyona ait tüm resmi belgeler ile araç-gereçlerin korunmasını sağlar veya sağlatu,","x0":0.23203284735841562,"x1":0.8336755713183235,"top":0.6162393163693262,"bottom":0.6308139533340427,"conf":1},{"text":"istenildiğinde geri verilmesini sağlar.","x0":0.19284060838057315,"x1":0.44778334899045824,"top":0.6307625065211443,"bottom":0.6465963106598496,"conf":1},{"text":"Istasyonun her türlü kayıtlarının tutulmasını, evrakların dosyalanmasını ve saklanmasını","x0":0.22792607276427662,"x1":0.8336755697224085,"top":0.654069767249746,"bottom":0.6671511629777024,"conf":1},{"text":"sağlar.","x0":0.19301848099314814,"x1":0.24229979387338166,"top":0.6700581396874703,"bottom":0.6831395346003204,"conf":1},{"text":"g)","x0":0.19301848064450447,"x1":0.21149897297459203,"top":0.6933139536246069,"bottom":0.7063953485374571,"conf":1},{"text":"Demirbaş eşyaların kayıt altına alınmasını, korunmasını sağlar. Ambar kayıtlarının","x0":0.22997945926873842,"x1":0.8316221832286462,"top":0.6918604649908714,"bottom":0.703488372214043,"conf":1},{"text":"tutulmasını, aymıyatların zamanında yapılmasını sağlar.","x0":0.1950718664737629,"x1":0.570841891023623,"top":0.7076923077456088,"bottom":0.7196581197114207,"conf":1},{"text":"h)","x0":0.19301848017144665,"x1":0.21355236130699282,"top":0.7296511628451738,"bottom":0.7427325577580239,"conf":1},{"text":"Yazışmaların kurallara uygun olmasından ve her türlü yazışmadan sorumludur Üst","x0":0.24430807588971687,"x1":0.8337260189562412,"top":0.7281340576415485,"bottom":0.7423823937162471,"conf":1},{"text":"makamca istasyonuna verilen görevleri veya emirleri tüm personele duyurmakla yükümlüdür.","x0":0.19301848800375557,"x1":0.8316221689476793,"top":0.7427325582878025,"bottom":0.7572674417054374,"conf":1},{"text":"Verilen görevi tevdi edeceği personeli bizzat arar ve görevlendirir. İstasyon personeli arasında","x0":0.19507185706928826,"x1":0.8316221884156456,"top":0.7572649572194399,"bottom":0.7705128204673031,"conf":1},{"text":"telefon zinciri olușturur.","x0":0.19485174393134366,"x1":0.3616373750304311,"top":0.7718032512965375,"bottom":0.7855059821437577,"conf":1},{"text":"i)","x0":0.1930184807530821,"x1":0.20739219662542577,"top":0.7965116280159587,"bottom":0.8095930229288087,"conf":1},{"text":"Istasyonda tanımlanmış görevlerin sorumlularını seçer, bu listeyi onay için Il Ambulans","x0":0.2402464141905499,"x1":0.8316221687533523,"top":0.7948717945086599,"bottom":0.8111111107479761,"conf":1},{"text":"Servisi Başhekimıne gönderir.","x0":0.19301847770497738,"x1":0.40041068017224424,"top":0.8110465114308294,"bottom":0.8241279071587857,"conf":1},{"text":"j)","x0":0.1909650925413217,"x1":0.20944558487140927,"top":0.8343023257059504,"bottom":0.8473837206188005,"conf":0.5},{"text":"Afet ve olağan dışı durumlarda, istasyonun doldurması gereken formları (Ek-4) nöbetçi","x0":0.2422998095255802,"x1":0.8336755640883824,"top":0.8311965813948017,"bottom":0.847435897634118,"conf":1},{"text":"ekip tarafindan eksiksiz hazırlanması ve Başhekimliğe iletilmesini sağlar,","x0":0.19294711145704146,"x1":0.6941324629014565,"top":0.8462083672370101,"bottom":0.8634036629132171,"conf":1},{"text":"Istasyonda nöbet esnasında olan olayların yazılacağı bir istasyon nöbet defteri","x0":0.2401869116821688,"x1":0.8337697845826184,"top":0.8686270588455477,"bottom":0.886487983329931,"conf":1},{"text":"oluşturulmasını sağlar.","x0":0.1930184770601629,"