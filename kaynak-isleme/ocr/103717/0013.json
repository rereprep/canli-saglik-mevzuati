{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537364127537,"x1":0.963039017837164,"top":0.03760683761997996,"bottom":0.056837606850749234,"conf":1},{"text":"₫)","x0":0.18685831674735265,"x1":0.2094455843820108,"top":0.21511627910029107,"bottom":0.22965116251792594,"conf":0.5},{"text":"Aletlerin şarj durumunu kontrol eder, şarjı eksik olanların şarjını tamamlar.","x0":0.22176591501662923,"x1":0.74537987820719,"top":0.2122093021701188,"bottom":0.2296511625973231,"conf":1},{"text":"e)","x0":0.18685831634778988,"x1":0.20533880867787743,"top":0.23982558119946074,"bottom":0.25145348842263227,"conf":1},{"text":"Oksijen tüpünün doluluğunu kontrol eder, eğer boş ise doldurulması için nöbetçi hekime","x0":0.23613963731956,"x1":0.8254620053832503,"top":0.23675213680303886,"bottom":0.25299145304235504,"conf":1},{"text":"bılgı verır.","x0":0.1847715361886271,"x1":0.26081367919274356,"top":0.2528096764853318,"bottom":0.2660856719028697,"conf":1},{"text":"D","x0":0.18480492827027448,"x1":0.20328542060036206,"top":0.2747093023734084,"bottom":0.2892441857910433,"conf":1},{"text":"Hasta müdahale çantasını tıbbi malzeme eksikliklerini giderir. Eğer eksiklikleri","x0":0.23396960051867483,"x1":0.8276790088186294,"top":0.26905355492709515,"bottom":0.29222442878099053,"conf":1},{"text":"gideremiyorsa nöbetçi hekime bilgi verir.","x0":0.18685831441260783,"x1":0.468172486200225,"top":0.2892441861925257,"bottom":0.3038461536699165,"conf":1},{"text":"g) Tıbbi aletlerin bakımı ve sterilizasyonunu yapar.","x0":0.18665590886461883,"x1":0.5669804697657487,"top":0.33143188511746946,"bottom":0.35213604285709244,"conf":1},{"text":"h)","x0":0.18685831636062356,"x1":0.20533880869071114,"top":0.3590116277935844,"bottom":0.3691860465119713,"conf":1},{"text":"Ambulansın hasta kabininin temizlik ve sterilizasyonunu yapar. Gerekirse temizlik","x0":0.2340862499918656,"x1":0.8254620045546679,"top":0.3559829057508136,"bottom":0.3722222219901299,"conf":1},{"text":"işinde nöbetçi sürücünün desteğini alır.","x0":0.18480492997573364,"x1":0.451745377818794,"top":0.3720930230609367,"bottom":0.38517441878889314,"conf":1},{"text":"i)","x0":0.18685831648203485,"x1":0.20123203235437853,"top":0.3953488373182843,"bottom":0.4084302322311344,"conf":1},{"text":"Nöbetçi sağlık personeli sürücülük görevini de yapıyorsa nöbetçi sürücünün","x0":0.23408624913369783,"x1":0.8234086171973881,"top":0.3938953485117215,"bottom":0.4098837212492473,"conf":1},{"text":"görevlerinden de sorumludur.","x0":0.18873888853727075,"x1":0.3902104594390146,"top":0.4086342258015222,"bottom":0.4215897634182193,"conf":1},{"text":"Nöbetçi hekimin bilgisi olmadan hiçbir şekilde istasyondan ayrılamaz.","x0":0.2197125321059557,"x1":0.7125256609082911,"top":0.4302325578090421,"bottom":0.446220930546568,"conf":1},{"text":"Istasyon Nöbetçi Sürücüsünün Görevleri","x0":0.18480491900817247,"x1":0.49486653868490316,"top":0.47674418619311254,"bottom":0.491452991277341,"conf":1},{"text":"Madde 15. 112 ambulans istasyonunun usulüne uygun planlama ve onay ile yayımlanmış nöbet","x0":0.1848049181195838,"x1":0.8254620224641651,"top":0.498546511298518,"bottom":0.5145348840360439,"conf":1},{"text":"cetveline görevlendirilmiş göre sürücüdür.","x0":0.18675111739652395,"x1":0.4764793212772676,"top":0.5129650703903846,"bottom":0.528083087342508,"conf":1},{"text":"a)","x0":0.18685831636062356,"x1":0.20533880869071114,"top":0.5392441858586983,"bottom":0.5508720930818699,"conf":1},{"text":"Nöbeti devir alırken programlı bir görevlendirme olup olmadığını öğrenir.","x0":0.21138664215509823,"x1":0.7373096088504203,"top":0.5334982694634747,"bottom":0.5537900739157023,"conf":1},{"text":"b)","x0":0.18480492870833828,"x1":0.20739219634299647,"top":0.5610465114400938,"bottom":0.5726744186632654,"conf":1},{"text":"Nöbeti devir aluken bir önceki nöbetçi sürücüden araç ve teknik donanım ile ilgili","x0":0.22381929508798984,"x1":0.8254620190478976,"top":0.5581196581904223,"bottom":0.5741279072939359,"conf":1},{"text":"herhangi bir sorun olup olmadığını öğrenir, var ise nöbetçi hekim ile görüşerek sorunu çözer.","x0":0.1848049324306733,"x1":0.8151950673781492,"top":0.5739316238340596,"bottom":0.5886627905432422,"conf":1},{"text":"c)","x0":0.1868583161415917,"x1":0.203285420819394,"top":0.5988372091064375,"bottom":0.6104651163296091,"conf":1},{"text":"Nöbet devir tesliminde ve görev esnasında uyulması gereken kurallar bölümünde","x0":0.2340862491441452,"x1":0.8234086172078355,"top":0.595726495950422,"bottom":0.6133720930007547,"conf":1},{"text":"nöbetçı sürücüi için belirtilen esasları yerine getirir.","x0":0.1846727123170692,"x1":0.5340020045867563,"top":0.6103777760634549,"bottom":0.6286697548180039,"conf":1},{"text":"d)","x0":0.18685831634778988,"x1":0.20533880867787743,"top":0.6351744184087631,"bottom":0.6468023256319347,"conf":1},{"text":"Ambulansta olan arıza saptadığında nöbetçi hekime ve istasyon sorumlu sürücüsüne","x0":0.23408624999120878,"x1":0.8254620045540111,"top":0.6337209303796351,"bottom":0.6482905984566312,"conf":1},{"text":"bilgi verir, önerilerini sunar, nöbetçi hekimin talimatları doğrultusunda hareket eder.","x0":0.18685831589257904,"x1":0.7577002054642613,"top":0.6482558141022972,"bottom":0.6628205124764667,"conf":1},{"text":"e)","x0":0.1848049279127197,"x1":0.2053388090482659,"top":0.6729651164153045,"bottom":0.6860465113281546,"conf":1},{"text":"Ambulansın yakıtının kontrolünden sorumludur. Ambulansın yakıt miktarının 1/2","x0":0.22176591825783423,"x1":0.8049281268241886,"top":0.6713675213445723,"bottom":0.6860465114722663,"conf":1},{"text":"deponun altına inmeyecek şekilde takviyesini yapar.","x0":0.18685832522171064,"x1":0.5420944478789053,"top":0.6858974360364265,"bottom":0.7005813950518408,"conf":1},{"text":"f)","x0":0.1868583164734791,"x1":0.2012320323458228,"top":0.7093023256358714,"bottom":0.7223837205487216,"conf":1},{"text":"Ambulansın dış kısmının ve sürücü kabininin temizliğinden sorumludur ve bu temizlik","x0":0.2237675017843585,"x1":0.8255365766360439,"top":0.7076086981072797,"bottom":0.7249764718969056,"conf":1},{"text":"günlük olarak yapılur.","x0":0.18659601346750634,"x1":0.33707359695946715,"top":0.7226493446804648,"bottom":0.738847142667661,"conf":1},{"text":"g)","x0":0.18685831682802145,"x1":0.20944558446267963,"top":0.7456395352623733,"bottom":0.7616279063696867,"conf":1},{"text":"Sağlık personeline hasta kabininin temizlenmesinde yardımcı olur.","x0":0.21765913519385968,"x1":0.6878850125059629,"top":0.7456395350308547,"bottom":0.7602564099865129,"conf":1},{"text":"h)","x0":0.18685831600306882,"x1":0.207392197138615,"top":0.7703488370279491,"bottom":0.7819767442511207,"conf":1},{"text":"Sağlık personelinin olmadığı durumlarda; oksijen tüpünün doluluğunu kontrol eder,","x0":0.22997945770727032,"x1":0.8275154086689541,"top":0.7688034191979567,"bottom":0.785042735437273,"conf":1},{"text":"eğer boş ise doldurtmak veya değiştirmek için nöbetçi hekime bilgi verir.","x0":0.18480493633612083,"x1":0.6817248381366801,"top":0.7833333336819608,"bottom":0.7979651161158864,"conf":1},{"text":"i)","x0":0.18480492827027448,"x1":0.20328542060036206,"top":0.806686046559455,"bottom":0.8212209299770898,"conf":0.5},{"text":"Nöbetçi hekimin bilgisi olmadan hiçbir şekilde istasyondan ayrılamaz.","x0":0.22176592047434568,"x1":0.7145790492766809,"top":0.8051282054444306,"bottom":0.8213675216837468,"conf":1},{"text":"Nöbet Devir-Teslim Esnasında Yapılacaklar","x0":0.18891169836849284,"x1":0.5071868640416715,"top":0.8517094016674523,"bottom":0.8633720931424321,"conf":1},{"text":"Madde 16. Merkez ve Istasyonlarda nöbet devir teslimi aşağıdaki kurallara göre yapılu.","x0":0.18685830861455127,"x1":0.7864476460753471,"top":0.8735042733108334,"bottom":0.8897435895501495,"conf":1},{"text":"315","x0":0.8952772073413626,"x1":0.9281314166969672,"top":0.9433139536627608,"bottom":0.956395348575611,"conf":1}]}