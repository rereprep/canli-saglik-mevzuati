.. VALİLIĞİNE","x0":0.49691991825302956,"x1":0.6160164274553894,"top":0.38953488380810986,"bottom":0.40261627872095995,"conf":1},{"text":"(Il Sağhk Müdürlüğü)","x0":0.41478439152571583,"x1":0.5749486676118611,"top":0.4040697676421765,"bottom":0.4171511625550266,"conf":1},{"text":"Ulkemiz genelınde vatandaşlarımızın maruz kaldığı afet, acil sağlık, kaza ve yaralanma","x0":0.23408624275834355,"x1":0.8069815188291378,"top":0.44767441847920986,"bottom":0.4594017095700854,"conf":1},{"text":"gibi durumlarda, en kısa sürede olay mahalline ulaşarak, yerinde ilk müdahaleyi yapmak","x0":0.18680025494701274,"x1":0.8070321324504135,"top":0.45778210652561335,"bottom":0.4724093822370643,"conf":1},{"text":"gerekiyorsa ihtiyacı olan sağlık hizmetini alabileceği bir sağlık kuruluşuna ulaştırılmasını","x0":0.18685829809323834,"x1":0.8069815374466995,"top":0.47222222217239973,"bottom":0.48418803413821165,"conf":1},{"text":"sağlamak amacıyla Bakanlığımız bünyesinde halen 81 ilımizde birer komuta kontrol merkezı","x0":0.18480490999436439,"x1":0.8049281493478257,"top":0.4854651162204042,"bottom":0.49572649577208805,"conf":1},{"text":"koordınasyonunda 889 acil sağlık hizmetleri istasyonu ile hizmet verılmektedır.","x0":0.18480492874654755,"x1":0.7104722784362203,"top":0.4985465115690123,"bottom":0.5087209302873992,"conf":1},{"text":"Acil Sağlık Hizmetleri Başhekimliği ve ambulans hizmetlerinin hastaneler ile sağlık","x0":0.23408624276579618,"x1":0.8069815188365904,"top":0.5158119658572491,"bottom":0.5277777778230611,"conf":1},{"text":"ocakları bünyesinde yürütülmesine dair usul ve esaslar 24.03.2004 tarih ve 25412 sayılı Resmi","x0":0.18685829800604306,"x1":0.8069815373595044,"top":0.5276162789423711,"bottom":0.5393162391130192,"conf":1},{"text":"Gazetede yayımlanarak yürürlüğe giren \"Acil Sağlık Hizmetleri Yönetmeliğinde Değişiklik","x0":0.18685829810577578,"x1":0.8069815374592371,"top":0.5405982904253426,"bottom":0.5523255815162182,"conf":1},{"text":"Yapılmasına Dair Yönetmelik\" ile belirlenmiştir.","x0":0.1868583118724204,"x1":0.509240250543823,"top":0.5537790696404031,"bottom":0.5654069768635748,"conf":1},{"text":"Bu doğrultuda Il ambulans servisi başhekimliği, komuta kontrol merkezi ve acil sağlık","x0":0.2340862427700734,"x1":0.8069815188408677,"top":0.5712209301071505,"bottom":0.5829059827995312,"conf":1},{"text":"istasyonlarının çalışma usul ve esasları, bu istasyonların çalıştırılması ile ilgili kurum ve","x0":0.1848049292544895,"x1":0.8069815182055173,"top":0.5841880341095063,"bottom":0.5959302326786491,"conf":1},{"text":"kuruluşların görev ve sorumluluklarına ilişkin idari hususlar, hazırlanan yönerge ile belirlenmiş","x0":0.18480492923420105,"x1":0.8069815181852289,"top":0.597383720804957,"bottom":0.6090116280281287,"conf":1},{"text":"bulunmaktadır.","x0":0.1845371797371765,"x1":0.28983329508196093,"top":0.6076542607277814,"bottom":0.6207651787891274,"conf":1},{"text":"Bılgilerinizi ve bundan sonra ilgili tüm kurum ve kuruluşlarla yürütülecek hizmetlerin","x0":0.23408624276077497,"x1":0.8069815188315692,"top":0.6277777777945399,"bottom":0.6397435897603518,"conf":1},{"text":"bu Yönerge hükümleri doğrultusunda yerine getirılmesi hususunda gereğıni rica ederım.","x0":0.184804930978134,"x1":0.7638603665462643,"top":0.640988371967632,"bottom":0.6526162791908037,"conf":1},{"text":"EKLER:","x0":0.18266198360991326,"x1":0.2526562908084896,"top":0.7367383959126687,"bottom":0.7545406735021243,"conf":1},{"text":"Yönerge (25 Sayfa)","x0":0.18476807898729236,"x1":0.320365391019676,"top":0.7498674502106037,"bottom":0.7690278977795787,"conf":1},{"text":"DAĞITIM:","x0":0.18268490677902716,"x1":0.2711138607501058,"top":0.7905123604057541,"bottom":0.8068713603264606,"conf":1},{"text":"81 İl Valiliğine","x0":0.18267258510774786,"x1":0.29166006352772406,"top":0.8049837803611771,"bottom":0.822923196317332,"conf":1},{"text":"303","x0":0.8952772077665425,"x1":0.9322381924267177,"top":0.943313953667891,"bottom":0.956395348580741,"conf":1}]}