lgili kliniğin ve yoğun bakım servisinin","x0":0.20123202441505766,"x1":0.7987679753767414,"top":0.3895348835290917,"bottom":0.4026162792570481,"conf":1},{"text":"durumunu, boş-dolu yatak ve cihazlara ait bilgiler ile ayrıca operasyona alınan vakaları anında","x0":0.20322753346409006,"x1":0.7988301386541596,"top":0.40092932552071425,"bottom":0.41524232560470287,"conf":1},{"text":"112 Komuta Kontrol Merkezine bildirmekle ve günün her saatinde güncel tutmakla","x0":0.20328543023787807,"x1":0.7987679577989044,"top":0.4141025639942437,"bottom":0.42735042724210703,"conf":1},{"text":"yükümlüdür.","x0":0.20116158039254414,"x1":0.2895981729835404,"top":0.42853793096879844,"bottom":0.4421016038740926,"conf":1},{"text":"Bu Genelgede tanımlanan acil sevk ve nakil işlemleri il sağlık müdürlüklerinin","x0":0.2853450981666792,"x1":0.800911424709341,"top":0.4386456701678281,"bottom":0.4553169927214138,"conf":1},{"text":"denetim ve sorumluluğunda yürütülür.","x0":0.20328542553384457,"x1":0.4496919899350122,"top":0.4534188032723949,"bottom":0.46511627859162963,"conf":1},{"text":"Genelgenin ilinizde bulunan tüm sağlık kuruluşlarına duyurulması, Bakanlığımıza ve","x0":0.24635973232234615,"x1":0.8008912494895355,"top":0.46479922016603226,"bottom":0.4806552498069472,"conf":1},{"text":"üniversitelere bağlı sağlık tesisleri ile özel sağlık tesislerinde ROP hastalığı taraması yapılan","x0":0.2032233066274089,"x1":0.8008811064923198,"top":0.47732567133515436,"bottom":0.4918036619665187,"conf":1},{"text":"veya ROP hastalığı tanısı konulan hastalara sunulan sağlık hizmetlerinin iş bu Genelge","x0":0.20323823515868197,"x1":0.8008663661810143,"top":0.4907910825980768,"bottom":0.50442408192043,"conf":1},{"text":"kapsamında yürütülmesi hususunda;","x0":0.20328541848908202,"x1":0.4353182773964656,"top":0.5058139533597248,"bottom":0.5175213676770596,"conf":1},{"text":"Bilgilerinizi ve gereğini önemle rica ederim.","x0":0.24831582496917012,"x1":0.5319751637761343,"top":0.5154510713912032,"bottom":0.