{"lines":[{"text":"330","x0":0.06776180656628569,"x1":0.10266940472734884,"top":0.030523255656540016,"bottom":0.04215116287971166,"conf":1},{"text":"T.C.","x0":0.4763860374165842,"x1":0.5112936332713007,"top":0.24709302331029004,"bottom":0.26017441822314025,"conf":1},{"text":"SAGLIK BAKANLIĞI","x0":0.4106776194257798,"x1":0.5811088280074851,"top":0.2601744187473267,"bottom":0.27478632481526455,"conf":1},{"text":"Temel Sağhk Hizmetleri Genel Müdürlüğü","x0":0.34069234484153976,"x1":0.6469895640591561,"top":0.2729654061079998,"bottom":0.2908219844458403,"conf":1},{"text":"K-O","x0":0.7761806983713173,"x1":0.800821354811434,"top":0.24563953484959433,"bottom":0.25436046506319643,"conf":1},{"text":"TSE-ISO-EN","x0":0.755646816443575,"x1":0.8193018486556721,"top":0.2529069767391292,"bottom":0.2616279069527314,"conf":1},{"text":"sans","x0":0.7741273100517503,"x1":0.8008213552973257,"top":0.2601744185051176,"bottom":0.2688953487187197,"conf":0.5},{"text":"8. İl ambulans servisi komuta kontrol merkezi ve istasyonlarda görev yapan tüm","x0":0.20314882517122754,"x1":0.8358931311151513,"top":0.3050036928549458,"bottom":0.3249117925592644,"conf":1},{"text":"personelin hizmet içi eğitimleri tamamlanacaktır.","x0":0.22792608542924733,"x1":0.58110882158733,"top":0.32122093036648036,"bottom":0.3358974360503141,"conf":1},{"text":"9. 2007 yılı Bütçe Kanununda öngörülen hibe ambulansların temini konusunda ilinizde","x0":0.20314979540007036,"x1":0.835825759681736,"top":0.3400478337959537,"bottom":0.3587960405621964,"conf":1},{"text":"bulunan hayırseverler, işletmeler ve sivil toplum kuruluşları ile görüşülerek ihtiyacın","x0":0.22981380874859386,"x1":0.8338120321605875,"top":0.3536776956222871,"bottom":0.3722901562233113,"conf":1},{"text":"giderilmesi sağlanacak ve bu konuda gereken hassasiyet gösterilecektir. Hibe edilen","x0":0.2298949823103973,"x1":0.8337681832862512,"top":0.368291082400958,"bottom":0.38505115209319474,"conf":1},{"text":"ambulansların üzerinde; ambulansın tamamı hibe edilmişse ambulans arka kapı","x0":0.2299794608235155,"x1":0.8357289577816472,"top":0.3822674420084049,"bottom":0.3970085473081344,"conf":1},{"text":"üzerine veya her iki yan duvarında şerit alt kısmına yüksekliği 10 cm ve uzunluğu 50","x0":0.22989447009994768,"x1":0.8337494417123268,"top":0.39489262353095156,"bottom":0.4120932108769553,"conf":1},{"text":"cm'yi geçmeyecek şekilde hibe eden şahsın veya kuruluşun ismi ve varsa logosu ile","x0":0.22987440438111223,"x1":0.8337827356282783,"top":0.4081918566772964,"bottom":0.42590438617762194,"conf":1},{"text":"birlikte yer alabilecektir. Hibe ambulansın toplam bedelinin yarısını geçecek şekilde","x0":0.22987981707036204,"x1":0.8337591437027683,"top":0.42147195868533793,"bottom":0.438167068484715,"conf":1},{"text":"araç veya donanım olarak hibe alındığı takdirde, ambulans arka kapı üzerine veya her","x0":0.22997945987978757,"x1":0.8336755703388072,"top":0.43589743617257604,"bottom":0.45058139518799023,"conf":1},{"text":"iki yan duvarında şerit alt kısmına yüksekliği 5 cm ve uzunluğu 25 cm olacak şekilde","x0":0.229900265642324,"x1":0.833747783142513,"top":0.4490619010367781,"bottom":0.4662657716307701,"conf":1},{"text":"hibe eden şahsın veya kuruluşun ismi ve varsa logosu ile birlikte yazı veya ibare","x0":0.22987291858687764,"x1":0.8337594779222011,"top":0.46301432808013887,"bottom":0.4805157026753245,"conf":1},{"text":"bulunabilecektir.","x0":0.22960118717986297,"x1":0.3536412949530407,"top":0.4756036287485521,"bottom":0.49148659357560864,"conf":1},{"text":"10. Verilen ambulans hizmetleri için il ambulans servislerince vatandaşlarımızdan ücret","x0":0.20319581666211758,"x1":0.8337593888734236,"top":0.49645294149701713,"bottom":0.5130587246171969,"conf":1},{"text":"talep edilmeyecek, hiçbir sosyal güvencesi olmayan vatandaşlarımıza verilen","x0":0.2299794600660469,"x1":0.8336755705250667,"top":0.5115384614411046,"bottom":0.5261627905434496,"conf":1},{"text":"ambulans hizmetleri ücretsiz olarak sunulacak, herhangi bir sosyal güvenlik","x0":0.23191168242625898,"x1":0.8337701328211351,"top":0.5222694917011582,"bottom":0.5408304000920837,"conf":1},{"text":"kuruluşuna bağlı vatandaşlar için tahakkuk eden ambulans ücretleri kişinin bağlı","x0":0.2279260727577366,"x1":0.8336755697158684,"top":0.5392441858543768,"bottom":0.5523255815823332,"conf":1},{"text":"bulunduğu sosyal güvenlik kuruluşundan tahsil edilecektir. Il ambulans servisleri özel","x0":0.22997946002536943,"x1":0.8336755704843892,"top":0.5521367523986077,"bottom":0.5668604649611035,"conf":1},{"text":"sağlık kuruluşlarının ambulans ihtiyacını karşılamak amacıyla ambulans hizmet","x0":0.22997946006479633,"x1":0.8336755705238161,"top":0.5666666664175376,"bottom":0.58139534868286,"conf":1},{"text":"sözleşmesi yapamayacaklardır.","x0":0.2299794697115111,"x1":0.453798764171674,"top":0.5799145296213081,"bottom":0.5959302328715084,"conf":1},{"text":"Yukarıda yer verilen hususlara titizlikle riayet edilmesi, bu kapsamda yapılan çalışmalar","x0":0.20321617873114503,"x1":0.8337314837209424,"top":0.5988075633905319,"bottom":0.6161702558077745,"conf":1},{"text":"ve sonucundan Bakanlığımıza bilgi verilmesi, arlan görevleri yerine getirmeyenler ve görevini","x0":0.15187523957445012,"x1":0.8337426614730671,"top":0.6125879653545967,"bottom":0.6299687955161886,"conf":1},{"text":"aksatan personel ve yöneticiler hakkında idari işlem yapılacağı hususunda bilgilerinizi ve","x0":0.1540040932501318,"x1":0.8336755779793867,"top":0.6277777776615701,"bottom":0.6424418603109967,"conf":1},{"text":"gereğini önemle rica ederim.","x0":0.15380859355829862,"x1":0.35742261283920856,"top":0.63969182766146,"bottom":0.6556168503409765,"conf":1},{"text":"Prof. Dr. Recep AKDAG","x0":0.6301843651933967,"x1":0.8113094756028209,"top":0.7077221308242396,"bottom":0.7248358726744814,"conf":1},{"text":"Bakan","x0":0.6919917860429258,"x1":0.7453798765340764,"top":0.7223837210664673,"bottom":0.7354651159793175,"conf":1},{"text":"DAĞITIM:","x0":0.14778070655052453,"x1":0.24236303013456795,"top":0.7309459518089876,"bottom":0.7501586990404955,"conf":1},{"text":"Gereği için:","x0":0.15115809475155337,"x1":0.24097853220018642,"top":0.7451583974743776,"bottom":0.7631368146345422,"conf":1},{"text":"81 Il Valiligine","x0":0.15161906320605514,"x1":0.2651848425726003,"top":0.7600166432099011,"bottom":0.7753945298923952,"conf":1},{"text":"Bilgi için:","x0":0.14989732842463158,"x1":0.22792607996859224,"top":0.7747093025231353,"bottom":0.7877906974359854,"conf":1},{"text":"Teftiş Kurulu Başkanlığına","x0":0.14989733384007958,"x1":0.3490759718601257,"top":0.7876068375592357,"bottom":0.8023255812340111,"conf":1},{"text":"Hukuk Müşavirliğine","x0":0.15195071438032726,"x1":0.3080082174682486,"top":0.8008547012341415,"bottom":0.8154069765739038,"conf":1}]}