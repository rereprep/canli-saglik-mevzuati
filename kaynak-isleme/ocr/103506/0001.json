{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.44969198636365637,"x1":0.9630390170586571,"top":0.03760683761997996,"bottom":0.056837606850749234,"conf":1},{"text":"6.3.18. Kutanöz Leishmaniasis Genelgesi (2003/126)","x0":0.13131243785749797,"x1":0.7290820863068064,"top":0.11434335888001324,"bottom":0.13803438626862663,"conf":1},{"text":"T.C.","x0":0.5154004105994051,"x1":0.5482546199550097,"top":0.20784883728827563,"bottom":0.2223837207059105,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4722792622860583,"x1":0.5954825444866422,"top":0.21794871808681615,"bottom":0.23418803432613244,"conf":1},{"text":"Temel Sağlık Hizmetleri","x0":0.45995893327061177,"x1":0.6057494854122003,"top":0.22948717938064356,"bottom":0.24572649561995985,"conf":1},{"text":"Genel Müdürlüğü","x0":0.4804320452747629,"x1":0.5873297614971547,"top":0.24252788706711592,"bottom":0.25892560045932467,"conf":1},{"text":"SAYI :B100TSH0110002","x0":0.23613962998790142,"x1":0.39014373735132435,"top":0.27905982899242865,"bottom":0.2936046510006105,"conf":1},{"text":"KONU : Kutanöz Leishmaniasis","x0":0.23613962649380635,"x1":0.41683778602184446,"top":0.2905982902861325,"bottom":0.3052325579790245,"conf":0.5},{"text":"24.10.2003 16130","x0":0.46580051632186986,"x1":0.5978545142795907,"top":0.3213869036712569,"bottom":0.34140379316188985,"conf":1},{"text":"GENELGE","x0":0.5010266933074524,"x1":0.5646817255195495,"top":0.35901162808409093,"bottom":0.372093022996941,"conf":1},{"text":"2003/126","x0":0.5030800812923382,"x1":0.5605749493944061,"top":0.3764534885537494,"bottom":0.3895348834665995,"conf":1},{"text":"İLGİ: 25.06.1996 tarihli ve B100TSH0110002/6078 sayılı Genelgemiz.","x0":0.23613962747315825,"x1":0.6098562655239065,"top":0.40982906005207276,"bottom":0.42441860449505653,"conf":1},{"text":"Bilindiği gibi Leishmaniasis, Leishmania cinsi parazitler ile enfekte dişi kum sineklerinin (Tatarcık,","x0":0.27926077128669946,"x1":0.8275154093681497,"top":0.4273255815420527,"bottom":0.4418803421407814,"conf":1},{"text":"Phlebotomus) kan emmesi sırasında insanlara bulaştırdığı bir hastalıktır. İnsanlarda üç tip klinik tablo ile","x0":0.2381930247756417,"x1":0.82546200634022,"top":0.43888888889788946,"bottom":0.4534883719314201,"conf":1},{"text":"seyreden hastalığın Ülkemizde en çok görülen şekli Kutanöz Leishmaniais (KL) olup, Şanlıurfa, Osmaniye,","x0":0.23812783127919884,"x1":0.8276025289226956,"top":0.44964098111994777,"bottom":0.46553061351615677,"conf":1},{"text":"Adana, Hatay, Kahramanmaraş ve Mersin illerimizde endemik olarak görülmektedir.","x0":0.23613963847050395,"x1":0.6858316138899417,"top":0.46366279050508674,"bottom":0.4769230767873571,"conf":1},{"text":"Malům olduğu üzere, KL ile ilgili tanı ve tedavi kriterleri ile vektör ve çevreye yönelik hizmetler ilgi","x0":0.27926079041408364,"x1":0.8275153915939883,"top":0.47948717984123856,"bottom":0.49418604633492014,"conf":1},{"text":"genelgemiz ve ekinde gönderilen Kutanöz Leishmaniosis Kontrol Programı kapsamında verilen bilgiler","x0":0.23613963811129,"x1":0.8275153926740922,"top":0.49127906991362524,"bottom":0.5059829061101334,"conf":1},{"text":"çerçevesınde yürütülmektedir.","x0":0.23819301668758414,"x1":0.40041067927284146,"top":0.5058139534222548,"bottom":0.5159883721406417,"conf":1},{"text":"Ancak, ortayą çıkan bir takım gelişmeler ve bu gelişmeler neticesinde yapılan değerlendirmeler, ilgi","x0":0.27926077128684573,"x1":0.8275154093682962,"top":0.5203488373560395,"bottom":0.5350427349620007,"conf":1},{"text":"genelgemiz çerçevesinde yürütülen hizmetlere ilişkin yeni bir mütaläanın gerekliliğini ortaya koymuştur.","x0":0.23613962221641688,"x1":0.7864476467969792,"top":0.5319767443307727,"bottom":0.5465811962520238,"conf":1},{"text":"Bu meyanda, yeniden değerlendirilen, KL olgularında tanı ve tedavide yaklaşım ilkeleri ekte","x0":0.27720738401521205,"x1":0.8275154085957743,"top":0.5494186047971767,"bottom":0.5641025638125909,"conf":1},{"text":"gönderilmektedir.","x0":0.23594096681489393,"x1":0.3347182673162827,"top":0.561963133127396,"bottom":0.5750485277666313,"conf":1},{"text":"Bu nedenle, KL ile ilgili hizmetlerin ilişikteki bilgiler çerçevesinden yürütülmesi ve ilgi genelgemizin iptal","x0":0.2813141803393444,"x1":0.8254620085210251,"top":0.578488372062985,"bottom":0.5931623933029585,"conf":1},{"text":"edildiği hususlarında bilgilerinizi, keyfiyetin gereği için de ilgililere emirlerinizi rica ederim.","x0":0.23819301623648775,"x1":0.7084188935485911,"top":0.590116278871487,"bottom":0.6031976745994434,"conf":1},{"text":"EK:","x0":0.2361396306095104,"x1":0.2607802870496272,"top":0.6249999998186467,"bottom":0.6366279070418184,"conf":1},{"text":"Kutanöz Leishmaniasis Olgularında","x0":0.28131416925674474,"x1":0.47433264777945483,"top":0.6249999998702538,"bottom":0.6367521366223905,"conf":0.5},{"text":"Tanı ve Tedavide Yaklaşım (3 sf.)","x0":0.2810998084649704,"x1":0.4643306133142468,"top":0.6353282645012098,"bottom":0.6489695885037284,"conf":1},{"text":"Prof. Dr. Recep AKDAĞ","x0":0.6220122765233043,"x1":0.7578870974032024,"top":0.6748230725504881,"bottom":0.6909294580015848,"conf":1},{"text":"Sağlık Bakanı","x0":0.6405364562150369,"x1":0.7208598473371746,"top":0.6885752503254772,"bottom":0.7024131217139695,"conf":1},{"text":"DAGITIM:","x0":0.2361396310583414,"x1":0.29774127215863333,"top":0.7122093024999703,"bottom":0.7252906974128205,"conf":1},{"text":"A Plânı","x0":0.23606826253651436,"x1":0.2834389240956135,"top":0.7251446810158929,"bottom":0.7370646212470857,"conf":1},{"text":"DAİMİ GENELGE","x0":0.2361143137321075,"x1":0.33678096413749314,"top":0.7469953003130635,"bottom":0.760272140995786,"conf":1},{"text":"577","x0":0.895277207334518,"x1":0.9281314166901224,"top":0.9433139533236301,"bottom":0.9549418605468017,"conf":1}]}