top":0.3514481255642332,"bottom":0.36657512987790586,"conf":1},{"text":"Ilgi : 11/04/2020 tarihli ve 2018/12 sayılı Genelge","x0":0.25256673648248085,"x1":0.542094454266546,"top":0.3880341879350695,"bottom":0.39970930244445635,"conf":1},{"text":"Bilindiği üzere Bakanlığımız taşra teşkilatında ihalelere katılmaktan yasaklama iş ve","x0":0.2915811056058247,"x1":0.7597535964188159,"top":0.40982905984547213,"bottom":0.42008547010188235,"conf":1},{"text":"işlemleri Bakanlığımızın ilgide kayıtlı \"Ihalelere Katılmaktan Yasaklama Işlemleri\" konulu","x0":0.252566728633452,"x1":0.7597535998311167,"top":0.4200581394728249,"bottom":0.43034188024190945,"conf":1},{"text":"Genelgesi kapsamında yürütülmektedir.","x0":0.25256673551974246,"x1":0.4681724839834573,"top":0.4316239316853385,"bottom":0.44188034194174874,"conf":1},{"text":"Başkanlığımızca Bakanlık Makamına sunulan yasaklama oluru ve diğer yazışmalar","x0":0.2895277183240929,"x1":0.7597535956361962,"top":0.44316239298004045,"bottom":0.45348837214762006,"conf":1},{"text":"fıziki evrak kullanılmadan EBYS üzerinden yapılmakta, ihalelere katılmaktan yasaklama iş ve","x0":0.2525667285569451,"x1":0.7597535997546099,"top":0.4534188035302269,"bottom":0.4636752137866371,"conf":1},{"text":"işlemlerine karşa açılan davalarla ilgili olarak Mahkemeler tarafindan istenilen bilgi ve belgeler","x0":0.2525667285511048,"x1":0.7597535997487697,"top":0.4636627905716384,"bottom":0.47529069779481004,"conf":1},{"text":"EBYS'den çıktı alınup fiziki olarak mahkemelere gönderilmektedir. Bu kapsamda; mahkeme","x0":0.25256672856476003,"x1":0.7597535997624247,"top":0.47521367530599146,"bottom":0.48691860477191296,"conf":1},{"text":"süreçleri de dahil ihalelere katılmaktan yasaklama iş ve işlemlerinin tamamının elektronik","x0":0.25256672856996276,"x1":0.7597535997676275,"top":0.4867521366647669,"bottom":0.4970930233106139,"conf":1},{"text":"ortamda EBYS'den yapılması ve arşivlenmesi planlandığından, Hukuk Hizmetleri Genel","x0":0.2525667477047808,"x1":0.7597535820009,"top":0.49563953497426194,"bottom":0.5072674413823273,"conf":1},{"text":"Müdürlüğünden alınan görüş doğrultusunda, Başkanlığımız tarafindan düzenlenen 11/04/2018","x0":0.2525667285691281,"x1":0.7597535997667929,"top":0.5072649573576692,"bottom":0.5175213676140794,"conf":1},{"text":"tarihli ve 2018/12 sayılı \"Ihalelere Katılmaktan Yasaklama Işlemleri\" konulu Genelgenin \"C-","x0":0.25256672853822265,"x1":0.7597535997358875,"top":0.5174418603386178,"bottom":0.5290697675617895,"conf":1},{"text":"Yasaklamayı Gerektirir Durumların Idarelerce Bildirilmesi\" Bölümünün, \"4- Yasaklama","x0":0.25256672851976636,"x1":0.7597535997174311,"top":0.5290598291321295,"bottom":0.5406976745382949,"conf":1},{"text":"Taleplerinde Bakanlığımıza Gönderilmesi Gereken Bilgi Ve Belgeler\" maddesinin üçüncü","x0":0.252566728550295,"x1":0.7597535997479596,"top":0.540598290491587,"bottom":0.5508720930776779,"conf":1},{"text":"fikrasının birinci cümlesi aşağıdaki şekilde değiştirilmiştir.","x0":0.25256672912389794,"x1":0.5708418947970766,"top":0.5508547010393214,"bottom":0.5611111112957318,"conf":1},{"text":"\"Bu bağlanda, yasak fiil veya davranışın özelliğine göre, gerekli belgeler idarelerimiz","x0":0.2936344929081808,"x1":0.75975359722206,"top":0.5623931622672191,"bottom":0.5741279070972284,"conf":1},{"text":"sadece EBYS ye yüklenerek","x0":0.3181451638042907,"x1":0.5012116829730199,"top":0.5721829920528103,"bottom":0.5857543016885922,"conf":1},{"text":"olup fiziki olarak","x0":0.5893223842424812,"x1":0.714579052942177,"top":0.5739316240267975,"bottom":0.584302325629179,"conf":1},{"text":"gönderilmeyecektir. Bakanlığımıza gönderilecek işlem dosyası toplu tarama yapılarak","x0":0.25051334207476555,"x1":0.7618069862706545,"top":0.5841880341764097,"bottom":0.5944767442407679,"conf":1},{"text":"EBYS'ye yüklenmeyecektir. EBYS'de üst yazı eki olarak yüklenecek bilgi ve belgelerin ayrı ayrı","x0":0.25256672853363915,"x1":0.759753599731304,"top":0.5944444443184508,"bottom":0.604700854574861,"conf":1},{"text":"taranması, adlandırıiması (ihalelere katılmaktan yasaklama formu, sözleşme, idari şartname,","x0":0.25256674885988084,"x1":0.7577001966568881,"top":0.6046511628812387,"bottom":0.6162790692893041,"conf":1},{"text":"ihale komisyon kararı, sipariş yazıları, ihtarname vb. şeklinde adlandırılarak) ve EBYS 'ye aynı","x0":0.25256672856098966,"x1":0.7597535997586544,"top":0.6175213677181739,"bottom":0.6279069767988228,"conf":1},{"text":"ayrı yüklenilmesi gerekmektedir.\"","x0":0.2523904614529158,"x1":0.43962237172488905,"top":0.6263236777723442,"bottom":0.6392089010632034,"conf":1},{"text":"Bilgilerini ve konunun Müdürlüğünüze bağlı sağlık tesislerine duyurulması hususunda","x0":0.2894533806146857,"x1":0.7598226573325855,"top":0.636751336193957,"bottom":0.6502024828658717,"conf":1},{"text":"gereğini önemle rica ederim.","x0":0.25051334360619154,"x1":0.4086242331932249,"top":0.6495726495640434,"bottom":0.6628205128119067,"conf":1},{"text":"Prof. Dr. Muhammet GÜVEN","x0":0.5872689951869495,"x1":0.7577002037686549,"top":0.68750000000392,"bottom":0.705128205132125,"conf":1},{"text":"Bakan a","x0":0.6406570832698985,"x1":0.6981519513719664,"top":0.7034188033613727,"bottom":0.716666666609236,"conf":1},{"text":"Bakan Yardımcisi","x0":0.6201232030385814,"x1":0.7268993840208828,"top":0.7122093024623977,"bottom":0.7269230772494528,"conf":1},{"text":"DAĞITIM","x0":0.25658070834595814,"x1":0.31631456849559536,"top":0.7657747638039192,"bottom":0.7792833754666941,"conf":1},{"text":"St Il Valigi (l Saglak Modurlugo)","x0":0.2562864578805193,"x1":0.43978546316245887,"top":0.7780233191329906,"bottom":0.7998223756833671,"conf":0.5},{"text":"Bilgi:","x0":0.5318275153427316,"x1":0.5646817246983361,"top":0.7776162789765624,"bottom":0.7877906976949492,"conf":1},{"text":"B Plans","x0":0.5338809028890945,"x1":0.5749486651601868,"top":0.7848837210174121,"bottom":0.7979651159302623,"conf":1},{"text":"1083","x0":0.8295228380491749,"x1":0.8686291125075193,"top":0.87784533