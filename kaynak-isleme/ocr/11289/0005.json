f":1},{"text":"tamamen entegre olduğu var sayılır, HBYS ve AHBS'de tanımlı hekim çalışma cetveli ile çakışacak","x0":0.11284829711963207,"x1":0.8727662516994386,"top":0.8534223596482512,"bottom":0.8722382788570225,"conf":1},{"text":"yeni bir cetvel MHRS'ye gönderilmez.","x0":0.11074391917286815,"x1":0.4026147743912781,"top":0.8703954237862747,"bottom":0.8874426230388055,"conf":1},{"text":"1","x0":0.8583162216308978,"x1":0.8685831621986708,"top":0.9200581394930784,"bottom":0.9302325579269799,"conf":1}]}