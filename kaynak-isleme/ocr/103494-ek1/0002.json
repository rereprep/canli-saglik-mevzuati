{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"Kan yoluyla bulaşan hastalıklarım kontrol altına ahınması. kişiden kişiye bulaşmasının","x0":0.2750151374825331,"x1":0.8029881695378724,"top":0.261348550185565,"bottom":0.27686124973661763,"conf":1},{"text":"önlenmesi. bu tür hizmet veren yerlerde çalışan personelin konu ile ilgili olarak","x0":0.22992456633745004,"x1":0.8008715515107043,"top":0.2756523436778111,"bottom":0.28752829710759564,"conf":1},{"text":"bilgilendirilmesi ve bu tür yerlerden hizmet alan kişilerin bilinçlendirilmesi için konu ile ilgili","x0":0.22990403388414568,"x1":0.800902607418003,"top":0.2866764694888614,"bottom":0.29991270443091445,"conf":1},{"text":"gereken hassasiyetin gösterilmesi özel bir önem arz etmektedir.","x0":0.22997946798956775,"x1":0.616016425034988,"top":0.3008547009744744,"bottom":0.3125000001197735,"conf":1},{"text":"Konunun önemi dolayısıyla, bu tür yerlerde çalışan personelin kan yolu ile bulaşan","x0":0.27310061821172377,"x1":0.8028747408996204,"top":0.31395348817965196,"bottom":0.3270348839076085,"conf":1},{"text":"hastalıklar ve bu tür hastalıklardan korunma konusunda eğitilmesi, bu tür yerlere giden","x0":0.22779238626743017,"x1":0.8029891010261591,"top":0.3253256899842185,"bottom":0.3420811763339928,"conf":1},{"text":"müşterilerin bilinçlendirilmesi ve bu tür yerlerin periyodik olarak mevzuata uygun şekilde","x0":0.227831074538948,"x1":0.802961255811148,"top":0.3380629962368219,"bottom":0.35493561906094473,"conf":1},{"text":"denetlenmesi hususunda gereken hassasiyetin gösterilmesini rica ederim.","x0":0.2257257067777524,"x1":0.671638262809059,"top":0.35020548582469424,"bottom":0.36686325968213696,"conf":1},{"text":"Doç. Dr. Sefer AYCAN","x0":0.5811088275826869,"x1":0.7310061619478858,"top":0.40406976724321664,"bottom":0.41715116297117305,"conf":1},{"text":"Bakan a.","x0":0.6236471334022208,"x1":0.6844958030793648,"top":0.4161185943430574,"bottom":0.4292624695955448,"conf":1},{"text":"Müsteşar","x0":0.6257751963673163,"x1":0.6881534812321917,"top":0.4304211503580817,"bottom":0.4429330745474618,"conf":1},{"text":"Dağıtım:","x0":0.2258726898415338,"x1":0.2854209444427137,"top":0.4404069766002081,"bottom":0.45203488382337986,"conf":1},{"text":"A Plan","x0":0.2257684558655117,"x1":0.2773116259134424,"top":0.45180142733425166,"bottom":0.4638962469818859,"conf":1},{"text":"601","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}