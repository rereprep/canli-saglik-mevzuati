0109843435,"top":0.32264957302549413,"bottom":0.338662791016728,"conf":1},{"text":"ilgili çeşitli düzenlemelerin Anayasa başta olmak üzere mevzuatımızda yer almasına karşın","x0":0.15195072122926248,"x1":0.8254620095596358,"top":0.33846153866770967,"bottom":0.35319767426461257,"conf":1},{"text":"uygulamada çeşitli aksaklıklar yaşandığı bilinmektedir.","x0":0.15195072533350454,"x1":0.5503080013735967,"top":0.3529914526839568,"bottom":0.3677325579836863,"conf":1},{"text":"kişilerin bu ihtiyaçlarının durumlarına uygun ortamlarda, hızlı, verimli ve mağdur edilmeden","x0":0.15400409007627608,"x1":0.8254620288090828,"top":0.41133720911070926,"bottom":0.42441860483866556,"conf":1},{"text":"kuruluşlarının multisektörel bir anlayışla birlikte hareket etmesi gerekmektedir.","x0":0.15195071755833675,"x1":0.720739220630907,"top":0.440406976893162,"bottom":0.4551282050117975,"conf":1},{"text":"Bu nedenle, sağlık hizmetlerinin koruyucu ve önleyici boyutundan başlayarak sağlık","x0":0.20533882742942025,"x1":0.8254619929797906,"top":0.4679487180860904,"bottom":0.4841880343254066,"conf":1},{"text":"hizmeti veren tüm kuruluşlarımızca;","x0":0.15171684800793284,"x1":0.4150426787650463,"top":0.48196008778622823,"bottom":0.4979692017174766,"conf":1},{"text":"- Özürlü vatandaşlarımızın özürlü sağlık kurulu raporlarının, 16.07.2006 tarihli ve","x0":0.2011812801047494,"x1":0.8275749038719427,"top":0.5100899301095823,"bottom":0.5274365176574715,"conf":1},{"text":"sayılı Resmi Gazetede yayımlanarak yürürlüğe giren","x0":0.20533880185852815,"x1":0.6632443601759593,"top":0.5260683762727624,"bottom":0.5406976742628277,"conf":1},{"text":"Özürlülük Olçütü,","x0":0.6606687825244248,"x1":0.8264133841235313,"top":0.5222194205449635,"bottom":0.5424189288859131,"conf":1},{"text":"ekinde yer alan Ek-3 sayılı formda gösterilen formata uygun olarak ve Ek-4' te yer alan 'Ozür","x0":0.1519507035777515,"x1":0.8275154153087824,"top":0.5551282051258608,"bottom":0.5697674417064732,"conf":1},{"text":"Durumuna Göre Tüm Vücut Fonksiyon Kaybı Oranları Cetveli\"","x0":0.15600286318633888,"x1":0.7105322400638894,"top":0.5682864672693804,"bottom":0.5838673243751246,"conf":1},{"text":"doğrultusunda","x0":0.7144624657523158,"x1":0.8256720076358651,"top":0.5693297955780651,"bottom":0.5842132640755778,"conf":1},{"text":"düzenleneceğinden, özürlü vatandaşlara bu çerçevede rapor düzenlenmesi ve bu raporların da","x0":0.15400410924434027,"x1":0.8275153975747135,"top":0.5841880340422707,"bottom":0.597435897290134,"conf":1},{"text":"sadece yetkili sağlık kuruluşlarımızdan verilerek mağduriyetlerinin önlenmesi,","x0":0.15195071597093157,"x1":0.7166324460452779,"top":0.5987179483358014,"bottom":0.6149572645751177,"conf":1},{"text":"doğru olarak doldurulmasının sağlanması,","x0":0.1538975189880125,"x1":0.45804040752881325,"top":0.6411620764632164,"bottom":0.6555774873119807,"conf":1},{"text":"- Sağlık hizmetlerinin verildiği iç ve dış mekanların, özürlülerin kullandıkları araç-","x0":0.20123203383543573,"x1":0.8275153957846875,"top":0.670058139827884,"bottom":0.6860465109351974,"conf":1},{"text":"düzenlenmesi,","x0":0.15184305436106937,"x1":0.260887951585837,"top":0.7001685107481701,"bottom":0.7155291636391499,"conf":1},{"text":"- Sağlık kuruluşuna imkanlar ölçüsünde özürlü asansörü konulması,","x0":0.1990487709006371,"x1":0.6901427305014155,"top":0.7267313412370422,"bottom":0.7457195364770304,"conf":1},{"text":"- Özürlüler, gaziler, şehit ve gazi dul yetimleri, 65 yaşını doldurmuş muhtaç, güçsüz","x0":0.1990553750652533,"x1":0.8276574087241862,"top":0.755652831146943,"bottom":0.7761048414728395,"conf":1},{"text":"taninmasi,","x0":0.153862279634989,"x1":0.23012129302198406,"top":0.7887636241204091,"bottom":0.8013526549160364,"conf":1},{"text":"- Sağlık kuruluşlarında, özürlülerin ve yakınlarının kendilerine tanınan öncelikleri","x0":0.1929358790705511,"x1":0.8276074789326279,"top":0.8143596591590305,"bottom":0.8326944261012422,"conf":1},{"text":"belirten tabelaların kolayca görebilecekleri yerlere asılması,","x0":0.15166030999029,"x1":0.5855391244292448,"top":0.8269060832937005,"bottom":0.8489782069597954,"conf":1},{"text":"Sıhhiye/ANKARA Tel: 0 312 431 90 23 Faks: 0 312 431 59 15","x0":0.28131416372876245,"x1":0.6981519551624081,"top":0.9025641027030181,"bottom":0.9158119659508814,"conf":1}]}