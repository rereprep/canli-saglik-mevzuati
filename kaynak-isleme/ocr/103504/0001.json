{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4516651707223533,"x1":0.9610487540218358,"top":0.039295297797623974,"bottom":0.05678161248967284,"conf":1},{"text":"6.3.11. Kot Giysilere Uygulanan Püskürtme İşleminde Kum","x0":0.13127728649214548,"x1":0.7968433768649159,"top":0.10359243827059383,"bottom":0.12661308559668016,"conf":1},{"text":"Kullanımının Yasaklanması Genelgesi (2009/24)","x0":0.13141683188994824,"x1":0.6878850159678465,"top":0.1293604654726932,"bottom":0.1482905982489373,"conf":1},{"text":"T.C.","x0":0.501026694221847,"x1":0.5318275147719929,"top":0.2616279070639238,"bottom":0.2747093019767739,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.44353182935961444,"x1":0.591375768000315,"top":0.27307692319793486,"bottom":0.28633720948020525,"conf":1},{"text":"Temel Sağhk Hizmetleri Genel Müdürlüğü","x0":0.386036960484796,"x1":0.6468172488305203,"top":0.28632478647887905,"bottom":0.29957264972674225,"conf":1},{"text":"TSE-ISO-EN","x0":0.7657530973942863,"x1":0.8194625080928414,"top":0.2858179245323864,"bottom":0.29557742400889264,"conf":1},{"text":"9000","x0":0.7823408621928931,"x1":0.8028747433284393,"top":0.29505813944097703,"bottom":0.300872093052563,"conf":1},{"text":"Say: : B100TSH0100006-140-01/","x0":0.23389231080868558,"x1":0.44986759134899507,"top":0.3095934545960164,"bottom":0.32451759363514565,"conf":1},{"text":"Konu : Kot Giysilere Uygulanan Püskürtme Işleminde","x0":0.23203285116161246,"x1":0.5338809063911224,"top":0.3226495727478844,"bottom":0.3358974359957476,"conf":1},{"text":"Kum Kullanımının Yasaklanması","x0":0.2751540025752094,"x1":0.4620123216005835,"top":0.3341880341714907,"bottom":0.34447674423584873,"conf":1},{"text":"SANAYI VE TICARET","x0":0.3099202615194064,"x1":0.5381432203620795,"top":0.34769774577556634,"bottom":0.36493915038231206,"conf":1},{"text":"27.03.2009/ 9805","x0":0.6338738486728044,"x1":0.8406392045867346,"top":0.3317575596014086,"bottom":0.3569103382268969,"conf":1},{"text":"BAKANLIĞINA","x0":0.5580952427965685,"x1":0.7090086058646752,"top":0.349094418745157,"bottom":0.3670282544839014,"conf":1},{"text":"GENELGE","x0":0.4804928133496649,"x1":0.548254618559986,"top":0.3677325583075952,"bottom":0.37936046471566054,"conf":1},{"text":"2009/.2.4","x0":0.4845995902096077,"x1":0.5462012313098996,"top":0.3779069765628328,"bottom":0.3895348837860044,"conf":1},{"text":"Son yıllarda ülkemizde yapılan bazı tıbbi araştırma ve iştatiştikler, kot kumlama işinde,","x0":0.27709269331791747,"x1":0.8029267272885945,"top":0.3985604802349816,"bottom":0.41445074026300555,"conf":1},{"text":"çalışanlarda Silikozis hastalığının görülme sıklığında artış olduğunu göstermektedir. Basın yoluyla da -","x0":0.23197576771112205,"x1":0.8029481780492228,"top":0.4098662098778916,"bottom":0.42441271997112406,"conf":1},{"text":"sıkça gündere gelen bu sağlık sorunu Bakanlığımız tarafından uzun süredir bütün detaylan ile","x0":0.23203284991272488,"x1":0.7926078069888471,"top":0.4229651161534733,"bottom":0.4346153845940459,"conf":1},{"text":"incelenmektedir. Bu şartlarda, hastalığın mümkün olduğunca erken teşhis ve tedavisi, aymı ortam veya","x0":0.23203284989844242,"x1":0.7926078069745647,"top":0.434593023196878,"bottom":0.44487179467068927,"conf":1},{"text":"benzer koşullarda çalışanların tespiti ve gerekli önlemlerin zaman geçmeden alımması amacıyla","x0":0.23203284910574534,"x1":0.7905544196827556,"top":0.4461538461140502,"bottom":0.4564102563704604,"conf":1},{"text":"Bakanlığımızca 2008/62 sayılı Genelge (24.09.2008/29184) yayınlanmıştı","x0":0.23203286377132692,"x1":0.6365502993087551,"top":0.4563953486785972,"bottom":0.4666666668208279,"conf":1},{"text":"Silikozis hastalığından korunmanın tek geçerli ve etkili yolu kişi ve çevre maruziyetinin","x0":0.2731006359060082,"x1":0.7905544026976875,"top":0.4665697675324014,"bottom":0.47820512808715354,"conf":1},{"text":"engellenmesidir. Pek çok işkolunda hastalık riski bulunmasına karşılık, kumun püskürtme yöntemi ile","x0":0.22997946262491697,"x1":0.7926078062001513,"top":0.4781976742927362,"bottom":0.4898255815159078,"conf":1},{"text":"kullanılması hastalık riskini oldukça artırmaktadır.","x0":0.2299794627139889,"x1":0.507186861503382,"top":0.4897435897959951,"bottom":0.5000000000524053,"conf":1},{"text":"Kot beyazlatma (aşındırma, eskitme) işleminin kum püskürtülerek yapıldığı işyerlerinin ve","x0":0.2731006134472948,"x1":0.7905544171405197,"top":0.4999999998743738,"bottom":0.5116279070975456,"conf":1},{"text":"işçilerin nitelikleri dikkate alındığında bu işyerlerinde, işleme, uygulayan kişiye.ve çevreye yönelik","x0":0.22997946181101483,"x1":0.7905544188871371,"top":0.5115384616408559,"bottom":0.5218023256363998,"conf":1},{"text":"yeterli, etkili ve sürdürülebilir iş sağlığı ve güvenliği tedbirleri alınması mümkün görünmemektedir.","x0":0.22786310173519594,"x1":0.790598459792368,"top":0.5202068076056859,"bottom":0.5334625028019844,"conf":1},{"text":"Bir toplum sağlığı sorunu haline gelen hastalığın önlenmesi ve gerekli tedbirlerin alımmast zorunlu","x0":0.22997946181063733,"x1":0.7905544188867596,"top":0.5333333334164977,"bottom":0.54505813965596,"conf":1},{"text":"hale gelmiştir. Bu çerçevede, Bakanlığımızca gündeme alıman püskürtme işleminin kum","x0":0.2279260745127709,"x1":0.7905544180880052,"top":0.5435897435590991,"bottom":0.5552325582605381,"conf":1},{"text":"kullanılarak yapılması konusu, koruyucu sağlık hizmetleri kapsamında tüm yönleriyle bilim kurulu","x0":0.22792607451628427,"x1":0.7905544180915187,"top":0.5551282052587594,"bottom":0.5668604652373553,"conf":1},{"text":"vasıtasıyla incelenmiştir.","x0":0.2279260767211859,"x1":0.36755646936543845,"top":0.5666666666074461,"bottom":0.5770348837659675,"conf":1},{"text":"Bu çalışmalar neticesinde, bilim kurulu kararı, uluslararası sözleşmeler ve ulusal mevzuatımız","x0":0.2689938380505077,"x1":0.7885010282428444,"top":0.5769230771004915,"bottom":0.5886627908182211,"conf":1},{"text":"hükümleri dikkate alınarak; öncelikle her türlü kot giysi ve kumaşlara uygulanan püskürtme işleminde","x0":0.22792607383746394,"x1":0.7885010309135863,"top":0.5871794872404991,"bottom":0.5988372094202054,"conf":1},{"text":"kum (silis tozu) veya silika kristalleri içeren herhangi bir madde kullanılmast yasaklanmıştır. Kum","x0":0.22792607377200053,"x1":0.7885010308481228,"top":0.598717948534447,"bottom":0.6104651163988635,"conf":1},{"text":"kullanılan diğer iş kollanı ise, uygulanan yöntem, kristalize silika içeriği ve alıan tedbirler yönünden","x0":0.22792607371875026,"x1":0.7885010307948725,"top":0.6102564102352849,"bottom":0.6222222222010969,"conf":1},{"text":"Bakanlığımızca değerlendirilmekte ve sağlık sonuçları izlenmektedir.","x0":0.22792607824043493,"x1":0.6098562622876311,"top":0.6205128203749837,"bottom":0.6324786323407956,"conf":1},{"text":"¡Bilgilerinizi ve gereğini arz/rica ederim.","x0":0.2648870604026912,"x1":0.4948665328109628,"top":0.632267441731495,"bottom":0.6440170940397715,"conf":1},{"text":"Span","x0":0.6632443536419194,"x1":0.7843942493433912,"top":0.6671511627423137,"bottom":0.7093023253055398,"conf":0.30000001192092896},{"text":"Dr. Nihat TOSUN","x0":0.6814619516482082,"x1":0.7847354010305059,"top":0.7074773472245462,"bottom":0.7205549237721526,"conf":1},{"text":"Bakan a.","x0":0.6755646807512428,"x1":0.7268993847432814,"top":0.7222222222893554,"bottom":0.7311965812637143,"conf":1},{"text":"Müsteşar","x0":0.6755128155752526,"x1":0.7269512498116799,"top":0.7324261977902661,"bottom":0.7428644998222151,"conf":1},{"text":"DAĞITIM:","x0":0.22381930251364263,"x1":0.29158110772396373,"top":0.7427325582640899,"bottom":0.7558139531769401,"conf":1},{"text":"Gereği:","x0":0.2217659137088232,"x1":0.2689938400899447,"top":0.7543604652034586,"bottom":0.7674418601163088,"conf":1},{"text":"A Plam","x0":0.221765914747272,"x1":0.26694045001658834,"top":0.7658119657430766,"bottom":0.7777777777088886,"conf":1},{"text":"Çalışma ve Sosyal Güvenlik Bakanlığı","x0":0.22176591496516798,"x1":0.43942504992799486,"top":0.777616278873732,"bottom":0.7906976746016884,"conf":1},{"text":"Sanayi ve Ticaret Bakanlığı","x0":0.221765909544335,"x1":0.37782341263225633,"top":0.7892441859154411,"bottom":0.8008720931386129,"conf":1},{"text":"İçişleri Bakanlığı","x0":0.21964041655199457,"x1":0.32040064927675743,"top":0.7991364373742796,"bottom":0.8127821670260975,"conf":1},{"text":"473","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139536654862,"bottom":0.9563953485783364,"conf":1}]}