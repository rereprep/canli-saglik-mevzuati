{"lines":[{"text":"T.C.","x0":0.4845995897640251,"x1":0.5277207385342294,"top":0.049418604378075215,"bottom":0.06395348855433758,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.40862422562522144,"x1":0.6119096550942643,"top":0.06244653556593438,"bottom":0.07869974343590869,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.35523613141177335,"x1":0.667351137587616,"top":0.08126603914934694,"bottom":0.09751924701932135,"conf":1},{"text":"aktarımı kimin denetleyeceği (veri erişim komitesi, vb.), kişisel verileri toplama yöntemi ve","x0":0.125162857437474,"x1":0.8851050932342167,"top":0.12631248668670692,"bottom":0.14706790779247603,"conf":1},{"text":"hukuki sebebi, aktarım şekli (kamuya açık, kontrollü) ve ilgili kişilerin 6698 sayılı Kişisel","x0":0.12514643962483002,"x1":0.8851418874501777,"top":0.1444979451653341,"bottom":0.1659364728232403,"conf":1},{"text":"Verilerin Korunması Kanunu'nun 11 inci maddesinde sayılan diğer hakları gibi detayların","x0":0.12525667261373788,"x1":0.8850102677099062,"top":0.16552609061520762,"bottom":0.18177929848518204,"conf":1},{"text":"metinde yer alması zorunludur.","x0":0.12525667138372437,"x1":0.38193018673122475,"top":0.1860465113930454,"bottom":0.20059880236904193,"conf":1},{"text":"7) Kişisel genetik verilerin yurtiçinde paylaşımında 6698 sayılı Kişisel Verilerin","x0":0.184725077921839,"x1":0.8850961893845809,"top":0.2025429895346923,"bottom":0.22130407695718968,"conf":1},{"text":"Korunması Kanunu'nun 8 inci maddesine, yurtdışına paylaşımında ise aynı Kanunun 9 uncu","x0":0.12525669184196844,"x1":0.8870636365357033,"top":0.222383721306458,"bottom":0.23994867434280298,"conf":1},{"text":"maddesine riayet edilmesi zorunludur.","x0":0.12525666595718385,"x1":0.43942505863213854,"top":0.24123182175607194,"bottom":0.2572674417740577,"conf":1},{"text":"8) Toplumun genetik yapısını ilgilendiren verinin uluslararası paylaşıma açılmasında","x0":0.18473286440876688,"x1":0.8871305349470453,"top":0.25892005242347915,"bottom":0.277990123798064,"conf":1},{"text":"Kişisel Verileri Koruma Kurulunun izni alınmalıdır.","x0":0.12517232309458537,"x1":0.5503618937141063,"top":0.27773066328301876,"bottom":0.29517977466674905,"conf":1},{"text":"9) Tanı amacı ile işlenen genetik verilerin ve arşiv materyallerinin ikincil amaçlar için","x0":0.18480494190616736,"x1":0.8870636412241087,"top":0.29796511635051726,"bottom":0.31395348829176317,"conf":1},{"text":"işlenmesi ve veri paylaşımı yapılabilmesi için bireylerin tekrar bilgilendirilmesi ve açık","x0":0.12525669182123275,"x1":0.8870636365149677,"top":0.31686046549336555,"bottom":0.33447390907521346,"conf":1},{"text":"rızalarının alınması kapsamında zorunludur.","x0":0.1252566668978565,"x1":0.4887063724530447,"top":0.335755814007171,"bottom":0.35174418594841683,"conf":1},{"text":"10) Sağlık kuruluşlarının, kişisel sağlık verilerinin yurt içinde aktarımında Kişisel","x0":0.1848049418816926,"x1":0.887063641199634,"top":0.3545765608937397,"bottom":0.370829768763714,"conf":1},{"text":"Verilerin Korunması Kanunu'nun 8 inci maddesine riayet ederek kuruluş bünyesinde muhafaza","x0":0.127310060666669,"x1":0.8870636557628375,"top":0.37339606529507663,"bottom":0.38964927316505094,"conf":1},{"text":"edilen sağlık kayıtlarını Bakanlığımıza anlık olarak aktarması zorunludur. Sağlık hizmet","x0":0.12525667416364641,"x1":0.8891170422580388,"top":0.3924418605386606,"bottom":0.4084687767488776,"conf":1},{"text":"sunumunu hizmet alımı yoluyla gerçekleştiren sağlık kuruluşları ilgili yüklenici fırma veya","x0":0.12525669182586383,"x1":0.8870636365195987,"top":0.4113372093753894,"bottom":0.42732558131663523,"conf":1},{"text":"cihaz üreticileri tarafından elde edilen tüm veriler için de bu kural doğrultusunda işlem tesis","x0":0.12525667416664055,"x1":0.8891170422610329,"top":0.43023255821320916,"bottom":0.44622093015445496,"conf":1},{"text":"etmesi zorunludur.","x0":0.12508325731852168,"x1":0.2836660069678094,"top":0.44710247870728814,"bottom":0.46376512857496355,"conf":1},{"text