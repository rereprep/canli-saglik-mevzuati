7926078439504015,"x1":0.48254619541331023,"top":0.35029069781973776,"bottom":0.36337209273258786,"conf":1},{"text":"Alan Uygulaması","x0":0.28336755776903455,"x1":0.39425051174956,"top":0.3662393160809967,"bottom":0.37790697685124996,"conf":1},{"text":"26.03.2014","x0":0.6262488250530909,"x1":0.7515745826713411,"top":0.3240214498317612,"bottom":0.3445832011729696,"conf":1},{"text":"GENELGE","x0":0.4556903067389962,"x1":0.5299359764164353,"top":0.4282430068505847,"bottom":0.44094303963089776,"conf":1},{"text":"2014/13","x0":0.47008264363323626,"x1":0.5278639692076015,"top":0.4401468008310727,"bottom":0.45665552435903,"conf":1},{"text":"Ilgi: 27.01.2012 tarihli ve 3931 (2012/10) sayılı Genelge.","x0":0.1949626034412309,"x1":0.5380829523704366,"top":0.47522293430955376,"bottom":0.48992234692442516,"conf":1},{"text":"Bilindiği üzere, 21.01.2012 tarih ve 28180 sayılı Resmi Gazete'de yayımlanarak yürürlüğe giren","x0":0.23819302704413653,"x1":0.7843942417249294,"top":0.5115384616406258,"bottom":0.5218023256361697,"conf":1},{"text":"Sağlık Uygulama Tebliği'nde (SUT) Değişiklik Yapılmasına Dair Tebliğ ile acil servislerde yeşil alan","x0":0.19917864970232277,"x1":0.784394244767789,"top":0.521794871710973,"bottom":0.5334302326732784,"conf":1},{"text":"uygulaması kapsamında değerlendirilecek sağlık hizmetleri için katılım payı alınacağı hükme","x0":0.19917865079999084,"x1":0.7864476323645692,"top":0.5348837208714303,"bottom":0.5450581395898173,"conf":1},{"text":"bağlanmıştır. Bu kapsamda 520.021 Kodu ile tanımlanan \"Yeşil Alan Muayenesi\" uygulamasında","x0":0.1990953099625705,"x1":0.784505413074345,"top":0.542222443801126,"bottom":0.5585529101123282,"conf":1},{"text":"birlıginin saglanması bakımından uyulması gerekli esasların neler olduğu hususu 2012/10 sayılı","x0":0.19917865000320104,"x1":0.7843942450686673,"top":0.558119657984912,"bottom":0.5697674419816244,"conf":1},{"text":"Bakanlığımızca; \"Yeşil Alan Muayenesi\" uygulamasında birliğin sağlanması amacıyla aşağıda","x0":0.2422998023923442,"x1":0.786447630574025,"top":0.5799145298243424,"bottom":0.5915697675601885,"conf":1},{"text":"belirtilen hususlara bir kez de iş bu genelge ile açıkhk getirilmesinde fayda görülmüştür.","x0":0.19917863657597265,"x1":0.7022587347754135,"top":0.5914529915251816,"bottom":0.6031976745381847,"conf":1},{"text":"Yataklı Sağlık Tesislerinde Acil Servis Hizmetlerinin Uygulama Usul ve Esasları Hakkında","x0":0.24229980242776472,"x1":0.7864476306094454,"top":0.6029914528184168,"bottom":0.6149572647842287,"conf":1},{"text":"Tebliği eki Ek-7' de sarı ve kırmızı renk kodlaması altında yer alan tıbbi durumların dışında kalan","x0":0.19917865076459657,"x1":0.7864476323291749,"top":0.6148255812694056,"bottom":0.6264957264835189,"conf":1},{"text":"işlemlerin tümü yeşil renk kodu kapsamında değerlendirilecek olup, bu işlemler için SUT' da yer alan","x0":0.2012320380819196,"x1":0.7864476331473859,"top":0.6264534882466082,"bottom":0.6380813954697798,"conf":1},{"text":"520.021 Kodu ile tanımlanan; Yeşil alan muayenesi girilecektir.","x0":0.19908585052492675,"x1":0.5627286618676943,"top":0.6363332288585418,"bottom":0.649241698572193,"conf":1},{"text":"Acil servislere başvuran tüm hastaların ilk müracaatta acil hasta olarak değerlendirilerek acil","x0":0.2422998016437055,"x1":0.7843942433262743,"top":0.649572649703407,"bottom":0.6598837209851661,"conf":1},{"text":"servisiere kabul edilmesi ve buna göre işiem yapılması esastır. Ancak yapılan muayenesi sonucunda","x0":0.1991786499612734,"x1":0.7843942450267397,"top":0.6613372091760679,"bottom":0.6730769228937975,"conf":1},{"text":"hekim değerlendirmesine göre yeşil alan muayenesi kapsamına girdiği belirlenen hastalar için 520.021","x0":0.19917865000061588,"x1":0.7843942450660821,"top":0.6729651162203719,"bottom":0.6833333333788932,"conf":1},{"text":"Kodu ile tanımlanan \"Yeşil Alan Muayenesi\", kodlama işleminin yapılması gerekmektedir. Bu","x0":0.19908606030448353,"x1":0.7844808123733318,"top":0.6817271319344359,"bottom":0.6967837290001577,"conf":1},{"text":"kodlama işlemi, hastanın acil servisteki işlemleri tamamlandıktan sonra yapılmalıdır.","x0":0.19910456065176296,"x1":0.6797494786299597,"top":0.6939583053582412,"bottom":0.7066650611349318,"conf":1},{"text":"Ilgi sayılı Genelgenin yürürlükten kaldırıldığı ile uygulamanın yukarıda vurgulanan esaslara","x0":0.24229980073083718,"x1":0.7823408559142939,"top":0.7063953487762055,"bottom":0.7166666665108831,"conf":1},{"text":"uygun olarak yürütülmesi gerektiğinin, ilgili tüm sağlık kurum ve kuruluşlarına tebliğini önemle rica","x0":0.19917865040539237,"x1":0.7823408589717467,"top":0.7165697676229721,"bottom":0.7269230768956729,"conf":1},{"text":"ederim.","x0":0.19917864366269133,"x1":0.24435318354470087,"top":0.7296511627638385,"bottom":0.7383720929774407,"conf":1},{"text":"Prof. Dr. Nihat TOSUN","x0":0.6016427078514845,"x1":0.7618069839376298,"top":0.77307692326841,"bottom":0.7850427352342221,"conf":1},{"text":"Bakan a.","x0":0.6503557012831657,"x1":0.7129382269769737,"top":0.787443860134225,"bottom":0.799635128859498,"conf":1},{"text":"Müsteşar","x0":0.6524977103284009,"x1":0.7168404581931298,"top":0.80148609909357,"bottom":0.8124405590093832,"conf":1},{"text":"DAGITIM:","x0":0.19706982897647132,"x1":0.27110265515218407,"top":0.8152288440335512,"bottom":0.8272130162677196,"conf":1},{"text":"Gereği:","x0":0.19710161953507918,"x1":0.25259037201781515,"top":0.828423824971761,"bottom":0.838727337773233,"conf":1},{"text":"81 11 Valiligine","x0":0.1968748928584731,"x1":0.285754931321692,"top":0.8378911436537538,"bottom":0.8498193164581054,"conf":1},{"text":"(Il Sağhk Müdürlüğü)","x0":0.19507186857061845,"x1":0.32648870599303664,"top":0.8502906975330362,"bottom":0.8619658120424231,"conf":1}]}