{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4496919876340192,"x1":0.96303901832902,"top":0.03760683777271745,"bottom":0.05683760700348661,"conf":1},{"text":"6.3.34. Trişinelloz Genelgesi (2004/28)","x0":0.12320327664720435,"x1":0.5770020619664116,"top":0.1132478632422459,"bottom":0.13675213674651943,"conf":1},{"text":"SAĞLIK BAKANLIĞIÙ","x0":0.4454135460170105,"x1":0.5915474393632781,"top":0.2059817530625908,"bottom":0.23733220023640222,"conf":1},{"text":"Temel Sağlık Hizmetleri","x0":0.4394250470790614,"x1":0.5954825501669827,"top":0.23401162770459227,"bottom":0.24709302343254858,"conf":1},{"text":"Genel Müdürlüğü","x0":0.45585215678863783,"x1":0.5770020524901096,"top":0.2485465117644141,"bottom":0.2632478635170621,"conf":1},{"text":"SAYI : B100TSH0110002","x0":0.1704312092052189,"x1":0.35523614173148105,"top":0.26581196551596253,"bottom":0.2850427347467318,"conf":1},{"text":"KONU : Trişinelloz","x0":0.17246075196356783,"x1":0.3039252846335393,"top":0.2804332876404232,"bottom":0.29805508440326456,"conf":0.5},{"text":"05.03.2004","x0":0.4435318277228492,"x1":0.5277207387641459,"top":0.33430232556401407,"bottom":0.3517441859912185,"conf":1},{"text":"03557","x0":0.5318275160686083,"x1":0.5934291571689002,"top":0.3343023254550024,"bottom":0.3517441858822068,"conf":1},{"text":"GENELGE","x0":0.48249082973505625,"x1":0.5524167675952154,"top":0.38213382080791547,"bottom":0.3969359465919826,"conf":1},{"text":"2004 / 28","x0":0.4866294003259388,"x1":0.5482781969886812,"top":0.39527724431312905,"bottom":0.40559484867150863,"conf":1},{"text":"Hayvanlardan insanlara geçen ve zoonozlar olarak bilinen hastalıkların iki yüzün üzerinde olduğu","x0":0.2217659035737737,"x1":0.8624230079183551,"top":0.42863247882933586,"bottom":0.4418803420771992,"conf":1},{"text":"Dünya Sağlık Teşkilatı tarafından bildirilmekte ve bu hastalıklara yenileri eklenerek sayıları sürekli artmaktadır.","x0":0.17248460848969444,"x1":0.8624229888129638,"top":0.44186046526545486,"bottom":0.456410256161357,"conf":1},{"text":"Hatalı beslenme alışkanlıkları, alt yapı eksıklikleri, sosyo-ekonomik ve sosyo-kültürel düzeydeki problemler","x0":0.17248460849815717,"x1":0.8624229888214265,"top":0.4563953489865644,"bottom":0.4709401709947463,"conf":1},{"text":"nedeniyle ülkemizde de oldukça önemli bir halk sağlığı problemi olmaya devam eden zoonoz hastalıkların","x0":0.17248460850203332,"x1":0.8624229888253025,"top":0.47093023236650344,"bottom":0.48418803420491363,"conf":1},{"text":"oldukça önemli bir kısmını ise zoonoz parazitozlar oluşturmaktadır. Son zamanlarda ciddi bir epidemi şeklinde","x0":0.1724846085027268,"x1":0.862422988825996,"top":0.48401162771542916,"bottom":0.49709302344338546,"conf":1},{"text":"ortaya çıkarak bu halkaya eklenen trişınelloz hastalığı da ülkemizdeki parazit ve gıda kaynaklı zoonozlardan","x0":0.17248460850271535,"x1":0.8624229888259847,"top":0.49854651143633477,"bottom":0.5116279071642912,"conf":1},{"text":"Bakanlığımızca, trişinelloz pidemisi durumunda gerek vaka yönetiminin uygun bir şekilde sağlanması","x0":0.22176590356896808,"x1":0.8624230079135494,"top":0.5319767439942079,"bottom":0.5450581397221643,"conf":1},{"text":"gerekse vakalara zamanında müdahale edilerek doğru bir şekilde tedaviye alınması amacıyla \"Trişinelloz","x0":0.17248461543384774,"x1":0.8624229957571171,"top":0.5448717948038446,"bottom":0.5595930229224803,"conf":1},{"text":"Vakalarında Yaklaşım\" adlı doküman ile \"Trişinelloz Vaka Bildirim Çizelgesi\" hazırlanarak ilişikte sunulmuştur.","x0":0.17248460034172292,"x1":0.8542094346685443,"top":0.5581196584876948,"bottom":0.5726744182713174,"conf":1},{"text":"Bu nedenle, trişinelloz vakalarında ilışikte gönderilen bılgıler doğrultusunda hareket edilmesi, söz","x0":0.2217659035761927,"x1":0.862423007920774,"top":0.5799145301017223,"bottom":0.5944767440320317,"conf":1},{"text":"konusu bilgılerin bütün sağlık kurum ve kuruluşlarına ulaştırılmasının sağlanması, konuya ilişkin olarak halkın","x0":0.17248460849883523,"x1":0.8624229888221044,"top":0.593023255963323,"bottom":0.6076923075004699,"conf":1},{"text":"sağlanması hususlarında bilgilerinizi ve keyfiyetin gereği için ilgililere emirlerinizi arz ve rica ederim.","x0":0.1724845991320284,"x1":0.7905544150848323,"top":0.6205128202440726,"bottom":0.635174418449639,"conf":1},{"text":"Prof. Dr. Necdet ÜNÜVAR","x0":0.5749486620990227,"x1":0.733059551686056,"top":0.693162393407549,"bottom":0.7107558138763929,"conf":1},{"text":"Bakan a.","x0":0.6283367553996154,"x1":0.6878850100007954,"top":0.7076923078244547,"bottom":0.7239316240637709,"conf":1},{"text":"Müsteşar","x0":0.6283367555536195,"x1":0.6878850101547994,"top":0.720930232208322,"bottom":0.7369186049458478,"conf":1},{"text":"EKLER:","x0":0.17248460032417048,"x1":0.2279260773144332,"top":0.7383720929550024,"bottom":0.7558139533822068,"conf":1},{"text":"EK-1. Trişinelloz Vakalarında Yaklaşım (9 sf.)","x0":0.17043121413974335,"x1":0.43942504848191577,"top":0.7572649574284707,"bottom":0.7747863249498381,"conf":1},{"text":"Ek-2. Tişinelloz Vaka Bildirim Çizelgesi (1 sf.)","x0":0.17248460296276955,"x1":0.44353182380405387,"top":0.7703488372172191,"bottom":0.7877906976444234,"conf":1},{"text":"DAĞITIM:","x0":0.17043121230329256,"x1":0.23819301751361366,"top":0.7950581395175025,"bottom":0.8124999999447068,"conf":1},{"text":"A Plânı","x0":0.17043121043631218,"x1":0.22176591442835092,"top":0.8081196581228075,"bottom":0.8241279072263211,"conf":1},{"text":"DAIMÌ GENELGE","x0":0.17246212691581236,"x1":0.28133664047963963,"top":0.8327787103141976,"bottom":0.8503608244442014,"conf":1},{"text":"639","x0":0.8932238199081054,"x1":0.9301848045682806,"top":0.9418604652034586,"bottom":0.9549418601163088,"conf":1}]}