{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4496919868389139,"x1":0.9609856310348028,"top":0.04059829029136153,"bottom":0.05523255798425353,"conf":1},{"text":"T.C.","x0":0.28131416858578234,"x1":0.3059548250258991,"top":0.24273255810056327,"bottom":0.2514534883141655,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.25667350930744254,"x1":0.3470225890714616,"top":0.24999999986148636,"bottom":0.2616279070846581,"conf":1},{"text":"Temel Sağlik Hizmetleri Genel Müdürlüği","x0":0.20739220006300194,"x1":0.3819301816429313,"top":0.2585470084351009,"bottom":0.27051282040091285,"conf":1},{"text":"6. Tedavi","x0":0.20319767221178656,"x1":0.2834553047798507,"top":0.2948552897167964,"bottom":0.31270284971905005,"conf":1},{"text":"Trişinellozis tedavi edilebilen gıda kaynaklı zoonoz bir parazitozdur. Ancak,","x0":0.24640657130714386,"x1":0.8193018473779381,"top":0.3183139531632032,"bottom":0.33430232590072906,"conf":1},{"text":"hastalık genelde kaslara yerleştikten sonra tanındığından, bu durumlarda daha çok","x0":0.20328541887178614,"x1":0.8172484618263658,"top":0.3328488368843594,"bottom":0.34883720962188525,"conf":1},{"text":"destek tedavisi ön plâna çıkmaktadır. Genel durumu iyi olmayan hastaların tedavileri","x0":0.20739219346124713,"x1":0.8172484634176029,"top":0.34871794887685714,"bottom":0.36196581212472045,"conf":1},{"text":"yatırılarak sürdürülmelidir.","x0":0.20739219801020553,"x1":0.4004106765329156,"top":0.36482558126486775,"bottom":0.3764957264789811,"conf":1},{"text":"Tedavide antihelmintik olarak benzimidazol grubu ilâçlar kullanılmaktadır;","x0":0.2504524688384345,"x1":0.8173228664776803,"top":0.38203444815352916,"bottom":0.39929830567712943,"conf":1},{"text":"bunlar,","x0":0.20739219693101602,"x1":0.26078028742216675,"top":0.3997093021732979,"bottom":0.41133720939646956,"conf":1},{"text":"tiyabendazol,","x0":0.25857666265511864,"x1":0.37181348319434177,"top":0.3975752626547795,"bottom":0.4120177602994485,"conf":0.5},{"text":"mebendazol ve albendazoldür. Klinik değerlendirmeler","x0":0.3696098635596095,"x1":0.8172484524799353,"top":0.3982558141003232,"bottom":0.4128205124744926,"conf":1},{"text":"yapıldıktan sonra söz konusu ilâçlar,","x0":0.20533880468976728,"x1":0.5277207433611699,"top":0.4127906974795843,"bottom":0.42606837609153525,"conf":1},{"text":"trişinellozisin değişik safhalarında","x0":0.5236139660304319,"x1":0.817248456812721,"top":0.41279069781488564,"bottom":0.42735042730133477,"conf":1},{"text":"kullanılabilirler. Endikasyonu uygun görülürse, kontrollü olarak, glukokortikoidler de","x0":0.20533882815938365,"x1":0.817248447713306,"top":0.4273255816883491,"bottom":0.44331395279566244,"conf":1},{"text":"kullanılabilmektedir.","x0":0.20490376652335598,"x1":0.3537289449349481,"top":0.4404989861688675,"bottom":0.4580675271495407,"conf":1},{"text":"Her üç ilâç da gebelikteki kullanımları açısında güvenlik düzeyi \"C\" olan","x0":0.24840083918733816,"x1":0.8173130731419558,"top":0.4620187574810062,"bottom":0.47932939721291046,"conf":1},{"text":"ilâçlardır.","x0":0.20309140466118106,"x1":0.2796410822966599,"top":0.4775804206021461,"bottom":0.49190231512557103,"conf":1},{"text":"6.1. Mebendazol","x0":0.24845995821556752,"x1":0.3778234091388737,"top":0.5145299146331008,"bottom":0.527777777880964,"conf":0.5},{"text":"Mebendazolün trişinellozisteki dozu, Italya'da bulunan Uluslararası","x0":0.2956002101837386,"x1":0.817338652324477,"top":0.5322759657027234,"bottom":0.5493667745385274,"conf":1},{"text":"Trichinella Rereferans Merkezi uzmanları tarafından 25 mg/kg miktarındaki","x0":0.2546201196904434,"x1":0.8172484632656777,"top":0.5494186044591897,"bottom":0.5625000001871461,"conf":1},{"text":"günlük dozun 3-4'e bölünerek iki hafta süreyle verilmesi, ciddi enfeksiyonlarda","x0":0.2484599578066307,"x1":0.817248460879201,"top":0.5639534885210188,"bottom":0.5786324786487127,"conf":1},{"text":"ise 5 gün sonra tedavinin tekrarlanması şeklinde önerilmektedir. Enfeksiyonun","x0":0.25051334509325573,"x1":0.817248461666714,"top":0.5784883719005949,"bottom":0.5915697676285513,"conf":1},{"text":"birinci haftasından önce tedaviye başlanması söz konusu ise günlük doz 15","x0":0.24845995781425065,"x1":0.8172484608868209,"top":0.5930232559627624,"bottom":0.6076923074999093,"conf":1},{"text":"mg/kg olarak ayarlanabilmektedir.","x0":0.24845996285232816,"x1":0.4969199137526078,"top":0.608974358948547,"bottom":0.6235465114694033,"conf":1},{"text":"Trişinellozisteki, diğer bilimsel kaynaklarda verilen veya uzmanlarca","x0":0.2955824138098853,"x1":0.817342627862466,"top":0.626155111383785,"bottom":0.6444824853122789,"conf":1},{"text":"önerilen mebendazol kullanımları ise:","x0":0.25256673294558796,"x1":0.5092402482930883,"top":0.6438953487728601,"bottom":0.6542735041143753,"conf":1},{"text":"• Hastalığın akut döneminde (gastrointestinal dönem) günde 200-400","x0":0.31416836968878065,"x1":0.8172484678882215,"top":0.6641025639289697,"bottom":0.6787790696128034,"conf":1},{"text":"mg dozunda 3-5 gün süreyle verildikten sonra, dozun 400-500","x0":0.33880903570840404,"x1":0.8172484590169554,"top":0.6786324782867291,"bottom":0.6948717945260454,"conf":1},{"text":"mg/gün şeklinde düzenlenerek 10 gün verilmesi,","x0":0.33880903692049347,"x1":0.6776180675847921,"top":0.6947674420067295,"bottom":0.7094017096996214,"conf":1},{"text":"• Günde iki kez 100 mg miktarında 3 gün verilmesini takiben, 3-4","x0":0.31416836968962575,"x1":0.8172484678890666,"top":0.714957265030098,"bottom":0.7296511626360593,"conf":1},{"text":"hafta içinde bir iyileşme olmazsa aynı uygulamanın tekrarlanması,","x0":0.33880902996191387,"x1":0.8028747477766811,"top":0.729487179517982,"bottom":0.7427350427658452,"conf":1},{"text":"• Bir diğer seçenek ise 200 mg mebendazolün 5 gün süreyle verilmesi","x0":0.31410804830797473,"x1":0.8193769247769516,"top":0.7485161553796167,"bottom":0.7656051400076256,"conf":1},{"text":"şeklindedir.","x0":0.338712585911219,"x1":0.427414011668852,"top":0.763893724770998,"bottom":0.7784972107913389,"conf":1},{"text":"Yan etki olarak aşırı duyarlılık olabileceğinin bildirildiği mebendazolün","x0":0.293634496739826,"x1":0.8172484599303868,"top":0.7848837210789615,"bottom":0.7995726497972023,"conf":1},{"text":"gebelikte kullanımı ile ilgili bilgiler henüz saptanmamıştır. Karaciğer problemi","x0":0.25051337002030627,"x1":0.8172484496922191,"top":0.799418604651133,"bottom":0.8124999995639832,"conf":1},{"text":"olan hastalarda gerekli doz ayarlaması yapılmalıdır. Ayrıca, iki yaşın altındaki","x0":0.2483771906974919,"x1":0.8173400535725297,"top":0.8130732128131425,"bottom":0.8304649572474666,"conf":1},{"text":"çocuklara mebendazol verilmez, bu yaşın üzerindeki çocuklara erişkin dozu","x0":0.24845995780870062,"x1":0.8172484608812709,"top":0.8299145301011591,"bottom":0.8444767440314684,"conf":1},{"text":"647","x0":0.8952772069769632,"x1":0.9301848051380264,"top":0.9433139533309585,"bottom":0.9549418605541302,"conf":1}]}