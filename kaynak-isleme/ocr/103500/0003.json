vliler hastalık hakkında bilgilendirilecektir.","x0":0.20308196947477472,"x1":0.8113209553966875,"top":0.3934496383245627,"bottom":0.41287327147614694,"conf":1},{"text":"11. Sağlık personeli herhangi bir riskli temas durumunda Enfeksiyon Hastalıkları Uzmanına","x0":0.17643474308907883,"x1":0.8215419524111767,"top":0.4204219834770029,"bottom":0.4395378031635011,"conf":1},{"text":"yönlendirilecektir.","x0":0.20123203205881152,"x1":0.3326488694812297,"top":0.43459302322577553,"bottom":0.4491279066434104,"conf":1},{"text":"12. Bunun yanı sıra, Birinci Basamak Sağlık Kuruluşlarındaki tüm çalışanların KKKA","x0":0.17643761055783572,"x1":0.8174229172480565,"top":0.4611979356969591,"bottom":0.4806199223339116,"conf":1},{"text":"şüpheli vakalara yaklaşım konusundaki eğitimleri devam edecek, bu hastalara müdahale","x0":0.2011283319214173,"x1":0.819434465371576,"top":0.47512362539101316,"bottom":0.49296251918358136,"conf":1},{"text":"ederken standart korunma önlemlerinin alınması sağlanacaktır. Bu amaçla Sağlık","x0":0.20316334865899952,"x1":0.8194395649929815,"top":0.48906499307498796,"bottom":0.5055168816892187,"conf":1},{"text":"Müdürlükleri tarafindan yeterli miktarda koruyucu malzeme temin edilmeye devam","x0":0.20313455052482554,"x1":0.8194555284334939,"top":0.5021732519754821,"bottom":0.519427620032081,"conf":1},{"text":"edilecektir.","x0":0.20080981661536448,"x1":0.28391754927518065,"top":0.5156064697857158,"bottom":0.5307368192954522,"conf":1},{"text":"13. Hasta ve hasta yakınlarına KKKA hastalığı, bulaşma yolları ve korunma tedbirleri","x0":0.1764370351177629,"x1":0.8173916397221311,"top":0.5430099094210091,"bottom":0.5626625629765939,"conf":1},{"text":"konusunda bilgi verilecektir.","x0":0.19892822001825566,"x1":0.4007218491583139,"top":0.5558495180921232,"bottom":0.5724277196469026,"conf":1},{"text":"14. KKKA hastalığından korunma yolları ve hastalıktan şüphelenilmesi durumunda yapılması","x0":0.17645496140585437,"x1":0.8173845467623764,"top":0.5839686610838707,"bottom":0.6021101500312908,"conf":1},{"text":"gereken işlemler konusunda toplumun bilgilendirilmesi ve bilinçlendirilmesi amacıyla","x0":0.20111717729616238,"x1":0.8194075168848489,"top":0.5981790061939629,"bottom":0.6164105268874892,"conf":1},{"text":"yürütülen eğitim çalışmalarına arttırılarak devam edilecekir.","x0":0.19910431870882214,"x1":0.612012722873442,"top":0.6122858290963547,"bottom":0.6279519283838605,"conf":1},{"text":"Belirtilen bu hususlara titizlikle uyulması, Kırım-Kongo Kanamalı Ateşi hastalığıyla ilgili","x0":0.176459861786727,"x1":0.8173656087448588,"top":0.6393995269822506,"bottom":0.6587460820563066,"conf":1},{"text":"bütün uygulamaların Bakanlığımızca yayımlanan genelge ve talimatlar doğrultusunda","x0":0.1744321946367521,"x1":0.8152896005702844,"top":0.6540315831731672,"bottom":0.6698572117961514,"conf":1},{"text":"yürütülmesi hususlarında bilgilerinizi ve gereğini önemle rica ederim","x0":0.1745379852200607,"x1":0.6447638625321639,"top":0.6670940174682912,"bottom":0.6816860463551352,"conf":1},{"text":"Prof. Dr Recep AKDAG","x0":0.6053633571064092,"x1":0.7785240069514817,"top":0.7361928060328571,"bottom":0.7539947290510925,"conf":1},{"text":"Bakan","x0":0.6672732422232072,"x1":0.7167103303650579,"top":0.7527404071754055,"bottom":0.7647014532149542,"conf":1},{"text":"EK:","x0":0.1745379872486423,"x1":0.20944558540970545,"top":0.7747093019418363,"bottom":0.7906976746793623,"conf":1},{"text":"1- Vaka yönetimi algoritması","x0":0.17453799453357452,"x1":0.37987679205095665,"top":0.7863247864706205,"bottom":0.8052325576219105,"conf":1},{"text":"DAĞITIM:","x0":0.17237667267989362,"x1":0.2588348258106798,"top":0.8137051281461082,"bottom":0.8330971971231381,"conf":1},{"text":"81 İl Valiligine","x0":0.1723354733623878,"x1":0.28557007058349476,"top":0.8294475074917042,"bottom":0.8478780730567644,"conf":1},{"text":"633","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}