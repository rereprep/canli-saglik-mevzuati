3424341,"bottom":0.5054471778996215,"conf":1},{"text":"sorunuyla karşı karşıya bırakacaktır.","x0":0.21541461054934774,"x1":0.49504398692503737,"top":0.5075104293324738,"bottom":0.5209781043214405,"conf":1},{"text":"AİDS'li vakalar, genellikle klinik belirtileri ortaya çıkmiş olenlarda ve","x0":0.24412415550588595,"x1":0.7929212832076694,"top":0.5204492400552848,"bottom":0.5408777639095975,"conf":1},{"text":"şüpheli gahıslarda yaptırılan ELİZA testi !le saptanmaktadır. Halbuki sağlıklı","x0":0.21325130144385773,"x1":0.8010626619241328,"top":0.5378897006191596,"bottom":0.5590427642710026,"conf":1},{"text":"görünümde olup AIDS virüsu taşıyan birçok kişi mevcuttur. Buda hem kendileri","x0":0.21328756465469026,"x1":0.7867159942548074,"top":0.5580042497567117,"bottom":0.5773059601300278,"conf":1},{"text":"hem de toplum için büyük bir tehlikedir.","x0":0.21340286196493674,"x1":0.5176125423030847,"top":0.5821798346980895,"bottom":0.5956429071895968,"conf":1},{"text":"Bu nedenle Bakanlığımızca özellikle turizm yönünden hareketli olun bölge ve","x0":0.24408300205552919,"x1":0.8093220930730436,"top":0.5958810906859003,"bottom":0.615461843718878,"conf":1},{"text":"Illerde olmak izere pilot uygulama ile sondajlama ve tarama niteliğinde açašana","x0":0.21335229046255466,"x1":0.809293098317093,"top":0.6153644604927706,"bottom":0.6352954141462203,"conf":1},{"text":"belirtildiği gekilde bir çalışma yapılmasına gerek duyulmuştur.","x0":0.21333205762625668,"x1":0.6901568169100951,"top":0.6352382130095376,"bottom":0.6539441499956947,"conf":1},{"text":"a) Hastanelerimize ayaktan muayene ve tedavi için müracant edenlerle, yatarak","x0":0.2441311265639674,"x1":0.8256960517335374,"top":0.652464221188639,"bottom":0.6721480329958639,"conf":1},{"text":"tedavi görecek hastalardan istenecek kan tetkiklerinde Eliza testi rutin olarak","x0":0.2153535998348139,"x1":0.8093182192234172,"top":0.6716635974626339,"bottom":0.691314382794686,"conf":1},{"text":"yaptirılacaktar. (Diş polikliniğine çekim ve cerrahi müdahale için gelenler dahil]","x0":0.2132752567711487,"x1":0.8298912256345102,"top":0.6893692036358047,"bottom":0.710458096417641,"conf":1},{"text":"b)Eliza testi sayısı ve müsbet olenlar aylık periodlarla muntazam olarak !]","x0":0.2441112787319053,"x1":0.8093284871329407,"top":0.708636604874306,"bottom":0.7289651331236716,"conf":1},{"text":"Sağlık Müdürlüklerine bildirilecek ve. Bakanlığımıza gönderilecektir.","x0":0.2133942778699767,"x1":0.7270724999358019,"top":0.7299876759706966,"bottom":0.7474032166169806,"conf":1},{"text":"c) Pilot uygulama Ankara-İstanbul-izmir-Antalya illeri başta olani izere","x0":0.24405683842209736,"x1":0.7887358643511897,"top":0.7451288201185553,"bottom":0.7661345810287199,"conf":1},{"text":"Orta ve Doğu Karadeniz, Trakya, Marmara, Ege ve Akdeniz bölgelerinde turizmin","x0":0.21532558679391353,"x1":0.7949761335862541,"top":0.7637198203668022,"bottom":0.7866444237230577,"conf":1},{"text":"harcketli olduğu illérimizde yapılacaktır.","x0":0.21560574364266064,"x1":0.5338809093158393,"top":0.789244185915648,"bottom":0.8008720931388197,"conf":1},{"text":"603","x0":0.8932238196822326,"x1":0.9301848043424078,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}