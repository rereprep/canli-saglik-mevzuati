{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453918148407,"x1":0.9630389991091839,"top":0.03760683758848771,"bottom":0.05683760681925698,"conf":1},{"text":"6.3.40. Doğrudan Gözetimli Tedavi Genelgesi (2009/51)","x0":0.11900863409036061,"x1":0.7578016199626778,"top":0.11308484501580196,"bottom":0.1379517112661255,"conf":1},{"text":"ЦІК ПАКАНІ","x0":0.2177300157188712,"x1":0.27068805098612103,"top":0.22656093811770528,"bottom":0.24713883508357992,"conf":0.30000001192092896},{"text":"T.C.","x0":0.4928131413343864,"x1":0.5338809036054787,"top":0.2412790697241054,"bottom":0.2587209301513098,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.42915811307311036,"x1":0.5995893216548157,"top":0.2529069766541304,"bottom":0.27051282015738143,"conf":1},{"text":"Verem Savaşı Dairesi Başkanlığı","x0":0.39630389894492873,"x1":0.6283367578523124,"top":0.26880341919124495,"bottom":0.28504273543056113,"conf":1},{"text":"Sayı : B.10.0.VSD.0.00.00.06-010/","x0":0.18057064925248786,"x1":0.431376468301479,"top":0.3269319898415626,"bottom":0.3417624650211206,"conf":1},{"text":"Konu : Doğrudan Gözetimli Tedavi","x0":0.18275154236314056,"x1":0.4271047202651962,"top":0.3401162792152036,"bottom":0.3547008547704671,"conf":1},{"text":"T.C.","x0":0.7022587267714628,"x1":0.7289527720170382,"top":0.29651162772562345,"bottom":0.3081395349487952,"conf":1},{"text":"Seren kK Bg BAN HEbana","x0":0.6694045184839938,"x1":0.8151950706255825,"top":0.3037790701104275,"bottom":0.32267441822731024,"conf":0.5},{"text":"Hizmetleri Şube Müdürlüğü","x0":0.6694045153036977,"x1":0.8069815214488383,"top":0.32122093016798237,"bottom":0.33139534888636923,"conf":1},{"text":"28 Agustos 2009 10:44:32 /3696","x0":0.6714579021250503,"x1":0.8295687917120835,"top":0.3299145298215782,"bottom":0.3415697675574243,"conf":1},{"text":".....VALILIGINE","x0":0.4722792599967675,"x1":0.5893223827000154,"top":0.3793604652906679,"bottom":0.3924418602035181,"conf":1},{"text":"(II Sağlık Müdürlüğü)","x0":0.414784392259921,"x1":0.56468172662512,"top":0.39389534863788744,"bottom":0.40697674436584386,"conf":1},{"text":"GENELGE","x0":0.474293112115041,"x1":0.5544543209447247,"top":0.43300234624870826,"bottom":0.4449046304633475,"conf":1},{"text":"2009/51/","x0":0.48459958843356565,"x1":0.5420944565356336,"top":0.45203488357695243,"bottom":0.46366279080012407,"conf":1},{"text":"Ilgi: 2006/78 tarih ve 857 sayılı genelgemiz.","x0":0.1827515413421037,"x1":0.4722792591261688,"top":0.48974359000011036,"bottom":0.5043604649557686,"conf":1},{"text":"Ilgi genelge ile verem kontrol programında belirlenen ülke hedeflerine ulaşmak üzere","x0":0.23203285148541017,"x1":0.7967145815597565,"top":0.5101744185458039,"bottom":0.5205128203402375,"conf":1},{"text":"Doğrudan Gözetimli Tedavi Stratejisinin ülke genelinde uygulanmasına geçilmiş ve bu","x0":0.18472680781800818,"x1":0.7967795315653631,"top":0.5205513303241996,"bottom":0.5346995680905633,"conf":1},{"text":"konuda başta Il Sağlık Müdürlükleri olmak üzere tüm sağlık kuruluşlarının her düzeyde","x0":0.1806377213894211,"x1":0.7988266186295397,"top":0.5345647151282334,"bottom":0.550050754999058,"conf":1},{"text":"üzerine düşen görevleri eksiksiz yerine getirmesi istenmiştir.","x0":0.18275154669488788,"x1":0.5811088227349801,"top":0.5494186045243602,"bottom":0.5611111109558745,"conf":1},{"text":"Geçen bu süre içerisinde illerde yapılan faaliyetler Bakanlığımız tarafindan titizlikle","x0":0.22987784062245725,"x1":0.7988679368380709,"top":0.5654788398855911,"bottom":0.5826132071844673,"conf":1},{"text":"takip edilmekte olup, karşılaşılan sorunlar ve hizmetin ifası sırasında yaşanılan aksaklıkların","x0":0.18275153876100117,"x1":0.798767968214693,"top":0.5811965813174755,"bottom":0.5944767443732868,"conf":1},{"text":"giderilmesi amacıyla illerde Doğrudan Gözetimli Tedavi (DGT) çalışmalarının İl Sağlık","x0":0.18275154497541268,"x1":0.7987679744291045,"top":0.5914529915374762,"bottom":0.6076923077767925,"conf":1},{"text":"Müdürlükleri tarafindan, Verem Savaşı Il Koordinatörleri ile birlikte hassasiyetle gözden","x0":0.18275153828478996,"x1":0.7987679677384818,"top":0.6059829061082095,"bottom":0.6206395346109492,"conf":1},{"text":"geçirilmesi gerekmektedir.","x0":0.180698148077316,"x1":0.3613963076053541,"top":0.6205128202359015,"bottom":0.6351744184414679,"conf":1},{"text":"Il Sağlık Müdürlüğü Bulaşıcı Hastalıklar Şubesi ve Verem Savaşı Il Koordinatörü;","x0":0.22997946497087457,"x1":0.798767968043445,"top":0.6380341878035151,"bottom":0.6526162789149182,"conf":1},{"text":"birlikte DGT'nin uygulanmasında aktif rol alarak düzenli denetimlerde bulunacaktır. Ayrıca","x0":0.1806981514629939,"x1":0.7987679674157977,"top":0.6525641026373493,"bottom":0.6671511626364729,"conf":1},{"text":"Verem Savașı Dairesi Başkanlığı tarafindan oluşturulacak \"Verem Savașı İzleme ve","x0":0.18275153882239645,"x1":0.7987679682760883,"top":0.6641025639227611,"bottom":0.6787790696065948,"conf":1},{"text":"Değerlendirme Ekipleri\" tarafından illere ziyaret yapılacak ve il düzeyinde yapılan DGT","x0":0.18268282402247057,"x1":0.7988249401401211,"top":0.6767764100799132,"bottom":0.6927579000602359,"conf":1},{"text":"uygulamaları ile bunlarla ilgili kayıtlar kontrol edilecektir.","x0":0.18275154033393712,"x1":0.5646817243811333,"top":0.6918604652617153,"bottom":0.7064102561576174,"conf":1},{"text":"Uygulamaya esas olmak üzere;","x0":0.22977194072123955,"x1":0.43549779854932674,"top":0.7106442644029355,"bottom":0.7254951661452024,"conf":1},{"text":"1. Verem hastasına DGT uygulanması işleyişinden, hastanın ikamet ettiğı ilin II Sağlık","x0":0.18480492526659084,"x1":0.7967145817220587,"top":0.7311046511041563,"bottom":0.7414529914891369,"conf":1},{"text":"Müdürlüğü sorumludur.","x0":0.18434048698827005,"x1":0.3432913480046508,"top":0.7410024935360406,"bottom":0.7551656819813031,"conf":1},{"text":"2. DGT'de en iyi gözetiminin bir sağlık personeli olması gerektiği ilkesinden hareketle","x0":0.1806981514648904,"x1":0.7987679674176942,"top":0.7615384614411495,"bottom":0.7761627905434945,"conf":1},{"text":"verem hastasının tedavisinde ildeki tüm sağlık kurum ve kuruluşlarında çalışan her sağlık","x0":0.18275153880693723,"x1":0.798767968260629,"top":0.7747093021995992,"bottom":0.7863372094227709,"conf":1},{"text":"personeli gözetimei olmak üzere görevlendirilebilecektir.","x0":0.1827515402148029,"x1":0.5585215647646631,"top":0.7876068374717541,"bottom":0.8008720926417449,"conf":1},{"text":"3. DGT'nin uygulanma kayıtlarının tutulması ve raporlanması işlerini Il Sağlık Müdürlüğü","x0":0.1806981558069656,"x1":0.7987679717597694,"top":0.8066860464815896,"bottom":0.8213675210531436,"conf":1},{"text":"Bulaşıcı Hastalıklar Şubesı yürütür.","x0":0.18275153757835716,"x1":0.4147843964857407,"top":0.8212209300365861,"bottom":0.8343023257645426,"conf":1},{"text":"4. DGT nin planlanmasi;","x0":0.1806981552313879,"x1":0.3613962963086533,"top":0.8371794868469408,"bottom":0.853197673725895,"conf":1},{"text":"a. Aile hekimliğine geçilmeyen illerde; verem hastasının dispansere kaydı sırasında","x0":0.2340862617982675,"x1":0.7987679549710682,"top":0.8575581395348539,"bottom":0.8706395344477041,"conf":1},{"text":"DGT uygulaması hakkında bilgi verildikten sonra dispanser doktorunca veya birden fazla","x0":0.20739220475036468,"x1":0.798767959313167,"top":0.8720930230639432,"bottom":0.8851744187918995,"conf":1},{"text":"doktor olan dispanserlerde sorumlu doktor tarafinca görevlendirilen dispanser","x0":0.20533880539178861,"x1":0.7166324495876774,"top":0.8837209303236436,"bottom":0.8982905984006397,"conf":1},{"text":"661","x0":0.8952772069769633,"x1":0.9301848051380265,"top":0.9433139533263986,"bottom":0.9549418605495703,"conf":1}]}