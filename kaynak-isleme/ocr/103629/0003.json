{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"dolayı yükümlü oldukları Devlet hizmeti yükümlülüğünden muaf sayılırlar.","x0":0.25667351687425605,"x1":0.7474332591774793,"top":0.26744186061233255,"bottom":0.2820512822364103,"conf":1},{"text":"(2) Askerlik hizmetinden sonra ilgili mevzuata göre yurt içinde veya yurt dışında","x0":0.24435318406222145,"x1":0.8193018466321278,"top":0.27905982912847516,"bottom":0.29069767453464057,"conf":1},{"text":"öğrenimlerini tamamlayarak tabıp, uzman tabip veya yan dal uzmanlık eğıtımını tamamlayarak","x0":0.20739219426273248,"x1":0.8193018507182003,"top":0.2921511626654075,"bottom":0.30384615394833525,"conf":1},{"text":"uzman tabip unvanını kazananlar, her eğitimleri için ayrı ayrı olmak kaydı ile Devlet hizmeti","x0":0.20944558156365203,"x1":0.8193018515200078,"top":0.30213675212507196,"bottom":0.3141025640908839,"conf":1},{"text":"yapmakla yükümlüdürler.","x0":0.20739219850505525,"x1":0.3778234070867606,"top":0.3153846153931893,"bottom":0.327034883833762,"conf":1},{"text":"Değişiklik","x0":0.20739219723771582,"x1":0.2792607800589541,"top":0.33866279088723017,"bottom":0.35174418580008027,"conf":1},{"text":"MADDE 8- (1) Uygulama sonuçlarına göre usul ve esasların değiştirilmesi, gözden geçirilmesi","x0":0.20731970424480745,"x1":0.8193936832823678,"top":0.34865963740542405,"bottom":0.3651214760216892,"conf":1},{"text":"veya aksayan hususların çözüme kavuşturulması, ihtiyaç duyulması halinde belirlenen yerlerde","x0":0.2073382851736086,"x1":0.8193660634762083,"top":0.3601307202613435,"bottom":0.37407381697650455,"conf":1},{"text":"değişiklik yapılması maksadıyla; Sağlık Bakanlığı ve Milli Savunma Bakanlığı temsilcilerinin","x0":0.20528149284082725,"x1":0.8214064128382768,"top":0.37190630307892014,"bottom":0.38719406916872634,"conf":1},{"text":"katılımı ile her yıl Kasım ayında toplantı yapılacaktır.","x0":0.20524508052891746,"x1":0.5565649897688283,"top":0.38356067092899915,"bottom":0.4002093237474671,"conf":1},{"text":"Yürürlük","x0":0.20530028919397142,"x1":0.27724591321681846,"top":0.4083239936995763,"bottom":0.4216178664350154,"conf":1},{"text":"MADDE 9- (1) Bu usul ve esaslar, imzalanıp teati edildikten sonra yürürlüğe girer.","x0":0.20533881760380504,"x1":0.7515400322845979,"top":0.42136752141232603,"bottom":0.43461538466018923,"conf":1},{"text":"Yürütme","x0":0.20519384432941504,"x1":0.2732455803700032,"top":0.44869165257844557,"bottom":0.4611920682826347,"conf":1},{"text":"MADDE 10- (1) Bu usul ve esaslar, Sağlık Bakanlığı ve Milli Savunma Bakanlığı tarafindan","x0":0.2052367452038427,"x1":0.8214511514491193,"top":0.4589416844880293,"bottom":0.476473341910739,"conf":1},{"text":"yürütülür.","x0":0.2032854210081009,"x1":0.2751540038293392,"top":0.4752906978651592,"bottom":0.4883720927780093,"conf":1},{"text":"/2018","x0":0.33675564832692734,"x1":0.37577001948621447,"top":0.5523255815343393,"bottom":0.5639534879424047,"conf":1},{"text":"Prof Dr. Eyüp GÜMÜŞ","x0":0.2525667335659157,"x1":0.414784396151173,"top":0.5901162791810405,"bottom":0.6047008547363039,"conf":1},{"text":"Sağlık Bakanlığı Müsteşarı","x0":0.23819301456950365,"x1":0.41889117409754173,"top":0.6046511629268828,"bottom":0.6192307695944258,"conf":1},{"text":"Y2018","x0":0.6498452670444474,"x1":0.6932517247263456,"top":0.5503163472874776,"bottom":0.5647229818872121,"conf":1},{"text":"Ali FIDAN","x0":0.6057312274581503,"x1":0.6837964930813791,"top":0.5915084154777469,"bottom":0.6032590263509774,"conf":1},{"text":"Milli Savunma Bakanlığı Müsteşarı","x0":0.5379876787889771,"x1":0.7741273106945848,"top":0.604651162594105,"bottom":0.6177325583220614,"conf":1},{"text":"981","x0":0.895277207334518,"x1":0.9281314166901224,"top":0.9433139533236301,"bottom":0.9549418605468017,"conf":1}]}