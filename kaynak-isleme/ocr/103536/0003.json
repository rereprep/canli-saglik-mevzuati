ti içerisinde sağlık","x0":0.24229978637658403,"x1":0.7926078109571463,"top":0.4358974358380716,"bottom":0.4491452990859348,"conf":1},{"text":"kuruluşlarına ödenmektedir.","x0":0.2647496215270729,"x1":0.43751457609979433,"top":0.45040752404349527,"bottom":0.46267381881630354,"conf":1},{"text":"12. Yenidoğan İşitme Tarama Ünitelerinde, tarama testlerinde kullanılan cihazların","x0":0.2422169857427063,"x1":0.7926881889574509,"top":0.4626589056396222,"bottom":0.4780062445850599,"conf":1},{"text":"bakımı, kalibrasyonu bünyesinde bulunduğu tarama veya referans merkczleri","x0":0.2648870650678252,"x1":0.79260780125661,"top":0.4794871795891751,"bottom":0.491452991554987,"conf":1},{"text":"tarafindan yaptırılacaktır.","x0":0.2648870594416656,"x1":0.4209445625295869,"top":0.49401709407466887,"bottom":0.5043604651643759,"conf":1},{"text":"13. Yenidoğan Işitme Tarama Programının ilde yürütülmesinden Halk Sağlığı Müdürlüğü","x0":0.24024639908223056,"x1":0.7926078101619048,"top":0.5072649572245679,"bottom":0.5205128204724311,"conf":1},{"text":"koordinasyonunda İl Sağlık Müdürlüğü, ve Kamu Hastaneler Birliği Genel","x0":0.26488706055037164,"x1":0.7926077967391565,"top":0.5203488372998432,"bottom":0.5320512819143514,"conf":1},{"text":"Sekreterliği sorumludur. Programın izleme ve değerlendirilmesi Halk Sağlığı","x0":0.2648870651543731,"x1":0.7926078013431579,"top":0.5348837208022138,"bottom":0.5465811965290017,"conf":1},{"text":"Müdürlüğü tarafından yapılır.","x0":0.2647534809660706,"x1":0.44779503623927197,"top":0.5492114889063129,"bottom":0.5624992646469772,"conf":1},{"text":"Yenidoğan Işitme Tarama Programı'nın sağlıkh şekilde yürütülmesi için yukarıda","x0":0.2648870650828272,"x1":0.792607801271612,"top":0.5683139532958259,"bottom":0.5813953490237823,"conf":1},{"text":"belirtilen hususlara dikkat edilerek genelge ve eklerinin tüm sağlık kuruluşlarına (resmi ve","x0":0.24229978637817565,"x1":0.7926078109587379,"top":0.5811965813839046,"bottom":0.5931623933497167,"conf":1},{"text