{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"T.C.","x0":0.4969199174355533,"x1":0.5318275155966165,"top":0.23982558123337538,"bottom":0.25145348845654714,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.43531828008895396,"x1":0.5934291512252146,"top":0.25000000010898193,"bottom":0.26324786335684514,"conf":1},{"text":"Sağhk Hizmetleri Genel Müdürlüğü","x0":0.3942505140416221,"x1":0.6344969189454537,"top":0.26452991463595543,"bottom":0.27777777788381863,"conf":1},{"text":"Bu kapsamda; ekte yer alan Bakanlığımızca hazırlanan diyaliz ünite/merkezleri için","x0":0.25462012540966944,"x1":0.7843942480975661,"top":0.28924418585436684,"bottom":0.30232558158232314,"conf":1},{"text":"enfeksiyon kontrol kılavuzunun tüm ilgililere tebliğ edilmesi;","x0":0.2073921958016052,"x1":0.5852156068505774,"top":0.30085470097416367,"bottom":0.3125000001194629,"conf":1},{"text":"Ilinizde faaliyet gösteren tüm diyaliz merkezlerine içerisinde enfeksiyon hastalıkları","x0":0.2586690828935217,"x1":0.7823917211355673,"top":0.31247001963419163,"bottom":0.3268065795493267,"conf":1},{"text":"uzmanının da yer aldığı denetleme ekibince özellikle enfeksiyon kontrol önlemlerine uyulup","x0":0.20739219831221556,"x1":0.7823408608821218,"top":0.3255813952208967,"bottom":0.3372093024440683,"conf":1},{"text":"uyulmadığı konusunda olağanüstü denetim yapılması, tespit edilen eksiklerin raporlanması,","x0":0.20728127072549934,"x1":0.7824804578877764,"top":0.33435856995714297,"bottom":0.3534099228900648,"conf":1},{"text":"enfeksiyon kontrolü yönelik yapılması gerekenlerin yazılı olarak bildirilmesi, eksiklik tespit","x0":0.20739219838031975,"x1":0.782340860950226,"top":0.3502906974822323,"bottom":0.3633720932101887,"conf":1},{"text":"edilen merkezlere eksikliklerin tamamlanması için 1 ay süre verilmesi bir ay sonunda tekrar","x0":0.20732872288770168,"x1":0.7824132569481234,"top":0.36113547217057096,"bottom":0.3761835334436078,"conf":1},{"text":"denetim yapılarak gerekli tedbirlerin alınmasının sağlanması ve konu ile ilgili gerekli hassasiyet","x0":0.20733282222982918,"x1":0.7824089427378779,"top":0.373382747933376,"bottom":0.3884446888356947,"conf":1},{"text":"ve özenin gösterilmesi hususunda;","x0":0.20739219594865274,"x1":0.4188911714141436,"top":0.3880341879328014,"bottom":0.3997093024421883,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.26270614806210174,"x1":0.48882405824196873,"top":0.3995149889310191,"bottom":0.4137642721591841,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.6180698150886714,"x1":0.7720739224520944,"top":0.4476744187135492,"bottom":0.4623931623883246,"conf":1},{"text":"Bakan a.","x0":0.6652977417643422,"x1":0.7207392187546049,"top":0.46220930222246615,"bottom":0.472383720940853,"conf":1},{"text":"Mästeşar","x0":0.6632443522186444,"x1":0.7207392203207122,"top":0.47529069777761657,"bottom":0.48982558119525144,"conf":0.5},{"text":"EK: Diyaliz Ünite/Merkezleri Için Enfeksiyon Kontrol Kılavuzu","x0":0.20533881568624104,"x1":0.6036960917263332,"top":0.523076923204622,"bottom":0.5363372094868923,"conf":1},{"text":"DAGITIM:","x0":0.2072909392341843,"x1":0.27936203773710333,"top":0.5476822785919279,"bottom":0.5613293490935325,"conf":1},{"text":"Gereği","x0":0.20739219758615038,"x1":0.2505133463563547,"top":0.5624999998491007,"bottom":0.5741279070722723,"conf":1},{"text":"81 II Valiliğine (II Sağlık Müdürlüğü)","x0":0.20533880817450628,"x1":0.4414784400801139,"top":0.5739316238974017,"bottom":0.5872093025093528,"conf":1},{"text":"137","x0":0.8952772073625187,"x1":0.9281314167181233,"top":0.9433139536469047,"bottom":0.9563953485597548,"conf":1}]}