{"lines":[{"text":"Istisnalar","x0":0.2012320339350651,"x1":0.2895277179745858,"top":0.07412790660372925,"bottom":0.08866279077999173,"conf":1},{"text":"MADDE 14- (1) Bakanlık ve bağlı kuruluş müfettişleri, iç denetçileri, hukuk müşavirleri","x0":0.2032854299760476,"x1":0.893223810299317,"top":0.09011627944362055,"bottom":0.10755813914984991,"conf":1},{"text":"ve avukatlarının; teftiş, denetim ve vekalet gibi bizzat ve kadro unvanlarına mündemiç olarak","x0":0.14579056798051965,"x1":0.8952771936795825,"top":0.10607356697755832,"bottom":0.12360992283726746,"conf":1},{"text":"kullandığı imza yetkileri saklıdır.","x0":0.14373716739441872,"x1":0.4086242287383671,"top":0.12189905868747652,"bottom":0.13815226655745083,"conf":1},{"text":"Hüküm bulunmayan haller","x0":0.20328541768723596,"x1":0.43326489009550756,"top":0.14670658672436154,"bottom":0.16133720952286668,"conf":1},{"text":"MADDE 15- (1) Bu Yönergede hüküm bulunmayan hallerde yapılması gereken iş ve","x0":0.20328541219893226,"x1":0.8952772159228591,"top":0.16124893046087208,"bottom":0.17750213833084638,"conf":1},{"text":"işlemler ile imza yetkileri, düzenleme yapılıncaya kadar Bakan tarafından belirlenir. Bu suretle","x0":0.14368462114955266,"x1":0.8953375151753991,"top":0.17563065101195652,"bottom":0.19380613998239737,"conf":1},{"text":"yapılacak olan iş ve işlemler Hukuk Hizmetleri Genel Müdürlüğü koordinasyonunda yerine","x0":0.1437371623155367,"x1":0.8952772114152571,"top":0.19186046548970814,"bottom":0.2093023251959374,"conf":1},{"text":"getirilir.","x0":0.1457905552218717,"x1":0.2135523604321928,"top":0.2093023253109796,"bottom":0.22383720948724206,"conf":1},{"text":"(2) Imza yetkilerinin kullanılmasında tereddüt bulunması halinde Hukuk Hizmetleri Genel","x0":0.20116306251089938,"x1":0.8973790599508178,"top":0.2222320764588932,"bottom":0.24002621236267507,"conf":1},{"text":"Müdürlüğünün görüşüne başvurulur.","x0":0.14579055578100486,"x1":0.43531827356507,"top":0.24123182227324902,"bottom":0.2558139537104479,"conf":1},{"text":"Yürürlükten kaldırılan hükümler","x0":0.2052146120279023,"x1":0.4867698616122433,"top":0.26299819949241265,"bottom":0.2783308660901951,"conf":1},{"text":"MADDE 16- (1) 10/10/2018 tarihli Sağlık Bakanlığı ve Bağlı Kuruluşları Imza Yetkileri","x0":0.2012320435795189,"x1":0.8952771969010123,"top":0.27758768196154915,"bottom":0.2936046510794308,"conf":1},{"text":"Yönergesi ve bu Yönergenin yürürlük tarihinden önce yürürlüğe konulmuş makam onayları","x0":0.14579056792316744,"x1":0.8952771936222303,"top":0.2934131734781533,"bottom":0.31104651124467175,"conf":1},{"text":"yürürlükten kaldırılmıştır.","x0":0.14373716431704525,"x1":0.3531827532834241,"top":0.31094952948304955,"bottom":0.3255813955661213,"conf":1},{"text":"Yönergenin uygulanması ve takip","x0":0.20928328552787132,"x1":0.4949812686665219,"top":0.3327902331264645,"bottom":0.3487079940097272,"conf":1},{"text":"MADDE 17- (1) Bu Yönerge, birimlerde görevli ilgili personele imza karşılığı okutularak","x0":0.20529494468680415,"x1":0.8953437344341968,"top":0.3473571467607066,"bottom":0.3657561055265246,"conf":1},{"text":"bildirilir ve sıralı amirlerince bu Yönergeye uygun hareket edilip edilmediği takip ve kontrol edilir.","x0":0.14579055029442456,"x1":0.8973305993941451,"top":0.364825581165664,"bottom":0.3793840885644928,"conf":1},{"text":"Yürürlük","x0":0.20531792310657884,"x1":0.2916019931964887,"top":0.3865587261773551,"bottom":0.3997784828658475,"conf":1},{"text":"MADDE 18- (1) Bu Yönerge Bakan onayı ile yürürlüğe girer.","x0":0.20533881218488537,"x1":0.6899383949907726,"top":0.402480752966242,"bottom":0.4187339608362164,"conf":1},{"text":"Yürütme","x0":0.20530033391095867,"x1":0.28751280740088836,"top":0.42575026485048795,"bottom":0.4390753164836718,"conf":1},{"text":"MADDE 19- (1) Bu Yönerge hükümlerini Sağlık Bakanı yürütür.","x0":0.2073921913745022,"x1":0.716632449071279,"top":0.44183062472764834,"bottom":0.4578488371300965,"conf":1},{"text":"16/7/2024","x0":0.7124164735655771,"x1":0.79066