{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4496919876339785,"x1":0.9630390183289792,"top":0.03760683729850545,"bottom":0.05813953499241986,"conf":1},{"text":"3.3.5. Ambulans Hizmetleri Koordinasyonu Genelgesi (2005/30)","x0":0.1313256542659255,"x1":0.8707402983342825,"top":0.11600130749170356,"bottom":0.14242691039645528,"conf":1},{"text":"T.C.","x0":0.4948665303992921,"x1":0.5379876791694964,"top":0.23110465100732802,"bottom":0.24854651143453244,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.42710472654683573,"x1":0.603696094625877,"top":0.2456395350252749,"bottom":0.26025640998093313,"conf":1},{"text":"Temel Sağhk Hizmetleri Genel Müdürlüğü","x0":0.3613963032130355,"x1":0.6694045179398814,"top":0.25854700823783516,"bottom":0.27478632447715134,"conf":1},{"text":"SAYI : B100TSH0160001","x0":0.17043121402569741,"x1":0.3675564655466315,"top":0.30085470122771585,"bottom":0.3154069765674782,"conf":1},{"text":"KONU : Ambulans Hizmetleri","x0":0.17248459839460925,"x1":0.3839835738601001,"top":0.3153846153301161,"bottom":0.3286324785779793,"conf":1},{"text":"Koordinasyonu","x0":0.23597848547206282,"x1":0.3473250335686516,"top":0.32780010461396525,"bottom":0.3438050875867217,"conf":1},{"text":"22.02.2005","x0":0.43517734074099723,"x1":0.5237548972357873,"top":0.33971935132214925,"bottom":0.3565015788627768,"conf":1},{"text":"2389","x0":0.5503080071930521,"x1":0.5954825470750615,"top":0.34011627869041483,"bottom":0.3561046514279407,"conf":1},{"text":"GENELGE","x0":0.47224641863084676,"x1":0.5565010144231258,"top":0.37053341966207076,"bottom":0.3838270454203152,"conf":1},{"text":"2005/30","x0":0.4845694291055913,"x1":0.5441780038955772,"top":0.3836522067731162,"bottom":0.39687104897793557,"conf":1},{"text":"VALİLIĞİNE","x0":0.517224306077572,"x1":0.6164038703264101,"top":0.4089373636221936,"bottom":0.4244705060380798,"conf":1},{"text":"(Il Sağhk Müdürlüğü)","x0":0.4394250492629332,"x1":0.5893223836281322,"top":0.4388888888892104,"bottom":0.45348837192274116,"conf":1},{"text":"Acil hastalık ve yaralanma hallerinde acil sağlık hizmetlerinin yurt sathında eşit, ulaşılabilir,","x0":0.22381928848371102,"x1":0.8562628468318443,"top":0.46794871775675206,"bottom":0.4825581393808297,"conf":1},{"text":"kaliteli ve süratli bir şekilde sunulması, bu hizmeti günün 24 saati vatandaşlarımızın alabilmesi","x0":0.17248458785768422,"x1":0.8562628455851631,"top":0.48110465096700183,"bottom":0.49418604669495836,"conf":1},{"text":"amacıyla, Bakanlığımızca 112 Acil Sağlık Hizmetleri kurulmuş ve halen 81 ilimizde faaliyet","x0":0.17043121882552217,"x1":0.8562628261505675,"top":0.4956395346919664,"bottom":0.508720930419923,"conf":1},{"text":"sürdürmektedır.","x0":0.17453798584369026,"x1":0.2772073938277677,"top":0.5101744185371849,"bottom":0.5203488372555719,"conf":1},{"text":"Tüm ambulans hizmetlerinin tek merkezden koordine edilmesi, 24.03.2004 tarih ve 25412","x0":0.2258726944963068,"x1":0.8562628294437825,"top":0.5217948716450072,"bottom":0.5350427348928705,"conf":1},{"text":"sayılı Resmi Gazetede yayımlanan Acil Sağlık Hizmetleri Yönetmeliğinde Değişiklik Yapılmasına","x0":0.1724845876622193,"x1":0.8562628453896981,"top":0.5363247864837023,"bottom":0.5495726497315655,"conf":1},{"text":"Dair yönetmelik ve 24.01.2005 tarihinde yayınlanan Il Ambulans Servisi Çalışma Yönergesi ile","x0":0.17248458766477878,"x1":0.8562628453922577,"top":0.549418604800588,"bottom":0.5641025638160022,"conf":1},{"text":"hükme bağlanmıştır.","x0":0.1704312100741776,"x1":0.3100616027184302,"top":0.5639534885737348,"bottom":0.5770348834865849,"conf":1},{"text":"Bu nedenle ilinizdeki tüm ambulans hizmetlerinin İl Ambulans Servisi Başhekimliği","x0":0.22171233040239816,"x1":0.8563208286216772,"top":0.5745386127247297,"bottom":0.5903215615691829,"conf":1},{"text":"koordınatörlüğünde yürütülmesi; hastaların hastaneden hastaneye veya hekım tarafindan hastaneden","x0":0.17248458766350738,"x1":0.8562628453909862,"top":0.5914529915270265,"bottom":0.6031976745400296,"conf":1},{"text":"evlerine ambulansla nakli uygun görülenlerin evlerine nakılleri ile il dışına ambulansla nakli uygun","x0":0.17043121881635423,"x1":0.8562628261413996,"top":0.6046511625989935,"bottom":0.61773255832695,"conf":1},{"text":"görülen hastaların nakli için, Il Ambulans Servisi Başhekimliği'ne başvurulması ve bu nakillerin İl","x0":0.17239725184964164,"x1":0.8563211968787378,"top":0.6158237735525205,"bottom":0.6322986318609702,"conf":1},{"text":"Ambulans Servisi Başhekimlıği nce görevlendirilecek ambulans ile yapılması gerekmektedir.","x0":0.17248460069623978,"x1":0.7946611896472675,"top":0.6322674420096492,"bottom":0.6470085473093788,"conf":1},{"text":"Söz konusu nakiller için ambulans ücretleri, 9 Şubat 2005 tarihi ve 25722 sayılı Resmi","x0":0.2238192884794064,"x1":0.8562628468275397,"top":0.6452991452208154,"bottom":0.6598837207760789,"conf":1},{"text":"Gazete'nin Mükerrer sayısında yayımlanan 2005 Mali Yılı Bütçe Uygulama Talimatı'nın 2.4. bölümüi","x0":0.17237097279447577,"x1":0.8563801603936672,"top":0.6553762480790298,"bottom":0.6756051507816875,"conf":1},{"text":"hükümlerine göre tahsil edilebilecektir.","x0":0.17043121252716498,"x1":0.4353182738711134,"top":0.6729651160832211,"bottom":0.6860465118111774,"conf":1},{"text":"Ayrıca 12.06.2004 tarih ve 25490 sayılı Resmi Gazetede yayımlanarak yürürlüğe giren","x0":0.2238192886129234,"x1":0.8562628469610567,"top":0.6858974358343976,"bottom":0.6991452990822608,"conf":1},{"text":"26.05.2004 tarihli ve 2004/7379 sayılı Bakanlar Kurulu Kararı gereğince hiçbir sosyal güvencesi","x0":0.17248460543319186,"x1":0.8542094397600133,"top":0.699127906779752,"bottom":0.7123931623572959,"conf":1},{"text":"olmayan vatandaşlarımızın, acil hastalık ve/veya yaralanma hallerinde Sağlık Bakanlığına bağlı 112","x0":0.17241769034361543,"x1":0.8542735251569468,"top":0.7111534840772603,"bottom":0.7273567970733665,"conf":1},{"text":"Acil Sağlık Hizmetleri kapsamında verilen hastane öncesi acil tıbbi yardım ve ambulans","x0":0.17248458777369496,"x1":0.8562628455011738,"top":0.7267441858524099,"bottom":0.7398255815803663,"conf":1},{"text":"hizmetlerınden ücretsiz yararlanmaları sağlanmıştır.","x0":0.17043121747462575,"x1":0.5195071806344844,"top":0.7412790695731767,"bottom":0.7543604653011331,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.2216746735981504,"x1":0.46829235174109934,"top":0.7528302616453522,"bottom":0.7698079614468053,"conf":1},{"text":"Prof. Dr. Recep AKDAĞ","x0":0.6445791479370256,"x1":0.8257415473581732,"top":0.8195997594999085,"bottom":0.8367984557994044,"conf":1},{"text":"Bakan","x0":0.7186858305950998,"x1":0.7700205345871385,"top":0.8343023257585096,"bottom":0.8473837206713597,"conf":1},{"text":"DAĞITIM:","x0":0.17182069114569057,"x1":0.25281733251462574,"top":0.8741069333400466,"bottom":0.8899611852342231,"conf":1},{"text":"81 II Valiliğine","x0":0.1704312112285618,"x1":0.2772073922108632,"top":0.8909883722946651,"bottom":0.9042735042381966,"conf":1},{"text":"331","x0":0.8952772077725818,"x1":0.932238192432757,"top":0.9418604652225051,"bottom":0.95639534864014,"conf":1}]}