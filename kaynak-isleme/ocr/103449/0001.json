{"lines":[{"text":"476","x0":0.06776180656628569,"x1":0.10266940472734884,"top":0.030523255656540016,"bottom":0.04215116287971166,"conf":1},{"text":"6.3.13. Aşı Sonrası İstenmeyen Etkiler (ASİE) Genelgesi (2023/03)","x0":0.11909652593733328,"x1":0.8767966976328443,"top":0.11623931596538284,"bottom":0.13974358946965637,"conf":1},{"text":"T.C.","x0":0.49281314198365395,"x1":0.5236139625337999,"top":0.24563953471578448,"bottom":0.2572674419389561,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4394250493576156,"x1":0.5893223837228145,"top":0.255813953627702,"bottom":0.27051282012138356,"conf":1},{"text":"Halk Sağlığı Genel Müdürlüğü","x0":0.4168377840188631,"x1":0.6119096490406852,"top":0.27034883735313553,"bottom":0.2850427349590967,"conf":1},{"text":"TSELISO-EN","x0":0.669213403469122,"x1":0.7209303336694057,"top":0.30351775994686503,"bottom":0.3229357281099885,"conf":0.5},{"text":"IQNet","x0":0.7453798758427896,"x1":0.7967145798348284,"top":0.30523255798725146,"bottom":0.316860465210423,"conf":0.5},{"text":"CERTIFICATE","x0":0.743326489332226,"x1":0.7987679663224887,"top":0.32267441866649915,"bottom":0.3299418603753166,"conf":0.30000001192092896},{"text":"Sayı : E- 21001706-010.06.02","x0":0.21128080363168117,"x1":0.412959853472975,"top":0.34013674260098326,"bottom":0.35517565186100764,"conf":1},{"text":"Konu : Aşı Sonrası İstenmeyen Etkiler","x0":0.21355236365914435,"x1":0.45790554156119995,"top":0.35465116264512253,"bottom":0.3662790698682943,"conf":1},{"text":"(ASIE) Genelgesi","x0":0.2628336738957579,"x1":0.37782341009989373,"top":0.3675213675748885,"bottom":0.38081395366510673,"conf":1},{"text":"BAKANLIK MAKAMINA","x0":0.4127310073363881,"x1":0.5852156024172055,"top":0.4156976744730807,"bottom":0.4287790693859308,"conf":1},{"text":"Aşı Sonrası Istenmeyen Etki (ASİE) izleme sistemi, Bakanlığımız tarafından yürütülen","x0":0.25872690158772976,"x1":0.7885010242756265,"top":0.45341880346289,"bottom":0.4651162791896779,"conf":1},{"text":"bağışıklama programlarının vazgeçilmez bir parçasıdır. Bu hizmetimiz her geçen gün aşılama hızlarının,","x0":0.21355236270210656,"x1":0.7885010252720128,"top":0.4649572648213738,"bottom":0.47529069772808696,"conf":1},{"text":"aşının kabul edilebilirliğinin ve hizmet kalitesinin artırılması için önem taşımaktadır. Bu sistemin temel","x0":0.21355236266987235,"x1":0.7885010252397786,"top":0.4767441859876089,"bottom":0.4869186047059958,"conf":1},{"text":"amacı, meydana gelen istenmeyen olguları düzenli olarak izlemek, analiz etmek ve yorumlayarak","x0":0.21355236267090744,"x1":0.7885010252408138,"top":0.4883720928976787,"bottom":0.5000000001208503,"conf":1},{"text":"aşılama programının iyileştirilmesini sağlamaktır.","x0":0.21355235879227064,"x1":0.49281314408077576,"top":0.49999999993892774,"bottom":0.5102564101953381,"conf":1},{"text":"Aşı sonrası istenmeyen etkilerin il ve ülke düzeyinde izlenebilmesi için sağlık personelinin","x0":0.2566735143898261,"x1":0.7885010235768348,"top":0.5101744184768595,"bottom":0.5218023257000312,"conf":1},{"text":"bilgilerinin geliştirilmesi ve bu konuda sağlık personelinin yönlendirilmesi amacıyla hazırlanan Daimi","x0":0.2135523626575519,"x1":0.7885010252274582,"top":0.5217948717169716,"bottom":0.5334302326792768,"conf":1},{"text":"Genelge ekte gönderilmektedir.","x0":0.21355236513662001,"x1":0.39014373321566137,"top":0.5333333334787771,"bottom":0.5436046512134547,"conf":1},{"text":"Söz konusu Genelge ile Mart 2009 tarihinden sonra Çocukluk Dönemi Ulusal Aşı Takvimimize","x0":0.25872690159077977,"x1":0.7885010242786765,"top":0.5448717947750122,"bottom":0.5552325581943999,"conf":1},{"text":"eklenen Hepatit A ve Suçiçeği aşılarının uygulaması sonrasında beklenen istenmeyen etkiler ASIE","x0":0.21351460779623185,"x1":0.7865067504239526,"top":0.5552059378482829,"bottom":0.5681062569069538,"conf":1},{"text":"Izleme Sistemi kapsamına alınmış, ayrıca ASIE vaka sınıflamasında uluslararası güncel rehberlere","x0":0.21347153898240717,"x1":0.7885759629758511,"top":0.565112019651343,"bottom":0.5797031462155644,"conf":1},{"text":"uygun olarak bazı değişiklikler yapılmıştır. Bu Genelge ile 13.03.2009 tarihli ve 2009/17-7943 sayılı","x0":0.21355236267090744,"x1":0.7885010252408138,"top":0.5784883720340874,"bottom":0.5886627907524743,"conf":1},{"text":"Daimi Genelge yürürlükten kaldırılmış olup, Aşı Sonrası İstenmeyen Etki İzleme Sisteminin yeni","x0":0.2134913006245937,"x1":0.7885519224835342,"top":0.5873351975615901,"bottom":0.6018259005900816,"conf":1},{"text":"değişiklikler doğrultusunda yürütülmesi hususlarını olurlarınıza arz ederim.","x0":0.21348371495318114,"x1":0.6345679886362978,"top":0.5997675942472275,"bottom":0.612693635613935,"conf":1},{"text":"Uyem püruyle arz ederun","x0":0.19885578328291226,"x1":0.3943675516285894,"top":0.6510233016548206,"bottom":0.6809413397866648,"conf":0.5},{"text":"- / /2023","x0":0.2361396284972864,"x1":0.31622176654035905,"top":0.677325581582789,"bottom":0.6889534879908543,"conf":1},{"text":"Doç.Dr. Tolga TOLUNAY","x0":0.215442529757376,"x1":0.38220358442716323,"top":0.6900148637418199,"bottom":0.7044329562901577,"conf":1},{"text":"Bakan Yardımcısı","x0":0.24435318484671695,"x1":0.3572895253263544,"top":0.7034188035180042,"bottom":0.7136752137744145,"conf":1},{"text":"Prot Dr. Sedat KAYGUSUZ","x0":0.6076126654191069,"x1":0.7866553478131139,"top":0.6404968825498358,"bottom":0.6539125875867491,"conf":1},{"text":"Halk Sağlığı Genel Müdürü","x0":0.6119096522677302,"x1":0.7823408608494355,"top":0.65256410269651,"bottom":0.6658119659443733,"conf":1},{"text":"DE NT ƯN CA","x0":0.4373716618708922,"x1":0.5770020545151449,"top":0.7485465116713907,"bottom":0.790697674234617,"conf":0.30000001192092896},{"text":"Bakan","x0":0.4722792621301425,"x1":0.523613961509488,"top":0.7863372096952531,"bottom":0.8023255808025664,"conf":1}]}