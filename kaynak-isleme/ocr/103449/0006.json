{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"1.b. Aşı Niteliğinden Kaynakh Reaksiyon","x0":0.19917864453127518,"x1":0.48459958931711633,"top":0.23675213693624575,"bottom":0.25000000018410895,"conf":1},{"text":"Aşı niteliğinden kaynaklı reaksiyon, üretici tarafından sağlanan enjektör dahil olmak","x0":0.24427311420433487,"x1":0.8091100890805818,"top":0.2488089108114213,"bottom":0.26498148615071426,"conf":1},{"text":"üzere aşı ürününün bir veya daha fazla kalite kusurunun neden olduğu veya hızlandırdığı","x0":0.19705502845805015,"x1":0.8091088592517699,"top":0.2620309502624729,"bottom":0.27813427009895086,"conf":1},{"text":"istenmeyen etkilerdir.","x0":0.19917864499254512,"x1":0.34291581063502163,"top":0.27606837599294587,"bottom":0.28779069778854804,"conf":1},{"text":"Uygulanan tüm aşıların güvenilir ve lisanslı olduklarından emin olunmalıdır. Bu","x0":0.2443531800061224,"x1":0.8090349100804687,"top":0.2892441858538668,"bottom":0.3023255815818232,"conf":1},{"text":"yüzden üretim tesisleri \"Iyi Uygulama Süreçleri Onay Belgesi\" (GMP), dünyada daha önce","x0":0.19712525376278245,"x1":0.8090349102182502,"top":0.30213675239838955,"bottom":0.31686046496088527,"conf":1},{"text":"kullanılmış, analiz sertifikaları tekrarlanabilir ve ulusal otorite TITCK tarafindan uygun","x0":0.19917864083951062,"x1":0.8090349107958664,"top":0.31538461532943907,"bottom":0.32863247857730227,"conf":1},{"text":"bulunmuş aşılar ülkemizde kullanılmaktadır. Ayrıca Aşı Takip Sistemi'nde uygulanan her","x0":0.19917864108921152,"x1":0.8090349110455675,"top":0.32848837190007474,"bottom":0.34156976762803115,"conf":1},{"text":"aşının kime ne zaman yapıldığına dair geriye dönük bilgi edinebilmek için kayıt altında","x0":0.1971252537933088,"x1":0.8090349102487766,"top":0.34145299139290786,"bottom":0.3561046510079273,"conf":1},{"text":"tutulmaktadır.","x0":0.19695130368447963,"x1":0.29395127814861016,"top":0.35374849017890053,"bottom":0.36739691294177956,"conf":1},{"text":"1.c. Uygulama Hataları","x0":0.19712525561507482,"x1":0.36139630469944417,"top":0.36752136750364195,"bottom":0.38247863246090696,"conf":1},{"text":"Aşıların üretimi, dağıtımı ya da uygulanması sırasında yapılan hatalara bağlı olarak","x0":0.24640656625683882,"x1":0.8069815233329611,"top":0.38076923084879954,"bottom":0.39401709409666286,"conf":1},{"text":"ortaya çıkan istenmeyen etkiler bu grupta toplanmaktadır. Bu gruptaki etkiler, gerçek yan","x0":0.19912087427023728,"x1":0.8090840480038943,"top":0.3937086052610562,"bottom":0.4086811616116338,"conf":1},{"text":"etkilerden biraz daha sık görülmeleri ve önlenebilir olmaları açısından önem taşımaktadır.","x0":0.1970583197857486,"x1":0.7783037144728707,"top":0.4067242884774426,"bottom":0.422767984106595,"conf":1},{"text":"Bu tip etkiler, genellikle, aşı uygulayan kişi, aşı uygulanan sağhık kuruluşunda aşının","x0":0.24435317922876879,"x1":0.806981522804003,"top":0.4213675214122845,"bottom":0.4346153846601477,"conf":1},{"text":"saklanması veya uygun olarak hazırlanmamış ya da kontamine olmuş tek bir flakona bağlı","x0":0.19917864108110628,"x1":0.8090349110374621,"top":0.43459302313018777,"bottom":0.4462209303533595,"conf":1},{"text":"olarak görülür ve kümelenme gösterebilir. Birden çok flakonun etkilendiği durumlar da söz","x0":0.1971252537995606,"x1":0.8090349102550284,"top":0.44767441841273026,"bottom":0.46075581414068667,"conf":1},{"text":"konusu olabilir (örn: taşıma sırasında donmaya maruz kalmış aşılar nedeniyle lokal","x0":0.19705671642176015,"x1":0.8090772620214427,"top":0.45927743700293167,"bottom":0.4749123291324222,"conf":1},{"text":"reaksiyonlarda artış).","x0":0.195071867196012,"x1":0.3347022598402646,"top":0.473837209162962,"bottom":0.48547008527385405,"conf":1},{"text":"En sık görülen uygulama hatası, yanlış uygulanan aşılardan kaynaklı hatalardır. Bu","x0":0.24429147637092266,"x1":0.8090894463135806,"top":0.4854321249883342,"bottom":0.5013763483107542,"conf":1},{"text":"yüzden aşılar uygulamadan önce Aşı Takip Sistemi'nden kontrol edilmelidir.","x0":0.19507186040229904,"x1":0.6981519586017398,"top":0.49854651177474163,"bottom":0.5132478635273896,"conf":1},{"text":"Enfeksiyon lokal olarak (örn: süpürasyon, apse) ortaya çıkabileceği gibi; sistemik","x0":0.2443142514937413,"x1":0.8070502737787322,"top":0.5115840493641939,"bottom":0.527446147471165,"conf":1},{"text":"hastalığa (örn: sepsis, toksik şok sendromu) da neden olabilir. Bazı uygulama hatalarına bağh","x0":0.194999686077205,"x1":0.8091114053585873,"top":0.5235067752450765,"bottom":0.5398417230104594,"conf":1},{"text":"istenmeyen etkiler Tablo 3'te özetlenmiştir.","x0":0.1971252564532931,"x1":0.4825462012391342,"top":0.5392441859857898,"bottom":0.5495726495972295,"conf":1},{"text":"Tablo 3. Sık görülen hatalar ve neden oldukları ASİ'ler","x0":0.19712525297592298,"x1":0.5687885045275591,"top":0.5508547012476939,"bottom":0.5654069765874563,"conf":1},{"text":"Program hatası","x0":0.19917864526780016,"x1":0.3080082127492136,"top":0.56538461538696,"bottom":0.5770348838275327,"conf":1},{"text":"Steril olmayan enjeksiyon:","x0":0.19917864766423038,"x1":0.3737166292441597,"top":0.5784883719596096,"bottom":0.5901709402081301,"conf":1},{"text":"• Steril olmayan enjektör ya da","x0":0.22176591529442136,"x1":0.46406570669736497,"top":0.5914529914559288,"bottom":0.604700854703792,"conf":1},{"text":"enjektör iğnesi","x0":0.24229979284192335,"x1":0.3449692008260008,"top":0.6059829059409513,"bottom":0.6177325582492278,"conf":1},{"text":"• Kontamine aşı ya da sulandırıcı","x0":0.22176591129453768,"x1":0.45379877020192133,"top":0.6191860463824814,"bottom":0.6308139536056532,"conf":1},{"text":"• Aşimın imha edilmesi istenen","x0":0.22369984508365306,"x1":0.4641742461863303,"top":0.6311968911441885,"bottom":0.6442315869895724,"conf":1},{"text":"süreden fazla kullanılması","x0":0.24640657296091853,"x1":0.4188911680417359,"top":0.6452991454099511,"bottom":0.6555555556663615,"conf":1},{"text":"(Orn: enjeksiyon yerinde lokal","x0":0.5503080122816507,"x1":0.7515400368008088,"top":0.5914529914555845,"bottom":0.6047008547034477,"conf":1},{"text":"süpürasyon, apse, selülit, sistemik","x0":0.5503080118077878,"x1":0.7741273062679507,"top":0.604651162594849,"bottom":0.6177325583228054,"conf":1},{"text":"enfeksiyon, sepsis, toksik şok","x0":0.5503080098986337,"x1":0.7453798749204558,"top":0.6175213675801953,"bottom":0.6308139536704136,"conf":1},{"text":"sendromu, kan yoluyla bulaşan","x0":0.5503080046388557,"x1":0.7556468206070105,"top":0.6307692308554044,"bottom":0.6440170941032677,"conf":1},{"text":"virüslerin bulaşması).","x0":0.5500558539513506,"x1":0.6943574840845032,"top":0.6422456687096965,"bottom":0.657567824132331,"conf":1},{"text":"Aşının yanlış hazırlanması","x0":0.20123203496936148,"x1":0.37371663005017886,"top":0.6598290597722926,"bottom":0.6715116280208131,"conf":1},{"text":"• Kullanılmadan önce yeterince","x0":0.2217659152744687,"x1":0.4640657066774123,"top":0.6729651161503711,"bottom":0.6846153845909438,"conf":1},{"text":"Lokal reaksiyon veya abse","x0":0.5479214886044481,"x1":0.7272197880041043,"top":0.6674175481973873,"bottom":0.6847228375718448,"conf":1},{"text":"çalkalanmaması","x0":0.24385758224861684,"x1":0.3536208234087778,"top":0.6832708938837528,"bottom":0.6980395970510079,"conf":1},{"text":"• Yanhış sulandırıcı kullanılması","x0":0.22552553625701563,"x1":0.4457835732660184,"top":0.696474550662422,"bottom":0.7122931269861025,"conf":1},{"text":"• Aşı ya da sulandırıcının yerine","x0":0.22363698757895034,"x1":0.4622426759669491,"top":0.7106472209286705,"bottom":0.7265212016546028,"conf":1},{"text":"Kullanılan maddenin (ilacın) etkisi","x0":0.5503080049662955,"x1":0.780287477374567,"top":0.7076923076768836,"bottom":0.7209401709247468,"conf":1},{"text":"başka madde (ilaç) kullanılması","x0":0.24640656884613155,"x1":0.45585215781251043,"top":0.7267441859166152,"bottom":0.7384615384169437,"conf":1},{"text":"Kontrendikasyonlara dikkat edilmemesi","x0":0.1971252561367888,"x1":0.4579055444825132,"top":0.7512820513621206,"bottom":0.7645348839052573,"conf":0.5},{"text":"Önlenebilir ciddi hastalık","x0":0.5503080075076424,"x1":0.7186858295902357,"top":0.7456395349927029,"bottom":0.7587209299055531,"conf":1},{"text":"Yanlış yere enjeksiyon","x0":0.19917864274146388,"x1":0.3490759771066629,"top":0.777616278867867,"bottom":0.7906976745958234,"conf":1},{"text":"• BCG aşısının intradermal yerine","x0":0.22165028878700632,"x1":0.46419748660172633,"top":0.7905485172117687,"bottom":0.8051506811297666,"conf":1},{"text":"sukütan uygulanması","x0":0.24435318073396287,"x1":0.3942505150991618,"top":0.8051282052467165,"bottom":0.8168604652253124,"conf":1},{"text":"• Toksoid aşıların (DaBT / Td /","x0":0.22163956287650252,"x1":0.4662708861777325,"top":0.8168094693655583,"bottom":0.8305919428726488,"conf":1},{"text":"DT / TT) yüzeyel uygulanması","x0":0.24821858894577137,"x1":0.4539499266533647,"top":0.8310324194779284,"bottom":0.8460196338842598,"conf":1},{"text":"Lokal reaksiyon ya da apse","x0":0.54825461699991,"x1":0.73100616302706,"top":0.799418604451841,"bottom":0.8125000001797974,"conf":1},{"text":"481","x0":0.897330595424867,"x1":0.9301848047804716,"top":0.9433139533236301,"bottom":0.9549418605468017,"conf":1}]}