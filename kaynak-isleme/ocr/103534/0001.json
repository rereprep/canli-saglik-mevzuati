arak","x0":0.248459967354053,"x1":0.8418891084159674,"top":0.4504273503305448,"bottom":0.46239316229635685,"conf":1},{"text":"verem savaşı hizmetlerinde kullanılmak üzere tahsis edilen mülkiyeti derneklere ait binalarda,","x0":0.19301847343589923,"x1":0.8418891237769286,"top":0.4636627905033055,"bottom":0.4769230767855759,"conf":1},{"text":"5368 sayılı Verem savaşı Hakkında Kanun ve 181 sayılı Kanun Hükmünde Kararname","x0":0.19294286731728483,"x1":0.8419443705386421,"top":0.47438240074200366,"bottom":0.4918694800037182,"conf":1},{"text":"çerçevesinde 20/12/2001 tarihli ve 8597 sayılı Bakanlık makamını Onayı ile yürürlüğe","x0":0.1930184725296907,"x1":0.84188912287072,"top":0.4897435898636243,"bottom":0.5043604648192825,"conf":1},{"text":"konulan Sağhk Hizmetlerinin Yürütülmesi Hakkında Yönergeye göre verem savaşı","x0":0.19507187921693422,"x1":0.8418891061573059,"top":0.5042735041574885,"bottom":0.515988372213957,"conf":1},{"text":"dispanserleri tarafından yürütülmektedir.","x0":0.19301847629350222,"x1":0.46817248858378335,"top":0.5174418606109962,"bottom":0.5320512822350738,"conf":1},{"text":"Sağlık Bakanhğı Imza Yetkileri Yönergesinin Müsteşar Tarafından Onaylanacak","x0":0.2422997869876405,"x1":0.8418891244484361,"top":0.5303418801490472,"bottom":0.5450581393799625,"conf":1},{"text":"İşlemler\" başlığı altında yer alan \"9.20 - Merkez ve taşra teşkilatında yer alan sağlık kurumu ve","x0":0.19085600766387348,"x1":0.8419890179561574,"top":0.542089095417612,"bottom":0.5605686659857293,"conf":1},{"text":"kuruluşların ve hizmet birimlerinin kurulması, yerinin ve adının değiştirilmesine ilişkin","x0":0.19301847349313242,"x1":0.8418891238341617,"top":0.5581196578519378,"bottom":0.5726744184506667,"conf":1},{"text":"onayların\" Müsteşar tarafindan onaylanacağı ifade edilmiştir.","x0":0.19301848840157845,"x1":0.6016426969372306,"top":0.5696581198160663,"bottom":0.584302325284399,"conf":1},{"text":"Bu kapsamda, verem savaşı dispanserlerinin açılması, kapanması, yer değiştirmesi ve","x0":0.2422997870150408,"x1":0.8418891244758366,"top":0.5841880339769139,"bottom":0.5988372091480731,"conf":1},{"text":"tahsisine ilişkin iş ve işlemler Verem Savaşı Dairesi Başkanlığının izni olmadan ve makam onayı","x0":0.19295855311696977,"x1":0.8419497239055883,"top":0.597291563476961,"bottom":0.61333408942864,"conf":1},{"text":"alınmadan yapılmamalıdır.","x0":0.19301847659768145,"x1":0.37371663612571954,"top":0.6119186044535282,"bottom":0.6250000001814846,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.24229979013539943,"x1":0.4928131459855638,"top":0.6249999998044944,"bottom":0.6380813955324508,"conf":1},{"text":"Prof. Dr. Nihat TOSUN","x0":0.6119096538724784,"x1":0.7864476354524077,"top":0.6758720926912555,"bottom":0.691880341794769,"conf":1},{"text":"Bakan a.","x0":0.6652977404642475,"x1":0.7351129367863738,"top":0.690406976857584,"bottom":0.7051282049762196,"conf":1},{"text":"Müsteşar","x0":0.6611909658652507,"x1":0.7351129351856011,"top":0.7034883717237473,"bottom":0.7194767444612732,"conf":1},{"text":"DAĞITIM","x0":0.19294698532050364,"x1":0.26906533462876203,"top":0.7570790015681698,"bottom":0.7719907656641609,"conf":1},{"text":"Gereği:","x0":0.19301848029466126,"x1":0.24640657078581196,"top":0.7718023257682427,"bottom":0.7848837206810928,"conf":1},{"text":"81 İl Valiliklerine","x0":0.19301848132270605,"x1":0.31622176352328984,"top":0.7833333335481476,"bottom":0.7979651159820732,"conf":1},{"text":"657","x0":0.895277207334518,"x1":0.9281314166901224,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}