{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397568687,"x1":0.9609856316724636,"top":0.04059829028555706,"bottom":0.05523255797844895,"conf":1},{"text":"EC Sağla Bakamo","x0":0.20533881122264305,"x1":0.28336755354121734,"top":0.2848837208224926,"bottom":0.29505813954087945,"conf":1},{"text":"TSE-ISO-EN","x0":0.652977411715395,"x1":0.6981519515974045,"top":0.27470930230598967,"bottom":0.28343023251959176,"conf":1},{"text":"9000","x0":0.663244353749406,"x1":0.6858316213840642,"top":0.28343023237678633,"bottom":0.29505813959995797,"conf":1},{"text":"-ONet","x0":0.7388600434652527,"x1":0.7990656437471214,"top":0.26659454152397355,"bottom":0.2809263004632765,"conf":0.30000001192092896},{"text":"CERTIERCATE","x0":0.7474332639177383,"x1":0.798767967909777,"top":0.2863372092943617,"bottom":0.2950581395079639,"conf":0.30000001192092896},{"text":"T.C.","x0":0.464065708737434,"x1":0.49486652928758,"top":0.2921511626146298,"bottom":0.30377906983780145,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4086242313982662,"x1":0.5585215565380788,"top":0.30213675230496395,"bottom":0.315406976362675,"conf":1},{"text":"Halk Sağlığı Genel Müdürluğü","x0":0.3839835745743701,"x1":0.5790554395961922,"top":0.3166666664796268,"bottom":0.3299418606477177,"conf":1},{"text":"4) Verilen hizmetin kayıtlarının tutulması ve sürecin yönetilebilmesi için her yerleşke için bir","x0":0.22993562553337277,"x1":0.7721391850859726,"top":0.33984017505949926,"bottom":0.3544866856483164,"conf":1},{"text":"hizmet defteri (mümkünse tablet PC üzerinden) oluşturulur. Ekipler tarafından sunulan hizmet verileri","x0":0.19507187063966214,"x1":0.7720739197086804,"top":0.35170940173601883,"bottom":0.36196581199242905,"conf":1},{"text":"her günün sonunda Ek-1' de yer alan \"Mobil Sağlık Formu\"na işlenerek kayıt altına alınır. Bu kayıtların","x0":0.19507186983152466,"x1":0.770020532401431,"top":0.36324786336872317,"bottom":0.3750000001208599,"conf":1},{"text":"icmali aynı form kullanılarak hazırlanan ekip icmali aynı gün sonunda il sağlık müdürlüğüne bildirilir.","x0":0.19712525475200793,"x1":0.7720739173219142,"top":0.37350427336840264,"bottom":0.385174418174963,"conf":1},{"text":"Il sağlık müdürlükleri de ilin icmalini aylık olarak Halk Sağlığı Genel Müdürlüğüne gönderir.","x0":0.19507186911791344,"x1":0.7207392188075863,"top":0.3850427351423866,"bottom":0.39829059839024994,"conf":1},{"text":"Ziynetlerde uyulacak ilkeler:","x0":0.24024640265311206,"x1":0.4209445621811501,"top":0.40843023235923615,"bottom":0.42151162808719245,"conf":1},{"text":"Mobil sağlık hizmetlerinin sunumunda aşağıda belirtilen ilke ve kurullara uyulacaktır;","x0":0.2627762389361195,"x1":0.7454475314821254,"top":0.41850187753404766,"bottom":0.4317134379871529,"conf":1},{"text":"a) Hazırlanan ve ilan edilen çalışma planına göre hizmetin sunulması esastır. Mücbir","x0":0.24845995875339136,"x1":0.7720739219439521,"top":0.4316239316882746,"bottom":0.44188034194468495,"conf":1},{"text":"sebeplerle yapılan değişiklikler, ziyaret gününden en az 1 gün önce köylerin muhtarlarına bildirilecektir.","x0":0.197125251192802,"x1":0.7720739137627083,"top":0.4418604652068201,"bottom":0.4534883716148854,"conf":1},{"text":"Mobil sağlık hizmetine gidilen birimin muhtarlarıyla işbirliği içerisinde hizmetler yürütülür.","x0":0.1971252524906637,"x1":0.7104722831856645,"top":0.4534188034632717,"bottom":0.4651162791900596,"conf":1},{"text":"b) Hizmetlerin sunumu (varsa) sağlık evinde, olmaması halinde de yerleşkede belirlenen","x0":0.2483982724519146,"x1":0.7721345273642484,"top":0.4633750493957405,"bottom":0.47719022496571495,"conf":1},{"text":"uygun bir mekånda sunulması esastır.","x0":0.19507186896096732,"x1":0.4106776174246822,"top":0.4767441859800453,"bottom":0.4869186046984322,"conf":1},{"text":"c) İleri derecede hastalığı, engelliliği ya da yaşlılığı olduğu için belirlenen hizmet mekânıma","x0":0.24640657142167677,"x1":0.7720739211113495,"top":0.48675213693791564,"bottom":0.5000000001857788,"conf":1},{"text":"gelemeyen vatandaşlar evlerinde ziyaret edilir.","x0":0.19507186884383776,"x1":0.45790554368867414,"top":0.4985465114998482,"bottom":0.5102564102610433,"conf":1},{"text":"d) Hizmetin verilmesi sırasıda tıbbi deontoloji ve mesleki etik ilkeleri ile ahlak ve genel","x0":0.24840767560472748,"x1":0.772125369039677,"top":0.5087640936942156,"bottom":0.5219008131289048,"conf":1},{"text":"nezaket kurallarına uyulması, hasta hakları mevzuatma uygun olarak hareket edilmesi zorunludur.","x0":0.1950182437439017,"x1":0.7433853946375686,"top":0.520247619886431,"bottom":0.5340735450776745,"conf":1},{"text":"Mobil sağlık hizmetlerinin bu Genelge hükümlerine uygun olarak etkin bir şekilde kaksiz","x0":0.23805372203837113,"x1":0.7721962496820569,"top":0.5302278607710774,"bottom":0.548223456295531,"conf":1},{"text":"olarak yürütülmesinden il sağlık müdürlükleri sorumludur.","x0":0.19507186741691193,"x1":0.5256673520847626,"top":0.5435897435574076,"bottom":0.5552325582588467,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.24024640299499553,"x1":0.4455852189631504,"top":0.5551282053218307,"bottom":0.5654069767956419,"conf":1},{"text":"Prof. Dr. Emine ALP MESE","x0":0.5811088277422789,"x1":0.7433264903275363,"top":0.5769230768940018,"bottom":0.593162393133318,"conf":1},{"text":"Baka","x0":0.6098562627479958,"x1":0.6427104721036003,"top":0.6002906975713034,"bottom":0.6104651162896904,"conf":1},{"text":"YardImC151","x0":0.6529774139980394,"x1":0.7166324415974433,"top":0.6002906974903705,"bottom":0.6104651162087573,"conf":1},{"text":"Ek:","x0":0.19507186880252889,"x1":0.21971252524264565,"top":0.6453488371015623,"bottom":0.6555232558199492,"conf":1},{"text":"2- Mobil Sağlık Çantasında Bulunması Gereken Tıbbi Cihaz, Araç, Gereç Listesi","x0":0.19507186139616162,"x1":0.6529774197135928,"top":0.6670940171289826,"bottom":0.680341880376846,"conf":1},{"text":"Dağitım","x0":0.19701702263645385,"x1":0.24651480459525874,"top":0.7003754780872276,"bottom":0.7138687078798958,"conf":1},{"text":"Gereği:","x0":0.19712525641462872,"x1":0.24435318279575022,"top":0.7122093025138445,"bottom":0.7252906974266947,"conf":1},{"text":"A PLANI","x0":0.19712525784821133,"x1":0.25872689894850326,"top":0.7209302325644383,"bottom":0.7354700856848999,"conf":1},{"text":"453","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139536654862,"bottom":0.9563953485783364,"conf":1}]}