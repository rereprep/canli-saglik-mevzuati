0.37209302292248025,"conf":1},{"text":"Ilgi : 21/06/2017 tarihli ve 2017/11 sayıl Genelge.","x0":0.2073922008816966,"x1":0.5030800781630977,"top":0.39230769215119965,"bottom":0.40555555539906285,"conf":1},{"text":"Bulaşıcı hastalıklar, halk sağlığını etkileyen, zamanında müdahale edilmediğinde istenmeyen","x0":0.2546201373433801,"x1":0.7720739041350593,"top":0.4127906977649596,"bottom":0.424418604173025,"conf":1},{"text":"sosyal ve ekonomik sonuçları da olan hastalıklardır. Tüm dünyada olduğu gibi ülkemizde de değişen","x0":0.21149896905883311,"x1":0.7720739261349554,"top":0.42435897420127044,"bottom":0.4360465117450645,"conf":1},{"text":"çevre ve iklim koşulları, bölgesel düzeyde değişen hijyen uygulamaları, gıda işleme uygulamaları, alt","x0":0.20944558251143638,"x1":0.7741273125857827,"top":0.43589743590452135,"bottom":0.44786324787033327,"conf":1},{"text":"yapı sorunları gibi birçok faktör, solunum yoluyla bulaşan enfeksiyonlar, su ve gıda kaynaklı","x0":0.2094455817249485,"x1":0.7720739253001828,"top":0.44767441854553236,"bottom":0.45784883726391923,"conf":1},{"text":"enfeksiyonlar, zoonotik ve vektörel enfeksiyonlar gibi geniş bir yelpazede bulaşıcı hastalıkların ve","x0":0.2114989699052469,"x1":0.7741273134804811,"top":0.45769230774403047,"bottom":0.4696581197098425,"conf":1},{"text":"salgınların ortaya çıkmasına yol açmaktadır.","x0":0.21149897482778435,"x1":0.45379876623072796,"top":0.4694767441245955,"bottom":0.4796511628429825,"conf":1},{"text":"Bulaşıcı hastalıklara hazırlıklı olma ve bulaşıcı hastalıkların erken tespiti ile müdahale ve","x0":0.2525667344244828,"x1":0.7741273111159317,"top":0.4794871796485336,"bottom":0.4898255814429672,"conf":1},{"text":"kontrol önlemlerinin alınması aşamalarında Il Sağlık Müdürlüğü tarafından yapılacak çalışmalara yol","x0":0.20944558170351865,"x1":0.772073925278753,"top":0.4912790697087104,"bottom":0.5014534884270974,"conf":1},{"text":"gösterici olması amacıyla hazırlanan Bulaşicı Hastalıklar Ile Mücadele Rehberi\" ye