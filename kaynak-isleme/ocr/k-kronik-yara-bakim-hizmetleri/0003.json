{"lines":[{"text":"müdürlüğü ile sorumlu tabip birinci derecede sorumludur.","x0":0.16221766057112344,"x1":0.5954825439976652,"top":0.17877906992886206,"bottom":0.19632164221140358,"conf":1},{"text":"8. Bu Genelgede hüküm bulunmayan hållerde, kronik yara bakım ünite bulunan sağlık","x0":0.18882071186237598,"x1":0.8584816929357209,"top":0.19273481348707255,"bottom":0.21411818140568906,"conf":1},{"text":"tesisinin tabi olduğu mevzuat hükümleri ile ilgili diğer mevzuat hükümleri uygulanır.","x0":0.16214969050872113,"x1":0.7947257992082752,"top":0.20902873763934993,"bottom":0.2264522009761738,"conf":1},{"text":"C- KOMİSYONUN KURULMASI VE GÖREVLERİ","x0":0.1928731935594928,"x1":0.6223165898360383,"top":0.2378051080735133,"bottom":0.2559201068444563,"conf":1},{"text":"1. Kronik yara bakımı konusunda, birimlerin faaliyetleri ve geliştirilmesi konularında","x0":0.19289882447781292,"x1":0.8605280802592519,"top":0.2683669123930692,"bottom":0.28918574345913883,"conf":1},{"text":"müdürlük bünyesinde, Bakanlıkça Kronik Yara Bakım Bilimsel Komisyonu oluşturulur.","x0":0.16427104183254082,"x1":0.8172484651717942,"top":0.3443113771094738,"bottom":0.3619186042684893,"conf":1},{"text":"2. Komisyon, Genel Müdür veya görevlendireceği bir yetkilinin başkanlığında, bir genel","x0":0.19290063614166295,"x1":0.862585824628853,"top":0.3585323660756492,"bottom":0.37846936411500565,"conf":1},{"text":"Cerrahi Uzmanı olmak üzere en az 5 (beş) üyeden oluşur.","x0":0.16632443543432476,"x1":0.5954825458626425,"top":0.3924418603383726,"bottom":0.4055232559338482,"conf":1},{"text":"görevlendirilir.","x0":0.16599956109250927,"x1":0.28766840322828807,"top":0.4367892909570582,"bottom":0.4521988535631518,"conf":1},{"text":"Komisyon çalışmaları ile ilgili oylamaya katılamaz.","x0":0.16837782526423536,"x1":0.5544147823096556,"top":0.5115483319407127,"bottom":0.5278015398106871,"conf":1},{"text":"karar geçerli sayılır. Komisyonun sekretaryası Genel Müdürlük tarafından yürütülür.","x0":0.1682666587466968,"x1":0.7988603426191273,"top":0.5551247980936033,"bottom":0.5737152512357808,"conf":1},{"text":"altında veya ekinde belirtilir.","x0":0.1683778269978239,"x1":0.39219712145798674,"top":0.6030795553205341,"bottom":0.6163387512144606,"conf":1},{"text":"9. Komisyon kararları tavsiye niteliğindedir.","x0":0.19712525789493568,"x1":0.5338809020601223,"top":0.6176218990544541,"bottom":0.6322674420835604,"conf":1},{"text":"Ç- KRONIK YARA BAKIM ÜNİTESİ FAALİYET İZNİ USUL VE ESASLARI","x0":0.19896941739653923,"x1":0.8379619668268976,"top":0.6419979278658834,"bottom":0.662909978352922,"conf":1},{"text":"1. Kronik yara bakım ünitesi, Ek-1'de belirtilen asgari standartlara göre Bakanlıkça verilen","x0":0.2010712878105179,"x1":0.8728538125375055,"top":0.6732841747547067,"bottom":0.6947033621585332,"conf":1},{"text":"faaliyet izni ile kurulur.","x0":0.17248459565725144,"x1":0.35318275518528947,"top":0.6933139532491703,"bottom":0.7078699740788662,"conf":1},{"text":"Olması Gereken Bilgi ve Belgeler\" ile birlikte müdürlüğe yapılır.","x0":0.17445481216093772,"x1":0.6633167079793136,"top":0.7368138711922624,"bottom":0.7544352696742466,"conf":1},{"text":"oluşan denetim ekibi tarafından yerinde incelenir","x0":0.17442650280477334,"x1":0.5463238946625801,"top":0.8124093714320596,"bottom":0.8311730163985962,"conf":1},{"text":"4. Kronik yara bakımı ünitesi başvurusu, müdürlüğün uygun görüşü ile birlikte Bakanlığa","x0":0.2031756245558268,"x1":0.881039154965062,"top":0.8262917932681858,"bottom":0.8476162862782768,"conf":1}]}