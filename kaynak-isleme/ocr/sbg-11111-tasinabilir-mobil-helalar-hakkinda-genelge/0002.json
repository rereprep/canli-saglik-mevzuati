{"lines":[{"text":"T.C.","x0":0.4640657093878368,"x1":0.49897330524255334,"top":0.09593023261261568,"bottom":0.10901162752546578,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.39835729054994046,"x1":0.5708418856307578,"top":0.10897435881005424,"bottom":0.12354651133091044,"conf":1},{"text":"Temel Sağlık Hizmetleri Genel Müdürlüğü","x0":0.32617008540026243,"x1":0.6409721883160159,"top":0.12341297154875264,"bottom":0.14270993637346174,"conf":1},{"text":"Sayı : B.10.O.TSH.0.10.00.02","x0":0.1434969192983057,"x1":0.3636629423036148,"top":0.15107730263909525,"bottom":0.16740742416035226,"conf":1},{"text":"Konu: Taşınabilir (Mobil) Helalar","x0":0.14145985844624584,"x1":0.3924131176202653,"top":0.16557383042424767,"bottom":0.18227068536611302,"conf":1},{"text":"K-Q","x0":0.7864476380274443,"x1":0.809034907968449,"top":0.11046511632185974,"bottom":0.11773255803067728,"conf":1},{"text":"TSE-ISO-EN","x0":0.7659137568918981,"x1":0.8295687891039952,"top":0.11918604657573006,"bottom":0.1264534882845475,"conf":1},{"text":"9000","x0":0.7843942503666032,"x1":0.8110882956121785,"top":0.12790697678972884,"bottom":0.13517441849854628,"conf":1},{"text":"Bu helalar, bir tür sızdırmasız tip helalar olup insanların geçici olarak bulunacakları","x0":0.1926806054622205,"x1":0.821669072105585,"top":0.2237611772887037,"bottom":0.24668425802647787,"conf":1},{"text":"yerlerdeki alanlarda belirli bir süre zarfında burada bulundurularak daha sonra","x0":0.14150057680254968,"x1":0.8215963555019149,"top":0.23865291960217783,"bottom":0.25858067640890203,"conf":1},{"text":"kaldırılabilmektedir.","x0":0.13922843377336191,"x1":0.29202080508734035,"top":0.25304289769349175,"bottom":0.26906426756236523,"conf":1},{"text":"bir tuvalet hizmeti verilmesinin önlenerek çevre ve toplum sağlının korunması açısından da","x0":0.13926394750026516,"x1":0.8216555927541951,"top":0.28193706286873377,"bottom":0.30635646920533066,"conf":1},{"text":"büyük önem arz etmektedir.","x0":0.13935516894042313,"x1":0.3452395373571874,"top":0.2978669256253499,"bottom":0.3143069731910383,"conf":1},{"text":"Ancak bu türden tuvaletlerin ve servis hizmeti vereceklerin çevre ve toplum sağlığının","x0":0.19061856233449403,"x1":0.8197282136532666,"top":0.3096489021476394,"bottom":0.3362616779013454,"conf":1},{"text":"korunması açısından taşıması gereken bazı özelliklerinin bulunması gerekmekte olup bu","x0":0.13728283293387322,"x1":0.8195871691311601,"top":0.3269004038989294,"bottom":0.34937617144210265,"conf":1},{"text":"özellikler aşağıda belirtilmektedir:","x0":0.13757699827594888,"x1":0.3901437406252253,"top":0.3430232559562839,"bottom":0.35769230749343084,"conf":1},{"text":"1- Kabinler kurulup kaldırılabilecek şekilde dizayn edilmiş olmalıdır.","x0":0.1886305094138593,"x1":0.7026183354463941,"top":0.35677086759243704,"bottom":0.37832565962166287,"conf":1},{"text":"2- Kabin yıkanabilir, kolay temizlenebilir ve içerisinde istenmeyen bir birikinti veya","x0":0.19063755038862795,"x1":0.8195719931693868,"top":0.37164028171404917,"bottom":0.3941356639741027,"conf":1},{"text":"oluşuma sebebiyet vermeyecek şekilde yıkanarak temizlenebilecek şekilde","x0":0.21739224065151452,"x1":0.8196112929489753,"top":0.3856952085132904,"bottom":0.4091298711284226,"conf":1},{"text":"paslanmaz ve sızdırmaz malzemeden yapılmış olmalıdır.","x0":0.21952223163343768,"x1":0.6306615757069903,"top":0.4016780112461298,"bottom":0.41871643157281924,"conf":1},{"text":"3- Ihtiyaç halinde araç yaklaşması zor yerler için taşınabilir sıvı atık tankları","x0":0.1886605696415488,"x1":0.8175099912614853,"top":0.4153652068183076,"bottom":0.43721963842711087,"conf":1},{"text":"4- Iç genişlik en az 1 m., yükseklik ise en az 2 m. olmalıdır.","x0":0.188574480525481,"x1":0.6327564647776727,"top":0.4444768122902969,"bottom":0.4650712233088641,"conf":1},{"text":"5- Kabin içi dışarıdan görülmeyecek malzemeden yapılmış olmalıdır.","x0":0.18861654199601297,"x1":0.7005309439902315,"top":0.459190316025318,"bottom":0.4798234421456,"conf":1},{"text":"6- Kapı dış ve içten açılacak şekilde, içten kilitlenebilir ve kendiliğinden kapanabilir","x0":0.1886955306836969,"x1":0.819475419754699,"top":0.4744215380871488,"bottom":0.4952259106953011,"conf":1},{"text":"sıstemde yapılmalıdır.","x0":0.21355236194809413,"x1":0.38193018403068746,"top":0.49127906956879785,"bottom":0.5043604652967543,"conf":1},{"text":"7- Içeride birisinin bulunduğunu gösterir şekilde meşgul işareti bulunmalıdır.","x0":0.18865208964899344,"x1":0.7559059681490312,"top":0.5035480819742686,"bottom":0.5240952771480049,"conf":1},{"text":"8- Kabinin iç tarafında sıvı atık deposu olmalı, deponun dış tarafa doğru","x0":0.18653413162955507,"x1":0.8175536593370067,"top":0.516510800661821,"bottom":0.5408880244347013,"conf":1},{"text":"havalandırması bulunmalıdır.","x0":0.2111986165556736,"x1":0.43161497964562595,"top":0.5327205874808674,"bottom":0.549604072410922,"conf":1},{"text":"9- Kabin içi hava alma özelliğine uygun üretilmiş olmalıdır.","x0":0.18660068349502504,"x1":0.6327200726888355,"top":0.5475927266245777,"bottom":0.5676429857501161,"conf":1},{"text":"10- Ihtiyaç şekline göre gerekli pisuvar bulunmalıdır.","x0":0.18649581907996965,"x1":0.5752897643924696,"top":0.5619556440650882,"bottom":0.582747923756866,"conf":1},{"text":"bulunmalıdır.","x0":0.21544760820998693,"x1":0.3164357448797317,"top":0.6078515011247188,"bottom":0.6186859839208905,"conf":1},{"text":"de düşünülmelidir.","x0":0.21323452853360597,"x1":0.35350975723462436,"top":0.6364726886480205,"bottom":0.6524082425003301,"conf":1},{"text":"13- Kabinlerin ara temizlik ve kontrolü için sürekli yetecek sayıda görevli personel","x0":0.18454965667343326,"x1":0.8174707948233727,"top":0.6499705410585321,"bottom":0.6728119995014158,"conf":1},{"text":"bulundurulmalı ve atık deposunun dolması ihtimaline karşı gerekli vidanjör vb.","x0":0.21130017179527144,"x1":0.8154206500274925,"top":0.6657312669049958,"bottom":0.6872519027217818,"conf":1},{"text":"araçlar hazır olmalıdır.","x0":0.2131460016714954,"x1":0.3825211064718846,"top":0.6799800497131169,"bottom":0.6978452698074553,"conf":1},{"text":"14- Hizmetin güvenli, kaliteli, sağlıklı ve belirli bir standartta yürütülmesi açısından","x0":0.18455437009317033,"x1":0.8154268820433669,"top":0.6945111800048376,"bottom":0.7165009763091328,"conf":1},{"text":"mobil tuvalet hizmeti verecek kamu ya da özel sektör temsilcilerinin AB","x0":0.21128949769157765,"x1":0.8134275141951296,"top":0.7083272905861843,"bottom":0.7299111069188791,"conf":1},{"text":"Standartlarındaki (ISO 14001 ve 9001) ile TSE 13111 ve TSE 8358 vb. belgelere","x0":0.21320278354866187,"x1":0.8155150122484994,"top":0.7213740620860244,"bottom":0.7462836610967853,"conf":1},{"text":"sahip olmaları uygun olacaktır.","x0":0.21120527114991489,"x1":0.44182843566704194,"top":0.7390740484405832,"bottom":0.7572410322813952,"conf":1},{"text":"(2)","x0":0.45585215599981577,"x1":0.48870636535542034,"top":0.7848837209910372,"bottom":0.7994186044086721,"conf":1},{"text":"Mithatpaşa Cad.No: 3 Sıhhiye/ANKARA","x0":0.1312106328758355,"x1":0.3841644724373625,"top":0.873867379201523,"bottom":0.8875251406367465,"conf":1},{"text":"Telefon : 0 312 585 13 54 Faks: 0 312 434 44 49 Elektronik adres:www.saglik.gov.tr","x0":0.1291757576083651,"x1":0.6408223650869209,"top":0.8864957824099545,"bottom":0.9044924440933876,"conf":1}]}