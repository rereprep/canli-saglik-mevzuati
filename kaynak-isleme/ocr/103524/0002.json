Insan şarbonunda antiserum uygulamasının, 1960°hı yıllardan beri batı dünyasında terk edildiği,","x0":0.2032854284188752,"x1":0.841889109362799,"top":0.4461538463220902,"bottom":0.46075581379948116,"conf":1},{"text":"• Dünya Saglik Teskilâti tarafindan hazirlanan \"Guidelines for the Surveillance and Control of","x0":0.20318069354859622,"x1":0.8481678990447419,"top":0.46256845913634814,"bottom":0.48048821146924736,"conf":1},{"text":"Anthrax in Humans and Animals WHO/EMC/ZDI/98.6\" adl kılavuzda da tedavide","x0":0.22381930318622661,"x1":0.8459958921372543,"top":0.47819767421983284,"bottom":0.49145299161438283,"conf":1},{"text":"antibakteriyel şarbon antiserumunun önerilmediği,","x0":0.22381930343609516,"x1":0.5544147881039458,"top":0.4912790697737407,"bottom":0.5059829059702489,"conf":1},{"text":"/ Sadece sistemik şarbon olgularının tedavisinde, aşılanmış insanlardan hazırlanan spesifik","x0":0.19917864917868486,"x1":0.8459958761190567,"top":0.5085470088989358,"bottom":0.524786325138252,"conf":1},{"text":"antitoksik human gammaglobulinin, antimikrobiyel tedavi ile birlikte verilmesi konusunda","x0":0.22381930296355562,"x1":0.8459958919145834,"top":0.5247093024746611,"bottom":0.5393162396548786,"conf":1},{"text":"görüş birliğinin bulunduğu; ancak, dünyada da henüz bu antiserumu hazırlayıp kullanımını","x0":0.2258726718042128,"x1":0.8459959111576741,"top":0.5376068376326126,"bottom":0.5508720932101565,"conf":1},{"text":"sürekli kılan bir ülkenin bulunmadığı,","x0":0.22360594265880376,"x1":0.47669886414530427,"top":0.5480670545558335,"bottom":0.5655819134537681,"conf":1},{"text":"• Bacillus anthracis'in biyolojik silah olarak da kullanılabilme potansiyelinin olması","x0":0.20116899801893337,"x1":0.8460449822569548,"top":0.5682791270014389,"bottom":0.5843172081787184,"conf":1},{"text":"keyfiyetinden ötürü, Refik Saydam Hıfzıssıhha Merkezi Başkanlığında şarbonla ilgili her türlü","x0":0.22176589721686607,"x1":0.8459959095685514,"top":0.5828488373584353,"bottom":0.5974358973575589,"conf":1},{"text":"çalışmayı yapabilecek bir låboratuvar kurulmasının uygun olacağı kanaatine varılmıştır.","x0":0.22581032233562576,"x1":0.7926522688832944,"top":0.5956233314717058,"bottom":0.60928725714797,"conf":1},{"text":"Bu nedenle, şarbon hastalığının tedavisinde antiserum kullanımının uygulamadan kaldırılması","x0":0.22381930301343608,"x1":0.8459958919644639,"top":0.6148255815428906,"bottom":0.629487179748457,"conf":1},{"text":"ve dolayısıyla da hayvan kaynaklı şarbon antiserumu üretimine son verilmesi hususlarında takdir ve","x0":0.176516587905977,"x1":0.8460622885511931,"top":0.6272699053474812,"bottom":0.6432316078083977,"conf":1},{"text":"Uzm. Dr. Mehmet UGURLU","x0":0.6035003652921672,"x1":0.7948745109475859,"top":0.6795640269483292,"bottom":0.6933132212973083,"conf":1},{"text":"Genel Müdür","x0":0.6488706358417405,"x1":0.7412731021048715,"top":0.6918604652034586,"bottom":0.7051282052248626,"conf":1},{"text":"Uygun Görüşle Arz Ederim","x0":0.176591375824049,"x1":0.36755646784764706,"top":0.7076923076059514,"bottom":0.7223837207680524,"conf":1},{"text":"/ /2005","x0":0.22176591544235558,"x1":0.29979465776092984,"top":0.719476744156008,"bottom":0.734188034499203,"conf":1},{"text":"Müstesar","x0":0.21305614217950122,"x1":0.2900701704127261,"top":0.7618326738165869,"bottom":0.7755817002536779,"conf":1},{"text":"Prof. Dr. Recep AKDAG","x0":0.4289648588279957,"x1":0.5937452414940704,"top":0.8428830097851162,"bottom":0.8601819788256854,"conf":1},{"text":"Bakan","x0":0.49060500049993516,"x1":0.534035656370292,"top":0.858674957966323,"bottom":0.8695227163980429,"conf":1}]}