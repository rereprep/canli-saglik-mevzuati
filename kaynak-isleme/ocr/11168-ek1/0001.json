,{"text":"2012/46 sayılı Genelge ile Bakanlık internet sitesinde ilan edilmişti. Ancak 30.11.2012 tarihli","x0":0.14784395195306943,"x1":0.9137576895219477,"top":0.27754056343705535,"bottom":0.29376601177181194,"conf":1},{"text":"ve 28483 sayılı Resmi Gazetede yayımlanarak yürürlüğe giren Sağlık Hizmetleri Lisans","x0":0.1478439524650627,"x1":0.913757690033941,"top":0.2950469683628084,"bottom":0.31104651153082186,"conf":1},{"text":"Yönetmeliğinin yayınlanması ile 2012/46 sayılı Genelge'nin geçerliliği kalmamıştır.","x0":0.14989734372046765,"x1":0.841889103679518,"top":0.3108454314040989,"bottom":0.3270708797388555,"conf":1},{"text":"Sağlık Hizmetleri Lisans Yönetmeliği 5 inci maddesi 1 inci fikrası ve 6 ıncı maddesi","x0":0.20527032677212625,"x1":0.9158884241972094,"top":0.32408123111301335,"bottom":0.34424206578623595,"conf":1},{"text":"1 inci fikrası gereğince Lisansların belirlenmesi ve ilanı kapsamında yeni düzenleme","x0":0.14776109082557345,"x1":0.9138454762044985,"top":0.34032055776753034,"bottom":0.3608674717289131,"conf":1},{"text":"yapılması gerekmiştir. Bu bağlamda;","x0":0.14568912455679053,"x1":0.4498361169683809,"top":0.35903238751961986,"bottom":0.37650459277532544,"conf":1},{"text":"A sınıfinda; o ildeki devlete ait üniversite hastaneleri, eğitim ve araştırma hastaneleri","x0":0.20739217888917916,"x1":0.9137577181451045,"top":0.37645348802749745,"bottom":0.3941075999401735,"conf":1},{"text":"ve devlet hastaneleri,","x0":0.14784394105339413,"x1":0.3223819314576061,"top":0.39239965862747095,"bottom":0.40862510696222754,"conf":1},{"text":"B sınıfında; o ildeki eğitim yetkisi almış olan vakıf üniversitesi tıp fakültesi","x0":0.20533879685278145,"x1":0.913757712089987,"top":0.408430232649422,"bottom":0.42442356919748214,"conf":1},{"text":"hastaneleri,","x0":0.14564075409263172,"x1":0.2445029828547562,"top":0.4239862396272942,"bottom":0.44229283009765796,"conf":1},{"text":"C sınıfında; o ildeki özel hastaneler,","x0":0.20721449997226335,"x1":0.5155998974733013,"top":0.4402457909143306,"bottom":0.457936770361276,"conf":1},{"text":"A sınıfında bulunan hastaneler B ve C sınıfinda bulunan merkez kontenjanları için","x0":0.20729320309990387,"x1":0.9138526100622756,"top":0.4564968501699044,"bottom":0.47423427054274114,"conf":1},{"text":"başvurabilecektir. B sınıfinda bulunan hastaneler, hem B sınıfi için hem de C sınıfinda","x0":0.14572695192799187,"x1":0.9138121552369818,"top":0.473519594400444,"bottom":0.49209720266044465,"conf":1},{"text":"bulunan kontenjanlar için başvuruda bulunabilecektir. C sınıfında bulunan hastaneler ise","x0":0.14579056659247733,"x1":0.9137576801426358,"top":0.4897523487527041,"bottom":0.5059777970874607,"conf":1},{"text":"yalnızca kendileri için açılan kontenjanlara başvuruda bulunabilecektir.","x0":0.14579055383658635,"x1":0.7268993842378734,"top":0.507258753008235,"bottom":0.5232558138540311,"conf":1},{"text":"Planlama kapsamında akciğer, kalp nakli için yeni merkez açılmayacaktır. Başvuruda","x0":0.20533879680372236,"x1":0.913757712040928,"top":0.5230572164285224,"bottom":0.5406976747545934,"conf":1},{"text":"bulunabilecek iller ve kontenjanlar aşağıda belirtildiği gibidir.","x0":0.145687586994177,"x1":0.6530808388647424,"top":0.5389652770644755,"bottom":0.5569062307565136,"conf":1},{"text":"BÖBREK NAKLİ MERKEZLERI IÇIN","x0":0.3817663821815735,"x1":0.7373446711214134,"top":0.5699892854089373,"bottom":0.5889466205577234,"conf":1},{"text":"ILLER","x0":0.2176105155909318,"x1":0.27314923672159774,"top":0.6045344374840618,"bottom":0.6163957947779767,"conf":1},{"text":"ANKARA","x0":0.20941517722634673,"x1":0.28339796424343183,"top":0.6190888268584095,"bottom":0.6309111730904711,"conf":1},{"text":"ISTANBUL","x0":0.20123203509266388,"x1":0.28952771828540996,"top":0.6351744187703986,"bottom":0.6468023253872871,"conf":1},{"text":"IZMIR","x0":0.21765913825006986,"x1":0.27104722704767137,"top":0.6497093024498467,"bottom":0.6627906974956476,"conf":1},{"text":"TOPLAM","x0":0.20523464306090577,"x1":0.28552