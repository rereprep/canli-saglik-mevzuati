{"lines":[{"text":"T.C.","x0":0.5071868578789873,"x1":0.5420944560400505,"top":0.09011627924104171,"bottom":0.1031976741538918,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.44558521527629397,"x1":0.6139630373588874,"top":0.10170940141767404,"bottom":0.11627906949467015,"conf":1},{"text":"Temel Sağlık Hizmetleri Genel Müdürlüğü","x0":0.3735686608168601,"x1":0.6839220610138258,"top":0.11790938764234316,"bottom":0.13385650377685632,"conf":1},{"text":"Sayı : B100TSH0110002","x0":0.19301848376205089,"x1":0.392197121782097,"top":0.161337209105881,"bottom":0.17441860483383742,"conf":1},{"text":"Konu : Kuduz ve Kuduz Riskli Temas","x0":0.1949576626825911,"x1":0.47650359462669434,"top":0.1812824170269487,"bottom":0.1948711642308083,"conf":1},{"text":"Durumlarında Yaklaşım","x0":0.2541392166997088,"x1":0.42961239414713737,"top":0.19476995295307742,"bottom":0.212847480512798,"conf":1},{"text":"17.08.00 11798","x0":0.5209248181229947,"x1":0.7173698819065781,"top":0.20709887440943742,"bottom":0.229293594946672,"conf":1},{"text":"Ilgi:","x0":0.18891170489605033,"x1":0.2238193007507669,"top":0.30523255817005857,"bottom":0.31976744158769344,"conf":1},{"text":"09/05/2001 tarihli ve B100TSH0110002 / 7755 sayılı Kuduz Korunma ve Kontrol","x0":0.24212629341098607,"x1":0.8625723474844442,"top":0.30360618653318894,"bottom":0.32304293148396424,"conf":1},{"text":"Yönergesi.","x0":0.24227872330617062,"x1":0.32445638941331145,"top":0.3197078911443201,"bottom":0.33436187625748026,"conf":1},{"text":"Kuduz hastalığı, etkeni ve patogenezi yaklaşık yüz yıl önce belirlenmiş olmasına","x0":0.24219154604746684,"x1":0.8604625861278591,"top":0.34784686704425005,"bottom":0.3665711162074945,"conf":1},{"text":"rağmen, bugün için de öldürücü olan ve ülkemizde halen önemli bir halk sağlığı problemi","x0":0.18878611482617075,"x1":0.8604974195703516,"top":0.36259486732163904,"bottom":0.38138837932365477,"conf":1},{"text":"olmaya devam eden bir hastalıktır.","x0":0.1889116997422689,"x1":0.4394250555924333,"top":0.37777777765435216,"bottom":0.3924418603037787,"conf":1},{"text":"Hastalığa yakalanmama konusunda, korunma veya hastalık etkeni ile karşılaşmayı","x0":0.2401142491119597,"x1":0.8584551438179754,"top":0.40596351883303394,"bottom":0.42475629805452786,"conf":1},{"text":"takiben enfeksiyonun durdurulması büyük önem arz etmekte olup, bu hususlarla alâkalı","x0":0.1867312054888274,"x1":0.8584509975884722,"top":0.42128230676222156,"bottom":0.4399150602485288,"conf":1},{"text":"uygulamalar ilgi Yönerge ile düzenlenmiş ve sağlık personelinin kolay ulaşabilmesi amacıyla","x0":0.18877314183810323,"x1":0.8584691793796692,"top":0.43524950203597457,"bottom":0.45453078095594435,"conf":1},{"text":"da kitapçık haline getirilerek dağıtımları sağlanmıştır.","x0":0.1867084049821669,"x1":0.5710110262908316,"top":0.45038114528720763,"bottom":0.4680983225233897,"conf":1},{"text":"Kuduzla ilgili bütün uygulamaların ilgi Yönerge doğrultusunda yapılması istenmesine","x0":0.2401127186573773,"x1":0.858449222079479,"top":0.4789444286815827,"bottom":0.49786944014523704,"conf":1},{"text":"ve keyfiyetin bir mevzuat hükmü olmasına rağmen, özellikle ısırık ve/veya temas sonrası","x0":0.18879696122800926,"x1":0.8584344729184189,"top":0.4931582304767561,"bottom":0.5108950142787559,"conf":1},{"text":"uygulanan proflakside, kuduz şüpheli olup olmadığının yeterince sorgulanmadığı ve hemen","x0":0.1867231962542216,"x1":0.8584415860951375,"top":0.5081690382871358,"bottom":0.5276047496831819,"conf":1},{"text":"hemen bütün ısırık ve/veya temaslıların kuduz şüpheli olarak değerlendirilip proflaksiye","x0":0.18674088024694338,"x1":0.8584094530014401,"top":0.5231057293339729,"bottom":0.5410925469791845,"conf":1},{"text":"alındığı müşahede edilmiştir.","x0":0.1868583150328441,"x1":0.39835729049833496,"top":0.5392441861905094,"bottom":0.5538461536679002,"conf":1},{"text":"Aşı tedarikinde dışa bağımlı olmamız ve kuduz aşısının da bütün aşı maliyeti içinde","x0":0.24009556610514593,"x1":0.8584458338037176,"top":0.5665323732590545,"bottom":0.5850405532415578,"conf":1},{"text":"oldukça önemli bir kalemi oluşturması yanında, yapılan bazı uygulamaların bir mantık","x0":0.18876563685287281,"x1":0.8584373193744115,"top":0.579896916976257,"bottom":0.599124217114812,"conf":1},{"text":"çerçevesine dahil edilememesi ve nihayet bilimselliğinin de bulunmaması sebebiyle, kuduzla","x0":0.18471070925369606,"x1":0.8584206755050185,"top":0.5959210949287372,"bottom":0.6137073801335023,"conf":1},{"text":"alâkalı bütün işlemlerde ve özellikle de profilaksi uygulamalarında ilgi Yönerge hükümlerine","x0":0.18673516308105906,"x1":0.8584391613192317,"top":0.6098970313969481,"bottom":0.6284969181689082,"conf":1},{"text":"titizlikle uyulması hususlarında bilgilerinizi, keyfıyetin, konunun muhataplarına ulaştırılması","x0":0.18466256990457977,"x1":0.8584490699612606,"top":0.6242020206761985,"bottom":0.644061839191813,"conf":1},{"text":"için de ilgililere emirlerinizi rica ederim.","x0":0.1827515426429019,"x1":0.47638603342519104,"top":0.6395348838491345,"bottom":0.6542735038898977,"conf":1},{"text":"Uzl Dr. Turan BUZGAN","x0":0.6324435341081162,"x1":0.8295687856290502,"top":0.6816239320002649,"bottom":0.7021367525130855,"conf":0.5},{"text":"Bakan a.","x0":0.6916257815016673,"x1":0.7621765501682404,"top":0.7009835192211256,"bottom":0.7146536996152248,"conf":1},{"text":"Genel Müdür V.","x0":0.6694045181619578,"x1":0.7905544138634296,"top":0.7149572650198753,"bottom":0.7296511626258365,"conf":1},{"text":"DAĞITIM :","x0":0.18480492674180884,"x1":0.2772073930049399,"top":0.7238372091759326,"bottom":0.7414529912697306,"conf":1},{"text":"81 İl Valiliğine","x0":0.18427654856209985,"x1":0.30017396130618146,"top":0.7456777697392539,"bottom":0.7644389065359933,"conf":1},{"text":"Bulaşıcı ve Salgın Hastalıklar Kontrolu Daire Başkanlığı","x0":0.1805252803766384,"x1":0.45600384175955483,"top":0.8327529900247607,"bottom":0.8490700364266077,"conf":1},{"text":"Zoonoz ve Paraziter Hastalıklar Şube Mudurluğu","x0":0.18