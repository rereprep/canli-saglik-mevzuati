{"lines":[{"text":"Ek-3","x0":0.4394250517090476,"x1":0.4763860363692228,"top":0.09011627891235396,"bottom":0.1017441861355256,"conf":1},{"text":"KAMU HİZMET STANDARTLARI TABLOSUNUN DOLDURULMASINDA","x0":0.18258275740171326,"x1":0.7332328962105668,"top":0.13019979562787265,"bottom":0.14858761620590166,"conf":1},{"text":"DIKKAT EDILECEK HUSUSLAR","x0":0.33046936167214774,"x1":0.5832920162394373,"top":0.14520504537938084,"bottom":0.15973945766560127,"conf":1},{"text":"1. TABLONUN BIÇIMI ILE ILGILİ HUSUSLAR","x0":0.19096510078141457,"x1":0.5462012234386092,"top":0.20042735026226066,"bottom":0.21367521351012397,"conf":1},{"text":"a) Basılı olarak oluşturulacak tablolarda \"Arial\" yazı tipi ve en az 14 karakter","x0":0.18673557245874403,"x1":0.7578587256101951,"top":0.2445525843198082,"bottom":0.26350718169514,"conf":1},{"text":"boyutunun kullanılması esastır. Büyük veya küçük harf kullanılması ihtiyarîdir. Formlar A3","x0":0.14162027350572884,"x1":0.7557055343789906,"top":0.26052176215241163,"bottom":0.27512727615711086,"conf":1},{"text":"veya daha büyük kağıt boyutunda oluşturulacaktır.","x0":0.1416837770227575,"x1":0.4722792616906082,"top":0.27470930219576095,"bottom":0.2863372094189325,"conf":1},{"text":"b) A3 kağıt boyutunda yatay olarak oluşturulacak tablolarda;","x0":0.1888122453190532,"x1":0.5873735869057369,"top":0.30606699132296766,"bottom":0.3197943571264824,"conf":1},{"text":"- Tablo başlığı koyu 18, Sütun başlıkları koyu en az 14 yazı karakteri boyutunda","x0":0.18679097112493434,"x1":0.7577654848511284,"top":0.34435566721131816,"bottom":0.3609553264382166,"conf":1},{"text":"olacaktır. Sütun genişlikleri alttaki tabloda belirtilen şekilde hazırlanacaktır.","x0":0.1395386718487063,"x1":0.6366552219852125,"top":0.35725578633721944,"bottom":0.37368928859969364,"conf":1},{"text":"- Sıra Numarası; dikey ve yatay ortalı olarak,","x0":0.18468830954855275,"x1":0.484758928036168,"top":0.3848364560868349,"bottom":0.40089957080736693,"conf":1},{"text":"- Hizmetin Adı; dikeyde ortalı, yatayda ise sola yaslı olarak,","x0":0.18470567757923936,"x1":0.5812263267984618,"top":0.4112127236097385,"bottom":0.4280979822110005,"conf":1},{"text":"- İstenen Belgeler; sola yaslı ve l'den itibaren sıra numarası verilerek, hizmetle ilgili","x0":0.1867953955647168,"x1":0.7577582484025341,"top":0.4309235271080438,"bottom":0.446299055688147,"conf":1},{"text":"bir açıklama yazılacak ise istenen belgelerin altında bir satır aralığı bırakılarak paragraf","x0":0.1416837769569323,"x1":0.7577002064106242,"top":0.44615384598106234,"bottom":0.45940170922892554,"conf":1},{"text":"girintisi olmadan,","x0":0.14168377733840784,"x1":0.25872690004165566,"top":0.45930232551296557,"bottom":0.4696581196370798,"conf":1},{"text":"- Hizmetin Tamamlanma Süresi; dikey ve yatay ortalı, koyu olarak,","x0":0.18471139962546504,"x1":0.6325636484942112,"top":0.48364624288493985,"bottom":0.5000509963498587,"conf":1},{"text":"yazılacaktır.","x0":0.18648536732896,"x1":0.2712702936823316,"top":0.5191743764193346,"bottom":0.5321327025145245,"conf":1},{"text":"KAĞIT","x0":0.15811088288584152,"x1":0.21149897337699222,"top":0.5581395348536825,"bottom":0.5726744182713174,"conf":1},{"text":"BOYUTU","x0":0.1498313522104915,"x1":0.21977850384661746,"top":0.5739272924783969,"bottom":0.5859564284188182,"conf":1},{"text":"A3 için","x0":0.1601642700454807,"x1":0.21149897403751944,"top":0.5944444446318382,"bottom":0.6061046512554047,"conf":1},{"text":"SIRA","x0":0.23819301810627977,"x1":0.2792607803773721,"top":0.5610465114599705,"bottom":0.5726744186831422,"conf":1},{"text":"NO","x0":0.24435318223868563,"x1":0.27310061628971954,"top":0.5741279068050809,"bottom":0.5857558140282525,"conf":1},{"text":"1 cm","x0":0.24137604879253197,"x1":0.27804617085841626,"top":0.5940056130855893,"bottom":0.6058440263893231,"conf":1},{"text":"HIZMETIN","x0":0.3058443270319271,"x1":0.3861474592055875,"top":0.5606547807967298,"bottom":0.5730661494031668,"conf":1},{"text":"ADI","x0":0.3305954825398569,"x1":0.3634