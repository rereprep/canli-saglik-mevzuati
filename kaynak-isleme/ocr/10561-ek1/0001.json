{"lines":[{"text":"insanliğan hismetirule","x0":0.18275153852880568,"x1":0.3100616029529999,"top":0.1482558140233553,"bottom":0.15555555554012068,"conf":0.5},{"text":"S9EG","x0":0.1889117066633708,"x1":0.31416837536306663,"top":0.15552325573289116,"bottom":0.18313953487848245,"conf":0.30000001192092896},{"text":"T.C.","x0":0.4928131406082766,"x1":0.5379876804902861,"top":0.1497093019533664,"bottom":0.16569767469089225,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.41683778482953976,"x1":0.6139630363504739,"top":0.16279069802198487,"bottom":0.18168604613886774,"conf":1},{"text":"T.C. SAĞLIK BAKANLIĞI İdari ve Mali İşler Dairesi Başkanlığı","x0":0.1598269863756815,"x1":0.6841344772122897,"top":0.17680313497510813,"bottom":0.201788569026361,"conf":1},{"text":"2 Mayis 1920 - 2000","x0":0.17043121253290183,"x1":0.3162217646744904,"top":0.19040697674734453,"bottom":0.1991452992906273,"conf":1},{"text":"Sayı : B100IMi000010/","x0":0.17018644041800887,"x1":0.3616648144886804,"top":0.2561482328266418,"bottom":0.2724923619488624,"conf":1},{"text":"Konu : Arşiv hizmetleri","x0":0.17043120840326273,"x1":0.35318275443041286,"top":0.27179487157800286,"bottom":0.2863372091423245,"conf":1},{"text":"ANKARA","x0":0.7309382268768204,"x1":0.8091028406859101,"top":0.2585370921137,"bottom":0.2734396520298784,"conf":1},{"text":"20 KASIM 200U","x0":0.6929329252928301,"x1":0.849090136356681,"top":0.3024678708501847,"bottom":0.3248194104946054,"conf":1},{"text":"6774","x0":0.5092402462754174,"x1":0.5749486649866266,"top":0.31395348832396497,"bottom":0.33139534875116927,"conf":1},{"text":"GENELGE","x0":0.4722129589527099,"x1":0.5585878621968576,"top":0.35445263564558704,"bottom":0.36938457362134836,"conf":1},{"text":"2000/.12.5","x0":0.47227926411466725,"x1":0.5626283346533,"top":0.3662790697737407,"bottom":0.38081395319137556,"conf":1},{"text":"Arşıvler bir Milletin tapu senedi, kimlıği, hatıratı ve hususiyetleri olduğu gibi, onu bu","x0":0.2217659019839326,"x1":0.8583162333302898,"top":0.3968023257306523,"bottom":0.41153846132755534,"conf":1},{"text":"günden yarınlara bağlıyan temel dayanağı ve bu hüviyeti ile de şüphesiz ki en değerli","x0":0.17043120114762914,"x1":0.858316231873332,"top":0.40982906005165387,"bottom":0.42441860449463764,"conf":1},{"text":"Bu cümleden olmak üzere, 04.04.1988 tarihli Resmi Gazetede yayımlanarak","x0":0.22372928669226547,"x1":0.8604548265766367,"top":0.4490572247780231,"bottom":0.4675356069212231,"conf":1},{"text":"yürürlüğe giren 316 Sayılı Kararname \"Muhafazasına Lüzum Kalmayan Evrak ve","x0":0.17043120100265174,"x1":0.8583162317283546,"top":0.46366279103064567,"bottom":0.4796511621379591,"conf":1},{"text":"Malzemenin Yok Edilmesi Hakkında Kanun Hükmünde Kararname\" 28.09.1988 tarihinde","x0":0.17043124240625043,"x1":0.8583161993288623,"top":0.4767441860164733,"bottom":0.49145299110070173,"conf":1},{"text":"Kanunlaşmıştır. Buna bağlı olarak da, devlet Arşiv Hizmetleri Hakkında Yönetmelik","x0":0.17248458925539936,"x1":0.8603696199811022,"top":0.49273255828897367,"bottom":0.5072674417066085,"conf":1},{"text":"16.05.1988 tarihli Resmi Gazetede yayımlanarak yürürlüğe girmiş ve buna göre, yapılan","x0":0.17240734192469107,"x1":0.8583894337522682,"top":0.5051586284095698,"bottom":0.5216465406446669,"conf":1},{"text":"mevzuat düzenlemeleri çerçevesinde, 3473 Sayılı Kanun kapsamında yer alan Kurum ve","x0":0.17043120117042285,"x1":0.8583162318961257,"top":0.5203488373581971,"bottom":0.5350427349641584,"conf":1},{"text":"Kuruluşlar Kurum/Birim Arşivlerini kurmakla mükellef tutulmuşlardır.","x0":0.1724021096537356,"x1":0.6879774032719528,"top":0.5318458615350456,"bottom":0.54945131052687,"conf":1},{"text":"Bakanlığımızda ise, Kanundan kaynaklanan yükümlülüğün yerine getirilmesi","x0":0.22381929006955809,"x1":0.8603696214159156,"top":0.5610465117770399,"bottom":0.5756410259228503,"conf":1},{"text":"amacıyla, 17.02.1989 tarih ve APKIH.9300/371 Sayılı Makam Oluru ile Arşiv Yönetmeliği","x0":0.17248458927079918,"x1":0.8603696199965019,"top":0.5755813954980297,"bottom":0.5901709399410136,"conf":1},{"text":"yürürlüğe konulmuş, Kurum Arşivi çalışmalarına ise, 1989 tarihinde başlanılmış, birimler","x0":0.17043122041331393,"x1":0.8603696007365833,"top":0.5884615381933984,"bottom":0.6047008544327147,"conf":1},{"text":"nezdinde birim arşivi oluşturulması çalışmaları başlamış ve hizmetlerin Kurum Arşivi","x0":0.1724845892614427,"x1":0.8603696199871456,"top":0.6029914526858865,"bottom":0.617732557985616,"conf":1},{"text":"bazında genel sevk ve idari işlemlerinin yürütülmesi görevi de \"181 Sayılı Kanun","x0":0.172484592491358,"x1":0.860369623217061,"top":0.6148255817549674,"bottom":0.6308139528622807,"conf":1},{"text":"Hükmündeki Kararnameden kaynaklanan yetki ve yükümlülük kapsamında\" Idari ve Mali","x0":0.17244008772186822,"x1":0.8604399560571538,"top":0.6290676984760822,"bottom":0.6463682814270328,"conf":1},{"text":"İşler Dairesi Başkanlığına verilmiştir.","x0":0.17248459857188855,"x1":0.4558521568586177,"top":0.6438953489833094,"bottom":0.6585470085983288,"conf":1},{"text":"Bu meyanda, Bakanlığımız kurum arşivi hizmetlerini yürütmek üzere, kurum arşivi","x0":0.2238192932179916,"x1":0.8603696245643491,"top":0.670058139867855,"bottom":0.6860465109751683,"conf":1},{"text":"oluşturulmuş, ancak söz konusu yer, mevcut durumuyla arşiv hizmetlerinden beklenen","x0":0.1724845892800872,"x1":0.8603696200057902,"top":0.684593023404471,"bottom":0.6991452987442334,"conf":1},{"text":"verim ve amaçtan uzak, bir arşivleme birimi olmaktan öte, evrak dosyalarının hiçbir","x0":0.17248458934429045,"x1":0.8603696200699933,"top":0.6991279071239604,"bottom":0.7136752135760025,"conf":1},{"text":"ayıklama ve kayda tabi tutulmadan, rastgele konulduğu bir depo görünümünde","x0":0.17248458923454985,"x1":0.8603696199602529,"top":0.7122093024712722,"bottom":0.7269230772583274,"conf":1},{"text":"bulunmaktadır.","x0":0.1743003345698693,"x1":0.3001104434235243,"top":0.7252633267064644,"bottom":0.7384860480019435,"conf":1},{"text":"Bu haliyle, Kanundan kaynaklanan yükümlülükleri yerine getirmek mümkün","x0":0.2238192900749571,"x1":0.8603696214213146,"top":0.7542735040246862,"bottom":0.768895348683171,"conf":1},{"text":"olmadığı gibi, Biriminizce buraya konulan ve zaman içerisinde ihtiyaç duyulacak herhangi","x0":0.17248461525930978,"x1":0.8624229955825791,"top":0.7658119658271069,"bottom":0.7834302323647651,"conf":1},{"text":"bir evraka ulaşmanızın da imkanı yoktur.","x0":0.17453797934586818,"x1":0.4866529855217108,"top":0.781976744058589,"bottom":0.7936046512817606,"conf":1},{"text":".1..","x0":0.7289527732499252,"x1":0.7679671444092124,"top":0.8546511627969965,"bottom":0.8691860462146314,"conf":0.5}]}