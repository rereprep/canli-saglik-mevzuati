{"lines":[{"text":"80","x0":0.19503022380210952,"x1":0.25691713229985647,"top":0.11366993874517317,"bottom":0.13935617833007152,"conf":1},{"text":"SIL","x0":0.22792607738952136,"x1":0.27515400377064286,"top":0.12645348842656912,"bottom":0.1395348833394192,"conf":0.5},{"text":"T.C. SAGLIK BAKANLIĞI","x0":0.16427104465706333,"x1":0.3264887072423207,"top":0.1380341881170981,"bottom":0.1512820513649613,"conf":1},{"text":"2 Mayis 1920","x0":0.17453798647829075,"x1":0.2669404527414218,"top":0.14825581395282572,"bottom":0.15697674416642793,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.41478439210428675,"x1":0.6036960976287729,"top":0.12350427343789794,"bottom":0.1410256409592654,"conf":1},{"text":"İdari ve Mali İşler Dairesi Başkanlığı","x0":0.3426660440186304,"x1":0.6758263337046189,"top":0.1396442982302799,"bottom":0.15921039076218513,"conf":1},{"text":"Kurum Arşivimizi mevcut kullanımsız ve amaca hizmet etmeyecek görüntüsünden,","x0":0.22368243976564597,"x1":0.8461380044006217,"top":0.20294135660280466,"bottom":0.2209854110091256,"conf":1},{"text":"ımkanlar dahılinde kurtararak amacına, niteliğine uygun görüntü, tefrişat, dizayn, doküman","x0":0.1724845827927653,"x1":0.843942521525572,"top":0.21794871775475388,"bottom":0.23255813937883152,"conf":1},{"text":"... vb. bakımdan mümkün olan en iyi şartlara kavuşturmak amacıyla, Idari ve Mali Işler","x0":0.17659135746100124,"x1":0.8439425231955839,"top":0.23110465131149605,"bottom":0.24572649596998097,"conf":1},{"text":"Dairesi Başkanlığı (Kurum Arşiv Şube Müdürlüğü) koordinatörlüğünde hızlı bir şekilde","x0":0.17453798854923774,"x1":0.843942503881387,"top":0.2440170938802495,"bottom":0.25872093007675767,"conf":1},{"text":"organizasyon çalışmalarının","x0":0.17659138299421065,"x1":0.4312114933918262,"top":0.25726495714804243,"bottom":0.26889534840752116,"conf":0.5},{"text":"başlatılması planlanmış","x0":0.43531827534421724,"x1":0.6509240238079321,"top":0.258547008423996,"bottom":0.27051282038980806,"conf":1},{"text":"bu çalişmalar","x0":0.7125256682196708,"x1":0.845995892141201,"top":0.2601744184690673,"bottom":0.27180232569223894,"conf":1},{"text":"tamamlanmadan Biriminizce buraya devredilmesi planlanan hiçbir evrak ve doküman","x0":0.17442902818512832,"x1":0.8440756176557298,"top":0.2687385800305373,"bottom":0.28604891817312783,"conf":1},{"text":"Kurum Arşivine kabul edilmeyecektir.","x0":0.17439175691064285,"x1":0.451895253701094,"top":0.2833594313071941,"bottom":0.29917036845506817,"conf":1},{"text":"Bu nedenle, Kurum Arşivinin ilk önce fiziki durumu ve görünümünün düzeltilmesi","x0":0.22578787883188087,"x1":0.8460721565298857,"top":0.3097260676284306,"bottom":0.32498745198924106,"conf":1},{"text":"ve belli bir niteliğe kavuşturulması gerekmektedir. Bunun için, bir takvim çerçevesinde,","x0":0.17238104189388684,"x1":0.8440910919855208,"top":0.3220413673742476,"bottom":0.3406457372306011,"conf":1},{"text":"burada mevcut evrakların ayıklama ve imha işlemlerine tabi tutularak temizlenmesi ve belli","x0":0.17453797087810183,"x1":0.8459959096109086,"top":0.33846153866556794,"bottom":0.35319767426247095,"conf":1},{"text":"bir düzen çerçevesinde arşivlenmesi çalışmasının en kısa sürede tamamlanması zarureti","x0":0.17652056075253,"x1":0.8439932063748848,"top":0.3512676403873909,"bottom":0.36587393363366827,"conf":1},{"text":"vardır.","x0":0.17427471899620192,"x1":0.22655288941462412,"top":0.3641536520968732,"bottom":0.37590065041918885,"conf":1},{"text":"Bilgilerinizi ve durumun hassasiyetle değerlendirilerek, Biriminizce bu güne kadar","x0":0.22576859624060375,"x1":0.8440346177108086,"top":0.39031291296002224,"bottom":0.4059529956861341,"conf":1},{"text":"Kurum Arşivine devredilmiş olan evrakları konu, işlem ve içerik bakımından","x0":0.17646917657978747,"x1":0.844040939753344,"top":0.40328456043616,"bottom":0.4200226923586945,"conf":1},{"text":"duzenleyerek yukarıda belirtildiği şekilde ayıklama çalışmaları neticesi arşivlenmesi","x0":0.17453797092470616,"x1":0.845995909657513,"top":0.41860465131096114,"bottom":0.43333333357628356,"conf":1},{"text":"için, Biriminiz hizmetleri hakkında (mümkünse her başkanlık için ayrı ayrı olmak üzere)","x0":0.17240214444903534,"x1":0.846066943208671,"top":0.43090848625528644,"bottom":0.44715833366739577,"conf":1},{"text":"yeterli bilgiye sahip iki (2) personel isminin çalışmaya esas gerekli planlamayı yapmak","x0":0.1744908353155765,"x1":0.8440046530254843,"top":0.44418488490207875,"bottom":0.45887625730886716,"conf":1},{"text":"üzere 13.12.2000 tarihine kadar Idari ve Mali Işler Dairesi Başkanlığına bildirilmesi","x0":0.17444183299707433,"x1":0.8460701092638896,"top":0.4571924846594324,"bottom":0.4744778495766332,"conf":1},{"text":"hususunda gereğini önemle rica ederim.","x0":0.17650109586613927,"x1":0.4743840062290379,"top":0.4708457484233408,"bottom":0.48467983038286144,"conf":1},{"text":"tonus","x0":0.6796714576467723,"x1":0.7618069821889569,"top":0.5188953490084192,"bottom":0.5377906971253019,"conf":0.30000001192092896},{"text":"Prof. Dr. Haluk TOKUÇOĞLU","x0":0.6218523196785901,"x1":0.8401812545937106,"top":0.5372379132494006,"bottom":0.5564545892930496,"conf":1},{"text":"Bakan a","x0":0.6958210794894771,"x1":0.7600310786569783,"top":0.5542167134985778,"bottom":0.5649693335435143,"conf":1},{"text":"Müsteşar","x0":0.6935335764449155,"x1":0.768464111130597,"top":0.5665134926425529,"bottom":0.5820426850535355,"conf":1},{"text":"DAĞITIM","x0":0.1745379876653562,"x1":0.24640657048659448,"top":0.6162790697737407,"bottom":0.6308139531913756,"conf":1},{"text":"B Planı","x0":0.17659137542169112,"x1":0.22381930180281265,"top":0.632267441833606,"bottom":0.6410256411504295,"conf":1}]}