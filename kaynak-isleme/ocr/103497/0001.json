.5996215069543983,"top":0.33564415845309625,"bottom":0.3489488647657486,"conf":1},{"text":"(Halk Sağlığı Müdürlüğü)","x0":0.4414784390273734,"x1":0.5954825463907963,"top":0.3502906975433482,"bottom":0.36196581205273515,"conf":1},{"text":"GENELGE 2012/02","x0":0.4558521553408794,"x1":0.5852156062641857,"top":0.3749999998670963,"bottom":0.38675213661923313,"conf":1},{"text":"Bilindiği üzere ülkemiz genelinde hizmet veren aile sağlığı merkezlerinin büyük","x0":0.28747432593250416,"x1":0.7946611971301689,"top":0.40406976731232724,"bottom":0.41581196588147007,"conf":1},{"text":"çoğunluğu kamu kurumlarından kiralanmış binalarda faaliyetlerini sürdürmektedir. Söz","x0":0.24430510253758816,"x1":0.7947163407409021,"top":0.4169035461925543,"bottom":0.42936563845358355,"conf":1},{"text":"konusu binalardaki kira, elektrik, su, telefon, internet, doğalgaz vb. giderlerin Aile Hekimliği","x0":0.2443531744457444,"x1":0.7946611990263066,"top":0.43023255801373717,"bottom":0.44188034201044957,"conf":1},{"text":"Uygulama Yönetmeliği\" ve \"Aile Hckimliği Uygulaması Kapsamında Sağlık Bakanlığınca","x0":0.24435317434791184,"x1":0.7946611989284741,"top":0.44316239331886764,"bottom":0.4551282052846797,"conf":1},{"text":"Çalıştırılan Personele Yapılacak Ödemeler ile Sözleşme Usul ve Esasları Hakkında","x0":0.2442773729131089,"x1":0.7947499045834913,"top":0.4539789588950103,"bottom":0.4689505452691465,"conf":1},{"text":"Yönetmelik\" hükümlerine istinaden aile hekimlerince karşılanması ve aboneliklerin kendi","x0":0.2462990773280341,"x1":0.7947416180791488,"top":0.46790979735076665,"bottom":0.4822172335194699,"conf":1},{"text":"adlarına yenilenmesi gerekmektedir.","x0":0.24435318315822277,"x1":0.45995893162193763,"top":0.4824786323786081,"bottom":0.4927350426350183,"conf":1},{"text":"Bu çerçevede;","x0":0.28747433365279357,"x1":0.37371663119320225,"top":0.4985465115565042,"bottom":0.5087209302748911,"conf":1},{"text":"1) Müstakil aile sağlığı merkezi binalarında halen Müdürlük üzcrine abonelik varsa","x0":0.2874743256568591,"x1":0.7946611968545239,"top":0.5145299146973572,"bottom":0.5261627908082491,"conf":1},{"text":"bunların iptal edilerek aile hekimleri adına yenilenmesi,","x0":0.2441429465064413,"x1":0.5731269775840373,"top":0.5250929988454652,"bottom":0.5407874426378246,"conf":1},{"text":"2) Entegre hastane, toplum sağlığı merkezi veya başka amaçlar için ortak kullanılan","x0":0.28534988255850524,"x1":0.7947320266977131,"top":0.543473219317115,"bottom":0.5568466924763834,"conf":1},{"text":"binalarda, mümkünse aboneliklerin ayrılması; hizmetin gereği ve altyapı gibi nedenlerle","x0":0.24426310230684875,"x1":0.794737110039051,"top":0.5563010798728645,"bottom":0.5705530464308155,"conf":1},{"text":"aboneliklerin ayrılmasının mümkün olmadığı hallerde ise elektrik, su, doğalgaz, gibi işletme","x0":0.24428441694731592,"x1":0.7947292724585765,"top":0.5695298912721142,"bottom":0.5831842162193734,"conf":1},{"text":"giderlerinin kullanım alanı ve kullanım zamanı gibi faktörler dikkate alınarak ilgili aile","x0":0.24430234595829095,"x1":0.7947212965846135,"top":0.582567763664636,"bottom":0.5960737600589971,"conf":1},{"text":"hekimlerinden tahsil dilmesi,","x0":0.2439120230828698,"x1":0.4235855742986724,"top":0.592871425731273,"bottom":0.6091671603650204,"conf":1},{"text":"3) Abonelikleri Müdürlüğe ait binalarda aile hekimlerinin payına düşen kısmın","x0":0.28733418281581896,"x1":0.7947823169555936,"top":0.6110493031145805,"bottom":0.6258555908311771,"conf":1},{"text":"zamanında ödenmemesi halinde doğacak gecikme zammı, faiz vb. her türlü giderin yukarıda","x0":0.24426407715071644,"x1":0.7947719236001383,"top":0.6240597799395615,"bottom":0.6386553186739323,"conf":1},{"text":"bahsi geçen ödemelere ilişkin yönetmeliğin 16. Maddesinin (c) fıkrasına istinaden aile","x0":0.2443531743769559,"x1":0.7946611989575182,"top":0.6380341879353707,"bottom":0.6497093024447577,"conf":1},{"text":"hekimlerine yapılacak ödemelerden kesilmesi,","x0":0.2440996076908102,"x1":0.5176922786896199,"top":0.6489199016956722,"bottom":0.6641302408424737,"conf":1},{"text":"4) Geçmiş dönemlere ilişkin olarak aile hekimlerince ödenmesi gerekirken","x0":0.28534491434484943,"x1":0.7947369849997958,"top":0.6669390805716223,"bottom":0.6804760660830761,"conf":1},{"text":"ödenmemiş olan veya ödemesi Bakanlığımızca yapılan işletme giderlerinin tahsilâtı için","x0":0.24425954985192724,"x1":0.794755108086699,"top":0.6794713089555308,"bottom":0.6940455399973331,"conf":1},{"text":"gereklı ışlemlerin başlatılması,","x0":0.24435317963797398,"x1":0.4271047256651241,"top":0.6947674417962244,"bottom":0.7051282052156121,"conf":1},{"text":"5) Müdürlüğe ait veya tahsisli binaları kullandığı halde kira sözleşmesi imzalamayan","x0":0.28534197416990126,"x1":0.7947502446033202,"top":0.7091086652865318,"bottom":0.722965026545275,"conf":1},{"text":"ya da kira sözleşmesi imzaladığı halde kira bedellerini ödemeyen aile hekimleri hakkında","x0":0.24229979989758874,"x1":0.7946611740757175,"top":0.7222222220294835,"bottom":0.7341880339952954,"conf":1},{"text":"ilgili Yönetmelik hükümleri doğrultusunda işlem tesis edilmesi,","x0":0.24425877135748134,"x1":0.6181653047613508,"top":0.7352980535475795,"bottom":0.7485799238434383,"conf":1},{"text":"6) Aile hekimliği mevzuatı çerçevesinde, aile hekimliği ücretinden yapılacak","x0":0.2853389001833204,"x1":0.794742078203461,"top":0.75134972240574,"bottom":0.7647770716430353,"conf":1},{"text":"kesintilerden (taşınır, taşınmaz kira bedelleri, elektrik, su, doğalgaz vb.) döner sermayeye","x0":0.24423714651082803,"x1":0.7947658054319096,"top":0.7638935087026703,"bottom":0.7778044771897495,"conf":1},{"text":"gelir kaydı gerekenlerin her ayın en geç 25'ine kadar ilgili halk sağlığı müdürlüğü döner","x0":0.24427916583518078,"x1":0.794745055227374,"top":0.7770332670684943,"bottom":0.7915679434491408,"conf":1},{"text":"sermaye hesabına aktarılması","x0":0.2443531855481599,"x1":0.41889116712808927,"top":0.7905982904601181,"bottom":0.800872093046209,"conf":1},{"text":"gerekmektedir.","x0":0.28510331544956025,"x1":0.3779807138286082,"top":0.8067541120364927,"bottom":0.8195205278851839,"conf":1}]}