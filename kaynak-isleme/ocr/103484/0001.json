087,"x1":0.7166324435046594,"top":0.306686046571653,"bottom":0.3139534882804704,"conf":1},{"text":"GENELGE","x0":0.4681724842848159,"x1":0.5503080088270006,"top":0.3444767443445792,"bottom":0.3575581392574293,"conf":1},{"text":"2014/.S","x0":0.4804928123367988,"x1":0.5441478445488959,"top":0.359011628103168,"bottom":0.3720930230160181,"conf":1},{"text":"Gebelik süresince, doğum sırasında ve sonrasında sağlık hizmetlerinin erişilebilirliği,","x0":0.22997946405981023,"x1":0.84394250701439,"top":0.3866279071253125,"bottom":0.40128205118419213,"conf":1},{"text":"sağlık hizmetlerinden etkin faydalanma, bu hizmetlerin kalitesinin artırılması ve hizmet sunan","x0":0.1806981689631417,"x1":0.8439424878964095,"top":0.40116279050565584,"bottom":0.41424418623361237,"conf":1},{"text":"sağlık kurumları arasında etkili sevk sisteminin bulunması anne ve yenidoğan ölümlerini","x0":0.18069814980438376,"x1":0.8418891191400852,"top":0.4141025639947322,"bottom":0.4273504272425954,"conf":1},{"text":"önlemede önemlidir. Anne ölümlerinin önlenmesine yönelik ulusal planlarımızda; doğum öncesi,","x0":0.17864476324125095,"x1":0.8439425055751761,"top":0.4286324788288999,"bottom":0.4418803420767632,"conf":1},{"text":"doğum sırası ve doğum sonrası bakım hizmetlerinin niteliğinin artırılması hedeflenmiştir.","x0":0.17864476035216542,"x1":0.7885010303085214,"top":0.44186046526155187,"bottom":0.456410256157454,"conf":1},{"text":"Doğum öncesi bakım, doğum sonrası bakım hizmetlerinde niteliğin artırılması,","x0":0.2319895432655456,"x1":0.844000088546399,"top":0.45496238646753095,"bottom":0.4694971973407094,"conf":1},{"text":"standartlar sağlanması amacı ile 2008/13 sayılı genelge ile uygulamaya konulan Doğum Öncesi","x0":0.1785943504698415,"x1":0.8440121704328101,"top":0.4679004454926803,"bottom":0.4851067940096825,"conf":1},{"text":"Bakım Yönetim Rehberi ve 2008/80 sayılı genelge ile uygulamaya konulan Doğum Sonu Bakım","x0":0.18069816897843616,"x1":0.843942487911704,"top":0.4840116280561271,"bottom":0.49871794869649533,"conf":1},{"text":"Yönetim Rehberinin ulusal ve uluslar arası güncel literatür bilgileri ışığında Bilim Komisyonları","x0":0.18069814984347896,"x1":0.8418891191791803,"top":0.497008546604097,"bottom":0.5116279068187216,"conf":1},{"text":"tarafindan gözden geçirilerek ikinci revizyonları gerçekleştirilmiştir.","x0":0.17864476144712602,"x1":0.6488706387592293,"top":0.511538461440084,"bottom":0.526162790542429,"conf":1},{"text":"Anne ve bebek sağlığını korumak ve anne ölümlerini en aza indirmek için Doğum Öncesi","x0":0.22988817879965037,"x1":0.8419985427610697,"top":0.5230457315822951,"bottom":0.5401284007670532,"conf":1},{"text":"Bakım Yönetim Rehberine göre izlenen her gebenin doğumunun hastanede gerçekleştirilmesi,","x0":0.18069817582597372,"x1":0.8439424947592414,"top":0.5376068373872396,"bottom":0.5523255810620151,"conf":1},{"text":"doğum sonrası komplikasyon gelişmeyen vakalar için normal doğumdan sonra en az 24 saat,","x0":0.17864476325118514,"x1":0.8439425055851104,"top":0.552136752399003,"bottom":0.5668604649614988,"conf":1},{"text":"sezaryen ile doğumdan sonra ise en az 48 saat lohusa ve yeni doğanın hastanede izlenmesi","x0":0.1806981498115687,"x1":0.84188911914727,"top":0.5653846153335091,"bottom":0.5786324785813725,"conf":1},{"text":"sağlanmalıdır. Lohusanın izlemi doğum sonu ilk 24-48 saatte hastanede, taburcu olduktan sonra","x0":0.17864476327209938,"x1":0.8439425056060246,"top":0.5799145301000744,"bottom":0.5944767440303838,"conf":1},{"text":"doğum sonu 42. güne kadar sağlık kuruluşunda veya evde gerçekleştirilmelidir.","x0":0.1785762102679456,"x1":0.7228613860019616,"top":0.5929022395356652,"bottom":0.6091682668069033,"conf":1},{"text":"Revize edilmiş olan yönetim rehberlerinin ilinizdeki doğum öncesi bakım, doğum sonu","x0":0.234019799050063,"x1":0.8440046339909261,"top":0.6064194313436932,"bottom":0.6211863738814412,"conf":1},{"text":"bakım hizmeti veren tüm sağlık kuruluşlarına ve personeline tebliğ edilerek uygulamaya","x0":0.17864476329091394,"x1":0.8439425056248393,"top":0.6205128202423191,"bottom":0.6351744184478855,"conf":1},{"text":"konulması konusunda ilgililere emirlerinizi önemle rica ederim.","x0":0.17864476716296446,"x1":0.6160164235877302,"top":0.6350427351437866,"bottom":0.6482905983916498,"conf":1},{"text":"PrOF. Or NiRL YOSUN","x0":0.6344592166159,"x1":0.8016286053373707,"top":0.6518574652355847,"bottom":0.6882542971718911,"conf":0.5},{"text":"Sakan :","x0":0.6858316216314789,"x1":0.7330595480126004,"top":0.6831395347420661,"bottom":0.6933139534604531,"conf":1},{"text":"Müstesar","x0":0.665297743590884,"x1":0.7433264859094583,"top":0.6976744182157817,"bottom":0.7136627909533075,"conf":1},{"text":"EKLER:","x0":0.17864476460129827,"x1":0.24640656981161935,"top":0.722383720571644,"bottom":0.7383720933091699,"conf":1},{"text":"1- Doğum Öncesi Bakım Yönetim Rehberi (44 Sayfa)","x0":0.2032854199887222,"x1":0.5852156040359184,"top":0.7354651161890141,"bottom":0.752991452598102,"conf":1},{"text":"2- Doğum Sonu Bakım Yönetim Rehberi (56 Sayfa)","x0":0.20328541563980226,"x1":0.5708418941932144,"top":0.7512820516371868,"bottom":0.767521367876503,"conf":1},{"text":"DAĞITIM:","x0":0.1765913782419773,"x1":0.26694044878060996,"top":0.7761627905422118,"bottom":0.7936046509694162,"conf":1},{"text":"Gereği:","x0":0.17840057933082348,"x1":0.23843720282317396,"top":0.7916864858469875,"bottom":0.8086042117605325,"conf":1},{"text":"81 Il Valiliği (İl Sağlık Müdürlüğü)","x0":0.17864475934304888,"x1":0.42915811519321323,"top":0.8051282049881849,"bottom":0.8226744185783668,"conf":1},{"text":"(İl Halk Sağhğı Müdürlüğo)","x0":0.27310061993327184,"x1":0.47227925795331793,"top":0.818313953440244,"bottom":0.8358974361336472,"conf":1},{"text":"(İl Kamu Hastane Birliği)","x0":0.27104722562598604,"x1":0.4558521581522481,"top":0.832848836877302,"bottom":0.8488372096148279,"conf":1},{"text":"Bilgi:","x0":0.5646817253011858,"x1":0.6078028740713901,"top":0.7936046513444469,"bottom":0.8066860462572971,"conf":1