{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4496919999205903,"x1":0.9609856072149335,"top":0.03924418633951188,"bottom":0.055232557446825314,"conf":1},{"text":"2.3.31. Ulusal Organ Nakli Bilgi Sistemi Genelgesi (2011/4)","x0":0.12320328470907001,"x1":0.7885010270429953,"top":0.11324786358188754,"bottom":0.13808139524687446,"conf":1},{"text":"T.C.","x0":0.4928131411787018,"x1":0.5215605752297358,"top":0.22529069757130338,"bottom":0.23546511628969036,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.43121150028950594,"x1":0.5790554389302065,"top":0.23546511609125653,"bottom":0.24709302331442817,"conf":1},{"text":"Tedavi Hizmetleri Genel Müdürlüğü","x0":0.3963039041023567,"x1":0.6180698120634076,"top":0.2470085471375032,"bottom":0.2587209303425584,"conf":1},{"text":"T.C.","x0":0.6694045180307202,"x1":0.6919917856653783,"top":0.210755813840096,"bottom":0.22093023255848288,"conf":1},{"text":"SAGLIK BAKANLIGI","x0":0.6386036982532459,"x1":0.7515400387328833,"top":0.21947674411879659,"bottom":0.22965116283718356,"conf":1},{"text":"Tedavi Hiz. Genel MüdEgitim","x0":0.6386036943812177,"x1":0.7885010287464166,"top":0.22674418589269818,"bottom":0.23846153839302675,"conf":1},{"text":"Tamtım Ve Ulusal Koordinasyon Şb.","x0":0.6365503127449106,"x1":0.8151950673230639,"top":0.2354651161358079,"bottom":0.24709302335897965,"conf":1},{"text":"24 Ocak 2011 14:13:58","x0":0.638603694425466,"x1":0.7535934306296018,"top":0.2456395348852708,"bottom":0.2543604650988729,"conf":1},{"text":"/3507","x0":0.7638603692319568,"x1":0.7987679673930199,"top":0.2441860464085127,"bottom":0.2543604651268996,"conf":1},{"text":"9374158","x0":0.6406570846113044,"x1":0.6837782333815088,"top":0.27470930228055357,"bottom":0.2834302324941558,"conf":1},{"text":"Sayı : B-10-0-THG-0-06-00-02-708/","x0":0.21765913434368786,"x1":0.4476386067519595,"top":0.27905982899398896,"bottom":0.2936046510021708,"conf":1},{"text":"Konu: Ulusal Organ Nakli Bilgi Sistemi","x0":0.21765914251693663,"x1":0.46817247991632827,"top":0.29059829058623876,"bottom":0.30683760682555505,"conf":1},{"text":"GENELGE","x0":0.4700972844928973,"x1":0.542223043410082,"top":0.33248758675670564,"bottom":0.34629148288634637,"conf":1},{"text":"2011/4","x0":0.4845995892252354,"x1":0.5441478438264152,"top":0.35029069786725553,"bottom":0.36337209278010574,"conf":1},{"text":"Bilindiği üzere, ülke genelinde böbrek nakli yapılan tüm merkezlerde nakil olmak","x0":0.2648870666654262,"x1":0.796714575852435,"top":0.36752136765165677,"bottom":0.3794871796174688,"conf":1},{"text":"isteyen kişilerin bilgileri, Bakanlığımız Ulusal Organ Nakli Bekleme Listesi Programına","x0":0.2196436402330402,"x1":0.7967816714972104,"top":0.37848527584658664,"bottom":0.39308417770935866,"conf":1},{"text":"kaydedilmekte, Tedavi Hizmetleri Genel Müdürlüğü bünyesinde Organ Nakli Ulusal","x0":0.21963121615267178,"x1":0.7968206881712631,"top":0.3901143592217591,"bottom":0.40600073934401726,"conf":1},{"text":"Koordinasyon Merkezi (UKM) tarafindan bu kayıtlar esas alınarak sadece Böbrek bekleyen","x0":0.21971252772040106,"x1":0.7967145767894194,"top":0.40552325575519443,"bottom":0.4158119658195526,"conf":1},{"text":"hasta işlemleri ve kadavra donör dağıtım işlemleri gerçekleştirilmekte idi.","x0":0.21971253800882826,"x1":0.6735112864264899,"top":0.41569767441857497,"bottom":0.42877906933142507,"conf":1},{"text":"Ülke genelinde canlı ve kadavradan gerçekleşen tüm (böbrek, karaciğer, kalp, akciğer,","x0":0.26488706665139417,"x1":0.7967145758384029,"top":0.4286324788288022,"bottom":0.4418803420766655,"conf":1},{"text":"pankreas ve ince barsak) organ nakilleri ile organ bekleyen hasta bilgilerini içeren yeni Ulusal","x0":0.21971252778272213,"x1":0.7967145768517405,"top":0.44186046498981735,"bottom":0.453488372212989,"conf":1},{"text":"Organ Nakli Bilgi Sistemi oluşturma çalışmaları tamamlanmıştır. Bu sistem, öncelikle organ","x0":0.21967176200369223,"x1":0.7967615629478995,"top":0.4531111798432106,"bottom":0.46663627458464063,"conf":1},{"text":"nakli merkezleri, bölge koordinasyon merkezleri (BKM) ve UKM tarafindan kullanılacak","x0":0.2197125277272264,"x1":0.7967145767962447,"top":0.466569767316517,"bottom":0.47820512827882233,"conf":1},{"text":"olup canlı ve kadavra donör bilgileri ile nâkile ilişkin dokümanlar öncelikle sisteme kayıt","x0":0.21971252868812954,"x1":0.7987679642562598,"top":0.4781976742893972,"bottom":0.4898255815125687,"conf":1},{"text":"edilerek takip edilecektir.","x0":0.21765913502248552,"x1":0.3778234111086308,"top":0.49127906996948245,"bottom":0.5043604648823327,"conf":1},{"text":"Bu bağlamda organ nakli bekleyen hastalar, nakillerinin gerçekleştirilmesini istedikleri","x0":0.2607802921902378,"x1":0.7967145743754706,"top":0.5029069765491758,"bottom":0.5159883722771322,"conf":1},{"text":"merkezlere başvurabileceklerdir.","x0":0.21971252289862458,"x1":0.42710472536589145,"top":0.5158119658523509,"bottom":0.5277777778181628,"conf":1},{"text":"Başvurunun yapıldığı organ nakli merkezleri tarafindan","x0":0.4250513310009737,"x1":0.7967145825526099,"top":0.515811965855895,"bottom":0.527777777821707,"conf":1},{"text":"hasta kimlik ve doku tipleme bilgileri ile programda istenen tüm bilgiler, güncel olarak ulusal","x0":0.21971252778182673,"x1":0.796714576850845,"top":0.5276162789433237,"bottom":0.5393162391139718,"conf":1},{"text":"organ nakli bilgi sistemine kaydedilecektir. Kadavra donör temini vb. işlemler için BKM' ler","x0":0.217589084492271,"x1":0.7988301986001156,"top":0.5390876167974974,"bottom":0.5540985548713322,"conf":1},{"text":"yetkilendirilerek, gerektiğinde bölgesinde bulunan tüm hastanelere sistemi kullanma yetkisi","x0":0.21765914083476123,"x1":0.7967145764028916,"top":0.5521367523893856,"bottom":0.5668604649518815,"conf":1},{"text":"verebilecektir.","x0":0.21765913625584035,"x1":0.31006160251897136,"top":0.5654069769316261,"bottom":0.5770348833396916,"conf":1},{"text":"Sistemde tutulacak her türlü kişisel bilginin gizliliği esastır. Bu kapsamda, sisteme giriş","x0":0.26283368023044995,"x1":0.7987679624156827,"top":0.5769230770324522,"bottom":0.5901709402803155,"conf":1},{"text":"yapacak olan kişiler, kaydı bulunan hastaların bilgilerinin amaç dışı kullanımını engelleyecek","x0":0.21971252853846404,"x1":0.7987679641065943,"top":0.5901162789441005,"bottom":0.6017441861672722,"conf":1},{"text":"önlemleri almak, hasta haklarına ve kişisel haklara riayet etmekle yükümlüdür.","x0":0.21971252245659958,"x1":0.6878850132695908,"top":0.602991452884914,"bottom":0.6133720930778425,"conf":1},{"text":"Halen UKM ve organ nakil merkezlerince kullanılan programda bulunan tüm veriler","x0":0.2627882091396224,"x1":0.7988298010191569,"top":0.6132998076712798,"bottom":0.6276306349441351,"conf":1},{"text":"hazırlanmış olan yeni sisteme Bakanlıkça","x0":0.21971252226121424,"x1":0.4969199210506074,"top":0.6277777777921194,"bottom":0.6397435897579314,"conf":1},{"text":"aktarılacaktır. Ancak aktarılan verilerin yeni","x0":0.4948027482277126,"x1":0.7988609477216005,"top":0.625102546068826,"bottom":0.6382401837207096,"conf":1},{"text":"sistemle uyumlu çalışabilmesi ve eşleştirme işlemlerinin yapılabilmesi için gerekli kontrol","x0":0.21971252852056958,"x1":0.7987679640886999,"top":0.6395348835956401,"bottom":0.6512820514600565,"conf":1},{"text":"ve güncelleme (doku grupları ve sistemdeki tüm bilgiler) ilgili merkezlerce yapılacaktır.","x0":0.21757574930927878,"x1":0.7988463477519745,"top":0.6499193791690465,"bottom":0.666303186033467,"conf":1},{"text":"Mevcut kullanıcı adı ve şifreleri yeni sistemde de aynen geçerli olacaktır. Yeni sisteme","x0":0.21760782176014448,"x1":0.7988323670740615,"top":0.6625434782287989,"bottom":0.6783568020077827,"conf":1},{"text":"http://sbu3.saglik.gov.tr/sbdoku/ adresine girilmek suretiyle ulaşılabilecektir.","x0":0.21758663392358152,"x1":0.6920519821915115,"top":0.6756384817060289,"bottom":0.6903630802890222,"conf":1},{"text":"Sisteme 24.01.2011 tarihinde böbrek dağıtım işlemleri ile başlanacak olup, 07.02.2011","x0":0.2627695822141731,"x1":0.7988456032356551,"top":0.6872739346492418,"bottom":0.7029650397663876,"conf":1},{"text":"tarihinde başta karaciğer dağıtımı olmak üzere tüm organlar sistem üzerinden dağıtılacaktır.","x0":0.21971252890998,"x1":0.7987679644781103,"top":0.7004273503219999,"bottom":0.7123931622878118,"conf":1},{"text":"Sistemde kaydı olmayan hastalara organ dağıtımı yapılmayacaktır.","x0":0.2197125178314701,"x1":0.6283367632686678,"top":0.7136627905713845,"bottom":0.7252906977945561,"conf":1},{"text":"Bu amaçla, nakil merkezlerinin 07.02.2011 tarihine kadar organ bekleyen tüm hasta","x0":0.2628336810202647,"x1":0.8008213497046095,"top":0.7252136752376291,"bottom":0.7384615384854923,"conf":1},{"text":"giriş kayıtlarını yapmaları ve kayıtları en kısa sürede güncellemeleri hususunda:","x0":0.21755601321609516,"x1":0.7085165737299064,"top":0.7362514206476096,"bottom":0.7529617085405299,"conf":1},{"text":"Gereğini önemle rica ederim.","x0":0.2628336732559309,"x1":0.44763860578219294,"top":0.7512820513594728,"bottom":0.7645348839026095,"conf":1},{"text":"DAGITIM:","x0":0.2196657513436323,"x1":0.29368127069450756,"top":0.8298089179678249,"bottom":0.8431561980951953,"conf":1},{"text":"Gereği:","x0":0.21765913660300995,"x1":0.26899384059504866,"top":0.8430232557339619,"bottom":0.8531976744523488,"conf":1},{"text":"81 Il Valiliği","x0":0.21765913542175963,"x1":0.2956878869657203,"top":0.852991452805136,"bottom":0.8649572647709479,"conf":1},{"text":"Prof. Đr. Nihat TOSUN","x0":0.6386036988008689,"x1":0.7843942509424574,"top":0.7948717949728735,"bottom":0.8068376069386856,"conf":1},{"text":"Bakan a.","x0":0.6857801050188181,"x1":0.7392712292376862,"top":0.8079796525817105,"bottom":0.8170203473482849,"conf":1},{"text":"Müsteşar","x0":0.6858095318921339,"x1":0.7454019668686587,"top":0.8197026465438005,"bottom":0.8300066557449808,"conf":1},{"text":"Bilgi: Idari Mali Işler Daire Başkanlığı","x0":0.5338809078766926,"x1":0.7597535888359674,"top":0.8414529915233818,"bottom":0.8531976745363848,"conf":1},{"text":"199","x0":0.8952772073755858,"x1":0.9281314167311904,"top":0.9433139536409586,"bottom":0.9563953485538088,"conf":1}]}