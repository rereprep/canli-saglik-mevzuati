{"lines":[{"text":"T. C.","x0":0.45585215512025373,"x1":0.5071868591122924,"top":0.08846153828796743,"bottom":0.10174418578763877,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.40012607876091216,"x1":0.5772978712490565,"top":0.1013230718005752,"bottom":0.11911497797806336,"conf":1},{"text":"Temel Sağlık Hizmetleri Genel Müdürlüğü","x0":0.3282693488653767,"x1":0.647105787045546,"top":0.11671377419429096,"bottom":0.1355559040238934,"conf":1},{"text":"Say1 : B100TSH0110002-104-01","x0":0.14154482636917642,"x1":0.40466480185474174,"top":0.15185274050908038,"bottom":0.1672126418720945,"conf":1},{"text":"Konu : Kuduz Şüpheli Temas","x0":0.14134261247721147,"x1":0.37195442976909854,"top":0.18066406973537252,"bottom":0.1991533205053545,"conf":1},{"text":"K-Q","x0":0.7371663242971301,"x1":0.7638603695427055,"top":0.11773255810937233,"bottom":0.12645348832297443,"conf":1},{"text":"TSE-ISO-EN","x0":0.7186670640716992,"x1":0.7823596297682588,"top":0.12638472315087956,"bottom":0.13524318379728884,"conf":1},{"text":"9000","x0":0.7371663242971301,"x1":0.7638603695427055,"top":0.13517441865252333,"bottom":0.14244186036134077,"conf":1},{"text":"14900 25.06.07","x0":0.45449566637348293,"x1":0.6503340502983431,"top":0.22992810079873105,"bottom":0.25880005438801557,"conf":1},{"text":"Turistik amaçla ülkemize gelen ve kuduz şüpheli temas sebebiyle kuduz profilaksisine","x0":0.19065813454107422,"x1":0.8278687821425328,"top":0.3152007893011275,"bottom":0.33993372462785865,"conf":1},{"text":"alınan, ancak aşıları tamamlanmadan yurt dışına çıkanların kalan aşılarının tamamlattırılması","x0":0.13730856649105147,"x1":0.8278174447076854,"top":0.33056572379431115,"bottom":0.35398153300180357,"conf":1},{"text":"için Bakanlığımızca gerekli girişimlerde bulunulduğu bilgileriniz dahilindedir.","x0":0.13526464591068665,"x1":0.7127921360860192,"top":0.3465478703612386,"bottom":0.36670649134230837,"conf":1},{"text":"Söz konusu kişilere aşılarının tamamlattırılması amacıyla ulaşılabilmek için, şahısların","x0":0.19062947799255214,"x1":0.8258029388733714,"top":0.3753332403769398,"bottom":0.39916755692404027,"conf":1},{"text":"kimlik ve adres bilgilerinin eksiksiz ve doğru olarak alınması ve Bakanlığımıza bildirilmesi","x0":0.13524339656314724,"x1":0.8257550792972389,"top":0.39031745734193146,"bottom":0.41286412445723264,"conf":1},{"text":"icap etmektedir. Ancak, Bakanlığımıza gönderilen yazılarda kişilere ait bilgilerin zaman","x0":0.13314725350095863,"x1":0.825751918092479,"top":0.4054035626075774,"bottom":0.4288623401412145,"conf":1},{"text":"zaman eksik veya hatalı olduğu tespit edilmekte ve bundan dolayı ilgili yerlerden, bahse konu","x0":0.13321762853112865,"x1":0.8257748377351417,"top":0.4193867401166186,"bottom":0.4445622096699873,"conf":1},{"text":"şahıslara ulaşılmakta güçlük çekildiği veya ulaşılamadığı bilgileri iletilmektedir.","x0":0.13326449275490437,"x1":0.7251464258172722,"top":0.43556992396673966,"bottom":0.4565406679122608,"conf":1},{"text":"Bu sebeple, kuduz şüpheli temas sebebiyle sağlık kuruluşlarına müracaat ederek kuduz","x0":0.1886423433583811,"x1":0.8256859007618347,"top":0.465703224420872,"bottom":0.4874687711380674,"conf":1},{"text":"profilaksisine alınan ve aşıları tamamlanmadan yurt dışına çıkan yabancı ülke vatandaşlarının","x0":0.13534477152287833,"x1":0.8236407378592221,"top":0.4802507856738977,"bottom":0.5011964161957535,"conf":1},{"text":"Bakanlığımıza bildirimi yapılırken, kimlik ve adres bilgilerinin eksiksiz ve doğru olduğuna","x0":0.133216283863525,"x1":0.8236504733520755,"top":0.49514262452009195,"bottom":0.5171354130794432,"conf":1},{"text":"dikkat edilmesinin yanı sıra pasaport ve kimlik fotokopilerinin de gönderilmesi hususlarında","x0":0.1331632274390588,"x1":0.8236856116213442,"top":0.5091780656556647,"bottom":0.5328045724936888,"conf":1},{"text":"bilgilerinizi ve gereği için de ilgililere emirlerinizi rica ederim.","x0":0.13120821102548128,"x1":0.5936658332906339,"top":0.525436340458916,"bottom":0.5440778163972402,"conf":1},{"text":"Uzm. DP. Turan BUZGAN","x0":0.5667370305900749,"x1":0.7662959390364549,"top":0.5763236937350679,"bottom":0.6030300404262321,"conf":1},{"text":"Bakan a.","x0":0.6298404942604756,"x1":0.6966595572372435,"top":0.6044306804954007,"bottom":0.6178004673366384,"conf":1},{"text":"Genel Müdür","x0":0.6119096498066598,"x1":0.7166324442898493,"top":0.6191860467062618,"bottom":0.632478632388927,"conf":1},{"text":"DAĞITIM:","x0":0.12925283162905815,"x1":0.21796010628165224,"top":0.6570010037453744,"bottom":0.6723159634100045,"conf":1},{"text":"81 Il Valiliğine","x0":0.1290681854193751,"x1":0.24673570994857041,"top":0.6729574171202923,"bottom":0.6884337368490459,"conf":1},{"text":"Bulaşıcı ve Salgın Hastalıklar Kontrolü Daire Başkanlığı","x0":0.12508927700095027,"x1":0.4395955402264642,"top":0.8557894290252422,"bottom":0.8721751595404207,"conf":1},{"text":"Zoonotik ve Paraziter Hastalıklar Şube Müdürlüğü","x0":0.12499359682705019,"x1":0.4088627578217033,"top":0.8656935160904572,"bottom":0.8824776216358924,"conf":1},{"text":"Telefon: 0 312 5851390","x0":0.12525667131318344,"x1":0.26283367745832403,"top":0.8777777777078337,"bottom":0.891025640955697,"conf":1},{"text":"Faks: 0 312 432 29 94","x0":0.12497629248863949,"x1":0.25287947545358713,"top":0.8881394910225384,"bottom":0.9028436312536791,"conf":1},{"text":"Elektronik Ağ: www. saglik.gov.tr","x0":0.6178174038000648,"x1":0.8134115363952885,"top":0.8593599700000779,"bottom":0.8741328481415627,"conf":1},{"text":"Elektronik Mektup: zoonoz.paraziter@saglik.gov.tr","x0":0.5233950332609071,"x1":0.8133411776693488,"top":0.8704921828582814,"bottom":0.8846810178066989,"conf":0.5},{"text":"Mithatpașa Caddesi, Nu: 3","x0":0.4229979467475502,"x1":0.5667351123900268,"top":0.8923076922733204,"bottom":0.9026162791112193,"conf":1},{"text":"06434 Sihhiye / ANKARA","x0":0.4188911744885459,"x1":0.5708418861274704,"top":0.9025641026563389,"bottom":0.914244185645893,"conf":1}]}