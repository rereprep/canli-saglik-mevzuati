 5258 sayılıi Aile Hekimliği Pilot Uygulaması","x0":0.2462632820006073,"x1":0.8173637407015785,"top":0.34273062047416913,"bottom":0.3608063939252325,"conf":1},{"text":"Hakkında Kanun\" ve bu Kanuna istinaden yayımlanan Yönetmelikler çerçevesinde 2005","x0":0.19898882681261648,"x1":0.8174104990017224,"top":0.35543406665341115,"bottom":0.37455229986952565,"conf":1},{"text":"yılında Düzce İlinde başlamış ve halen 46 ilimizde devam etmektedir. 2010 yılı sonunda","x0":0.19698486952682,"x1":0.8174374920753765,"top":0.36829863039474864,"bottom":0.388775395497559,"conf":1},{"text":"ülkemizin tamamında aile hekimliği uygulamasına geçılecektir.","x0":0.1969389140328613,"x1":0.6141356837010898,"top":0.38314354284177177,"bottom":0.4010921189620016,"conf":1},{"text":"Aile hekimliği uygulamasında standart veri toplanması ve Bakanlığımıza gönderilmesi","x0":0.24425916162202793,"x1":0.8173475434804016,"top":0.39706746561354556,"bottom":0.41337202295737896,"conf":1},{"text":"amacıyla Aile Hekimliği Bilgi Sistemi (AHBS) oluşturulmuştur. 05.01.2009 tarih ve 154","x0":0.19499297652306857,"x1":0.8173422647070165,"top":0.4100614984864651,"bottom":0.42670374130935673,"conf":1},{"text":"sayılı \"Protokol defteri\" konulu genel yazımız ile aile hekimlerinin kullandıkları basılı","x0":0.1969707945786946,"x1":0.8174027522617735,"top":0.42182736684044375,"bottom":0.44155843687802476,"conf":1},{"text":"ortamdaki protokol defterleri yerine 01.05.2009 tarihi itibari ile elektronik protokol defteri","x0":0.19499579824943916,"x1":0.8152848731483584,"top":0.43653338062900304,"bottom":0.4538517035524514,"conf":1},{"text":"uygulaması yürürlüğe konulmuştur. Bu ve diğer uygulamalarla ihtiyaç duyulan veriler ulusal","x0":0.194946724449361,"x1":0.8153141044278224,"top":0.4504746851029753,"bottom":0.46871774281041145,"conf":1},{"text":"sağlık veri sözluğü standartlarında eksiksiz olarak Sağlık Bakanlığı bilgi işlem veri tabanına","x0":0.1949918751903715,"x1":0.8152824999542015,"top":0.46486110676840675,"bottom":0.4817356279749935,"conf":1},{"text":"gönderilmekte ve kaydedilerek depolanmaktadır.","x0":0.19507186423577783,"x1":0.5174538029071805,"top":0.4794871795205806,"bottom":0.4927350427684438,"conf":1},{"text":"Yukarıda değinildiği üzere Bakanlığımızın yapmış olduğu çalışmalar sonucunda söz","x0":0.242143565334742,"x1":0.8153673020619941,"top":0.49106135695047914,"bottom":0.5092585225456396,"conf":1},{"text":"konusu verilerin aile hekimliği bilgi sistemi aracılığıyla toplanması için gerekli olan bilişim","x0":0.1928865908117036,"x1":0.815337579655038,"top":0.5039663066061141,"bottom":0.5226810385887446,"conf":1},{"text":"ve donanım alt yapısı oluşturulmuştur. Aile hekimlerinin yapmış olduğa tüm iş ve işlemler ile","x0":0.19507185036113717,"x1":0.8151950897145984,"top":0.5203488370154955,"bottom":0.5334302327434519,"conf":1},{"text":"uygulamaları Aile Hekimlıği Bilgi Sistemine girmeleri nedeniyle, 01.07.2010 tarihinden","x0":0.19507186781415256,"x1":0.8131416837669564,"top":0.5319767441923453,"bottom":0.5465811969287027,"conf":1},{"text":"itibaren aile hekimlerinden ayrıca basılı veya elektronik ortamda (form) herhangi bir bilgi","x0":0.193018462292302,"x1":0.8131417016457634,"top":0.5465116280546961,"bottom":0.5611111110882269,"conf":1},{"text":"istenmeyecektir.","x0":0.19301848260925727,"x1":0.3059548230888947,"top":0.5595930234589424,"bottom":0.5726744183717924,"conf":1},{"text":"Bakanlığımız birimleri, il sağlık müdürlukleri, sağlık grup başkanlıkları ve toplum","x0":0.24229979503056798,"x1":0.8151950711013622,"top":0.5726495726824378,"bottom":0.5872093021688869,"conf":1},{"text":"sağlığı merkezleri ihtiyaçları olan bilgileri, Sağlık Bakanlığı internet sayfası web","x0":0.19292657094417534,"x1":0.8132597800915077,"top":0.5842812658040392,"bottom":0.6021501286082238,"conf":1},{"text":"uygulamalan linkinden ulaşılabilen Aile Hekimliği Bilgi Sistemi (AHBS) ve Karar Destek","x0":0.1950010580740564,"x1":0.8132142365311112,"top":0.5981606504387195,"bottom":0.6152139521602761,"conf":1},{"text":"Sistemin (KDS-Iş Zekası)'den temin edeceklerdir. İl Sağlık Müdürlüklerine bu sistemlerin","x0":0.19301849432953774,"x1":0.813141659879908,"top":0.6119186046211245,"bottom":0.6264957268448074,"conf":1},{"text":"kullanım yetkisini Bakanlığımız Idari Mali Işler Daire Başkanlığı verecektir.","x0":0.19301847310523562,"x1":0.6981519578037882,"top":0.626453488519389,"bottom":0.6410256410402452,"conf":1},{"text":"Bu genelgenin yayımı tarihinden evvel yürürlükte bulunan genelgelerdeki aile","x0":0.24014378399782596,"x1":0.813227811473831,"top":0.6394780906380074,"bottom":0.65621334686568,"conf":1},{"text":"hekimlorinden yazılı veya elektronik olarak verilerin toplanacağına dair hükümler 1.7.2010","x0":0.19096509345303672,"x1":0.8131416824040646,"top":0.6540697675897031,"bottom":0.668803418742746,"conf":1},{"text":"tarihi itibariyle uygulanmayacaktır.","x0":0.19077506591463228,"x1":0.427315374801233,"top":0.665380671349413,"bottom":0.6821869918006767,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.24024640809369374,"x1":0.48254619949663735,"top":0.6802325582848077,"bottom":0.69487179486542,"conf":1},{"text":"Prof. Dr. Recep AKDAG","x0":0.6302289438399957,"x1":0.8072234059512601,"top":0.7480473515426135,"bottom":0.7628756291957126,"conf":1},{"text":"Bakan","x0":0.6857961318899487,"x1":0.7392552025038605,"top":0.7629996966824328,"bottom":0.7747910009202551,"conf":1},{"text":"Dağıtım:","x0":0.19096509310134452,"x1":0.2525667342016364,"top":0.7994186045079009,"bottom":0.8110465117310726,"conf":1},{"text":"Gereği:","x0":0.19096509281903704,"x1":0.24640656980929973,"top":0.8095930233267123,"bottom":0.8241279067443472,"conf":1},{"text":"A Planı","x0":0.18891170341474292,"x1":0.2464065715168108,"top":0.823931623945311,"bottom":0.835897435911123,"conf":1},{"text":"467","x0":0.8952772069833801,"x1":0.9301848051444432,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}