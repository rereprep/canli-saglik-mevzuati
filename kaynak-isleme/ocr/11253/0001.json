{"lines":[{"text":"Sayı : B.10.O.THG.0.12.00.04.254.99/","x0":0.0862422978328818,"x1":0.4147843960016205,"top":0.13372092990511575,"bottom":0.1497093026426417,"conf":1},{"text":"Konu : Hekim Seçme Yönergesi","x0":0.08384988356228332,"x1":0.3576660487713881,"top":0.14654692308077932,"bottom":0.16766555175384368,"conf":1},{"text":"T.C.","x0":0.49075975324587073,"x1":0.5318275155169631,"top":0.05232558150157496,"bottom":0.06686046491920994,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.41478439594067223,"x1":0.6098562609624943,"top":0.0666666667509278,"bottom":0.08290598299024399,"conf":1},{"text":"Tedavi Hizmetleri Genel Müdürlüğü","x0":0.36139630002905165,"x1":0.6611909687594496,"top":0.08575581362568552,"bottom":0.10174418636321136,"conf":1},{"text":"9379","x0":0.4989733061836638,"x1":0.5831622172249605,"top":0.13372093009132402,"bottom":0.15406976752809776,"conf":1},{"text":"1 7 EKIM 2007","x0":0.7629575049443247,"x1":0.9473499888965806,"top":0.1290531031227624,"bottom":0.15473633659579855,"conf":1},{"text":"BAKANLIK MAKAMINA","x0":0.39615514306417965,"x1":0.6264456585994351,"top":0.19216058548516657,"bottom":0.20807327071643245,"conf":1},{"text":"Bilindiği üzere, Sağlıkta Dönüşüm Programının alt bileşenlerinden olan hasta hakları uygulaması","x0":0.14579054690344698,"x1":0.936344976387841,"top":0.2427325578140207,"bottom":0.25872093055154655,"conf":1},{"text":"bütün devlet hastanelerinde başlatılmıştır. Hasta hakları uygulamasının bir ayağını da hekim seçme","x0":0.08407816163081039,"x1":0.9364592117129975,"top":0.2567064222783546,"bottom":0.276328255036288,"conf":1},{"text":"uygulaması oluşturmaktadır. Bu bağlamda 2004/117 sayılı Genelgeyle hastanelerimizde poliklinik","x0":0.08412839620806063,"x1":0.9384535673131468,"top":0.2735337608048185,"bottom":0.29289384990310496,"conf":1},{"text":"hizmetlerinin yapılandırılması ve alınacak tedbirler belirlenmişti. Hastanelerimizde yapılan bu","x0":0.08405991148658529,"x1":0.9385006582321642,"top":0.2887803493400911,"bottom":0.31005673856806415,"conf":1},{"text":"düzenlemelerin yanında hekim seçme hakkının poliklinik hizmeti verilen Bakanlığımıza bağlı bütün","x0":0.08410264973472555,"x1":0.9364201553555689,"top":0.30632273478831207,"bottom":0.32631431033914127,"conf":1},{"text":"sağlık kuruluşlarında sağlanması ve uygulama ile ilgili usul ve esaslarının belirlenmesi amacıyla Ek'teki","x0":0.08418892812222709,"x1":0.9363449525799811,"top":0.3239316237019991,"bottom":0.3415697674207512,"conf":1},{"text":"«Sağlık Hizmet Sunumunda Poliklinik Hizmetlerinin Hastaların Hekimini Seçmesine ve Değiştirmesine","x0":0.08407779256309131,"x1":0.936444155830171,"top":0.3383971486098196,"bottom":0.35794095206122734,"conf":1},{"text":"Imkân Verecek Şekilde Düzenlenmesi Hakkında Yönerge\" hazırlanmıştır.","x0":0.08213551912855843,"x1":0.6899384025858023,"top":0.3559829060929307,"bottom":0.37354651160524,"conf":1},{"text":"Söz konusu Yönerge ile Bakanlığımıza bağlı sağlık kuruluşlarından hizmet alan hastaların.","x0":0.1436587672842389,"x1":0.950812840388267,"top":0.37220442381949337,"bottom":0.39101767606475246,"conf":1},{"text":"muayene ve tedavi olabilecekleri hekimleri kendilerinin seçebilmesine imkân tanınması","x0":0.08418891035052892,"x1":0.9383983582089402,"top":0.3880341876572537,"bottom":0.4055555551786213,"conf":1},{"text":"amaçlanmaktadır. Uygulamayla sağlık hizmet sunumunda hekim kaynağından en etkili ve verimli bir","x0":0.08411801867720585,"x1":0.9364130881583878,"top":0.4044869573911216,"bottom":0.4235464190010516,"conf":1},{"text":"şekilde faydalanılması ve hastalarımızın muayene ve tedavi olacakları hekimini seçmesi sağlanacaktır.","x0":0.08418890249968225,"x1":0.9178644853669737,"top":0.4229651159545854,"bottom":0.43895348869211137,"conf":1},{"text":"Bu kapsamda Makamınızca uygun görülmesi halinde Ekteki Yönergenin yürürlüğe konulmasını","x0":0.14158303569554492,"x1":0.9364597432038582,"top":0.43647672627343925,"bottom":0.4571950676769765,"conf":1},{"text":"takdir ve tensiplerinize arz ederim.","x0":0.08213552418100742,"x1":0.3696098554659606,"top":0.45494186013553084,"bottom":0.47094017064849747,"conf":1},{"text":"Doç. Dr Oner ODABAŞ","x0":0.6858316199198613,"x1":0.8952772088862402,"top":0.486752136694802,"bottom":0.5029914529341183,"conf":1},{"text":"Genel Müdür V.","x0":0.7310061588047202,"x1":0.8706365514489727,"top":0.5042735043553903,"bottom":0.5205128205947065,"conf":1},{"text":"Uygun Görüşle Arz Ederin","x0":0.08624230099399674,"x1":0.3039014359568236,"top":0.5376068376287955,"bottom":0.5508720932063393,"conf":1},{"text":"....2007 nen","x0":0.08167211432537273,"x1":0.29830237884745936,"top":0.5512823931352464,"bottom":0.5789806165426983,"conf":0.30000001192092896},{"text":"Uzm.Dr. Orhan .GUMRÜKÇÜOGLU","x0":0.08213551857504564,"x1":0.40246407074733626,"top":0.584188034308235,"bottom":0.6004273505475513,"conf":0.5},{"text":"Müsteşar V.","x0":0.17845776423166304,"x1":0.2835545558784521,"top":0.6011100550475351,"bottom":0.6183666890995183,"conf":1},{"text":"OLUR","x0":0.5092402455764227,"x1":0.5667351136784906,"top":0.7311046513340649,"bottom":0.7441860462469151,"conf":1},{"text":"..../.../2002","x0":0.4919830523319998,"x1":0.5840126284778961,"top":0.7478935331790656,"bottom":0.7638782852146142,"conf":1},{"text":"Prof. Dr. Recep AKDAĞ","x0":0.43301347293774123,"x1":0.6409317069360503,"top":0.7789475388603752,"bottom":0.797800509603147,"conf":1},{"text":"Bakan","x0":0.5089496031737276,"x1":0.5649723671467192,"top":0.7973933021216874,"bottom":0.813071813847219,"conf":1},{"text":"Sağlık Bakanlığı Tedavi Hizmetleri Genel Müdürlüğü Mithatpaşa Cad. No:3 (B) Blok 2.Kat Sıhhiye/ANKARA","x0":0.12519798134559118,"x1":0.8871161472974503,"top":0.9270349013296688,"bottom":0.9435307918247734,"conf":1},{"text":"Tel: 0.312.585 14 79-80-81 Fax: 0.312.585 15 65-585 15 66","x0":0.2956878803136459,"x1":0.7125256717472916,"top":0.9418604649219101,"bottom":0.9551282049433142,"conf":1},{"text":"Internet sayfası http://sbu.saglik.gov.tr/extras/hastahaklari/giris.htm