{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45164723922106603,"x1":0.9631511853247352,"top":0.036979054272278655,"bottom":0.057080251017800565,"conf":1},{"text":"TELISO IN","x0":0.7019412974076779,"x1":0.7621244108102602,"top":0.24076967185516773,"bottom":0.2606838163874612,"conf":0.5},{"text":"9000","x0":0.716632444189258,"x1":0.7453798759339454,"top":0.25726744171881044,"bottom":0.2674418604371973,"conf":1},{"text":"-TO Net","x0":0.7720739221840488,"x1":0.8562628332253455,"top":0.23837209267602266,"bottom":0.2543604654135485,"conf":0.5},{"text":"CERTUFRCATE","x0":0.7843942512122275,"x1":0.8459958923125194,"top":0.26017441846138933,"bottom":0.271802325684561,"conf":0.30000001192092896},{"text":"TO SICA DAMTO","x0":0.18248072861576184,"x1":0.2672240577019733,"top":0.28733201982488354,"bottom":0.2966262974072966,"conf":0.5},{"text":"akki Hak Sayg","x0":0.19301848127253454,"x1":0.2607802864828556,"top":0.29487179489835147,"bottom":0.30232558130816967,"conf":0.5},{"text":"TC.","x0":0.4825462013676375,"x1":0.5133470219177835,"top":0.2688953489243888,"bottom":0.28197674383723903,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4165253813060076,"x1":0.5814840722399178,"top":0.2788196721413865,"bottom":0.29788866234341804,"conf":1},{"text":"Türkiye Halk: Sağlığı Kurumu Başkanlığı","x0":0.35728952835136324,"x1":0.6447638596363163,"top":0.29358974369356927,"bottom":0.31111111121493673,"conf":1},{"text":"Sayı : 99858683","x0":0.18069815091035604,"x1":0.28542094539354546,"top":0.3357558137505804,"bottom":0.3488372094785368,"conf":1},{"text":"Konu: Nöbet Hizmetleri","x0":0.18069814773735351,"x1":0.33675565082527487,"top":0.35170940166363307,"bottom":0.36337209313861285,"conf":1},{"text":"b) Nöbet tutturulacak sağlık tesisinde görev yapan ebe, hemşire, sağlık memuru (toplum","x0":0.22997947257657997,"x1":0.8172484541411582,"top":0.37777777765006615,"bottom":0.3924418602994928,"conf":1},{"text":"sağlığı) ve acil tap teknisyenlerinin aylık mesailerinin üzerine 24 saat ilave (160+24) hizmet","x0":0.1826657673954615,"x1":0.8152778920034195,"top":0.3913814729002124,"bottom":0.4076292760258384,"conf":1},{"text":"vermelerine rağmen ihtiyacın devam etmesi durumunda; aile sağlığı elemanları, il ve ilçe sağhk","x0":0.18069814018924427,"x1":0.8172484715356015,"top":0.40552325596300565,"bottom":0.42008546989331497,"conf":1},{"text":"müdürlugo, 112 acil sağlık hizmetleri başhekimliği ve bağhı istasyonları, halk sağlığı","x0":0.18267164902951602,"x1":0.8173183772499286,"top":0.4179849012749248,"bottom":0.4352199333809821,"conf":1},{"text":"müdürluğü, toplum sağlığı merkezi, kamu hastaneleri genel sekreterliğinde sayılan unvanlarda","x0":0.18268634357765756,"x1":0.8173203776664196,"top":0.4328511710207319,"bottom":0.4491624668479617,"conf":1},{"text":"görev yapanların dähil edilmesi suretiyle nöbet havuzu oluşturulacaktır.","x0":0.18263039020721852,"x1":0.6674227097852302,"top":0.44594971444564646,"bottom":0.46247197118272787,"conf":1},{"text":"e) İlgili kurumlar yukarıdaki büktenler çerçevesinde belirledikleri nöbet ihtiyacımı Halk","x0":0.2319516351758737,"x1":0.8173427339917179,"top":0.4587627124165623,"bottom":0.4762404081750884,"conf":1},{"text":"Sağlığı Müdürliğine bildirecek olup, halk sağlğı müdürlugünün değerlendirmesi ile nöbet","x0":0.1826866646123223,"x1":0.8173237246278151,"top":0.4735282270340493,"bottom":0.49054654684053134,"conf":1},{"text":"planlaması yapılacaktır. Ihtilef olması halinde 04/07/2013 tarihli ve 2013/3 sayılı Bakanlığımız","x0":0.18266981811531008,"x1":0.8193688626900153,"top":0.48699609232016994,"bottom":0.5032048176217984,"conf":1},{"text":"Genelgesi ile oluşturulan komisyon kararına göre işlem tesis edilecektir.","x0":0.18268802034366619,"x1":0.6715090292496327,"top":0.5013895717672396,"bottom":0.516961558886735,"conf":1},{"text":"4) Nöbet listeleri öncelikle görülülük esasına göre hazılanacaktu. Nöbet listesi","x0":0.23196764989614238,"x1":0.8193809534051546,"top":0.5141205795980798,"bottom":0.5302009061022573,"conf":1},{"text":"hazırlanırken sağhk personelinin eşit ve sualı şckilde yer almasına azami dikkat gösterilecektir.","x0":0.18061254400047194,"x1":0.8193681117056564,"top":0.5273647470870461,"bottom":0.5443109821569079,"conf":1},{"text":"5) Aile hekimi ve aile sağlığı elemanına nöbet planlaması hafta içi sekiz saat ve gece","x0":0.22997947331527757,"x1":0.8193018413789679,"top":0.54215116292462,"bottom":0.5568376071990006,"conf":1},{"text":"24.00'c kadar, hafta sonu ise on altı soutten fuzla olmamak üzere, mesai suatleri ve çalışma","x0":0.182751528264802,"x1":0.8193018596111593,"top":0.5566860466608119,"bottom":0.571367521232366,"conf":1},{"text":"süresi (haftalk 40 saat) dişında yapılacaktır.","x0":0.18275153697097812,"x1":0.48459959220048804,"top":0.5712209300376809,"bottom":0.5843023257656373,"conf":1},{"text":"6) Planlama; ulaşım imkânları ve süresi, defin ve adli tabiplik gibi diğer nöbet görevleri","x0":0.2319569968914432,"x1":0.8214607360512451,"top":0.5822504002494809,"bottom":0.6004537541313169,"conf":1},{"text":"ile yıllık izin ve hastahk izinleri dikkate alınarak yapılacaktır.","x0":0.18275153618227788,"x1":0.6016427141150356,"top":0.597383721078095,"bottom":0.6119658121894983,"conf":1},{"text":"7) Nöbet tlereileri, nöbet tutulan sağlık kurumu tarafından ödenecektir. Nöbet tutan tüm","x0":0.22990548343483047,"x1":0.8214415752128119,"top":0.609429537130628,"bottom":0.6260442293621568,"conf":1},{"text":"personelin bu hizmet kapsamındaki yemek, yer, malzeme vb. ihtiyaçları nöbet tutulan saglık","x0":0.1827515475345995,"x1":0.8213552284785233,"top":0.6250000001488631,"bottom":0.639743589892453,"conf":1},{"text":"kuruluşu tarafıdan karşılaracak, ulaşım konusunda gerekli kolaylık gösterilecektir.","x0":0.18275153970995056,"x1":0.7535934292816329,"top":0.6380341878040544,"bottom":0.6526162789154576,"conf":1},{"text":"8) 09/12/2014 tarihli ve 2014/33 sayılı Genelge yürürlukten kaldırılmıştır.","x0":0.2340862341777853,"x1":0.737166332377226,"top":0.6511627903709571,"bottom":0.667151163108483,"conf":1},{"text":"Bilgilerini ve geregini rica ederim.","x0":0.23408624222726326,"x1":0.4722792606319829,"top":0.6656976745633962,"bottom":0.6803418800317288,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.5811088336088096,"x1":0.757700201687851,"top":0.7165697670775346,"bottom":0.7325581398150605,"conf":1},{"text":"Bakan a.","x0":0.6300013206146354,"x1":0.7006222944715141,"top":0.73237257605884,"bottom":0.745287505897102,"conf":1},{"text":"Müstear","x0":0.6282860597526064,"x1":0.7002560341827875,"top":0.7455252729045542,"bottom":0.7617421688312661,"conf":1},{"text":"Dagitim","x0":0.18650547206294352,"x1":0.24867333047732249,"top":0.7738291345811454,"bottom":0.7880346221503186,"conf":1},{"text":"A PLANI","x0":0.18683760843344174,"x1":0.2608009951259178,"top":0.7862786624515743,"bottom":0.7994771510456946,"conf":1},{"text":"485","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}