{"lines":[{"text":"280","x0":0.06570841927155513,"x1":0.10266940393173027,"top":0.029069767618974618,"bottom":0.042151162531824826,"conf":1},{"text":"Sağlık Bakanhğı'na Bildirim:","x0":0.17025078883502096,"x1":0.38824871688704443,"top":0.31673182030626934,"bottom":0.3343823479343284,"conf":1},{"text":"Kök Hücre Nakilleri Bilimsel Danışma Kurulu tarafından onay verilmiş olan çalışmaların, 6","x0":0.22381930136651398,"x1":0.8418891173193178,"top":0.34572649608422834,"bottom":0.36046511612499144,"conf":1},{"text":"ayda bir gelişme raporlarının ve çalışma sonrasında \"Sonuç Raporunun\" Sağlık Bakanlığı'na","x0":0.1745379874089523,"x1":0.8398357297428777,"top":0.35755813967584404,"bottom":0.3722222223252706,"conf":1},{"text":"bildirilmesi zorunludur.","x0":0.17453798574747278,"x1":0.3367556483327301,"top":0.3720930234545702,"bottom":0.3851744183674203,"conf":1},{"text":"Rapor içeriğinde, çalışma yapılan hastanın:","x0":0.17453798903136714,"x1":0.46406570681543224,"top":0.39957264956696203,"bottom":0.41282051281482524,"conf":1},{"text":"-Adı Soyadı,","x0":0.17432358978858697,"x1":0.26309014677402004,"top":0.4115015675382788,"bottom":0.4266606560642955,"conf":1},{"text":"-Yași,","x0":0.17286504289636628,"x1":0.22205143577619832,"top":0.42359365319204134,"bottom":0.44131049623465946,"conf":1},{"text":"-Cinsiyeti,","x0":0.17439531504396444,"x1":0.24676155672045186,"top":0.4395004797405504,"bottom":0.45394186068965237,"conf":1},{"text":"-TanisI,","x0":0.17405789454989046,"x1":0.23278841090288413,"top":0.45289173421848683,"bottom":0.46541158613128686,"conf":1},{"text":"-Evresi,","x0":0.17453798831051098,"x1":0.2299794653007737,"top":0.4651162792593231,"bottom":0.4781976741721732,"conf":1},{"text":"-Daha önce uygulanan tedaviler,","x0":0.17453798967322384,"x1":0.3942505111351627,"top":0.4794871795182065,"bottom":0.4927350427660697,"conf":1},{"text":"-Kök hücre kaynağı, miktarı, uygulama yolu,","x0":0.17453798539558932,"x1":0.47843942712421117,"top":0.4927325582859916,"bottom":0.5072674417036265,"conf":1},{"text":"-Ek tedaviler,","x0":0.17429791245553486,"x1":0.26964669036491173,"top":0.5044878350151465,"bottom":0.519176608048093,"conf":1},{"text":"-Tedavi sonucu,","x0":0.173921703394847,"x1":0.2860668747390552,"top":0.5183738905558509,"bottom":0.5349436598364394,"conf":1},{"text":"-Gözlem ve öneriler,","x0":0.17635568917768812,"x1":0.31864158161352074,"top":0.5311388515769052,"bottom":0.5452864731229413,"conf":1},{"text":"ayrıntılı biçimde belirtilmelidir.","x0":0.17437097854419137,"x1":0.39027243754273655,"top":0.5452404373406562,"bottom":0.5611673070509426,"conf":1},{"text":"Çalışmayı yapan kurum, hastanın takibinde oluşabilecek beklenmeyen ciddi yan etkilerin","x0":0.22376247025892085,"x1":0.8398862832100054,"top":0.5711758740193608,"bottom":0.5874097486093297,"conf":1},{"text":"veya ölüm durumunun ortaya çıkması halinde, yedi gün içinde sebeplerine yönelik bilgilerle,","x0":0.17453796947018754,"x1":0.8418891352047703,"top":0.5857558136266949,"bottom":0.6017441863642208,"conf":1},{"text":"komplikasyonların ayrıntıhı dökümünü Sağlık Bakanlığı'na bildirir.","x0":0.17453799496247838,"x1":0.6221765838828041,"top":0.6002906974817883,"bottom":0.6133720932097447,"conf":1},{"text":"Klinik kök hücre çalışması tamamlanıp, sonuçları bilimsel bir ortamda veya hakemli","x0":0.2238193013668585,"x1":0.8418891173196623,"top":0.613247863369126,"bottom":0.6250000001212628,"conf":1},{"text":"bilimsel bir dergide yayınlanmadıkça söz konusu çalışma ile ilgili verilerin kamuoyunu","x0":0.1765913927700923,"x1":0.8398357117033601,"top":0.6264534881800745,"bottom":0.6397435898264326,"conf":1},{"text":"yönlendirecek/yanıltacak biçimde açıklanması yasaktır.","x0":0.17248459350029335,"x1":0.5462012315510415,"top":0.6395348836908918,"bottom":0.6542735045467613,"conf":1},{"text":"Hasta hakları ve insan onuruna saygı gereği, hastalarla ilgili bilgilerde mahremiyet hakkının","x0":0.22168063044887049,"x1":0.841985794421626,"top":0.6510528080479943,"bottom":0.6698873932541157,"conf":1},{"text":"gözetilmesi ve tıp etiğine uyulması esastır.","x0":0.1745379874251143,"x1":0.4599589322109554,"top":0.667094017465405,"bottom":0.6816860463522489,"conf":1}]}