{"lines":[{"text":"242","x0":0.06776180655986885,"x1":0.10266940472093199,"top":0.030523255654402504,"bottom":0.042151162877574255,"conf":1},{"text":"Bu hususlar kapsamında uygulamamın aşağıda belirtildiği şekilde yürütülmesi","x0":0.22367298725989598,"x1":0.8153160566182696,"top":0.2107018637460486,"bottom":0.22920787473081172,"conf":1},{"text":"gerekmektedir.","x0":0.17429398092720957,"x1":0.2793486955867471,"top":0.22669052455968686,"bottom":0.2407214913591702,"conf":1},{"text":"1-Aile hekimlerince, bu Genelge ekinde yer alan ve \"Yatağa Bağımlı Kişiler Için Durum","x0":0.22176592216617613,"x1":0.8151950632280904,"top":0.24273255781413627,"bottom":0.2587209305516621,"conf":1},{"text":"Bildirir Tek Hekim Raporu\" formatina uygun şekilde huns/feraporsaglikgovar adresinde","x0":0.17232889328476825,"x1":0.8153435635679831,"top":0.25594279846980694,"bottom":0.2751592348722175,"conf":1},{"text":"yayımlanan Sağlık Bakanlığı e-Rapor sistemi üzerinden elektronik olarak düzenlenccektir.","x0":0.17043120297233463,"x1":0.7700205404331304,"top":0.27307692270776407,"bottom":0.2877906974948192,"conf":1},{"text":"2- Görme ve işitme engelli olan seçmenlere sadece bu engelleri nedeniyle \"Yatağa Bağum?","x0":0.21971251722927143,"x1":0.8172484681909553,"top":0.28924418572146515,"bottom":0.305232558458991,"conf":1},{"text":"Kişiler Için Durum Bildirir Tek Hekim Raporu\" düzenlenmeyecektir.","x0":0.1723139816509403,"x1":0.6346951070122803,"top":0.30142979714089313,"bottom":0.32023415902224706,"conf":1},{"text":"3- Düzenlenen raporlar elektronik imza ile imzalanarak e-Rapor sisteminden çıktı alınarak","x0":0.21961984361631973,"x1":0.8152811591652731,"top":0.31889840748662557,"bottom":0.3360778933619427,"conf":1},{"text":"bir nushası vatandaşa teslim edilecektir.","x0":0.17230357178064046,"x1":0.4416161063204871,"top":0.33422904579592405,"bottom":0.3511087844976384,"conf":1},{"text":"4-Yatağa bağımlılığı tıbbi gerekçesi açık ve anlaşılacak şekilde raporda belirtilecektir.","x0":0.22169