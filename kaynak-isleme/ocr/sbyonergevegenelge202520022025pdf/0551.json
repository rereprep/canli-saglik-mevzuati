tom":0.3692307693609177,"conf":1},{"text":"8 9 10","x0":0.5338809031099712,"x1":0.6283367558722143,"top":0.3575581397351997,"bottom":0.3706395346480499,"conf":1},{"text":"30°0","x0":0.28542094519557976,"x1":0.3223819298557549,"top":0.37936046517075517,"bottom":0.39244186008360527,"conf":0.30000001192092896},{"text":"38°C","x0":0.2854209449389062,"x1":0.3223819295990814,"top":0.39534883738641646,"bottom":0.40843023229926656,"conf":0.5},{"text":"37°C","x0":0.28336755533782915,"x1":0.3223819311098095,"top":0.4113372091449121,"bottom":0.42296511636808387,"conf":0.5},{"text":"Ates","x0":0.6221765909605362,"x1":0.6570841891215994,"top":0.4258720929324732,"bottom":0.43604651165086006,"conf":1},{"text":"Döküntü","x0":0.6283367562647801,"x1":0.6837782332550428,"top":0.44331395348107905,"bottom":0.45203488369468126,"conf":1},{"text":"Lenfadenopat:","x0":0.6201232036776105,"x1":0.7166324429389657,"top":0.4651162790013377,"bottom":0.47529069771972454,"conf":0.5},{"text":"Halsizlik (erişkinlerde)","x0":0.5852156050253403,"x1":0.7268993841687049,"top":0.49273255799209636,"bottom":0.504360465215268,"conf":1},{"text":"Halsizlik (cocuklarda","x0":0.5934291573909004,"x1":0.7227926083142066,"top":0.5188034186435659,"bottom":0.5290697674905231,"conf":1},{"text":"Konjunktivit","x0":0.591375768660837,"x1":0.6714579067039096,"top":0.5436046510925354,"bottom":0.5537790698109223,"conf":0.30000001192092896},{"text":"Nezie belirtileri","x0":0.5893223815267042,"x1":0.6837782342889472,"top":0.5683139534881602,"bottom":0.5770348837017624,"conf":1},{"text":"3.2. Kızamıkçık Hastalığıı Tanısı","x0":0.2094455827614934,"x1":0.441478441668877,"top":0.6132478632968508,"bottom":0.6264957265447141,"conf":1},{"text":"Bazı","x0":0.2525667348704524,"x1":0.2854209442260569,"top":0.6380813955168975,"bottom":0.6497093019249629,"conf":1},{"text":"enfeksiyonlar belirtileri","x0":0.2895277237025551,"x1":0.4640657052824844,"top":0.6380341879984867,"bottom":0.6482905982548969,"conf":1},{"text":"değerlendirmesi çok önem taşımaktadır.","x0":0.20944558835663113,"x1":0.4558521527577987,"top":0.6758720928262637,"bottom":0.68895348855422,"conf":1},{"text":"Doğal enfeksiyonu ve bağışıklamayı takiben humoral ve hucresel bağışıklık gelişmektedir.","x0":0.2525667292120678,"x1":0.809034913289966,"top":0.7004273502637566,"bottom":0.7136752135116199,"conf":1},{"text":"Doğal enfeksiyon sırasında; dokuntunun başlamasından itibaren 3-4 gun içerisinde IgM","x0":0.21149898270299042,"x1":0.8090348967631287,"top":0.7122093024161223,"bottom":0.7239316238041714,"conf":1},{"text":"antikorlan, bir hafta içerisinde ise IgG antikorlan saptanabilir. Aşılamayı takiben, IgM ve IgG","x0":0.20944557757604304,"x1":0.8090349150368388,"top":0.725213675239798,"bottom":0.7384615384876612,"conf":1},{"text":"antikorlannın görülmesi doğal enfeksiyona göre hem daha geç, hem de daha düşük düzeyde","x0":0.21144180233323548,"x1":0.8111317334070528,"top":0.7357854760642618,"bottom":0.7502955672100952,"conf":1},{"text":"olmaktadır. Kızamıkçığa özgü IgM antikoru, genellikle hastalığın sona ermesinden 2 ay sonrasına","x0":0.2094455775587192,"x1":0.809034915019515,"top":0.7499999998078242,"bottom":0.7632478630556874,"conf":1},{"text":"kadar saptanabilmekte ve bazı kişilerde doğal enfeksiyon, aşılama ve yeniden enfeksiyon sonrası","x0":0.21149896485751363,"x1":0.8090349158191974,"top":0.7615384615740385,"bottom":0.7732558140743672,"conf":1},{"text":"6-7 aya kadar da azalarak devam edebilmektedır.","x0":0.21149897706553392,"x1":0.5071868543469351,"top":0.7747093021982443,"bottom":0.7863372094214159,"conf":1},{"text":"Enfeksiyonu takiben, döküntünün başlamasından birkaç gün öncesinden başlayarak en az 7","x0":0.25256672920447304,"x1":0.8090349132823713,"top":0.7978632477752979,"bottom":0.8111111110231612,"conf":1},{"text":"gün sonrasına kadar, virus nazofarengeal sekresyonlardan izole edilebilir. RT-PCR ile viral","x0":0.21143432430865655,"x1":0.8090995044826665,"top":0.8091563635007334,"bottom":0.8231045611508276,"conf":1},{"text":"RNA'nın saptanması yöntemi ile bu süre 3-4 gün daha uzayabilir. Ancak örnek almak için en","x0":0.21149896486339811,"x1":0.8090349158250819,"top":0.8226495728180697,"bottom":0.8343023257025025,"conf":1},{"text":"uygun zaman belirtilerin başlamasını takiben ilk 4 gündür. Aşılanmış kişilerde de, belli düzeylerde","x0":0.21149896568740878,"x1":0.8110883031482047,"top":0.8341880341096934,"bottom":0.8459302326788364,"conf":1},{"text":"virüsůn saptanması mümkůndür.","x0":0.21149897658735078,"x1":0.4106776146073969,"top":0.8473837208666709,"bottom":0.85769230770457,"conf":1},{"text":"537","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}