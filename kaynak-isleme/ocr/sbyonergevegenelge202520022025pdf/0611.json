{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4516747514700037,"x1":0.9610482606475657,"top":0.039307461895094487,"bottom":0.05532729447357421,"conf":1},{"text":"MATERNAL VE NEONATAL TETANOZ (MNT) ELIMINASYON PROGRAMI","x0":0.1887994113980764,"x1":0.7105771167832222,"top":0.23167008039845416,"bottom":0.24867758048452937,"conf":1},{"text":"Bu progranda amaç Türkiye'de 2007 yılı sonuna kadar Maternal Tetanoz (MT) ve","x0":0.2319675413381017,"x1":0.7701005283086089,"top":0.257764358317231,"bottom":0.27294281865846437,"conf":1},{"text":"Neonatal Tetanozun (NT) ve bunlara bağlı ölümlerin elimine edilmesi ve bu duzeyin","x0":0.19091981399658955,"x1":0.7680159251050765,"top":0.27031160740663096,"bottom":0.2841489424552086,"conf":1},{"text":"sürdürülmesidir. Hedef, her bölgede 1000 canlı doğumda l'in altınde NT vakasının görülmesi ve","x0":0.1888355842757761,"x1":0.7700958871872786,"top":0.2817588616081099,"bottom":0.29827989487070505,"conf":1},{"text":"MT'un hię görûlmemesi ve bu durumun devamhılığının sağlanmasıdır. Hedefler aşılama, temiz.","x0":0.1909068223496998,"x1":0.7700747338285012,"top":0.29561377053651605,"bottom":0.3098384383709365,"conf":1},{"text":"doğum, izlem ve sürveyans olmak üzere 4 ana başlık altında ele alınmıştır.","x0":0.19096509967741418,"x1":0.63860368859774,"top":0.3094017095380651,"bottom":0.32136752150387715,"conf":1},{"text":"1. Asilama","x0":0.2319643379961318,"x1":0.2998631770956514,"top":0.32244203336310373,"bottom":0.33308122240671945,"conf":1},{"text":"A. Aşama-1: Eliminasyonun Sağlanmas: (2006-2007)","x0":0.23395229041051888,"x1":0.570974658946549,"top":0.33313063062777226,"bottom":0.3484772816235322,"conf":1},{"text":"a. Tüm gebelerin en az %80'ini takvime uygun olarak aşılı hale getirmek ve bebeklerin","x0":0.19096509529396358,"x1":0.7700205308620939,"top":0.34738372080411184,"bottom":0.3590116280272835,"conf":1},{"text":"korunmasını sağlamak.","x0":0.19096509428659883,"x1":0.326488704707241,"top":0.3602564102783641,"bottom":0.3706395349151528,"conf":1},{"text":"b. 2007 yılı sonuna kadar MNT açısından yüksek riskli bölgelerde destek aşılama aktiviteleri ile","x0":0.1909650952545838,"x1":0.770020530822714,"top":0.37350427357828697,"bottom":0.3837606838346972,"conf":1},{"text":"MNTnin hızla elimine edilmesi için doğurganlık yaş grubu (15-49 yaş) kadınların en az","x0":0.19096509524216704,"x1":0.7700205308102974,"top":0.38504273521100374,"bottom":0.39700854717681566,"conf":1},{"text":"%80'inin primer immünizasyonunu sağlamak (Tetanoz Aşı Günleri). 2006-2007 yıllarında","x0":0.1909650973340046,"x1":0.7700205329021349,"top":0.3968023257176301,"bottom":0.4098837206304802,"conf":1},{"text":"gerçekleştirilmiştir.","x0":0.18891170425891218,"x1":0.308008213461272,"top":0.4098837211305485,"bottom":0.4229651160433987,"conf":1},{"text":"e. Okul döneminde yapılan Td aşılamasında en az %90 aşılama hızına ulaşmak.","x0":0.19096509238023468,"x1":0.6673511291896739,"top":0.4229651162198895,"bottom":0.43333333337841085,"conf":1},{"text":"B. Aşama-2: Eliminasyonun Sürdürülmesi (2007- )","x0":0.23203286116504337,"x1":0.572895278328454,"top":0.43459302334635497,"bottom":0.4462209297544204,"conf":1},{"text":"a. Tüm bölgelerde gebe aşılamaları hızını en az %80 olacak şekilde sürdürmek","x0":0.1909650915846374,"x1":0.6652977418949646,"top":0.44767441847878264,"bottom":0.4594017095696583,"conf":1},{"text":"b. Yüksek Riskli Bölge (YRB) değerlendirmesi güncel tutularak, bölgedeki 15-49 yaş grubu","x0":0.18891170709526497,"x1":0.7679671426633953,"top":0.45930232572832397,"bottom":0.47393162371838926,"conf":1},{"text":"kadınların primer immünizasyonunu sağlamak.","x0":0.19084215124602733,"x1":0.46826749056311845,"top":0.4723390008268227,"bottom":0.485174263810096,"conf":1},{"text":"e. YRB tanımlaması alan bölgelerde nüfusa yeni eklenen 15-49 yaş grubu kadınlan primer","x0":0.19096509525455288,"x1":0.7700205308226832,"top":0.4854651160869847,"bottom":0.4987179486301214,"conf":1},{"text":"immünizasyona almak.","x0":0.1909650940677847,"x1":0.3264887044884269,"top":0.49854651156309027,"bottom":0.5087209302814772,"conf":1},{"text":"d. Tüm bölgelerde, 1 yaş altı çocukların en az %90'ının üç doz Tetanoz içeren aşı ile primer","x0":0.19096509520138247,"x1":0.7700205307695128,"top":0.5101744184782776,"bottom":0.5218023257014492,"conf":1},{"text":"immünizasyorunu ve ayrıca aşıya devamsızlık hızının %10'un altında olmasını sağlamak.","x0":0.19096509458619687,"x1":0.7207392172740936,"top":0.5230769232731655,"bottom":0.5350427352389775,"conf":1},{"text":"e. Okul Td aşılamalannı en az %90 hızında sürdürmek.","x0":0.18891170473985802,"x1":0.5236139624059327,"top":0.5363247862078908,"bottom":0.546581196464301,"conf":1},{"text":"Sağlık Ocağı Düzeyinde Yüksek Riskli Bölge Değerlendirme Şeması","x0":0.19096509172176918,"x1":0.6180698156509749,"top":0.5566860464520825,"bottom":0.5668604651704694,"conf":1},{"text":"Bagede son Us","x0":0.2073921963974584,"x1":0.27720739271958467,"top":0.5841880342320772,"bottom":0.5931623932064363,"conf":0.5},{"text":"yıda vaka","x0":0.20739219686637406,"x1":0.2546201232474956,"top":0.5930232558732603,"bottom":0.6004273505530031,"conf":1},{"text":"górúldo mb?","x0":0.20739219779039766,"x1":0.2628336747806604,"top":0.6002906976609467,"bottom":0.6090116278745489,"conf":0.5},{"text":"нарг","x0":0.3018480487776737,"x1":0.3305954828287076,"top":0.5872093023734536,"bottom":0.594476744082271,"conf":0.30000001192092896},{"text":"Bolgede 100 cenk","x0":0.36960985490043485,"x1":0.44969199294350753,"top":0.5784883720913205,"bottom":0.5872093023049227,"conf":1},{"text":"dogumda en az 1","x0":0.36960985410481645,"x1":0.4476386056487771,"top":0.5871794870277551,"bottom":0.5944767441006603,"conf":1},{"text":"Neonsta Becek Ölumu","x0":0.36755646854375695,"x1":0.47433264952605836,"top":0.5944444442785648,"bottom":0.603197674300115,"conf":0.5},{"text":"lesspit ediliyor mu?","x0":0.3696098556960534,"x1":0.4517453802382381,"top":0.6046511628574373,"bottom":0.611