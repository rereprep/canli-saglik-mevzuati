{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453739730201,"x1":0.9609856316697969,"top":0.04059829028555706,"bottom":0.05523255797844895,"conf":1},{"text":"(4) Toplantılann gündemi toplantı tarihinden en az 2 gün doce Kurul Başkamınca onaylamır ve","x0":0.19294351217837397,"x1":0.7741972466147782,"top":0.24450834545360767,"bottom":0.26058246084813474,"conf":1},{"text":"kurul üyelerine iletilir. Toplantılara konusu itibarıyla Teknik Kurul üyeleri vayu diğer umanler","x0":0.19301848513443443,"x1":0.7761806937007887,"top":0.2601744187457663,"bottom":0.27478632481370413,"conf":1},{"text":"davet edilebilir. Kural toplantısının organizasyonu Sağlık Bakanlığı Bakan Yardımcısı","x0":0.19301848412955427,"x1":0.7741273061967966,"top":0.27470930247435654,"bottom":0.2893162396545741,"conf":1},{"text":"tarafindan koordine edilir.","x0":0.1928460087784728,"x1":0.35750354619959207,"top":0.2885076402260256,"bottom":0.30097443116705214,"conf":1},{"text":"(5) Kurul toplantılarında alınan kararlar ve yapılan çalışmalara yönelik raporlar 6 ayda bir","x0":0.19096509763959688,"x1":0.7761806927050632,"top":0.30377906991648473,"bottom":0.3183760685061553,"conf":1},{"text":"Bağımilkla Mücadele Yilksck Kurulo (BMYK)'na sunulur.","x0":0.19096509108270307,"x1":0.5687885021316753,"top":0.3183139532950535,"bottom":0.33139534902300993,"conf":1},{"text":"(6) BMK'nm görevleri şunlardır:","x0":0.19096509042941637,"x1":0.4004106793957952,"top":0.33284883701176626,"bottom":0.3459302327397227,"conf":1},{"text":"a) Bağımlılık ile mücadele çalışmelerını, BMYK'ya sunımak.","x0":0.23604166359551407,"x1":0.6181783486913046,"top":0.3459205473695284,"bottom":0.36228429772947934,"conf":1},{"text":"b) BMYK kararlarımıe uygulanmasım sağlamak.","x0":0.23600094510113495,"x1":0.5381192857006286,"top":0.36168615425558426,"bottom":0.3773138066113326,"conf":1},{"text":"e) Bağımlılık ile mucadele politiklarına katkı sağlamak.","x0":0.23613963884216907,"x1":0.5913757614993638,"top