{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537413948146,"x1":0.9609856318362582,"top":0.040598290291630645,"bottom":0.055232557984522646,"conf":1},{"text":"Sağlık Kurulu","x0":0.43121149944255277,"x1":0.5770020515841413,"top":0.23247863231432775,"bottom":0.2499999998356952,"conf":1},{"text":"1- Heyet poliklinikleri meveut polildinik bölümlerine yakın, ortak bekleme bölümü ve koridorları","x0":0.1745379838681417,"x1":0.8316221802056191,"top":0.2601744184129542,"bottom":0.2732558141409105,"conf":1},{"text":"paşlaşan bir yapıda tasarlanmahdır. Bu bölim sağlık kurulu odası ve danışma kayıt kasılarımı da","x0":0.1744731417887901,"x1":0.8316766039213097,"top":0.27099610400030794,"bottom":0.2866333664587831,"conf":1},{"text":"bardımalı ve sağhi: kurulu günleri dışında normal poliklinik olarak hizmet verecek şekilde","x0":0.17248461514685612,"x1":0.8316221610818999,"top":0.284883721076726,"bottom":0.2995726497949669,"conf":1},{"text":"planlanacaktur:","x0":0.1745379896408014,"x1":0.2751540019003805,"top":0.29941860451179925,"bottom":0.3110465117349708,"conf":1},{"text":"300 yatakh hastanelerde 8.","x0":0.29339405057265666,"x1":0.4622027166496858,"top":0.309817959467249,"bottom":0.32596076060531987,"conf":1},{"text":"400 yatakh hastanelerde 10","x0":0.2956878861938936,"x1":0.46611909477559893,"top":0.32393162394877173,"bottom":0.33589743591458365,"conf":1},{"text":"500 yatakh hastanelerde 12 adet heyet poliklinik odası yapılacaktur:","x0":0.29559996135528976,"x1":0.7126212272731405,"top":0.3347087499011656,"bottom":0.35032972653669914,"conf":1},{"text":"Amelivathaneler","x0":0.4209445575163369,"x1":0.5852156066007063,"top":0.37500000013650725,"bottom":0.3895348835541421,"conf":0.5},{"text":"1- Ameliyathane personel girişlerinde terlik rafi geçiş havuzu oluşturulacaktır.","x0":0.17659138131114888,"x1":0.6673511236143721,"top":0.40982905984586027,"bottom":0.4200854701022705,"conf":1},{"text":"Terlik / Çoraph geçilecek alan","x0":0.2997946591758341,"x1":0.5092402481422129,"top":0.437499999801356,"bottom":0.45058139552931253,"conf":1},{"text":"Steril / Raf","x0":0.22792607825758576,"x1":0.31211498929888243,"top":0.4491279069755868,"bottom":0.4578488371891889,"conf":1},{"text":"(geçiş alam 2 m) /","x0":0.373716634583742,"x1":0.48665297506337946,"top":0.44912790691045545,"bottom":0.45940170949654635,"conf":1},{"text":"Yarı steril","x0":0.2751195074016135,"x1":0.34089691816482015,"top":0.45919016432894033,"bottom":0.4695889051788835,"conf":1},{"text":"Ameliyathane Tam Steril Alan","x0":0.542094455932401,"x1":0.7330595479559991,"top":0.4374999998675577,"bottom":0.4491452990128568,"conf":1},{"text":"Terlik Raft","x0":0.5358562804542385,"x1":0.609934274121638,"top":0.44742215072270364,"bottom":0.45955459322967307,"conf":1},{"text":"/Tam Steril","x0":0.5154004088224062,"x1":0.5954825468654789,"top":0.4593023259143667,"bottom":0.4752906970216799,"conf":1},{"text":"2- Ameliyathane içindeki dolaplar, 2 ameliyathane arasında duvara gömme şekilde yapılıp yarısını bir","x0":0.17659137036322753,"x1":0.8295687937024809,"top":0.4867521366652351,"bottom":0.49709302331108196,"conf":1},{"text":"ameliyathane diğer yarısım diğer ameliyathane kullanacak sekilde olacaktır. Dolap kapaldarı ameliyathane","x0":0.17659138960892745,"x1":0.8316221625457472,"top":0.4999999999414192,"bottom":0.5102564101978295,"conf":1},{"text":"duvarlarıyla aymı seviyede ve eğimde olup anti bakteriyel olabilmesi için gerekli metal malzemeden","x0":0.17659137036124034,"x1":0.8295687937004936,"top":0.5115384615744979,"bottom":0.5232558140748266,"conf":1},{"text":"3- Ameliyathanelerde imal edilen dolap kapaklarında çerçeveli cam olarak mikrop barındıracak veya zor","x0":0.17659138865992682,"x1":0.8316221615967466,"top":0.5448717949728735,"bottom":0.5568376069386856,"conf":1},{"text":"steril edilecek ara mahalleri olmayacaktır.","x0":0.17659137603004865,"x1":0.43942505087488504,"top":0.5594017091980887,"bottom":0.5697674419127499,"conf":1},{"text":"4- Ameliyadhane odaları tavan ve duvar birleşme noktaları köşesiz ve oval olacaktır. Duvarlar alçı plaka","x0":0.17659137038359513,"x1":0.8295687937228484,"top":0.5799145298268743,"bottom":0.5915697675627204,"conf":1},{"text":"yardımı ile ovalleștirilecek, projelerde detayları gösterilecektir. (Bkz. Ameliyathane Detayı)","x0":0.17453798336864437,"x1":0.7351129404447666,"top":0.5930232556217133,"bottom":0.6061046513496697,"conf":1},{"text":"5- Tüm yeni yapılacak, mevcutta yapını devam eden ve ameliyathane tadilatı olacak hastanelerde,","x0":0.17659138960798393,"x1":0.8316221625448037,"top":0.6277777777948821,"bottom":0.6397435897606941,"conf":1},{"text":"ameliyathane sayılanı aksi belirtilmediği taktirde;","x0":0.1765913742883793,"x1":0.4825462025161132,"top":0.6409883720323013,"bottom":0.651282051391933,"conf":1},{"text":"1-10 yatak için =","x0":0.20123203213417165,"x1":0.3305954830574778,"top":0.6540697673089569,"bottom":0.6658119658780999,"conf":1},{"text":"11-24 yatak için - 1 genel","x0":0.19917864485062398,"x1":0.3901437368742221,"top":0.6656976742218574,"bottom":0.6787790699498139,"conf":1},{"text":"25-49 yatak için","x0":0.2012320319709905,"x1":0.3182751546742383,"top":0.6786324784793392,"bottom":0.6905982904451511,"conf":1},{"text":"- 1 genel +1 lokal","x0":0.32854209437592863,"x1":0.44763860357828844,"top":0.6786324785472341,"bottom":0.6889534884195402,"conf":1},{"text":"- 2 genel +1 lokal","x0":0.32032854059357774,"x1":0.4476386050177719,"top":0.6918604650501617,"bottom":0.7021367520801127,"conf":1},{"text":"76-100 yatak için","x0":0.19875006283254956,"x1":0.31862501936252896,"top":0.7026181758885184,"bottom":0.7179367106091755,"conf":1},{"text":"- 3 genel +1 lokal ameliyat odası olarak düzenlenecektir.","x0":0.32648869864644536,"x1":0.6878850177025214,"top":0.7034188034610482,"bottom":0.7151162791878362,"conf":1},{"text":"Yatak sayısa 100-300 e kadar olan hastanelerde ise her 50 yatak için en az bir adet ameliyat odası","x0":0.20328540598758685,"x1":0.8316221913374962,"top":0.716569767250106,"bottom":0.7296511629780624,"conf":1},{"text":"ellenecek, 300 tizeri yatak sayıs olan hastanelerde ise her 30 yatağa bir adet ameliyat odası projesinde","x0":0.17453798386444566,"x1":0.8316221802019229,"top":0.7294871795229884,"bottom":0.7427350427708516,"conf":1},{"text":"planlanacaktır. Yatak sayısı 100 in üzerinde olan hastanelerde lokal ameliyathaneler günübirlik (out-","x0":0.17659137195946345,"x1":0.8336755682969408,"top":0.7412790695754325,"bottom":0.754360465303389,"conf":1},{"text":"patient) olarak düşimileceginden sayısı ihtiyaç programında belirtilen sayida olacaktu.","x0":0.1745379938661771,"x1":0.7145790490496339,"top":0.754273504090753,"bottom":0.7675213673386162,"conf":1},{"text":"411","x0":0.8993839834347073,"x1":0.9260780286802826,"top":0.9433139533204355,"bottom":0.9549418605436072,"conf":1}]}