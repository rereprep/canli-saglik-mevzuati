210853305,"top":0.39584427241291975,"bottom":0.4130141090604099,"conf":1},{"text":"Görevleri Hakkında Kanun Hükmünde Kararname'nin 40 ıncı maddesine dayanılarak bazırlarmıştır.","x0":0.21748150312294964,"x1":0.7845836055663633,"top":0.4075752673224369,"bottom":0.4246498376114618,"conf":1},{"text":"Tanımlar ve kasaltmalar","x0":0.27104722837985507,"x1":0.4188911670205557,"top":0.4358974358715155,"bottom":0.44622093018768183,"conf":1},{"text":"MADDE 3- (1) Bu Yönergenin uygulanmasıda:","x0":0.270888457521953,"x1":0.5504248789045388,"top":0.4487680279059503,"bottom":0.46277654015836656,"conf":1},{"text":"a) AHBS: Aile Hekimliği Bilgi Yönetim Sistemini,","x0":0.2688637916922057,"x1":0.5586610568153447,"top":0.4619384366454313,"bottom":0.47622677650483136,"conf":1},{"text":"b) ASM: Aile sağlığı merkezlerini,","x0":0.2667536986401462,"x1":0.4684070096534567,"top":0.4747515335991981,"bottom":0.48945160808034716,"conf":1},{"text":"c) Bakanlık: Sağhk Bakanlığını,","x0":0.26670919161168793,"x1":0.4520148412087821,"top":0.48786432069501817,"bottom":0.503245626748245,"conf":1},{"text":"g) HBYS: Hastane Bilgi Yönetim Sistemiai,","x0":0.2668025070268897,"x1":0.5196587789021259,"top":0.5010407593583157,"bottom":0.515483209726822,"conf":1},{"text":"d) Hekim çalışma cetveli: Bir hekimin çalışma zamanının tamamını ihtiva eden çalışna","x0":0.2688557127428833,"x1":0.7906911321451844,"top":0.5142184560259794,"bottom":0.5294869220299191,"conf":1},{"text":"programini,","x0":0.22381930261681776,"x1":0.29158110782713886,"top":0.5290697674363024,"bottom":0.5377906976499046,"conf":1},{"text":"e) HSGM: Halk Sağlığı Genel Mudürlugünü,","x0":0.26283367487573467,"x1":0.523613963221459,"top":0.5405982907543593,"bottom":0.5538461540022226,"conf":1},{"text":"1) KHGM: Kamu Hastancleri Genel Müdürlugunü,","x0":0.26673693254992226,"x1":0.5566853279526391,"top":0.5528729027072952,"bottom":0.5683994411323169,"conf":1},{"text":"g) MHRS: Merkezi Hekim Randevu Sistemini.","x0":0.2648870652835153,"x1":0.5318275131265756,"top":0.5666666664678974,"bottom":0.5799418602284351,"conf":1},{"text":"g) Sağlık tesisi: Sağlık Bakanlığma bağlı, ikinci ve üçüncü basamak sağhk kurumları ile","x0":0.26470939721562275,"x1":0.7907541759126262,"top":0.5777473793459219,"bottom":0.5970068623246775,"conf":1},{"text":"ağz ve diş sağlıği merkezlerini ve hastanelerini,","x0":0.21971252141915007,"x1":0.49486653370943123,"top":0.5930232556166074,"bottom":0.6061046513445637,"conf":1},{"text":"h) SBSGM: Sağhk Bilgi Sistemleri Gencl Madürlüğünü,","x0":0.26283367115732353,"x1":0.5852156098287262,"top":0.6059829058813833,"bottom":0.6192307691292465,"conf":1},{"text":"1) TSM: Toplam sağlığ merkezlerini.","x0":0.2648870637888231,"x1":0.4804928122525379,"top":0.6191860467062618,"bottom":0.632478632388927,"conf":1},{"text":"ifade eder.","x0":0.2627194806061053,"x1":0.3266029010959689,"top":0.6392152539213178,"bottom":0.6514824204502642,"conf":1},{"text":"İKİNCİ BÖLÜM","x0":0.44147844075557346,"x1":0.5523613947360989,"top":0.6729651164825284,"bottom":0.6860465113953786,"conf":1},{"text":"MHRS Hizmetlerinin Merkezi Koordinasyonu","x0":0.3549282851197,"x1":0.6389859207579728,"top":0.6847773188085097,"bottom":0.7026513224878341,"conf":1},{"text":"Görev ve sorumluluklar","x0":0.2628336773809811,"x1":0.4106776160216817,"top":0.7122093022605084,"bottom":0.7223837209788954,"conf":1},{"text":"MADDE 4 (1) MERS hizmetlerinin koordinasyonu; SBSGM, KHGM ve HSGM","x0":0.260548653996262,"x1":0.7846118197001428,"top":0.7237447445483451,"bottom":0.7420723646389276,"conf":1},{"text":"tarafindan birlikte gerçekleştirilir. Bu koordinasyon görevinin yerine getirilmesi için ilgili genel","x0":0.2174407594504916,"x1":0.7866428919465239,"top":0.7361712761951347,"bottom":0.7562190427257504,"conf":1},{"text":"müdürlüklerde ve il sağlık mülkdärliklerinde \"MHRS Hizmet Birimleri\" olusturulur.","x0":0.21539587557916456,"x1":0.6902141133266706,"top":0.7483640464183312,"bottom":0.7675791623486113,"conf":1},{"text":"(2) SBSGM'nin görev ve sorumluluklan şunlardir:","x0":0.25872690154838046,"x1":0.5503080058315576,"top":0.7776162788753268,"bottom":0.7906976746032832,"conf":1},{"text":"a) MHRS hizmetlerinin teknik süreçlerinin takibi, planlanması, yürütülmesi, gelişen","x0":0.2585135867141305,"x1":0.782557305303535,"top":0.7959268009369037,"bottom":0.8143684560225407,"conf":1},{"text":"ihtiyaçlar doğrultusunda KHGM ile HSGM'nin görüşlerini alarak bakım, onaran ve geliştirme","x0":0.21542809349704414,"x1":0.7824938479181445,"top":0.809030111557672,"bottom":0.8260895828184601,"conf":1},{"text":"çalışmalan kapsanında teknik yapıın oluşturulması, gerekli güncellemelerin yapılması, MHRS.","x0":0.21548547492722084,"x1":0.7906727797918482,"top":0.8231626689992142,"bottom":0.8383520550246675,"conf":1},{"text":"süreçlerine ilişkin yazılun ve donanımım temini.","x0":0.21334285864385819,"x1":0.49511791228394475,"top":0.8346302986886036,"bottom":0.8499633292588702,"conf":1},{"text":"377","x0":0.8952772073413626,"x1":0.9281314166969672,"top":0.9433139533263986,"bottom":0.9549418605495703,"conf":1}]}