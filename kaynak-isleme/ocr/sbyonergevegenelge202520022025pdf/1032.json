{"lines":[{"text":"1018","x0":0.06365503082543945,"x1":0.10472279309653179,"top":0.029069767496336607,"bottom":0.042151162409186704,"conf":1},{"text":"İKİNCİ BÖLÜM","x0":0.44763860581995774,"x1":0.5605749462995951,"top":0.2688034189120976,"bottom":0.2820512821599609,"conf":1},{"text":"Muhakkiklik Eğitiminin Esasları","x0":0.40246406212999974,"x1":0.6078028780981546,"top":0.28034188034570584,"bottom":0.2906976744698201,"conf":1},{"text":"Genel esaslar","x0":0.2710472270512896,"x1":0.3531827515934743,"top":0.29941860483227434,"bottom":0.309593022735555,"conf":1},{"text":"Madde 5- (1) Muhakkiklik hizmet içi eğitimi programının standartları; Bakanlığın","x0":0.2689938356753595,"x1":0.7823408663703603,"top":0.3110465116355756,"bottom":0.3197674418491778,"conf":1},{"text":"stratejik planları, Bakanlığımıza çeşitli vasıtalarla iletilen şikäyet ve temennilerin içerikleri ile","x0":0.2278798977587168,"x1":0.7823750669035929,"top":0.3190075899085216,"bottom":0.3301107023819687,"conf":1},{"text":"Teftiş Kurulu Başkanlığının inceleme, soruşturma ve denetimlerde tespit ettiği hususlar da","x0":0.22792606972136462,"x1":0.7843942537992629,"top":0.3299145298493267,"bottom":0.3401709401057369,"conf":1},{"text":"dikkate alınarak belirlenir.","x0":0.22773508497261283,"x1":0.3800719343836051,"top":0.3399090559729049,"bottom":0.35176688551514645,"conf":1},{"text":"Muhakkiklik eğitiminin hedefleri","x0":0.2708963524752029,"x1":0.47447190189493343,"top":0.35997442810818303,"bottom":0.3717390050119582,"conf":1},{"text":"Madde 6- (1) Muhakkiklik eğitim programının hedefi;","x0":0.2710472196027155,"x1":0.5831622257785581,"top":0.3705128204430139,"bottom":0.38081395354177927,"conf":1},{"text":"a) Bakanlık taşra ve merkez teşkilatında inceleme ve soruşturma görevlerini ifa eden","x0":0.2689938356800637,"x1":0.7823408663750644,"top":0.38076923058699363,"bottom":0.39102564084340385,"conf":1},{"text":"muhakkiklerin günün koşularına uygun olarak yetiştirilmelerini sağlamak,","x0":0.22792609417460513,"x1":0.6488706217049294,"top":0.3909883721835642,"bottom":0.40261627859162963,"conf":1},{"text":"b) Görevin gerektirdiği bilgi, beceri ve davranışlara sahip olmalarını temin etmek, temsil","x0":0.26694044918008164,"x1":0.7843942528733064,"top":0.4011627906387716,"bottom":0.4115384615364266,"conf":1},{"text":"kabıliyetlerini yükseltmek,","x0":0.2279260776310695,"x1":0.38193018499449244,"top":0.41279069767800414,"bottom":0.42151162789160623,"conf":1},{"text":"e) Muhakkiklik görevini ifa eden personelin niteliklerini ve verimliliklerini artırmak,","x0":0.268993833728475,"x1":0.7823408644234757,"top":0.42005813970294403,"bottom":0.43168604611100947,"conf":1},{"text":"inceleme ve araştırma kapasitelerini geliştirmek,","x0":0.2279260738409494,"x1":0.5030800861312306,"top":0.43162393168617486,"bottom":0.4418803419425852,"conf":1},{"text":"ç) Muhakkiklerin görevlerini ifa ederken tarafsızlık, kamu yararı ve etik kurallar","x0":0.26488705954969155,"x1":0.7823408632429163,"top":0.44040697688317654,"bottom":0.4521367520103592,"conf":1},{"text":"çerçevesinde hareket etmelerini temin etmek,","x0":0.22780995730146525,"x1":0.4867385814465302,"top":0.4508480506680528,"bottom":0.46225774864901514,"conf":1},{"text":"d) Çalışma disiplini, ekip çalışması, iletişim becerileri, analitik ve disiplinler arası","x0":0.2669404483759073,"x1":0.7823408655700199,"top":0.46220930226648216,"bottom":0.47238372098486914,"conf":1},{"text":"düşünme alışkanlığını yerleştirmek,","x0":0.22792607366278822,"x1":0.4312115031318311,"top":0.4722222222359873,"bottom":0.4825581395865607,"conf":1},{"text":"e) Güncel inceleme, soruşturma ve rapor yazım teknikleri konularındaki becerilerini","x0":0.2648870610935667,"x1":0.7823408647867915,"top":0.4824786323817418,"bottom":0.49273504263815204,"conf":1},{"text":"geliştirmek","x0":0.22792607803507156,"x1":0.29363449674628067,"top":0.49273255806382554,"bottom":0.5029069767822124,"conf":1},{"text":"f) Rapor yazım tekniklerinde standardizasyonu ve objektifliği sağlamak.","x0":0.2689938327998123,"x1":0.679671464736122,"top":0.5029069767514839,"bottom":0.511627906965086,"conf":1},{"text":"g)","x0":0.26899383977608854,"x1":0.2854209444538908,"top":0.513081395271106,"bottom":0.5218023254847081,"conf":1},{"text":"Muhakkiklerin","x0":0.28952772112137587,"x1":0.38603696038273094,"top":0.5130813953474141,"bottom":0.5218023255610162,"conf":0.5},{"text":"aldıkları","x0":0.3919140839583894,"x1":0.4500447149497243,"top":0.5120525560214824,"bottom":0.5217953075098011,"conf":1},{"text":"eğitimler","x0":0.45174537978787693,"x1":0.5112936343890568,"top":0.5130813953401466,"bottom":0.5218023255537487,"conf":1},{"text":"doğrultusunda","x0":0.519176758006452,"x1":0.608085810309817,"top":0.5114273099909902,"bottom":0.5232132296369028,"conf":1},{"text":"teorik","x0":0.6160164269020014,"x1":0.6570841891730937,"top":0.5130813953727507,"bottom":0.5203488370815682,"conf":1},{"text":"bilgilerini, pratige","x0":0.6591375785113044,"x1":0.7823408607118882,"top":0.5130813953509246,"bottom":0.5218023255645268,"conf":1},{"text":"aktarabilmelerini,","x0":0.2258726888666645,"x1":0.33059548334985395,"top":0.5232558140192186,"bottom":0.530523255728036,"conf":1},{"text":"Temin etmektir.","x0":0.27104722751053784,"x1":0.3655030802727809,"top":0.5333333331333916,"bottom":0.5423076921077505,"conf":1},{"text":"Muhakkiklik eğitimiyle ilgili sorumluluklar","x0":0.27515400197289597,"x1":0.5318275173203963,"top":0.5537790698402376,"bottom":0.5611111111649508,"conf":1},{"text":"Madde 7- (1) Muhakkiklik eğitiminde belirlenen hedeflere ulaşılabilmesi için ilgililerir","x0":0.2731006086765692,"x1":0.778234093375122,"top":0.5639534884464154,"bottom":0.571367521309152,"conf":1},{"text":"sorumlulukları şunlardır;","x0":0.22997946558191917,"x1":0.3716632447252838,"top":0.5739316240936776,"bottom":0.5829059830680366,"conf":1},{"text":"a) Bu yönergede belirtilen hükümlere göre eğiticiler ve eğitime tabi tutulacak personel","x0":0.2669404491839158,"x1":0.7843942528771406,"top":0.5828488371503235,"bottom":0.593162393283496,"conf":1},{"text":"eğitime katılmaktan sorumludur.","x0":0.22780051463173148,"x1":0.416911543854213,"top":0.5927124551019783,"bottom":0.6033358763226762,"conf":1},{"text":"b) Muhakkiklik eğitiminden yararlanmada, belirlenecek öncelik prensipleri dähilinde","x0":0.26694044838446307,"x1":0.7823408655785759,"top":0.6029914528851521,"bottom":0.6133720930780806,"conf":1},{"text":"talep eden veya kendi birimlerince bu eğitime katılması istenilen personel, belirlenen muhakkik","x0":0.2279260713653622,"x1":0.7823408689441484,"top":0.6132478634349413,"bottom":0.6235465116822932,"conf":1},{"text":"ihtiyacına göre. Muhakkiklik eğitim etkinliklerine katılır.","x0":0.22792607607774032,"x1":0.556468174246479,"top":0.6235042735734037,"bottom":0.6337606838298139,"conf":1},{"text":"c) Gerektiğinde ilgili kurum ve kuruluşlarla, muhakkiklik eğitimi için iş birliği","x0":0.2648870619104837,"x1":0.7843942521028204,"top":0.6337209301730407,"bottom":0.6440170939765325,"conf":1},{"text":"sağlanarak; bilgi, belge, araç-gereç ve eğitici değişimi yapılır.","x0":0.22792608482228024,"x1":0.579055434481251,"top":0.64389534870923,"bottom":0.6555555557403496,"conf":1},{"text":"ç) Muhakkiklik eğitimleri, Bakanlığın amaçları, görevleri, yetkileri, sorumlulukları ve","x0":0.26689566617542954,"x1":0.7824028026391161,"top":0.6523360301158482,"bottom":0.6650409649451688,"conf":1},{"text":"ihtiyaçları doğrultusunda; bir plân ve programa dayalı olarak düzenlenir","x0":0.22997945828212907,"x1":0.6386037037193268,"top":0.6641025641950368,"bottom":0.6730769231693957,"conf":1},{"text":"d) Eğitimler, etkinlik ve verimlilik ilkelerine uygun olarak yürütülür.","x0":0.2688989583075876,"x1":0.663343600380309,"top":0.6718919203578082,"bottom":0.6852637384438292,"conf":1},{"text":"e) Eğitim yapılacak ortamlar, eğitimin gereklerine göre düzenlenir ve donatılır. Eğer","x0":0.27104722216921984,"x1":0.7802874798659966,"top":0.6845930231966951,"bottom":0.6948717946705064,"conf":1},{"text":"eğitim,","x0":0.22792607922822114,"x1":0.2731006144975375,"top":0.6947674417470727,"bottom":0.7049418604654596,"conf":1},{"text":"uzaktan eğitim yoluyla yapılacaksa gerekli teknik altyapı ve program desteğ","x0":0.2792607890167884,"x1":0.7782340773164597,"top":0.6947674418014139,"bottom":0.7051282052208016,"conf":1},{"text":"katılımcılara sağlanır.","x0":0.22792607951059102,"x1":0.3511293617111748,"top":0.70494186046551,"bottom":0.7136752137135194,"conf":1},{"text":"f) Muhakkiklik eğitim plânı ve programları ile eğitim faaliyetleri Bakanlık birimlerinin","x0":0.26892022121931963,"x1":0.7824201350173092,"top":0.7122786167598189,"bottom":0.7260000616315093,"conf":1},{"text":"asli görevlerini aksatmayacak biçimde düzenlenir.","x0":0.22587269045660593,"x1":0.5133470217415591,"top":0.7238372091717524,"bottom":0.7354700852826445,"conf":1},{"text":"g) Muhakkiklik eğitimine tabi tutulan personel, eğitimde kazandırılan niteliklerine ve","x0":0.26694044833972863,"x1":0.7823408655338414,"top":0.7340116277796103,"bottom":0.7457264958360788,"conf":1},{"text":"eğitime gönderilme amaçlarına uygun görevlerde değerlendirilir.","x0":0.22792607353246977,"x1":0.597535938584994,"top":0.7440170940135916,"bottom":0.7559829059794035,"conf":1},{"text":"ğ) Eğitimden beklenen sonuçlara ulaşılıp ulaşılamadığının belirlenmesi için eğitim","x0":0.2689938356809192,"x1":0.7823408663759199,"top":0.7558139534293667,"bottom":0.7659883721477536,"conf":1},{"text":"çalışmaları sırasında ve bitiminde değerlendirme yapılır.","x0":0.2258726827946195,"x1":0.5503080079651341,"top":0.7645299145646474,"bottom":0.7761627902679862,"conf":1},{"text":"Belge dogrul","x0":0.17599478007219604,"x1":0.23056563428688392,"top":0.8416878163764772,"bottom":0.8529763312880961,"conf":1},{"text":"Bu belge, güvenli elektro","x0":0.38809035025118327,"x1":0.4866529760116503,"top":0.834188034234001,"bottom":0.84316239320836,"conf":1},{"text":"1C 012 145 11122815","x0":0.49075975366124946,"x1":0.5626283364824878,"top":0