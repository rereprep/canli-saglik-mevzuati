ttom":0.41141931629442363,"conf":1},{"text":"11. Sağlık personeli herhangi bir riskli temas durumunda Enfeksiyon Hastalıklan Uzmanma","x0":0.1784912269220173,"x1":0.8215156392132432,"top":0.41972405366982835,"bottom":0.438769003128024,"conf":1},{"text":"yönlendirilecektir.","x0":0.2008273903932683,"x1":0.3328036921469478,"top":0.43329815008883843,"bottom":0.4495665362775738,"conf":1},{"text":"12. Bunun yamı sıra, Birinci Basamak Sağlık Kuruluşlanndaki tüm çalışanların KKKA","x0":0.17854620906866955,"x1":0.8193954228591017,"top":0.4609969085736707,"bottom":0.4786797608704185,"conf":1},{"text":"şüpheli vakalara yaklaşım konusundaki eğitimleri devam edecek, bu hastalara müdahale","x0":0.20322080161048536,"x1":0.8214192194493419,"top":0.4751482459107432,"bottom":0.4915412194600889,"conf":1},{"text":"ederken standar korunma önlemlerinin alınması sağlanacaktır. Bu amaçla Sağlık","x0":0.20525477098027076,"x1":0.8214360396376922,"top":0.48924081758253,"bottom":0.5038787499931371,"conf":1},{"text":"Müdürlükleri tarafindan yeterli miktarda koruyucu malzeme temin edilmeye devam","x0":0.20110721324751682,"x1":0.8194586248939988,"top":0.501974587888967,"bottom":0.5200217242120317,"conf":1},{"text":"13. Hasta ve hasta yakınlarına KKKA hastalığı, bulaşma yollanı ve korunma tedbirleri","x0":0.17640664277000892,"x1":0.8194830862403838,"top":0.5415128699614864,"bottom":0.5633618794834924,"conf":1},{"text":"konusunda bilgi verilecektir.","x0":0.1991786495162621,"x1":0.4024640605345322,"top":0.5566860466250259,"bottom":0.5713675211965799,"conf":1},{"text":"14. KKKA hastalığından korunma yolları ve hastahktan şüphelenilmesi durumunda yapılması","x0":0.1764632720443182,"x1":0.8194316677894814,"top":0.5837560337615945,"bottom":0.6021393247941736,"conf":1},{"text":"gereken işlemler konusunda toplumun bilgilendirilmesi ve bilinçlendirilmesi amacıyla","x0":0.2011817580820456,"x1":0.81936847813098,"top":0.5983561484796165,"bottom":0.6148914004556949,"conf":1},{"text":"yürütülen eğitim çalışmalanna arttırılarak: devam edilecekir.","x0":0.20114754819079766,"x1":0.6120137839261363,"top":0.6120826588121476,"bottom":0.6279367908857049,"conf":1},{"text":"Belirtilen bu hususlara titizlikle uyulması, Kırım-Kongo Kanamahı Ateşi hastahığıyla ilgili","x0":0.17648480992837767,"x1":0.8193960082780225,"top":0.6391534719050675,"bottom":0.6573126796322226,"conf":1},{"text":"bütün uygulamaların Bakanlığımızca yayımlanan genelge ve talimatlar doğrultusunda","x0":0.17442211451033834,"x1":0.8173561180150994,"top":0.6531144450451427,"bottom":0.6703934007818736,"conf":1},{"text":"yürütülmesi hususlarında bilgilerinizi ve gereğini önemle rica ederim.","x0":0.17659137410460526,"x1":0.6488706379158204,"top":0.665697674091094,"bottom":0.6816860468286199,"conf":1},{"text":"Prof. DryRecep AKDA","x0":0.6054498863156039,"x1":0.7662097902475965,"top":0.7361631683749469,"bottom":0.7523299955849412,"conf":1},{"text":"Bakan","x0":0.6689077735884854,"x1":0.7191463448477314,"top":0.7520296488394828,"bottom":0.7642921708929975,"conf":1},{"text":"EK:","x0":0.1745379872486423,"x1":0.20944558540970545,"top":0.7747093019418363,"bottom":0.7906976746793623,"conf":1},{"text":"1- Vaka yönetimi algoritması","x0":0.17659137230339692,"x1":0.3819301882715518,"top":0.7876068377577585,"bottom":0.8068376069885278,"conf":1},{"text":"DAGITIM:","x0":0.17448687542683783,"x1":0.26083139947365613,"top":0.8152802187078673,"bottom":0.8329755951121975,"conf":1},{"text":"81 il Valiligine","x0":0.1744891590595575,"x1":0.28546977298023746,"top":0.8283445933851075,"bottom":0.8475274995766806,"conf":1},{"text":"669","x0":0.8932238196822326,"x1":0.9301848043424078,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}