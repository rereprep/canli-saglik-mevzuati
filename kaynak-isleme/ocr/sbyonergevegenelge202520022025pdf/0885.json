{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537413210447,"x1":0.9609856318288812,"top":0.04059829029136153,"bottom":0.05523255798425353,"conf":1},{"text":"14. Ekte gönderilen tip sözleşmede idareler tarafindan doldurulması gereken maddeler ve","x0":0.19082549516986264,"x1":0.8441023376492687,"top":0.23721705318332298,"bottom":0.25674550247823646,"conf":1},{"text":"idarelerce öngörülecek diğer hususlar ilgili mevzuat hükümlerine aykırı olmamak şartıyla","x0":0.1415210042563259,"x1":0.8441086439508165,"top":0.2510151848905452,"bottom":0.27196498875641817,"conf":1},{"text":"doldurulacaktır.","x0":0.1433407995144426,"x1":0.2653424197875022,"top":0.2655171899081983,"bottom":0.28077745757344186,"conf":1},{"text":"15. Ilgi genelge doğrultusunda imzalanan sözleşmeler, sözleşme süresi sonuna kadar","x0":0.1907959609807038,"x1":0.8441107382488794,"top":0.29477392988040063,"bottom":0.31575111642574816,"conf":1},{"text":"uygulanabilecektir. Bu sözleşmelerle ilgili damga vergisi hususunda 29.01.2014 tarihli ve","x0":0.1436598334479952,"x1":0.8440344136560136,"top":0.31078971573414793,"bottom":0.3294347789550931,"conf":1},{"text":"2014.5454.327 sayılı yazımız ekinde gönderilen Maliye Bakanlığı Gelir Idaresi Başkanlığı'nın","x0":0.14365597227930238,"x1":0.8440170465216694,"top":0.32529600526030156,"bottom":0.3445929823116045,"conf":1},{"text":"görüşü doğrultusunda hareket edilecektir.","x0":0.14373716404177675,"x1":0.4476386057703986,"top":0.3414529913907799,"bottom":0.35610465100579924,"conf":1},{"text":"16. Bu genelgenin yayımı itibari ile ilgide kayıth genelge yürürlükten kaldırılmıştır.","x0":0.19085895383756782,"x1":0.8420136622386032,"top":0.37044464032797575,"bottom":0.38924211700680766,"conf":1},{"text":"Yürürlükten kaldınılan ilgi genelge doğrultusunda alım süreci devam eden ancak henüz sözleşme","x0":0.14364164481730707,"x1":0.8440244909715167,"top":0.3849216871322435,"bottom":0.4017235465069826,"conf":1},{"text":"imzalanmamış alımlarda bu genelge hükümleri doğrultusunda hareket edilecektir.","x0":0.1415904731755263,"x1":0.7352115760771096,"top":0.3991922416009863,"bottom":0.4168786045603672,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.1971252571535959,"x1":0.46201231849754426,"top":0.4286324787269207,"bottom":0.44331395329847467,"conf":1},{"text":"som","x0":0.6754859704671541,"x1":0.8173271716036036,"top":0.4605418251969585,"bottom":0.4871325930818243,"conf":0.5},{"text":"Dr. Ercan ÖZGÜL","x0":0.6714579057554395,"x1":0.8151950713979161,"top":0.48675213692448394,"bottom":0.5000000001723472,"conf":1},{"text":"Kurum Başkan V.","x0":0.6714579072076275,"x1":0.8069815176282698,"top":0.5029069768839198,"bottom":0.517521367395718,"conf":1},{"text":"871","x0":0.8973305957824219,"x1":0.9281314163325679,"top":0.9433139533204355,"bottom":0.9549418605436072,"conf":1}]}