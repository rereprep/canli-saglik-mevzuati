ciddi","x0":0.2546201275672012,"x1":0.800821342247994,"top":0.4794871797209499,"bottom":0.49418604621463147,"conf":1},{"text":"sorunlara yol açan bir hastalıktır. Bu hastalık için Avrupa ülkeleri için bir haberleşme","x0":0.20944559284140254,"x1":0.8008213474042049,"top":0.49401709394820315,"bottom":0.5072674420474796,"conf":1},{"text":"ağı kurulmuş olup, ülkemiz de bu ağın içinde yer almaktadır. 1996 yılında yayınlanan","x0":0.2073922055470716,"x1":0.8008213466089859,"top":0.5072649575654681,"bottom":0.5218023254269631,"conf":1},{"text":"Ilgi'de belirtilen genelge doğrultusunda Lejyoner hastalığına yönelik çalışmalar,","x0":0.20944559283153516,"x1":0.8008213473943374,"top":0.518803418924117,"bottom":0.5320512821719802,"conf":1},{"text":"bilimsel gelişmeler göz önüne ahınarak ekte gönderilen \"Seyahat İlişkili Lejyoner","x0":0.20944559741059052,"x1":0.8008213519733928,"top":0.5303418804627023,"bottom":0.5436046507812797,"conf":1},{"text":"Hastalığı Kontrol Programıi çerçevesinde yeniden düzenlenmiştir.","x0":0.20944559249788933,"x1":0.657084181418215,"top":0.5448717950487618,"bottom":0.5581395350701659,"conf":1},{"text":"Ekte gönderilen \"Seyahat İlişkili Lejyoner Hastalığı Kontrol Programı\" göz","x0":0.25462013493380026,"x1":0.7987679631154809,"top":0.5696581195111962,"bottom":0.5829059827590594,"conf":1},{"text":"önüne alınarak, özellikle hastanelere öncelik vererek vaka sürveyansı çalışmalarını, Il","x0":0.20940879972664278,"x1":0.7988192148778859,"top":0.5828176913803019,"bottom":0.5944767059109729,"conf":1},{"text":"Turizm Müdürlükleri ile işbirliği içinde Bulaşıcı Hastalıklar Şube Müdürlüğü ve Gıda","x0":0.20739220554336504,"x1":0.8008213466052794,"top":0.5957264957430903,"bottom":0.609011628094175,"conf":1},{"text":"ve Çevre Kontrol Şube Müdürlükleri sorumluluğunda çevresel sürveyans çalışmalarımı","x0":0.20944559284024644,"x1":0.8008213474030488,"top":0.6089743590858926,"bottom":0.6206395350047325,"conf":1},{"text":"düzenlemeniz gerekmektedir.","x0":0.2073921927534236,"x1":0.41067762222246645,"top":0.620512820713987,"bottom":0.6337606839618501,"conf":1},{"text":"Ilgi'de belirtilen 30.05.1996 tarih ve 6076 sayıl Daimi Genelge, bu genelge ile","x0":0.2505133387352418,"x1":0.8008213633158041,"top":0.6468023253893489,"bottom":0.6598837211173053,"conf":1},{"text":"yürürlükten kaldırılmış olup, ekte gönderilen Seyahat İlişkili Lejyoner Hastalığı","x0":0.20523506177415637,"x1":0.7988441716734536,"top":0.6572897403967622,"bottom":0.6739309455893934,"conf":1},{"text":"Kontrol Programı\"nın il düzeyindeki bütün sağlık kuruluşlarında dağıtımının yapılması","x0":0.20725950642370322,"x1":0.8009115328204119,"top":0.6699936231249735,"bottom":0.6872628277455957,"conf":1},{"text":"ve personel eğitimlerinde göz önüne alınması hususunda bilgi ve gereğini önemle rica","x0":0.20524181813374787,"x1":0.8009143517525319,"top":0.6818041569376874,"bottom":0.7000410084261105,"conf":1},{"text":"Doç. Dr. Osman DURMUŞ","x0":0.5749486630481139,"x1":0.7597535955743759,"top":0.7730769231985289,"bottom":0.7863372094807993,"conf":1},{"text":"Sağlık Bakam","x0":0.5749486664526928,"x1":0.6735112922131599,"top":0.787606837685904,"bottom":0.7995726496517159,"conf":1},{"text":"EK : Kontrol Programı (23) sayfa","x0":0.20717087272520526,"x1":0.43963824733080153,"top":0.7960776930654342,"bottom":0.8148885603097961,"conf":1}]}