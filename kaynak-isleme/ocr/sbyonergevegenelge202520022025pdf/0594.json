4979726405162,"x1":0.7721511415430722,"top":0.38061668479555766,"bottom":0.39507054502139827,"conf":1},{"text":"sevkiyatı yapılması gerektiği belirtilmektedir.","x0":0.19301848476592254,"x1":0.4661190921063189,"top":0.3952991453493304,"bottom":0.4069767443025776,"conf":1},{"text":"Aşının depolandığı yer","x0":0.2646745273898681,"x1":0.4088257837251254,"top":0.4158739078518059,"bottom":0.4290537855323969,"conf":1},{"text":"Sevk dönemleri","x0":0.5215605769318976,"x1":0.6221765891914767,"top":0.41569767435113847,"bottom":0.42606837595352,"conf":1},{"text":"Bölge deposu ve Il deposu","x0":0.26283367212209574,"x1":0.4209445617091291,"top":0.4302325580069438,"bottom":0.4418803420036562,"conf":1},{"text":"De ayda bir","x0":0.5190928194597181,"x1":0.5937289028758093,"top":0.4275797997266382,"bottom":0.4425056113637993,"conf":1},{"text":"liçe deposu / TSM","x0":0.26259125299422414,"x1":0.3760566324808617,"top":0.44174706835349276,"bottom":0.45519714234557807,"conf":1},{"text":"Ayda bir","x0":0.5212046391265307,"x1":0.5773509033469103,"top":0.4420936582594457,"bottom":0.4560769478639587,"conf":1},{"text":"Sağlık Ocağı / Aile Hekimi","x0":0.2607802872403435,"x1":0.4271047228238249,"top":0.4549418602673809,"bottom":0.46802325599533723,"conf":1},{"text":"Ayda bir","x0":0.5215605755666283,"x1":0.577002052556891,"top":0.4549418606579533,"bottom":0.4680232555708035,"conf":1},{"text":"Sağlık Evi","x0":0.2607119999298256,"x1":0.32861038237271967,"top":0.46782171688644913,"bottom":0.4798527014878531,"conf":1},{"text":"Haftada bir","x0":0.5194616313942009,"x1":0.5914213241312682,"top":0.4664278612765169,"bottom":0.4783395803460385,"conf":1},{"text":"Kurumların aşı, antiserum ve malzeme ihtiyaçları bu sevk dönemi süreleri dikkate alınarak","x0":0.22783094131054366,"x1":0.7742221989506397,"top":0.4868516961939967,"bottom":0.5014980372407132,"conf":1},{"text":"hesaplanır. Sağlık Bakanlığı merkez deposundan Il Sağlık Mudurluklerine aşı ve antiserum","x0":0.19494814138166958,"x1":0.7742317023040547,"top":0.49827723932654877,"bottom":0.5147450885363261,"conf":1},{"text":"dağıtımı aşąğıda belirtilen dönemler için. ilgili dönemin ilk ayında il deposunda olacak şekilde","x0":0.1949617206400672,"x1":0.7742612968331974,"top":0.5113956622274616,"bottom":0.528080912501598,"conf":1},{"text":"yapılmaktadır.","x0":0.19070259965359254,"x1":0.28348973685235784,"top":0.5269863470040194,"bottom":0.5403611606055213,"conf":1},{"text":"Sevk dönemi","x0":0.2895107868927178,"x1":0.3716801778282812,"top":0.5479052208977448,"bottom":0.5596529185812259,"conf":1},{"text":"2","x0":0.32443531833350264,"x1":0.336755646553561,"top":0.5741279067926962,"bottom":0.5843023255110831,"conf":1},{"text":"Aylar","x0":0.5215605738126181,"x1":0.5605749495845985,"top":0.5479651161235564,"bottom":0.559593023346728,"conf":1},{"text":"Ocak - Şubat - Mart","x0":0.5236139623132209,"x1":0.652977413236527,"top":0.5610465115617896,"bottom":0.5713675214340957,"conf":1},{"text":"Nisan - Mayıs - Haziran","x0":0.5154004124965441,"x1":0.6632443511372446,"top":0.5739316239595118,"bottom":0.5858974359253237,"conf":1},{"text":"Temmuz - Ağustos - Eylil","x0":0.509240245355759,"x1":0.6735112944401284,"top":0.5871794872371555,"bottom":0.5988372094168618,"conf":1},{"text":"Ekim - Kasım - Aralık","x0":0.5195071862994979,"x1":0.6611909654428625,"top":0.6017094017303545,"bottom":0.6119658119867647,"conf":1},{"text":"2) AŞI İHTİYACININ BELİRLENMESİ","x0":0.225638337890347,"x1":0.4950727766857389,"top":0.6333145437626296,"bottom":0.6500771957114769,"conf":1},{"text":"Dönemlik aşı ihtiyacı belirlenirken o dönemde tüketilmesi planlanan aşı yanında rezerv stok","x0":0.22587268181995124,"x1":0.7761807064005136,"top":0.6468023257258476,"bottom":0.6615384613227506,"conf":1},{"text":"ve fire de dikkate alınmalıdır.","x0":0.19489366356342894,"x1":0.3738682072536779,"top":0.6611027657769716,"bottom":0.6733708358511997,"conf":1},{"text":"a) Il Sağlık Müdürlüğü Ayı İhtiyacı:","x0":0.23799504120750692,"x1":0.47652517368110314,"top":0.680190638743219,"bottom":0.6963338115697414,"conf":1},{"text":"Her dönemde kullanılmast beklenen aşı miktarı, her antijen için dönem hedef nüfusu göz","x0":0.22786633258630004,"x1":0.7762439635188877,"top":0.692993408517237,"bottom":0.7072288773246206,"conf":1},{"text":"Unünde bulundurularak ayrı aynı hesaplanmalıdır. Yıllık hedef nüfus dörde bölünerek üç aylık","x0":0.1970416085865835,"x1":0.7762582301054393,"top":0.7046568088020098,"bottom":0.719081074150004,"conf":1},{"text":"dönem hedef nüfusu bulunur. Belirlenen hedef nüfus uygulanan aşı doz sayıst ile çarpılarak","x0":0.1971252601604408,"x1":0.7761806957285711,"top":0.7179487178769425,"bottom":0.7296511628990038,"conf":1},{"text":"yapılacak așı miktarı hesaplanır (örneğin katsayı DaBT-IPA-Hib ve KPA için dört, Hep B için Uç,","x0":0.19489855051259883,"x1":0.7762814034566927,"top":0.7290916441898438,"bottom":0.746745499081629,"conf":1},{"text":"BOG için bir, vb olmalıdır). Hesaplanan șı miktarına fire payı ve rezerv stok eklendikten sonra","x0":0.19705272855884617,"x1":0.7762632244211497,"top":0.742202491012175,"bottom":0.7574683731292915,"conf":1},{"text":"çıkan miktar ilin üç aylık ihtiyacını yansıtmaktadır. Son olarak hesaplanan bu miktardan il depo","x0":0.1970043223630436,"x1":0.7762706502636822,"top":0.7542120953546373,"bottom":0.7689483931576847,"conf":1},{"text":"mevcudu çıkarılarak nihai üç ayhık İstek miktarı bulunmalıdır.","x0":0.19488776875117822,"x1":0.5648223674040651,"top":0.7661212407958078,"bottom":0.7834959160900807,"conf":1}]}