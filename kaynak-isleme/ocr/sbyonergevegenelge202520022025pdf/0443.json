{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397633646,"x1":0.9609856316731131,"top":0.040598290285678074,"bottom":0.05523255797856996,"conf":1},{"text":"Nor: Standartiar belnit araliklarla güncellenecek olug yayun tarthrıden mubaren ven pianlanan yada planianmiş","x0":0.15400410280435434,"x1":0.8583162255229533,"top":0.24700854708236442,"bottom":0.2602564103302277,"conf":1},{"text":"olan uvEniamma projesi veni çizarTiscer saglik vapularina kapsamaktadir.","x0":0.15400409958778008,"x1":0.6119096579052113,"top":0.260174418412105,"bottom":0.2732558141400614,"conf":0.5},{"text":"* Tüm cizimler ve resimler fikir vermek amach olup, malzeme özellikleri, minimum ölçüler değiştirilmemek","x0":0.1540041028087781,"x1":0.858316225527377,"top":0.3139534882471793,"bottom":0.3256410257909733,"conf":1},{"text":"koşuluyla ve bakanhk teknik elemanları tarafindan onavlanmak suretivle tasarım serbesttir.","x0":0.15400410407962586,"x1":0.7659137605350936,"top":0.32692307655526376,"bottom":0.34156976728256283,"conf":1},{"text":"**Hastane birimleri ana başhıkdar alunda toplanarak daha önce vavılanan ilgili maddeler geliştirilerek","x0":0.1540041028087781,"x1":0.858316225527377,"top":0.3675213675192426,"bottom":0.3824786324765075,"conf":1},{"text":"tekrar düzenlenmiş ve numaralandırılmıştır.","x0":0.15385811054279255,"x1":0.45394926474047614,"top":0.3818275540614424,"bottom":0.39689553979173586,"conf":1},{"text":"Ilk Yayınlanma Tarihi: 18.01.2011","x0":0.34496919084803046,"x1":0.6570841970238731,"top":0.4418604653360192,"bottom":0.4636752134968787,"conf":1},{"text":"Son Guncelleme Tarihi: 30.10.2012","x0":0.34486712382893486,"x1":0.6633499344986182,"top":0.4603596338023812,"bottom":0.4745336762025131,"conf":1},{"text":"Yukanda belirtilen maddeler genelge yayım tarihi itibari ile projesine başlanacak olan","x0":0.21149896630505294,"x1":0.8603696166460822,"top":0.5623931627500223,"bottom":0.5813953484737427,"conf":1},{"text":"ve teknik olarak mümkun olduğu kadarı ile devam eden inşaatlarda uygulanması hususunda","x0":0.15400410290403274,"x1":0.8583162256226315,"top":0.5799145299663568,"bottom":0.5974358974877243,"conf":1},{"text":"geregini rica ederim.","x0":0.1535031959709589,"x1":0.31047373554830926,"top":0.5934844354077065,"bottom":0.6121652002825478,"conf":1},{"text":"Is bu genelge 24 savfadan ve toplam 104 maddeden ibarettir.","x0":0.15195072771276819,"x1":0.5564681632501964,"top":0.6409883722409054,"bottom":0.6555555558740414,"conf":1},{"text":"Prof Dr Nihat TOSUN","x0":0.6386036982360539,"x1":0.8110882933168713,"top":0.7703488375509406,"bottom":0.7893162394304062,"conf":1},{"text":"Bakan a.","x0":0.6877482369545184,"x1":0.7598903663198237,"top":0.7860523467467867,"bottom":0.8040639322106122,"conf":1},{"text":"Müsteşar","x0":0.6873447458042172,"x1":0.7643386442443741,"top":0.8003918256583396,"bottom":0.8198034343624745,"conf":1},{"text":"429","x0":0.893223820533853,"x1":0.93223819169314,"top":0.9404069763492604,"bottom":0.9563953490867863,"conf":1}]}