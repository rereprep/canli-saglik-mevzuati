92234,"top":0.432985258235395,"bottom":0.44492171822502424,"conf":1},{"text":"2009/51","x0":0.48254620113883506,"x1":0.542094455740015,"top":0.45203488391469904,"bottom":0.46511627882754913,"conf":1},{"text":"Ilgi: 2006/78 tarih ve 857 sayıl genelgemiz.","x0":0.18051176468766117,"x1":0.4724323447386266,"top":0.48868052480158175,"bottom":0.5049326968967256,"conf":1},{"text":"İlgi genelge ile verem kontrol programında belirlenen alke hedeflerine ulaşmak üzere","x0":0.2258726857667932,"x1":0.7987679618375875,"top":0.5085470085964882,"bottom":0.5232558136807167,"conf":1},{"text":"Doğrudan Gözetimli Tedavi Stratejisinin ülke genelinde uygulanmasına geçilmiş ve bu","x0":0.18275153866124447,"x1":0.7987679681149362,"top":0.521794871646914,"bottom":0.5350427348947772,"conf":1},{"text":"konuda başta Il Sağhk Mudurlukleri olmak uzere tum sağlık kuruluşlannın her duzeyde","x0":0.17858074259088896,"x1":0.7988251666197583,"top":0.5345735402869075,"bottom":0.5509524540684893,"conf":1},{"text":"üzerine düşen görevleri eksiksiz yerine getirmesi istenmiştir.","x0":0.18058826376301085,"x1":0.5791979463742941,"top":0.5475110646998952,"bottom":0.5639938613281462,"conf":1},{"text":"Geçen bu süre içerisinde illerde yapılan faaliyetler Bakanlığımız tarafindan titizlikle","x0":0.22792607769763013,"x1":0.7987679672693124,"top":0.5683139532964167,"bottom":0.5813953490243731,"conf":1},{"text":"takip edilmekte olup, karşılaşılan sorunlar ve hizmetin ifası sırasında yaşamılan aksaklıklanın","x0":0.1806981514670066,"x1":0.7987679674198104,"top":0.5811965813174838,"bottom":0.5944767443732949,"conf":1},{"text":"giderilmesi amacıyla illerde Doğrudan Gözetimli Tedavi (DGT) çalışmalarının Il Sağlık","x0":0.18069815079587526,"x1":0.7967145802495671,"top":0.5930232559592816,"bottom":0.6076923074964286,"conf":1},{"text":"Müdürlükleri tarafından, Verem Savaşı Il Koordinatörleri ile birlikte hassasiyetle gözden","x0":0.18061965072777536,"x1":0.7988420914727496,"top":0.6050945752487007,"bottom":0.62227459583372,"conf":1},{"text":"geçirilmesi gerekmektedir.","x0":0.18036203777498988,"x1":0.35954105292883093,"top":0.6200226616125514,"bottom":0.6363314297952896,"conf":1},{"text":"İl Sağlık Müdürlüğü Bulaşıcı Hastalıklar Şubesi ve Verem Savaşı İl Koordinatörü;","x0":0.22587268958605028,"x1":0.7967145791577326,"top":0.6380341878034865,"bottom":0.6526162789148898,"conf":1},{"text":"birlikte DGT'nin uygulanmasında aktif rol alarak düzenli denetimlerde bulunacaktır. Aynca","x0":0.18069815061262198,"x1":0.7967145800663138,"top":0.6525641027027747,"bottom":0.6658119659506379,"conf":1},{"text":"Verem Savaşı Dairesi Başkanlığı tarafindan oluşturulacak \"Verem Savaşı Izleme ve","x0":0.18069815145730733,"x1":0.7987679674101111,"top":0.6656976742266044,"bottom":0.6787790699545608,"conf":1},{"text":"Değerlendirme Ekipleri\" tarafindan illere ziyaret yapılacak ve il düzeyinde yapılan DGT","x0":0.18061988270200288,"x1":0.7967905237143215,"top":0.6767764101013601,"bottom":0.6942181172885888,"conf":1},{"text":"uygulamaları ile bunlarla ilgili kayıtlar kontrol edilecektir.","x0":0.17864476579401065,"x1":0.5646817228394309,"top":0.6918604652611348,"bottom":0.706410256157037,"conf":1},{"text":"Uygulamaya esas olmak tizere;","x0":0.22792607522479863,"x1":0.4353182776920655,"top":0.7106837603332362,"bottom":0.7252906975134537,"conf":1},{"text":"1. Verem hastasına DGT uygulanması işleyışınden, hastanı ikamet ettıği ilin II Sağlık","x0":0.18069815067678424,"x1":0.796714580130476,"top":0.7311046510375512,"bottom":0.742735042704583,"conf":1},{"text":"Müdürlüğü sorumludur.","x0":0.18221971688051466,"x1":0.3413032758544982,"top":0.7410024936942635,"bottom":0.7566652657180433,"conf":1},{"text":"2. DGT'de en iyi gözetiminin bir sağlık personeli olması gerektiği ilkesinden hareketle","x0":0.18069815146849194,"x1":0.7987679674212957,"top":0.7615384614412348,"bottom":0.7761627905435798,"conf":1},{"text":"verem hastasının tedavisinde ildeki tüm sağlık kurum ve kuruluşlarında çalışan her sağlık","x0":0.1827515379751147,"x1":0.7967145809296945,"top":0.7747093021336083,"bottom":0.7877906978615647,"conf":1},{"text":"personeli gozetimei olmak uzere gorevlendirilebilecektir.","x0":0.1805545772688606,"x1":0.5565668973664459,"top":0.7871553103373371,"bottom":0.8037658618290989,"conf":1},{"text":"3. DGT'nin uygulanma kayıtlarının tutulması ve raporlanması işlerini I| Sağhık Müdürlüğü","x0":0.18069815146884113,"x1":0.7987679674216449,"top":0.8081196579184404,"bottom":0.8213675211663036,"conf":1},{"text":"Bulaşıcı Hastahklar Şubesı yürütür.","x0":0.18069815028589858,"x1":0.41478439569239417,"top":0.8212209300367694,"bottom":0.8343023257647258,"conf":1},{"text":"4. DGT nin planlanmasi;","x0":0.17864476791099004,"x1":0.3613962954873674,"top":0.8371794868469408,"bottom":0.853197673725895,"conf":1},{"text":"a. Aile hekimliğine geçilmeyen illerde; verem hastasının dispansere kaydı sırasında","x0":0.2299794649962112,"x1":0.7987679680687816,"top":0.8589743590192713,"bottom":0.8722222222671345,"conf":1},{"text":"DGT uygulaması hakkında bilgi verildikten sonra dispanser doktorunca veya birden fazla","x0":0.20533881666074372,"x1":0.796714571223546,"top":0.8720930230639595,"bottom":0.8851744187919158,"conf":1},{"text":"doktor olan dispanserlerde sorumlu doktor tarafinca görevlendirilen dispanser","x0":0.20533880327562512,"x1":0.7145790609724019,"top":0.8850427351440597,"bottom":0.898290598391923,"conf":1},{"text":"697","x0":0.8952772069906525,"x1":0.9301848051517156,"top":0.9433139536627608,"bottom":0.956395348575611,"conf":1}]}