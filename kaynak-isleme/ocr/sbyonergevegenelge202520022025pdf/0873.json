{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397231834,"x1":0.960985631669095,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"7.3.4. MHRS Genelgesi (2021/12)","x0":0.11693408007332264,"x1":0.48678125896493013,"top":0.10894338115545821,"bottom":0.13029217464170284,"conf":1},{"text":"ISTATISTIK ANALA VE RAPO","x0":0.6160164295939405,"x1":0.7412730982936363,"top":0.1773255814484619,"bottom":0.1846153847822335,"conf":1},{"text":"AMA VE STRATE","x0":0.7515400419458677,"x1":0.825462011266218,"top":0.17732558144521748,"bottom":0.1846153847789891,"conf":1},{"text":"FONETİM DAIRESI BAŞKANLIĞ","x0":0.6201232050144985,"x1":0.7556468154351407,"top":0.1845930232541113,"bottom":0.1933139534677134,"conf":1},{"text":"16/12/2021 14 42 .E-32693113 . 010 06 01:.11","x0":0.6201232079010698,"x1":0.792607802981887,"top":0.19186046511309995,"bottom":0.19786324786954668,"conf":1},{"text":"T.C","x0":0.45174538016933885,"x1":0.48254620071948484,"top":0.2383720928585138,"bottom":0.25000000008168555,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.38603695996614296,"x1":0.5503080090505122,"top":0.25000000014011203,"bottom":0.2645348835577469,"conf":1},{"text":"Kamu Hastaneleri Genel Müdürlüğü","x0":0.3449692022963361,"x1":0.5913757666975037,"top":0.2658119657875593,"bottom":0.27906976762596947,"conf":1},{"text":"Sayı : E-32693113-719","x0":0.14784393861498446,"x1":0.32854209814302254,"top":0.2935897434874457,"bottom":0.3068376067353089,"conf":1},{"text":"Konu : MHRS","x0":0.14784394477130383,"x1":0.26078028525094127,"top":0.30668604670236854,"bottom":0.31976744161521875,"conf":1},{"text":"GENELGE","x0":0.42694872094183534,"x1":0.5093962480511867,"top":0.3337957580322075,"bottom":0.3478902884475388,"conf":1},{"text":"2021/12","x0":0.44555705122079986,"x1":0.507215022530291,"top":0.34731733968262324,"bottom":0.3605314974718046,"conf":1},{"text":"Bakanlığımıza bağlı sağlık tesislerinde, Merkezi Hekim Randevu Sistemi (MHRS)","x0":0.19296601176193415,"x1":0.7865089571901575,"top":0.38801272389472696,"bottom":0.40441854188841275,"conf":1},{"text":"kapsamında verilecek muayene randevusu hizmetlerine ilişkin usûl ve esaslar Yönerge","x0":0.14989736234746318,"x1":0.7864476198907295,"top":0.4025641025427549,"bottom":0.4158119657906181,"conf":1},{"text":"(Merkezi Hekim Randevu Sistemi Çalışma Usul ve Esasları Hakkında Yönerge) ile","x0":0.14784394997978342,"x1":0.7864476309237073,"top":0.41709401747078434,"bottom":0.4316860463576283,"conf":1},{"text":"oluşturulmuştur.","x0":0.14784394075958507,"x1":0.2628336769637209,"top":0.43168604670918176,"bottom":0.44476744162203197,"conf":1},{"text":"Il saglık müdürü, MHRS hizmetlerinin planlanması, yürütülmesi, denetlenmesi,","x0":0.19092043600204095,"x1":0.7844622374823538,"top":0.4429553615904165,"bottom":0.45911342803839994,"conf":1},{"text":"raporlanması ve geliştirilmesinden sorumludur. MHRS'ye ilişkin süreçler, il sağlık müdürünün","x0":0.14784394998087563,"x1":0.7864476309247994,"top":0.4576923076139068,"bottom":0.47238372077600776,"conf":1},{"text":"sorumluluğunda kamu hastaneleri başkanı ile birlikte yürütülmektedir.","x0":0.14774639404900033,"x1":0.6243518105464119,"top":0.46936522654662505,"bottom":0.48747746866656905,"conf":1},{"text":"Sağlık tesislerinde MHRS uygulamalarımın planlanması, yürütulmesi, denetlenmesi.","x0":0.18891169587475323,"x1":0.786447646836437,"top":0.48546511642817647,"bottom":0.49999999984581134,"conf":1},{"text":"raporlanması ve geliştirilmesinden, hekim çalışma cetvellerinin sisteme girilmesinin","x0":0.1478439500645167,"x1":0.7864476310084405,"top":0.4985465117751766,"bottom":0.5132478635278246,"conf":1},{"text":"sağlanması, takip edilmesi, çalışma cetvellerinin izin ve görevlendirmeler dikkate alınarak","x0":0.1477759271068151,"x1":0.786518431664894,"top":0.511473991379944,"bottom":0.5282382588693855,"conf":1},{"text":"düzenlenmesinden, randevulu hastaların randevu saatinde muayene olabilmeleri için gerekli","x0":0.14989731953716195,"x1":0.7864476508835192,"top":0.5260683759871226,"bottom":0.5377906977827247,"conf":1},{"text":"tüm tedbirlerin alınması, hastalanın sağlık tesisinden ayrılmadan önce uygun görülen ilk","x0":0.1477894577659906,"x1":0.7865082715318612,"top":0.5392201371591309,"bottom":0.5551122059079311,"conf":1},{"text":"muayene ve kontrol randevularının verilmesine ilişkin süreçlerin planlanmasından başhekimler","x0":0.1478439499938371,"x1":0.7864476309377609,"top":0.5537790699163262,"bottom":0.5683760685059968,"conf":1},{"text":"sorumludur.","x0":0.14989733170549724,"x1":0.2361396292459059,"top":0.5683139533891108,"bottom":0.5784883721074977,"conf":1},{"text":"Hekim çalışma cetvellerinin planlanması, uygulanması ve polikliniklerde randevulu","x0":0.19295930605172346,"x1":0.7865208498588765,"top":0.5796738515168683,"bottom":0.5971691788387604,"conf":1},{"text":"muayene süreçlerinin takibi, hizmete erişim ve hasta memnuniyeti açısından önceliğimizi","x0":0.14777186645222748,"x1":0.7865323789645083,"top":0.5944432848011639,"bottom":0.610987496425179,"conf":1},{"text":"oluşturmaktadır. Bu minvalde;","x0":0.14784394186164107,"x1":0.36139630382624394,"top":0.6089743587737171,"bottom":0.6235465112945734,"conf":1},{"text":"1) Sağhk tesislerinde aktif görev yapmakta olan hekimlerin aylık çalışma programları","x0":0.19507187744865567,"x1":0.7885010185105701,"top":0.622093022905012,"bottom":0.6380813956425379,"conf":1},{"text":"nitelikli bir şekilde planlanmalıdır.","x0":0.14761900477239798,"x1":0.38626641035757975,"top":0.6352663042648367,"bottom":0.6523200469588762,"conf":1},{"text":"2) Sağlık hizmetlerine erişimi kolaylaştıracak şekilde az zamanda çok hasta bakılarak","x0":0.1950718762100766,"x1":0.7864476307728789,"top":0.6495726499113159,"bottom":0.6642441858923229,"conf":1},{"text":"değil yaygın poliklinik hizmeti planlanarak randevulu muayene kapasite artırımı sağlanmalıdır.","x0":0.14784394997809483,"x1":0.7864476309220185,"top":0.6641025639295699,"bottom":0.6787790696134036,"conf":1},{"text":"3) Muayene süresi hekime ve ilgili branşın özelligine göre değişebildiğinden randevu","x0":0.19712526434449637,"x1":0.7885010189072986,"top":0.677325581542119,"bottom":0.6918803421408478,"conf":1},{"text":"aralıkları en etkili şekilde hekimlerimiz tarafından oluşturulmalı ve başhekimliklerimizce","x0":0.14778130251549373,"x1":0.788562100840577,"top":0.6901795683107023,"bottom":0.7063453766378799,"conf":1},{"text":"onaylanmalıdır. Kamuoyunda gündem olduğu gibi 5 dakikada bir muayene yapıldığı şeklindeki","x0":0.14784393242864075,"x1":0.7885010367732219,"top":0.704941860612014,"bottom":0.7196581198429293,"conf":1},{"text":"söylentilere sebep olacak uygulamalardan sakınılmalıdır.","x0":0.14784394516703853,"x1":0.5359342887115707,"top":0.7194767443336342,"bottom":0.7341880338617228,"conf":1},{"text":"4) MHRS'ye esas poliklinikler için tüm hekimlerin 30 günlük tanılı çalışma cetveli","x0":0.19705024830452664,"x1":0.7886274115026448,"top":0.7310551023299652,"bottom":0.7491822046520138,"conf":1},{"text":"olmalı, periyodik olarak güncellenmeli ve sistemdeki görünürluğünün 15 günün altına","x0":0.147843932321497,"x1":0.7885010366660783,"top":0.7485465117770912,"bottom":0.7632478635297392,"conf":1},{"text":"düşmemesi sağlanmalıdır.","x0":0.14784394019477456,"x1":0.33264887272103666,"top":0.7645299141606671,"bottom":0.7790697672811285,"conf":1},{"text":"5) Ihtiyaç duyulması halinde mesai dışı poliklinik hizmeti sunulmahdır.","x0":0.19712526506509,"x1":0.6858316208692012,"top":0.7790598288212752,"bottom":0.7936046508294571,"conf":1},{"text":"6) Bakanlığımız SINA ekranlarından MHRS verileri Il Sağlık Müdürlükleri ve","x0":0.19703584411970435,"x1":0.7906438838741822,"top":0.7932559667095979,"bottom":0.8114035004849927,"conf":1},{"text":"Başhekimliklerce takip edilerck gerekli tedbirler alınmalıdır.","x0":0.14982099011454414,"x1":0.5626887287760277,"top":0.8109543911848297,"bottom":0.8264426179857319,"conf":1},{"text":"MHRS ile ilgili süreçlerin yukarıdaki açıklamalar dikkate alımurak hassasiyetle","x0":0.1971252666748555,"x1":0.7905544077367698,"top":0.8269230773221166,"bottom":0.8415697672343094,"conf":1},{"text":"yürütülmesi hususunda;","x0":0.14784394465685524,"x1":0.3162217667394486,"top":0.8430232557839151,"bottom":0.857692307321062,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.19712525215057874,"x1":0.4476386080007431,"top":0.8589743592894084,"bottom":0.8750000003150493,"conf":1},{"text":"Dr. Fahretun KOCA","x0":0.5708418896359827,"x1":0.7145790552784593,"top":0.8895348838241283,"bottom":0.9042735046799977,"conf":1},{"text":"Bakan","x0":0.609856261905371,"x1":0.6673511300074388,"top":0.90697674401811,"bottom":0.9186046512412817,"conf":1},{"text":"Dagıtım","x0":0.15605749466202218,"x1":0.20944558515317288,"top":0.9229651161967658,"bottom":0.9331395349151527,"conf":1},{"text":"81 Il Valiliğine (11 Sağlık Müdürlüğü)","x0":0.15381752426775636,"x1":0.40675291305653544,"top":0.9313917396462662,"bottom":0.9452974050520613,"conf":1},{"text":"859","x0":0.8952772070282982,"x1":0.9301848051893613,"top":0.9433139536409586,"bottom":0.9563953485538088,"conf":1}]}