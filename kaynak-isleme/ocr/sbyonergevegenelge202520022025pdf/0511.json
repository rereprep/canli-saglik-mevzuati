01,"conf":1},{"text":"sağlık hizmeti alımınm kolaylaştırılmasına yönelik tilm önlemlerin alınması için bilgilerinizi ve","x0":0.2052871077891891,"x1":0.8029219179912561,"top":0.5493569180268352,"bottom":0.5634034631370323,"conf":1},{"text":"geregini arz/rica ederim.","x0":0.20328542119696033,"x1":0.34702258683943693,"top":0.5623931623263196,"bottom":0.5726744186515441,"conf":1},{"text":"OiR.Grantil","x0":0.5195071867257826,"x1":0.683778235810152,"top":0.6409883723654929,"bottom":0.6671511621911932,"conf":0.30000001192092896},{"text":"Uz. Dr. Orhan Ferzi GÜMRÜKÇÜOĞLU","x0":0.4866529792645876,"x1":0.753593427107648,"top":0.6627906980268378,"bottom":0.6816860461437206,"conf":1},{"text":"Bakan a.","x0":0.6016427096603052,"x1":0.6652977418724023,"top":0.6773255810445469,"bottom":0.6933139537820727,"conf":1},{"text":"Müstejar V.","x0":0.5951105441177247,"x1":0.6800135830928418,"top":0.6876301221507761,"bottom":0.7056094970607885,"conf":1},{"text":"EKLER:","x0":0.20123203343619422,"x1":0.2566735104264569,"top":0.7122093025072378,"bottom":0.7252906974200879,"conf":1},{"text":"Ek-1","x0":0.19917864434129298,"x1":0.23408624250235613,"top":0.7252906975096766,"bottom":0.7369186047328482,"conf":1},{"text":"Liste (1 sayfa)","x0":0.23404070634608187,"x1":0.34296134684177887,"top":0.7251188864519427,"bottom":0.739997392582585,"conf":1},{"text":"Ek-2","x0":0.19917864591786302,"x1":0.23819301707715015,"top":0.7369186044864209,"bottom":0.7485465117095925,"conf":1},{"text":": Form Örnegi (1 sayfa)","x0":0.237883763524748,"x1":0.39260386235003897,"top":0.734342089924935,"bottom":0.7512701008491847,"conf":1},{"text":"Dağitım:","x0":0.20123203336555415,"x1":0.25667351035581687,"top":0.7601744187723317,"bottom":0.7732558136851818,"conf":1},{"text":"Gerogi:","x0":0.19899154832358248,"x1":0.25070044321233464,"top":0.7714271678155051,"bottom":0.7852588786309348,"conf":0.5},{"text":"A Plan","x0":0.1991786437496172,"x1":0.2505133477416559,"top":0.78333333331141,"bottom":0.7965811965592732,"conf