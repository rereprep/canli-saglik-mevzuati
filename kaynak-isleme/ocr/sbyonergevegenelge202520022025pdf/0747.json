591094831,"bottom":0.33204731239755647,"conf":1},{"text":"GENFLGE","x0":0.46810293439853107,"x1":0.5524309458155741,"top":0.3442500376178189,"bottom":0.35778484598047,"conf":0.5},{"text":"20141 3","x0":0.4804928123333765,"x1":0.5441478445454736,"top":0.3589743589319596,"bottom":0.37354651145281603,"conf":0.5},{"text":"Gehelik stresince, dogum surasında ve sonrasında sağhk hizmetlerinin erişilebilirliği.","x0":0.22997946324820134,"x1":0.8418891197036691,"top":0.3866279071258596,"bottom":0.40128205118473925,"conf":1},{"text":"sağkk hizmetlerinden etkin faydalanma, bu hizmetlerin kalitesınin artırılması ve hizmet sunan","x0":0.17864478087040753,"x1":0.8418890998036752,"top":0.4011627905057189,"bottom":0.4142441862336754,"conf":1},{"text":"sağlık kurumlun arasıda etkili sevk sisteminin bulunması anne ve yenidogan ölümlerini","x0":0.17864478088314775,"x1":0.8418890998164156,"top":0.4141025639294631,"bottom":0.4287790696132967,"conf":1},{"text":"onlemede nemlidir. Anne alümlerinin anlenmesine yönelik ulusal planlarımızda; dogum öncesi.","x0":0.17864478092495714,"x1":0.841889099858225,"top":0.42863247882863487,"bottom":0.44188034207649807,"conf":1},{"text":"doğum sırası ve doğum sonrası bakım hizmetlerinin niteliğinin artırılması hedellenmiştir.","x0":0.17857776383163515,"x1":0.7885461037816616,"top":0.4407815862886497,"bottom":0.45682688930733384,"conf":1},{"text":"Dogum öncesi bakım, dogum emras halam hizmetlerinde niteligin arunimasi.","x0":0.2299794640404362,"x1":0.843942506995016,"top":0.4563953486453053,"bottom":0.46965811977898897,"conf":1},{"text":"standirtlar sağlanması amacı ile 2005/13 sayıbı genelge ile uygulamaya konulim Doğum Oncesi","x0":0.17864476329953669,"x1":0.843942505633462,"top":0.469476744333849,"bottom":0.48418803386193776,"conf":1},{"text":"Bakın Fonetim Reheuri ve 2008/80 saydi genelge ile uygulanaya konulan Doğam Sona Bukım","x0":0.17864478092783279,"x1":0.8418890998611007,"top":0.48247863258471824,"bottom":0.49709302309651626,"conf":1},{"text":"Foneziw Sehherı ulusal ve uluslar arası guncel literatür bilgileri ışıgında Billim Komisyoniun","x0":0.17864478100042178,"x1":0.8418890999336895,"top":0.497008546604097,"bottom":0.5116279068187216,"conf":1},{"text":"tatafindan gözden geçinılerek ikinci revizyonları gerçeklestirilmiştir.","x0":0.17864475985056807,"x1":0.6447638641644473,"top":0.5115384614398966,"bottom":0.5261627905422416,"conf":1},{"text":"Aninte ve bebek saglığım korumak ve amne ölümlerini en aza indirmel için Dogum Oncesi","x0":0.22988814790103673,"x1":0.8419857439277145,"top":0.523045836264623,"bottom":0.541529302225525,"conf":1},{"text":"Bakim Yonetim Rehberine göre izlenen her gebenin dogumumın hasthnede gerçeklestirilmesi","x0":0.1786025622232531,"x1":0.8398978891296165,"top":0.5376518165582386,"bottom":0.5536946709977376,"conf":1},{"text":"coğun sonrası komplikasyon gelişmeyen vakalar için normal doğumdan sonra en az 24 saat.","x0":0.17856518767040055,"x1":0.8419493634610974,"top":0.5515636786670232,"bottom":0.5677071041764841,"conf":1},{"text":"sezaryen ile doğumdan sonta ise en az 48 seat lohusa ve yeni doğanın hastanede izlenmesi","x0":0.17856492962631693,"x1":0.8419715415566753,"top":0.5642036806553844,"bottom":0.5815440114476729,"conf":1},{"text":"sağlanmalıdır, Lobusanın izlemi doğum sonu ilk: 24-48 saatte hastanede, taburcu olduktın sonra","x0":0.17864478088244204,"x1":0.8418890998157098,"top":0.5799145297603762,"bottom":0.5931623930082395,"conf":1},{"text":"doğum sonu 42 güne kadar sağlık kuruluşunda veya evde gerçekleştirilmelidir.","x0":0.17858205262083549,"x1":0.7228532057675631,"top":0.5928084782636053,"bottom":0.6088725205750536,"conf":1},{"text":"Revize edilmiş olan yönetim rehberlerinin ilinızdeki doğum öncesi bakım, doğum sonu","x0":0.22997946404363415,"x1":0.8439425069982139,"top":0.6075581392091415,"bottom":0.6235465119466673,"conf":1},{"text":"bakıu hizmeli veren tüm sağlık kuruluşlarna ve personeline tebliğ edilerek uygulamaya","x0":0.17864476321980852,"x1":0.8439425055537338,"top":0.6220930234050551,"bottom":0.6367521363516552,"conf":1},{"text":"konulması konusunda ilgililere emirlerinizi önemle rica ederim.","x0":0.17659137986873716,"x1":0.6160164227926149,"top":0.6350427350770845,"bottom":0.6497093021703713,"conf":1},{"text":"PrOT. OL. VaS, POSUN","x0":0.6323992161953976,"x1":0.8015420811192092,"top":0.6519493828552672,"bottom":0.6871238032038666,"conf":0.5},{"text":"Sakan i","x0":0.6837471370317457,"x1":0.7310372563551072,"top":0.6830671602195391,"bottom":0.6933863279517126,"conf":0.5},{"text":"Müsteşar","x0":0.672791869263425,"x1":0.7419925256976376,"top":0.6967356320855718,"bottom":0.7116946006149062,"conf":1},{"text":"EKLER","x0":0.17859669799360994,"x1":0.2402944722326115,"top":0.7251625294076323,"bottom":0.7370467728755664,"conf":1},{"text":"1- Doğunı Öncesi Bakun Yönetim Rehberi (44 Sayfa)","x0":0.20123203032246714,"x1":0.5811088278705513,"top":0.7367521371375547,"bottom":0.7514534880750965,"conf":1},{"text":"2- Doğum Sonu Bakım Yonetim Rehberi (56 Sayfa)","x0":0.20328541573923467,"x1":0.5708418942926469,"top":0.7512820516316958,"bottom":0.7675213678710121,"conf":1},{"text":"DAGITIM:","x0":0.1785244787734162,"x1":0.2629539602151862,"top":0.7786726661376094,"bottom":0.7925482639039313,"conf":1},{"text":"Geregi:","x0":0.17864476445894742,"x1":0.23408624144921014,"top":0.7950581393852428,"bottom":0.8066860466084145,"conf":1},{"text":"81 I| Valitigi (I| Saghk Müdürluge)","x0":0.1786447661806569,"x1":0.42299794408271246,"top":0.8066860466569561,"bottom":0.8213675212285102,"conf":1},{"text":"(l Halk Saghgr Modüriaga)","x0":0.27104723119866364,"x1":0.4702258692187098,"top":0.8212209303763063,"bottom":0.83589743606014,"conf":0.5},{"text":"(II Kamu Hastane Birligi)","x0":0.27104723172009426,"x1":0.4517453727973596,"top":0.8341880337978326,"bottom":0.8488372089689918,"conf":1},{"text":"Bilgi:","x0":0.5626283372108367,"x1":0.6057494859810411,"top":0.7936046513444469,"bottom":0.8066860462572971,"conf":1},{"text":"Sağlık Hizmetlen Genel