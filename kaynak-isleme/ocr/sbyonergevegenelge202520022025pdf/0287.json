{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397633646,"x1":0.9609856316731131,"top":0.040598290285678074,"bottom":0.05523255797856996,"conf":1},{"text":"T.C.","x0":0.49281314283778094,"x1":0.5318275139970681,"top":0.24127906993871617,"bottom":0.25436046485156627,"conf":1},{"text":"SAGLIK BAKANLIĞI","x0":0.4309553268578628,"x1":0.5998210611750012,"top":0.25147453207018977,"bottom":0.2676462482874916,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.38809034785150553,"x1":0.6468172496981179,"top":0.2674418606046516,"bottom":0.2820512822287292,"conf":1},{"text":"aktarımı kimin denetleyeceği (veri erişim komitesi, vb.), kişisel verileri toplama yöntemi ve","x0":0.19917862827420646,"x1":0.8234086406258918,"top":0.3051282051242554,"bottom":0.3197674417048677,"conf":1},{"text":"hukuki sebebi, aktarım şekli (kamuya açık, kontrollü) ve ilgili kişilerin 6698 sayıhı Kişisel","x0":0.19909325950250642,"x1":0.8235069677476696,"top":0.32005995100034124,"bottom":0.33701134406257416,"conf":1},{"text":"Verilerin Korunması Kanunu'nun 11 inci maddesinde sayılan diğer hakları gibi detayların","x0":0.19917862833067246,"x1":0.8234086406823579,"top":0.3357558140983441,"bottom":0.3504273500793511,"conf":1},{"text":"metinde yer alması zorunludur.","x0":0.20123203089002772,"x1":0.41067761985640655,"top":0.3529914531532179,"bottom":0.3662790699481627,"conf":1},{"text":"7) Kişisel genetik verilerin yurtiçinde paylaşımında 6698 sayılı Kişisel Verilerin","x0":0.24633573159189948,"x1":0.8234813276728963,"top":0.3661883483020134,"bottom":0.38260797582584316,"conf":1},{"text":"Korunması Kanunu'nun 8 inci maddesine, yurtdışına paylaşımında ise aynı Kanunun 9 uncu","x0":0.19917864748579972,"x1":0.8254620094350515,"top":0.38226744153458014,"bottom":0.3982905981163609,"conf":1},{"text":"maddesine riayet edilmesi zorunludur.","x0":0.19917864363814877,"x1":0.45790554548476115,"top":0.39825581408437194,"bottom":0.41282051245854134,"conf":1},{"text":"8) Toplumun genetik yapısını ilgilendiren verinin uluslararası paylaşıma açılmasında","x0":0.2464065736970863,"x1":0.8254620092652166,"top":0.41410256392921796,"bottom":0.4287790696130518,"conf":1},{"text":"Kişisel Verileri Koruma Kurulunun izni alınmalıdır.","x0":0.19917865538098686,"x1":0.5503080050399576,"top":0.4286324785834843,"bottom":0.4433139531550383,"conf":1},{"text":"9) Tanı amacı ile işlenen genetik verilerin ve arşiv materyallerinin ikincil amaçlar için","x0":0.24633375619636008,"x1":0.8234858469493641,"top":0.44320467948281295,"bottom":0.4599976664259846,"conf":1},{"text":"işlenmesi ve veri paylaşımı yapılabilmesi için bireylerin tekrar bilgilendirilmesi ve açık","x0":0.1991786477583283,"x1":0.8254620097075802,"top":0.45930232572372587,"bottom":0.47393162371379116,"conf":1},{"text":"rızalarının alınması kapsamında zorunludur.","x0":0.20123203661851846,"x1":0.4969199138999196,"top":0.476744185918493,"bottom":0.4884615384188217,"conf":1},{"text":"10) Sağhk kuruluşlarının, kişisel sağlık verilerinin yurt içinde aktanmında Kişisel","x0":0.2484599611415212,"x1":0.8254620102105397,"top":0.48974359000148093,"bottom":0.5043604649571392,"conf":1},{"text":"Verilerin Korunması Kanunu'nun 8 inci maddesine riayet ederek kuruluş bünyesinde muhafaza","x0":0.20123201631701768,"x1":0.8254620286687029,"top":0.5058139536372354,"bottom":0.5205128201309169,"conf":1},{"text":"edilen sağlık kayıtlarını Bakanlığımıza anlık olarak aktarması zorunluur. Sağlık hizmet","x0":0.19917864746082242,"x1":0.8254620094100742,"top":0.5217948715837973,"bottom":0.536337209148119,"conf":1},{"text":"sunumunu hizmet ahımı yoluyla gerçekleştiren sağlık kuruluşları ilgili yuklenici firma veya","x0":0.19917864746784447,"x1":0.8254620094170964,"top":0.5376068375658463,"bottom":0.5523255812406217,"conf":1},{"text":"cihaz üreticileri tarafindan elde edilen tüm veriler için de bu kural doğrultusunda işlem tesis","x0":0.19917864746514363,"x1":0.8254620094143954,"top":0.5521367523996967,"bottom":0.5668604649621926,"conf":1},{"text":"etmesi zorunludur.","x0":0.19889752803243563,"x1":0.33095213486565717,"top":0.5669493827686671,"bottom":0.582993546268809,"conf":1},{"text":"Bilgilerini ve gereğini önemle rica ederim.","x0":0.2483534261408854,"x1":0.5339741558940406,"top":0.5825736275813868,"bottom":0.5980223828619711,"conf":1},{"text":"Prof. Dr. Sab","x0":0.5893223799126516,"x1":0.6796714596766706,"top":0.6293604649764539,"bottom":0.6410256408952939,"conf":1},{"text":"attin AYDIN","x0":0.6919917882758195,"x1":0.7802874723153402,"top":0.6293604649777654,"bottom":0.6410256408966054,"conf":1},{"text":"Bakan a.","x0":0.6528664776923199,"x1":0.7146899893349051,"top":0.6450488693043666,"bottom":0.6572767114396737,"conf":1},{"text":"Bakan Yardımeası","x0":0.6221315568203523,"x1":0.7515850751908273,"top":0.6568087809334128,"bottom":0.6745865678403806,"conf":1},{"text":"Dağıtım","x0":0.2012320335224071,"x1":0.262833674622699,"top":0.7049418601047974,"bottom":0.7209302328423233,"conf":1},{"text":"Gereği","x0":0.20123203267639592,"x1":0.2546201231675466,"top":0.7209302322039115,"bottom":0.7369186049414373,"conf":1},{"text":"Yükseköğretim Kurulu Başkanlığına","x0":0.2012320283230845,"x1":0.4517453841732489,"top":0.73546511628972,"bottom":0.752991452698808,"conf":1},{"text":"81 İl Valiliğine (İl Sağlık Madarlagu)","x0":0.20102482524674914,"x1":0.460152809991355,"top":0.7497671730726171,"bottom":0.7701290750324195,"conf":1},{"text":"Bilgi","x0":0.5400410674065483,"x1":0.5811088296776407,"top":0.7180232559851633,"bottom":0.7369186041020461,"conf":1},{"text":"Sağlık Bilgi Sistemleri Genel Müdürlüğü","x0":0.5400410651795752,"x1":0.8193018504680804,"top":0.7340116282574994,"bottom":0.7529914531713721,"conf":1},{"text":"273","x0":0.8952772069769632,"x1":0.9301848051380264,"top":0.9418604652251773,"bottom":0.9563953486428122,"conf":1}]}