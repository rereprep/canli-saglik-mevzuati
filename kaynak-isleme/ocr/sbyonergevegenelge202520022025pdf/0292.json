{"lines":[{"text":"278","x0":0.06776180718051394,"x1":0.10061601653611849,"top":0.029069767496336607,"bottom":0.042151162409186704,"conf":1},{"text":"2.3.54. Kök Hücre Çalışmaları Genelgesi (2006/51)","x0":0.12925430682855024,"x1":0.7106357206123698,"top":0.11152368891518283,"bottom":0.13682512987957995,"conf":1},{"text":"T.C.","x0":0.4907597549526108,"x1":0.5359342902219272,"top":0.3343023254550024,"bottom":0.3517441858822068,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4250513370077073,"x1":0.6016427050867487,"top":0.34871794863104255,"bottom":0.3633720926899222,"conf":1},{"text":"Tedavi Hizmetleri Genel Müdürlüğü","x0":0.3757700248326031,"x1":0.6488706321729995,"top":0.36482558153802436,"bottom":0.3794871797435908,"conf":1},{"text":"Sayı : B.10.O.THG.0.14.00.03-","x0":0.16825677861707614,"x1":0.3964058236641212,"top":0.4068631747603214,"bottom":0.42024309174207564,"conf":1},{"text":"Konu : Kök Hücre Çalışmaları","x0":0.1704312118981477,"x1":0.3860369603618625,"top":0.42136752147520085,"bottom":0.4333333334410129,"conf":1},{"text":"01.05.2006 / 8647","x0":0.7227926072670716,"x1":0.8521560581903778,"top":0.40683760691658,"bottom":0.4200854701644433,"conf":1},{"text":"...VALILIGINE","x0":0.5133470217779262,"x1":0.630390144481174,"top":0.44767441879291425,"bottom":0.46075581370576435,"conf":1},{"text":"(Il Sağlık Müdürlüğü)","x0":0.43708730871556256,"x1":0.5936886852317732,"top":0.46200207917787117,"bottom":0.4780585507824384,"conf":1},{"text":"GENELGE","x0":0.4722792626029297,"x1":0.5605749466424503,"top":0.4767441859087631,"bottom":0.48837209313193464,"conf":1},{"text":"2006 / 51","x0":0.4740887976621072,"x1":0.544391694034892,"top":0.4891441530185858,"bottom":0.5035884039568058,"conf":1},{"text":"Kök hücre nakli özellikle hematolojik, onkolojik hastalıklarda bir tedavi yöntemi olarak","x0":0.2176079905454238,"x1":0.8604268612282381,"top":0.5172872724129497,"bottom":0.5333425572228121,"conf":1},{"text":"uzun yıllardır kullanılmaktadır. Son yıllarda farklı hastalıklarda da tedavi amaçlı kök hücre","x0":0.16632444582900355,"x1":0.8603695991504968,"top":0.5333333333501017,"bottom":0.5465811965979649,"conf":1},{"text":"kullanımı gündeme gelmiştir. Dünyada ve ülkemizde kök hücre nakli ile tedavi konusunda halen","x0":0.16632444581905526,"x1":0.8603695991405487,"top":0.5465116280563604,"bottom":0.5611111110898911,"conf":1},{"text":"yoğun araştırmalar yapılmakta olup, konu ile ilgili haberler basın ve yayın organlarında sıklıkla yer","x0":0.16837781468219992,"x1":0.8603696184061268,"top":0.561046511502491,"bottom":0.5726744187256626,"conf":1},{"text":"almaktadır. Bazı hastalıkların tedavisinde ümit verici bir yöntem olarak değerlendirilmesine karşın,","x0":0.1683778146575094,"x1":0.8603696183814362,"top":0.5739316239010025,"bottom":0.5872093025129536,"conf":1},{"text":"henüz kök hücre nakli yapılan hasta sayısı çok azdır ve uygulamanın başarısı veya uzun vadede","x0":0.16632444582262326,"x1":0.8603695991441166,"top":0.5884615386678781,"bottom":0.6031976742647811,"conf":1},{"text":"tedavinin hastada meydana getirebileceği yan etkiler konusunda yeterli bilgi mevcut değildir.","x0":0.16632442673002454,"x1":0.8110883040728298,"top":0.6029914531598979,"bottom":0.6162790699548427,"conf":1},{"text":"Bakanlığımızca; kök hücre nakli çalışmalarıyla ilgili olarak, çalışmanın yapılacağı kurum","x0":0.21765912739016888,"x1":0.8583162317347501,"top":0.6162393163695191,"bottom":0.6308139533342356,"conf":1},{"text":"bünyesinde gerekli altyapının oluşturulması ve çağdaş bilimin gereklerine uygun olarak uygulama","x0":0.16632442697606054,"x1":0.8583162306999874,"top":0.6293604652251771,"bottom":0.6440170937279168,"conf":1},{"text":"yapılabilmesi amacıyla Kök Hücre Nakilleri Bilimsel Danışma Kurulu oluşturulmuş ve \"Klinik","x0":0.1662612351118903,"x1":0.8583787993028668,"top":0.6422875697582346,"bottom":0.6584600815192397,"conf":1},{"text":"Amaçlı Embriyonik Olmayan Kök Hücre Çalışmaları Kılavuzu\" hazırlanmıştır. Ekte gönderilmekte","x0":0.16830975108237034,"x1":0.8604346955824459,"top":0.6543594457809011,"bottom":0.6732332245561081,"conf":1},{"text":"olan Kılavuzun gereğinin ifası için, konu ile ilgili tüm kamu ve özel kurum-kuruluşlar ile","x0":0.16632444592905732,"x1":0.8603695992505507,"top":0.6700581392076977,"bottom":0.6860465119452236,"conf":1},{"text":"üniversiteler bünyesindeki ilgili personele tebliğini önemle rica ederim.","x0":0.166252661387022,"x1":0.6612690338647276,"top":0.6843111184307501,"bottom":0.7017599577976956,"conf":1},{"text":"Prof.Dr. Recep AKDAĞ","x0":0.6299634115496932,"x1":0.8054171603334181,"top":0.7235750764798455,"bottom":0.7432389393766263,"conf":1},{"text":"Bakan","x0":0.6960985628206636,"x1":0.7453798757008971,"top":0.7412790698546214,"bottom":0.7543604647674715,"conf":1},{"text":"Ek:2","x0":0.16632443544198638,"x1":0.20328542010216152,"top":0.781976744156008,"bottom":0.796511627573643,"conf":1}]}