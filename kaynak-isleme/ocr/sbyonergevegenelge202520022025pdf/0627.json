{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453749255891,"x1":0.9630390191214778,"top":0.03924418606144875,"bottom":0.05683760653029257,"conf":1},{"text":"6.3.19. Kutanöz Leishmaniasis Genelgesi (2003/126)","x0":0.13128848312463048,"x1":0.7311148392121455,"top":0.11359781692836945,"bottom":0.13737109342858234,"conf":1},{"text":"T.C.","x0":0.5154004106028275,"x1":0.548254619958432,"top":0.20784883737279003,"bottom":0.22093023228564024,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4702258749947791,"x1":0.5954825436944748,"top":0.21794871808704197,"bottom":0.23418803432635826,"conf":1},{"text":"Temel Sağlık Hizmetleri","x0":0.4599589332721216,"x1":0.6057494854137102,"top":0.22948717938081387,"bottom":0.24572649562013016,"conf":1},{"text":"Genel Müdürluğü","x0":0.48042163822946915,"x1":0.5852867804244085,"top":0.2424970140979733,"bottom":0.2589564742341912,"conf":1},{"text":"SAVI :B100TSH0110002","x0":0.23613962616933876,"x1":0.3921971292572601,"top":0.2776162787359304,"bottom":0.29360465147345627,"conf":1},{"text":"KONU : Kutanöz Leishmaniasis","x0":0.2361396283040156,"x1":0.4188911743311657,"top":0.28760683777689655,"bottom":0.30384615401621273,"conf":0.5},{"text":"24.10.2003 16130","x0":0.46370981244008347,"x1":0.598022793857646,"top":0.32205892037720385,"bottom":0.34147004898375555,"conf":1},{"text":"GENELGE","x0":0.5010266947511356,"x1":0.5626283358514275,"top":0.3604651161358079,"bottom":0.37209302335897954,"conf":1},{"text":"2003/126","x0":0.5051334708477845,"x1":0.5605749478380472,"top":0.3779069766684766,"bottom":0.3880813953868636,"conf":1},{"text":"ILGI: 25.06.1998 tarihli ve B100TSH0110002/6078 saylı Genelgemiz","x0":0.2360338328217517,"x1":0.609959112210733,"top":0.4098285856680943,"bottom":0.4248049029189249,"conf":1},{"text":"Bilindiği gibi Leishmaniasis, Leishmania cinsi parazitler ile enfekte dişi kum sineklerinin (Tatarcık,","x0":0.27926078896343576,"x1":0.8275153901433405,"top":0.4273255814498249,"bottom":0.4405982907665025,"conf":1},{"text":"Phlebotomus) kan emmesi sırasında insanlara bulaştırdığı bir hastalıktır. İnsanlarda üç tip kinik tablo ile","x0":0.23608657493773402,"x1":0.827591817023681,"top":0.4376747722371298,"bottom":0.453825199509307,"conf":1},{"text":"seyreden hastalığın Ulkemizde en çok gorülen şekli Kutanoz Leishmaniais (KL) olup, Şanlıurfa, Osmaniye,","x0":0.23613963880783537,"x1":0.8295687798697496,"top":0.4520348838696593,"bottom":0.4666666663035848,"conf":1},{"text":"Adana, Hatay, Kahramanmaraş ve Mersin illerimizde endemik olarak gorülmektedir.","x0":0.23613963846952643,"x1":0.6858316138889642,"top":0.46366279050502957,"bottom":0.47692307678729995,"conf":1},{"text":"Malům olduğu uzere, KL ile ilgili tanı ve tedavi kriterleri ile vektör ve çevreye yönelik hizmetler ilgi","x0":0.281314176951572,"x1":0.8275153916323648,"top":0.4811046510373831,"bottom":0.4927350427044149,"conf":1},{"text":"genelgemiz ve ekinde gönderilen Kutanöz Leishmaniosis Kontrol Programı kapsamında verilen bilgiler","x0":0.2381930253268313,"x1":0.8275153933905216,"top":0.49273255801377125,"bottom":0.5043604652369429,"conf":1},{"text":"çerçevesinde yürütülmektedir.","x0":0.23613962941058741,"x1":0.40041067849495676,"top":0.505813953353046,"bottom":0.5175213676703808,"conf":1},{"text":"Ancak. ortaya çıkan bir takım gelişmeler ve bu gelişmeler neticesinde yapılan değerlendireler. ilçi","x0":0.27926079307876756,"x1":0.8275153942586724,"top":0.5217948719328027,"bottom":0.5334302320800017,"conf":1},{"text":"genelgemiz çerçevesinde yürütülen hizmetlere ilişkin yeni bir mütalåanın gereklliğini ortaya koymuştur.","x0":0.23819302711638213,"x1":0.7843942417971749,"top":0.5333333334142637,"bottom":0.545058139653726,"conf":1},{"text":"Bu meyanda, yeniden değerlendirilen, KL olgularında tanı ve tedavide yaklaşım ilkeleri ekte","x0":0.2813141592960305,"x1":0.8295687973774806,"top":0.5508547009757206,"bottom":0.5625000001210199,"conf":1},{"text":"gonenmektedir.","x0":0.23613963158050766,"x1":0.3347022573409747,"top":0.5639534882350365,"bottom":0.5755813954582082,"conf":0.5},{"text":"Bu nedenle, KL. le igıli hizmetlerin ilişikteki bilgiler çerçevesinden yürütulmesi ve ilgi genelgemizin iptal","x0":0.27926077120606735,"x1":0.8275154092875177,"top":0.5799145297604235,"bottom":0.5931623930082867,"conf":1},{"text":"edildiği hususlarında bilgilerinizi, keyfiyetin gereği için de ilgililere emirlerinizi rica ederim.","x0":0.23819303705851205,"x1":0.7104722639681817,"top":0.5901162791603084,"bottom":0.6017441855683738,"conf":1},{"text":"EK:","x0":0.23613963025195564,"x1":0.262833675497531,"top":0.6249999998239322,"bottom":0.6366279070471038,"conf":1},{"text":"Kutanoz Leishmaniasis Olgularında","x0":0.2772073938739851,"x1":0.4722792588958072,"top":0.6249999998031729,"bottom":0.6380813955311293,"conf":0.5},{"text":"Tanı ve Tedavide Yaklaşım (3 sf.)","x0":0.2811319932867727,"x1":0.46631179016295354,"top":0.6360609854873017,"bottom":0.6497994130977806,"conf":1},{"text":"Prof. Dr. Recep AKDAG","x0":0.6241867648242876,"x1":0.7597968078898673,"top":0.6742497643613529,"bottom":0.6920293053769778,"conf":1},{"text":"Sağlık Bakonı","x0":0.6406570835879083,"x1":0.722792608130093,"top":0.6874999996511014,"bottom":0.7034883723886273,"conf":0.5},{"text":"DAĞITIM:","x0":0.23593030853282634,"x1":0.3001285361073143,"top":0.7092206704746642,"bottom":0.726163333748924,"conf":1},{"text":"A Plâni","x0":0.2360038684955965,"x1":0.2814499299493639,"top":0.723600058298912,"bottom":0.7371557549819643,"conf":1},{"text":"DAÎMI GENELGE","x0":0.23593207014990167,"x1":0.33696320634553534,"top":0.7463398627086325,"bottom":0.7623810673730748,"conf":1},{"text":"613","x0":0.8973305950608954,"x1":0.9322381932219586,"top":0.9418604652225051,"bottom":0.95639534864014,"conf":1}]}