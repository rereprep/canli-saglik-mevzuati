{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397568687,"x1":0.9609856316724636,"top":0.04059829028555706,"bottom":0.05523255797844895,"conf":1},{"text":"2.3.8. Enjeksiyon Uygulamaları Hakkında Genelge (2019/11)","x0":0.11909651353539849,"x1":0.7967145748639959,"top":0.11482558127133591,"bottom":0.13517441870810976,"conf":1},{"text":"T.C.","x0":0.49691991744924263,"x1":0.5318275156103057,"top":0.219476744353727,"bottom":0.2325581392665771,"conf":1},{"text":"SAGLIK BAKANLIĞI","x0":0.43531827254150124,"x1":0.5954825486276466,"top":0.23247863264849422,"bottom":0.24572649589635753,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.39408294684194967,"x1":0.6366987261789735,"top":0.2455612103139857,"bottom":0.26321197595307066,"conf":1},{"text":"Sayı","x0":0.19917864453506565,"x1":0.2320328538906702,"top":0.28633720941130747,"bottom":0.29941860432415757,"conf":1},{"text":"Konu","x0":0.20123203380776233,"x1":0.24024640496704947,"top":0.2994186045095081,"bottom":0.30959302322789495,"conf":1},{"text":": 14500235-401.99/","x0":0.250513347029294,"x1":0.3819301844517122,"top":0.2863247861265361,"bottom":0.2979651163841148,"conf":1},{"text":": Enjeksiyon Uygulamalar","x0":0.2482478072886318,"x1":0.4314407511522295,"top":0.299194038033906,"bottom":0.31477190369970043,"conf":1},{"text":"Hakkında Genelge","x0":0.2581652469454367,"x1":0.38662383507164116,"top":0.3114778148329176,"bottom":0.32760177234462384,"conf":1},{"text":"GENELGE","x0":0.4743104919471842,"x1":0.5523835530218989,"top":0.35457662811391555,"bottom":0.36635360441401654,"conf":1},{"text":"2019/11","x0":0.48049281320629567,"x1":0.552361396027534,"top":0.36773255826847184,"bottom":0.3822674416861067,"conf":1},{"text":"1219 sayılı Tababet ve Şuabatı San'atlarının Tarzı lerasına Dair Kanunun l'inci maddesi","x0":0.2318394892379006,"x1":0.8297578878171026,"top":0.3908824667237042,"bottom":0.41023774587998973,"conf":1},{"text":"\"Türkiye Cumhuriyeti dähilinde tababet icra ve her hangi surette olursa olsun hasta tedavi","x0":0.1968088147195623,"x1":0.829746115746429,"top":0.4036315245886266,"bottom":0.42524749686301555,"conf":1},{"text":"edebilmek için tıp fakültesinden diploma sahibi olmak şarttır.\" hükmü ile 70\"inci maddesinde","x0":0.19491551755072853,"x1":0.8297438751780714,"top":0.4168234982308947,"bottom":0.43659312279425866,"conf":1},{"text":"\"Tabipler, diş tabipleri ve disçiler yapacakları her nevi ameliye için hastanın, hasta küçük veya","x0":0.1948315722922262,"x1":0.8277097570432088,"top":0.43093010841635293,"bottom":0.4511200897954135,"conf":1},{"text":"tahtı hacirde ise veli veya vasisinin evvelemirde muvafakatımı alırlar. Büyük ameliyei","x0":0.19488467762722556,"x1":0.8276781364297496,"top":0.444079219751234,"bottom":0.4629792938541737,"conf":1},{"text":"cerrahiyeler için bu muvafakatin tahriri olması lazımdır. (Veli veya vasisi olmadığı veya","x0":0.1949111074744136,"x1":0.8277181460456802,"top":0.45627295798653533,"bottom":0.47574326086176066,"conf":1},{"text":"bulunmadığı veya üzerinde ameliye yapılacak şahıs ifadeye muktedir olmadığı takdirde","x0":0.19485203847106192,"x1":0.8276753137223466,"top":0.4703629564087305,"bottom":0.4898358448009914,"conf":1},{"text":"muvafakat şart değildir.) ...\" hükmü yer almaktadır.","x0":0.19507187211671947,"x1":0.5379876757792421,"top":0.4840116280489346,"bottom":0.49871794868930297,"conf":1},{"text":"Kanun Maddesinden de anlaşılacağı üzere, tıbbi müdahalelerde hastanın muvafakatının","x0":0.2441153535720833,"x1":0.8277141443231979,"top":0.4955441784288125,"bottom":0.5152801211715758,"conf":1},{"text":"alımması gereklidir. Ancak, büyük cerrahi işlemler için bu muvafakatın yazılı olması zorunlu olup","x0":0.19488796233238584,"x1":0.8276936724480146,"top":0.5093100233394025,"bottom":0.5288682305334129,"conf":1},{"text":"mevzuatımızda bunun dışında yazılı rıza alınması gereken bir işlem öngörülmemiştir.","x0":0.19479756402078585,"x1":0.7600089788791784,"top":0.5214987222399968,"bottom":0.5433068623344605,"conf":1},{"text":"Enjeksiyon uygulamaları büyük ameliyei cerrahiye olmadığı için hastaların sözel olarak","x0":0.24210481873627843,"x1":0.8276714951055915,"top":0.5362272005979943,"bottom":0.5549802099702816,"conf":1},{"text":"bilgilendirilmesinin gerekli ve yeterli olduğu, müdavi hekim tarafından reçete edilmiş güncel","x0":0.1948501561014676,"x1":0.8256434035319392,"top":0.5487867260439074,"bottom":0.568661142297413,"conf":1},{"text":"tedavisinin yetkili sağlık meslek mensupları tarafindan hastanın reçetesi görülerek yapılması","x0":0.1949031869070233,"x1":0.8256213027908654,"top":0.5624582391003513,"bottom":0.580520304094446,"conf":1},{"text":"halinde yazılı onam alınması zorunluluğu bulunmadığı hususunda.","x0":0.19698826176465364,"x1":0.63051846730331,"top":0.5764221971100152,"bottom":0.5899024129162426,"conf":1},{"text":"Bilgilerinizi ve uygulamanın gereğini önemle rica ederim.","x0":0.24201274691548622,"x1":0.6286186150878147,"top":0.5884862679235383,"bottom":0.6079458619328073,"conf":1},{"text":"Prof. Dr Muhammet GÜVEN","x0":0.6180698197560943,"x1":0.8213552307743643,"top":0.6495726492285356,"bottom":0.6688034184593049,"conf":1},{"text":"Bakan a.","x0":0.6875295096961981,"x1":0.7520310172350362,"top":0.6698167036773451,"bottom":0.6827246517229942,"conf":1},{"text":"Bakan Yardımcisı","x0":0.6588662591822289,"x1":0.7826289872633012,"top":0.6823450308600789,"bottom":0.6963849002500613,"conf":1},{"text":"DAĞITIM","x0":0.19078815729291554,"x1":0.27122416270651983,"top":0.7146629524122767,"bottom":0.7315579776166662,"conf":1},{"text":"Geregi","x0":0.19096509223322117,"x1":0.24435318272437187,"top":0.729651162433689,"bottom":0.745639535171215,"conf":1},{"text":"81 Il Valiligine (II Sağlık Müdürlugu)","x0":0.19072175622698428,"x1":0.44996662661694803,"top":0.7407753248806984,"bottom":0.7605371602887053,"conf":1},{"text":"Yükseköğretim Kurulu Başkanlığına (YÖK)","x0":0.19283308331284774,"x1":0.49710154781297056,"top":0.75417302448806,"botto