8711,"x1":0.5441478446908372,"top":0.3168604649349258,"bottom":0.32848837215809756,"conf":0.5},{"text":"Ülkemizde aile hekimliği uygulaması 5258 sayıkı \"Aile Hekimliği Pilot Uygulaması","x0":0.24413976138885557,"x1":0.8174353823267335,"top":0.3414693496583433,"bottom":0.3621868384607396,"conf":1},{"text":"Hakkında Kanun\" ve bu Kanuna istinaden yayınlanan Yönetmelikler çerçevesinde 2005","x0":0.1949051250967396,"x1":0.8173879230722912,"top":0.3554023018787902,"bottom":0.374552124537753,"conf":1},{"text":"yalunda Düzce finde başlamış ve halen 46 ilimizde devem etmektedir. 2010 yılı sonunda","x0":0.1948496929252683,"x1":0.8174686576036994,"top":0.36686204558769075,"bottom":0.39049481896259053,"conf":1},{"text":"ülkemizin tamamında aile hekimliği uygulamasına geçilecektir.","x0":0.19488639102923447,"x1":0.6141336688760263,"top":0.3831677102557607,"bottom":0.4011448713371888,"conf":1},{"text":"Aile hekimliği uygulamasında standart veri toplanması ve Bakanhığımuza gönderilmesi","x0":0.2422311855066211,"x1":0.8173269007353279,"top":0.3977783156959145,"bottom":0.4132613078844579,"conf":1},{"text":"amacıyla Aife Hekimliği Bilgi Sistemi (AHBS) olusturulmuştur. 05.01.2009 tarih ve 154","x0":0.19496638660654445,"x1":0.8173612851007253,"top":0.40950030308399854,"bottom":0.42705787762513947,"conf":1},{"text":"sayılı \"Protokol defteri\" konulu genel yazımız ile aile hekimlerinin kullandıklan basılı","x0":0.19496441401459416,"x1":0.8153151144944913,"top":0.4227275636969434,"bottom":0.44068115109041883,"conf":1},{"text":"ortamdaki protokol defterleri yerine 01.05.2009 tarihi itibari ile elektronik protokol defteri","x0":0.19492354109465676,"x1":0.8153566058241006,"top":0.4357807861968912,"bottom":0.45566487287098645,"conf":1},{"text":"uygulaması yürürlüğe konulmuştur. Bu ve diğer uygulamalarla ihtiyaç duyulan veriler ulusal","x0":0.19496957446125174,"x1":0.8152910489171163,"top":0.4508153767494685,"bottom":0.46856611191010045,"conf":1},{"text":"sağlık veri sözluğü standartlarında eksiksiz olarak Sağlık Bakanlığı bilgi işlem veri tabanma","x0":0.19293154699943002,"x1":0.8152905771913889,"top":0.46477609269664255,"bottom":0.4819416386248151,"conf":1},{"text":"gönderilmekte ve kaydedilerek depolanmaktadır","x0":0.19301847614476375,"x1":0.5154004148161664,"top":0.479487179520672,"bottom":0.4927350427685353,"conf":1},{"text":"Yukarıda değinildiği üzere Bakanlığımızın yapmış olduğu çalışmalar sonucurda süz","x0":0.2421953374252283,"x1":0.8153062661278998,"top":0.49217849347181675,"bottom":0.508511943071906,"conf":1},{"text":"konusu verilerin aile hekimliği bilgi sistemi aracılığıyla toplanması için gerekli olan bilişim","x0":0.19281316048095548,"x1":0.8153510893654778,"top":0.5040191496342646,"bottom":0.5238826809588631,"conf":1},{"text":"ve donanım alt yapısı oluşturulmuştur. Aile hekimlerinin yapmış olduğu tüm iş ve işlanler ile","x0":0.19293865367703553,"x1":0.8152711147562375,"top":0.5190480333361768,"bottom":0.5352688132441858,"conf":1},{"text":"uygulamaları Aile Hekimtıği Bilgi Sistemine girmeleri nedeniyle, 01.07.2010 tarihinden","x0":0.1929117893410672,"x1":0.8132619731993276,"top":0.5305895055209676,"bottom":0.5493241032732045,"conf":1},{"text":"itibaren aile hekimlerinden aynca basılı veya elektronik ortamde (formı) herhangi bir bilgi","x0":0.19291306143330736,"x1":0.8132372666035386,"top":0.5450178115098585,"bottom":0.5623384167308163,"conf":1},{"text":"istenmeyecektir.","x0":0.19301848183535725,"x1":0.3039014358158827,"top":0.5610465114935126,"bottom":0.5726744187166842,"conf":1},{"text":"Bakanlığımız birimleri, il sağlık müdürlükleri, sağlık grup başkanhkları ve toplum","x0":0.24015522557410826,"x1":0.8132311347101043,"top":0.5719914221022889,"bottom":0.5881146826981486,"conf":1},{"text":"sağlığı muezkezleri ihtiyaçları olan bilgileri, Sağlık Bakanlığı internet suyfası web","x0":0.1929520050308929,"x1":0.8132170201221489,"top":0.5854308998914312,"bottom":0.6019745890323378,"conf":1},{"text":"uygulamalan linkinden ulaşılabilen Aile Hekimliği Bilgi Sistemi (AHBS) ve Karar Destek","x0":0.19293558258959628,"x1":0.8132306355388859,"top":0.5984169177408742,"bottom":0.6158230129358947,"conf":1},{"text":"Sistemin (KDS-Iş Zekası)'den temin edeceklerdir. I] Sağhk Müdürlüklerine bu sistemlerin","x0":0.1909650934440976,"x1":0.8131416823951255,"top":0.6132478633011175,"bottom":0.6264957265489807,"conf":1},{"text":"kullanım yetkisini Bakanlığımız Idari Mali Işler Daire Başkanlığı verecektir.","x0":0.19096508501578663,"x1":0.6960985697143394,"top":0.6264534885194148,"bottom":0.6410256410402712,"conf":1},{"text":"Bu genelgenin yayımı tarihinden evvel yürürlükte bulunan genelgelerdeki aile","x0":0.23819301958493677,"x1":0.8131416821548431,"top":0.6409883722380643,"bottom":0.6555555558712002,"conf":1},{"text":"hekimlerinden yazılı veya elektronik olarak verilerin toplanacağına dair hükümler 1.72010","x0":0.1888208133744086,"x1":0.8111867810569207,"top":0.6524835353528734,"bottom":0.670705864908287,"conf":1},{"text":"tarihi itibariyle uygulanmayacaktu.","x0":0.18870808188894522,"x1":0.42940130915641234,"top":0.6637949782988329,"bottom":0.6826892977516241,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.23819301989387204,"x1":0.48459958429503963,"top":0.6773255815665585,"bottom":0.6962209296834414,"conf":1},{"text":"Prof. Dr. Recep AKDAG","x0":0.6301948374811314,"x1":0.8072280462151663,"top":0.7480625029681186,"bottom":0.7629419049005334,"conf":1},{"text":"Bakan","x0":0.6857996375265124,"x1":0.73925169684678,"top":0.7630078155458283,"bottom":0.7747828820519778,"conf":1},{"text":"Daimm:","x0":0.18891170419675682,"x1":0.25462012290796593,"top":0.796511628239948,"bottom":0.8124999993472614,"conf":0.5},{"text":"Gergél:","x0":0.18891170340463156,"x1":0.24640657150669945,"top":0.8095930228972253,"bottom":0.8255813956347513,"conf":0.5},{"text":"A Plani","x0":0.18685831757769455,"x1":0.24435318106706927,"top":0.8212209305655294,"bottom":0.8372093016728428,"conf":1},{"text":"503","x0":0.8952772069769632,"x