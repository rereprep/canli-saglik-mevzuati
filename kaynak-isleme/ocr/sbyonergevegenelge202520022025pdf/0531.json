{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397633646,"x1":0.9609856316731131,"top":0.040598290285678074,"bottom":0.05523255797856996,"conf":1},{"text":"1.b. Aşı Niteliğinden Kaynakh Reaksiyon","x0":0.19712525641119474,"x1":0.48254620119703584,"top":0.23546511642314716,"bottom":0.24999999984078203,"conf":1},{"text":"Aşı niteliğinden kaynakhı reaksiyon, üretici tarafından sağlanan cnjektör dahil olmak","x0":0.24024640458704222,"x1":0.8069815211605005,"top":0.24999999980657017,"bottom":0.2632478630544335,"conf":1},{"text":"üzere aşı ürününün bir veya daha fazla kalite kusurunun neden olduğu veya hızlandırdığı","x0":0.19500168228443465,"x1":0.8070554761766089,"top":0.26203095054493863,"bottom":0.27812707543851833,"conf":1},{"text":"istenmeyen etkilerdir.","x0":0.1968910149344677,"x1":0.34105319412719176,"top":0.2753066056087542,"bottom":0.2887466823226422,"conf":1},{"text":"Uygulanan tüm aşılanın güvenilir ve lisanslı olduklarından emin olunmalıdır. Bu","x0":0.24435317919398922,"x1":0.8069815227692235,"top":0.2892441859202217,"bottom":0.30087209314339336,"conf":1},{"text":"yüzden üretim tesisleri \"Iyi Uygulama Süreçleri Onay Belgesi\" (GMP), dünyada daha önce","x0":0.1949509714440246,"x1":0.8071030710533996,"top":0.29989163662204366,"bottom":0.31923532904293794,"conf":1},{"text":"kullanılmış, analiz sertifikalanı tekrarlanabilir ve ulusal otorite TITCK tarafindan uygun","x0":0.19705984827508974,"x1":0.8070374505130357,"top":0.31405900469729586,"bottom":0.32858795740183144,"conf":1},{"text":"bulunmuş aşılar ülkemizde kullanılmaktadır. Aynea Aşı Takip Sistemi'nde uygulanan her","x0":0.19712525298241454,"x1":0.8069815229387703,"top":0.32848837190068036,"bottom":0.3415697676286368,"conf":1},{"text":"aşının kime ne zaman yapıldığına dair geriye dönük bilgi edinebilmek için kayıt altında","x0":0.1930184784082812,"x1":0.806981521362861,"top":0.34145299139292207,"bottom":0.35610465100794153,"conf":1},{"text":"tutulmaktadır.","x0":0.1948356202793979,"x1":0.2920023805037829,"top":0.3535516716643682,"bottom":0.3668804676272317,"conf":1},{"text":"1.c. Uygulama Hataları","x0":0.19507186752782613,"x1":0.3593429166121955,"top":0.36752136757214027,"bottom":0.3808139532548055,"conf":1},{"text":"Aşıların üretimi, dağıtımı ya da uygulanması sırasında yapılan hatalara bağlı olarak","x0":0.24222904404180576,"x1":0.807054431832767,"top":0.3797532519182789,"bottom":0.3961422379678331,"conf":1},{"text":"ortaya çıkan istenmeyen etkiler bu grupta toplanmaktadır. Bu gruptaki etkiler, gerçek yan","x0":0.19499512396933005,"x1":0.8070585860664242,"top":0.3931333571148956,"bottom":0.4091529419010742,"conf":1},{"text":"etkilerden biraz daha sık görülmeleri ve önlenebilir olmaları açısından önem taşımaktadır.","x0":0.19497846059230203,"x1":0.7783380924270586,"top":0.4053920261602729,"bottom":0.42185304559475356,"conf":1},{"text":"Bu tip etkiler, genellikle, aşı uygulayan kişi, uşı uygulanan sağlık kuruluşunda aşının","x0":0.24229979104299376,"x1":0.8049281346182282,"top":0.42005813968110783,"bottom":0.4346153847236969,"conf":1},{"text":"saklanması veya uygun olarak hazırlanmamış ya da kontamine olmuş tek bir flakona baghı","x0":0.1950718648390835,"x1":0.8049281347954393,"top":0.4331395345564417,"bottom":0.44914529921609514,"conf":1},{"text":"olarak görülür ve kümelenme gösterebilir. Birden çok flakonun etkilendiği durumlar da söz","x0":0.1949565122916319,"x1":0.8070989805976325,"top":0.44461194078465816,"bottom":0.4636106606765894,"conf":1},{"text":"konusu olabilir (örn: taşıma","x0":0.19712525542588696,"x1":0.40862423089137784,"top":0.4606837605335161,"bottom":0.47094017078992634,"conf":1},{"text":"sırasında donmaya maruz kalmış aşılar nedeniyle lokal","x0":0.4065708536379953,"x1":0.8069815161771995,"top":0.45930232558136563,"bottom":0.47238372049421584,"conf":1},{"text":"reaksiyonlarda artış).","x0":0.19507186639536062,"x1":0.3326488725405012,"top":0.4738372091620119,"bottom":0.4854700852729039,"conf":1},{"text":"En sık görülen uygulama hatası, yanlış uygulanan aşılardan kaynaklı hatalardır. Bu","x0":0.24229979194281967,"x1":0.806981522017166,"top":0.4867521369392649,"bottom":0.5000000001871281,"conf":1},{"text":"yüzden aşılar uygulamadan önce Aşt Takip Sistemi'nden kontrol edilmelidir.","x0":0.19301849524427608,"x1":0.6960985565421713,"top":0.4985465116342058,"bottom":0.5132478633868539,"conf":1},{"text":"Enfeksiyon lokal olarak (om: süpürasyon, apse) ortaya çıkabileceği gibi; sistemik","x0":0.24229979114872782,"x1":0.8049281347239621,"top":0.5130813954978131,"bottom":0.5277777775476344,"conf":1},{"text":"hastalığa (om: sepsis, toksik şok sendromu) da neden olabilir. Bazı uygulama hatalarına bağh","x0":0.19498922331937488,"x1":0.8070580730421114,"top":0.5235067375596278,"bottom":0.5398417228198984,"conf":1},{"text":"İstenmeyen etkiler Tablo 3'te özetlenmiştir.","x0":0.19507186836220133,"x1":0.4804928131480425,"top":0.5376068376303537,"bottom":0.5508720932078975,"conf":1},{"text":"Tablo 3. Sık görülen hatalar ve neden oldukları ASIE*ler","x0":0.1971252529785995,"x1":0.5687885045302357,"top":0.5508547009071192,"bottom":0.5641025641549825,"conf":1},{"text":"Program hatası","x0":0.19712525797013625,"x1":0.3080082119506617,"top":0.56538461538696,"bottom":0.5770348838275327,"conf":1},{"text":"Steril olmayan enjeksiyon:","x0":0.19712525960164579,"x1":0.3716632411815751,"top":0.5784883720288879,"bottom":0.5886627907472749,"conf":1},{"text":"• Steril olmayan enjektör ya da","x0":0.21957437305054345,"x1":0.4621525866142526,"top":0.5910912137948567,"bottom":0.6049975981243673,"conf":1},{"text":"enjektör iğnesi","x0":0.2422170035504516,"x1":0.3429986022700565,"top":0.6043261503611724,"bottom":0.6180575705031913,"conf":1},{"text":"• Kontamine aşı ya da sulandıncı","x0":0.2174737572982418,"x1":0.4519152538832252,"top":0.617417600497344,"bottom":0.6320393970645599,"conf":1},{"text":"• Aşinın imha edilmesi istenen","x0":0.22165056670924868,"x1":0.46209900757466965,"top":0.6314724194637032,"bottom":0.6442162886583209,"conf":1},{"text":"süreden fazla kullamılması","x0":0.24207266427962723,"x1":0.41699241079848304,"top":0.6440595216622612,"bottom":0.6585210610041143,"conf":1},{"text":"Aşının yanlış hazırlanması","x0":0.19712525958593782,"x1":0.3716632411658672,"top":0.6598290597047745,"bottom":0.6730769229526377,"conf":1},{"text":"• Kullanılmadan önce yeterince","x0":0.2197125271959443,"x1":0.4620123185988879,"top":0.6729651161497998,"bottom":0.6846153845903724,"conf":1},{"text":"(Om: enjeksiyon yerinde lokal","x0":0.5482546157162905,"x1":0.7515400451853333,"top":0.5901162792104039,"bottom":0.6047008547656673,"conf":1},{"text":"süpürasyon, apse, seltilit, sistemik","x0":0.5482546237164706,"x1":0.7720739181766334,"top":0.6029914526811019,"bottom":0.6177325579808315,"conf":1},{"text":"enfeksiyon, sepsis, taksik şok","x0":0.548254622267883,"x1":0.7433264872897052,"top":0.6162393163059403,"bottom":0.6308139532706568,"conf":1},{"text":"sendromu, kan yoluyla bulaşan","x0":0.5480447322371585,"x1":0.7558420583216507,"top":0.6290380910090629,"bottom":0.6449645107806976,"conf":1},{"text":"virüslerin bulaşması).","x0":0.5478403420883611,"x1":0.6924627296803493,"top":0.641399971017651,"bottom":0.6579078566163798,"conf":1},{"text":"> Lokal reaksiyon veya abse","x0":0.5209056525290383,"x1":0.7252652675366902,"top":0.6652245325030121,"bottom":0.6862454706916138,"conf":1},{"text":"çalkalanmaması","x0":0.2443531830970756,"x1":0.353182750578489,"top":0.6860465115319067,"bottom":0.6962209302502936,"conf":1},{"text":"• Yanlış sulandıncı kullamılması","x0":0.21909334271241349,"x1":0.44593540882108945,"top":0.6951431901862226,"bottom":0.7152806933944807,"conf":1},{"text":"• Aşı ya da sulandıncıın yerine","x0":0.2197125271862002,"x1":0.4620123185891438,"top":0.7122093021969844,"bottom":0.7239316239925865,"conf":1},{"text":"Kullamlan maddenin (ilacın) etkisi","x0":0.5462012295821324,"x1":0.778234088489516,"top":0.7076923076769898,"bottom":0.7209401709248531,"conf":1},{"text":"başka madde (ilaç) kullamılması","x0":0.2443531799613441,"x1":0.45174538242861095,"top":0.7267441859837964,"bottom":0.7369186047021833,"conf":1},{"text":"Kontrendikasyonlara dikkat edilmemesi","x0":0.19917864263343008,"x1":0.4558521579809305,"top":0.7512820513620784,"bottom":0.7645348839052151,"conf":0.5},{"text":"Onlenebilir ciddi hastalık","x0":0.5482546196128542,"x1":0.7166324416954475,"top":0.745639535008276,"bottom":0.758720929921126,"conf":1},{"text":"Yanhış yere enjeksiyon","x0":0.198873034001839,"x1":0.3472516483606142,"top":0.7775028816720516,"bottom":0.7921209980345336,"conf":1},{"text":"• BCG aşısının intradermal yerine","x0":0.2195776565388583,"x1":0.4621633426655304,"top":0.7905485174314841,"bottom":0.8066041690391607,"conf":1},{"text":"sukütan uygulanması","x0":0.244151502641302,"x1":0.39238387617527737,"top":0.8048108254721975,"bottom":0.8178634006732484,"conf":1},{"text":"• Toksoid asilarm (DaBT / Td /","x0":0.21753969020870936,"x1":0.46423526751419986,"top":0.8168029066090685,"bottom":0.8306754428363029,"conf":1},{"text":"DT / TT) yüzeyel uygulanması","x0":0.2464065672064313,"x1":0.4517453831745862,"top":0.8311965813052601,"bottom":0.8444767439535181,"conf":1},{"text":"Lokal reaksiyon ya da apse","x0":0.5441478416163625,"x1":0.7289527741426247,"top":0.7978632477007532,"bottom":0.8124999998375053,"conf":1},{"text":"517","x0":0.8973305957750882,"x1":0.9281314163252342,"top":0.9433139533236301,"bottom":0.9549418605468017,"conf":1}]}