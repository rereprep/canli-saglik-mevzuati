{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537364127537,"x1":0.963039017837164,"top":0.03760683761997996,"bottom":0.056837606850749234,"conf":1},{"text":"6.3.35. Trişinelloz Genelgesi (2004/28)","x0":0.12525668155860445,"x1":0.5749486569780422,"top":0.11324786289924027,"bottom":0.13517441836976385,"conf":1},{"text":"SAGLIK BAKANLIGIÙ","x0":0.4455359345986182,"x1":0.5914250507682259,"top":0.20627765618783844,"bottom":0.23703629709662577,"conf":1},{"text":"Temel Sağlık Hizmetleri","x0":0.4394250479169556,"x1":0.5975359375039889,"top":0.23247863244804856,"bottom":0.24999999996941613,"conf":1},{"text":"Genel Müdürlüğü","x0":0.455710261417932,"x1":0.577143948455039,"top":0.24517547562546016,"bottom":0.2649989428474946,"conf":1},{"text":"SAYI : B100TSH0110002","x0":0.17248459649868192,"x1":0.355236142525832,"top":0.26581196599075874,"bottom":0.28343023252841704,"conf":1},{"text":"KONU : Trişinelloz","x0":0.17248459963090323,"x1":0.30390143705332145,"top":0.2803418800006705,"bottom":0.2979651162411552,"conf":0.5},{"text":"05.03.2004","x0":0.445585215007722,"x1":0.5277207395499067,"top":0.3343023255624342,"bottom":0.35174418598963864,"conf":1},{"text":"03557","x0":0.5379467772678111,"x1":0.5934700603717448,"top":0.3342373599348307,"bottom":0.3518091515592423,"conf":1},{"text":"GENELGE","x0":0.48446347332794926,"x1":0.550444123965667,"top":0.3805013416163463,"bottom":0.3956614490251795,"conf":1},{"text":"2004 / 28","x0":0.4866529774478007,"x1":0.5482546185480927,"top":0.3938953488916854,"bottom":0.4069767438045355,"conf":1},{"text":"Hayvanlardan insanlara geçen ve zoonozlar olarak bilinen hastalıkların iki yüzün üzerinde olduğu","x0":0.22381930931893482,"x1":0.8624229902628586,"top":0.4286324787627478,"bottom":0.4433139533343019,"conf":1},{"text":"Dünya Sağlık Teşkilatı tarafından bildirilmekte ve bu hastalıklara yenleri eklenerek sayılan sürekli artmaktadır.","x0":0.17248460848969444,"x1":0.8624229888129638,"top":0.44186046526545486,"bottom":0.456410256161357,"conf":1},{"text":"Hatalı beslanme alışkanlıklan, at yapı eksiklikleri, sosyo-ekonomık ve sosyo-kültürel düzeydeki problemler","x0":0.17453797733517598,"x1":0.8624230080608788,"top":0.4563953486454473,"bottom":0.46965811977913097,"conf":1},{"text":"nedeniyle ülkemizde de oldukça önemi bir halk sağlığı problemi cimaya devam eden zoonoz hastalıkların","x0":0.17248460863331122,"x1":0.8624229889565804,"top":0.4694767443323895,"bottom":0.48418803386047804,"conf":1},{"text":"oldukça önemli bir kısmını ise zoonoz parazitozlar cluşturmaktadır. Son zamanlarda ciddi bir epidemi şeklinde","x0":0.1724846085027268,"x1":0.862422988825996,"top":0.48401162771542916,"bottom":0.49709302344338546,"conf":1},{"text":"ortaya çıkarak bu hakkaya eklenen trşınelloz hastalığı da ülkemizdeki parazıt ve gıda kaynaklı zoonoziardan","x0":0.17248460850271535,"x1":0.8624229888259847,"top":0.49854651177731857,"bottom":0.5132478635299665,"conf":1},{"text":"birisi olmuştur.","x0":0.17211990165025426,"x1":0.26935853685987865,"top":0.5101193341370575,"bottom":0.5262178741904658,"conf":1},{"text":"Bakanlığımızca, trişinelloz pidemisi durumunda gerek vaka yönetiminin uygun bir şekide sağlanması","x0":0.22381929006769236,"x1":0.8603696214140497,"top":0.5319767443351531,"bottom":0.5465811962564042,"conf":1},{"text":"gerekse vakalara zamanında müdahale edilerek doğru bir şekilde tedaviye alınması amacıyla \"Trişinelloz","x0":0.17248460855223788,"x1":0.8624229888755072,"top":0.5448717949816233,"bottom":0.559593023100259,"conf":1},{"text":"Vakalarında Yaklaşım\" adlı doküman ile \"Trişinelloz Vaka Bildirim Çizelgesi\" hazırlanarak ilişikte sunulmuştur.","x0":0.17240581983891054,"x1":0.8522245417346935,"top":0.5577059648744738,"bottom":0.574842372384302,"conf":1},{"text":"Bu nedenle, trişineloz vakalannda ilişikte gönderilen bılgiler doğrultusunda hareket edilmesi, söz","x0":0.2217659035761927,"x1":0.862423007920774,"top":0.5799145301017223,"bottom":0.5944767440320317,"conf":1},{"text":"konusu bilgilerin butün sağlık kurum ve kuruluşlarına ulaştırılmasının sağlanması, konuya ilişkin olarak halkın","x0":0.172484608501785,"x1":0.8624229888250543,"top":0.5930232559633855,"bottom":0.6076923075005324,"conf":1},{"text":"biçılenmesi ve bilinçlenmesine yönelik çalışmaların yapılması, gıda denetmlerinin titizikle yapılmasının","x0":0.17248460848684952,"x1":0.8624229888101189,"top":0.6075581396839993,"bottom":0.6222222223334258,"conf":1},{"text":"sağlanması hususlarında bilgeinizi ve keyfiyetin gereği için ilgililere emirlerinizi arz ve rica ederim.","x0":0.172484581449297,"x1":0.7926078208027583,"top":0.6205128202448135,"bottom":0.6351744184503798,"conf":1},{"text":"Prof. Dr. Nedet ÜNÜVAR","x0":0.5749486610715425,"x1":0.7310061641594638,"top":0.6931623934520622,"bottom":0.710755813920906,"conf":1},{"text":"Bakan a.","x0":0.6261284247611903,"x1":0.685986564703364,"top":0.7075567793824431,"bottom":0.7241292670423864,"conf":1},{"text":"Müsteşar","x0":0.6283367563406822,"x1":0.6899383974409742,"top":0.7194767441686652,"bottom":0.7369186045958696,"conf":1},{"text":"EKLER:","x0":0.17248460022834572,"x1":0.22792607721860844,"top":0.7383720929937623,"bottom":0.7558139534209666,"conf":1},{"text":"EK-1. Trişinelloz Vakalarında Yaklaşım (9 sl.)","x0":0.1724846009822866,"x1":0.43737166232623503,"top":0.7572649575228311,"bottom":0.7718023253843261,"conf":1},{"text":"Ek-2. Trişinelloz Vaka Bitirim Çizelgesi (1 sf.)","x0":0.17231052649016773,"x1":0.4416665125998356,"top":0.7701222872905,"bottom":0.7869372234148616,"conf":1},{"text":"DAĞITIM:","x0":0.17043121230329256,"x1":0.23819301751361366,"top":0.7950581395175025,"bottom":0.8124999999447068,"conf":1},{"text":"A Plâni","x0":0.1724845998227169,"x1":0.22176591270295046,"top":0.8081196583622707,"bottom":0.8256410258836382,"conf":1},{"text":"DAIMİ GENELGE","x0":0.17035428759590496,"x1":0.2834444798441006,"top":0.8325972554449398,"bottom":0.8505422793321176,"conf":1},{"text":"675","x0":0.8952772079573869,"x1":0.9322381