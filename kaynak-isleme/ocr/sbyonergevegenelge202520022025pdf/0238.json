{"lines":[{"text":"224","x0":0.06776180656628569,"x1":0.10266940472734884,"top":0.030523255656540016,"bottom":0.04215116287971166,"conf":1},{"text":"T.C.","x0":0.4743326488050599,"x1":0.5071868581606644,"top":0.21511627923744792,"bottom":0.228197674150298,"conf":1},{"text":"SAGLIK BAKANLIGI","x0":0.4147843938737789,"x1":0.5687885012372018,"top":0.22674418584656997,"bottom":0.23982558157452638,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlugo","x0":0.37577001911742297,"x1":0.6098562645239186,"top":0.2397435899743663,"bottom":0.2543604649300245,"conf":1},{"text":"ROP merkezleri sevk usul ve esasları","x0":0.29363449319082824,"x1":0.5462012355401046,"top":0.28760683769642637,"bottom":0.2995726496622384,"conf":1},{"text":"6.1.","x0":0.2484599591123329,"x1":0.27926077966247886,"top":0.2994186047601447,"bottom":0.3124999996729948,"conf":1},{"text":"Tarama muayenesinde ROP teşhisi koyulan vakalar, ilgili sağlık tesisi","x0":0.2874743269518145,"x1":0.7967145846485912,"top":0.299418604457663,"bottom":0.3125000001856194,"conf":1},{"text":"sorumluluğunda olmak üzere en yakın ve uygun olan ROP Tanı ve Tedavi Merkezine sevk","x0":0.19907274407402237,"x1":0.7988747820430557,"top":0.31098143410095147,"bottom":0.32863510314851085,"conf":1},{"text":"edilir.","x0":0.19917864608881888,"x1":0.24435318135813522,"top":0.32558139545781906,"bottom":0.33866279037066915,"conf":1},{"text":"6.2. Hastanın sevk ve nakli için belirlenen ROP tanı ve tedavi merkezi, sevkle","x0":0.24427650003007098,"x1":0.7988857687536199,"top":0.33567109756067914,"bottom":0.35291084913194315,"conf":1},{"text":"gönderilen hastayı kabul etmekle ve bekletmeksizin tedavisini sağlamakla yükümlüdür.","x0":0.19909888982312113,"x1":0.7536633600704383,"top":0.34992208591569707,"bottom":0.3652225872256054,"conf":1},{"text":"6.3.","x0":0.24640657033681268,"x1":0.27515400438784665,"top":0.364825581219281,"bottom":0.37645348844245263,"conf":1},{"text":"Sevk ve nakillerde Acil Sağlık Hizmetleri Çağnı Kayıt ve Operasyon Yönetim","x0":0.2874743278113032,"x1":0.798767972007192,"top":0.36324786329889114,"bottom":0.37649572654675445,"conf":1},{"text":"Sistemindeki güncellenmiş en son veriler esas alınır. Bu nedenle, Bakanlığımızca ROP merkezi","x0":0.2032854293805208,"x1":0.7967145704424352,"top":0.3764534882465904,"bottom":0.38808139546976195,"conf":1},{"text":"faaliyet izni verilen sağlık tesisleri; ameliyathanenin, ilgili kliniğin ve yoğun bakım servisinin","x0":0.20123202441505766,"x1":0.7987679753767414,"top":0.3895348835290917,"bottom":0.4026162792570481,"conf":1},{"text":"durumunu, boş-dolu yatak ve cihazlara ait bilgiler ile ayrıca operasyona alınan vakalanı anında","x0":0.20117357334142713,"x1":0.7988243250111483,"top":0.40111643973815836,"bottom":0.41677487376645783,"conf":1},{"text":"112 Komuta Kontrol Merkezine bildirmekle ve günün her saatinde güncel tutmakla","x0":0.20123202449207356,"x1":0.7987679754537573,"top":0.414102563927502,"bottom":0.4287790696113356,"conf":1},{"text":"yükümlüdür.","x0":0.20093667852026872,"x1":0.2877696867755873,"top":0.42756537111956283,"bottom":0.44162067536155836,"conf":1},{"text":"6.4.","x0":0.24208216463104748,"x1":0.27799365549924343,"top":0.44057138015675723,"bottom":0.4530109090540345,"conf":1},{"text":"Bu Genelgede tanımlanan acil sevk ve nakil işlemleri il sağlık müdürlüklerinin","x0":0.2894561290944593,"x1":0.7988539932920484,"top":0.4387640234283421,"bottom":0.4538673603168428,"conf":1},{"text":"denetim ve sorumluluğunda yürütülür.","x0":0.20123203672298806,"x1":0.4496919876232677,"top":0.45341880339196705,"bottom":0.46666666663983036,"conf":1},{"text":"Genelgenin ilinizde bulunan tüm sağlık kuruluşlarına duyurulması, Bakanlığımıza ve","x0":0.2463456164329253,"x1":0.7988668850076872,"top":0.464273508215001,"bottom":0.48067438503457904,"conf":1},{"text":"üniversitelere bağlı sağlık tesisleri ile özel sağlık tesislerinde ROP hastalığı taraması yapılan","x0":0.20116064126851904,"x1":0.7988377775432697,"top":0.4774391121071042,"bottom":0.4932571504606573,"conf":1},{"text":"veya ROP hastalığı tanısı konulan hastalara sunulan sağlık hizmetlerinin iş bu Genelge","x0":0.2032384493325757,"x1":0.7988203158540766,"top":0.4907981238772807,"bottom":0.504418565265142,"conf":1},{"text":"kapsamında yürütülmesi hususunda;","x0":0.20328541848908202,"x1":0.4353182773964656,"top":0.5058139534267498,"bottom":0.5159883721451368,"conf":1},{"text":"Bilgilerinizi ve gereğini önemle rica ederim.","x0":0.2484599579147193,"x1":0.5318275162014484,"top":0.5174418606111302,"bottom":0.5320512822352079,"conf":1},{"text":"Prof. Dr. Sabahattin AYDIN","x0":0.5708418869065138,"x1":0.7556468194327759,"top":0.5537790695639658,"bottom":0.5668604652919222,"conf":1},{"text":"Bakan a.","x0":0.6342094400510212,"x1":0.6922896865946749,"top":0.568327011880633,"bottom":0.578372018216943,"conf":1},{"text":"Bakan Yardımcısı","x0":0.6078028738126472,"x1":0.724845996515895,"top":0.5811965810998045,"bottom":0.5901709400741635,"conf":1},{"text":"Ek:","x0":0.20328542079781464,"x1":0.22997946604339,"top":0.6206395347120577,"bottom":0.6322674419352293,"conf":1},{"text":"1- Faaliyet Izni Başvuru Formu","x0":0.20533881308835616,"x1":0.4065708376075143,"top":0.6322674417291764,"bottom":0.644017094037453,"conf":1},{"text":"2- Yerinde Denetim ve Değerlendirme Formu","x0":0.20328542389756182,"x1":0.49691991467985097,"top":0.6452991452844348,"bottom":0.6585470085322981,"conf":1},{"text":"Dağıtım:","x0":0.20317426727684298,"x1":0.26499821712528093,"top":0.6843273489408446,"bottom":0.6979400928728025,"conf":1},{"text":"Gereği:","x0":0.20328542074383352,"x1":0.2566735112349842,"top":0.696220930416127,"bottom":0.7093023253289772,"conf":1},{"text":"A Plant","x0":0.20328542148580148,"x1":0.25872689847606417,"top":0.7093023257526696,"bottom":0.7223837206655198,"conf":1},{"text":"Yükseköğretim Kurulu Başkanlığı","x0":0.20533881111187702,"x1":0.4271047190729279,"top":0.7209302325281012,"bottom":0.7354700856485626,"conf":1},{"text":"Bilgi:","x0":0.52156057470985,"x1":0.56