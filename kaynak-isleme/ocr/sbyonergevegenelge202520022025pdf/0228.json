{"lines":[{"text":"214","x0":0.06981519560275043,"x1":0.10061601615289638,"top":0.029069767496336607,"bottom":0.042151162409186704,"conf":1},{"text":"2.3.31. Çocuk Kalp Hastalıkları Merkezleri Hizmetleri Genelgesi","x0":0.13141684338627133,"x1":0.8603696040942141,"top":0.10299145323433534,"bottom":0.12354651173809761,"conf":1},{"text":"(2021/5)","x0":0.12913658639381287,"x1":0.2322597173305335,"top":0.12430894069120868,"bottom":0.14313291973476172,"conf":1},{"text":"SAGLE HEDE TUR ORNE KOLEL DOC -","x0":0.6507756501170441,"x1":0.8440748940486588,"top":0.20622350639417675,"bottom":0.21760207954285526,"conf":0.30000001192092896},{"text":"ỘỰK NỊNE TEH PLANI AMA DAIRESI","x0":0.6527592197284681,"x1":0.8338649568265069,"top":0.21338524556249316,"bottom":0.2250730035925287,"conf":0.5},{"text":"BAŞKANA TO","x0":0.6488706364571102,"x1":0.70841889105829,"top":0.22222222229137412,"bottom":0.23119658126573306,"conf":0.5},{"text":"T.C.","x0":0.48254620080100374,"x1":0.5174537989620669,"top":0.27180232541345895,"bottom":0.2834302326366305,"conf":1},{"text":"SAGLIK BAKANLIĞI","x0":0.4209445543199772,"x1":0.5770020574078984,"top":0.28333333334156685,"bottom":0.29658119658943005,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.3817564430122272,"x1":0.6161510930852038,"top":0.29643013073078506,"bottom":0.31118208672495906,"conf":1},{"text":"Sayı : E-83913885","x0":0.1930184783442675,"x1":0.3305954844894081,"top":0.3357558137538662,"bottom":0.3488372094818226,"conf":1},{"text":"Konu : Çocuk Kalp Hastalikları","x0":0.1971252606269603,"x1":0.3983572851461184,"top":0.348717948525497,"bottom":0.3604651163899134,"conf":1},{"text":"Merkezleri Hizmetleri","x0":0.24408902341620808,"x1":0.38420361968968336,"top":0.36176057460276956,"bottom":0.37542173299330384,"conf":1},{"text":"GENELGE","x0":0.4569585569779223,"x1":0.5348110575152089,"top":0.4137557186411278,"bottom":0.430852078350517,"conf":1},{"text":"2021/","x0":0.46817248371932874,"x1":0.5256673518213967,"top":0.4287790696893773,"bottom":0.43895348840776416,"conf":1},{"text":"Bakanlığımızca kalp merkezlerinin planlaması, kurulumu ve işleyişi ile ilgili usul ve esasları","x0":0.24217138340619104,"x1":0.7988899444702782,"top":0.45042784746687814,"bottom":0.4657884335191451,"conf":1},{"text":"düzenleyen 18.07.2019 tarihli ve 80118214-060.04-457 (2019/14) sayılı \"Kalp Merkezi Hizmetleri","x0":0.19293247161291077,"x1":0.7988407559213109,"top":0.4621758435176715,"bottom":0.4788071264218807,"conf":1},{"text":"Genelgesi\" yayımlanmış olup erişkin kalp merkezi ve çocuk kalp hastalıkları merkezi ayrımı","x0":0.1949007860635205,"x1":0.800970625338101,"top":0.4731911044143937,"bottom":0.4916847828415438,"conf":1},{"text":"yapılmaksızın tüm iş ve işlemler ilgili Genelge kapsamında yürütülmektedir.","x0":0.19288975868978425,"x1":0.6490411282389832,"top":0.4859786447300011,"bottom":0.5013336049189075,"conf":1},{"text":"Çocuk kalp hastalıkları, fetal dönemden erişkinlik dönemine kadar, organ gelişimini, doğum","x0":0.23805550184106491,"x1":0.7988977737127585,"top":0.49846521417310696,"bottom":0.5153021842497088,"conf":1},{"text":"sürecini, büyümeyi, gelişmeyi, yaşam tarzını ve kalitesini etkilemektedir. Bu dönemde koordineli bir","x0":0.19495235175365194,"x1":0.798881015752386,"top":0.5098169280928817,"bottom":0.525643538103795,"conf":1},{"text":"şekilde ve son teknolojik uygulamalar eşliğinde, alanında uzmanlaşmış bir ekip tarafından çocuk kalp","x0":0.19289597314559298,"x1":0.7989165119553912,"top":0.5213336780712914,"bottom":0.5388807434475079,"conf":1},{"text":"hastalıklarının erken tamı, tedavi ve takibinin sağlanması önem arz etmektedir.","x0":0.19491314027650353,"x1":0.6551660797060115,"top":0.5340797540634821,"bottom":0.5488771457104298,"conf":1},{"text":"Bu nedenle, çocuk kalp hastalıkları merkezi hizmetlerinin çağın gerekleri doğrultusunda,","x0":0.23805383294278798,"x1":0.7989167696799593,"top":0.5462773039712994,"bottom":0.5633439057815917,"conf":1},{"text":"ülkenin ihtiyaç ve şartlarına uygun olarak sunulmasını sağlama, bu merkezlerin hizmet standartlarını,","x0":0.19493801215950765,"x1":0.798903909817647,"top":0.5577330795694774,"bottom":0.5729084392465231,"conf":1},{"text":"fiziki şartlarını, araç, gereç, tıbbi donanım ve personel standartlarını belirleme, mevcut merkezleri","x0":0.19490739684434374,"x1":0.7988904537211386,"top":0.5687139716833817,"bottom":0.5852555048682483,"conf":1},{"text":"yeniden yapılandırma, yeni kurulacak merkezleri planlama ve açılmalarına izin verme, bunların işleyişi","x0":0.19291642892447483,"x1":0.7988819475299388,"top":0.5812033634498225,"bottom":0.5965547306503641,"conf":1},{"text":"ve denetimine ilişkin usul ve esaslarını düzenleme ihtiyacı håsıl olmuştur. Bu kapsamda, çocuk kalp","x0":0.19498743514311775,"x1":0.7988624073931555,"top":0.5939658928393896,"bottom":0.6083509222327731,"conf":1},{"text":"hastalıkları merkezi hizmetlerine ait usul ve esaslar iş bu Genelge ile ekte belirtilen şekliyle","x0":0.1928731031004741,"x1":0.7988861139949912,"top":0.6049004414470918,"bottom":0.6209576254545245,"conf":1},{"text":"düzenlenmiştir","x0":0.19262567636038033,"x1":0.28590777398888034,"top":0.6164508268750609,"bottom":0.6289117514963821,"conf":1},{"text":"Gencigenin ilinizde bulunan kamu, üniversite ve özel sağlık tesislerine duyurulması ve çocuk","x0":0.23597632800555474,"x1":0.798922578395235,"top":0.6291097845192334,"bottom":0.6462044602191032,"conf":1},{"text":"kalp hastalıklarınin tanısı, tedavisi ve takibi için sunulan sağlık hizmetlerinin iş-bu-Genelge kapsamında","x0":0.19083259086612614,"x1":0.7988999476999381,"top":0.6405079098046201,"bottom":0.6575040913252616,"conf":1},{"text":"yürütülmesi hususunda;","x0":0.18872752683731847,"x1":0.3390828462836654,"top":0.6526172508603812,"bottom":0.6672596076677314,"conf":1},{"text":"Bilgilerinizi ve gereğini önemle arz/tica ederim.","x0":0.23803642796019747,"x1":0.5258120419133508,"top":0.6654404401643244,"bottom":0.6799880718437614,"conf":1},{"text":"Prof.: Dr. Sabalattin