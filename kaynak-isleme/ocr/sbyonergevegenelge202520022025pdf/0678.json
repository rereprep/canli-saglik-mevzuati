{"lines":[{"text":"664","x0":0.06570841855644562,"x1":0.10677618082753795,"top":0.027616278703104014,"bottom":0.04360465144062986,"conf":1},{"text":"6.3.31. Kırım-Kongo Kanamalı Ateşi Genelgesi (2006/81)","x0":0.1314168466767982,"x1":0.774127300618946,"top":0.1132478628966549,"bottom":0.13517441836717858,"conf":1},{"text":"T. C.","x0":0.4862637302110735,"x1":0.5241883549112853,"top":0.2140903850106084,"bottom":0.22632850237534508,"conf":1},{"text":"SAGLIK BAKANLIĞI","x0":0.42915810969104784,"x1":0.5811088305553588,"top":0.22521367516507595,"bottom":0.23982558123301378,"conf":1},{"text":"Temel Sağhk Hizmetleri Genel Mudurtuğu","x0":0.37166324619173174,"x1":0.6406570805339041,"top":0.23675213674751083,"bottom":0.2529914529868271,"conf":1},{"text":"Say1 : B100TSH0110002-101-02-01","x0":0.21765913914634358,"x1":0.4599589305492872,"top":0.27179487178291273,"bottom":0.2906976740464824,"conf":1},{"text":"Komu : Kınm-Kongo Kanamals Ateși","x0":0.21943535484195534,"x1":0.4581763242957416,"top":0.295766390405509,"bottom":0.3164964016852754,"conf":1},{"text":"TSE-SO-EN","x0":0.7207392195294853,"x1":0.7741273100206361,"top":0.2354651158841441,"bottom":0.25145348862166994,"conf":0.5},{"text":"14.07.06","x0":0.41474987515156103,"x1":0.48052733204169956,"top":0.3516462354014822,"bottom":0.3634700436313688,"conf":1},{"text":"11494","x0":0.5462012310681957,"x1":0.5975359350602345,"top":0.35174418589687084,"bottom":0.3633720931200425,"conf":1},{"text":"GENELGE","x0":0.4680748408520436,"x1":0.5442454888756558,"top":0.40083622096667604,"bottom":0.41311726712490426,"conf":1},{"text":"(2006/81)","x0":0.4721155547789813,"x1":0.5402047735644068,"top":0.41374908954900347,"bottom":0.42636718947894336,"conf":1},{"text":"Ilgi: a) 30/12/2003 tarihli ve B100TSH0110002/20 409 sayıl genelge.","x0":0.21971253103319152,"x1":0.6632443469552932,"top":0.4388888890291367,"bottom":0.450581395460651,"conf":1},{"text":"b) 31/03/2004 tarihli ve B100TSH0110002/5367 (2004/46) sayil genelge.","x0":0.26481910612939863,"x1":0.7187708852562313,"top":0.4495193065852403,"bottom":0.46252075465410347,"conf":1},{"text":"c) 06/08/2004 tarihli ve B100TSH0110002/12 875 sayılı yazı.","x0":0.26488706311694177,"x1":0.644763860665026,"top":0.463662790637249,"bottom":0.4739316239280664,"conf":1},{"text":"g) 11/03/2005 tarihli ve B100TSH0110002/3580 (2005/40) sayal genelge.","x0":0.262833667551841,"x1":0.7186858393701602,"top":0.47521367523736946,"bottom":0.48846153848523266,"conf":1},{"text":"d) 10/03/2006 taribli ve B100TSH0110002/3079 sayıl yaz1.","x0":0.2627233140537119,"x1":0.6325633340454933,"top":0.48565058345390477,"bottom":0.501726549139627,"conf":1},{"text":"Ulkemizde 2002 yılından beri görülmeye başlayan ve önemli bir halk sağlığı problemi","x0":0.26488706586304434,"x1":0.794661188550941,"top":0.5130813952233612,"bottom":0.5247863246892827,"conf":1},{"text":"olan Kırım-Kongo kanamah ateşi (KKKA) ile ilgili bütün uygulamaların ilgi genelge ve","x0":0.21971252687259776,"x1":0.7946611894425041,"top":0.5247093021979633,"bottom":0.5363372094211349,"conf":1},{"text":"yazılar çerçevesinde yapıldığı malumunuzdur.","x0":0.21971252459142104,"x1":0.5030800828781502,"top":0.5376068376931914,"bottom":0.5495726496590033,"conf":1},{"text":"Hastalıkla mücadele kapsamında başarılı birçok çalışma Bakanlığımızın eş","x0":0.26488706584890653,"x1":0.7946611885368033,"top":0.5623931623340435,"bottom":0.572674418659268,"conf":1},{"text":"gudumünde gerçekleştirilmiştir. Ancak, uygulamada zaman zaman aşağıda belirtilen aksaklık","x0":0.21966072186798222,"x1":0.7947194248465569,"top":0.5738958674703822,"bottom":0.5870748966253635,"conf":1},{"text":"ve olumsuzluklarla da karşılaşılmaktadır.","x0":0.2176591346565788,"x1":0.4722792635049672,"top":0.5871794872403995,"bottom":0.5988372094201058,"conf":1},{"text":"Belirlenen aksaklıklar genel olarak:","x0":0.2648870648584712,"x1":0.48254619982129804,"top":0.611918604522412,"bottom":0.6235465117455836,"conf":1},{"text":"• İlgi (a) yazı ekinde ömeği ve doldurma talimatı yer alan Kırım-Kongo Kanamahı Ateşi","x0":0.2175975207606988,"x1":0.7947161049103927,"top":0.6278130687561807,"bottom":0.643795809109496,"conf":1},{"text":"Vaka Bildirim Çizelgesi'nin yapılan vaka tanımları çerçevesinde doğru ve okunaklı olarak","x0":0.2442918883324426,"x1":0.794708218949035,"top":0.6409662660175632,"bottom":0.6538486665954671,"conf":1},{"text":"doldurulmadığn, epi numaralarımın yazılmadığı ve birer nüshalarımın Bakanlğımıza","x0":0.24229978716232176,"x1":0.794661198241996,"top":0.6540697672496528,"bottom":0.6671511629776092,"conf":1},{"text":"ulaştırılmadığı,","x0":0.24011927707273104,"x1":0.3390265540427422,"top":0.6650991944838325,"bottom":0.6783356601009553,"conf":1},{"text":"/ Her ay sonunda Bakanlığımaza bildirilmesi gereken kesin KKKA vaka ve ölüm","x0":0.2196079375612669,"x1":0.7968014687498628,"top":0.6816160196125204,"bottom":0.6981052246061352,"conf":1},{"text":"imallerinin gönderilmediği.","x0":0.24024641110543055,"x1":0.41889116568358387,"top":0.6961538460423209,"bottom":0.7078488373252486,"conf":1},{"text":"• Kan ve serum örneklerinin, biyogüvenlik önlemleri alınmadan uygun olmayan şartlarda,","x0":0.21758855374263147,"x1":0.7926853022146123,"top":0.7106917959781283,"bottom":0.7272642241353152,"conf":1},{"text":"bazen de hasta sahipleri ile laboratuvara yollandığı,","x0":0.24024640063088035,"x1":0.558521566304059,"top":0.7267441859862295,"bottom":0.7369186047046163,"conf":1},{"text":"• Hastalara ait ikinci numunelerin ahumasında gerekli titizliğin güsterilmediği; ancak,","x0":0.21765913499663406,"x1":0.7946611840656523,"top":0.7412790697979655,"bottom":0.7559829059944737,"conf":1},{"text":"şikäyeti olmayan kişilerden \"temaslı\" diye bahsedilerek numune ahndığı ve laboratuvara","x0":0.24222133077667418,"x1":0.7947503855775357,"top":0.7546427927206745,"bottom":0.7705004411626086,"conf":1},{"text":"gönderildiği şeklindedir.","x0":0.24024640617781073,"x1":0.3942505135412337,"top":0.7688034189162506,"bottom":0.7820512821641138,"conf":1},{"text":"KKKA vakalarımın ve pideminin doğru bir şekilde izlenmesi yanında, gerekli kontrol","x0":0.264887065853309,"x1":0.7946611885412058,"top":0.7978632478417966,"bottom":0.8095930233765324,"conf":1},{"text":"ve korunma önlemlerinin ahınması için süz konusu aksaklıkların giderilmesinin önemi","x0":0.21971252690670284,"x1":0.7946611894766091,"top":0.8110465115019379,"bottom":0.8226744187251095,"conf":1},{"text":"bilgileriniz dähilindedir.","x0":0.2176591363806291,"x1":0.36960985724494005,"top":0.8239316239611099,"bottom":0.8358974359269218,"conf":1}]}