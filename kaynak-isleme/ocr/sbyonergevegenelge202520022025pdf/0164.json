0558296846819253,"bottom":0.4202932660119709,"conf":1},{"text":"b) Doğal afet, genel salgın hastalık, kısmi veya genel seferberlik ilanı gibi mücbir","x0":0.2628336833416437,"x1":0.8069815115233244,"top":0.4186046509707442,"bottom":0.4316860466987006,"conf":1},{"text":"sebeplerden dolayı sağlık kabinin faaliyeti Müdürlükçe en fazla 2 (iki) yıl süreyle askıya","x0":0.21971253170116548,"x1":0.8069815132657437,"top":0.4302325579475438,"bottom":0.4433139536755002,"conf":1},{"text":"alınabilir. Askı süresinin sonunda faaliyete geçmeyen sağlık kabininin işletme uygunluk belgesi","x0":0.21765914361232164,"x1":0.8049281251768999,"top":0.44316239325487805,"bottom":0.45641025650274125,"conf":1},{"text":"iptal edilir.","x0":0.21718472918446566,"x1":0.2899093079311829,"top":0.4541952056479662,"bottom":0.4684493469094012,"conf":1},{"text":"27. Bu Genelgenin yürürlüğe girdiği tarihten önce faaliyette bulunan sağlık kabinleri en","x0":0.26078029604487557,"x1":0.8069815107256684,"top":0.46794871782293934,"bottom":0.48119658107080254,"conf":1},{"text":"geç 6 (altı) ay içerisinde Genelge'ye uygun hale getirilir. Belirtilen süre sonunda uygunluk","x0":0.21971253170683994,"x1":0.8069815132714182,"top":0.4794871795892999,"bottom":0.4914529915551118,"conf":1},{"text":"sağlayamayan sağlık kabinlerinin faaliyetine Müdürlükçe son verilir.","x0":0.21971253700499724,"x1":0.6365502915370974,"top":0.49127906985798275,"bottom":0.502991453063038,"conf":1},{"text":"28. 1997-3 sayılı Sağlık Kabinlerinin Açılışı ve Işleyişi Hakkında Genelge yürürlükten","x0":0.26283368333881496,"x1":0.8069815115204958,"top":0.5042735040908677,"bottom":0.5175213673387309,"conf":1},{"text":"kaldırılmıştır.","x0":0.2174307328112201,"x1":0.306256470650242,"top":0.5163825444769551,"bottom":0.5286774466263838,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.26283367914876865,"x1":0.4866529736089315,"top":0.5290598290627664,"bottom":0.5423076923106296,"conf":1},{"text":"Dr. Faretin KOCA","x0":0.66119096457