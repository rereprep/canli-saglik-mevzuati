2177018023,"top":0.35170940166413034,"bottom":0.3633720931391101,"conf":0.5},{"text":"- Aşı etkisi","x0":0.2647933483509964,"x1":0.33274258573627685,"top":0.36305153650994537,"bottom":0.3738670680857271,"conf":1},{"text":"- Vaka değil","x0":0.2648870615135731,"x1":0.34291581305753377,"top":0.37499999985803156,"bottom":0.3867521366101683,"conf":1},{"text":"Tüm vakalar ayrıca importe, importe vakayla ilişkili veya importasyonla ilişkili olmayan","x0":0.26078029126159163,"x1":0.7946611869477124,"top":0.3982558137611095,"bottom":0.41153846166833397,"conf":1},{"text":"vaka şeklinde de sınıflanacaktır.","x0":0.2195360761690747,"x1":0.4087388979859769,"top":0.409238691270432,"bottom":0.4219150166853667,"conf":1},{"text":"• İmporte Vaka: Döküntünun başlangıcından önceki inkübasyon süresi boyunca (kızamık","x0":0.2380986342315878,"x1":0.7927048401268606,"top":0.43296881430527656,"bottom":0.44905924405146425,"conf":1},{"text":"için 7-18, kızamıkçık için 12-23 gün) yurt dışında bulunma öyküsü olan ve pidemiyolojik","x0":0.26078029037162065,"x1":0.7926077995586295,"top":0.4461538460449742,"bottom":0.45784883732790194,"conf":1},{"text":"ve/veya virolojik olarak da yabancı kaynaklı enfeksiyona ilişkin kanıtlarla desteklenen","x0":0.2607802903804334,"x1":0.7926077995674422,"top":0.45769230767276714,"bottom":0.47094017092063045,"conf":1},{"text":"• Importe Vakayla İlişkili Vaka: Importe vakayla pidemiyolojik ve/veya virolojik ilişkisi","x0":0.23613963947650546,"x1":0.7926077866528582,"top":0.48110465113275236,"bottom":0.4957264957912372,"conf":1},{"text":"bulunan vakadır. Importe vakayla ilişkili tüm vakalar yerli vaka olarak kabul edilir.","x0":0.26078029063823516,"x1":0.7453798734441224,"top":0.4940170940131656,"bottom":0.5059829059789777,"conf":1},{"text":"• Importasyonla İlişkili Olmayan Vaka: Importasyonun veya importe vakayla ilişkinin","x0":0.23819301139299606,"x1":0.7926078089717823,"top":0.5058139532859877,"bottom":0.5188953490139441,"conf":1},{"text":"katlanamadığı veya enfeksiyon kaynağı bilinmeyen sporadik vakadır. Yerli vaka olarak","x0":0.2587269030793725,"x1":0.7926077987654933,"top":0.5188034189215622,"bottom":0.5320512821694255,"conf":1},{"text":"6.5.1. Aşılanma Öyküsü Durumunda Yaklaşım","x0":0.21971252699598848,"x1":0.5112936312791656,"top":0.5537790698546214,"bottom":0.5668604647674717,"conf":1},{"text":"• Kızamık ve/veya kızamıkçık aşısı uygulanmış olan kişilerde, aşılamadan sonra IgM","x0":0.227926075284206,"x1":0.7926078053585524,"top":0.5784883719671053,"bottom":0.5901709402156259,"conf":1},{"text":"saptanması beklenir. Serolojik yöntemler doğal enfeksiyon ve aşılama ile ortaya çıkan","x0":0.24845996669276693,"x1":0.7926077948744477,"top":0.5901162789430723,"bottom":0.6017441861662439,"conf":1},{"text":"bağışıklık yanıtını ayıramaz; bu nedenle, sadece virüsün izolasyonu ve genetik","x0":0.24845996670998094,"x1":0.7926077948916617,"top":0.6029914528852756,"bottom":0.613372093078204,"conf":1},{"text":"tiplendirilmesi ile doğal enfeksiyon ve aşı ile oluşan IgM yamıtı ayırt edilebilir","x0":0.24845995094775014,"x1":0.7043121227660694,"top":0.6148255812694803,"bottom":0.6264957264835936,"conf":1},{"text":"• Virüs izolasyonu veya tespiti yapılamamış IgM pozitif bir vakada yakın zamanda (doküntu","x0":0.22587268800915122,"x1":0.7926078045826097,"top":0.6380341878705074,"bottom":0.6512820511183706,"conf":1},{"text":"başlangıçından önceki 6 hafla içinde) aşılanma öyküsü olması durumunda yaklaşım aşağıda","x0":0.2443531736685714,"x1":0.7926078117500217,"top":0.6495726495701531,"bottom":0.6628205128180163,"conf":1},{"text":"yer almaktadır:","x0":0.24619998524358028,"x1":0.3389578964183129,"top":0.6615062739910281,"bottom":0.6726153872767123,"conf":1},{"text":"Tablo 4. Aşılanma Oyküsu Olan Vakaya Yaklaşım","x0":0.21765913369695436,"x1":0.5174538024273523,"top":0.6845930234020381,"bottom":0.6991452987418004,"conf":1},{"text":"Epidemiyolojik Bulgu","x0":0.21765913620637337,"x1":0.3572895288506259,"top":0.7076923076715527,"bottom":0.7209401709194159,"conf":0.5},{"text":"Son Vaka Sınıflaması","x0":0.6137604504902086,"x1":0.7476358626066686,"top":0.7077539431910103,"bottom":0.719571638939103,"conf":1},{"text":"-Laboratuvarla doğrulanmış vaka ilc","x0":0.22792608082637714,"x1":0.449691988787428,"top":0.734011627711128,"bottom":0.7470930234390845,"conf":1},{"text":"pidemiyolojik ilişkinin varlığı","x0":0.22792607572465526,"x1":0.41273100825091735,"top":0.7456395347529565,"bottom":0.7572674419761283,"conf":1},{"text":"-Toplumda yapılan aktif araştırma ile virüs dolaşımının","x0":0.2279260760486343,"x1":0.5564681742173729,"top":0.760174418407659,"bottom":0.7732558141356154,"conf":1},{"text":"olduğuna dair kanıt bulunmaması","x0":0.2299794685510063,"x1":0.4271047200719404,"top":0.7730769229268047,"bottom":0.7834302326070588,"conf":1},{"text":"-Vinüsün dolaşımda olduğu bölgelere seyahat hikayesi","x0":0.2298385342644258,"x1":0.5504253234520958,"top":0.7830403941958366,"bottom":0.7989574842612955,"conf":1},{"text":"bulunmamasi","x0":0.22997946835132202,"x1":0.3080082106698963,"top":0.7965116278801175,"bottom":0.8052325580937197,"conf":1},{"text":"Laboratuvarla doğrulanmaş","x0":0.609447106707167,"x1":0.7725252948826128,"top":0.7327710521963524,"bottom":0.7487557651068008,"conf":1},{"text":"(kesin) vaka","x0":0.6098562606663248,"x1":0.6878850122102854,"top":0.7470085472016468,"bottom":0.7572674419019172,"conf":1},{"text":"Vaka değil","x0":0.6118554802347899,"x1":0.6797256283826866,"top":0.7730964947745397,"bottom":0.7850430400738415,"conf":1},{"text":"(yakın zamanda aşılanmış)","x0":0.6098562602219633,"x1":0.7700205363081085,"top":0.7848837207311936,"bottom":0.7979651164591499,"conf":1},{"text":"549","x0":0.8932238196822326,"x1":0.9301848043424078,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}