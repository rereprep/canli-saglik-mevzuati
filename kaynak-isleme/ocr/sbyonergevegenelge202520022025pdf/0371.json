{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.44969198763688983,"x1":0.9630390183318907,"top":0.037606837772855006,"bottom":0.05683760700362428,"conf":1},{"text":"3.3.6.Ambulans Hizmetleri Koordinasyonu Genelgesi (2005/30)","x0":0.12936343983828538,"x1":0.8644763969451097,"top":0.11025641001450381,"bottom":0.13517441847648048,"conf":1},{"text":"T.C.","x0":0.49486653024235455,"x1":0.537987679012559,"top":0.23110465111945433,"bottom":0.24854651154665863,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4271047249572054,"x1":0.5995893200380228,"top":0.24401709421435014,"bottom":0.26025641045366643,"conf":1},{"text":"Temel Saghk Hizmetleri Genel Müdürlügü","x0":0.3591850032600795,"x1":0.6695517987180603,"top":0.25591822917807683,"bottom":0.27521503994770413,"conf":1},{"text":"SAYT : B100TSH0160001","x0":0.16837782667895418,"x1":0.3675564646990003,"top":0.30085470090461053,"bottom":0.31410256415247373,"conf":1},{"text":"KONU : Ambulans Hizmetleri","x0":0.17248459800483246,"x1":0.38193018697121134,"top":0.3123931620042928,"bottom":0.3286324782436092,"conf":1},{"text":"Koordinasyom","x0":0.23389002236989478,"x1":0.3453482253177674,"top":0.32607745019428647,"bottom":0.3425661449313867,"conf":1},{"text":"22.02.2005","x0":0.4352894107282997,"x1":0.5236428272357485,"top":0.3414720135786693,"bottom":0.35474891661702035,"conf":1},{"text":"2389","x0":0.5523613959752159,"x1":0.5934291582463084,"top":0.34302325565654,"bottom":0.35465116287971166,"conf":1},{"text":"GENELGE","x0":0.47223294495695023,"x1":0.5565144881028277,"top":0.370489401072146,"bottom":0.38387106401149484,"conf":1},{"text":"2005/30","x0":0.4821919889291147,"x1":0.544502056674448,"top":0.38148152779783606,"bottom":0.39758823929143405,"conf":1},{"text":"VALILIGINE","x0":0.5174341270843331,"x1":0.6160360991176851,"top":0.4098094619851089,"bottom":0.4230393749630612,"conf":1},{"text":"(Il Saghk Müdürluğü)","x0":0.4373716620479802,"x1":0.5893223829122912,"top":0.43888888896471134,"bottom":0.45213675221257466,"conf":1},{"text":"Acil hastalık ve yaralanma hallerinde acil sağlık hizmetlerinin yut sathında eşit, ulaşılabilir,","x0":0.22381930773010683,"x1":0.8583162156758066,"top":0.46794871775675984,"bottom":0.4825581393808376,"conf":1},{"text":"kaliteli ve süratli bir şekilde sunulması, bu hizmeti günün 24 saati vatandaşlarınuzın alabılmesi","x0":0.172484587744259,"x1":0.8562628454717378,"top":0.48110465096700183,"bottom":0.49418604669495836,"conf":1},{"text":"amacıyla, Bakanlığınuzca 112 Acil Sağlık Hizmetleri kurulnuş ve halen 81 ilimizde faaliyet","x0":0.17043121870939093,"x1":0.8562628260344364,"top":0.4940170938784938,"bottom":0.508720930075002,"conf":1},{"text":"sürdürmektedir","x0":0.17043121048493606,"x1":0.2751540049681255,"top":0.5087209300944368,"bottom":0.5203488373176085,"conf":1},{"text":"Tüm ambulans hizmetlerinin tek merkezden koordine edilmesi, 24.03.2004 tarih ve 25412","x0":0.2238192884850708,"x1":0.8562628468332041,"top":0.5217948716505646,"bottom":0.5350427348984279,"conf":1},{"text":"sayılı Resmi Gazetede yayımlanan Acil Sağlık Hizmetleri Yönetmeliğinde Değişiklik Yapılmasına","x0":0.17035548241428217,"x1":0.856339493122225,"top":0.533853355853037,"bottom":0.5520255025768576,"conf":1},{"text":"Dair yönetmelik ve 24.01.2005 tarihinde yayınlanan Il Ambulans Servisi Çalışma Yönergesi ile","x0":0.17043121947231657,"x1":0.8562628267973619,"top":0.5478632479195711,"bottom":0.5641025641588873,"conf":1},{"text":"hukme baglanmiştır","x0":0.17248460124943588,"x1":0.3080082116700781,"top":0.5639534883068855,"bottom":0.5741279070252724,"conf":1},{"text":"Bu nedenle ilinizdeki tüm ambulans hizmetlerinin Il Ambulans Servisi Başhekimliği","x0":0.2237582991346253,"x1":0.8563282083745362,"top":0.5730997536753255,"bottom":0.5903154180416972,"conf":1},{"text":"koordınatörlüğünde yürütülmesi; hastalarm hastaneden hastaneye veya hekun tarafindan hastaneden","x0":0.17043121881955733,"x1":0.8562628261446026,"top":0.5901162788782016,"bottom":0.603197674606158,"conf":1},{"text":"evlerine ambulansla nakli uygun görülenlerin evlerine nakilleri ile il dışma ambulansla nakli uygun","x0":0.17043121881667322,"x1":0.8562628261417186,"top":0.6029914526857669,"bottom":0.6177325579854965,"conf":1},{"text":"görulen hastaların nakli için, Il Ambulans Servisi Başhekimliği ne başvurulması ve bu nakillerin II","x0":0.17035934750527315,"x1":0.8563302212630195,"top":0.6155085380600018,"bottom":0.6323049769781562,"conf":1},{"text":"Ambulans Servisi Başhekimligi nee görevlendırilecek ambulans de yapılması gerekmektedir.","x0":0.17248460069765054,"x1":0.7946611896486784,"top":0.6322674416687181,"bottom":0.6453488373966745,"conf":1},{"text":"Söz konusu nakiller için ambulans ücretleri, 9 Şubat 2005 tarihi ve 25722 sayılı Resmi","x0":0.2237464420731685,"x1":0.8563446178969291,"top":0.6430952902847374,"bottom":0.6604708646412077,"conf":1},{"text":"Gazete'nin Mükerrer sayısında yayılanan 2005 Mali Yıhı Bütçe Uygulama Talimat'nın 2.4. bölümü","x0":0.17241893229223582,"x1":0.8563166772240299,"top":0.6568532616199498,"bottom":0.6741905618471884,"conf":1},{"text":"hükümlerne göre tahsil edilebilecektir","x0":0.17043121094026786,"x1":0.43121149928599223,"top":0.6729651164238614,"bottom":0.6876068374483338,"conf":1},{"text":"Ayrıca 12.06.2004 tarih ve 25490 sayılı Resmi Gazetede yayımlanarak yırtırltğe giren","x0":0.22381928848229607,"x1":0.8562628468304294,"top":0.6858974361793201,"bottom":0.7005813951947343,"conf":1},{"text":"26.05.2004 tarihli ve 2004/7379 sayıl: Bakanlar Kurulu Kararı gereğince hiçbir sosyal guvencesı","x0":0.17031715137403697,"x1":0.8563558501724045,"top":0.6969424975854258,"bottom":0.7163726564776742,"conf":1},{"text":"olmayan vatandaşlarımızın, acil hastalık ve/veya yaralanma hallerinde Sağlık Bakanlığına bağlı 112","x0":0.17242488260121586,"x1":0.856323291760829,"top":0.7121285926337722,"bottom":0.7284291127563328,"conf":1},{"text":"Acil Sağlık Hizmetleri kapsamunda verilen hastane öncesi acil tibbi yardun ve ambulans","x0":0.1724845876631651,"x1":0.8562628453906439,"top":0.7267441861959023,"bottom":0.7414529912801308,"conf":1},{"text":"hızmetlerıden ücretsız yararlanmaları sağlaumştu.","x0":0.1704312166809059,"x1":0.5174537933416525,"top":0.7412790699139716,"bottom":0.7559829061104798,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.22381930416925203,"x1":0.4681724820713076,"top":0.754273504020918,"bottom":0.7688953486794028,"conf":1},{"text":"Prof. Dr. Recep AKDAG","x0":0.6423521069504152,"x1":0.8259845482208676,"top":0.8180615667706875,"bottom":0.8392029703275764,"conf":1},{"text":"Bakan","x0":0.716463883956899,"x1":0.7701890931296195,"top":0.8339880851047666,"bottom":0.8491514496781883,"conf":1},{"text":"DAĞITIM:","x0":0.1724578859671204,"x1":0.25259344822268454,"top":0.8749180318009615,"bottom":0.888163363328802,"conf":1},{"text":"81 II Valiligine","x0":0.17043121121022797,"x1":0.27720739219252943,"top":0.8909883719531982,"bottom":0.9026162791763699,"conf":1},{"text":"357","x0":0.8952772069769633,"x1":0.9301848051380265,"top":0.9433139536627608,"bottom":0.956395348575611,"conf":1}]}