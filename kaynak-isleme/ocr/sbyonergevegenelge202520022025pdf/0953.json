{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45167286379218086,"x1":0.9610407639348275,"top":0.03926376737701709,"bottom":0.05536876225684573,"conf":1},{"text":"Sorumluluk","x0":0.2523221562318479,"x1":0.3492320632488096,"top":0.2476087534669622,"bottom":0.26216439112001966,"conf":1},{"text":"MADDE 17 - (1) Malf ve idari karar ve işlemlere ilişkin her türlü kayıt, bilgi ve","x0":0.2524068646566088,"x1":0.8297214698159762,"top":0.26020170635914763,"bottom":0.2799442278244817,"conf":1},{"text":"belgeler, yetkililerce düzenli olarak kanunl süresince muhafaza edilir.","x0":0.20114874119242396,"x1":0.6879578778379613,"top":0.2787836298924943,"bottom":0.2967831224399452,"conf":1},{"text":"(2) Mali iş ve işlemlerin hazırlanması, uygulanması, sonuç andınimas,","x0":0.2525036026355811,"x1":0.8275921958660073,"top":0.2949635116408429,"bottom":0.3136749595603787,"conf":1},{"text":"muhasebelestirilmesi, raporlanmast işlemlerine ait bilgi ve belgeleri denetimle","x0":0.20319912727665787,"x1":0.8296489151960955,"top":0.30994558596591193,"bottom":0.32741349718897295,"conf":1},{"text":"görevlendirilmiş olanlara ibraz etımek, görevin sağhıklı yepımasını sağlayacak önlemleri","x0":0.2011283800194629,"x1":0.8317205140269827,"top":0.32671535700213594,"bottom":0.34553444866859395,"conf":1},{"text":"simak ve her türlül yardım ve kolaylığı göstermek zorunludur.","x0":0.2010742540416672,"x1":0.6325753173966022,"top":0.34305174237577185,"bottom":0.36142909209887053,"conf":1},{"text":"(3) Bakanlık merkez teşkilatındaki yetkililer, Ek-1 Sayılt Merkez Teşkilatı","x0":0.2504195897155345,"x1":0.8317225877151757,"top":0.358382753531475,"bottom":0.37643633979032254,"conf":1},{"text":"Cetveli'nde yer elan belgeleri; taşra teşkilatmdaki yetkililer ise Ek-ll Sayıli Taşta","x0":0.20111265397209105,"x1":0.8317338663974614,"top":0.37468426923256737,"bottom":0.3934527786653681,"conf":1},{"text":"Teşkilatı Cetveli'nde yer alan belgeleri doldurup suresinde ilgili mercileie sunmakla","x0":0.20114864054653997,"x1":0.8317530258671642,"top":0.39155081650355616,"bottom":0.41205501971306635,"conf":1},{"text":"yükümlüdir.","x0":0.20118519977977264,"x1":0.2957347178898703,"top":0.41116659635330366,"bottom":0.4245892175667765,"conf":0.5},{"text":"(4) Kamu kaynaklarının kullamılmasında veya yönetiminde kamu zararına","x0":0.2504339365243531,"x1":0.8317228012320692,"top":0.4237284674739168,"bottom":0.4408777895272229,"conf":1},{"text":"sebebiyet verilmesi hälinde sorumlu ve ilgililer hakkında idarf, malf ve cezai hükümlcı","x0":0.20123203732027575,"x1":0.8316221722677515,"top":0.4404069764147327,"bottom":0.4564102566305259,"conf":1},{"text":"uygulanacaktir.","x0":0.2011545018426992,"x1":0.3183526848401202,"top":0.45898459728905117,"bottom":0.47415493754178883,"conf":1},{"text":"Hükum Bulunmayan Häller","x0":0.2523863630809615,"x1":0.4663395680835121,"top":0.49084331850294216,"bottom":0.5070669374260316,"conf":1},{"text":"MADDE 18 -(1) Bu Yönergede yer almayan hususlerda yürürltikte bulunan","x0":0.25242668503627136,"x1":0.8338318634153901,"top":0.5040292170634018,"bottom":0.5234467124648983,"conf":1},{"text":"mevzuat hükümleri uygulanır.","x0":0.20123203424817118,"x1":0.41889116921099806,"top":0.5230769227077642,"bottom":0.5377906974948192,"conf":1},{"text":"(2) Bu Yönergenin uygulanmasında ortaya çıkan tereddütler gidermeye Genel","x0":0.2503571214261799,"x1":0.8338997849265957,"top":0.5351544928378652,"bottom":0.5561950009125034,"conf":1},{"text":"Müdürlük yetkilidir.","x0":0.2007679656963115,"x1":0.3517454175235579,"top":0.5526113474899003,"bottom":0.5714226483707888,"conf":1},{"text":"Yürürlük","x0":0.25459612517828184,"x1":0.3326728671821597,"top":0.5885911066743165,"bottom":0.60181586981096,"conf":1},{"text":"MADDE 19-(1) Bu Yönerge Bakan Onayına müteakip yürürluge girer.","x0":0.25243117641418916,"x1":0.7639909176546478,"top":0.601579048082439,"bottom":0.6203674738214339,"conf":1},{"text":"Yürütme","x0":0.25462012347124174,"x1":0.328542092791592,"top":0.6366279070639238,"bottom":0.6497093019767739,"conf":1},{"text":"MADDE 20 -(1) Bu Yönerge hükümlerini Sağlık Bakam yürmur.","x0":0.2544084863985018,"x1":0.7229538673287278,"top":0.6466263829335068,"bottom":0.6693242881234774,"conf":1},{"text":"Ekler:","x0":0.20533880878419875,"x1":0.2587268992753495,"top":0.7500000003929276,"bottom":0.7659883715002409,"conf":1},{"text":"Ek-I Sayılı Merkez Teskilatı Cetveli","x0":0.20533880849821176,"x1":0.46611909684393615,"top":0.7645299148450756,"bottom":0.7820512823664432,"conf":1},{"text":"Ek-II Sayılı Taşra Teşkilatı Cetveli","x0":0.20328541817229412,"x1":0.4579055470206825,"top":0.7790598291921959,"bottom":0.7979651158996256,"conf":1},{"text":"939","x0":0.8932238196761934,"x1":0.9301848043363685,"top":0.9433139533309585,"bottom":0.9549418605541302,"conf":1}]}