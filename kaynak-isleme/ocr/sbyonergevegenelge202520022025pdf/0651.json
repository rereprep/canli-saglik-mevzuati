{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397633646,"x1":0.9609856316731131,"top":0.040598290285678074,"bottom":0.05523255797856996,"conf":1},{"text":"Kan yoluyla bulaşan hastalıklarım kontrol altına alınması, kişiden kişiye bulaşmasının","x0":0.27303485549826445,"x1":0.8008850792101939,"top":0.26158865370984274,"bottom":0.2750628157219266,"conf":1},{"text":"bu tür hizmet veren yerlerde çalşan personelin konu ile ilgili olarak","x0":0.29561503151524016,"x1":0.800886454190856,"top":0.2744280737154472,"bottom":0.2890955912226253,"conf":1},{"text":"bilgilendirilmesi ve bu tür yerlerden hizmet alan kişilerin bilinçlendirilmesi için konu ile ilgili","x0":0.22587269110938007,"x1":0.8008213536792863,"top":0.28760683756404815,"bottom":0.3023255812388237,"conf":1},{"text":"gereken hassasiyetin gösterilmesi özel bir önem arz etmektedir.","x0":0.22792607985369714,"x1":0.6139630368991174,"top":0.30085470097290257,"bottom":0.31250000011820167,"conf":1},{"text":"Komanun önemi dolayısıyla, bu tür yerlerde çalışan personelin kan yolu ile bulaşan","x0":0.27104723010374226,"x1":0.800821352791639,"top":0.31395348824592806,"bottom":0.3256410257897221,"conf":1},{"text":"hastalıklar ve bu tür hastalıklardan korunma konusunda eğitilmesi, bu tür yerlere giden","x0":0.22571139336308235,"x1":0.8009981109912754,"top":0.32378537462715307,"bottom":0.34230000943607664,"conf":1},{"text":"müşterilerin bilinçlendirilmesi ve bu tür yerlerin periyodik olarak mevzuata uygun şekilde","x0":0.22573057032240426,"x1":0.8009689100244524,"top":0.3362363908084467,"bottom":0.35518174243354683,"conf":1},{"text":"denetlenmesi hususunda gereken hassasiyetin gösterilmesini rica ederim.","x0":0.22364244655044122,"x1":0.6716278361953363,"top":0.3500185132935488,"bottom":0.3684740463782552,"conf":1},{"text":"Doç. Dr. Sefer AYCAN","x0":0.5811088325468802,"x1":0.7310061576866927,"top":0.402564102665393,"bottom":0.4158119659132562,"conf":1},{"text":"Bakan a.","x0":0.6236706503470336,"x1":0.6842751701737912,"top":0.4165059397581006,"bottom":0.4302634628627764,"conf":1},{"text":"Müsteşar","x0":0.6233235996503423,"x1":0.6865484567085157,"top":0.4288640420774924,"bottom":0.44419051919348207,"conf":1},{"text":"Dagitim:","x0":0.22176591446012098,"x1":0.2833675555604129,"top":0.4404069769403771,"bottom":0.4534883718532272,"conf":1},{"text":"A Plani","x0":0.22381930085020468,"x1":0.2751540048422434,"top":0.4520348839025866,"bottom":0.4651162788154367,"conf":1},{"text":"637","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139536654862,"bottom":0.9563953485783364,"conf":1}]}