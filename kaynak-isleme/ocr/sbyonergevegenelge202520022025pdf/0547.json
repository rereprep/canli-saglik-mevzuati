{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397633646,"x1":0.9609856316731131,"top":0.040598290285678074,"bottom":0.05523255797856996,"conf":1},{"text":"Dermal kapiler endotel hücrelerinde, viruse karşı oluşan bağışıklık yanıtı","x0":0.21971251915617018,"x1":0.7268993903538349,"top":0.25128205136307813,"bottom":0.26453488390621493,"conf":1},{"text":"makülopapüler doküntu ve enantem (Koplik lekeleri) meydana gelir. Şekil l'de kızamık","x0":0.21958857022035472,"x1":0.8214675747760719,"top":0.2623550292084835,"bottom":0.280297407260763,"conf":1},{"text":"hastalığının klinik ozelliklerinin hastalığın günlerine göre görülme durumu verilmiştir.","x0":0.21759358731292736,"x1":0.747486569878866,"top":0.27545493430121004,"bottom":0.29085424360625445,"conf":1},{"text":"Şekil 1. Kızamık Hastalığının Klinik Ozelliklerinin Hastalığın Günlerine Göre Görülme Durumu","x0":0.21971253253818007,"x1":0.8090349006018704,"top":0.3008547009078524,"bottom":0.3141025641557156,"conf":1},{"text":"Hastalığın günleri (kızamık)","x0":0.3939736693424131,"x1":0.5670089092851183,"top":0.32425919383454227,"bottom":0.33988813976391463,"conf":1},{"text":"40º0 1 2","x0":0.34828385697054387,"x1":0.4394408868478064,"top":0.3417988340806124,"bottom":0.35383715545340255,"conf":1},{"text":"3456 7 8","x0":0.4394250554369347,"x1":0.613963037016864,"top":0.34011627888571927,"bottom":0.3504273505750316,"conf":0.5},{"text":"9 10","x0":0.6180698142300244,"x1":0.6694045182220631,"top":0.34145299157396447,"bottom":0.35174418608218283,"conf":1},{"text":"39°C","x0":0.3470225876493785,"x1":0.38398357230955366,"top":0.3604651161939396,"bottom":0.3706395349123266,"conf":0.5},{"text":"38ºC","x0":0.3470225869228613,"x1":0.3880903491939537,"top":0.37354651154277674,"bottom":0.3837209302611637,"conf":0.30000001192092896},{"text":"3Z:C","x0":0.3470225876493785,"x1":0.38398357230955366,"top":0.3866279068916141,"bottom":0.39680232561000095,"conf":0.5},{"text":"10-12 gunlük","x0":0.23613962982336348,"x1":0.31827515436554815,"top":0.5421511627887008,"bottom":0.550872093002303,"conf":1},{"text":"inkübasyon dönemi","x0":0.23613963267436044,"x1":0.3613963013740563,"top":0.5508547010308731,"bottom":0.5611111112872833,"conf":0.5},{"text":"Prodromal","x0":0.37987679678862174,"x1":0.45174537960986005,"top":0.5465116279032411,"bottom":0.5552325581168434,"conf":0.5},{"text":"dönem","x0":0.38397277662794177,"x1":0.4312222950258715,"top":0.5566509269030632,"bottom":0.5639886079479434,"conf":1},{"text":"Dokunta donemi","x0":0.47638603838276944,"x1":0.5872689923632949,"top":0.5478632479624487,"bottom":0.5568376069368076,"conf":1},{"text":"Ates","x0":0.6878850097633,"x1":0.7166324438143339,"top":0.39825581400136056,"bottom":0.405523255710178,"conf":1},{"text":"Döküntü","x0":0.6735112942524598,"x1":0.7289527712427225,"top":0.4171511627834046,"bottom":0.4258720929970068,"conf":1},{"text":"Koplik lekeleri","x0":0.6384901388209642,"x1":0.7290663291467369,"top":0.44285706917867873,"bottom":0.4553987447463057,"conf":1},{"text":"Konjunkdvit","x0":0.6344731817548046,"x1":0.7166561801352697,"top":0.4679391472038994,"bottom":0.4797352711649976,"conf":0.5},{"text":"Nezle belirtileri","x0":0.6283367568301078,"x1":0.7268993825905748,"top":0.49700854720623866,"bottom":0.5072674419065092,"conf":1},{"text":"Oksürük","x0":0.6673511299853614,"x1":0.7227926069756241,"top":0.5218023255747235,"bottom":0.5305232557883257,"conf":1},{"text":"İyileşme dönemi","x0":0.6427104742773271,"x1":0.7474332595351301,"top":0.5465116280880884,"bottom":0.5568376068481148,"conf":1},{"text":"Bildirilen kızamık vakalarının yaklaşık 630 unda bir ya da daha fazla komplikasyon","x0":0.26283367044605604,"x1":0.8213552410230665,"top":0.598717948876193,"bottom":0.6119658121240563,"conf":1},{"text":"gelişmektedir. Bir yaş altı çocuklarda ve erişkinlerde ciddi komplikasyon riski daha yüksektir","x0":0.22176592297697362,"x1":0.8172484505379999,"top":0.6119186045258651,"bottom":0.6235465117490367,"conf":1},{"text":"Gelişmekte olan ülkelerde görülen komplikasyonlar şunlardır: Pnömoni (%1-6), diyare (%6), otitis","x0":0.22176592821113453,"x1":0.8213552287703849,"top":0.6235042736914413,"bottom":0.6367521369393045,"conf":1},{"text":"media (%7-9), körlük ve post enfeksiyóz ensefalit (1000 vakada 1), ölum (%3-6).","x0":0.22176592011190255,"x1":0.7145790489142378,"top":0.6366279068502643,"bottom":0.648290598325244,"conf":1},{"text":"Daha az rastlanan (100.000 vakada 1) ancak çok ciddi bir diğer komplikasyon ise subakut","x0":0.2628336704914212,"x1":0.8213552410684315,"top":0.6613372091094792,"bottom":0.6744186048374357,"conf":1},{"text":"sklerozan panensefalit (SSPE) dir. SSPE, santral sinir sisteminin kalıcı kızamık virus enfeksiyonu","x0":0.2197125187894962,"x1":0.821355242749404,"top":0.6729651160834539,"bottom":0.6860465118114103,"conf":1},{"text":"nedeni ile oluşan ilerleyici kronik ensefalittir. Genellikle,","x0":0.21971253072880925,"x1":0.6139630337706774,"top":0.6858974358364801,"bottom":0.6991452990843434,"conf":1},{"text":"gorülmektedir. SSPE hastalarında molekuler tanı yöntemleri ile yapılan incelemelerde de vahşi","x0":0.2196523752013136,"x1":0.8214128150913529,"top":0.6971357364972502,"bottom":0.712234694634958,"conf":1},{"text":"kızamık virusu suşları gösterilmiştir. SSPE isidansının kızamık enfeksiyonunun yaşamın erken","x0":0.21971251882511314,"x1":0.8213552427850209,"top":0.7106837608139935,"bottom":0.7239316240618567,"conf":1},{"text":"dönemlerinde geçirilmesiyle yükseldiği bilinmektedir. Aşılanma oranı yüksek olan ülkelerde, tüm","x0":0.21964421003780515,"x1":0.82140804487003,"top":0.7209992538845708,"bottom":0.7372130018709323,"conf":1},{"text":"nüfusta SSPE insidansı milyonda 1, kızamık hastalığının endemik olduğu aşılanma oranı düşük","x0":0.22176590611813746,"x1":0.8213552435789333,"top":0.7354651161538017,"bottom":0.7470930233769734,"conf":1},{"text":"olan ülkelerde ise milyonda 20-100 olarak bildirilmektedir. DSO Aşı Güvenliği Küresel Danışma","x0":0.21971251910123393,"x1":0.8213552430611418,"top":0.7470085470592143,"bottom":0.7602564103070776,"conf":1},{"text":"Komitesi (GACVS) tarafindan SSPE hastalığına kızamık aşısının neden olmadığı açıklanmıştır.","x0":0.21971253010072686,"x1":0.8028747386670811,"top":0.7601744184125564,"bottom":0.7732558141405128,"conf":1},{"text":"533","x0":0.8950975264276583,"x1":0.9303644856768388,"top":0.9430401856275669,"bottom":0.955215628249825,"conf":1}]}