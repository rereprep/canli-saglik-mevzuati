{"lines":[{"text":"1006","x0":0.05954825551060192,"x1":0.10882956839083545,"top":0.029069767529040003,"bottom":0.04215116244189021,"conf":1},{"text":"T.C.","x0":0.5112936356509227,"x1":0.5503080068102097,"top":0.23255813915553114,"bottom":0.248546511893057,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4537987645420657,"x1":0.611909654129099,"top":0.24401709421418927,"bottom":0.26025641045350545,"conf":1},{"text":"Yönetim Hizmetleri Genel Müdürlügü","x0":0.40657083737265914,"x1":0.6570841932228235,"top":0.25854700823705135,"bottom":0.27478632447636764,"conf":1},{"text":"TC Soga Quartg","x0":0.22378592976693115,"x1":0.3100949729777553,"top":0.27023834278583514,"bottom":0.2835407264532186,"conf":0.30000001192092896},{"text":"Say1 : 82040698/","x0":0.22963765164214528,"x1":0.3576946771502648,"top":0.3056785783593592,"bottom":0.3209351633745501,"conf":1},{"text":"Konu : Mal Bildirimleri","x0":0.2299794642647444,"x1":0.3921971268500017,"top":0.31965811967669944,"bottom":0.331395348950569,"conf":1},{"text":"4) Her türlü kara, deniz ve hava taşıt araçları, traktör, biçer-döver, harman makinası ve","x0":0.27926078904774654,"x1":0.8254620037285393,"top":0.34572649607734174,"bottom":0.36046511611810494,"conf":1},{"text":"diğer ziraat makinalan, inşeat ve iş makinalan, hayvanlar, koleksiyon ve ev eşyalan ile diğer","x0":0.23408625002416394,"x1":0.8254620045869663,"top":0.3589743590169746,"bottom":0.3722222222648379,"conf":1},{"text":"taşınır mallar,","x0":0.23203285555359138,"x1":0.3305954813140584,"top":0.3735042734608973,"bottom":0.3851744186750108,"conf":1},{"text":"6) Alacaklari,","x0":0.27515400288874636,"x1":0.3675564691518774,"top":0.399572649623282,"bottom":0.411538461589094,"conf":1},{"text":"7) Borçlan,","x0":0.2765973596818331,"x1":0.35377009223684885,"top":0.41080861244811406,"bottom":0.425252354760032,"conf":1},{"text":"Mal bildirimine konu teşkil etmektedir.","x0":0.27720739709085856,"x1":0.5277207344902503,"top":0.43589743582421625,"bottom":0.44914529907207956,"conf":1},{"text":"Mallar, mal bildirimi tarihindeki değerleri esas alınmak suretiyle beyan edilecektir. Mal","x0":0.277135304133174,"x1":0.8255480653370736,"top":0.44763551502003074,"bottom":0.46446083885848477,"conf":1},{"text":"bildirimlerinde (b) bendinde belirtilen mal, hak, alacak, borç ve gelirlerin ayrı ayn toplam","x0":0.23203286353254612,"x1":0.8275153910935724,"top":0.4622093024719245,"bottom":0.47692307725897953,"conf":1},{"text":"degerleri gösterilecektir.","x0":0.23181761783241486,"x1":0.3903091284104643,"top":0.4750747784946173,"bottom":0.4891308848011662,"conf":1},{"text":"Mal bildiriminde bulunmakla yükümlü personel, eşinin 3628 sayılı Kanun kapsamında","x0":0.2751539974567914,"x1":0.8295687950355777,"top":0.48675213680468343,"bottom":0.5029914530439997,"conf":1},{"text":"olmast halinde, her birinin ayrı ayn mal bildiriminde bulunması ve eşlerden her birinin, eși ile","x0":0.2299794823281776,"x1":0.8295687828874279,"top":0.4985465119608782,"bottom":0.5145348830681916,"conf":1},{"text":"velayeti altındaki çocuklarına ait malları da ayrıca bildirecektir.","x0":0.22987405211754156,"x1":0.6345771024288134,"top":0.511183932862703,"bottom":0.527753504072472,"conf":1},{"text":"3. Mal Bildiriminin Verilme Zamanı","x0":0.2751539995697843,"x1":0.5256673554199487,"top":0.5392441858504113,"bottom":0.5523255815783676,"conf":1},{"text":"Mal bildirimlerinin;","x0":0.2772073913912277,"x1":0.4065708423145339,"top":0.5521367521101743,"bottom":0.5641025640759862,"conf":1},{"text":"a) 3628 sayılı Kanun kapsamında bir göreve ilk defa veya yeniden atanmada, atamaya","x0":0.2751539974881828,"x1":0.8295687950669691,"top":0.5639534885175291,"bottom":0.578632478645223,"conf":1},{"text":"esas belgelerle birlikte,","x0":0.23203285223573883,"x1":0.3819301866009378,"top":0.5784883718908854,"bottom":0.5915697676188418,"conf":1},{"text":"b) Görevin sona ermesi halinde, görevden ayrılma tarihini izleyen bir ay içinde,","x0":0.2792607941714501,"x1":0.7802874689702334,"top":0.588461538488368,"bottom":0.6031976740852709,"conf":1},{"text":"ç) Mal varlığıda önemli bir değişiklik olduğunda bir ay içinde (Ek Mal Bildirimi),","x0":0.27926078099229495,"x1":0.8049281306819676,"top":0.600290697345668,"bottom":0.6162790700831938,"conf":1},{"text":"verilmesi zorunludur.","x0":0.2792607789365603,"x1":0.4188911715808129,"top":0.6162393161535175,"bottom":0.6264957264099277,"conf":1},{"text":"Sonu (0) ve (5) ile biten yılların en geç Şubat ayı sonuna kadar mal bildirimlerinin","x0":0.27720738480383506,"x1":0.8295687958835094,"top":0.6277777776585778,"bottom":0.6424418603080044,"conf":1},{"text":"yenilenmesi zorunludur.","x0":0.23182865839178618,"x1":0.3882091791582047,"top":0.641073836211661,"bottom":0.6541747651458725,"conf":1},{"text":"Mal bildiriminde bulunmakla yükümlü personelin eşleri, velayeti altındaki çocukları ve","x0":0.2751539968232152,"x1":0.8275154079028895,"top":0.6525641029682399,"bottom":0.668803419207556,"conf":1},{"text":"kendilerinin şahsi mal varlıklarında önemli bir değişiklik olduğunda, değişikliği izleyen bir ay","x0":0.22997945859876498,"x1":0.8295687960595608,"top":0.6656976745618018,"bottom":0.6803418800301345,"conf":1},{"text":"içinde yeni edindikleri mal, hak, gelir, alacak ve borçlara münhasır olmak üzere ek mal","x0":0.22997947698936866,"x1":0.8295687775486189,"top":0.6786324786198215,"bottom":0.6933139531913756,"conf":1},{"text":"bildirimi vermeleri zorunludur.","x0":0.23203285826391956,"x1":0.4332648827830777,"top":0.6918604649193704,"bottom":0.7051282049407744,"conf":1},{"text":"4. Birden Fazla Mal Bildirimi","x0":0.2751540005385203,"x1":0.48049281650667514,"top":0.7179487178188975,"bottom":0.7311965810667608,"conf":1},{"text":"Asli görevleri ile beraber ikinci bir görevi yürütenler sadece asli görevlerinden dolayı","x0":0.27712581918662427,"x1":0.8296469770567497,"top":0.7282049409232385,"bottom":0.7446608651285295,"conf":1},{"text":"tek mal bildirimi verecekler.","x0":0.22973911249473664,"x1":0.41913950518622317,"top":0.7416189293900197,"bottom":0.7565885285351102,"conf":1},{"text":"5. Mal Bildiriminin Doldurulması","x0":0.27720738972977216,"x1":0.5092402486371558,"top":0.7688034189870457,"bottom":0.7805232559312346,"conf":1},{"text":"Ilgililerce, Mal Bildiriminde Bulunulması Hakkında Yönetmeliğin ekinde yer alan","x0":0.2772073847058003,"x1":0.8295687957854746,"top":0.7803418801495989,"bottom":0.7950581393805142,"conf":1},{"text":"\"Mal Bildirim Formu\" düzenlenmek suretiyle mal bildirimi verilecektir","x0":0.23203284622494458,"x1":0.6878850180432639,"top":0.7935897435586303,"bottom":0.8052325582600693,"conf":1},{"text":"Mal bildiriminde yer alan \"Edinme Tarihi\" mutlaka gün, ay ve yıl olarak, \"Taşınmaz","x0":0.2751009140044284,"x1":0.8275935838814311,"top":0.8050142539465236,"bottom":0.8212208224770057,"conf":1},{"text":"Mal Bilgileri\" bölümünde yer alan adres bilgilerinde ada ve parsel numaraları mutlaka","x0":0.23203286338368712,"x1":0.8275153909447134,"top":0.8183139536350077,"bottom":0.8329059825218517,"conf":1},{"text":"belirtilecektir.","x0":0.23203285300073134,"x1":0.3244353192638624,"top":0.8328488370722459,"bottom":0.8444767442954175,"conf":1},{"text":"Ek mal bildirimlerinde, sadece ek mal bildirimi verilmesini gerektiren bilgiler beyan","x0":0.27515399740622415,"x1":0.8295687949850103,"top":0.8444444445935372,"bottom":0.8576923078414004,"conf":1},{"text":"edilecektir.","x0":0.2320328535550757,"x1":0.30800821398723116,"top":0.8575581393916217,"bottom":0.8691860466147934,"conf":1}]}