{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4516726354627411,"x1":0.9610501669087621,"top":0.03926382760953162,"bottom":0.055369371870974904,"conf":1},{"text":"üretilen barkod bilgisi orijinal belge üzerine eklenerek muhatap birime fiziksel olarak","x0":0.151950713430585,"x1":0.7577002103887168,"top":0.19615384632196942,"bottom":0.21075581379936037,"conf":1},{"text":"gönderilmek üzere birim evrak ve/veya evrak birimine ulaştırılır.","x0":0.1519507148318626,"x1":0.5708418927646203,"top":0.21220930213266764,"bottom":0.22529069786062395,"conf":1},{"text":"(3) Yasal zorunluluklar nedeniyle EBYS üzerinden gizli belge gönderilmemesi","x0":0.20739218913609023,"x1":0.7577002137166525,"top":0.2252136751627858,"bottom":0.23982558123072362,"conf":1},{"text":"istenildiği durumlarda aşağıdaki esaslara göre işlem tesis edilir:","x0":0.14989732355798635,"x1":0.560574955494296,"top":0.24127906957452805,"bottom":0.25436046530248446,"conf":1},{"text":"a) EBYS* de yalnızca üst veri bilgileri ile oluşturulan belge, belgeyi hazırlayan kişa","x0":0.20944557613260964,"x1":0.7577002142140599,"top":0.25581395363718085,"bottom":0.2705128201308624,"conf":1},{"text":"tarafindan belgenin üzerine tarih ile sayı bilgisi yazılıp kapalı zarfa konulduktan sonra, zarf","x0":0.15195071343493846,"x1":0.7577002103930703,"top":0.270348837358382,"bottom":0.2850427349643432,"conf":1},{"text":"üzerine tarih, sayı ve gideceği yer bilgileri yazılarak birim evrak ve/veya evrak birimine","x0":0.15195071343208932,"x1":0.7577002103902212,"top":0.28488372060505296,"bottom":0.3008720933425788,"conf":1},{"text":"Birim evrak ve evrak birimi gizli evrak usul ve esaslarına uygun bir şekilde","x0":0.22587269294537535,"x1":0.7577002021323841,"top":0.3153846152679012,"bottom":0.3299418603104902,"conf":1},{"text":"işlemleri gerçekleştirir.","x0":0.14989732716194062,"x1":0.30800821674897394,"top":0.32991453009290883,"bottom":0.34447674402321815,"conf":1},{"text":"Yürürlük","x0":0.2094280