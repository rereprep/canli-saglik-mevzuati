{"lines":[{"text":"512","x0":0.06981519537907781,"x1":0.10061601592922377,"top":0.030523255649211545,"bottom":0.042151162872383185,"conf":1},{"text":"6.3.14. Aşı Sonrası İstenmeyen Etkiler (ASİE) Genelgesi (2023/03)","x0":0.11909650669260073,"x1":0.8747433287905451,"top":0.11752136758923437,"bottom":0.13974358981145651,"conf":1},{"text":"T.C.","x0":0.49075975315252796,"x1":0.5256673513135911,"top":0.24563953471205757,"bottom":0.2572674419352292,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4373716673838924,"x1":0.587268992523705,"top":0.2558139535428481,"bottom":0.2688953484556983,"conf":1},{"text":"Halk Sagher Genel Müdurloga","x0":0.4147843959175137,"x1":0.6098562609393359,"top":0.2703488373522983,"bottom":0.2850427349582595,"conf":0.5},{"text":"TEE ISO EN","x0":0.6694045187719128,"x1":0.7145790540412291,"top":0.3110465117959673,"bottom":0.32267441820403264,"conf":1},{"text":"TC Net","x0":0.7449675995092723,"x1":0.7972813153413932,"top":0.30122476670247633,"bottom":0.31669430311698954,"conf":0.5},{"text":"CEANFIONT","x0":0.7433264885326587,"x1":0.7967145790238095,"top":0.3226744185973581,"bottom":0.33139534881096033,"conf":0.30000001192092896},{"text":"Sayı : E-21001706-010.06.02","x0":0.20923059196413502,"x1":0.410877943377848,"top":0.340298490428224,"bottom":0.35517565163354836,"conf":1},{"text":"Konu : Aşı Sonrası Istenmeyen Etkiler","x0":0.21149897562247794,"x1":0.45585215352453357,"top":0.35465116266224617,"bottom":0.3662790698854178,"conf":1},{"text":"(ASIE) Genelgesi","x0":0.2628336777067932,"x1":0.3757700181864307,"top":0.36752136757537246,"bottom":0.3808139536655908,"conf":1},{"text":"BAKANLIK MAKAMINA","x0":0.4106776210027571,"x1":0.5852156025826865,"top":0.41569767461842955,"bottom":0.42877906953127964,"conf":1},{"text":"Aşı Sonrası Istenmeyen Etki (ASIE) İzleme sistemi, Bakanlığımız tarafından yürütalen","x0":0.2566735135031635,"x1":0.7864476361910603,"top":0.45341880346303365,"bottom":0.46511627918982146,"conf":1},{"text":"bağışıklama programlarımın vazgeçilmez bir parçasıdır. Bu hizmetimiz her geçen gün aşılama hızlarımın,","x0":0.21149897456051558,"x1":0.7864476371304219,"top":0.46495726475599986,"bottom":0.4769230767218118,"conf":1},{"text":"aşıın kabul edilebilirliğinin ve hizmet kalitesinin artırılması için önem taşımaktadır. Bu sistemin temel","x0":0.21149897457425657,"x1":0.7864476371441629,"top":0.4767441859877022,"bottom":0.48691860470608905,"conf":1},{"text":"aması, meydana gelen istenmeyen olguları düzenli olarak izlemek, analiz etmek ve yorumlayarak","x0":0.21145735923588613,"x1":0.786514733758823,"top":0.48688847527604384,"bottom":0.5014714809366633,"conf":1},{"text":"aşılama programının iyileştirilmesini sağlamaktır.","x0":0.2114989714983886,"x1":0.49281314328600573,"top":0.49999999993892774,"bottom":0.5102564101953381,"conf":1},{"text":"Aşt sonrası istenmeyen etkilerin il ve ülke düzeyinde İzlenebilmesi için sağhık personelinin","x0":0.2566735135807357,"x1":0.7864476362686323,"top":0.5101744184771937,"bottom":0.5218023257003653,"conf":1},{"text":"bilgilerinin geliştirilmesi ve bu konuda sağlık personelinin yönlendirilmesi amacıyla hazırlanan Daimi","x0":0.21149897330094708,"x1":0.7864476358708534,"top":0.5203488372092727,"bottom":0.5334302321221228,"conf":1},{"text":"Genelge ekte gönderilmektedir.","x0":0.21149897783797672,"x1":0.39014373241613004,"top":0.5333333334786219,"bottom":0.5436046512132995,"conf":1},{"text":"Söz konusu Genelge ile Mart 2009 tarihinden sonra Çocukluk Dönemi Ulusal Aşı Takvimimize","x0":0.2566735135446178,"x1":0.7864476362325146,"top":0.5435897435577646,"bottom":0.5552325582592035,"conf":1},{"text":"eklenen Hepatit A ve Suçiçeği aşılarının uygulaması sonrasında beklenen istenmeyen etkiler ASIE","x0":0.2114606598275919,"x1":0.7865075912131534,"top":0.55517852528896,"bottom":0.568124780068091,"conf":1},{"text":"Izleme Sistemi kapsamına alanmış, ayrica ASIE vaka sınıflamasında uluslararası güncel rehberlere","x0":0.2135523618596769,"x1":0.7864476379304712,"top":0.5666666666174134,"bottom":0.5770348837759347,"conf":1},{"text":"uygun olarak hazs değişiklikler yapılmıştır. Bu Genelge ile 13.03.2009 taribli ve 2009/17-7943 sayıl","x0":0.2114989745763912,"x1":0.7864476371462975,"top":0.5784883720341759,"bottom":0.5886627907525629,"conf":1},{"text":"Daimi Genelge yararlakten kaldırılme olup. Ast Sonrası Istenmeyen Etki Izleme Sisteminin yeni","x0":0.21142931132933615,"x1":0.7885822139163411,"top":0.5872285532160245,"bottom":0.6015049468781757,"conf":1},{"text":"değniklikler doğrultusunda yürütülmesi hastalarımı olurlarmıza arz ederım","x0":0.21149897022301747,"x1":0.6324435346548871,"top":0.6002906975470221,"bottom":0.611965812056409,"conf":0.5},{"text":"dyen gorile arz ederte","x0":0.1942779767499983,"x1":0.39028854328614176,"top":0.65153902078649,"bottom":0.6824455545738831,"conf":0.30000001192092896},{"text":"/ /2023","x0":0.22990648050170195,"x1":0.3162947513307055,"top":0.6785030982906629,"bottom":0.6906829481924328,"conf":1},{"text":"Doç.Dr. Tolga TOLUNAY","x0":0.2153768525554428,"x1":0.3801512202696017,"top":0.6900148645161318,"bottom":0.7044567540915357,"conf":1},{"text":"Bakan Yardımcısı","x0":0.24229979293489307,"x1":0.3572895291390289,"top":0.703418803518408,"bottom":0.7136752137748184,"conf":1},{"text":"Prot Dr. Sedat RAKY GUSUZ","x0":0.605749492842613,"x1":0.7864476339198784,"top":0.6409883719513686,"bottom":0.6512820513110003,"conf":0.5},{"text":"Halk Sagla Gerdi Müdari","x0":0.6094905117804643,"x1":0.7847367262723212,"top":0.6475673609813921,"bottom":0.6671478686673876,"conf":1},{"text":"OLUR","x0":0.4681270087559096,"x1":0.5298196029404623,"top":0.751346000097053,"bottom":0.764642371948265,"conf":1},{"text":"Bakan","x0":0.4743326478322099,"x1":0.5195071877142194,"top":0.7892441858909982,"bottom":0.8008720931141698,"conf":1}]}