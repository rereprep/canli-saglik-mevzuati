{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453746313017,"x1":0.9630390188271905,"top":0.037606837732452325,"bottom":0.0568376069632216,"conf":1},{"text":"d)","x0":0.18685831594146715,"x1":0.20739219707701334,"top":0.21366279078485395,"bottom":0.22674418569770416,"conf":1},{"text":"Aletlerin şarj dunumunu kontrol eder, şarjı eksik olanların şarjını tamamlar.","x0":0.22381930101437278,"x1":0.7453798777058216,"top":0.21220930199517274,"bottom":0.22820512806427917,"conf":1},{"text":"Oksijen tüpünun doluluğunu kontrol eder. eğer boş ise doldurulması için nöbetçi hekime","x0":0.2340862500316802,"x1":0.8254620045944825,"top":0.23401162826019317,"bottom":0.2529914531740658,"conf":1},{"text":"bilgi verir.","x0":0.18474904228097874,"x1":0.2608361728817477,"top":0.2498530958749441,"bottom":0.26468178760202,"conf":1},{"text":"Hasta müdahale çantasının tıbbi malzeme eksikliklerini giderir. Eğer eksiklikleri","x0":0.22781188897752044,"x1":0.8276847041108147,"top":0.26848036700222955,"bottom":0.2916660562273856,"conf":1},{"text":"gideremiyorsa nöbetçi hekime bilgi verir.","x0":0.1868583118269307,"x1":0.46817248361454783,"top":0.28632478660088967,"bottom":0.3023255807426102,"conf":1},{"text":"g) Tıbbi aletlerin bakunı ve stenlızasyonunu yapar.","x0":0.18275154106643715,"x1":0.5667351116127454,"top":0.33284883722133696,"bottom":0.3504273502119135,"conf":1},{"text":"h)","x0":0.18480492870833828,"x1":0.20739219634299647,"top":0.3575581393470706,"bottom":0.3691860465702421,"conf":1},{"text":"Ambulansın hasta kabininin temizlik ve sterilizasyonunu yapar. Gerekirse temizlik","x0":0.22381929421229393,"x1":0.8234086316730898,"top":0.35598290575252745,"bottom":0.37222222199184374,"conf":1},{"text":"işınde nöbetçı sürücünün desteğını ahr.","x0":0.18480493078182994,"x1":0.4537987651240023,"top":0.37209302312750014,"bottom":0.3837606838977534,"conf":1},{"text":"Nobetçi sağhk personeli suttıculuk görevini de yapıyorsa nobetçi surtenınun","x0":0.23408624904839023,"x1":0.8234086171120806,"top":0.39230769201738713,"bottom":0.4085470082567033,"conf":1},{"text":"görevlerinden de sorumludur.","x0":0.1866501555335673,"x1":0.3902536025216927,"top":0.4061736000136822,"bottom":0.4230422565307761,"conf":1},{"text":"D","x0":0.18480492805124257,"x1":0.20123203272904483,"top":0.43168604662060983,"bottom":0.44476744153345993,"conf":1},{"text":"Nöbetçi hekimin bilgisi olmadan hiçbir şekilde istasyondan ayrılamaz.","x0":0.2238193065991872,"x1":0.7125256624032985,"top":0.4302325582873576,"bottom":0.4448717948679699,"conf":1},{"text":"İstasyon Nöbetçi Sürücüsünün Görevleri","x0":0.18466064550565067,"x1":0.4949539330850037,"top":0.47522885022956185,"bottom":0.49120662332536935,"conf":1},{"text":"Madde 15. 112 ambulans istasyonunun usulüne uygun planlama ve onay ile yayımlanmış nöbet","x0":0.1848049214211385,"x1":0.8254620257657198,"top":0.4970085467917954,"bottom":0.5132478630311116,"conf":1},{"text":"cetvelme görevlendırılmış göre sürücüdür.","x0":0.18685831760381608,"x1":0.47638603538788127,"top":0.5145299143643652,"bottom":0.5247863246207755,"conf":1},{"text":"a)","x0":0.18480492836219126,"x1":0.20944558480230802,"top":0.5348837210011308,"bottom":0.5494186044187657,"conf":1},{"text":"Nöbetı devır aluken programlı bir görevlendume olup olmadığı öğrenır.","x0":0.21765913581029211,"x1":0.7371663260026289,"top":0.5363247864832092,"bottom":0.5495726497310724,"conf":1},{"text":"b)","x0":0.18480492870833828,"x1":0.20739219634299647,"top":0.5595930230680007,"bottom":0.5712209302911724,"conf":1},{"text":"Nöbeti devir aluken bir önceki nöbetçi sürücüden araç ve teknik donanım ile ilgili","x0":0.23203286183672267,"x1":0.823408616399525,"top":0.5581196578517247,"bottom":0.5726744184504535,"conf":1},{"text":"herhangi bir sorun olup olmadığıu öğrenir, var ise nöbetçi hekim ile görüşerek sorunu çözer.","x0":0.1848049357860156,"x1":0.8151950707334914,"top":0.5726495725057985,"bottom":0.5872093019922477,"conf":1},{"text":"c)","x0":0.18685831634778988,"x1":0.20533880867787743,"top":0.5973837207343443,"bottom":0.609011627957516,"conf":0.5},{"text":"Nöbet devir tesliminde ve görev esnasmda uyulması gereken kurallar bölümünde","x0":0.23408624912928028,"x1":0.8234086171929706,"top":0.5957264960840818,"bottom":0.610465116124845,"conf":1},{"text":"nöbetçi sürücü için belirtilen esasları yerine getirir.","x0":0.18685832067031113,"x1":0.5338808973310578,"top":0.6102564103606383,"bottom":0.6235465111918901,"conf":1},{"text":"d)","x0":0.18685831634351197,"x1":0.20533880867359955,"top":0.6337209304199983,"bottom":0.6453488368280637,"conf":1},{"text":"Ambulansta olan arıza saptadığında nöbetçi hekıme ve istasyon sorumlu sürücüsüne","x0":0.2340862491319106,"x1":0.8234086171956009,"top":0.6337209300405489,"bottom":0.6470085468354937,"conf":1},{"text":"bilgi verir, önerilerini sunar, nöbetçi hekimin talimatları doğrultusunda hareket eder.","x0":0.18480492779836302,"x1":0.7556468173700454,"top":0.6482558141024244,"bottom":0.6628205124765939,"conf":1},{"text":"e)","x0":0.1848049279127197,"x1":0.2053388090482659,"top":0.6715116280432116,"bottom":0.6845930229560617,"conf":1},{"text":"Ambulansun yakıtmın kontrolünden sorumludur. Ambulansm yakıt miktarının 1/2","x0":0.2114989827224412,"x1":0.8069815102834675,"top":0.6700581392044752,"bottom":0.6860465119420011,"conf":1},{"text":"deponun altına inmeyecek şekilde takviyesini yapar.","x0":0.18891171185834715,"x1":0.5420944480164298,"top":0.6858974359021484,"bottom":0.6978632478679603,"conf":1},{"text":"D","x0":0.18685831648203485,"x1":0.20123203235437853,"top":0.7093023257688356,"bottom":0.7209302321769009,"conf":1},{"text":"Ambulansın dış kısmmın ve sürücü kabininin temizliğinden sorumludur ve bu temizlik","x0":0.22997947534138335,"x1":0.8254620029024096,"top":0.707692307613841,"bottom":0.722383720775942,"conf":1},{"text":"günlük olarak yapılu.","x0":0.18685831423994217,"x1":0.3367556486051412,"top":0.7238372091006536,"bottom":0.73691860482861,"conf":1},{"text":"g)","x0":0.18480492835078352,"x1":0.2094455847909003,"top":0.7441860461094347,"bottom":0.7601744188469606,"conf":0.5},{"text":"Sağlik personelıne hasta kabininin temizlenmesinde yardımcı olur.","x0":0.22580532690867522,"x1":0.6879499133633873,"top":0.7438923969853142,"bottom":0.7616038635870853,"conf":1},{"text":"h)","x0":0.18480492836011708,"x1":0.20944558480023384,"top":0.7674418605506963,"bottom":0.7819767439683312,"conf":1},{"text":"Sağlık personelinin olmadığı durumlarda; oksijen tupunun doluluğunu kontrol eder,","x0":0.2319725010964111,"x1":0.8255374767472953,"top":0.7659456809097641,"bottom":0.7834622751689121,"conf":1},{"text":"eğer boş ise doldurtmak veya değiştirmek için nöbetçi hekime bilgi verir.","x0":0.18480493607431284,"x1":0.681724837874872,"top":0.7819767443333162,"bottom":0.7965811962545672,"conf":1},{"text":"Nöbetçi hekimin bilgisi olmadan hiçbir şekilde istasyondan ayrılamaz.","x0":0.22587269388329906,"x1":0.7125256631882982,"top":0.8051282051247771,"bottom":0.8197674417053894,"conf":1},{"text":"Nöbet Devir-Teslim Esnasında Yapılacaklar","x0":0.18880419135374646,"x1":0.5052464203606049,"top":0.8493555898512527,"bottom":0.8624113798313667,"conf":1},{"text":"Madde 16. Merkez ve Istasyonlarda nöbet devır teslımı aşağıdakı kurallara göre yapılu.","x0":0.18480492128386372,"x1":0.7864476452437714,"top":0.8735042737860894,"bottom":0.888081395194666,"conf":1},{"text":"339","x0":0.8932238196822326,"x1":0.9301848043424078,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}