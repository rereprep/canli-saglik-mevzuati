arak","x0":0.24435317431381928,"x1":0.8418891252755031,"top":0.45042735026396163,"bottom":0.46367521351182495,"conf":1},{"text":"verem savaşı hizmetlerinde kullanılmak üzere tahsis edilen mülkiyeti derneklere ait binalarda.","x0":0.1930184911662094,"x1":0.8398357181065812,"top":0.46366279050564674,"bottom":0.4769230767879171,"conf":1},{"text":"5368 sayılı Verem savaşı Hakkıda Kanun ve 181 sayılı Kanun Hükmünde Karamame","x0":0.19096510535239952,"x1":0.8418891052909954,"top":0.4752136750546393,"bottom":0.4898255811225771,"conf":1},{"text":"çerçevesinde 20/12/2001 tarihli ve 8597 sayıhı Bakanlık makamınım Onayı ile yürürlüğe","x0":0.19096510465707123,"x1":0.8418891045956671,"top":0.4897435900062098,"bottom":0.504360464961868,"conf":1},{"text":"konulan Sağlık Hizmetlerinin Yürütülmesi Hakkında Yönergeye göre verem savaşı","x0":0.19089286539774689,"x1":0.8419581244525005,"top":0.501537523593846,"bottom":0.5178746110131439,"conf":1},{"text":"dispanserleri tarafından yürütülmektedir.","x0":0.19096508899795686,"x1":0.46817248778735,"top":0.5158119661284494,"bottom":0.530523255656538,"conf":1},{"text":"Sağlık Bakanıhğı Imza Yetkileri Yönergesinin \"Müsteşar Tarafindan Onaylanacak","x0":0.23811124644728196,"x1":0.8419567343624687,"top":0.5281962416164923,"bottom":0.5463128527059541,"conf":1},{"text":"İşlemler\" başlığı altında yer alan \"9.20 - Merkez ve taşra teşkilatında yer alan sağlik kurumu ve","x0":0.1908285391091652,"x1":0.841987970908024,"top":0.5420898220978422,"bottom":0.5605344563968352,"conf":1},{"text":"kuruluşların ve hizmet birimlerinin kurulması, yerinin ve adımın değiştirilmesine ilişkin","x0":0.19096510463159871,"x1":0.8418891045701946,"top":0.5566860466605537,"bottom":0.5713675212321078,"conf":1},{"text":"onayların\" Müsteşar tarafindan onaylanacağı ifade edilmiştir.","x0":0.1909650853821034,"x1":0.6016427173184131,"top":0.5696581199570105,"bottom":0.5843023254253432,"conf":1},{"text":"Bu kapsamda, verem savaşı dispanserlerinin açılması, kapanması, yer değiştirmesi ve","x0":0.23819301242522758,"x1":0.8418891228842474,"top":0.5841880339769232,"bottom":0.5988372091480825,"conf":1},{"text":"tahsisine ilişkin iş ve işlemler Verem Savaşı Dairesi Başkanlığımım izni olmadan ve makam onayı","x0":0.19096510427161092,"x1":0.8418891042102068,"top":0.5957264960749372,"bottom":0.6104651161157004,"conf":1},{"text":"alınmadan yapılmamahdır","x0":0.19096508930155506,"x1":0.3737166353287052,"top":0.6102564100955632,"bottom":0.624999999839153,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.24229979854268785,"x1":0.49075974944296746,"top":0.6235042737783771,"bottom":0.6380813951869537,"conf":1},{"text":"Prof. Dr. Nihat TOSUN","x0":0.6119096550775225,"x1":0.7885010231565638,"top":0.674358974684375,"bottom":0.6918803422057426,"conf":1},{"text":"Bakan a.","x0":0.6644783359829777,"x1":0.7359323437786506,"top":0.6884914385950099,"bottom":0.7068573996535369,"conf":1},{"text":"Müsteşar","x0":0.6610778880060116,"x1":0.735226013060626,"top":0.703223956969288,"bottom":0.7197411592324925,"conf":1},{"text":"DAĞITIM","x0":0.19096509397596356,"x1":0.26694044979542586,"top":0.7572674418909888,"bottom":0.7718023253086237,"conf":1},{"text":"Gereği:","x0":0.190915651852661,"x1":0.2464560111467728,"top":0.7716971860281954,"bottom":0.7849888604220693,"conf":1},{"text":"81 Il Valiliklerine","x0":0.19096509389588312,"x1":0.3141683760964669,"top":0.7848837207278481,"bottom":0.7979651164558045,"conf":1},{"text":"693","x0":0.8932238196822326,"x1":0.9301848043424078,"top":0.9433139536654862,"bottom":0.9563953485783364,"conf":1}]}