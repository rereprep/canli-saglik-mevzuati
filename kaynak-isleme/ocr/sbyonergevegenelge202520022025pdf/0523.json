{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4516658041254406,"x1":0.961048280378558,"top":0.03930748836228792,"bottom":0.056780782547045994,"conf":1},{"text":"6.3.12. Kot Giysilere Uygulanan Püskürtme İşleminde Kum","x0":0.13127786760355672,"x1":0.8009496977312773,"top":0.10358463782089478,"bottom":0.12663081101441076,"conf":1},{"text":"Kullanımının Yasaklanması Genelgesi (2009/24)","x0":0.13347021917813714,"x1":0.6878850167569234,"top":0.12936046513196875,"bottom":0.14700854662616158,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.44353182856325024,"x1":0.5893223807048388,"top":0.27307692319852883,"bottom":0.2863372094807992,"conf":1},{"text":"Temel Sağlk Hizmetleri Genel Müdürtiği","x0":0.3860369604464462,"x1":0.6468172487921706,"top":0.2863247864137983,"bottom":0.3008720928658404,"conf":1},{"text":"SaM: : B100TSH0100006-140-01/","x0":0.2318419772362825,"x1":0.4478435870293032,"top":0.3099928963952231,"bottom":0.32452732661378114,"conf":1},{"text":"Konu : Kat Giysilere Uygulanan Piskürtme Işleminde","x0":0.232032851125884,"x1":0.5338809063553939,"top":0.32264957274902106,"bottom":0.33589743599688426,"conf":1},{"text":"Kum Kullanımman Yasaklanmas","x0":0.27288111567549783,"x1":0.46018631241682567,"top":0.33225168898663715,"bottom":0.34624249224059356,"conf":1},{"text":"SANATT VE","x0":0.30970669006386786,"x1":0.43543040317413084,"top":0.3487607161328652,"bottom":0.36342682595154385,"conf":1},{"text":"TICARET","x0":0.4310404648825822,"x1":0.5363459716706953,"top":0.3488112396898173,"bottom":0.36298886366682637,"conf":1},{"text":"27.03.2009/9805","x0":0.6344969163241264,"x1":0.8398357322922813,"top":0.332848837047117,"bottom":0.3531976744838907,"conf":1},{"text":"BAKANLIĞINA","x0":0.5601881086753653,"x1":0.7069369109250015,"top":0.3495256380367555,"bottom":0.3669624725188019,"conf":1},{"text":"GENELGE","x0":0.4763477155695415,"x1":0.5503463293998865,"top":0.3676099680561442,"bottom":0.379483055164789,"conf":1},{"text":"2009/.2.4","x0":0.48254620144521676,"x1":0.5482546201564259,"top":0.3764534883783919,"bottom":0.39098837179602675,"conf":1},{"text":"Son yıllarda ålkemizde yepılan bazı tibbi araşama ve istatiştikder,, kot kumlara işinde ,","x0":0.27515400552937086,"x1":0.8028747417181555,"top":0.4011627905051418,"bottom":0.4142441862330982,"conf":1},{"text":"çalışanlarda Silikozis bastabığıın görime sıklığanda artış olduğunu göstermektedir. Basra yoluyla da","x0":0.23408623920590674,"x1":0.796714582781141,"top":0.41133720916793126,"bottom":0.4230769228856608,"conf":1},{"text":"sıkşo gündere gelen bu sağlık serami Bakanlığanız tarafından uaun süredir büstn detaylan ile","x0":0.23198230612426143,"x1":0.7906115185094829,"top":0.42261188429360375,"bottom":0.4346566979877018,"conf":1},{"text":"incclenmektedir. Bu şartlardı, hastalığım mämkün olduğunca erken teşłas ve todavisi, aytı ortum veyu","x0":0.22997946181841045,"x1":0.7905544188945327,"top":0.4345930231967905,"bottom":0.4448717946706018,"conf":1},{"text":"benzer koyullarda çaganların tespiti ve gerekli Unlemleria zamna geçmeden alomas amacıyla","x0":0.22997946183953408,"x1":0.7905544189156564,"top":0.44476744170495164,"bottom":0.45641025640639055,"conf":1},{"text":"Silikozis bastalığından kornamanın tek geçerli ve etkili yulu kişi ve çevre maruziyetinko","x0":0.2710039655166191,"x1":0.790605845074698,"top":0.4664904280121164,"bottom":0.4796571922633037,"conf":0.5},{"text":"engellenmcaıdir. Pek çok işkolanda hastalık riski bulunmasına karşılık, kumun püsürtme yönterni ile","x0":0.22992034976607076,"x1":0.7906197019520592,"top":0.477825566969279,"bottom":0.49109644351954596,"conf":1},{"text":"Kot beyazlatma (aşındırma, eskitase) işleminin kum püskürtülerek yapıkiığı işyerlerinın ve","x0":0.2689938388624958,"x1":0.7905544155539446,"top":0.499999999874442,"bottom":0.5116279070976136,"conf":1},{"text":"işçilerin nitelikleri dildkate alındığında bu işyerlerinde, işleme, uygulayan kişiye, ve çevreye yönelik","x0":0.22787692176266558,"x1":0.7906031651381001,"top":0.5101160933096713,"bottom":0.5232440919225562,"conf":1},{"text":"yeterli, etkıli ve sürdärlilebilir iş sağlığt ve güvenlidi tedbirleri ahınmam mümkın görünmemektedir.","x0":0.22787039019518895,"x1":0.7885449076410588,"top":0.5213393336490009,"bottom":0.5334559288601929,"conf":1},{"text":"Bir toplum seğlağa sorunu haline gelen bastalaa önlenmesi ve gerekli tedbirlerin alarasi zorunia","x0":0.2278690195468614,"x1":0.7906231604906908,"top":0.5317004336749757,"bottom":0.5452273941946196,"conf":1},{"text":"hale gelmiştir. Bu gerçevede, Bakanlığamuzca gündene ahnan püskärtme işlemiain kum","x0":0.2299337762279118,"x1":0.7865134767762983,"top":0.5433333677447968,"bottom":0.5572673434209828,"conf":1},{"text":"kullanılurak yapalması konusu, koruyucu sağlık hizmetleri kapsamında tüm yşinleriyle bilim kurulu","x0":0.22997946114614623,"x1":0.7885010317231566,"top":0.5551282053228948,"bottom":0.5654069767967059,"conf":1},{"text":"Bu çalışmalar neticesinde, bilim kurulu karanı, ulusleraramı sözleşmeler ve ulusal mevzuatmaz","x0":0.2710472253467794,"x1":0.7885010290400042,"top":0.5769230771005158,"bottom":0.5886627908182455,"conf":1},{"text":"baktıleri dikkate ahınarak; ducelikle her türlå kot giysi ve kumaşlara uygulanen püskürtme işlerinde","x0":0.22788666124904303,"x1":0.7885467870921695,"top":0.587159225307964,"bottom":0.6000678792356285,"conf":1},{"text":"kum (silis tozu) veya silika kristalleri içeren herhangi bir madde kallanılması yasaklanmıştır. Kumı","x0":0.2278692909601953,"x1":0.7885529230878026,"top":0.5977434533020227,"bottom":0.6108845914277113,"conf":1},{"text":"kullarlan diğer iş kolları ize, uygulanan yöntem, kristalize silika içeriği ve alman tedbirler yündeden","x0":0.2279260738462449,"x1":0.7885010309223672,"top":0.6102564102995958,"bottom":0.6206395349363845,"conf":1},{"text":"of. Dr. Nihat TOSUN","x0":0.6632443550129378,"x1":0.7864476372135216,"top":0.7076923076361105,"bottom":0.7209401708839737,"conf":1},{"text":"Bakan a.","x0":0.6753594857650321,"x1":0.7251945663004411,"top":0.720938754072256,"bottom":0.7305198088575688,"conf":1},{"text":"Müstegar","x0":0.6714579061617819,"x1":0.7268993831520446,"top":0.7325581393874452,"bottom":0.7441860466106168,"conf":0.5},{"text":"DAĞITIM:","x0":0.22176591306723628,"x1":0.29158110938936255,"top":0.7412790694088534,"bottom":0.7572674421463792,"conf":1},{"text":"Gereli","x0":0.22122064353033918,"x1":0.26953203157606875,"top":0.7547476711844302,"bottom":0.7685933480304046,"conf":1},{"text":"A Plan","x0":0.21971252613767503,"x1":0.2689938390179086,"top":0.765811965814633,"bottom":0.777777777780445,"conf":1},{"text":"Çalışma ve Sosyal Güvealik Bakalığı","x0":0.21971252781632788,"x1":0.43737166277915474,"top":0.7760683762042173,"bottom":0.7906976741942826,"conf":0.5},{"text":"Sanayi ve Ticaret Bakanlığı","x0":0.21948088666976653,"x1":0.3780361446676599,"top":0.7865644117315009,"bottom":0.802775233486413,"conf":1},{"text":"İçişleri Bakanlağt","x0":0.2196077918304865,"x1":0.3204332757130723,"top":0.7990046633321077,"bottom":0.8129139404737113,"conf":1},{"text":"509","x0":0.893223819688272,"x1":0.9301848043484472,"top":0.943313953667891,"bottom":0.956395348580741,"conf":1}]}