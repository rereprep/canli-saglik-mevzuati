{"lines":[{"text":"582","x0":0.06776180657270252,"x1":0.10266940473376567,"top":0.030523255654402504,"bottom":0.042151162877574255,"conf":1},{"text":"Rezerv stok miktarı; merkez depoda 3 aylık, bölge ve il depolarında 1 aylık, ilçe ve Sağlık","x0":0.24633218765300094,"x1":0.7947593773611894,"top":0.23782517612174847,"bottom":0.25381343311418636,"conf":1},{"text":"Ocağu/Aile Hekimliği depolarında 1 haftalık ihtiyacı karşılayacak şekilde planlanmalıdır.","x0":0.21344832883278347,"x1":0.7434238232544506,"top":0.25002068727414883,"bottom":0.26674564137388557,"conf":1},{"text":"Il depolarında merkez depodan nakliyat zamanı da hesaplanaruk rezerv stoğa ihtiyaç","x0":0.24636481272495048,"x1":0.7947145091875979,"top":0.26296375355152457,"bottom":0.27685708639970663,"conf":1},{"text":"duyulmadan önce yeni aşı talepleri yapılmalıdır. Rezerv stok aşıları diğer aşılardan ayrı bir yerde","x0":0.2155107247237256,"x1":0.7968178925980076,"top":0.27446351366942756,"bottom":0.29025021607817736,"conf":1},{"text":"tutulmamahdır. Rezerv stok için planlanan aşılar her bir sevkiyalla yenileri ile değiştirilmeli, daha","x0":0.21347807659533727,"x1":0.7967870426081283,"top":0.28764272246205,"bottom":0.3036511565946831,"conf":1},{"text":"Fire Yüzdesi:","x0":0.24640657266196447,"x1":0.3347022567014852,"top":0.32264957280599593,"bottom":0.3343023256904287,"conf":1},{"text":"Açılan aşıların kullanım sürelerinin sınırlı olması ve enjektörlerdeki ölü boşluklar vb.","x0":0.2463381886338288,"x1":0.7967797230059948,"top":0.33269210679397543,"bottom":0.34989257839489096,"conf":1},{"text":"nedenlerle çok dozlu flakonlardaki aşının tamamı kullanılamayabilir. Açılan flakonlardaki aşıdan","x0":0.21555250242811327,"x1":0.7967669367185645,"top":0.34555760325862694,"bottom":0.3592351840024002,"conf":1},{"text":"kullanılamayan miktanın açılan doza oranına fire payı denir. Bunun 100 ile çarpımı fire yüzdesini","x0":0.21555527215312204,"x1":0.7967880834132299,"top":0.35801196350091014,"bottom":0.37233627318416374,"conf":1},{"text":"verar.","x0":0.2156057490714192,"x1":0.2505133472324823,"top":0.37500000005159906,"bottom":0.3822674417604165,"conf":0.5},{"text":"Bir aşı flakonunun açılmadan änce kullanılamaz hale gelmesi (ömeğin kırılan flakonlar,","x0":0.2484599694354705,"x1":0.7967145706153753,"top":0.38372093008165886,"bottom":0.3953488373048306,"conf":1},{"text":"donmaya veya sıcağa maruz kalan aşılar, miadının dolması gibi nedenlerle aşının kullanılamaz","x0":0.21758119915876578,"x1":0.7967837611887876,"top":0.3956215258627942,"bottom":0.41007437046624307,"conf":1},{"text":"hale gelmesi) ise zayi olarak tanımlanmaktadır. Zayi öngbrülmeyen bir kayıp olduğundan ihtiyaç","x0":0.2156057531483582,"x1":0.7967145752156005,"top":0.4098290597125289,"bottom":0.4230769229603921,"conf":1},{"text":"planlamasında dikkate alınmaz.","x0":0.21528280361959234,"x1":0.40265604681081435,"top":0.42026398499299045,"bottom":0.4347611567047084,"conf":1},{"text":"Fire yüzdesi aşı cinsine, aşı seanslarının sıklığına ve yerleşim yerlerinin dağınıklığına göre","x0":0.2462858192696592,"x1":0.7968595718793365,"top":0.4322465328816958,"bottom":0.4503256205547852,"conf":1},{"text":"değişir. lIk ihtiyaç planlamasında il düzeyindeki fire yüzdeleri dikkate alımmalı ancak bu yüzdenin","x0":0.21760486463319506,"x1":0.7967636983318045,"top":0.44525395466214457,"bottom":0.4593667467179756,"conf":1},{"text":"kurum düzeyinde değişebileceği bilinmeli ve daha sonraki dönemlerde ihtiyaç planlamasında o","x0":0.2156057539665823,"x1":0.7987679625329366,"top":0.459302325388676,"bottom":0.4723837211166324,"conf":1},{"text":"kuruma ait fire yüzdeleri dikkate ahımalıdır.","x0":0.21560575133017545,"x1":0.4825461991732359,"top":0.47222222210321174,"bottom":0.48547008535107494,"conf":1},{"text":"Fire yüzdesini hesaplamak için aşağıdaki formül kullanılır:","x0":0.2463090253365508,"x1":0.599683538826575,"top":0.4834797778396105,"bottom":0.4987173790301612,"conf":1},{"text":"Fire yüzdesi -","x0":0.25440284959129134,"x1":0.3