törlerdeki ölü boşluklar","x0":0.5112936382192061,"x1":0.6878850062982476,"top":0.585755814040668,"bottom":0.5988372089535182,"conf":1},{"text":"Yanlış sulandırma","x0":0.5112936357612772,"x1":0.6221765897418027,"top":0.598717948857272,"bottom":0.6119658121051352,"conf":1},{"text":"Flakon kapaklarının ıslanması gibi nedenlerle","x0":0.5111612472172358,"x1":0.7865919472956442,"top":0.6101320199924201,"bottom":0.6262531181113896,"conf":1},{"text":"kontaminasyon şüphesi","x0":0.5112936339411213,"x1":0.6529774130844859,"top":0.6249999999356509,"bottom":0.6351744186540378,"conf":0.5},{"text":"Uygulama sırasında meydana gelen kazalar","x0":0.5132280627457715,"x1":0.7722058028478913,"top":0.6348672463166003,"bottom":0.6495132564301779,"conf":1},{"text":"Kullanım süresinin dolması","x0":0.5112936350264652,"x1":0.6796714571090585,"top":0.6482558138881418,"bottom":0.6585470083963602,"conf":1},{"text":"Soğuk zincirde kırılma vs.","x0":0.5112936318114426,"x1":0.671457907897588,"top":0.6598290600410687,"bottom":0.6744186044840524,"conf":1},{"text":"Maksimum Stok:","x0":0.248459960399665,"x1":0.36139630087930247,"top":0.6816239314641472,"bottom":0.6948717947120104,"conf":1},{"text":"Maksimum stok, yeni bir sevkiyat devresinin başında depoda bulunması gereken miktardaki","x0":0.24845994985122016,"x1":0.7967145879326702,"top":0.6931623931214645,"bottom":0.7094017093607807,"conf":1},{"text":"ași ve malzemeleri ifade eder.","x0":0.21538501055517983,"x1":0.3944354791752864,"top":0.705706464014894,"bottom":0.721097676869524,"conf":1},{"text":"Maksimum stok hesaplaması yapılırken fire payı ve rezerv stok da dikkate alınmalıdır.","x0":0.24640656907444133,"x1":0.7659137592667781,"top":0.7179487177559986,"bottom":0.7325581393800762,"conf":1},{"text":"Aşı ihtiyacının belirlenmesine yönelik bazı örnekler Ek-3'de yer almaktadır.","x0":0.2484599501560794,"x1":0.7022587354752866,"top":0.7311046513108406,"bottom":0.7457264959693254,"conf":1}]}