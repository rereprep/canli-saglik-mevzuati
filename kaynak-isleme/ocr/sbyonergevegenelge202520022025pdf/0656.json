f":1},{"text":"..YALILIGINE","x0":0.46611909897801335,"x1":0.5667351112375923,"top":0.382267441676417,"bottom":0.3924418603948039,"conf":1},{"text":"> Memleketinizde AIDS olguları saptanmamistır. AIDS'in görülduğu Amerika","x0":0.19675562980287045,"x1":0.8032250759136247,"top":0.425635239810742,"bottom":0.4513993236730467,"conf":1},{"text":"Birlegik Devletleri vo Avrupa Ulkeleri ile mikı ilişkileriais olması gedeniyle","x0":0.1928492566213565,"x1":0.8338481430803195,"top":0.44579720055401273,"bottom":0.46385943835063315,"conf":1},{"text":"uyanak bulunmamis gerekir.","x0":0.1907937245680408,"x1":0.40676756594807595,"top":0.4631789487433089,"bottom":0.4773897768886539,"conf":1},{"text":"AIDS yeni tarif edilnig bir sendrom olup etkeni henüz saptanmanıętar.","x0":0.22361613388487186,"x1":0.7928145393248092,"top":0.4798013838845674,"bottom":0.4982253299717443,"conf":1},{"text":"Mubtemel otken bir virus olarak düşünülnektedir. Çok yakın temas (cinsel) ve","x0":0.18876387648403217,"x1":0.8194108461881585,"top":0.49817898430525087,"bottom":0.5155816087778445,"conf":1},{"text":"Han ve kan ürünleri-küllanımı ile geçmektedir (Hepatit B benzeri).","x0":0.1887728948053689,"x1":0.7352674767728531,"top":0.5153166650995531,"bottom":0.5314693110909519,"conf":1},{"text":"Bu hastalik kiçinin hücresel direncini kırmaktadır. Burada bilhansa T len-","x0":0.22149336937434574,"x1":0.8318351160632439,"top":0.5303939843162983,"bottom":0.5504555514108892,"conf":1},{"text":"fosit subpopulagyonlari etkilennektedir. Bunun sonucunda da hastalarda non-","x0":0.18861818055507557,"x1":0.8072034741969096,"top":0.5459446296310623,"bottom":0.5671142008147478,"conf":1},{"text":"spesifik bulgular yanında halsizlik, sebepoig kilo kaybi, ateg, zaygan len-","x0":0.18864409002509533,"x1":0.8071779798140539,"top":0.5628458104754929,"bottom":0.5850551988497562,"conf":1},{"text":"fadenomegali, uzun süreli lehsl, öksürük, menenjit, prömoni, ansefalit, oral","x0":0.18861222554457768,"x1":0.8154068215051279,"top":0.5796569070929587,"bottom":0.6011455548799386,"conf":1},{"text":"ve intestinal kandidiazie, herpes zuster v.b. gibi ağır enfeksiyonlar oluşmakta","x0":0.18660112630023867,"x1":0.8380241827401194,"top":0.5969851122990589,"bottom":0.6187653219626457,"conf":1},{"text":"veya kaposi sarkoru, lenfona v.b. gibi malign olugumlar meydana çiksaktadar.","x0":0.1866727208637624,"x1":0.8133458369365405,"top":0.6153477381305064,"bottom":0.6336275343069929,"conf":1},{"text":"Progno: kötü olup yeterli bir tedavisi yoktur. Tartişmala olmakla beraber","x0":0.18455517608747485,"x1":0.7907659792658492,"top":0.6307974905175461,"bottom":0.6512309897804293,"conf":1},{"text":"kortikosteroidlerin kullanılması denenaektedir. Kosin tani için (etkene yönelik)","x0":0.1845568379019329,"x1":0.8441864290446173,"top":0.6461874512709278,"bottom":0.6679384352998011,"conf":1},{"text":"elinisda herhangi bir laboratuvar testi yoktur. Hücresel direncin laboratuvar","x0":0.18463023193360295,"x1":0.8194743834224179,"top":0.6649573997390305,"bottom":0.6825466541998135,"conf":1},{"text":"tostleri ile tanamiyle bozulduğu saptanır. Kulugka süresi uzun olup 6 ay ile","x0":0.1846381406995534,"x1":0.8112491883728076,"top":0.6813458316510034,"bottom":0.6998257673867222,"conf":1},{"text":"3 pil arasinda değismektedir. Portörlügü saptayacak bir laboratuvar testi de","x0":0.18457932171150815,"x1":0.8112612203521142,"top":0.6987242372110067,"bottom":0.7167508581247812,"conf":1},{"text":"yoktur. Anys nenleketlerinde ve Çin'de bugune kadar rastlanmamiętar. Genetik","x0":0.1825559437742139,"x1":0.811269641509817,"top":0.7143487557667076,"bottom":0.7340314981545281,"conf":1},{"text":"dispoziaron da duelndlnektedir.","x0":0.18045628712251408,"x1":0.4396455837849611,"top":0.7323661218953431,"bottom":0.7483108098283275,"conf":0.5},{"text":"(.6..)","x0":0.4496919920439523,"x1":0.5030800825351031,"top":0.7718023259143666,"bottom":0.78779069702168,"conf":0.5}]}