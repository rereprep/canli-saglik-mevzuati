{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453741355351,"x1":0.9609856318323118,"top":0.040598290632302914,"bottom":0.056837606871619095,"conf":1},{"text":"2.3.45. Acil Sağlık Hizmetlerinde Yeşil Alan Uygulaması","x0":0.11704311259299334,"x1":0.7618069899357987,"top":0.10170940160869735,"bottom":0.1235465113945109,"conf":1},{"text":"Genelgesi (2014/13)","x0":0.11909650589765362,"x1":0.34907597830592524,"top":0.12645348869851458,"bottom":0.14534883681539745,"conf":1},{"text":"26.03.2014 11:11","x0":0.6427104713659993,"x1":0.7002053394680672,"top":0.23974358984603938,"bottom":0.24871794882039833,"conf":1},{"text":": 010.56 02","x0":0.7535934295324562,"x1":0.7905544141926314,"top":0.23974358984115374,"bottom":0.24871794881551268,"conf":1},{"text":"TC Sofis Sakatd","x0":0.20944558603955638,"x1":0.28336755535990665,"top":0.2935897437463715,"bottom":0.3008720929334562,"conf":0.5},{"text":"T.C.","x0":0.47843942461043354,"x1":0.5133470227714967,"top":0.2587209303960458,"bottom":0.2718023253088959,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.41450212253173113,"x1":0.5732085108092024,"top":0.2701203037052866,"bottom":0.2878148487012384,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.3737166333519579,"x1":0.6139630382557896,"top":0.2863247859240612,"bottom":0.3023255816959942,"conf":1},{"text":"Sayı : 23642684/010.06.02 - 5409.13","x0":0.20278226960015758,"x1":0.5281975153113123,"top":0.3287137294666983,"bottom":0.35235625151238814,"conf":1},{"text":"Konu","x0":0.20323779434654962,"x1":0.2444008087319529,"top":0.35020638449494057,"bottom":0.362002917639378,"conf":1},{"text":"Acil Sağlık Hizmetlerinde Yeşil","x0":0.27926078439504015,"x1":0.48254619541331023,"top":0.35029069781973776,"bottom":0.36337209273258786,"conf":1},{"text":"Alan Uygulaması","x0":0.28336755776903455,"x1":0.39425051174956,"top":0.3662393160809967,"bottom":0.37790697685124996,"conf":1},{"text":"26.03.2014","x0":0.624229977856349,"x1":0.7515400422805433,"top":0.32412790716787854,"bottom":0.34593023229433084,"conf":1},{"text":"GENELGE","x0":0.4557003324276665,"x1":0.5299259507278219,"top":0.4282776981801799,"bottom":0.4409083483011026,"conf":1},{"text":"2014/13","x0":0.47008264363323626,"x1":0.5278639692076015,"top":0.4401468008310727,"bottom":0.45665552435903,"conf":1},{"text":"Ilgi: 27.01.2012 tarihli ve 3931 (2012/10) sayılı Genelge.","x0":0.1949626034412309,"x1":0.5380829523704366,"top":0.47522293430955376,"bottom":0.48992234692442516,"conf":1},{"text":"Bilindiği üzere, 21.01.2012 tarih ve 28180 sayılı Resmi Gazete'de yayımlanarak yürürlüğe giren","x0":0.23819302704413653,"x1":0.7843942417249294,"top":0.5115384616406258,"bottom":0.5218023256361697,"conf":1},{"text":"Sağlık Uygulama Tebliği'nde (SUT) Değişiklik Yapılmasına Dair Tebliğ ile acil servislerde yeşil alan","x0":0.19917864970232277,"x1":0.784394244767789,"top":0.521794871710973,"bottom":0.5334302326732784,"conf":1},{"text":"uygulaması kapsamında değerlendirilecek sağlık hizmetleri için katılım payı alınacağı hükme","x0":0.19917865079999084,"x1":0.7864476323645692,"top":0.5348837208714303,"bottom":0.5450581395898173,"conf":1},{"text":"bağlanmıştır. Bu kapsamda 520.021 Kodu ile tanımlanan \"Yeşil Alan Muayenesi\" uygulamasında","x0":0.1990953099625705,"x1":0.784505413074345,"top":0.542222443801126,"bottom":0.5585529101123282,"conf":1},{"text":"birlıginin saglanması bakımından uyulması gerekli esasların neler olduğu hususu 2012/10 sayılı","x0":0.19917865000320104,"x1":0.7843942450686673,"top":0.558119657984912,"bottom":0.5697674419816244,"conf":1},{"text":"Genelgemiz ile açıklanmıştır.","x0":0.20123203330107878,"x1":0.36960985538367214,"top":0.5683139533498586,"bottom":0.5799418605730302,"conf":1},{"text":"Bakanlığımızca; \"Yeşil Alan Muayenesi\" uygulamasında birliğin sağlanması amacıyla aşağıda","x0":0.2422998023923442,"x1":0.786447630574025,"top":0.5799145298243424,"bottom":0.5915697675601885,"conf":1},{"text":"belirtilen hususlara bir kez de iş bu genelge ile açıkhk getirilmesinde fayda görülmüştür.","x0":0.19917863657597265,"x1":0.7022587347754135,"top":0.5914529915251816,"bottom":0.6031976745381847,"conf":1},{"text":"Yataklı Sağlık Tesislerinde Acil Servis Hizmetlerinin Uygulama Usul ve Esasları Hakkında","x0":0.24229980242776472,"x1":0.7864476306094454,"top":0.6029914528184168,"bottom":0.6149572647842287,"conf":1},{"text":"Tebliği eki Ek-7' de sarı ve kırmızı renk kodlaması altında yer alan tıbbi durumların dışında kalan","x0":0.19917865076459657,"x1":0.7864476323291749,"top":0.6148255812694056,"bottom":0.6264957264835189,"conf":1},{"text":"işlemlerin tümü yeşil renk kodu kapsamında değerlendirilecek olup, bu işlemler için SUT' da yer alan","x0":0.2012320380819196,"x1":0.7864476331473859,"top":0.6264534882466082,"bottom":0.6380813954697798,"conf":1},{"text":"520.021 Kodu ile tanımlanan; Yeşil alan muayenesi girilecektir.","x0":0.19908585052492675,"x1":0.5627286618676943,"top":0.6363332288585418,"bottom":0.649241698572193,"conf":1},{"text":"Acil servislere başvuran tüm hastaların ilk müracaatta acil hasta olarak değerlendirilerek acil","x0":0.2422998016437055,"x1":0.7843942433262743,"top":0.649572649703407,"bottom":0.6598837209851661,"conf":1},{"text":"servisiere kabul edilmesi ve buna göre işiem yapılması esastır. Ancak yapılan muayenesi sonucunda","x0":0.1991786499612734,"x1":0.7843942450267397,"top":0.6613372091760679,"bottom":0.6730769228937975,"conf":1},{"text":"hekim değerlendirmesine göre yeşil alan muayenesi kapsamına girdiği belirlenen hastalar için 520.021","x0":0.19917865000061588,"x1":0.7843942450660821,"top":0.6729651162203719,"bottom":0.6833333333788932,"conf":1},{"text":"Kodu ile tanımlanan \"Yeşil Alan Muayenesi\", kodlama işleminin yapılması gerekmektedir. Bu","x0":0.19911008258691804,"x1":0.7844537629168002,"top":0.6826269973056298,"bottom":0.6966070468627859,"conf":1},{"text":"kodlama işlemi, hastanın acil servisteki işlemleri tamamlandıktan sonra yapılmalıdır.","x0":0.19910456094946977,"x1":0.6797388881841092,"top":0.693958305193073,"bottom":0.7066650226597697,"conf":1},{"text":"Ilgi sayılı Genelgenin yürürlükten kaldırıldığı ile uygulamanın yukarıda vurgulanan esaslara","x0":0.24229980163969153,"x1":0.7843942433222603,"top":0.7063953487117156,"bottom":0.7180232559348873,"conf":1},{"text":"uygun olarak yürütülmesi gerektiğinin, ilgili tüm sağlık kurum ve kuruluşlarına tebliğini önemle rica","x0":0.19912646317766963,"x1":0.784450585688439,"top":0.7155824451884255,"bottom":0.7299393501556438,"conf":1},{"text":"ederim.","x0":0.19913712481166732,"x1":0.2443947023964287,"top":0.729542771563743,"bottom":0.7384804841760582,"conf":1},{"text":"Prof. Dr. Nihat TOSUN","x0":0.6016427078514845,"x1":0.7618069839376298,"top":0.77307692326841,"bottom":0.7850427352342221,"conf":1},{"text":"Bakan a.","x0":0.6519684189849798,"x1":0.7133788870161377,"top":0.7857457898201372,"bottom":0.7998797110602672,"conf":1},{"text":"Müsteşar","x0":0.652614112422751,"x1":0.7168377882255516,"top":0.8014965775935934,"bottom":0.8124345503552204,"conf":1},{"text":"DAGITIM:","x0":0.19706982897647132,"x1":0.27110265515218407,"top":0.8152288440335512,"bottom":0.8272130162677196,"conf":1},{"text":"Gereği:","x0":0.19710161953507918,"x1":0.25259037201781515,"top":0.828423824971761,"bottom":0.838727337773233,"conf":1},{"text":"81 11 Valiligine","x0":0.19687195456484932,"x1":0.2857578695991884,"top":0.8378794970076927,"bottom":0.8498309626958928,"conf":1},{"text":"(Il Sağhk Müdürlüğü)","x0":0.19507186857061845,"x1":0.32648870599303664,"top":0.8502906975330362,"bottom":0.8619658120424231,"conf":1},{"text":"253","x0":0.8952772069769633,"x1":0.9301848051380265,"top":0.9433139536627608,"bottom":0.956395348575611,"conf":1}]}