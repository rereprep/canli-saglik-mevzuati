44308278141392676,"conf":1},{"text":"ile üniversite hastanelerinin bildirimleri Il Sağlık Müdürlüğü Verem Kontrol Biriminde","x0":0.1662746533447021,"x1":0.8357833048382406,"top":0.4402316101647491,"bottom":0.4574979309394469,"conf":1},{"text":"toplanarak, il içi hastalar ildeki Verem Savaşı Dispanserlerine, il dışı hastalar ise ilgili Il","x0":0.1662577901462567,"x1":0.8358106496912991,"top":0.4532421743281989,"bottom":0.4722935305215459,"conf":1},{"text":"Sağhk Müdürlüklerine bildirilecektir.","x0":0.1683778220712181,"x1":0.42710472391783044,"top":0.4694767443316379,"bottom":0.48418803385972664,"conf":1},{"text":"DGT uygulamasının başanh olabılmesi için ilaç, donamım, iletişim ve ulaşım araçları,","x0":0.21965195737879903,"x1":0.8316908799481385,"top":0.49842765982002923,"bottom":0.5131030080529833,"conf":1},{"text":"bılgısayar, basılı malzemeler vb. lojistik ve laboratuvar desteğinin kesintisiz olarak temin","x0":0.16832378685009713,"x1":0.8316918735669576,"top":0.5124848058658572,"bottom":0.5278446876663213,"conf":1},{"text":"gerektiğinden, bu hususlar Il Sağlık Müdürlüklerince takip edilecek ve eksikliklere mahal","x0":0.16837780512466616,"x1":0.835728970859249,"top":0.5276162792190858,"bottom":0.5423076923811868,"conf":1},{"text":"verilmeyecektir.","x0":0.1681592609053362,"x1":0.28356079068104567,"top":0.5411846615103102,"bottom":0.5553910685193371,"conf":1},{"text":"Sağlık Bakanlığı verem kontrol politikasına uygun olarak il düzeyinde DGT","x0":0.2197125243901972,"x1":0.8357289538438891,"top":0.5696581194848335,"bottom":0.5858974357241497,"conf":1},{"text":"hizmetlerinin planlanması ve yürütülmesi amacıyla; II Sağlık Müdürü başkanlığında,","x0":0.16837782414446778,"x1":0.8336755664783932,"top":0.5841880338583947,"bottom":0.598837209029554,"conf":1},{"text":"Tüberküloz İl Koordinatörü,","x0":0.1682351826822912,"x1":0.39031576857255723,"top":0.5966501380610919,"bottom":0.6120047999211096,"conf":1},{"text":". Verem Savaş Dispanserleri Başhekimleri, Sağhk Grup","