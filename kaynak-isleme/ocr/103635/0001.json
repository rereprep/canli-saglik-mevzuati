229978878033467,"x1":0.798767972858233,"top":0.5145299147074461,"bottom":0.5261627908183382,"conf":1},{"text":"nci maddesinin beşinci fikrası hükmü gereğince atanan tabip, uzman tabip ve yan dal","x0":0.24024640201554656,"x1":0.7987679725925568,"top":0.5260683759878498,"bottom":0.537790697783452,"conf":1},{"text":"uzmanların il içindeki atamaları öncelikle ilçelere, ilçelerde standart kadro mevzuatına göre","x0":0.2422997887748175,"x1":0.7987679728527157,"top":0.539244185987432,"bottom":0.5495726495988716,"conf":1},{"text":"boşluk bulunmaması halinde il merkezlerine yapılacaktır.","x0":0.2422997966749395,"x1":0.5811088273392382,"top":0.5508547009742115,"bottom":0.5625000001195106,"conf":1},{"text":"e) Bu kapsamda ilçelere atanan personelden, sağlık ve can güvenliği mazeretine bağhı","x0":0.2833675531384328,"x1":0.7987679703325454,"top":0.5623931622669047,"bottom":0.574127907096914,"conf":1},{"text":"yer değiştirmeleri hariç olmak üzere atandıkları yerde bir yıl süre ile görev yapmayanların il","x0":0.24024640075558806,"x1":0.7967145848334862,"top":0.5739316239656339,"bottom":0.5858974359314458,"conf":1},{"text":"merkezlerine atamaları yapılmayacaktır.","x0":0.24229979539307436,"x1":0.482546200296906,"top":0.587179487306988,"bottom":0.5974358975633982,"conf":1},{"text":"Bilgilerinizi ve gereğini önemle rica ederim.","x0":0.28531436334886195,"x1":0.5483334315582691,"top":0.5972336949208688,"bottom":0.6097883266023926,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜS","x0":0.5951275872544972,"x1":0.745657939956517,"top":0.6430425466836301,"bottom":0.6600670792299751,"conf":1},{"text":"Bakan a.","x0":0.6427104728612455,"x1":0.6981519498515082,"top":0.6584302325433926,"bottom":0.6671511627569948,"conf":1},{"text":"Müste Sar","x0":0.6386036967924277,"x1":0.7002053378927195,"top":0.6686046513535312,"bottom":0.6816860462663814,"conf":1},{"text":"Dağıtım:","x0":0.24019689995257598,"x1":0.2977907795139022,"top":0.7542373183115539,"bottom":0.7661115188553406,"conf":1},{"text":"A Planı",