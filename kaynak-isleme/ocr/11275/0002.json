{"lines":[{"text":"T.C.","x0":0.46201232074641063,"x1":0.490759752491098,"top":0.11046511646018142,"bottom":0.12063953436346209,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.40862423166208706,"x1":0.5441478420827293,"top":0.1205128203687289,"bottom":0.13247863233454082,"conf":1},{"text":"Temel Sağlık Hizmetleri Genel Müdürlüğü","x0":0.35510174777050046,"x1":0.5976802749973463,"top":0.13237042909808194,"bottom":0.14584426221479263,"conf":1},{"text":"Sayı : B.100.TSH.020. 00.06","x0":0.21752358607846345,"x1":0.3882323127330697,"top":0.15684314510923958,"bottom":0.1676289497599619,"conf":1},{"text":"Konu : Yönerge","x0":0.21737009464406992,"x1":0.3103320621400078,"top":0.16804708461012796,"bottom":0.17961286606488258,"conf":1},{"text":"T.C.","x0":0.644763860139505,"x1":0.6652977412750513,"top":0.13226744189591433,"bottom":0.13953488360473176,"conf":1},{"text":"SAĞLIK BAKANLIGI","x0":0.6155179546801027,"x1":0.7212885408714854,"top":0.13852072345661104,"bottom":0.15151107629915384,"conf":1},{"text":"Temel Sağ. Hiz. Genel Md. Aile","x0":0.6154916435529082,"x1":0.7560984603163651,"top":0.1455206194143993,"bottom":0.15937150967997005,"conf":1},{"text":"Hekimliği Toplum Sağlğı Şube","x0":0.6155262024886687,"x1":0.7539786793499237,"top":0.1550008361243851,"bottom":0.1680775865618036,"conf":1},{"text":"03 Agustos 2011 10:51:23 /25143","x0":0.6155807237303431,"x1":0.7663700053517202,"top":0.16246884931531214,"bottom":0.17586918470871238,"conf":1},{"text":"BAKANLIK MAKAMINA","x0":0.396303898823659,"x1":0.5564681749098044,"top":0.19040697661144124,"bottom":0.202136752146177,"conf":1},{"text":"1297148","x0":0.6221765917501153,"x1":0.6591375764102905,"top":0.19040697679863505,"bottom":0.1976744185074525,"conf":1},{"text":"Aile hekimliği pilot uygulaması kapsamında 26.01.2010 tarihli ve 2365 sayılı makam","x0":0.2545470919739957,"x1":0.7413433868817005,"top":0.21268368492328804,"bottom":0.2259914898623624,"conf":1},{"text":"onayı ile \" Aile Hekimliğinin Pilot Uygulandığı Illerde Toplum Sağlığı Merkezlerinin","x0":0.21355236201974606,"x1":0.7392197117094188,"top":0.22521367537241255,"bottom":0.23547008562882277,"conf":1},{"text":"Kurulması ve Çalıştırılmasına Dair Yönerge\" yürürlüğe girmiştir.","x0":0.21560576317488966,"x1":0.5790554318285324,"top":0.23401162799751773,"bottom":0.24572649564643312,"conf":1},{"text":"Mevcut yönergenin 25 inci maddesinin 2 numaralı fikrası, 34 üncü maddesinin (ğ)","x0":0.2525667399484995,"x1":0.7412730957526107,"top":0.2470085471408625,"bottom":0.2587209303459177,"conf":1},{"text":"bendi ve Geçici 1 inci maddesinin iptali ve yürütmenin durdurulması talepleriyle,","x0":0.21355236203098024,"x1":0.739219711720653,"top":0.25854700843944745,"bottom":0.27051282040525937,"conf":1},{"text":"Bakanlığımız aleyhine açılan davalarda, Danıştay 10. Daire'nin 31/12/2010 tarihli ve","x0":0.21349921070694444,"x1":0.7413374783181332,"top":0.26987687919945724,"bottom":0.28253856775140074,"conf":1},{"text":"E.2010/3859 sayılı kararı, yine Danıştay 10. Daire'nin 7/3/2011 tarih ve 2011/798 E sayılı","x0":0.21355236280909837,"x1":0.7412730989978832,"top":0.28197674406055284,"bottom":0.2936046512837245,"conf":1},{"text":"kararı ile \"dava konusu işlemin yürütülmesinin durdurulmasına\" karar verilmiştir.","x0":0.21348354604531794,"x1":0.7392920441465121,"top":0.29167228120645505,"bottom":0.3061491241682147,"conf":1},{"text":"Yürütmenin durdurulması kararının gerekçesinde, 5258 sayılı Kanun'un 8 inci maddesi","x0":0.21560575010382896,"x1":0.7412730997935018,"top":0.30512820532525553,"bottom":0.3154069767990667,"conf":1},{"text":"hükmünün doğrudan dava konusu yönergenin dayanak maddesi olamayacağına işaret","x0":0.21355236280909837,"x1":0.7412730989978832,"top":0.31666666661729725,"bottom":0.3270348837758187,"conf":1},{"text":"edilmektedir. Mezkur yargı kararının nasıl uygulanması gerektiği ile ilgili Hukuk","x0":0.21349655787744276,"x1":0.7413468553924631,"top":0.3264898844531521,"bottom":0.3400924530061964,"conf":1},{"text":"Müşavirliğinden görüş alınmış olup, 21/02/2011 tarih ve 7295 sayılı hukuk müşavirliği","x0":0.2135523628099036,"x1":0.7412730989986884,"top":0.3384615383929126,"bottom":0.3504273503587245,"conf":1},{"text":"görüşünde \"...Bu itibarla, yürürlükteki Yönerge'nin dayanak maddesinin, karar gerekçesinde","x0":0.21348779568558215,"x1":0.7413279452755912,"top":0.34874477689826566,"bottom":0.3619516076973357,"conf":1},{"text":"işaret edildiği üzere,","x0":0.21355235985435803,"x1":0.3408624242785522,"top":0.3619186045480476,"bottom":0.372222222090673,"conf":1},{"text":"\"5258 sayılı Kanun'un 8 inci maddesine dayanılarak çıkarılan ve","x0":0.338809043132523,"x1":0.7412730921708393,"top":0.36191860459145286,"bottom":0.3722222221340784,"conf":1},{"text":"25/05/2010 tarihli ve 27591 sayılı Resmi Gazete'de yayımlanan Aile Hekimliği Uygulama","x0":0.21560575089529088,"x1":0.7433264870840757,"top":0.3735042735780377,"bottom":0.38376068383444806,"conf":1},{"text":"Yönetmeliği ve 181 sayılı KHK'nin 43. Maddesi\" olarak değiştirilmesinin, yargı kararı","x0":0.2156057506465101,"x1":0.7412731003361829,"top":0.38372093043384103,"bottom":0.39534883684190647,"conf":1},{"text":"icaplarına göre hareket edilmiş olması bakımından yeterli olabileceği sonucuna varılmaktadır\"","x0":0.2134870775409468,"x1":0.743448364867598,"top":0.3938379020363362,"bottom":0.40774051079368134,"conf":1},{"text":"denildiğinden, Yönergenin hukuki dayanak başlıkh 3 üncü maddesinin 5258 sayılı Kanun'un","x0":0.21560575091672352,"x1":0.7433264871055083,"top":0.40683760664525215,"bottom":0.41880341861106407,"conf":1},{"text":"8 inci maddesine dayanılarak çıkarılan ve 25/05/2010 tarihli ve 27591 sayılı Resmi Gazete'de","x0":0.21560575131012508,"x1":0.7433264874989098,"top":0.41709401700447646,"bottom":0.4287790692893041,"conf":1},{"text":"yayımlanan Aile Hekimliği Uygulama Yönetmeliği ve 181 sayılı Sağlık Bakanlığının Teşkilat","x0":0.213468396285128,"x1":0.741353491957551,"top":0.42832382804328495,"bottom":0.44189543519284924,"conf":1},{"text":"ve Görevleri Hakkında Kanun Hükmünde Kararnamenin 43 üncü maddesi olarak","x0":0.21355236285383697,"x1":0.7412730990426217,"top":0.44040697668447626,"bottom":0.4505813954028631,"conf":1},{"text":"değiştirilmesi zarureti hâsıl olmuştur. Bununla birlikte diğer hükümlerden bazılarının","x0":0.21555320373999237,"x1":0.7433746073448895,"top":0.45128364840970714,"bottom":0.46376804564580576,"conf":1},{"text":"yürütmesi durdurulduğundan yönerge yeniden hazırlanmıştır.","x0":0.213442782408837,"x1":0.5586039713116862,"top":0.4630013347417329,"bottom":0.47670502496901324,"conf":1},{"text":"Bu","x0":0.25667351106352965,"x1":0.2772073921990758,"top":0.4767441860819608,"bottom":0.4840116277907782,"conf":1},{"text":"gerekçe ile hazırlanan","x0":0.2769881908014734,"x1":0.43753585549454704,"top":0.47401330153521937,"bottom":0.48624910522085596,"conf":1},{"text":"Toplum Sağlığı Merkezlerinin","x0":0.44342168589482894,"x1":0.6386766194838555,"top":0.474333841225533,"bottom":0.48563568883013786,"conf":1},{"text":"Kurulması ve","x0":0.6386036950698668,"x1":0.7433264895530562,"top":0.4752136750236835,"bottom":0.48418803399804244,"conf":1},{"text":"Çalıştırılmasına Dair Yönerge'nin yürürlüğe konulması hususunu;","x0":0.21560574576961972,"x1":0.5872689973212559,"top":0.48675213666357386,"bottom":0.49709302330942085,"conf":1},{"text":"Tensiplerinize arz ederim.","x0":0.25667351311384795,"x1":0.4045174517545485,"top":0.4985465115633312,"bottom":0.508720930281718,"conf":1},{"text":"Dr. Selacoadin co","x0":0.6180698164268166,"x1":0.7289527704073421,"top":0.5130813949795613,"bottom":0.5290697677170871,"conf":0.5},{"text":"Genel Müdür V.","x0":0.6365503068020575,"x1":0.7289527730651886,"top":0.5319767441853839,"bottom":0.5406976743989861,"conf":1},{"text":"Ek: Toplum Sağlığı Merkezlerinin Kurulması ve","x0":0.2156057460539687,"x1":0.49281314484336186,"top":0.5319767441240915,"bottom":0.5423076921793913,"conf":1},{"text":"Çalıştırılmasına Dair Yönerge","x0":0.2154430591784298,"x1":0