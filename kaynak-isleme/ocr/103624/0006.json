{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4496919868389139,"x1":0.9609856310348028,"top":0.04059829029136153,"bottom":0.05523255798425353,"conf":1},{"text":"Sağlık Kurulu","x0":0.4312114991480587,"x1":0.5749486647905353,"top":0.23401162756569172,"bottom":0.25000000030321756,"conf":1},{"text":"1- Heyet poliklinikleri mevcut poliklinik bölümlerine yakın, ortak bekleme bölümü ve koridorları","x0":0.17453798406945437,"x1":0.8316221804069317,"top":0.2601744184085508,"bottom":0.27325581413650735,"conf":1},{"text":"paylaşan bir yapıda tasarlanmalıdır. Bu bölüm sağhk kurulu odası ve danışma kayıt kasınlarmı da","x0":0.17453798393348682,"x1":0.8316221802709642,"top":0.27307692320607924,"bottom":0.2863372094883496,"conf":1},{"text":"barındırmalı ve sağlık kurulu günleri dışıda normal poliklinik olarak hizmet verecek şekilde","x0":0.17453798983947483,"x1":0.8316221861769522,"top":0.28488372093653136,"bottom":0.29957264965477226,"conf":1},{"text":"planlanacaktır:","x0":0.17659137693371707,"x1":0.2751540026941841,"top":0.29941860457887914,"bottom":0.3095930232972661,"conf":1},{"text":"300 yatakh hastanelerde 8,","x0":0.29568788556798037,"x1":0.4640657076505737,"top":0.31239316232977243,"bottom":0.322674418654997,"conf":1},{"text":"400 yatakh hastanelerde 10","x0":0.2936344991191689,"x1":0.4661190941999862,"top":0.3239316238915102,"bottom":0.33720930250346126,"conf":1},{"text":"500 yatakh hastanelerde 12 adet heyet poliklinik odası yapılacaktır.","x0":0.29363449312771667,"x1":0.7125256710604744,"top":0.3357558140987611,"bottom":0.3504273500797681,"conf":1},{"text":"Amelivathaneler","x0":0.4209445575163369,"x1":0.5852156066007063,"top":0.37500000013650725,"bottom":0.3895348835541421,"conf":0.5},{"text":"1- Ameliyathane personel girişlerinde terlik rafı geçiş havuzu oluşturulacaktır.","x0":0.17659138130797075,"x1":0.667351123611194,"top":0.4098290597791311,"bottom":0.42151162802765163,"conf":1},{"text":"Terlik 1 Çoraph geçilecek alan","x0":0.30184804634282825,"x1":0.5092402488100951,"top":0.43750000020078117,"bottom":0.45058139511363127,"conf":1},{"text":"Steril / Raf","x0":0.22792607825758576,"x1":0.31211498929888243,"top":0.4491279069755868,"bottom":0.4578488371891889,"conf":1},{"text":"(geçiş alanı 2 m) /","x0":0.37166324273395446,"x1":0.4866529789380903,"top":0.44912790683691917,"bottom":0.4607558140600908,"conf":1},{"text":"Ameliyathane Tam Steril Alan","x0":0.5441478432525079,"x1":0.7330595487769939,"top":0.43749999993275,"bottom":0.44786324779599784,"conf":1},{"text":"/Tam Steril","x0":0.5152916604700326,"x1":0.5955912962222574,"top":0.4604513653765777,"bottom":0.4755951453920504,"conf":1},{"text":"2- Ameliyathane içindeki dolaplar, 2 ameliyathane arasında duvara gömme şekilde yapılıp yarısını bir","x0":0.1765913703612532,"x1":0.8295687937005065,"top":0.4867521365986257,"bottom":0.49871794856443774,"conf":1},{"text":"ameliyathane diğer yarısını diğer ameliyathane kullanacak şekilde olacaktır. Dolap kapakları ameliyathane","x0":0.17659138960961884,"x1":0.8316221625464387,"top":0.49999999987481547,"bottom":0.5116279070979871,"conf":1},{"text":"duvarlarıyla aymı seviyede ve eğimde olup anti bakteriyel olabilmesi için gerekli metal malzemeden","x0":0.17659137036091666,"x1":0.82956879370017,"top":0.5130813952903336,"bottom":0.5232558140087205,"conf":1},{"text":"(Krom-Nikel vb) imal edilecektir.","x0":0.17646188953821174,"x1":0.386187376727176,"top":0.523240838285838,"bottom":0.5363982410417057,"conf":1},{"text":"3- Ameliyathanelerde imal edilen dolap kapaklarında çerçeveli cam olarak mikrop barındıracak veya zor","x0":0.17659138959974005,"x1":0.8316221625365599,"top":0.5465116277817651,"bottom":0.5581395350049367,"conf":1},{"text":"steril edilecek ara mahalleri olmayacaktır.","x0":0.1765913760291751,"x1":0.4394250508740114,"top":0.5594017095384959,"bottom":0.5713675215043078,"conf":1},{"text":"4- Ameliyathane odaları tavan ve duvar birleşme noktaları köşesiz ve oval olacaktır. Duvarlar alçı plaka","x0":0.1765913703629016,"x1":0.8295687937021549,"top":0.5811965810433185,"bottom":0.5915697674971133,"conf":1},{"text":"yardımı ile ovalleştirilecek, projelerde detayları gösterilecektir. (Bkz. Ameliyathane Detayı)","x0":0.17653043764118292,"x1":0.7351589119954944,"top":0.593061118439105,"bottom":0.6061208608694415,"conf":1},{"text":"5- Tüm yeni yapılacak, mevcutta yapımı devam eden ve ameliyathane tadilatı olacak hastanelerde,","x0":0.17659138960797346,"x1":0.8316221625447933,"top":0.6277777777948702,"bottom":0.6397435897606822,"conf":1},{"text":"ameliyathane sayıları aksi belirtilmediği taktirde;","x0":0.17659137428832128,"x1":0.4825462025160552,"top":0.64230769228494,"bottom":0.6526162791228389,"conf":1},{"text":"yatak için =","x0":0.23203285469750742,"x1":0.32854209395886247,"top":0.6540697673628744,"bottom":0.6642441860812612,"conf":1},{"text":"11-24 yatak için = 1 genel","x0":0.2012320329996413,"x1":0.3921971250232394,"top":0.6656976742787797,"bottom":0.6773504271632125,"conf":1},{"text":"25-49 yatak için","x0":0.2032854192472759,"x1":0.3182751554514117,"top":0.6786324784776698,"bottom":0.6905982904434818,"conf":1},{"text":"= 1 genel +1 lokal","x0":0.3223819325114628,"x1":0.4476386012111586,"top":0.6786324784781964,"bottom":0.6905982904440084,"conf":1},{"text":"= 2 genel +1 lokal","x0":0.32238193251307795,"x1":0.44763860121277377,"top":0.6918604650490291,"bottom":0.7021367520789802,"conf":1},{"text":"76-100 yatak için","x0":0.20301687436050944,"x1":0.3164270952620171,"top":0.7033727204534251,"bottom":0.7160159195426711,"conf":1},{"text":"= 3 genel +1 lokal ameliyat odası olarak düzenlenecektir.","x0":0.330595490927074,"x1":0.6858316135842687,"top":0.7049418604052202,"bottom":0.7151162791236072,"conf":1},{"text":"Yatak sayısı 100-300 e kadar olan hastanelerde ise her 50 yatak için en az bir adet ameliyat odası","x0":0.20533879241392813,"x1":0.8295688047656135,"top":0.7165697673153054,"bottom":0.7282051282776107,"conf":1},{"text":"eklenecek, 300 üzeri yatak sayısı olan hastanelerde ise her 30 yatağa bir adet ameliyat odası projesinde","x0":0.17659138962025248,"x1":0.8316221625570723,"top":0.7294871795893608,"bottom":0.7414529915551727,"conf":1},{"text":"planlanacaktır. Yatak sayısı 100 in üzerinde olan hastanelerde lokal ameliyathaneler günübirlik (out-","x0":0.1765913896102707,"x1":0.8316221625470905,"top":0.7427325580144754,"bottom":0.7543604652376471,"conf":1},{"text":"patient) olarak düşünüleceğinden sayısı ihtiyaç programında belirtilen sayıda olacaktır.","x0":0.1765913811790258,"x1":0.7145790498633706,"top":0.7542735041569185,"bottom":0.765988372213387,"conf":1},{"text":"385","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}