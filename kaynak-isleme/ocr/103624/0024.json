{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453741355351,"x1":0.9609856318323118,"top":0.040598290632302914,"bottom":0.056837606871619095,"conf":1},{"text":"Not: Standartlar belirli aralıklarla güncellenecek olup yayın tarihinden itibaren veni planlanan yada planlanmış","x0":0.15400410288440652,"x1":0.8583162256030055,"top":0.24700854660652216,"bottom":0.2616279068211469,"conf":1},{"text":"olan uygulanma projesi veni çizdirilecek sağlık yapılarımı kapsamaktadır.","x0":0.15400410038480927,"x1":0.6139630452013525,"top":0.2601744187529498,"bottom":0.2747863248208876,"conf":1},{"text":"*Tüm çizimler ve resimler fikir vermek amaçhı olup, malzeme özellikleri, minimum ölçüler değiştirilmemek","x0":0.1560575085921034,"x1":0.8583162079100447,"top":0.31395348804663115,"bottom":0.3299418607841571,"conf":1},{"text":"koşuluyla ve bakanlık teknik elemanları tarafından onavlanmak suretivle tasarım serbesttir:","x0":0.15389085532967187,"x1":0.7681066738708977,"top":0.3257114591129471,"bottom":0.3445465994064272,"conf":1},{"text":"**Hastane birimleri ana başhklar altında toplanarak daha önce vayınlanan ilgili maddeler gelistirilerek","x0":0.15400410293126948,"x1":0.8583162256498684,"top":0.3675213678569451,"bottom":0.3837606840962613,"conf":1},{"text":"tekrar düzenlenmiş ve numaralandırılmıştır:","x0":0.15382774088238343,"x1":0.4540543237520365,"top":0.38114729803169944,"bottom":0.39835931642779987,"conf":1},{"text":"Ilk Yavınlanma Tarihi: 18.01.2011","x0":0.3449691909724635,"x1":0.6570841971483061,"top":0.44186046530337597,"bottom":0.46367521346423546,"conf":1},{"text":"Son Güncelleme Tarihi: 30.10.2012","x0":0.34702258245259615,"x1":0.6652977481257748,"top":0.45494186074654897,"bottom":0.4739316242509686,"conf":1},{"text":"Yukarıda belirtilen maddeler genelge yayım tarihi itibari ile projesine başlanacak olan","x0":0.2113921094797227,"x1":0.8584555435316423,"top":0.5623754521908351,"bottom":0.5844607593854715,"conf":1},{"text":"ve teknik olarak mümkün olduğu kadarı ile devam eden inşaatlarda uygulanması hususunda","x0":0.1539216069898048,"x1":0.8584132188256951,"top":0.5787929191844526,"bottom":0.5980228521162059,"conf":1},{"text":"gereğini rica ederim.","x0":0.15370306855521643,"x1":0.3143554229328615,"top":0.5952721754689124,"bottom":0.6124988470301291,"conf":1},{"text":"Is bu genelge 24 sayfadan ve toplam 104 maddeden ibarettir:","x0":0.1540041150074932,"x1":0.5564681640458093,"top":0.6409883722408858,"bottom":0.6555555558740217,"conf":1},{"text":"Prof.Dr.Nihat TOSUN","x0":0.638603699061898,"x1":0.8131416806418272,"top":0.7717948717813752,"bottom":0.7906976740449447,"conf":0.5},{"text":"Bakan a.","x0":0.6878850110140206,"x1":0.7618069803343709,"top":0.7876068378568383,"bottom":0.8038461540961545,"conf":1},{"text":"Müsteşar","x0":0.6874038661853197,"x1":0.7642972863297848,"top":0.8028009825705779,"bottom":0.8198555452615084,"conf":1},{"text":"403","x0":0.8931312745092104,"x1":0.9343841257071231,"top":0.9402879358129169,"bottom":0.9565143896755555,"conf":1}]}