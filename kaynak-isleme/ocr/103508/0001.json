3602817,"x1":0.7559629882830777,"top":0.29752245746885975,"bottom":0.30967146904819387,"conf":1},{"text":"/2916","x0":0.7679671453890098,"x1":0.8028747435500729,"top":0.29796511618828725,"bottom":0.3081395349066741,"conf":1},{"text":"8474085","x0":0.6447638593292472,"x1":0.7494866538124365,"top":0.32412790684213055,"bottom":0.3357558140653022,"conf":0.5},{"text":"GENELGE","x0":0.48047353374316476,"x1":0.5564874516776701,"top":0.329885852676141,"bottom":0.34307926356585616,"conf":1},{"text":"2010/...2.","x0":0.48329800431893016,"x1":0.5682218373149341,"top":0.33631576424394394,"bottom":0.35698627684274786,"conf":0.5},{"text":"Ülkemizde son otuz yıldır çevresel","x0":0.2545046056306847,"x1":0.5093496493988697,"top":0.3661377046670907,"bottom":0.37853708713607237,"conf":1},{"text":"nedenli kanserler dikkati çekmektedir.","x0":0.5071868549251186,"x1":0.7843942537145118,"top":0.3675213677161657,"bottom":0.3779069767968146,"conf":1},{"text":"Anadolu'nun neredeyse tamamına yakın bir alanında yaygın olarak asbestli bölgeler ve bunun","x0":0.20944558451764875,"x1":0.782340860588443,"top":0.37777777791991773,"bottom":0.39102564116778105,"conf":1},{"text":"neden olduğu sağlık sorunları ile karşılaşmak mümkündür. Özellikle asbest ve zeolitin neden","x0":0.20944558924892775,"x1":0.784394251818834,"top":0.3909883721835642,"bottom":0.40261627859162963,"conf":1},{"text":"olduğu mezotelyoma önemli bir halk sağlığı sorunu olarak çözüm beklemektedir.","x0":0.20944559234749854,"x1":0.7043121076489458,"top":0.4040697672494694,"bottom":0.4171511629774258,"conf":1},{"text":"Mezotelyoma; Akciğer zarının Primer tümörüdür. Zeolit (Erionit) ve Asbest liflerinin","x0":0.2525667373136492,"x1":0.7823408600015459,"top":0.41709401726250106,"bottom":0.4273504275189113,"conf":1},{"text":"solunum yoluyla alınması, bu kanserin oluşumunda en önemli etkendir. Mezotelyoma oldukça","x0":0.20944558567857338,"x1":0.7823408617493677,"top":0.4302325580141677,"bottom":0.4418803420108802,"conf":1},{"text":"nadir görülmektedir. Dünyadaki görülme sıklığı (insidansı) yılda 1/1.000.000 iken ülkemizde","x0":0.20739219837094877,"x1":0.7823408609408551,"top":0.441860464923888,"bottom":0.45512820494529205,"conf":1},{"text":"bazı","x0":0.2060351515264111,"x1":0.23952502229203257,"top":0.4527084516994875,"bottom":0.46605572775132664,"conf":1},{"text":"yörelerimizdeki zeolit nedeniyle dünya ortalamasından 4000 kat daha fazla","x0":0.23613963881277764,"x1":0.7823408534935704,"top":0.4534188034600082,"bottom":0.465116279186796,"conf":1},{"text":"görülmektedir.","x0":0.2071358888331604,"x1":0.30199533379849064,"top":0.465332697095161,"bottom":0.47925498740809935,"conf":1},{"text":"Mezotelyomanın ülke genelinde oldukça yüksek değerlerde olduğu düşünülmesine","x0":0.2505133498572672,"x1":0.782340859044276,"top":0.4781976745627601,"bottom":0.49273504242425514,"conf":1},{"text":"rağmen eldeki verilerin oldukça yetersiz olduğu dikkati çekmektedir. Illerden Başkanlığımıza","x0":0.2072511694067947,"x1":0.7824884758655689,"top":0.48927914685741114,"bottom":0.5073071990977666,"conf":1},{"text":"yapılan kanser bildirimlerinin yetersiz oluşu ve mezotelyoma tanısının diğer kanser tanıları ile","x0":0.2093572275707794,"x1":0.7824208115905797,"top":0.5032185482199856,"bottom":0.5180457580838927,"conf":1},{"text":"karışması (over, testis, akciğer vb.) nedeni ile bu sorun yaşanmaktadır.","x0":0.20936054046045863,"x1":0.6366332402247611,"top":0.5159590094628381,"bottom":0.5294000977235866,"conf":1},{"text":"Daha sağlıklı kanser verisi ve mezotelyoma verilerinin eksiksiz toplanması ile ilgili şu","x0":0.25247010617094834,"x1":0.7824388845113353,"top":0.5283561556745459,"bottom":0.5441529018225493,"conf":1},{"text":"noktalara dikkat edilmesi gerekmektedir:","x0":0.20723295148107773,"x1":0.46016846942526607,"top":0.5399528960327066,"bottom":0.5546547458152754,"conf":1},{"text":"Aktif kanser kayıtçılık yapan illerimizde mezotelyoma vakalarında adres","x0":0.27298071459601214,"x1":0.7804213946235968,"top":0.5533990049675452,"bottom":0.5690880478658701,"conf":1},{"text":"bilgilerinin Kimlik Paylaşım Sisteminden tekrar teyidinin yapılarak hasta","x0":0.27704073074707053,"x1":0.7804226097855758,"top":0.5651823032885915,"bottom":0.5810229641010999,"conf":1},{"text":"ikametlerinin netliği sağlanması.","x0":0.2749990175786622,"x1":0.4765850017222157,"top":0.5783626186185078,"bottom":0.591000824774399,"conf":1},{"text":"Pasif kanser kayıtçılık yapan illerimizde kanser bildirimine gereken önemin","x0":0.27088172086878587,"x1":0.7804630595505802,"top":0.5900989884646015,"bottom":0.606990577181027,"conf":1},{"text":"gösterilmesi ve mezotelyoma verilerindeki kaçağı önlemek için özellikle ildeki","x0":0.27295365207866695,"x1":0.7804299051961094,"top":0.6026456940315555,"bottom":0.6200577615100942,"conf":1},{"text":"Göğüs Hastalıkları Hastanelerinde ve Gögüs Hastalıkları Kliniklerindeki kanser","x0":0.2749807082437065,"x1":0.7804465282609943,"top":0.6147292155017472,"bottom":0.631665997784389,"conf":1},{"text":"edilmesi gerekmektedir.","x0":0.27310061384495016,"x1":0.42299794821014913,"top":0.6641025639710533,"bottom":0.6773504272189166,"conf":1},{"text":"Bilgilerinizi, iş bu genelgenin ilgili kurum ve baştabipliklerine imza karşılığında","x0":0.24819795805428335,"x1":0.7805283615033084,"top":0.6749975811041684,"bottom":0.6951671179881829,"conf":1},{"text":"tebliğini ve uygulamanın aksaksız yürütülebilmesi için takibini önemle rica ederim.","x0":0.20303925792066627,"x1":0.7127777971862724,"top":0.687175091563506,"bottom":0.7064153877561642,"conf":1},{"text":"Prof Dr. Nihat TOSUN","x0":0.6259821779036413,"x1":0.7703356547082154,"top":0.7548254495013286,"bottom":0.769420182910721,"conf":1},{"text":"Bakan.a","x0":0.6734566739087096,"x1":0.7269540021999141,"top":0.7687506595113808,"bottom":0.7792144564367217,"conf":1},{"text":"Müsteşar","x0":0.6686077307726741,"x1":0.7295405036846961,"top":0.7814242872611263,"bottom":0.7958111913988926,"conf":1},{"text":"DAGITIM:","x0":0.2027126383695