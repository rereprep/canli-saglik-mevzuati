rilmeye devam edilecektir.","x0":0.20523372825610933,"x1":0.6879924774649402,"top":0.3958926461140567,"bottom":0.4105715066398563,"conf":1},{"text":"7. Yapılan muayene, tetkik, girişim, 112 acil yardım ve bunun gibi her türlü hizmetler ile","x0":0.25044127733274985,"x1":0.8049902489309586,"top":0.41994940855258156,"bottom":0.4345695814281407,"conf":1},{"text":"kişilerin sosyal güvenlik kurumlarına yönelik bilgileri kayıt altına alınmaya devam edilecektir. Bu","x0":0.20533882056226388,"x1":0.8049281211215142,"top":0.43162393174711566,"bottom":0.444871794994979,"conf":1},{"text":"bilgiler Il Sağlık Müdürlükleri, Refik Saydam Hıfzıssıhha Merkezi Başkanlığı ve Bölge","x0":0.20525186688002164,"x1":0.8029648345554486,"top":0.4430505142406236,"bottom":0.45772979210082476,"conf":1},{"text":"Müdürlüklerince hizmet verilen ayı takip eden ayın ilk 7 günü içerisinde elektronik ortamda (EK-2)","x0":0.20533880131487564,"x1":0.8049281387756715,"top":0.45639534871049314,"bottom":0.4680232559336648,"conf":1},{"text":"Strateji Geliştirme Başkanlığına ve Temel Sağlık Hizmetleri Genel Müdürlüğüne iletilecektir.","x0":0.20526788329758147,"x1":0.7516185123360866,"top":0.46740379783484953,"bottom":0.4807472037621979,"conf":1},{"text":"8. Performansa dayalı ek ödeme uygulamasına devam edilecek ve birinci basamak döner","x0":0.2504456489837428,"x1":0.8029444814188433,"top":0.4909104229781185,"bottom":0.504431330111172,"conf":1},{"text":"sermayesince dağıtılacak tutarların belirlenmesinde ilgi yılı tedavi giderleri resmi fiyat tarifesine","x0":0.20526223954276843,"x1":0.8029708528358269,"top":0.5013966769598887,"bottom":0.5168337672548815,"conf":1},{"text":"tekabül eden tutarlar esas alınacaktır.","x0":0.2030072129332522,"x1":0.42540135125559575,"top":0.5123569196813529,"bottom":0.527760629745059,"conf":1},{"text":"Yapılacak iş ve işlemlerin aksatılmaması, uygulamanın başlangıcından itibaren vatandaşın","x0":0.25042461604246874,"x1":0.802956696770061,"top":0.5373349369682139,"bottom":0.5521362737294278,"conf":1},{"text":"sağlık hizmeti alımının kolaylaştırılmasına yönelik tüm önlemlerin alınması için bilgilerinizi ve","x0":0.20533880058716056,"x1":0.8028747515488444,"top":0.5508547009756435,"bottom":0.5625000001209427,"conf":1},{"text":"gereğini arz/rica ederim.","x0":0.20504345062723045,"x1":0.34923103653402837,"top":0.559704750721028,"bottom":0.5731130513327359,"conf":1},{"text":"OiR.Grentil","x0":0.5215605749591353,"x1":0.6858316240435046,"top":0.6409883720113081,"bottom":0.6656976741473298,"conf":0.30000001192092896},{"text":"Uz. Dr. Orhan Fevzi GÜMRÜKÇÜOĞLU","x0":0.486652980859528,"x1":0.7556468152017004,"top":0.6627906979486939,"bottom":0.6816860460655768,"conf":1},{"text":"Bakan a.","x0":0.602889639437497,"x1":0.6661451662926705,"top":0.677691671549482,"bottom":0.6923679172144209,"conf":1},{"text":"Müsteşar V.","x0":0.5954283699481995,"x1":0.6776722466533461,"top":0.6887994398577896,"bottom":0.7036424203974865,"conf":1},{"text":"EKLER:","x0":0.20120311880472194,"x1":0.2567024251294697,"top":0.7135937371935054,"bottom":0.7253597511296053,"conf":1},{"text":"Ek-1","x0":0.20123203278968577,"x1":0.2340862421452903,"top":0.726744185955729,"bottom":0.7369186046741159,"conf":1},{"text":": Liste (1 sayfa)","x0":0.23613963094771398,"x1":0.3449691984291274,"top":0.7267441859106588,"bottom":0.7384615384109875,"conf":1},{"text":"Ek-2","x0":0.20328542129560911,"x1":0.24024640595578425,"top":0.7369186045579577,"bottom":0.7470930232763445,"conf":1},{"text":": Form Örneği (1 sayfa)","x0":0.23819301809430093,"x1":0.3921971254577239,"top":0.736752136930974,"bottom":0.7500000001788372,"conf":1},{"text":"Dağitim:","x0":0.20115167654023325,"x1":0.25880725548562844,"top":0.7614267716197316,"bottom":0.7734569492659447,"conf":1},{"text":"Gereği:","x0":0.20123203337279677,"x1":0.2505133462530303,"top":0.7718023257630516,"bottom":0.7848837206759017,"conf":1},{"text":"A Plani","x0":0.20123203331005438,"x1":0.2505133461902879,"top":0.7833333332977834,"bottom":0.796581196545