83037669646484,"bottom":0.32003003439748445,"conf":1},{"text":"tedavi ve cenaze giderleri\" hükmü ve 4/10/2004 tarihli ve 2004/7955 sayılı Bakanlar Kurulu","x0":0.10657576132592403,"x1":0.8749361990904343,"top":0.313504279957024,"bottom":0.33665484706883,"conf":1},{"text":"Kararı ile yürürlüğe konulan Terör ve Terörle Mücadeleden Doğan Zararların Karşılanması","x0":0.10864346563840696,"x1":0.8748899614676466,"top":0.3312999304159152,"bottom":0.3533611773041656,"conf":1},{"text":"Hakkında Yönetmelik gereğince 3713 sayılı Terörle Mücadele Kanununun 1 inci, 3 üncü ve 4","x0":0.10864511619565476,"x1":0.8728415097633316,"top":0.34789378945254734,"bottom":0.36842077651205096,"conf":1},{"text":"üncü maddeleri kapsamına giren eylemler veya terörle mücadele kapsamında yürütülen","x0":0.1085993993133233,"x1":0.8728915892931072,"top":0.3637315975381853,"bottom":0.3865599898278278,"conf":1},{"text":"faaliyetler nedeniyle zarar gören ve Genel Sağlık Sigortasından yararlanmayan kişilerin (","x0":0.10864182361010039,"x1":0.8728623507885316,"top":0.3807526465652942,"bottom":0.40251372242468997,"conf":1},{"text":"Türk vatandaşı veya yabancı uyruklu ) Sağlık Bakanlığına bağlı Kamu Kurum ve Kuruluşları.","x0":0.10866953520398583,"x1":0.8708097008535475,"top":0.39708395113317674,"bottom":0.41601004831836064,"conf":1},{"text":"Kamu ve Vakıf Universitelerine bağlı hastane/sağlık uygulama ve araştırma merkezleri ile Ozel","x0":0.10870808219070939,"x1":0.8707348124894171,"top":0.4135626515966415,"bottom":0.4318462168244436,"conf":1},{"text":"sağlık hizmet sunucularında verilen sağlık hizmetleri Valiliklerce Sağlık Uygulama Tebliği","x0":0.10661646403552551,"x1":0.8708299799203124,"top":0.42827638915272015,"bottom":0.4500500910079803,"conf":1},{"text":"(SUT) ve eklerinde yer alan fiyat tarifeleri üzerinde karşılanacaktır.","x0":0.10459877000252309,"x1":0.6613592881238388,"top":0.4442174434818822,"bottom":0.46418186702830644,"conf":1},{"text":"Bu bağlamda terörden zarar gören kişilerin tedavi giderlerinin valiliklerce","x0":0.17851402034648414,"x1":0.8727993289260639,"top":0.46321936715529,"bottom":0.48277154745366313,"conf":1},{"text":"karşılanmasında dikkat edilecek hususlar;","x0":0.10461336836134756,"x1":0.44778180000433426,"top":0.47894896928738573,"bottom":0.49568830756717497,"conf":1},{"text":"• Bu kişilerin terör olaylarına bağlı tedavilerinde kullanılan ilaç ve tıbbi malzeme giderleri","x0":0.13330829670673533,"x1":0.8707860524551105,"top":0.4962520224218896,"bottom":0.5164087148615638,"conf":1},{"text":"SUT ve eklerinde yer alan hükümler çerçevesinde Valiliklerce karşılanacaktır.","x0":0.1066082521299754,"x1":0.7455273674847971,"top":0.5126484632619889,"bottom":0.5329971556098496,"conf":1},{"text":"• Bu kişilere terör olayları nedeniyle sunulan sağlık hizmetinin devamı niteliğinde olan","x0":0.13330534567672628,"x1":0.8708002237422114,"top":0.5300723148711869,"bottom":0.5499697790691119,"conf":1},{"text":"tedaviler de bu kapsamda değerlendirilecek olup Valiliklerce karşılanacaktır.","x0":0.104569208434837,"x1":0.7373406739162457,"top":0.5461744695849252,"bottom":0.5655496022842232,"conf":1},{"text":"• Bu kişilere düzenlenen reçetelere terör olaylarından zarar gördüğüne dair açıklama","x0":0.12714652261498205,"x1":0.8708042539906244,"top":0.563699618248961,"bottom":0.5842396657559618,"conf":1},{"text":"eklenecektir.","x0":0.10450608151875192,"x1":0.2139549768636072,"top":0.578760950601272,"bottom":0.5939587550441097,"conf":1},{"text":"• Bu kişilere sunulan sağlık hizmetlerinden herhangi bir ad altında ilave ücret","x0":0.12731007349406026,"x1":0.872689926194899,"top":0.5973837209455088,"bottom":0.614957265048365,"conf":1},{"text":"alınmayacaktır.","x0":0.10472279254656047,"x1":0.23408624346986667,"top":0.6133720930295546,"bottom":0.6279069764471895,"conf":1},{"text":"Bu itibarla, ülkemizde meydana gelen terör eyleminden zarar gören kişilerin tedavi","x0":0.14977315009526437,"x1":0.8707565054317592,"top":0.6289748871323063,"bottom":0.6491023498617359,"conf":1},{"text":"giderlerinin karşılanmasında yukarıda yer alan hükümler çerçevesinde hareket edilmesi ve","x0":0.10458191287136667,"x1":0.8707981494332999,"top":0.6433740460683688,"bottom":0.6659582194828111,"conf":1},{"text":"ilinizdeki tüm sağlık hizmet sunucularına duyurulması hususunda;","x0":0.10449607549692264,"x1":0.6449744877975954,"top":0.660793184060549,"bottom":0.6803878273191899,"conf":1},{"text":"Gereğini önemle rica ederim.","x0":0.17659137519182136,"x1":0.416837780095653,"top":0.6773255816883491,"bottom":0.6933139527956624,"conf":1},{"text":"Prof. Dr. Eyüp GÜMÜŞ","x0":0.5646817231759481,"x1":0.774127312142327,"top":0.7122093023048968,"bottom":0.7296511627321012,"conf":1},{"text":"Bakan a.","x0":0.6236814891834547,"x1":0.7069139951939785,"top":0.730695457980358,"bottom":0.7445952399492164,"conf":1},{"text":"Müşteşar","x0":0.6195142077897504,"x1":0.7025001653494305,"top":0.7468326870728875,"bottom":0.7635345060118357,"conf":1},{"text":"DAĞITIM:","x0":0.1044401420775565,"x1":0.20778695173229975,"top":0.7554710735393265,"bottom":0.7730935093454705,"conf":1},{"text":"Geregi:","x0":0.1046936619167411,"x1":0.17251373005470683,"top":0.7760872154644636,"bottom":0.789319761235614,"conf":1},{"text":"81 Il Valiliğine","x0":0.102485285129488,"x1":0.23035711100615064,"top":0.7907475419295176,"bottom":0.8061184015810016,"conf":1},{"text":"(II Sağlık Müdürlüğü)","x0":0.10266940136953842,"x1":0.2854209473966885,"top":0.8081196581819324,"bottom":0.824127907285446,"conf":1},{"text":"Bilgi:","x0":0.5399996132278746,"x1":0.593470612266368,"top":0.7760935812716794,"bottom":0.7922203720927222,"conf":1},{"text":"Içişlerí Bakanlığına","x0":0.5418126671551569,"x1":0.7066643805086749,"top":0.7924530913824377,"bottom":0.8100431079675676,"conf":1},{"text":"(Mali Idareler Genel Müdürlüğü)","x0":0.5438684313643659,"x1":0.8155186972621421,"top":0.8088550079001295,"bottom":0.8273792625930549,"conf":1},{"text":"Türkiye Kamu Hastaneleri Kurumuna","x0":0.5462012409299358,"x1":