{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537364127537,"x1":0.963039017837164,"top":0.03760683761997996,"bottom":0.056837606850749234,"conf":1},{"text":"2.3.10. Enjeksiyon Uygulamaları Hakkında Genelge (2019/11)","x0":0.1252566649546154,"x1":0.8172484686785423,"top":0.11324786323522418,"bottom":0.1367521367394977,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4331786294408397,"x1":0.5996755797495137,"top":0.21634477777530348,"bottom":0.24877150102729828,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.39388609272634545,"x1":0.6390485768734415,"top":0.2410198709075766,"bottom":0.26339987324725755,"conf":1},{"text":"Sayı","x0":0.19917864453506565,"x1":0.2320328538906702,"top":0.28633720941130747,"bottom":0.29941860432415757,"conf":1},{"text":"Konu","x0":0.19898191286282832,"x1":0.24044313786276927,"top":0.2990632943117021,"bottom":0.31140182176291575,"conf":1},{"text":": 14500235-401.99/","x0":0.2484599567098989,"x1":0.38603696285503947,"top":0.2863247861265361,"bottom":0.2979651163841148,"conf":1},{"text":": Enjeksiyon Uygulamaları","x0":0.2482450660282217,"x1":0.43347014110072585,"top":0.2990455206065604,"bottom":0.31480404968276987,"conf":1},{"text":"Hakkında Genelge","x0":0.2581652366748577,"x1":0.3866269983339748,"top":0.3114209034938865,"bottom":0.3276017717242008,"conf":1},{"text":"GENELGE","x0":0.47433265050395723,"x1":0.5523613928225315,"top":0.3531976744730807,"bottom":0.3662790693859308,"conf":1},{"text":"2019/ 11","x0":0.4822161024279573,"x1":0.5506381039633568,"top":0.36687152755280683,"bottom":0.3816749835902793,"conf":1},{"text":"1219 sayılı Tababet ve Şuabatı San'atlarının Tarzı Icrasına Dair Kanunun l'inci maddesi","x0":0.23393573766058984,"x1":0.8296880155191901,"top":0.391865309674873,"bottom":0.40877836665979883,"conf":1},{"text":"\"Türkiye Cumhuriyeti dâhilinde tababet icra ve her hangi surette olursa olsun hasta tedavi","x0":0.19688694802191126,"x1":0.8297323642004935,"top":0.40397378221446156,"bottom":0.4241481102930331,"conf":1},{"text":"edebilmek için tıp fakültesinden diploma sahibi olmak şarttır.\" hükmü ile 70'inci maddesinde","x0":0.19491549148032547,"x1":0.8297217819834618,"top":0.41682349800890317,"bottom":0.43659295466037895,"conf":1},{"text":"\"Tahipler, diş tahipleri ve disçiler yapacakları her nevi ameliye için hastanın, hasta küçük veya","x0":0.19483364134023595,"x1":0.8277085787552148,"top":0.43093765023690933,"bottom":0.4510857098862545,"conf":1},{"text":"tahtı hacirde ise veli veya vasisinin evvelemirde muvafakatını alırlar. Büyük ameliyei","x0":0.19698473662166666,"x1":0.8276543638747274,"top":0.4441146385482695,"bottom":0.461506593280007,"conf":1},{"text":"cerrahiyeler için bu muvafakatin tahriri olması lazımdır. (Veli veya vasisi olmadığı veya","x0":0.1949111074744136,"x1":0.8277181460456802,"top":0.45627295798653533,"bottom":0.47574326086176066,"conf":1},{"text":"bulunmadığı veya üzerinde ameliye yapılacak şahıs ifadeye muktedir olmadığı takdirde","x0":0.19484318514306648,"x1":0.827677383251818,"top":0.47036444452139325,"bottom":0.49015227774335046,"conf":1},{"text":"muvafakat şart değildir.) ...\" hükmü yer almaktadır.","x0":0.19483568548074393,"x1":0.5382571510211951,"top":0.48204588313869334,"bottom":0.5003629785773327,"conf":1},{"text":"Kanun Maddesinden de anlaşılacağı üzere, tıbbi müdahalelerde hastanın muvafakatının","x0":0.2441358066520031,"x1":0.8277031203848099,"top":0.49657629173746964,"bottom":0.5154874284624797,"conf":1},{"text":"alınması gereklidir. Ancak, büyük cerrahi işlemler için bu muvafakatın yazılı olması zorunlu olup","x0":0.194887960433741,"x1":0.8276952942173716,"top":0.5091982270822604,"bottom":0.5288682309895537,"conf":1},{"text":"mevzuatımızda bunun dışında yazılı rıza alınması gereken bir işlem öngörülmemiştir.","x0":0.19693114080933818,"x1":0.7578969590553517,"top":0.5221884110926328,"bottom":0.5401731860815734,"conf":1},{"text":"Enjeksiyon uygulamaları büyük ameliyei cerrahiye olmadığı için hastaların sözel olarak","x0":0.24210481873627843,"x1":0.8276714951055915,"top":0.5362272005979943,"bottom":0.5549802099702816,"conf":1},{"text":"bilgilendirilmesinin gerekli ve yeterli olduğu, müdavi hekim tarafından reçete edilmiş güncel","x0":0.1948501561014676,"x1":0.8256434035319392,"top":0.5487867260439074,"bottom":0.568661142297413,"conf":1},{"text":"tedavisinin yetkili sağlık meslek mensupları tarafindan hastanın reçetesi görülerek yapılması","x0":0.19486375245501536,"x1":0.8256332352901876,"top":0.5623165824889153,"bottom":0.5826035827048858,"conf":1},{"text":"halinde yazılı onam alınması zorunluluğu bulunmadığı hususunda,","x0":0.19493294678962816,"x1":0.6346676674833064,"top":0.5749567483014656,"bottom":0.5913952210818726,"conf":1},{"text":"Bilgilerinizi ve uygulamanın gereğini önemle rica ederim.","x0":0.24205130428154537,"x1":0.6285906389673449,"top":0.5885127299184484,"bottom":0.6074498587516649,"conf":1},{"text":"Prof. Dr Suhammet GÜVEN","x0":0.6179919643800957,"x1":0.823715331353862,"top":0.6423187540452211,"bottom":0.6711136409684649,"conf":1},{"text":"Bakan a.","x0":0.6870783450483002,"x1":0.7544000947158911,"top":0.6665023489281398,"bottom":0.6823348603083271,"conf":1},{"text":"Bakan Yardımcısı","x0":0.6587804710429858,"x1":0.7827251237433523,"top":0.6803911579028288,"bottom":0.6951780159316645,"conf":1},{"text":"DAĞITIM","x0":0.19089702605498163,"x1":0.2711152938993882,"top":0.7135058157780649,"bottom":0.7312616257902301,"conf":1},{"text":"SI I Valiliginc (l Sağlik Madurlugo)","x0":0.18950527079586885,"x1":0.45048351748240534,"top":0.7321130799708878,"bottom":0.7645376285193987,"conf":0.5},{"text":"Yükseköğretim Kurulu Başkanlığına (YÖK)","x0":0.1930184766196668,"x1":0.4928131453500647,"top":0.7542735042285941,"bottom":0.7732558135863269,"conf":1},{"text":"Bilgi","x0":0.5338809031628796,"x1":0.5749486654339719,"top":0.7311046511236071,"bottom":0.7485465115508114,"conf":1},{"text":"Hukuk Hizmetleri Genel Müdürlüğüne","x0":0.5334763658006124,"x1":0.7950591520562