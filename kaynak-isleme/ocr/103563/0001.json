7922353,"bottom":0.4324366204753274,"conf":1},{"text":"2021/D","x0":0.47022587183534525,"x1":0.5277207399374132,"top":0.42877906961192835,"bottom":0.4404069768351,"conf":0.5},{"text":"Bakanlığımızca kalp merkezlerinin planlaması, kurulumu ve işleyişi ile ilgili usul ve esasları","x0":0.24216359800544468,"x1":0.7988641511153298,"top":0.4513082042587089,"bottom":0.46593867681688517,"conf":1},{"text":"düzenleyen 18.07.2019 tarihli ve 80118214-060.04-457 (2019/14) sayılı 'Kalp Merkezi Hizmetleri","x0":0.19700983634376626,"x1":0.7988714971731005,"top":0.46193196145605286,"bottom":0.4764929087112446,"conf":1},{"text":"Genelgesi\" yayımlanmış olup erişkin kalp merkezi ve çocuk kalp hastalıkları merkezi ayrımı","x0":0.19693312148533612,"x1":0.8009697963077363,"top":0.4732329336708143,"bottom":0.49143103011731637,"conf":1},{"text":"yapılmaksızın tüm iş ve işlemler ilgili Genelge kapsamında yürütülmektedir.","x0":0.19289152521660893,"x1":0.6490355513582543,"top":0.48616728283812916,"bottom":0.501319660594362,"conf":1},{"text":"Çocuk kalp hastalıkları, fetal dönemden erişkinlik dönemine kadar, organ gelişimini, doğum","x0":0.2359836071751281,"x1":0.7989529579322887,"top":0.4971102020868592,"bottom":0.51563089639567,"conf":1},{"text":"sürecini, büyümeyi, gelişmeyi, yaşam tarzını ve kalitesini etkilemektedir. Bu dönemde koordineli bir","x0":0.19288818553732123,"x1":0.7988929673871927,"top":0.5098221610427309,"bottom":0.5270105283157845,"conf":1},{"text":"şekilde ve son teknolojik uygulamalar eşliğinde, alanında uzmanlaşmış bir ekip tarafından çocuk kalp","x0":0.19287762140241563,"x1":0.7989333273850713,"top":0.5213385976980375,"bottom":0.5393122905023577,"conf":1},{"text":"hastalıklarının erken tanı, tedavi ve takibinin sağlanması önem arz etmektedir.","x0":0.1949947506490962,"x1":0.6551045120820806,"top":0.5346973807219797,"bottom":0.5471675441651294,"conf":1},{"text":"Bu nedenle, çocuk kalp hastalıkları merkezi hizmetlerinin çağın gerekleri doğrultusunda,","x0":0.24011324849599838,"x1":0.800955446564601,"top":0.5459388053649056,"bottom":0.5615494611250593,"conf":1},{"text":"ülkenin ihtiyaç ve şartlarına uygun olarak sunulmasını sağlama, bu merkezlerin hizmet standartlarını,","x0":0.1949047171114554,"x1":0.8009815676796802,"top":0.5571170838061348,"bottom":0.5741861863624124,"conf":1},{"text":"fiziki şartlarını, araç, gereç, tıbbi donanım ve personel standartlarını belirleme, mevcut merkezleri","x0":0.19494611032622408,"x1":0.7988713424812272,"top":0.5696111610572357,"bottom":0.5852138890939695,"conf":1},{"text":"yeniden yapılandırma, yeni kurulacak merkezleri planlama ve açılmalarına izin verme, bunların işleyişi","x0":0.19291680419617158,"x1":0.7988808836413612,"top":0.5812699430546611,"bottom":0.596540199031933,"conf":1},{"text":"ve denetimine ilişkin usul ve esaslarını düzenleme ihtiyacı håsıl olmuştur. Bu kapsamda, çocuk kalp","x0":0.1949581945849574,"x1":0.79889604706852,"top":0.5936204079692725,"bottom":0.6087260287854951,"conf":1},{"text":"hastalıkları merkezi hizmetlerine ait usul ve esaslar iş bu Genelge ile ekte belirtilen şekliyle","x0":0.19289270525639243,"x1":0.7989056792493641,"top":0.6049005734690244,"bottom":0.6209577574764571,"conf":1},{"text":"düzenlenmiştir.","x0":0.19281682543356743,"x1":0.2876294976899818,"top":0.6178001377164497,"bottom":0.6285963080733958,"conf":1},{"text":"Genelgenin ilinizde bulunan kamu, üniversite ve özel sağlık tesislerine duyurulması ve çocuk","x0":0.23803264083324996,"x1":0.7989163900420808,"top":0.6292618308913898,"bottom":0.6463223047328694,"conf":1},{"text":"kalp hastalıklarının tanısı, tedavisi ve takibi için sunulan sağlık hizmetlerinin iş-bu-Genelge kapsamında","x0":0.19083347813886137,"x1":0.798899026796944,"top":0.64052337802425,"bottom":0.657488246423063,"conf":1},{"text":"yürütülmesi hususunda;","x0":0.19096509032160064,"x1":0.34086242468679956,"top":0.6525641026179039,"bottom":0.6671511626170274,"conf":1},{"text":"Bilgilerinizi ve gereğini önemle arz/rica ederim.","x0":0.238193019