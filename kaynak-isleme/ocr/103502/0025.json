{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.45174537397568687,"x1":0.9609856316724636,"top":0.04059829028555706,"bottom":0.05523255797844895,"conf":1},{"text":"6.5. Vaka Sınıflaması","x0":0.21971252716476447,"x1":0.3552361375854067,"top":0.22093023248007493,"bottom":0.23119658132703225,"conf":1},{"text":"Laboratuvar incelemesi sonucu dikkate alınarak son vaka sınıflaması yapıldıktan sonra","x0":0.2587269039706207,"x1":0.7946611861558535,"top":0.24401709388118664,"bottom":0.2587209300776948,"conf":1},{"text":"Vaka Inceleme Formunun (Ek 2) alt kısmındaki","x0":0.22166474188712063,"x1":0.5277856270695855,"top":0.25557371802404194,"bottom":0.268036682041209,"conf":1},{"text":"'Son vaka sınıflaması' kısmı tam olarak","x0":0.5318275159246043,"x1":0.7946611907694408,"top":0.254273503881728,"bottom":0.2688953485402128,"conf":1},{"text":"doldurularak form Sağlık Müdürlüğü tarafindan Sağlık Bakanlığı Bulaşıcı Hastalıklar ve Salgın","x0":0.2176591397532109,"x1":0.7946611888222292,"top":0.2674418606105524,"bottom":0.28205128223463016,"conf":1},{"text":"Kontrolü Daire Başkanlığı'na gönderilecektir.","x0":0.2197125291013291,"x1":0.4907597499426135,"top":0.2803418802134341,"bottom":0.2936046513471178,"conf":1},{"text":"Son sınıflama Şekil 6'ya göre yapılacaktır (Bkz: Olası Kızamık/Kızamıkçık Vakaları için","x0":0.25872690400911014,"x1":0.7946611861943428,"top":0.3037790699153817,"bottom":0.3183760685050523,"conf":1},{"text":"Sıniflandırma Şeması, sf:25)","x0":0.2195590797285458,"x1":0.3903191364329367,"top":0.31508228836674146,"bottom":0.3284006452638185,"conf":1},{"text":"- Olası (Klinik) Vaka","x0":0.2587269010490903,"x1":0.39425051146973245,"top":0.3284883719601196,"bottom":0.34017094020864014,"conf":1},{"text":"- Laboratuvarla doğrulanmış Vaka","x0":0.26078028629415173,"x1":0.4722792617596426,"top":0.34011627894016483,"bottom":0.35174418616333636,"conf":1},{"text":"- Epidemiyolojik Ilişkili Vaka","x0":0.26078028517687313,"x1":0.44558521770313525,"top":0.35170940159675834,"bottom":0.36495726484462165,"conf":0.5},{"text":"- Aşı etkisi","x0":0.2627641203431346,"x1":0.33271842626639353,"top":0.363128761655682,"bottom":0.3737898428230497,"conf":1},{"text":"- Vaka değil","x0":0.26061258324116277,"x1":0.34308351515574487,"top":0.37445380034895537,"bottom":0.3886275949567862,"conf":1},{"text":"Tüm vakalar ayrıca importe, importe vakayla ilişkili veya importasyonla ilişkili olmayan","x0":0.2606773321994655,"x1":0.7947601900440846,"top":0.39662428278134754,"bottom":0.4134000791336363,"conf":1},{"text":"vaka şeklinde de sınıflanacaktır:","x0":0.21971252574769784,"x1":0.41067761777129597,"top":0.41133720923909867,"bottom":0.42151162795748554,"conf":1},{"text":"• İmporte Vaka: Döküntünün başlangıcından önceki inkübasyon süresi boyunca (kızamık","x0":0.23819302268150222,"x1":0.794661169857855,"top":0.43313953488369117,"bottom":0.4462209297965414,"conf":1},{"text":"için 7-18, kızamıkçık için 12-23 gün) yurt dışında bulunma öyküsü olan ve pidemiyolojik","x0":0.2607802912735863,"x1":0.7946611869597071,"top":0.44767441854581913,"bottom":0.457848837264206,"conf":1},{"text":"ve/veya virolojik olarak da yabancı kaynaklı enfeksiyona ilişkin kanıtlarla desteklenen","x0":0.26283367856524764,"x1":0.7946611877522564,"top":0.45930232545572847,"bottom":0.4709401708618939,"conf":1},{"text":"vakadır.","x0":0.2607802865135631,"x1":0.3121149905056018,"top":0.4709302324588782,"bottom":0.4811046511772652,"conf":1},{"text":"• Importe Vakayla İlişkili Vaka: Importe vakayla pidemiyolojik ve/veya virolojik ilişkisi","x0":0.23613962442856096,"x1":0.7926078085064592,"top":0.4824786326544943,"bottom":0.4957264959023576,"conf":1},{"text":"bulunan vakadır. İmporte vakayla ilişkili tüm vakalar yerli vaka olarak kabul edilir.","x0":0.25863361925353456,"x1":0.7475245934897611,"top":0.493750058104369,"bottom":0.5094072336086133,"conf":1},{"text":"• Importasyonla Ilişkili Olmayan Vaka: Importasyonun veya importe vakayla ilişkinin","x0":0.23819301177727573,"x1":0.792607809356062,"top":0.5072649572910468,"bottom":0.5188953489580787,"conf":1},{"text":"kanıtlanamadığı veya enfeksiyon kaynağı bilinmeyen sporadik vakadır. Yerli vaka olarak","x0":0.2607802912397596,"x1":0.7946611869258804,"top":0.5188034187991799,"bottom":0.5305232553358157,"conf":1},{"text":"kabul edilir.","x0":0.2607300814657882,"x1":0.33475246450412566,"top":0.5318156207694115,"bottom":0.5437657745440968,"conf":1},{"text":"6.5.1. Aşılanma Öyküsü Durumunda Yaklaşım","x0":0.21765913995646471,"x1":0.5112936307387539,"top":0.5537790698919969,"bottom":0.566860464804847,"conf":1},{"text":"• Kızamık ve/veya kızamıkçık aşısı uygulanmış olan kişilerde, aşılamadan sonra IgM","x0":0.2279260760549644,"x1":0.7946611926284226,"top":0.5784883719663488,"bottom":0.5901709402148694,"conf":1},{"text":"saptanması beklenir. Serolojik yöntemler doğal enfeksiyon ve aşılama ile ortaya çıkan","x0":0.24841571059890877,"x1":0.7947184414313604,"top":0.5892580649863798,"bottom":0.6033730382665448,"conf":1},{"text":"bağışıklık yanıtını ayıramaz; bu nedenle, sadece virüsün izolasyonu ve genetik","x0":0.248459967505212,"x1":0.7946611821860048,"top":0.6029914528186554,"bottom":0.6149572647844673,"conf":1},{"text":"tipledirilmesi ile doğal enfeksiyon ve aşı ile oluşan IgM yanıtı ayırt edilebilir.","x0":0.24845995253708167,"x1":0.708418897353625,"top":0.6148255812694557,"bottom":0.6264957264835692,"conf":1},{"text":"• Virüs izolasyonu veya tespiti yapılamamış IgM pozitif bir vakada yakın zamanda (döküntü","x0":0.2279260753029039,"x1":0.7926078053772502,"top":0.6380341879370919,"bottom":0.6497093024464788,"conf":1},{"text":"başlangıcından önceki 6 hafta içinde) aşılanma öyküsü olması durumunda yaklaşım aşağıda","x0":0.24640656175813686,"x1":0.7946611998395872,"top":0.6495726499110831,"bottom":0.6642441858920901,"conf":1},{"text":"yer almaktadır:","x0":0.24625346460982522,"x1":0.34090809677226763,"top":0.6617054529119992,"bottom":0.6723860208245656,"conf":1},{"text":"Tablo 4. Aşılanma Oyküsü Olan Vakaya Yaklaşım","x0":0.21765914241665565,"x1":0.5174537926962808,"top":0.6845930233647959,"bottom":0.69786324783006,"conf":1},{"text":"Epidemiyolojik Bulgu","x0":0.21765913619643318,"x1":0.35728952884068577,"top":0.7076923076702515,"bottom":0.7209401709181147,"conf":0.5},{"text":"Son Vaka Sınıflaması","x0":0.6137576318641087,"x1":0.7496914859914138,"top":0.7077523675702114,"bottom":0.7195974309183132,"conf":1},{"text":"-Laboratuvarla doğrulanmış vaka ile","x0":0.22792608082141236,"x1":0.44969198878246325,"top":0.7340116277781183,"bottom":0.7457264958345868,"conf":1},{"text":"pidemiyolojik ilişkinin varlığı","x0":0.22792607490394723,"x1":0.41067762093109733,"top":0.7456395347508173,"bottom":0.757267441973989,"conf":1},{"text":"-Toplumda yapılan aktif araştırma ile virüs dolaşımının","x0":0.22997946414159534,"x1":0.558521562310334,"top":0.7615384616389228,"bottom":0.7718023256344667,"conf":1},{"text":"olduğuna dair kanıt bulunmaması","x0":0.22997946853404744,"x1":0.4271047200549815,"top":0.7730769229256691,"bottom":0.783430232605923,"conf":1},{"text":"-Virüsün dolaşımda olduğu bölgelere seyahat hikayesi","x0":0.2299794617731283,"x1":0.552361400444531,"top":0.784883720803268,"bottom":0.7965811965300558,"conf":1},{"text":"bulunmamasi","x0":0.22792607642367554,"x1":0.3080082144667482,"top":0.7965116278768141,"bottom":0.8052325580904163,"conf":1},{"text":"Laboratuvarla doğrulanmış","x0":0.611909648274518,"x1":0.7720739243606634,"top":0.735465116146166,"bottom":0.7470930233693377,"conf":1},{"text":"(kesin) vaka","x0":0.6098562606663248,"x1":0.6878850122102854,"top":0.7470085471330986,"bottom":0.7587209303381538,"conf":1},{"text":"Vaka değil","x0":0.6119096517037461,"x1":0.6796714569140672,"top":0.773076923257792,"bottom":0.785042735223604,"conf":1},{"text":"(yakın zamanda aşılanmış)","x0":0.6098562590821839,"x1":0.7700205351683292,"top":0.7848837210174121,"bottom":0.7979651159302623,"conf":1},{"text":"513","x0":0.895277207334518,"x1":0.9281314166901224,"top