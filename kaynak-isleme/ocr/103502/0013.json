{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453741331312,"x1":0.9609856318299079,"top":0.040598290632205436,"bottom":0.05683760687152162,"conf":1},{"text":"Artralji ve artrit kızamıkçık geçiren erişkinler arasında yaygın olarak izlenmekte olup","x0":0.25462011736052714,"x1":0.8110883014384254,"top":0.2397435895302873,"bottom":0.2559829057696035,"conf":1},{"text":"kronikleşebildiği de bilinmektedir. Daha az yaygın olan komplikasyonlar ise ölümcül olabilen","x0":0.2094455784976676,"x1":0.8110883024575755,"top":0.25290697688992525,"bottom":0.2675213674017233,"conf":1},{"text":"trombositopeni ve ensefalittir (6000 vakada 1). İlerleyici kızamıkçık panensefaliti olarak bilinen","x0":0.20944557846949297,"x1":0.8110883024294009,"top":0.2645299141643278,"bottom":0.2790697672847894,"conf":1},{"text":"nadir görülen geç bir kızamıkçık komplikasyonu da bulunmaktadır.","x0":0.2093383845668892,"x1":0.6222436521001419,"top":0.27570064457035537,"bottom":0.29259461828767797,"conf":1},{"text":"Şekil 3. Kızamıkçık Hastalığının Klinik Ozelliklerinin Hastalığın Günlerine Göre Görülme","x0":0.20932233676526674,"x1":0.8112163602500007,"top":0.30057940352519363,"bottom":0.3190621864270554,"conf":1},{"text":"Hastalığın günleri (kızamıkçık)","x0":0.33675564529521307,"x1":0.5236139643205872,"top":0.3414529915884674,"bottom":0.3517441860966858,"conf":1},{"text":"1 2 3","x0":0.33264886927700354,"x1":0.41273100732007617,"top":0.3589743591403094,"bottom":0.3692307693967197,"conf":1},{"text":"40ºC","x0":0.2895277217081653,"x1":0.3244353175628819,"top":0.3633720929237221,"bottom":0.3720930231373243,"conf":0.5},{"text":"39°C","x0":0.2874743322336367,"x1":0.32238193039469987,"top":0.3808139534687802,"bottom":0.3895348836823824,"conf":0.5},{"text":"38°C","x0":0.28747433223363683,"x1":0.3223819303947,"top":0.3968023254946027,"bottom":0.4069767442129897,"conf":0.5},{"text":"6 7 8 9 10","x0":0.48665297768389515,"x1":0.6303901433263717,"top":0.3575581393322427,"bottom":0.3706395350601992,"conf":1},{"text":"Ates","x0":0.6242299792715474,"x1":0.657084188627152,"top":0.42587209296005935,"bottom":0.43459302317366155,"conf":1},{"text":"Döküntü","x0":0.628295756341231,"x1":0.6838192331782785,"top":0.4431822127484969,"bottom":0.45216662442827826,"conf":1},{"text":"Lenfadenopati","x0":0.6262833663503121,"x1":0.7186858326134431,"top":0.4651162790010689,"bottom":0.47529069771945576,"conf":0.5},{"text":"Halsizlik (erişkinlerde)","x0":0.58916794488996,"x1":0.729151531451539,"top":0.4926161279582386,"bottom":0.5039850905966372,"conf":1},{"text":"Halsizlik (çocuklarda","x0":0.5934291573925563,"x1":0.7227926083158626,"top":0.5188034186434315,"bottom":0.5290697674903887,"conf":1},{"text":"Konjunktivit","x0":0.595427568834625,"x1":0.6735662685333903,"top":0.5419367757696018,"bottom":0.5525399680908575,"conf":0.5},{"text":"Nezle belirtileri","x0":0.5913757696147717,"x1":0.6858316223770147,"top":0.5683139534883709,"bottom":0.5770348837019731,"conf":1},{"text":"3.2. Kızamıkçık Hastalığının Tanısı","x0":0.21149897083702476,"x1":0.44353182974440836,"top":0.613247863364957,"bottom":0.6250000001170938,"conf":1},{"text":"Bazı enfeksiyonlar belirtileri","x0":0.2566735069297706,"x1":0.45995893639881347,"top":0.6380341880005631,"bottom":0.6482905982569734,"conf":1},{"text":"ve bulguları yönünden kızamıkçıkla benzerlik","x0":0.47227926281044236,"x1":0.8110882934747411,"top":0.6380341879354532,"bottom":0.64970930244484,"conf":1},{"text":"gösterebilmektedir. Bununla birlikte; enfekte kişilerin yaklaşık %50'sinde, hastalık belirtisiz","x0":0.20944557836870809,"x1":0.811088302328616,"top":0.6495726499109266,"bottom":0.6642441858919336,"conf":1},{"text":"olabilir ya da çok az belirti gösterebilir. Bu nedenle, tanının doğrulanması için laboratuvar","x0":0.21149896565896362,"x1":0.8110883031197594,"top":0.6627906975488977,"bottom":0.6744186047720694,"conf":1},{"text":"değerlendirmesi çok önem taşımaktadır.","x0":0.2114989756243933,"x1":0.4558521535264489,"top":0.675872092894897,"bottom":0.6876068377249064,"conf":1},{"text":"Doğal enfeksiyon sırasında; döküntünün başlamasından itibaren 3-4 gün içerisinde IgM","x0":0.2114989649570826,"x1":0.8090349159187664,"top":0.7122093021986409,"bottom":0.723931623994243,"conf":1},{"text":"antikorları, bir hafta içerisinde ise IgG antikorları saptanabilir. Aşılamayı takiben, IgM ve IgG","x0":0.2114989648718878,"x1":0.8090349158335716,"top":0.7252136753063859,"bottom":0.7369186047723074,"conf":1},{"text":"antikorlarının görülmesi doğal enfeksiyona göre hem daha geç, hem de daha düşük düzeyde","x0":0.2114989656668285,"x1":0.8110883031276243,"top":0.7367521365983826,"bottom":0.7487179485641946,"conf":1},{"text":"olmaktadır. Kızamıkçığa özgü IgM antikoru, genellikle hastalığın sona ermesinden 2 ay sonrasına","x0":0.21149896564942108,"x1":0.8110883031102168,"top":0.7499999998744512,"bottom":0.761627907097623,"conf":1},{"text":"kadar saptanabilmekte ve bazı kişilerde doğal enfeksiyon, aşılama ve yeniden enfeksiyon sonrası","x0":0.2114989648526905,"x1":0.8090349158143744,"top":0.7615384615740571,"bottom":0.7732558140743858,"conf":1},{"text":"6-7 aya kadar da azalarak devam edebilmektedir.","x0":0.21141558919047745,"x1":0.5093057691578388,"top":0.7728985063013644,"bottom":0.7851027009816027,"conf":1},{"text":"Enfeksiyonu takiben, döküntünün başlamasından birkaç gün öncesinden başlayarak en az 7","x0":0.2546201173035865,"x1":0.8110883013814847,"top":0.7978632477755236,"bottom":0.8111111110233868,"conf":1},{"text":"gün sonrasına kadar, virüs nazofarengeal sekresyonlardan izole edilebilir. RT-PCR ile viral","x0":0.21143713563405173,"x1":0.8111451115636165,"top":0.8091843192701117,"bottom":0.8224018181798256,"conf":1},{"text":"RNA'nın saptanması yöntemi ile bu süre 3-4 gün daha uzayabilir. Ancak örnek almak için en","x0":0.213552352951006,"x1":0.8110883039126897,"top":0.822649572818031,"bottom":0.8343023257024638,"conf":1},{"text":"uygun zaman belirtilerin başlamasını takiben ilk 4 gündür. Aşılanmış kişilerde de, belli düzeylerde","x0":0.21149896567571896,"x1":0.8110883031365148,"top":0.8341880340425778,"bottom":0.8474358972904411,"conf":1},{"text":"virüsün saptanması mümkündür.","x0":0.21149897656935904,"x1":0.41067761458940516,"top":0.8473837208675837,"bottom":0.8576923077054828,"conf":1},{"text":"501","x0":0.8952772069705462,"x1":0.9301848051316094,"top":0.9433139533288212,"bottom":0.9549418605519928,"conf":1}]}