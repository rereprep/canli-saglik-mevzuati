{"lines":[{"text":"498","x0":0.06776180735586484,"x1":0.10472279201603998,"top":0.030523255656540016,"bottom":0.04215116287971166,"conf":1},{"text":"2.2. Kızamık Hastalığının Tanısı","x0":0.21149897208359042,"x1":0.42299794754908127,"top":0.23837209288927552,"bottom":0.25000000011244716,"conf":1},{"text":"Kızamık isidansının düşük olduğu ülkelerde, kızamığın klinik tanısının pozitif tahmin","x0":0.25256673000885155,"x1":0.8110883005858618,"top":0.26308139515682794,"bottom":0.27616279088478435,"conf":1},{"text":"değeri de düşük olduğundan; tek başına klinik belirtiler kızamık tanısı için güvenilir değildir.","x0":0.2114488034896461,"x1":0.8090733181605197,"top":0.2738733474306374,"bottom":0.2878562262215989,"conf":1},{"text":"Kızamık benzeri döküntüyle seyreden birtakım hastalıkları kızamıktan ayırt edebilmek için","x0":0.21149896566313456,"x1":0.8110883031239303,"top":0.2876068376995846,"bottom":0.29957264966539654,"conf":1},{"text":"mutlaka laboratuvar değerlendirmesi gerekmektedir.","x0":0.2114237998708114,"x1":0.5319144974340104,"top":0.29931118372150967,"bottom":0.3137378487423139,"conf":1},{"text":"Birincil bağışıklık yanıtı sırasında, kızamığa özgü IgM ve IgG antikorları oluşmakta olup","x0":0.2546201173149849,"x1":0.8110883013928831,"top":0.323931623833299,"bottom":0.3386627905424817,"conf":1},{"text":"döküntülerin başlamasından itibaren birkaç gün içerisinde duyarl ELISA yöntemiyle serumda","x0":0.20944557836805264,"x1":0.8110883023279605,"top":0.33717948717721613,"bottom":0.35042735042507944,"conf":1},{"text":"saptanabilir. Döküntülerin ortaya çıkmasından itibaren kızamık vakalarının %70'inde ilk 2 gün,","x0":0.21355237469997962,"x1":0.8090349022610059,"top":0.34871794874826045,"bottom":0.36196581199612377,"conf":1},{"text":"%90'ında ise 3-5 gün içerisinde IgM antikoru pozitifliği saptanır. IgM antikorları 7-10 içinde pik","x0":0.20944557836877034,"x1":0.8110883023286781,"top":0.3619186044593632,"bottom":0.3750000001873195,"conf":1},{"text":"yaptıktan sonra düşmeye başlar, 6-8 haftanın sonunda ise artık nadiren saptanabilir. IgG antikor","x0":0.21139578478576307,"x1":0.8111487067977416,"top":0.3720315760652039,"bottom":0.3874999672554311,"conf":1},{"text":"düzeyleri ise 3. haftada pik yaparak enfeksiyondan sonra uzun süre bulunmaya devam eder. Yanıt","x0":0.21149896566866522,"x1":0.811088303129461,"top":0.38662790685125936,"bottom":0.39829059832623903,"conf":1},{"text":"sırasında, serum ve sekretuvar IgA antikorları da oluşmaktadır.","x0":0.2114218365448861,"x1":0.5955409095662547,"top":0.39816347475039526,"bottom":0.41225358402940837,"conf":1},{"text":"Şekil 2. Akut Kızamık Enfeksiyonunda Bağışıklık Yanıtı Oluşma Süreci.","x0":0.20944559250082276,"x1":0.6570841814211485,"top":0.422965116086482,"bottom":0.43604651181443854,"conf":1},{"text":"Virüs nazofarinkste saptanabilir.","x0":0.4353182715815358,"x1":0.6406570875496906,"top":0.46947674412393403,"bottom":0.479651162842321,"conf":1},{"text":"Virüs kanda saptanabilir.","x0":0.4353182717304733,"x1":0.5934291613175067,"top":0.4811046510987578,"bottom":0.4914529914837382,"conf":1},{"text":"Döküntülü dönem","x0":0.375770019604589,"x1":0.4928131423078368,"top":0.49401709413800066,"bottom":0.5029914531123596,"conf":1},{"text":"CD8","x0":0.3613963042013131,"x1":0.39219712475145907,"top":0.5305232557943617,"bottom":0.5392441860079639,"conf":1},{"text":"T hức.","x0":0.3507900652961979,"x1":0.39463524083980195,"top":0.540759429390142,"bottom":0.5517814746560571,"conf":1},{"text":"IgG","x0":0.5462012315450091,"x1":0.574948665596043,"top":0.5377906975064821,"bottom":0.5494186047296538,"conf":0.5},{"text":"CD4/","x0":0.33059548210896683,"x1":0.36550308027003,"top":0.6031976742538627,"bottom":0.6148255814770344,"conf":1},{"text":"Thộc.","x0":0.3215037303046126,"x1":0.3641715435884014,"top":0.612855624993911,"bottom":0.6241588957740342,"conf":0.5},{"text":"Enfeksiyon","x0":0.25459193357566207,"x1":0.3285702838448367,"top":0.681583009264751,"bottom":0.6919635023310008,"conf":1},{"text":"Ig M","x0":0.4969199187272457,"x1":0.525667350471933,"top":0.6029914529985392,"bottom":0.6162790693859309,"conf":1},{"text":"immunsupresyon","x0":0.42710472673649796,"x1":0.5420944537152474,"top":0.6351744187727115,"bottom":0.646802325180777,"conf":0.5},{"text":"7","x0":0.4579055441035232,"x1":0.4702258723235816,"top":0.6511627907882154,"bottom":0.6627906971962808,"conf":1},{"text":"14","x0":0.5112936347676212,"x1":0.5359342912077381,"top":0.6511627907521504,"bottom":0.6642441856650007,"conf":1},{"text":"Döküntünün başlaması","x0":0.3449691979624684,"x1":0.4969199188267793,"top":0.6816239317486952,"bottom":0.6905982907230541,"conf":1},{"text":"21","x0":0.570841888978855,"x1":0.5975359342244303,"top":0.6526162788819542,"bottom":0.6642441861051259,"conf":1},{"text":"28","x0":0.6283367551852976,"x1":0.6570841892363316,"top":0.6526162788819542,"bottom":0.6642441861051259,"conf":1},{"text":"35","x0":0.6960985632873937,"x1":0.7186858309220518,"top":0.6526162792378278,"bottom":0.6642441856458933,"conf":1},{"text":"Günler","x0":0.6774400356539337,"x1":0.718863865550208,"top":0.6681669142287182,"bottom":0.6777633182798876,"conf":1},{"text":"Kızamık virüsü klinik örneklerden (nazofarengeal sürüntü, idrar, periferik kandaki","x0":0.2546201181003457,"x1":0.8131416886773559,"top":0.7194767439940644,"bottom":0.7325581397220208,"conf":1},{"text":"mononükleer hücreler) döküntülerin başlamasından itibaren ilk 5 güne kadar izole edilebilir, PCR","x0":0.2114989659747128,"x1":0.8110883034355088,"top":0.7311046513043447,"bottom":0.7457264959628295,"conf":1},{"text":"ile de 7 güne kadar (ve bazen sonrasında da) saptanabilir.","x0":0.2114382805370888,"x1":0.5627004757598443,"top":0.7436069246489713,"bottom":0.7575517428685392,"conf":1},{"text":"ELISA ile spesifik IgM antikoru saptanması DSO tarafindan rutin kızamık sürveyansı için","x0":0.25462011730718764,"x1":0.8110883013850858,"top":0.7688034189240676,"bottom":0.7820512821719308,"conf":1},{"text":"önerilen standart testtir. IgM antikor testine ek olarak 2-4 hafta ara ile alınan örneklerde IgG","x0":0.21355235296303082,"x1":0.8110883039247145,"top":0.7819767440607338,"bottom":0.7936046512839056,"conf":1},{"text":"antikor titresinde en az dört katı artış, immunofloresan ile antijenin gösterilmesi, kızamık virus","x0":0.21355235378257764,"x1":0.8131416912433734,"top":0.7935897435583881,"bottom":0.8052325582598271,"conf":1},{"text":"RNA'sının revers transkripsiyon (RT) PCR ile gösterilmesi, kızamık virus izolasyonu gibi diğer","x0":0.21355235295677555,"x1":0.8110883039184593,"top":0.8051282052588496,"bottom":0.8168604652374456,"conf":1},{"text":"tanı yöntemleri ile de kızamık tanısı konulabilmektedir.","x0":0.2113470525882945,"x1":0.5503925114545846,"top":0.8144493952746502,"bottom":0.8302969437349993,"conf":1}]}