{"lines":[{"text":"544","x0":0.06776180735586484,"x1":0.10472279201603998,"top":0.030523255656540016,"bottom":0.04215116287971166,"conf":1},{"text":"1. Ağızdan verilir.","x0":0.19096509380599555,"x1":0.30184804778652097,"top":0.254273504476751,"bottom":0.2675213677246142,"conf":1},{"text":"2. Çocuğun başı geriye doğru eğilir, ağzı açılıp bir elle yanaklardan tutulurken diğer elle dil","x0":0.19096509868196737,"x1":0.731006153865424,"top":0.26581196612895086,"bottom":0.2805232556570396,"conf":1},{"text":"üzerine aşı damlatılır.","x0":0.1909650932686421,"x1":0.3244353171901723,"top":0.28034188027548135,"bottom":0.2923076922412934,"conf":1},{"text":"3. Damlalığın ucunun çocuğun ağzına değmemesine dikkat edilir.","x0":0.19085530125201366,"x1":0.5791591571387844,"top":0.2903296022236106,"bottom":0.30640492316028634,"conf":1},{"text":"4. Damlatılması gereken miktar aşı tipine göre değişebilir. Kaç damlanın bir doza eşdeğer olduğu","x0":0.19082693401303943,"x1":0.7722191599496893,"top":0.30075656489534475,"bottom":0.31899539709196345,"conf":1},{"text":"aşı flakonu üzerinden kontrol edilmelidir (halen kullanılan aşıda 2 damla 1 dozdur).","x0":0.19089223598074653,"x1":0.6879383041653558,"top":0.3150499556940751,"bottom":0.32999821780277205,"conf":1},{"text":"H-) AȘI LOJİSTIĞİ","x0":0.2336681246907059,"x1":0.3679940770015102,"top":0.33536432690315876,"bottom":0.35119249702744104,"conf":1},{"text":"1) Aşıların Sevkiyatı","x0":0.23613963046743572,"x1":0.3675564678898539,"top":0.3589743591462353,"bottom":0.36923076940264565,"conf":1},{"text":"GBP için gerekli aşı ve malzemeler sevk dönemlerinde ve düzenli aralıklarla dağıtılırlar.","x0":0.23603082396030095,"x1":0.7701296970756653,"top":0.36732302104610626,"bottom":0.382702589292801,"conf":1},{"text":"Aşağıda yer alan tabloda aşı depolaması yapılan ve kullanılan merkezlere ne kadar süre için aşı","x0":0.1949713780756472,"x1":0.7721567540226884,"top":0.38058973037858457,"bottom":0.3951634356768534,"conf":1},{"text":"sevkiyatı yapılması gerektiği belirtilmektedir.","x0":0.19067277184140782,"x1":0.4663214677998325,"top":0.3926440750873901,"bottom":0.41079424573151435,"conf":1},{"text":"Aşının depolandığı yer","x0":0.2628336766088772,"x1":0.4086242287504657,"top":0.4170940171101267,"bottom":0.4303418803579899,"conf":1},{"text":"Sevk dönemleri","x0":0.5195071850244303,"x1":0.6221765930085078,"top":0.41569767428352566,"bottom":0.42735042716795846,"conf":1},{"text":"Bölge deposu ve Il deposu","x0":0.2628336729129709,"x1":0.4229979489991162,"top":0.430232558006467,"bottom":0.4418803420031794,"conf":1},{"text":"Ilçe deposu / TSM","x0":0.26283367691117465,"x1":0.3737166308917001,"top":0.44316239297289073,"bottom":0.45348837214047033,"conf":1},{"text":"Sağlık Ocağı / Aile Hekimi","x0":0.2626387958127007,"x1":0.4273393235343226,"top":0.4548240317590927,"bottom":0.4687692395994498,"conf":1},{"text":"Ayda bir","x0":0.5215119785373711,"x1":0.5770506495857765,"top":0.45483852678574377,"bottom":0.46812658944380914,"conf":1},{"text":"Sağlık EVI","x0":0.2606278548955791,"x1":0.32869452683670664,"top":0.46901711663099177,"bottom":0.48156427867881,"conf":1},{"text":"Haftada bir","x0":0.5195071877186438,"x1":0.5934291570389941,"top":0.46794871794278015,"bottom":0.47820512819919037,"conf":1},{"text":"Kurumların aşı, antiserum ve malzeme ihtiyaçları bu sevk dönemi süreleri dikkate alınarak","x0":0.22579348720475625,"x1":0.7742214518454001,"top":0.4868516962615028,"bottom":0.5014420509201024,"conf":1},{"text":"hesaplanır. Sağlık Bakanlığı merkez deposundan Il Sağlık Müdürlüklerine aşı ve antiserum","x0":0.19494814138166958,"x1":0.7742317023040547,"top":0.49827723932654877,"bottom":0.5147450885363261,"conf":1},{"text":"dağıtımı aşağıda belirtilen dönemler için, ilgili dönemin ilk ayında il deposunda olacak şekilde","x0":0.19301848428911794,"x1":0.7741273063563602,"top":0.5130813954941653,"bottom":0.5277777775439867,"conf":1},{"text":"yapılmaktadır.","x0":0.19078852779730948,"x1":0.28346991439207025,"top":0.5274519784821761,"bottom":0.540267018679304,"conf":1},{"text":"Sevk dönemi","x0":0.2915811074415027,"x1":0.3716632454845753,"top":0.5478632477834576,"bottom":0.5581395348134086,"conf":1},{"text":"1","x0":0.3223819302773767,"x1":0.3347022584974351,"top":0.5610465116278773,"bottom":0.5741279065407274,"conf":1},{"text":"2","x0":0.32443531811447074,"x1":0.33470225868224385,"top":0.5741279070672852,"bottom":0.5857558134753507,"conf":1},{"text":"Aylar","x0":0.5215605738183219,"x1":0.5605749495903023,"top":0.5479651161252562,"bottom":0.5595930233484279,"conf":1},{"text":"Ocak - Şubat - Mart","x0":0.5215605750738697,"x1":0.6529774124962878,"top":0.5594017094557309,"bottom":0.5726744183648552,"conf":1},{"text":"Nisan - Mayıs - Haziran","x0":0.5154004124784178,"x1":0.6632443511191184,"top":0.573931623957908,"bottom":0.5858974359237199,"conf":1},{"text":"Temmuz - Ağustos - Eylül","x0":0.5071868593899841,"x1":0.6735112949734655,"top":0.5871794871004843,"bottom":0.5988372088726374,"conf":1},{"text":"Ekim - Kasım - Aralık","x0":0.5195071863010077,"x1":0.6611909654443723,"top":0.6017094017302428,"bottom":0.611965811986653,"conf":1},{"text":"2) AȘI İHTİYACININ BELİRLENMESİ","x0":0.2277737186843622,"x1":0.4950208921735834,"top":0.6350785708104373,"bottom":0.6499559700267876,"conf":1},{"text":"Dönemlik aşı ihtiyacı belirlenirken o dönemde tüketilmesi planlanan aşı yanında rezerv stok","x0":0.2257776112972889,"x1":0.7763009194942735,"top":0.6467242379014897,"bottom":0.6637295616538685,"conf":1},{"text":"ve fire de dikkate alınmalıdır.","x0":0.1950718755172203,"x1":0.37371663009537365,"top":0.6613372093928666,"bottom":0.6730769231105962,"conf":1},{"text":"Her dönemde kullanılması beklenen aşı miktarı, her antijen için dönem hedef nüfusu göz","x0":0.2298864117609637,"x1":0.7762808429339723,"top":0.6928566549039489,"bottom":0.7075742737320947,"conf":1},{"text":"önünde bulundurularak ayrı ayrı hesaplanmalıdır. Yıllık hedef nüfus dörde bölünerek üç aylık","x0":0.19704621795372126,"x1":0.77625822677939,"top":0.7051719492031088,"bottom":0.7190810739198431,"conf":1},{"text":"dönem hedef nüfusu bulunur. Belirlenen hedef nüfus uygulanan aşı doz sayısı ile çarpılarak","x0":0.1970667166026857,"x1":0.7762558464701472,"top":0.7177396898349254,"bottom":0.7323453342566251,"conf":1},{"text":"yapılacak aşı miktarı hesaplanır (örneğin katsayı DaBT-İPA-Hib ve KPA için dört, Hep B için üç,","x0":0.19697997282182403,"x1":0.7762476291781005,"top":0.7282040363146143,"bottom":0.7445979390850886,"conf":1},{"text":"BCG için bir, vb olmalıdır). Hesaplanan așı miktarına fire payı ve rezerv stok eklendikten sonra","x0":0.19704485323774007,"x1":0.7762580798144103,"top":0.742011150059293,"bottom":0.7562364316687222,"conf":1},{"text":"çıkan miktar ilin üç aylık ihtiyacını yansıtmaktadır. Son olarak hesaplanan bu miktardan il depo","x0":0.19701930157700595,"x1":0.7762706474501733,"top":0.7542120949747493,"bottom":0.7689483161578088,"conf":1},{"text":"mevcudu çıkarılarak nihai üç aylık istek miktarı bulunmalıdır.","x0":0.19712525221776045,"x1":0.5667351172702847,"top":0.7688034189880513,"bottom":0.7805232559322401,"conf":1}]}