{"lines":[{"text":"546","x0":0.06776180656628569,"x1":0.10266940472734884,"top":0.030523255656540016,"bottom":0.04215116287971166,"conf":1},{"text":"Rezerv stok miktarı; merkez depoda 3 aylık, bölge ve il depolarında 1 aylık, ilçe ve Sağlık","x0":0.24633269403908087,"x1":0.7968175139241134,"top":0.23770823476320124,"bottom":0.25399239977878874,"conf":1},{"text":"Ocağı/Aile Hekimliği depolarında 1 haftalık ihtiyacı karşılayacak şekilde planlanmalıdır.","x0":0.21552906004592826,"x1":0.7433965167796042,"top":0.25039254188111504,"bottom":0.26610457566642154,"conf":1},{"text":"Il depolarında merkez depodan nakliyat zamanı da hesaplanarak rezerv stoğa ihtiyaç","x0":0.2483896351332262,"x1":0.7967927650337514,"top":0.26289983046344134,"bottom":0.27723458247290655,"conf":1},{"text":"duyulmadan önce yeni aşı talepleri yapılmalıdır. Rezerv stok aşıları diğer aşılardan ayrı bir yerde","x0":0.21760063822249792,"x1":0.796781391439132,"top":0.2755990978327574,"bottom":0.28961767501719005,"conf":1},{"text":"tutulmamalıdır. Rezerv stok için planlanan aşılar her bir sevkiyatta yenileri ile değiştirilmeli, daha","x0":0.21756237708979329,"x1":0.7968175976252376,"top":0.2875496033777518,"bottom":0.3031239070292193,"conf":1},{"text":"erken miatlı aşıların kullanımına öncelik verilmelidir.","x0":0.21560574434645358,"x1":0.5359342965187442,"top":0.30213675205650903,"bottom":0.3154069769293263,"conf":1},{"text":"Açılan aşıların kullanım sürelerinin sınırlı olması ve enjektörlerdeki ölü boşluklar vb.","x0":0.2505133548574361,"x1":0.7946611830391168,"top":0.3341880341087702,"bottom":0.345930232677913,"conf":1},{"text":"nedenlerle çok dozlu flakonlardaki aşının tamamı kullanılamayabilir. Açılan flakonlardaki aşıdan","x0":0.21759828043954954,"x1":0.7967669299492608,"top":0.3457625786691758,"bottom":0.3592289996171718,"conf":1},{"text":"kullanılamayan miktarın açılan doza oranına fire payı denir. Bunun 100 ile çarpımı fire yüzdesini","x0":0.21758142642290293,"x1":0.796822329158695,"top":0.3580147248409067,"bottom":0.37349974827423327,"conf":1},{"text":"donmaya veya sıcağa maruz kalan aşılar, miadının dolması gibi nedenlerle aşının kullanılamaz","x0":0.21765914142561305,"x1":0.7987679634928553,"top":0.39680232545134153,"bottom":0.4085470084643448,"conf":1},{"text":"hale gelmesi) ise zayi olarak tanımlanmaktadır. Zayi öngörülmeyen bir kayıp olduğundan ihtiyaç","x0":0.21765914129531844,"x1":0.7987679633625606,"top":0.40982905977791906,"bottom":0.4215116280264395,"conf":1},{"text":"Fire yüzdesi aşı cinsine, aşı seanslarının sıklığına ve yerleşim yerlerinin dağınıklığına göre","x0":0.24845995073665458,"x1":0.7987679753172169,"top":0.43459302312832526,"bottom":0.4462209303514969,"conf":1},{"text":"değişir. Ilk ihtiyaç planlamasında il düzeyindeki fire yüzdeleri dikkate alınmalı ancak bu yüzdenin","x0":0.21765914122436975,"x1":0.798767963291612,"top":0.44767441847935363,"bottom":0.4594017095702292,"conf":1},{"text":"kurum düzeyinde değişebileceği bilinmeli ve daha sonraki dönemlerde ihtiyaç planlamasında o","x0":0.215605753986213,"x1":0.7987679625525674,"top":0.45930232538801075,"bottom":0.47238372111596716,"conf":1},{"text":"kuruma ait fire yüzdeleri dikkate alınmalıdır.","x0":0.21560575135609628,"x1":0.48254619919915664,"top":0.4722222221018123,"bottom":0.4854700853496756,"conf":1},{"text":"Fire yüzdesini hesaplamak için aşağıdaki formül kullanılır:","x0":0.24632072623497367,"x1":0.5997048341268267,"top":0.48339413939635434,"bottom":0.4987762271364782,"conf":1},{"text":"Fire yüzdesi =","x0":0.2586774430963845,"x1":0.34501865522949454,"top":0.5056283654732052,"bottom":0.5176274480385128,"conf":1},{"text":"(Açılan flakon doz sayısı - Uygulanan doz sayısı)","x0":0.387972082370184,"x1":0.6859572100141059,"top":0.5044111538059168,"bottom":0.5183936364552391,"conf":1},{"text":"x 100","x0":0.25785416816760304,"x1":0.2964639853772735,"top":0.5175701087554955,"bottom":0.5295058139567341,"conf":1},{"text":"Açılan flakon doz sayısı","x0":0.3819301866344752,"x1":0.52977412