549337,"top":0.27224339668181563,"bottom":0.29138932313288723,"conf":1},{"text":"9000","x0":0.6529774135424408,"x1":0.6817248452871281,"top":0.2863372091182774,"bottom":0.2965116278366644,"conf":1},{"text":"CERTIFICATE","x0":0.7206088534539163,"x1":0.7763661061943727,"top":0.28980923719141294,"bottom":0.2982571752790719,"conf":0.30000001192092896},{"text":"ENELG","x0":0.47214778283532943,"x1":0.5259470072829281,"top":0.3210293700961939,"bottom":0.329279309093642,"conf":1},{"text":"021/14","x0":0.4810559220660543,"x1":0.527505124357965,"top":0.3277728083618897,"bottom":0.3427996426378771,"conf":1},{"text":"Yenidoğan sağlığında öncelikli konular olan; doğum öncesi bakımın nitelik ve nicelik olarak","x0":0.24024640067152317,"x1":0.7967145847494215,"top":0.3559829060189408,"bottom":0.3662790698224325,"conf":1},{"text":"düzeltilmesi, her doğum için sağlıklı ve güvenli koşulların sağlanması, doğum sırasında ve erken","x0":0.20533881666419174,"x1":0.7967145712269941,"top":0.36752136771849264,"bottom":0.3779069767991414,"conf":1},{"text":"yenidoğan döneminde optimal yaklaşımın sağlanması, yüksek riskli gebe ve yenidoğanın tanınması","x0":0.2032854301454035,"x1":0.7987679577064297,"top":0.37936046499052645,"bottom":0.3910256409093664,"conf":1},{"text":"uygun bakım ve sevk zincirinin sağlanması önem taşımaktadır.","x0":0.20526233989774106,"x1":0.5667982944019733,"top":0.390801229535785,"bottom":0.40272322546494876,"conf":1},{"text":"Yenidoğan döneminde karşılaşılan sorunlardan biri olan Yenidoğanın Hemorajik Hastalığı, K","x0":0.23814722051372758,"x1":0.7967799754473166,"top":0.4008656676873882,"bottom":0.414760885061228,"conf":1},{"text":"vitamini eksikliği sonucu ortaya çıkan bir tablodur. Yenidoğan bebeklere doğumu takiben yapılacak K","x0":0.20533881667530732,"x1":0.7967145712381096,"top":0.41410256406235424,"bottom":0.4260683760281663,"conf":1},{"text":"vitamini, bu vitaminin eksikliğine bağlı kanamaları önleyecektir. Koruyucu sağlık hizmetleri","x0":0.2032854302042676,"x1":0.7987679577652939,"top":0.42587209296389417,"bottom":0.43604651168228115,"conf":1},{"text":"kapsamında, doğum sonrası tüm yenidoğanlara K vitamini uygulamasının sağlanması, personelin","x0":0.2032854301770167,"x1":0.798767957738043,"top":0.4374999998744229,"bottom":0.449145299019722,"conf":1},{"text":"bilgilendirilmesi ve doğru uygulamaların sürdürülmesi önem arz etmektedir.","x0":0.2052428511874336,"x1":0.6468807690900561,"top":0.4480996033853051,"bottom":0.4617060294286932,"conf":1},{"text":"Bu kapsamda yapılacak çalışmalarda aşağıdaki hususlara riayet edilecektir.","x0":0.24845996144069443,"x1":0.6837782313663482,"top":0.46068376087992,"bottom":0.47238372105056814,"conf":1},{"text":"Tüm yenidoğanlara doğumun ardından doğum salonunda yapılacaktır.","x0":0.27310060829641225,"x1":0.6817248537336099,"top":0.47222222216480825,"bottom":0.48418803413062017,"conf":1},{"text":"2) Yenidoğan proflaksisinde genel uygulama dozu 1 mg intramusküler (IM) şeklindedir.","x0":0.25051335559555815,"x1":0.7967145702763507,"top":0.4840116277815524,"bottom":0.49572649583802086,"conf":1},{"text":"Bebek doğum ağırlığı 1500 gramın altında ise doz 0,5 mg IM olarak yapılacaktır.","x0":0.20533880587054298,"x1":0.6735112966835343,"top":0.495639534756525,"bottom":0.5072674419796966,"conf":1},{"text":"3) K vitamininin hazırlanması ve uygulanması sırasında yürürlükte bulunan hasta ve çalışan","x0":0.24845995064244022,"x1":0.7987679752230025,"top":0.5072649572911112,"bottom":0.518895348958143,"conf":1},{"text":"güvenliği ile ilgili mevzuatta belirtilen usul ve esaslara uyulacaktır.","x0":0.2053388073602468,"x1":0.591375764405667,"top":0.5188034188476296,"bottom":0.5305232553842653,"conf":1},{"text":"4) Her bebek için ayrı ampul açılacaktır.","x0":0.25051335013294507,"x1":0.4969199145341127,"top":0.5319767441246365,"bottom":0.5423076921799364,"conf":1},{"text":"5) K vitamini ışıktan etkilendiği için kullanımdan hemen önce enjektöre çekilmeli, önceden","x0":0.25051333794373976,"x1":0.79876797602519,"top":0.5421511626651012,"bottom":0.5538461539480289,"conf":1},{"text":"hazırlanıp bekletilmemelidir.","x0":0.20328542229394173,"x1":0.373716630875647,"top":0.5551282053207207,"bottom":0.5654069767945319,"conf":1},{"text":"6) K vitamini ampullerinin, görünüm bakımından benzer ampuller ile ilaç tepsisinde yan","x0":0.2463148527350884,"x1":0.7988890381260914,"top":0.5617119867585766,"bottom":0.5801165512492616,"conf":1},{"text":"yana durması önlenecektir.","x0":0.20291052791762818,"x1":0.3596291406438789,"top":0.5760688791536961,"bottom":0.5902765324601843,"conf":1},{"text":"7) K vitamininin temini ve sürekliliğinin sağlanması sorumluluğu sağlık kuruluşlarının","x0":0.24842241106570007,"x1":0.7988126153880815,"top":0.5883457626246243,"bottom":0.6017176393982956,"conf":1},{"text":"yönetimindedir.","x0":0.20314832032318497,"x1":0.29986205872429117,"top":0.6009327669299144,"bottom":0.6125553384675517,"conf":1},{"text":"8) Il sağlık müdürlükleri sağlık kuruluşlarında sürekli K vitamini bulunma durumunu","x0":0.2484599506777979,"x1":0.7987679752583602,"top":0.6119186045244255,"bottom":0.6235465117475971,"conf":1},{"text":"kontrol edecektir.","x0":0.20328541983338935,"x1":0.30800821431657877,"top":0.6249999999944419,"bottom":0.6337606837551256,"conf":1},{"text":"9)","x0":0.24845995903002807,"x1":0.2669404513601156,"top":0.6366279068990128,"bottom":0.645348837112615,"conf":1},{"text":"Ailelerin uygulamayı reddetmesi durumunda öncelikle bilgilendirme yapılacak, ailenin","x0":0.26899384218827394,"x1":0.7987679648761707,"top":0.6350427352077483,"bottom":0.6470085471735604,"conf":1},{"text":"kararını değiştirmemesi halinde ekte yer alan form doldurularak imza altına alınacak hasta dosyasında","x0":0.20533882220518235,"x1":0.7987679632670968,"top":0.646802325720386,"bottom":0.6585470087333891,"conf":1},{"text":"muhafaza edilecektir. Ayrıca formun bir kopyası aileye verilecek, bir kopyası da resmi yazı ile il","x0":0.20529252216080462,"x1":0.7988291205232027,"top":0.6583482906041808,"bottom":0.672943196816099,"conf":1},{"text":"sağlık müdürlügüne iletilecektir.","x0":0.203285421040536,"x1":0.39425051306413417,"top":0.6713675215410809,"bottom":0.6816860465619737,"conf":1},{"text":"10) Aile tarafından uygulamanın reddedildiği durumda bebekte sekel ya da ölüm tespit","x0":0.248419706679217,"x1":0.7988388049117217,"top":0.6812464999790503,"bottom":0.695284874464164,"conf":1},{"text":"edilirse konu, il sağlık müdürlüğü tarafından adli makamlara intikal ettirilecektir.","x0":0.205338805041119,"x1":0.6714579093549983,"top":0.6931623933199952,"bottom":0.7051282052858071,"conf":1},{"text":"11) 18/03/2010 tarih ve 2010/17 sayılı Genelge yürürlükten kaldırılmıştır.","x0":0.24845996064148215,"x1":0.6817248440680239,"top":0.7049418603384826,"bottom":0.7166666665779449,"conf":1},{"text":"Konu ile ilgili olarak doğum yapılan tüm sağhık kuruluşlarının bilgilendirilmesi ve uygulamanın","x0":0.22792607791760633,"x1":0.7987679674892886,"top":0.7165697673109968,"bottom":0.7282051282733021,"conf":1},{"text":"devamlılığının sağlanması için gerekli çalışmaların yürütülmesi hususlarında;","x0":0.20321898347778444,"x1":0.6530512216716516,"top":0.7276070473581324,"bottom":0.7412226270447455,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.2505133458236284,"x1":0.46201232128911923,"top":0.7397435897274289,"bottom":0.7514534884886239,"conf":1},{"text":"Joç De Tolga TOLUNA","x0":0.6427104729282483,"x1":0.786447638570725,"top":0.7558139536273627,"bottom":0.7675213675371444,"conf":1},{"text":"Bakan a.","x0":0.689944634023356,"x1":0.7538600435404712,"top":0.7680607203365059,"bottom":0.7778515956980219,"conf":1},{"text":"Bakan Yardımcısı","x0":0.659137578305317,"x1":0.7700205322858426,"top":0.7803418804062292,"bottom":0.7893162393805883,"conf":1},{"text":"EKLER:","x0":0.2032521232086995,"x1":0.24849325654224932,"top":0.8022514404569971,"bottom":0.8125741408596727,"conf":1},{"text":"1- K Vitamini Uygulaması Ebeveyn Bilgilendirme ve Ret Formu (1 sayfa)",