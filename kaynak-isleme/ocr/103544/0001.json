{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.44969198667893884,"x1":0.9609856308748276,"top":0.040598290285432825,"bottom":0.055232557978324825,"conf":1},{"text":"7.3.3. MHRS Genelgesi (2021/12)","x0":0.11704311585734746,"x1":0.4845995944107596,"top":0.11025641030791011,"bottom":0.1294871795386794,"conf":1},{"text":"ISTATISTIK ANALIZ VE RAPORLAMA VE STRATEJK","x0":0.616016429097426,"x1":0.8357289505593648,"top":0.1773255814674648,"bottom":0.1846153848012364,"conf":1},{"text":"YONETİM DAIRESI BAŞKANLIGI","x0":0.6180698130465263,"x1":0.7556468191916669,"top":0.1845930232585835,"bottom":0.19331395347218572,"conf":1},{"text":"09/12/2021 14:42 - E-32693113 - 010 06 01 - 802","x0":0.6179073724414053,"x1":0.7988733818374243,"top":0.18999756274113322,"bottom":0.20074907831709643,"conf":1},{"text":"00154157867","x0":0.7084188921378427,"x1":0.7597535915171882,"top":0.22238372085250124,"bottom":0.23110465106610345,"conf":1},{"text":"T.C.","x0":0.4517453802334885,"x1":0.48870636489366365,"top":0.23837209319093633,"bottom":0.2514534881037864,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.38572120221899797,"x1":0.550531050769151,"top":0.24845710955208433,"bottom":0.2662377745992327,"conf":1},{"text":"Kamu Hastaneleri Genel Müdürlüğü","x0":0.34291580657183773,"x1":0.593429162422002,"top":0.2658119661281608,"bottom":0.2805232556562496,"conf":1},{"text":"Sayı : E-32693113-719","x0":0.1476407454250001,"x1":0.3308259030624982,"top":0.2920257928889429,"bottom":0.30837233228035454,"conf":1},{"text":"Konu : MHRS","x0":0.14778924272074556,"x1":0.2608349870573916,"top":0.3064712718574232,"bottom":0.3214357048590799,"conf":1},{"text":"GENELGE","x0":0.42706061107190335,"x1":0.509284357983982,"top":0.3327236394491999,"bottom":0.3475089186172229,"conf":1},{"text":"2021/12","x0":0.4455215288701844,"x1":0.5072505448801413,"top":0.34723272757860024,"bottom":0.36061610957703727,"conf":1},{"text":"Bakanlığımıza bağlı sağlık tesislerinde, Merkezi Hekim Randevu Sistemi (MHRS)","x0":0.19301848891354353,"x1":0.7864476299754578,"top":0.389534883870019,"bottom":0.4042735039107821,"conf":1},{"text":"kapsamında verilecek muayene randevusu hizmetlerine ilişkin usûl ve esaslar Yönerge","x0":0.14989736234746318,"x1":0.7864476198907295,"top":0.4025641025427549,"bottom":0.4158119657906181,"conf":1},{"text":"(Merkezi Hekim Randevu Sistemi Çalışma Usul ve Esasları Hakkında Yönerge) ile","x0":0.14784394998502168,"x1":0.7864476309289455,"top":0.4170940171297043,"bottom":0.4303418803775675,"conf":1},{"text":"oluşturulmuştur.","x0":0.14765547548037575,"x1":0.2649591876725283,"top":0.42994343712796623,"bottom":0.4445048131290471,"conf":1},{"text":"Il sağlık müdürü, MHRS hizmetlerinin planlanması, yürütülmesi, denetlenmesi,","x0":0.19096510125362376,"x1":0.7843942423155381,"top":0.44316239277006053,"bottom":0.4578488370444411,"conf":1},{"text":"raporlanması ve geliştirilmesinden sorumludur. MHRS ye ilışkin süreçler, il saglık müdurünun","x0":0.14784393073761146,"x1":0.7843942620839688,"top":0.45930232545619054,"bottom":0.47094017086235596,"conf":1},{"text":"sorumluluğunda kamu hastaneleri başkanı ile birlikte yürütülmektedir.","x0":0.1477607576270783,"x1":0.6243375385251851,"top":0.469355063052478,"bottom":0.48602398104261635,"conf":1},{"text":"Sağlık tesislerinde MHRS uygulamalarının planlanması, yürütülmesi, denetlenmesi,","x0":0.1929742394613674,"x1":0.7864886599949223,"top":0.48367490718534545,"bottom":0.49980648675562667,"conf":1},{"text":"raporlanması ve geliştirilmesinden, hekim çalışma cetvellerinin sisteme girilmesinin","x0":0.14784395022829008,"x1":0.786447631172214,"top":0.4985465117712963,"bottom":0.5132478635239442,"conf":1},{"text":"sağlanması, takip edilmesi, çalışma cetvellerinin izin ve görevlendirmeler dikkate alınarak","x0":0.14989731884222965,"x1":0.7864476501885869,"top":0.5130813951567715,"bottom":0.526162790884728,"conf":1},{"text":"düzenlenmesinden, randevulu hastaların randevu saatinde muayene olabilmeleri için gerekli","x0":0.14989731897816275,"x1":0.78644765032452,"top":0.5260683759973034,"bottom":0.5377906977929056,"conf":1},{"text":"tüm tedbirlerin alınması, hastaların sağlık tesisinden ayrılmadan önce uygun görülen ilk","x0":0.14784394998798275,"x1":0.7864476309319066,"top":0.5405982907666231,"bottom":0.5538461540144863,"conf":1},{"text":"muayene ve kontrol randevularının verilmesine ilişkin süreçlerin planlanmasından başhekimler","x0":0.14778298687908067,"x1":0.7865012840233143,"top":0.5523037059099909,"bottom":0.5684126377530231,"conf":1},{"text":"sorumludur.","x0":0.14989733170549724,"x1":0.2361396292459059,"top":0.5683139533891108,"bottom":0.5784883721074977,"conf":1},{"text":"Hekim çalışma cetvellerinin planlanması, uygulanması ve polikliniklerde randevulu","x0":0.19295930979964515,"x1":0.7865191561357054,"top":0.5796738525254587,"bottom":0.5968772943735615,"conf":1},{"text":"muayene süreçlerinin takibi, hizmete erişim ve hasta memnuniyeti açısından önceliğimizi","x0":0.14989731884348537,"x1":0.7864476501898426,"top":0.5957264958095614,"bottom":0.6076923077753733,"conf":1},{"text":"oluşturmaktadır. Bu minvalde;","x0":0.14784394109168988,"x1":0.35934291655718076,"top":0.6089743587737171,"bottom":0.6235465112945734,"conf":1},{"text":"1) Sağlık tesislerinde aktif görev yapmakta olan hekimlerin aylık çalışma programları","x0":0.19500647531602255,"x1":0.7865359617173603,"top":0.6213471554281463,"bottom":0.638980986419712,"conf":1},{"text":"nitelikli bir şekilde planlanmalıdır.","x0":0.147843942346609,"x1":0.3860369607513286,"top":0.6366279071805188,"bottom":0.649709302093369,"conf":1},{"text":"2) Sağlık hizmetlerine erişimi kolaylaştıracak şekilde az zamanda çok hasta bakılarak","x0":0.1950718762097163,"x1":0.7864476307725186,"top":0.6495726499113246,"bottom":0.6642441858923317,"conf":1},{"text":"değil yaygın poliklinik hizmeti planlanarak randevulu muayene kapasite artırımı sağlanmalıdır.","x0":0.14784394997809483,"x1":0.7864476309220185,"top":0.6641025639295699,"bottom":0.6787790696134036,"conf":1},{"text":"3) Muayene süresi hekime ve ilgili branşın özelliğine göre değişebildiğinden randevu","x0":0.19712526429521113,"x1":0.7885010188580135,"top":0.6773255815443442,"bottom":0.6918803421430729,"conf":1},{"text":"aralıkları en etkili şekilde hekimlerimiz tarafından oluşturulmalı ve başhekimliklerimizce","x0":0.14778607731689186,"x1":0.7885572074370552,"top":0.6900905675932324,"bottom":0.7064187206328876,"conf":1},{"text":"onaylanmalıdır. Kamuoyunda gündem olduğu gibi 5 dakikada bir muayene yapıldığı şeklindeki","x0":0.14784393234596843,"x1":0.7885010366905496,"top":0.704941860613914,"bottom":0.7196581198448293,"conf":1},{"text":"söylentilere sebep olacak uygulamalardan sakınılmalıdır.","x0":0.14784394597407113,"x1":0.5379876760177154,"top":0.7194767439923989,"bottom":0.7325581397203553,"conf":1},{"text":"4) MHRS'ye esas poliklinikler için tüm hekimlerin 30 günlük tanımlı çalışma cetveli","x0":0.1971252643037848,"x1":0.7885010188665871,"top":0.7324786325897445,"bottom":0.7470930231015426,"conf":1},{"text":"olmalı, periyodik olarak güncellenmeli ve sistemdeki görünürlüğünün 15 günün altına","x0":0.14784393232185444,"x1":0.7885010366664358,"top":0.7485465117770993,"bottom":0.7632478635297474,"conf":1},{"text":"düşmemesi sağlanmalıdır.","x0":0.14989732669505615,"x1":0.33059548622309426,"top":0.7645299147026368,"bottom":0.7761627908135287,"conf":1},{"text":"5) Ihtiyaç duyulması halinde mesai dışı poliklinik hizmeti sunulmalıdır.","x0":0.19712526151246557,"x1":0.6858316173165768,"top":0.7790598289967497,"bottom":0.7936046510049316,"conf":1},{"text":"6) Bakanlığımız SİNA ekranlarından MHRS verileri II Sağlık Müdürlükleri ve","x0":0.1971252652633307,"x1":0.790554406325245,"top":0.7948717949781898,"bottom":0.8095930230968255,"conf":1},{"text":"Başhekimliklerce takip edilerek gerekli tedbirler alınmalıdır.","x0":0.14978188332662465,"x1":0.5627320969422912,"top":0.8101631256112158,"bottom":0.8268834515376461,"conf":1},{"text":"MHRS ile ilgili süreçlerin yukarıdaki açıklamalar dikkate ahınarak hassasiyetle","x0":0.19712526430985283,"x1":0.7885010188726551,"top":0.8269230765600413,"bottom":0.8415697672873403,"conf":1},{"text":"yürütülmesi hususunda;","x0":0.14784394314653432,"x1":0.31622176522912765,"top":0.8430232559464764,"bottom":0.8576923074836234,"conf":1},{"text":"Bilgilerinizi ve gereğini rica ederim.","x0":0.19712525215057874,"x1":0.4476386080007431,"top":0.8589743589488558,"bottom":0.8735465114697121,"conf":1},{"text":"Dr. Fahrettin KOCA","x0":0.566281774062583,"x1":0.714968544002407,"top":0.8887930737218399,"bottom":0.9056846754799655,"conf":1},{"text":"2","x0":0.5420944554369224,"x1":0.5770020535979854,"top":0.8997093024539516,"bottom":0.921511627580404,"conf":1},{"text":"Bakan","x0":0.5907137696030859,"x1":0.6695127947823388,"top":0.8998726156809309,"bottom":0.9298242753155129,"conf":1},{"text":"agıtım","x0":0.1581108834982816,"x1":0.2073921963785151,"top":0.9229651162703792,"bottom":0.9316860464839815,"conf":1},{"text":"31 Il Valiliğine (Il Sağlık Müdürlugu","x0":0.15580957373547125,"x1":0.40474636640664713,"top":0.9313367507408097,"bottom":0.9458432325961532,"conf":1},{"text":"821","x0":0.8973305957824219,"x1":0.9281314163325679,"top":0.9433139536560525,"bottom":0.9563953485689027,"conf":1}]}