{"lines":[{"text":"T.C.","x0":0.43942505263904225,"x1":0.4784394237983294,"top":0.09883720927228723,"bottom":0.1133720926899221,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.3593429119314928,"x1":0.540041071459531,"top":0.11191860479242843,"bottom":0.12649572620100502,"conf":1},{"text":"Sağlık Eğitimi Genel Müdürlüğü","x0":0.32238192725958403,"x1":0.5770020561079724,"top":0.12936046492135822,"bottom":0.14244186064931463,"conf":1},{"text":"Sayı : B.10.0.SEG.0.72.00.03-010/1074","x0":0.12714195414761484,"x1":0.44381467020763976,"top":0.18302117394124906,"bottom":0.20231034064443243,"conf":1},{"text":"20.01.2010","x0":0.7019204022552674,"x1":0.8361633629902517,"top":0.1810365716017147,"bottom":0.19704925569835263,"conf":1},{"text":"уартак,","x0":0.12525667546629646,"x1":0.19507186717572955,"top":0.23110465119331436,"bottom":0.24563953461094923,"conf":0.30000001192092896},{"text":"sağlamak,","x0":0.12726289467462715,"x1":0.20538597579426135,"top":0.26004723851605327,"bottom":0.27483648236089264,"conf":1},{"text":"8. Kurumun sunduğu hizmetin nitelik, nicelik ve verimliliğini artırmak,","x0":0.17854757908007937,"x1":0.7064852963563792,"top":0.27318442012076893,"bottom":0.29074532844648604,"conf":1},{"text":"9.Hizmet sunumu aşamasında karşılaşılacak hataları azaltmak,","x0":0.18263273759308427,"x1":0.6387225553643963,"top":0.2877318394604791,"bottom":0.30382810618254685,"conf":1},{"text":"10. Personelin eğitim aldığı alanda değerlendirilmesini sağlamak ve","x0":0.1805912924382334,"x1":0.6674513532165549,"top":0.3032262842140714,"bottom":0.31963358081050064,"conf":1},{"text":"11. Tüm hizmet içi eğitim faaliyetlerinin merkez ve taşra teşkilatı birimlerinin işbirliği","x0":0.18055105525492718,"x1":0.809153457929315,"top":0.3162622174467522,"bottom":0.33585311040152155,"conf":1},{"text":"ve koordinasyonu içinde yapılması amaçlanmaktadır.","x0":0.12514223369732283,"x1":0.5155367097426108,"top":0.33211175118836644,"bottom":0.3488897923432769,"conf":1},{"text":"müsteşar veya görevlendireceği müsteşar yardımcısı başkanlığında, merkez teşkilatı ana","x0":0.12731004802373538,"x1":0.8069815327529902,"top":0.39230769215270755,"bottom":0.40555555540057076,"conf":1},{"text":"planlamalara dayandırılacak ve yürütülecektir.","x0":0.12525667632457593,"x1":0.4661190934879866,"top":0.42136752134390676,"bottom":0.4360465114716008,"conf":1},{"text":"Bakanlığın hizmet içi eğitim faaliyetlerine ilişkin hizmetleri yürütmek Sağlık Eğitimi Genel","x0":0.12512914239430428,"x1":0.8070732457044615,"top":0.4636160262677702,"bottom":0.48362687093042844,"conf":1},{"text":"Müdürlüğü'nün görevidir.","x0":0.12525667518346087,"x1":0.32032854020528295,"top":0.47948717985804024,"bottom":0.4941860463517218,"conf":1},{"text":"Yönetmelik doğrultusunda;","x0":0.1786447594874726,"x1":0.3819301889565154,"top":0.5085470087095372,"bottom":0.5232558137937657,"conf":1},{"text":"doğrultusunda Bakanlığın eğitim politikası ve amaçlarına uygun olarak birimlerin önerileri","x0":0.12511796477978437,"x1":0.8050501220264215,"top":0.5516797015891141,"bottom":0.5705531983375574,"conf":1},{"text":"dikkate alınarak, ilgili birimlerle işbirliği içinde oluşturulacak komisyonlar aracılığıyla yıllık","x0":0.12513230209885168,"x1":0.8050381116420047,"top":0.5665504638064035,"bottom":0.5846800864369874,"conf":1},{"text":"sonra Bakan onayı ile kesinleşerek uygulamaya konulacak ve eğitim çalışmalarının","x0":0.12720718782010138,"x1":0.8050255507376496,"top":0.5957399229957253,"bottom":0.6126702341498219,"conf":1},{"text":"başlamasından en az bir ay önce bütün birimlere duyurulacaktır.","x0":0.125256668654429,"x1":0.5893223864691962,"top":0.6119186047978328,"bottom":0.6264957262064095,"conf":1},{"text":"2-Il hizmet içi eğitim planı ise il sağlık müdürlüğünce hazırlanacak ve valilik onayı","x0":0.17644187716424453,"x1":0.8050840597046769,"top":0.6243169978037114,"bottom":0.6440442009772266,"conf":1},{"text":"alındıktan sonra yürürlüğe girecektir.","x0":0.12525667767862114,"x1":0.3983572850190175,"top":0.6409883722355866,"bottom":0.6555555558687226,"conf":1},{"text":"3-Merkez birimlerinin yıllık hizmet içi eğitim planında ve faaliyetlerinde Bakan onayı,","x0":0.17647438470950963,"x1":0.805046306707318,"top":0.6550622158796705,"bottom":0.6732698718923116,"conf":1},{"text":"il'e ait yıllık hizmet içi eğitim planında ve faaliyetlerinde ise valilik onayı alınmadan","x0":0.12515315909019245,"x1":0.802969529324284,"top":0.6684361680339805,"bottom":0.6874929112645557,"conf":1},{"text":"birim tarafından Sağlık Eğitimi Genel Müdürlüğü'ne bildirilecektir.","x0":0.12512909105488973,"x1":0.6161412768308495,"top":0.6987668055196871,"bottom":0.7157843151105533,"conf":1},{"text":"4-Bakanlık birimleri bir sonraki yılın planının zamanında hazırlanabilmesi amacıyla,","x0":0.17647983353851712,"x1":0.8030038673674924,"top":0.7128516183018626,"bottom":0.7312314051926587,"conf":1},{"text":"Müdürlüğü'ne bildireceklerdir.","x0":0.12525666938727614,"x1":0.3531827552964358,"top":0.7427325579394257,"bottom":0.7559829060387023,"conf":1},{"text":".Eğitimler; eğitilecek personeli, eğitim görevlilerini, eğitim yerlerini, eğitim","x0":0.1744091986688079,"x1":0.8029950694508137,"top":0.7569897407497621,"bottom":0.7757992027509432,"conf":1},{"text":"programlarına dayalı olarak yürütülecektir.","x0":0.12525668384334424,"x1":0.43737165311764137,"top":0.7863247862378802,"bottom":0.8008720926899221,"conf":1},{"text":"raporlar Makama ve Eğitim Kurulu'na sunulacak ve değerlendirilecektir.","x0":0.1251674967848671,"x1":0.6510328970692156,"top":0.8152332804068925,"bottom":0.831908794236833,"conf":1},{"text":"Prof. Dr. Nusret Fişek Cad. No:41 Yenişehir 06420 ANKARA","x0":0.12731006271453713,"x1":0.4640657068797238,"top":0.8546511627273904,"bottom":0.8649572651214291,"conf":1},{"text":"Ayrıntılı bilgi için irtibat: Dai.Bşk. M.HAYIRDOĞAN","x0":0.5009632901253311,"x1":0.8009093105445799,"top":0.8559371230860201,"bottom":0.8687049612951234,"conf":1},{"text":"Telefon: (0 312) 458 35 06 - 26","x0":0.127310062956355