{"lines":[{"text":"Sağlık Bakanlığı","x0":0.05749486591819599,"x1":0.13347022635035147,"top":0.07991452994296122,"bottom":0.08866279066923788,"conf":1},{"text":"T.C","x0":0.4845995897027666,"x1":0.5215605743629418,"top":0.05813953498994706,"bottom":0.07267441840758193,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.39630389787977516,"x1":0.60164271384793,"top":0.07264957301857267,"bottom":0.08866279100980656,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.34291580358425827,"x1":0.657084196259213,"top":0.09145299173077825,"bottom":0.10769230797009444,"conf":1},{"text":"tanınması, diyalizer pıhtılaşması gibi) açısından eğitim döneminde siz ve yakınınız gerekli eğitimleri","x0":0.11704310416256156,"x1":0.8829568956576115,"top":0.1220930229311401,"bottom":0.13808139566866606,"conf":1},{"text":"alacaksınız.","x0":0.11896287681126548,"x1":0.2096588034267856,"top":0.138045794380527,"bottom":0.1490578929048325,"conf":1},{"text":"Ev hemodiyalizi tedavisinin uygulanması ile ilgili olarak sizden herhangi bir ücret talep","x0":0.17659138535115762,"x1":0.882956857667323,"top":0.1816239316325925,"bottom":0.1978632478719088,"conf":1},{"text":"edilmeyecektir.","x0":0.11704312185965082,"x1":0.23819301756112263,"top":0.19767441874115832,"bottom":0.2122093021587932,"conf":1},{"text":"Ev hemodiyalizi tedavisine katılıp katılmamakta serbestsiniz. Eğer isterseniz karar vermeden","x0":0.17650892921421066,"x1":0.8830448866705666,"top":0.21062176424351264,"bottom":0.22901749216730527,"conf":1},{"text":"önce aile bireyleri ve arkadaşlarınızla görüşebilirsiniz.","x0":0.11704311242214828,"x1":0.523613971360234,"top":0.2281976745629115,"bottom":0.24273504242440658,"conf":1},{"text":"Bu formu okuduğunuz için teşekkür ederiz. Eğer ev hemodiyalizi tedavisini kabul ediyorsanız","x0":0.17447405555625844,"x1":0.8850814343302533,"top":0.24125588350658767,"bottom":0.25891274124981023,"conf":1},{"text":"aklınıza gelen tüm soruları sorunuz. Bu bilginin ve formun bir kopyasını mutlaka saklayınız.","x0":0.11704313005644457,"x1":0.8069815103797138,"top":0.25854700871521374,"bottom":0.2732558137994422,"conf":1},{"text":"Daha fazla bilgi ve yardıma ihtiyacım olduğunda kiminle irtibata geçebilirim?","x0":0.1190475770798488,"x1":0.7372421940595193,"top":0.2877611360068899,"bottom":0.3050846788707846,"conf":1},{"text":"Ev hemodiyalizi uygulamasıyla ilgili herhangi bir sorunuz olduğunda aşağıda belirtilen","x0":0.1765913909877078,"x1":0.8829568633038732,"top":0.30213675191047173,"bottom":0.318376068149788,"conf":1},{"text":"kişilerle günün 24 saati irtibata geçebilirsiniz.","x0":0.11909651205032493,"x1":0.4599589292137356,"top":0.318313953635449,"bottom":0.332905982522293,"conf":1},{"text":"Nefrolog adı ( lütfen yazınız) :","x0":0.11909650583165182,"x1":0.3490759782399234,"top":0.3473837205889474,"bottom":0.36337209332647336,"conf":1},{"text":"Hemşire adı ( lütfen yazınız)","x0":0.11881814031315426,"x1":0.3390318032136984,"top":0.3618685148889579,"bottom":0.37874686954025405,"conf":1},{"text":"Teknisyen adı (lütfen yazınız) :","x0":0.11909650824003991,"x1":0.3552361401456475,"top":0.37777777764857934,"bottom":0.392441860298006,"conf":1},{"text":"..telefon:","x0":0.6077854957413404,"x1":0.6714752845966013,"top":0.3487949505806167,"bottom":0.36196086304576913,"conf":1},{"text":".telefon :","x0":0.6118545099390507,"x1":0.6756198224198618,"top":0.3646508799795647,"bottom":0.37517470132940156,"conf":1},{"text":".telefon:","x0":0.6098562619937778,"x1":0.6735112942058749,"top":0.3793604652839595,"bottom":0.3924418601968096,"conf":1},{"text":"..ev hemodiyalizi ile ilgili verilen tüm bilgileri, yararlarını ve","x0":0.4106012061508403,"x1":0.8851334569207542,"top":0.40763688121438535,"bottom":0.4252681136472154,"conf":1},{"text":"olası risklerini sorular sormak ve tartışmak fırsatı verilerek okudum ve anladım. Bütün sorularıma beni","x0":0.1190532010116577,"x1":0.8830022804214219,"top":0.42292910198981915,"bottom":0.4384489532831386,"conf":1},{"text":"tatmin edecek şekilde cevap verildi ve ben ev hemodiyalizi uygulamasına katılmayı gönüllü olarak","x0":0.11696213836454679,"x1":0.8830358611577753,"top":0.43744647850960783,"bottom":0.4553034888537626,"conf":1},{"text":"kabul ediyorum. Kendi onayımla, herhangi bir zamanda bu diyaliz tedavisinden ayrılabileceğimi ve","x0":0.1190212363801037,"x1":0.8830287678379332,"top":0.4523255983987834,"bottom":0.4698427827948588,"conf":1},{"text":"eğer bunu yaparsam, bu durumun doktorlarımdan alacağım gelecekteki tedavi ve bakımı","x0":0.12108623352438082,"x1":0.8830227764458969,"top":0.4682162501153455,"bottom":0.4834584843698402,"conf":1},{"text":"etkilemeyeceğini anladım. Imzalanmış bu yazılı bilgilendirilmiş onay formunun bir kopyasını","x0":0.11898960689848927,"x1":0.8851247338634227,"top":0.48148791112351796,"bottom":0.5017282611783974,"conf":1},{"text":"Gönüllünün/velinin veya vasının ımzası","x0":0.11884752673639205,"x1":0.4191060663444445,"top":0.5276851026835441,"bottom":0.545079780685274,"conf":1},{"text":"(gönüllünün/velinin veya vasinin eksiksiz doldurması gereklidir.)","x0":0.11689389121284846,"x1":0.6059486345079852,"top":0.5410464999050586,"bottom":0.5602135588008543,"conf":1},{"text":"Gönüllünün/velinin veya vasinin","x0":0.11909651234738293,"x1":0.36550307674855054,"top":0.5581196578474827,"bottom":0.5726744184462115,"conf":1},{"text":"Adı-soyadı:","x0":0.11891404835441242,"x1":0.21168143400095113,"top":0.5720729094417427,"bottom":0.5878108114391051,"conf":1},{"text":"Adres:","x0":0.11909650891253555,"x1":0.17248459940368627,"top":0.5872093023800575,"bottom":0.6002906972929076,"conf":1},{"text":"Telefon:","x0":0.1186976975128563,"x1":0.18722154270113095,"top":0.6026862697617036,"bottom":0.6159415569973222,"conf":1},{"text":"tax no:","x0":0.11842342819599508,"x1":0.17726445545236222,"top":0.6180550973674019,"bottom":0.6319449024357197,"conf":1},{"text":"tarih","x0":0.745379878041164,"x1":0.7843942492004512,"top":0.5305232556261402,"bottom":0.5421511628493119,"conf":1},{"text":"Yukarıda adı-soyadı geçen katılımcıya ev hemodiyaliz tedavisiyle ilgili gerekli tüm bilgileri anlattım.","x0":0.11900230202440572,"x1":0.8727825701480832,"top":0.647773623840561,"bottom":0.666424371612517,"conf":1},{"text":"..d...","x0":0.6242299783768662,"x1":0.7289527728600557,"top":0.6656976742677053,"bottom":0.6773255814908771,"conf":0.5},{"text":"Nefrolog (ad-soyad, imza)","x0":0.11887109475710457,"x1":0.31848345509213516,"top":0.6770130880747369,"bottom":0.6931295303067874,"conf":1},{"text":"tarih","x0":0.6509240251237111,"x1":0.6878850097838862,"top":0.6802325579436468,"bottom":0.6918604651668184,"conf":1},{"text":"Hemşire (ad-soyad, imza)","x0":0.11890583965573447,"x1":0.3184831988748623,"top":0.7062814110394648,"bottom":0.7228570873950714,"conf":1},{"text":"tarih","x0":0.6509240251031774,"x1":0.6878850097633525,"top":0.710755813772135,"bottom":0.7223837209953068,"conf":1},{"text":"Teknisyen (ad-soyad, imza)","x0":0.11882834584465353,"x1":0.32879601787670654,"top":0.7367943413719051,"bottom":0.7537370763755151,"conf":1},{"text":"tarih","x0":0.6509240260630668,"x1":0.689938397222354,"top":0.7398255815634092,"bottom":0.7514534879714745,"conf":1},{"text":"Ben aşağıda imzası olan, bu formu imzalamış şahsın yukarıda ismi belirtilmiş olan doktor, hemşire ve","x0":0.11897938414755257,"x1":0.8830773981949377,"top":0.7666365165870601,"bottom":0.7853187649552826,"conf":1},{"text":"teknisyen tarafından tam ve dikkatli bir şekilde açıklanmış olan tedavi özelliklerini, ayrıca tedavinin","x0":0.1169030793945115,"x1":0.8830959203766003,"top":0.781307903189026,"bottom":0.8016332133989035,"conf":1},{"text":"getireceği yararları ve olası riskleri açıkça anladığına şahitlik ederim.","x0":0.11898108681936807,"x1":0.634628707466757,"top":0.7970279216401788,"bottom":0.814743310533241,"conf":1},{"text":"Kurumda görevli şahidin imzası","x0":0.1188975859978076,"x1":0.3615758027498103,"top":0.8269207626137054,"bottom":0.842908584339404,"conf":1},{"text":"J../...","x0":0.6570841890495126,"x1"