{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.4517453741326359,"x1":0.9609856318294125,"top":0.04059829029134332,"bottom":0.05523255798423521,"conf":1},{"text":"T.C.","x0":0.4804928134415594,"x1":0.5112936339917054,"top":0.24418604641562758,"bottom":0.25436046513401456,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.42505133642065,"x1":0.5708418885622386,"top":0.25290697688950514,"bottom":0.26598837180235535,"conf":1},{"text":"Yönetim Hizmetleri Genel Müdürlüğü","x0":0.3819301943250826,"x1":0.6139630347816935,"top":0.26452991480317145,"bottom":0.2790697671085267,"conf":1},{"text":"13) Yataklı Tedavi Kurumları Konut Yönergesi Bakanlık Makamının Onayı ile yürürlükten","x0":0.23613962539420402,"x1":0.7946611959712144,"top":0.3110465117735486,"bottom":0.32564102591935895,"conf":1},{"text":"kaldırılmıştır. Bu sebeple mülga yönergeye göre kendilerine konut tahsis edilenler süresi bitene kadar","x0":0.19499748911969142,"x1":0.7947374217876555,"top":0.3219402789684771,"bottom":0.33819816984909445,"conf":1},{"text":"mezkür konutlarda ikamet etmeye devam edeceklerdir. Süresi dolanlara tahsis iş ve işlemleri bu genelge","x0":0.1950718611106376,"x1":0.7946611985714334,"top":0.3341880340385154,"bottom":0.3474358972863787,"conf":1},{"text":"hükümleri çerçevesinde yapılacaktır.","x0":0.1971252570726857,"x1":0.4127310055364005,"top":0.34738372086806546,"bottom":0.3576923077059644,"conf":1},{"text":"14) Konutlar için puanlama kriterleri, personelin oturma süresi ve bu genelgede belirtilmeyen sair","x0":0.2381930125804049,"x1":0.7946611966583031,"top":0.3691860463196186,"bottom":0.3824786324098368,"conf":1},{"text":"hususlar hakkında 2946 sayılı Kamu Konutları Kanunu ve Kamu Konutları Yönetmeliği hükümlerine göre","x0":0.197125248233629,"x1":0.7946611991953129,"top":0.38226744173521143,"bottom":0.39401709404348795,"conf":1},{"text":"işlem yapılacaktır.","x0":0.19712525879553527,"x1":0.31006159927517274,"top":0.39529914541129996,"bottom":0.4055555556677102,"conf":1},{"text":"15) 2012/35 sayılı ve \"Taşra Teşkilatı Konut Tahsisi\" konulu Genelge yürürlükten kaldırılmıştır.","x0":0.23613963908986738,"x1":0.7823408537706602,"top":0.4170940174661484,"bottom":0.43168604635299235,"conf":1},{"text":"Bilgi ve gereği ile uygulamada herhangi bir aksamaya meydan verilmemesi için yukarıda belirtilen","x0":0.23607169982814066,"x1":0.7947418360273169,"top":0.43969631402717924,"bottom":0.45583615632955055,"conf":1},{"text":"hususlara titizlikle riayet edilmesini önemle rica ederim.","x0":0.19712525143381823,"x1":0.5174538036061089,"top":0.4520348835847966,"bottom":0.4636752138423754,"conf":1},{"text":"Dr. Fahreti KOCA","x0":0.6365275803796212,"x1":0.7536161565615335,"top":0.5013617588975094,"bottom":0.5160801015400083,"conf":0.5},{"text":"S Bakan","x0":0.6550308004843176,"x1":0.7145790550854976,"top":0.511538461503699,"bottom":0.5232558140040277,"conf":1},{"text":"EK : Görev Tahsisli Unvan Listesi (I sayfa)","x0":0.19712525215357304,"x1":0.44763860800373734,"top":0.6495726495671067,"bottom":0.66282051281497,"conf":1},{"text":"961","x0":0.8952772073413626,"x1":0.9281314166969672,"top":0.9433139533263986,"bottom":0.9549418605495703,"conf":1}]}