{"lines":[{"text":"T.C. SAĞLIK BAKANLIĞI YÖNERGELER VE GENELGELER KİTABI","x0":0.451745374969157,"x1":0.9630390191650458,"top":0.03760683777083451,"bottom":0.056837607001603674,"conf":1},{"text":"2.3.8. Poliklinik Hizmetlerinde Öncelik Sırası Genelgesi (2016/22)","x0":0.1252566694832998,"x1":0.8767967185830201,"top":0.10897435936624911,"bottom":0.13247863287052253,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.43326488445574274,"x1":0.5934291605418881,"top":0.23110465096316846,"bottom":0.24418604669112487,"conf":1},{"text":"Sağlık Hizmetleri Genel Müdürlüğü","x0":0.39219712573589993,"x1":0.6344969171388435,"top":0.24127907010041305,"bottom":0.2572674412077265,"conf":1},{"text":"TC Sağlık Bakanlığı","x0":0.205338810218198,"x1":0.30390143597866504,"top":0.27034883720950265,"bottom":0.27906976742310485,"conf":1},{"text":"GENELGE","x0":0.47429310510733436,"x1":0.5482941636650684,"top":0.3051317198387198,"bottom":0.3198682801059809,"conf":1},{"text":"2016/22","x0":0.49075975254848386,"x1":0.5359342924304934,"top":0.31831395367521953,"bottom":0.3313953485880696,"conf":1},{"text":"Ilgi : Poliklinik Hizmetlerinde Öncelik Sırast konulu 2010/73-80 sayılı Genelge","x0":0.20328541757503474,"x1":0.7186858347691475,"top":0.3430232559612494,"bottom":0.3576923074983963,"conf":1},{"text":"Bilindıği üzere, sağlık kurum ve kuruluşlarında özellikle poliklinik hizmetlerinde hasta","x0":0.2505133466883365,"x1":0.8213552362600187,"top":0.3691860463862202,"bottom":0.38081395360939185,"conf":1},{"text":"mağduriyetlerinin önlenmesi, hasta hakları mevzuatı başta olmak üzere mevzuatımızda toplumda","x0":0.20533880776134358,"x1":0.8213552372150353,"top":0.3822674418018186,"bottom":0.39244186052020547,"conf":1},{"text":"öncelikli olarak korunması ve özel tedbir alınması öngörülen vatandaşlarımızın sağlık hizmetinden","x0":0.20533880775564398,"x1":0.8213552372093358,"top":0.39529914542061695,"bottom":0.40555555567702717,"conf":1},{"text":"de öncelikli olarak yararlandırılmaları konusunda Bakanlığımızca ilgili Genelge ile düzenleme","x0":0.20533880775344585,"x1":0.8213552372071377,"top":0.4068376066460144,"bottom":0.41880341861182635,"conf":1},{"text":"yapılmıştır.","x0":0.20305105881472246,"x1":0.2793841474416071,"top":0.4197110835525737,"bottom":0.43250450387143813,"conf":1},{"text":"Diğer taraftan, 669 sayılı olağanüstü Hal Kapsamında Bazı Tedbirler Alınması ve Milli","x0":0.2505133466929688,"x1":0.821355236264651,"top":0.43162393168844093,"bottom":0.44188034194485115,"conf":1},{"text":"Savunma Üniversitesi Kurulması Ile Bazı Kanunlarda Değişiklik Yapılmasına Dair Kanun","x0":0.20732676247109602,"x1":0.8214209535183677,"top":0.4424296206217463,"bottom":0.4557877416622862,"conf":1},{"text":"Hükmünde Kararname'nin 106 neı maddesi ile; Gülhane Askeri Tıp Akademisine bağlı eğitim","x0":0.2053388076703574,"x1":0.8213552371240492,"top":0.4563953487091905,"bottom":0.46802325593236227,"conf":1},{"text":"hastaneleri ve Türk Silahlı Kuvvetleri Rehabılitasyon ve Bakım Merkezleri ile asker hastaneleri,","x0":0.20533880775706456,"x1":0.8213552372107564,"top":0.46947674412747153,"bottom":0.4796511628458584,"conf":1},{"text":"dispanser ve benzeri sağlık hizmet birimleri ile Jandarma Genel Komutanlığı'na ait sağlık kuruluşları","x0":0.205338807735189,"x1":0.8213552371888808,"top":0.48110465103638245,"bottom":0.4927350427034143,"conf":1},{"text":"Bakanlığımıza devredilmiştir. Ayrıca, şehit yakınları ve gazilere sağlık hizmeti sunumunda öncelik","x0":0.20739220921680945,"x1":0.8213552152698438,"top":0.49273255827852536,"bottom":0.5043604646865908,"conf":1},{"text":"tanınacağı ve askeri personel ile bakmakla yükümlü olduğu kişilere devredilen sağlık kuruluşlarında","x0":0.20533880779991256,"x1":0.8213552372536044,"top":0.5058139533623497,"bottom":0.5175213676796845,"conf":1},{"text":"öncelikli hizmet verileceği hüküm altına alınmıştır.","x0":0.2032854149984254,"x1":0.521560580671604,"top":0.518803418920945,"bottom":0.5320512821688081,"conf":1},{"text":"Bu kapsamda 669 sayılı KHK ile Bakanlığımıza devredilen Gülhane Askeri Tip Akademisine","x0":0.24845995936921578,"x1":0.8213552354400102,"top":0.5303418802156245,"bottom":0.5436046513493081,"conf":1},{"text":"bağlı eğitim hastaneleri ve Türk Silahlı Kuvvetleri Rehabilitasyon ve Bakım Merkezi ile asker","x0":0.2053388077495699,"x1":0.8213552372032618,"top":0.5435897435592031,"bottom":0.5552325582606421,"conf":1},{"text":"hastaneleri, dispanser ve benzeri sağlık hizmet birimlerinde (devredilen-askeri-sağlık kuruluşlarının)","x0":0.20533880766554735,"x1":0.8213552371192392,"top":0.5551282052571938,"bottom":0.5668604652357897,"conf":1},{"text":"genel hizmetin aksamasına meydan vermeyecek şekilde poliklinik muayenelerinde öncelik sırası","x0":0.2053388077554551,"x1":0.8213552372091469,"top":0.5683139533629891,"bottom":0.5799418605861607,"conf":1},{"text":"alacak gruplar aşağıdaki şekilde uygulanacaktır.","x0":0.20328541786242793,"x1":0.5051334730919378,"top":0.5811965813149138,"bottom":0.5944767443707251,"conf":1},{"text":"1.","x0":0.24845995883153008,"x1":0.26488706350933233,"top":0.5915697675290401,"bottom":0.6046511624418902,"conf":1},{"text":"Acil vakalar (Ani gelişen hastalık, kaza, yaralanma ve benzeri durumlar ile ivedilikle","x0":0.29568788562998843,"x1":0.8213552353196614,"top":0.5930232556883374,"bottom":0.6047008546415844,"conf":1},{"text":"tıbbi müdahale yapılması gerektiğine hekim tarafindan karar verilen vakalar),","x0":0.24845996128941025,"x1":0.7310061575961855,"top":0.6059829058851666,"bottom":0.6192307691330299,"conf":1},{"text":"Engelli hastalar,","x0":0.29568788388624767,"x1":0.4004106783694371,"top":0.6175213676325261,"bottom":0.629487179598338,"conf":1},{"text":"3.","x0":0.2525667351507511,"x1":0.2648870633708095,"top":0.6308139534106407,"bottom":0.6395348836242429,"conf":1},{"text":"Hamileler,","x0":0.2927950589504076,"x1":0.36668758545014546,"top":0.6282269165893946,"bottom":0.6443941790661282,"conf":1},{"text":"4.","x0":0.25051334728285624,"x1":0.2648870631551999,"top":