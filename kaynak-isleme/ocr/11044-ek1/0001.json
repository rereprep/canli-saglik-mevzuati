{"lines":[{"text":"T.C.","x0":0.4784394239300792,"x1":0.5195071877331651,"top":0.04360465127070423,"bottom":0.05668604631650509,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.4065708399053571,"x1":0.593429159911207,"top":0.05668604621784146,"bottom":0.07130657550992114,"conf":1},{"text":"Tedavi Hizmetleri Genel Müdürlüğü","x0":0.3531827520919076,"x1":0.6468172496929605,"top":0.07258753210058622,"bottom":0.08720930255377457,"conf":1},{"text":"T.C.","x0":0.7002053386107187,"x1":0.7310061603112525,"top":0.017441860546273502,"bottom":0.027616278734249766,"conf":1},{"text":"SAĞLIK BAKANLIĞI","x0":0.6580253036846695,"x1":0.8101471838888749,"top":0.022192961950459278,"bottom":0.043214014114721144,"conf":1},{"text":"Tedavi Hiz. Genel Müd.Organ Nakli","x0":0.6620652259535764,"x1":0.8966758341880741,"top":0.026907738082747712,"bottom":0.05335198996008694,"conf":1},{"text":"Hizmetleri Şb.","x0":0.6624913201538029,"x1":0.7543145018221443,"top":0.048519364716306024,"bottom":0.06303728158381705,"conf":1},{"text":"02 Ocak 2012 13:49:59","x0":0.6642531110403374,"x1":0.8141609096231422,"top":0.05488791683889882,"bottom":0.0757402297299199,"conf":1},{"text":"174","x0":0.8357289527709751,"x1":0.86036960967069,"top":0.05377906989451553,"bottom":0.06540697651140404,"conf":0.5},{"text":"13014550","x0":0.670780113628444,"x1":0.7336931098929156,"top":0.09940965895740239,"bottom":0.11223613628834073,"conf":1},{"text":"Sayı : B.10.0.THG.0.14.00.03.020","x0":0.11686433748985277,"x1":0.39649799313009093,"top":0.1025185780291542,"bottom":0.11940686177581006,"conf":1},{"text":"Konu : Organ Nakli Merkezleri 2012 Yılı Planlaması","x0":0.11691806677664232,"x1":0.5298935807693205,"top":0.11667128941596472,"bottom":0.1343272280506661,"conf":1},{"text":"GENELGE","x0":0.42286666719278915,"x1":0.5155316898907908,"top":0.14777633498604947,"bottom":0.1618166882414802,"conf":1},{"text":"2011/..6.7/","x0":0.42487090350716095,"x1":0.5196876181763563,"top":0.15796992628059425,"bottom":0.17778588756293512,"conf":1},{"text":"2010/67 sayılı Genelge ile Organ Nakli Merkezlerinin 2011 yılı planlaması ile Organ Nakli","x0":0.174446324259526,"x1":0.8830957430397193,"top":0.19035922974413833,"bottom":0.21006703246861014,"conf":1},{"text":"Yönergesinde Bakanlık Makamının 24/08/2010 tarihli ve 34208 sayılı Onayı ile yapılan değişiklikle","x0":0.11696377286209798,"x1":0.8830573724856261,"top":0.20563714974760516,"bottom":0.22408975500406125,"conf":1},{"text":"eklenen Ek 1 inci maddesinde organ nakli merkezlerinin Bakanlıkça yapılacak planlamaya göre","x0":0.11704313123915573,"x1":0.8829568688080341,"top":0.22238372064162215,"bottom":0.23697694276049175,"conf":1},{"text":"açılacağı,","x0":0.11683840645245437,"x1":0.19322319500249494,"top":0.2392721633021122,"bottom":0.2549138831430309,"conf":1},{"text":"ülke genelinde yeni merkez açılmasına ihtiyaç duyulan hizmet bölgeleri ve ihtiyaç","x0":0.1928862079497979,"x1":0.883083033060192,"top":0.23407879234450546,"bottom":0.25518436073921924,"conf":1},{"text":"kapasitesi belirlenerek Bakanlık internet sitesinden ilan edileceği bildirilmişti.","x0":0.11695007762833164,"x1":0.698206520228158,"top":0.24978683110572986,"bottom":0.2689886293859458,"conf":1},{"text":"Bahse konu Yönergenin Ek 1 inci maddesi hükümleri gereğince; illerin demografik yapısı,","x0":0.16421425109349871,"x1":0.8830097326048589,"top":0.26481715598525457,"bottom":0.28384010734753207,"conf":1},{"text":"organ bekleme listelerindeki kayıtlı hasta sayıları, merkezlerin kapasite kullanım durumu, bölgelere","x0":0.1169558189461107,"x1":0.8830508191348185,"top":0.2797715710998271,"bottom":0.29808191600110334,"conf":1},{"text":"göre nufüs ve merkez sayıları, transplantaşyon yapabilecek hekim sayıları ve ülke genelinde dağılımı","x0":0.11704313123214594,"x1":0.8829568688010243,"top":0.29504696873728176,"bottom":0.3125533735195192,"conf":1},{"text":"gibi kriterler dikkate alınarak, 2012 yılı için yeni organ nakli merkezi açılmasına ihtiyaç duyulan iller","x0":0.11697037689339676,"x1":0.8850777681033907,"top":0.3091494425101371,"bottom":0.32656202235360765,"conf":1},{"text":"ve merkez sayıları belirlenmiş olup aşağıdaki listede belirtildiği gibidir.","x0":0.11704311647288658,"x1":0.6529774172871604,"top":0.32408198084821505,"bottom":0.34030742918297163,"conf":1},{"text":"Başvurular Bakanlıkça değerlendirilir. Kamu hizmetlerinin sürekliliği ve sürdürülebilirliği ile","x0":0.1764914497242836,"x1":0.8850852881810318,"top":0.3370990724750961,"bottom":0.35477475241247014,"conf":1},{"text":"uzman hekim eğitimi bakımından öncelikle o ildeki devlete ait üniversite hastaneleri ile eğitim ve","x0":0.11698557104866165,"x1":0.8830145972460122,"top":0.3529090780466573,"bottom":0.3695158755752703,"conf":1},{"text":"araştırma hastanelerinden yapılan başvuru dikkate alınır. Kamuya ait hastanelerden başvuru","x0":0.11900415047032346,"x1":0.8830416466961689,"top":0.3673407052550641,"bottom":0.38474393892735204,"conf":1},{"text":"yapılmaması halinde özel hastanelerden yapılan başvurular değerlendirmeye alınır. Belirlenen sayının","x0":0.1169510441091898,"x1":0.8830310803646624,"top":0.3828305825042586,"bottom":0.40070446218858957,"conf":1},{"text":"üzerinde başvuru olması halinde hak sahibi noter huzurunda yapılacak kura ile belirlenir. Hak sahibi","x0":0.1169612721012381,"x1":0.885100065456839,"top":0.3975483964408084,"bottom":0.4160128521797394,"conf":1},{"text":"hastaneye merkez açma nihai başvurusu yapmak üzere ön ızın verılır.","x0":0.11704312590361117,"x1":0.6365503082967082,"top":0.415697674533933,"bottom":0.4274124681292968,"conf":1},{"text":"On izin başvurusunda bulunacak merkezler başvuru yaptıkları tarıh ıtıbarı ıle Organ Naklı","x0":0.16427106536454172,"x1":0.8829568605081484,"top":0.4302325583178016,"bottom":0.4419299744360292,"conf":1},{"text":"Merkezleri Yönergesinde bahsedilen fiziki şartları taşımaları ve burada bildirilmiş olan birimlere ve","x0":0.11909651320541867,"x1":0.8829568747930168,"top":0.4432109311279274,"bottom":0.4578488374899381,"conf":1},{"text":"personele sahip olmaları gerekmektedir. Merkez açma talep dilekçeleri 02 Ocak- 29 Şubat 2012","x0":0.11693264321893164,"x1":0.8830671540884968,"top":0.45586842167358466,"bottom":0.4743386377356922,"conf":1},{"text":"tarihleri arasında Bakanlık Tedavi Hizmetleri Genel Müdürlüğüne iletilecektir. Ön izin başvurularının","x0":0.1169422467030921,"x1":0.8830441022897845,"top":0.4687717282668922,"bottom":0.4888965537941713,"conf":1},{"text":"değerlendirilmesi aşamasında belirtilen şartları taşımadığı tespit edilen merkezlerin başvuruları","x0":0.11699751008296441,"x1":0.8830128254843458,"top":0.4852075674220364,"bottom":0.5025757472515174,"conf":1},{"text":"geçersız sayılacaktır.","x0":0.1166427032190278,"x1":0.2774841797331714,"top":0.5008077190251744,"bottom":0.5176691875023666,"conf":1},{"text":"Merkez açma ön izni alan hastane Yönergeye uygun olarak merkez ruhsat başvurusunu ön izin","x0":0.1765312754606681,"x1":0.8830217598734096,"top":0.5144529625107834,"bottom":0.5315176914797677,"conf":1},{"text":"tarihinden itibaren iki ay içerisinde eksiksiz olarak İl Sağlık Müdürlüğü aracılığıyla Bakanlığa yapar.","x0":0.11704313733854156,"x1":0.8850102508887001,"top":0.5290350124490508,"bottom":0.5452604607838074,"conf":1},{"text":"Bu süre içerisinde ruhsat başvurusu yapılmaması halinde başvuru sahibinin ön izni iptal edilir. Noter","x0":0.11901254100249488,"x1":0.8850902921253059,"top":0.5434472387555095,"bottom":0.5620989420533469,"conf":1},{"text":"kurasındaki sıraya göre yeni hak sahibi belirlenerek aynı işlemler yapılır.","x0":0.11704313212493107,"x1":0.6632443497025844,"top":0.5595930231506582,"bottom":0.5755813950542837,"conf":1},{"text":"Gereğini bilgilerinize rica ederim.","x0":0.16427104522740094,"x1":0.4229979484333094,"top":0.5755764304125749,"bottom":0.5901162793461328,"conf":1},{"text":"ORGAN NAKLİ MERKEZİ AÇMAK İÇIN PLANLAMA DAHILINDE RUHSAT","x0":0.17248458352083812,"x1":0.8295688043702116,"top":0.6031976741309455,"bottom":0.6178479929184527,"conf